        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo PIN è troppo lungo per una chiave di sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのPINはセキュリティキーには長すぎます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს PIN უსაფრთხოების გასაღებისთვის ზედმეტად გრძელია."
          }
        },
        "km": {
          "stringUnit": {
