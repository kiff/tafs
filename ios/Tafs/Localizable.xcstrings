    "sample.chargebacks.job": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworte Kartenreklamationen vor der Frist mit den Nachweisen der Bestellung. Akzeptiere kleine, die nicht zu gewinnen sind. Teile nichts über die Vorlage hinaus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer card disputes with the order's evidence before the deadline. Accept small ones that can't be won. Share nothing beyond the template."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde a las disputas de tarjeta con las pruebas del pedido antes del plazo. Acepta las pequeñas que no se pueden ganar. No compartas nada más allá de la plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondre aux litiges de carte bancaire avec les preuves de la commande avant l'échéance. Accepter les petits litiges impossibles à gagner. Ne rien partager au-delà du modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi alle contestazioni delle carte con le prove dell'ordine prima della scadenza. Accetta quelle piccole che non si possono vincere. Non condividere nulla oltre il modello."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord kaartgeschillen vóór de deadline met het bewijs van de bestelling. Accepteer kleine geschillen die niet te winnen zijn. Deel niets buiten de sjabloon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadaj na spory kartowe dowodami z zamówienia przed terminem. Akceptuj małe, których nie da się wygrać. Nie udostępniaj niczego poza szablonem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder às disputas de cartão com as provas da encomenda antes do prazo. Aceitar as pequenas que não se podem ganhar. Não partilhar nada além do modelo."
          }
        }
      }
    },
