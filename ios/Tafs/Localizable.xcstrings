    "card.rule.up_to_each": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "hər biri %1$@-dək; çoxu əvvəlcə sizdən soruşur"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "до %1$@ всяко; за повече първо ви пита"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "až %1$@ za každé; víc se vás nejdřív zeptá"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "bis zu %1$@ pro Aufruf; für mehr fragt er dich zuerst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "up to %1$@ each; more asks you first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "hasta %1$@ cada vez; si es más, te pregunta primero"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "kuni %1$@ korraga; rohkema korral küsib see kõigepealt sinult"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "jusqu'à %1$@ chacun ; au-delà, il vous demande d'abord"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "do %1$@ po pozivu; više pita vas najprije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "egyenként legfeljebb %1$@; a több előbb téged kérdez"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "մինչև %1$@ մեկ զանգի համար․ ավելիի համար նախ հարցնում է ձեզ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "hingga %1$@ per panggilan; yang lebih bertanya kepada Anda lebih dulu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "fino a %1$@ ciascuna; oltre, ti chiede prima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1件あたり最大%1$@、それ以上はまずあなたに確認します"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-მდე თითო ზარზე; მეტისთვის ჯერ გეკითხებათ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건당 최대 %1$@; 그 이상은 먼저 나에게 묻습니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "iki %1$@ vienu kartu; daugiau – pirmiausia klausia jūsų"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "līdz %1$@ par katru; par vairāk tas vispirms jautā tev"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tot %1$@ per keer; meer vraagt het je eerst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "do %1$@ za każde; przy większej kwocie najpierw pyta Ciebie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "até %1$@ cada; mais do que isso pergunta-lhe primeiro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "até %1$@ cada; mais do que isso pergunta a você primeiro"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "până la %1$@ fiecare; pentru mai mult vă întreabă mai întâi"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "do %1$@ za každé; viac sa vás najprv opýta"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "do %1$@ vsak; več najprej vpraša vas"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "deri në %1$@ për thirrje; për më shumë ju pyet më parë"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "do %1$@ po pozivu; za više prvo pita vas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูงสุด %1$@ ต่อครั้ง มากกว่านั้นจะถามคุณก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "her biri için en fazla %1$@; fazlası önce size sorar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tối đa %1$@ mỗi lần; nhiều hơn thì hỏi bạn trước"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次最多 %1$@；超過的部分會先詢問您"
          }
        }
      }
