          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ KIFF เพื่อตั้งชื่ออุปกรณ์นี้ไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
