    "connect.another_approval": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجري موافقة أخرى الآن. وافق على هذه عندما تنتهي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqa təsdiq keçir. Bu bitəndə bunu təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Друго одобрение е в процес. Одобрете това, след като приключи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরেকটি অনুমোদন চলছে। সেটি শেষ হলে এটি অনুমোদন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi ha una altra aprovació en curs. Aprova aquesta quan acabi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probíhá jiné schválení. Toto schvalte, až skončí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Genehmigung läuft gerade. Genehmige diese hier, sobald sie fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another approval is going through. Approve this one once it's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otra aprobación en curso. Aprueba esta cuando termine."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teine kinnitus on pooleli. Kinnita see, kui see on tehtud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre approbation est en cours. Approuvez celle-ci une fois qu'elle est terminée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אישור אחר מתבצע כעת. יש לאשר את זה כשהוא יסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक और मंज़ूरी चल रही है। उसके पूरा होने पर इसे मंज़ूर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugo se odobrenje upravo provodi. Odobrite ovo kad bude gotovo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy másik jóváhagyás folyamatban van. Ezt akkor hagyd jóvá, ha az kész."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեկ այլ հաստատում է անցնում։ Հաստատեք սա, երբ ավարտվի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persetujuan lain sedang berjalan. Setujui yang ini setelah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra approvazione è in corso. Approva questa quando è terminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の承認が進行中です。それが終わってからこれを承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვა დამტკიცება მიმდინარეობს. დაამტკიცეთ ეს, როცა დასრულდება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការអនុម័តមួយទៀតកំពុងដំណើរការ។ អនុម័តមួយនេះនៅពេលវារួចរាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 승인이 진행 중입니다. 끝나면 이것을 승인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມີການອະນຸມັດອື່ນກຳລັງດຳເນີນ. ອະນຸມັດອັນນີ້ເມື່ອມັນສຳເລັດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vykdomas kitas patvirtinimas. Patvirtinkite šį, kai jis bus baigtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiek cits apstiprinājums. Apstiprini šo, kad tas būs pabeigts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Друго одобрување е во тек. Одобри го ова кога ќе заврши."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өөр зөвшөөрөл явагдаж байна. Дууссаны дараа үүнийг зөвшөөрнө үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अर्को स्वीकृति चलिरहेको छ। यो सकिएपछि यसलाई स्वीकृत गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt al een andere goedkeuring. Je kunt deze goedkeuren zodra die klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa inne zatwierdzenie. Zatwierdź to, gdy się zakończy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra aprovação está em curso. Aprove esta quando estiver concluída."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra aprovação está em andamento. Aprove esta quando estiver concluída."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O altă aprobare este în curs. Aprobați-o pe aceasta după ce se termină."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prebieha iné schválenie. Toto schváľte, keď skončí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poteka druga odobritev. To odobrite, ko se konča."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një miratim tjetër po kalon. Miratojeni këtë kur të mbarojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugo se odobrenje upravo provodi. Odobrite ovo kad bude gotovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการอนุมัติอื่นกำลังดำเนินอยู่ อนุมัติรายการนี้เมื่อรายการนั้นเสร็จ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Başga tassyklama geçýär. Ol gutarandan soň muny tassyklaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir onay sürüyor. O bitince bunu onaylayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک اور منظوری چل رہی ہے۔ اس کے مکمل ہونے پر اسے منظور کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lượt phê duyệt khác đang được xử lý. Hãy phê duyệt lượt này khi nó xong."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一項核准正在進行。待它完成後，再核准這一項。"
          }
        }
      }
    },
