        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo est un abonnement à %2$@ par %1$@, facturé sur votre compte Apple. Il se renouvelle chaque %3$@ jusqu'à ce que vous l'annuliez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo è un abbonamento a %2$@ ogni %1$@, addebitato sul tuo account Apple. Si rinnova ogni %3$@ finché non lo annulli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo is een abonnement van één %1$@ voor %2$@, in rekening gebracht bij je Apple-account. Het wordt elke %3$@ verlengd tot je opzegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo to subskrypcja na okres %1$@ za %2$@, pobierana z Twojego konta Apple. Odnawia się co %3$@, dopóki jej nie anulujesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Solo é uma subscrição por %1$@, a %2$@, cobrada na sua conta Apple. Renova-se a cada %3$@ até a cancelar."
          }
        }
      }
    },
