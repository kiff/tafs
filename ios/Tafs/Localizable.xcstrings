    "chat.empty_named": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-dan nə etdiyini soruşun və ya ona başqa cür nə edəcəyini deyin. O, Card-ının daxilində qalır. Onun təsdiqinizi tələb etdiyi çağırış, söhbətdən və ya planlaşdırılmış işdən, burada da görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Попитайте %1$@ какво е направил или му кажете какво да прави различно. Той остава в рамките на своята Card. Тук се показва и заявка, която трябва да одобрите, от чат или от планирано изпълнение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptejte se %1$@, co udělal, nebo mu řekněte, co dělat jinak. Zůstává v rámci své Card. Zobrazí se tu i volání, které potřebuje vaše schválení, z chatu i z plánovaného běhu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag %1$@, was er getan hat, oder sag ihm, was er anders machen soll. Er bleibt innerhalb seiner Card. Ein Aufruf, den du genehmigen musst, aus einem Chat oder einem geplanten Lauf, erscheint auch hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask %1$@ what it did, or tell it what to do differently. It stays inside its Card. A call it needs you to approve, from a chat or a scheduled run, shows here too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a %1$@ qué hizo, o dile qué hacer de otra forma. Se mantiene dentro de su Card. Aquí también aparece una llamada que necesite tu aprobación, desde un chat o una ejecución programada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Küsi tafilt %1$@, mida see tegi, või ütle, mida teha teisiti. See jääb oma Cardi piiresse. Siin on ka päring, mille see vajab sinult kinnitamiseks, olgu vestlusest või ajastatud käivitusest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à %1$@ ce qu'il a fait, ou dites-lui quoi faire autrement. Il reste dans sa Card. Un appel qu'il vous demande d'approuver, depuis un chat ou une exécution planifiée, s'affiche aussi ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitajte taf %1$@ što je napravio ili mu recite da radi drugačije. Ostaje unutar svog Carda. Poziv koji treba da odobrite, iz razgovora ili zakazanog izvođenja, prikazuje se i ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérdezd meg a(z) %1$@ tafot, mit csinált, vagy mondd meg neki, mit csináljon másképp. A Cardján belül marad. Az a hívás is itt jelenik meg, amelyet jóvá kell hagynod, akár csevegésből, akár ütemezett futásból jön."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարցրեք %1$@-ին, թե ինչ արեց, կամ ասեք, թե ինչ անի այլ կերպ։ Այն մնում է իր Card-ի շրջանակներում։ Զանգը, որ պետք է հաստատեք, զրույցից կամ պլանավորված գործարկումից, այստեղ նույնպես երևում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanyakan kepada %1$@ apa yang dilakukannya, atau katakan apa yang harus dilakukannya secara berbeda. Ia tetap berada dalam Card-nya. Panggilan yang memerlukan persetujuan Anda, dari obrolan atau eksekusi terjadwal, juga muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a %1$@ cosa ha fatto, o digli cosa fare diversamente. Resta entro la sua Card. Anche una chiamata che deve farti approvare, da una chat o da un'esecuzione pianificata, compare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に何をしたか尋ねたり、やり方を変えるよう伝えたりできます。%1$@はCardの範囲内で動きます。チャットや予定された実行から承認が必要な呼び出しがあると、ここにも表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჰკითხეთ %1$@-ს, რა გააკეთა, ან უთხარით, რა გააკეთოს სხვანაირად. ის თავისი Card-ის ფარგლებში რჩება. ზარიც, რომლის დამტკიცებაც გჭირდებათ, ჩატიდან ან დაგეგმილი გაშვებიდან, აქაც ჩანს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에게 무엇을 했는지 묻거나, 다르게 할 일을 알려 주세요. Card 안에서만 일합니다. 채팅이나 예약 실행에서 내 승인이 필요한 호출도 여기에 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paklauskite %1$@, ką jis padarė, arba pasakykite, ką daryti kitaip. Jis neperžengia savo Card ribų. Čia rodoma ir užklausa, kurią turite patvirtinti, iš pokalbio ar suplanuoto paleidimo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pajautā, ko %1$@ izdarīja, vai pasaki, ko darīt citādi. Tas darbojas Card ietvaros. Šeit parādās arī izsaukums, kas jāapstiprina tev, no sarunas vai ieplānotas palaišanas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag %1$@ wat het heeft gedaan, of zeg wat het anders moet doen. Het blijft binnen zijn Card. Een aanroep die je moet goedkeuren, uit een chat of een geplande run, verschijnt hier ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj %1$@, co zrobił, albo powiedz mu, co ma robić inaczej. Działa w ramach swojej Card. Wywołanie, które musisz zatwierdzić, z czatu lub zaplanowanego uruchomienia, też pojawi się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte a %1$@ o que fez, ou diga-lhe o que fazer de outra forma. Fica sempre dentro do seu Card. Uma chamada que precise da sua aprovação, de um chat ou de uma execução agendada, também aparece aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte a %1$@ o que fez, ou diga o que fazer de outro jeito. Ele sempre fica dentro do seu Card. Uma chamada que precise da sua aprovação, de um chat ou de uma execução agendada, também aparece aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întrebați-l pe %1$@ ce a făcut sau spuneți-i ce să facă altfel. Rămâne în limitele Cardului său. Un apel pe care trebuie să-l aprobați, dintr-o conversație sau dintr-o rulare programată, apare și aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opýtajte sa %1$@, čo urobil, alebo mu povedzte, čo robiť inak. Zostáva v rámci svojej Card. Zobrazí sa tu aj volanie, ktoré potrebuje vaše schválenie, z chatu aj z plánovaného behu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vprašajte %1$@, kaj je naredil, ali mu povejte, kaj naj naredi drugače. Ostane znotraj svoje Card. Tu se prikaže tudi klic, ki ga morate odobriti, iz klepeta ali načrtovanega zagona."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyetni %1$@ çfarë bëri, ose tregojini çfarë të bëjë ndryshe. Qëndron brenda Card-it të vet. Një thirrje që ka nevojë ta miratoni, nga një bisedë ose një ekzekutim i planifikuar, shfaqet edhe këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitajte taf %1$@ šta je napravio ili mu recite da radi drugačije. Ostaje unutar svog Carda. Poziv koji treba da odobrite, iz razgovora ili zakazanog izvršavanja, prikazuje se i ovdje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถาม %1$@ ว่ามันทำอะไรไป หรือบอกให้ทำต่างออกไป มันอยู่ใน Card ของมันเสมอ การเรียกที่ต้องให้คุณอนุมัติ จากแชตหรือการทำงานตามกำหนดการ จะแสดงที่นี่ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ taf'ına ne yaptığını sorun veya neyi farklı yapması gerektiğini söyleyin. Card'ının içinde kalır. Onaylamanızı gerektiren bir çağrı, bir sohbetten veya zamanlanmış bir çalıştırmadan, burada da görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy hỏi %1$@ nó đã làm gì, hoặc bảo nó làm khác đi. Nó luôn ở trong Card của mình. Một lượt gọi cần bạn phê duyệt, từ một cuộc trò chuyện hay một lượt chạy theo lịch, cũng hiện ở đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詢問 %1$@ 它做了什麼，或告訴它該換個方式做。它會留在它的 Card 範圍內。需要您核准的呼叫，不論來自對話或排程執行，也會顯示在這裡。"
          }
        }
      }
    },
    "chat.empty_unnamed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondan nə etdiyini soruşun və ya ona başqa cür nə edəcəyini deyin. O, Card-ının daxilində qalır. Onun təsdiqinizi tələb etdiyi çağırış, söhbətdən və ya planlaşdırılmış işdən, burada da görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Попитайте го какво е направил или му кажете какво да прави различно. Той остава в рамките на своята Card. Тук се показва и заявка, която трябва да одобрите, от чат или от планирано изпълнение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptejte se ho, co udělal, nebo mu řekněte, co dělat jinak. Zůstává v rámci své Card. Zobrazí se tu i volání, které potřebuje vaše schválení, z chatu i z plánovaného běhu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag ihn, was er getan hat, oder sag ihm, was er anders machen soll. Er bleibt innerhalb seiner Card. Ein Aufruf, den du genehmigen musst, aus einem Chat oder einem geplanten Lauf, erscheint auch hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask it what it did, or tell it what to do differently. It stays inside its Card. A call it needs you to approve, from a chat or a scheduled run, shows here too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale qué hizo, o dile qué hacer de otra forma. Se mantiene dentro de su Card. Aquí también aparece una llamada que necesite tu aprobación, desde un chat o una ejecución programada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Küsi temalt, mida see tegi, või ütle, mida teha teisiti. See jääb oma Cardi piiresse. Siin on ka päring, mille see vajab sinult kinnitamiseks, olgu vestlusest või ajastatud käivitusest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez-lui ce qu'il a fait, ou dites-lui quoi faire autrement. Il reste dans sa Card. Un appel qu'il vous demande d'approuver, depuis un chat ou une exécution planifiée, s'affiche aussi ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitajte ga što je napravio ili mu recite da radi drugačije. Ostaje unutar svog Carda. Poziv koji treba da odobrite, iz razgovora ili zakazanog izvođenja, prikazuje se i ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérdezd meg, mit csinált, vagy mondd meg neki, mit csináljon másképp. A Cardján belül marad. Az a hívás is itt jelenik meg, amelyet jóvá kell hagynod, akár csevegésből, akár ütemezett futásból jön."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարցրեք՝ ինչ արեց, կամ ասեք, թե ինչ անի այլ կերպ։ Այն մնում է իր Card-ի շրջանակներում։ Զանգը, որ պետք է հաստատեք, զրույցից կամ պլանավորված գործարկումից, այստեղ նույնպես երևում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanyakan apa yang dilakukannya, atau katakan apa yang harus dilakukannya secara berbeda. Ia tetap berada dalam Card-nya. Panggilan yang memerlukan persetujuan Anda, dari obrolan atau eksekusi terjadwal, juga muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedigli cosa ha fatto, o digli cosa fare diversamente. Resta entro la sua Card. Anche una chiamata che deve farti approvare, da una chat o da un'esecuzione pianificata, compare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何をしたか尋ねたり、やり方を変えるよう伝えたりできます。Cardの範囲内で動きます。チャットや予定された実行から承認が必要な呼び出しがあると、ここにも表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჰკითხეთ, რა გააკეთა, ან უთხარით, რა გააკეთოს სხვანაირად. ის თავისი Card-ის ფარგლებში რჩება. ზარიც, რომლის დამტკიცებაც გჭირდებათ, ჩატიდან ან დაგეგმილი გაშვებიდან, აქაც ჩანს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 했는지 묻거나, 다르게 할 일을 알려 주세요. Card 안에서만 일합니다. 채팅이나 예약 실행에서 내 승인이 필요한 호출도 여기에 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paklauskite jo, ką jis padarė, arba pasakykite, ką daryti kitaip. Jis neperžengia savo Card ribų. Čia rodoma ir užklausa, kurią turite patvirtinti, iš pokalbio ar suplanuoto paleidimo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pajautā, ko tas izdarīja, vai pasaki, ko darīt citādi. Tas darbojas Card ietvaros. Šeit parādās arī izsaukums, kas jāapstiprina tev, no sarunas vai ieplānotas palaišanas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag wat het heeft gedaan, of zeg wat het anders moet doen. Het blijft binnen zijn Card. Een aanroep die je moet goedkeuren, uit een chat of een geplande run, verschijnt hier ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj go, co zrobił, albo powiedz mu, co ma robić inaczej. Działa w ramach swojej Card. Wywołanie, które musisz zatwierdzić, z czatu lub zaplanowanego uruchomienia, też pojawi się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte-lhe o que fez, ou diga-lhe o que fazer de outra forma. Fica sempre dentro do seu Card. Uma chamada que precise da sua aprovação, de um chat ou de uma execução agendada, também aparece aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte o que ele fez, ou diga o que fazer de outro jeito. Ele sempre fica dentro do seu Card. Uma chamada que precise da sua aprovação, de um chat ou de uma execução agendada, também aparece aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întrebați-l ce a făcut sau spuneți-i ce să facă altfel. Rămâne în limitele Cardului său. Un apel pe care trebuie să-l aprobați, dintr-o conversație sau dintr-o rulare programată, apare și aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opýtajte sa ho, čo urobil, alebo mu povedzte, čo robiť inak. Zostáva v rámci svojej Card. Zobrazí sa tu aj volanie, ktoré potrebuje vaše schválenie, z chatu aj z plánovaného behu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vprašajte ga, kaj je naredil, ali mu povejte, kaj naj naredi drugače. Ostane znotraj svoje Card. Tu se prikaže tudi klic, ki ga morate odobriti, iz klepeta ali načrtovanega zagona."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyeteni çfarë bëri, ose tregojini çfarë të bëjë ndryshe. Qëndron brenda Card-it të vet. Një thirrje që ka nevojë ta miratoni, nga një bisedë ose një ekzekutim i planifikuar, shfaqet edhe këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitajte ga šta je napravio ili mu recite da radi drugačije. Ostaje unutar svog Carda. Poziv koji treba da odobrite, iz razgovora ili zakazanog izvršavanja, prikazuje se i ovdje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามมันว่ามันทำอะไรไป หรือบอกให้ทำต่างออกไป มันอยู่ใน Card ของมันเสมอ การเรียกที่ต้องให้คุณอนุมัติ จากแชตหรือการทำงานตามกำหนดการ จะแสดงที่นี่ด้วย"
          }
        },
        "tr": {
