    "alert.open_tafs_answer_kiff_did": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح tafs لتردّ: لم يذكر KIFF أي نسخة منه رأيتها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cavab vermək üçün tafs-ı açın: KIFF hansı versiyanı gördüyünüzü demədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете tafs, за да отговорите: KIFF не каза коя версия сте видели."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তর দিতে tafs খুলুন: আপনি এর কোন সংস্করণ দেখেছেন তা KIFF বলেনি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre tafs per respondre: KIFF no ha dit quina versió has vist."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete tafs a odpovězte: KIFF neřekl, kterou verzi jste viděli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne tafs, um zu antworten: KIFF hat nicht gesagt, welche Version du gesehen hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open tafs to answer it: KIFF didn't say which version of it you saw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
