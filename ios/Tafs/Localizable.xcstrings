          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tiếp tục làm việc như hiện tại. Những gì phiên bản này làm là thật, dưới Card riêng của nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 維持現狀繼續運作。此版本所做的事是真實的，在它自己的 Card 之下。"
