    "people.rename_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتغير الاسم فقط: يبقى أشخاصها وtafs الخاصة بها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız ad dəyişir: adamları və taf-ları qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Променя се само името: хората и tafs остават."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু নাম বদলায়: এর সদস্য ও taf থেকে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només canvia el nom: les seves persones i taf es queden."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změní se jen název: její lidé a tafy zůstávají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Name ändert sich: Ihre Personen und tafs bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the name changes: its people and tafs stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cambia el nombre: sus personas y tafs se mantienen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutub ainult nimi: selle inimesed ja tafid jäävad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le nom change : ses membres et ses tafs restent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק השם משתנה: האנשים וה-taf שלה נשארים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल नाम बदलता है: उसके लोग और taf रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijenja se samo naziv: njezini ljudi i tafovi ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a név változik: a tagjai és tafjai maradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխվում է միայն անունը․ նրա մարդիկ և taf-երը մնում են։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya nama yang berubah: anggota dan tafs-nya tetap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia solo il nome: le sue persone e i suoi tafs restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変わるのは名前だけで、メンバーとtafsはそのままです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იცვლება მხოლოდ სახელი: მისი ადამიანები და taf-ები რჩება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឈ្មោះប៉ុណ្ណោះដែលផ្លាស់ប្តូរ៖ មនុស្ស និង taf របស់វានៅដដែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름만 바뀝니다. 사람과 taf는 그대로입니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສະເພາະຊື່ທີ່ປ່ຽນ: ຄົນ ແລະ taf ຂອງມັນຍັງຢູ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Keičiasi tik pavadinimas: jos nariai ir taf lieka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainās tikai nosaukums: tās cilvēki un taf paliek."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Се менува само името: нејзините луѓе и tafови остануваат."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөвхөн нэр өөрчлөгдөнө: хүмүүс болон taf-ууд нь үлдэнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम मात्र परिवर्तन हुन्छ: यसका मानिस र taf रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de naam verandert: de mensen en tafs blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia się tylko nazwa: jej członkowie i tafs zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o nome muda: as suas pessoas e os seus tafs mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o nome muda: as suas pessoas e os seus tafs mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se schimbă doar numele: membrii și tafurile rămân."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmení sa len názov: jej ľudia a tafy zostávajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremeni se samo ime: njeni ljudje in tafi ostanejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndryshon vetëm emri: njerëzit dhe tafs-et e tij mbeten."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Menja se samo naziv: njeni ljudi i tafovi ostaju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนเฉพาะชื่อ: สมาชิกและ taf ของกลุ่มยังเหมือนเดิม"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diňe at üýtgeýär: onuň adamlary we tafs-lary galýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ad değişir: kişileri ve tafs'ları kalır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف نام بدلتا ہے: اس کے لوگ اور tafs رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tên thay đổi: các thành viên và tafs của nhóm vẫn giữ nguyên."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會變更名稱：群組的成員和 taf 維持不變。"
          }
        }
      }
    },
