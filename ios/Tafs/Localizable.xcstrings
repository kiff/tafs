    "knob.not_read_back": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung wurde vorgenommen, konnte aber nicht zurückgelesen werden. Tippe, um das Rad erneut zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change was made but couldn't be read back. Tap to read the dial again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio se hizo, pero no se pudo volver a leer. Toca para leer la rueda de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muudatus tehti, kuid seda ei õnnestunud tagasi lugeda. Puuduta, et valikuketas uuesti lugeda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification a été faite mais n'a pas pu être relue. Touchez pour relire la molette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica è stata fatta ma non è stato possibile rileggerla. Tocca per rileggere il quadrante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は行われましたが、再読み込みできませんでした。タップしてダイヤルを再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경은 되었지만 다시 읽지 못했습니다. 탭하여 다이얼을 다시 읽으세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakeitimas atliktas, bet jo nepavyko nuskaityti. Palieskite, kad dar kartą nuskaitytumėte ratuką."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmaiņa tika veikta, bet to nevarēja nolasīt atpakaļ. Pieskaries, lai vēlreiz nolasītu ripu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijziging is gemaakt maar kon niet worden teruggelezen. Tik om de draaiknop opnieuw te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana została wprowadzona, ale nie udało się jej odczytać. Dotknij, aby odczytać pokrętło ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração foi feita mas não foi possível relê-la. Toque para ler o seletor novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração foi feita mas não foi possível relê-la. Toque para ler o seletor novamente."
          }
        }
      }
    },
    "knob.not_recorded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung hört zu, aber das Rad hat es noch nicht festgehalten. Genehmige erneut, um es festzuhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection is listening, but the dial hasn't recorded it yet. Approve again to record it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión está escuchando, pero la rueda aún no lo ha registrado. Vuelve a aprobar para registrarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendus ootab sündmusi, kuid valikuketas pole seda veel salvestanud. Salvestamiseks kinnita uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion écoute, mais la molette ne l'a pas encore enregistré. Approuvez à nouveau pour l'enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento è in ascolto, ma il quadrante non l'ha ancora registrato. Approva di nuovo per registrarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続は受信中ですが、まだダイヤルに記録されていません。記録するにはもう一度承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결은 수신 중이지만 다이얼에 아직 기록되지 않았습니다. 기록하려면 다시 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryšys klausosi, bet ratukas to dar neįrašė. Patvirtinkite dar kartą, kad tai būtų įrašyta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Savienojums klausās, bet ripa to vēl nav reģistrējusi. Apstiprini vēlreiz, lai to reģistrētu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De koppeling luistert, maar de draaiknop heeft het nog niet vastgelegd. Je moet het opnieuw goedkeuren om het vast te leggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie nasłuchuje, ale pokrętło jeszcze tego nie zapisało. Zatwierdź ponownie, aby to zapisać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação está à escuta, mas o seletor ainda não o registou. Aprove novamente para o registar."
          }
        },
        "pt-BR": {
