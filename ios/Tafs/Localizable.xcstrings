    "version.while_you_try.live_keeps_working": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى النسخة الفعّالة تعمل؛ وفي اليوم الواحد يمكن إنفاق حدود الـ Cardين معًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İşləyən versiya işləməyə davam edir; bir gündə hər iki Card-ın limitləri xərclənə bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Активната версия продължава да работи; за един ден могат да се изразходват лимитите и на двете Cards."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালু সংস্করণ চলতে থাকে; একদিনে দুই Card-এর সীমাই খরচ হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La versió activa continua executant-se; en un dia es poden gastar els límits dels dos Card."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivní verze dál běží; za den se mohou vyčerpat limity obou Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Version läuft weiter; an einem Tag können die Limits beider Cards ausgeschöpft werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live version keeps running; on a day, both Cards' limits can be spent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión activa sigue funcionando; en un día se pueden gastar los límites de ambas Cards."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutusel olev versioon töötab edasi; ühel päeval võib kulutada mõlema Cardi limiidid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version en service continue de tourner ; sur une journée, les limites des deux Cards peuvent être dépensées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגרסה הפעילה ממשיכה לרוץ; ביום אחד אפשר לנצל את המגבלות של שני ה-Card."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू संस्करण चलता रहता है; एक दिन में दोनों Card की सीमाएँ खर्च हो सकती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzija u radu i dalje radi; u jednom danu mogu se potrošiti ograničenja oba Carda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az élő verzió tovább fut; egy adott napon mindkét Card limitjei elkölthetők."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ակտիվ տարբերակը շարունակում է աշխատել․ օրվա ընթացքում երկու Card-երի սահմանաչափերն էլ կարող են ծախսվել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi yang aktif tetap berjalan; dalam sehari, batas kedua Card dapat terpakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione attiva continua a funzionare; in un giorno si possono spendere i limiti di entrambe le Card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用中のバージョンも動き続けるため、1日で両方のCardの上限を使う場合があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქტიური ვერსია აგრძელებს მუშაობას; ერთ დღეში ორივე Card-ის ლიმიტი შეიძლება დაიხარჯოს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណែដែលកំពុងដំណើរការបន្តដំណើរការ; ក្នុងមួយថ្ងៃ ដែនកំណត់នៃ Card ទាំងពីរអាចត្រូវបានចំណាយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용된 버전은 계속 실행됩니다. 하루에 두 Card의 한도를 모두 쓸 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເວີຊັນທີ່ໃຊ້ງານຢູ່ເຮັດວຽກຕໍ່; ໃນມື້ໜຶ່ງ ຂີດຈຳກັດຂອງທັງສອງ Card ໃຊ້ໄດ້ທັງໝົດ."
          }
        },
        "lt": {
