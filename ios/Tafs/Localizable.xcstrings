    },
    "needs_you.sign_in_again_to_answer": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefondan cavab vermək üçün çıxıb yenidən daxil olun, ki, KIFF onun açarını tanısın. Və ya buna KIFF-də cavab verin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Излезте и влезте отново, за да отговаряте от този телефон, така че KIFF да познава ключа му. Или отговорете на това в KIFF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlaste se a znovu přihlaste, abyste mohli odpovídat z tohoto telefonu a KIFF znal jeho klíč. Nebo na tohle odpovězte v KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich ab und erneut an, um von diesem Telefon zu antworten, damit KIFF seinen Schlüssel kennt. Oder beantworte diese hier in KIFF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out and in again to answer from this phone, so KIFF knows its key. Or answer this one in KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra sesión y vuelve a iniciarla para responder desde este teléfono, así KIFF conoce su clave. O responde a esta en KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellest telefonist vastamiseks logi välja ja uuesti sisse, et KIFF teaks selle võtit. Või vasta sellele KIFFis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous puis reconnectez-vous pour répondre depuis ce téléphone, afin que KIFF connaisse sa clé. Ou répondez à celle-ci dans KIFF."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavite se i ponovno prijavite da biste odgovarali s ovog telefona, kako bi KIFF znao njegov ključ. Ili odgovorite na ovaj u KIFF-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezz ki és be újra, hogy erről a telefonról válaszolhass, és a KIFF ismerje a kulcsát. Vagy erre a KIFF-ben válaszolj."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դուրս եկեք և նորից մուտք գործեք՝ այս հեռախոսից պատասխանելու համար, որպեսզի KIFF-ը ճանաչի նրա բանալին։ Կամ պատասխանեք սրան KIFF-ում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar lalu masuk lagi untuk menjawab dari ponsel ini, agar KIFF mengenal kuncinya. Atau jawab yang ini di KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci e accedi di nuovo per rispondere da questo telefono, così KIFF conosce la sua chiave. Oppure rispondi a questa in KIFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンから回答するには、サインアウトしてもう一度サインインし、KIFFにキーを認識させてください。または、これはKIFFで回答してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოდით და ხელახლა შედით, რომ ამ ტელეფონიდან უპასუხოთ და KIFF-მა მისი გასაღები იცნოს. ან ამას უპასუხეთ KIFF-ში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에서 답변하려면 로그아웃한 뒤 다시 로그인해 KIFF가 키를 알게 하세요. 또는 이 요청은 KIFF에서 답변하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsijunkite ir vėl prisijunkite, kad galėtumėte atsakyti iš šio telefono ir KIFF žinotų jo raktą. Arba į šią atsakykite KIFF."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izraksties un pieraksties vēlreiz, lai atbildētu no šī tālruņa un KIFF zinātu tā atslēgu. Vai atbildi uz šo KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log uit en opnieuw in om vanaf deze telefoon te antwoorden, zodat KIFF de sleutel kent. Of beantwoord deze in KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyloguj się i zaloguj ponownie, aby odpowiadać z tego telefonu, żeby KIFF znał jego klucz. Albo odpowiedz na to w KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine a sessão e inicie sessão novamente para responder a partir deste telefone, para que o KIFF conheça a sua chave. Ou responda a este no KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre a sessão e entre novamente para responder a partir deste telefone, para que o KIFF conheça a sua chave. Ou responda a este no KIFF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectați-vă și conectați-vă din nou pentru a răspunde de pe acest telefon, ca KIFF să-i cunoască cheia. Sau răspundeți la aceasta în KIFF."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhláste sa a znova prihláste, aby ste mohli odpovedať z tohto telefónu a KIFF poznal jeho kľúč. Alebo na toto odpovedzte v KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavite se in znova prijavite, da boste lahko odgovarjali s tega telefona in bo KIFF poznal njegov ključ. Ali pa na to odgovorite v KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilni dhe hyni sërish për t'u përgjigjur nga ky telefon, që KIFF ta njohë çelësin e tij. Ose përgjigjuni kësaj në KIFF."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavite se i ponovo prijavite da biste odgovarali s ovog telefona, kako bi KIFF znao njegov ključ. Ili odgovorite na ovaj u KIFF-u."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจากระบบแล้วเข้าสู่ระบบอีกครั้งเพื่อตอบจากโทรศัพท์เครื่องนี้ เพื่อให้ KIFF รู้จักกุญแจของมัน หรือตอบรายการนี้ใน KIFF"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefondan yanıtlamak için oturumu kapatıp tekrar açın, böylece KIFF anahtarını tanır. Ya da bunu KIFF'te yanıtlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng xuất rồi đăng nhập lại để trả lời từ điện thoại này, để KIFF biết khóa của nó. Hoặc trả lời cái này trong KIFF."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請登出再重新登入，才能從這部手機回覆，讓 KIFF 認得它的金鑰。或者在 KIFF 中回覆這一項。"
          }
        }
      }
    },
    "needs_you.someone_answers": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buna bu hesabda təsdiq edən biri cavab verir. Onun cavabı burada görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На това отговаря някой, който одобрява в този акаунт. Отговорът му се показва тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tohle odpoví někdo, kdo v tomto účtu schvaluje. Jeho odpověď se zobrazí tady."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand, der in diesem Konto genehmigt, beantwortet das. Die Antwort erscheint hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone who approves on this account answers this. Their answer shows here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien aprueba en esta cuenta responde a esto. Su respuesta aparece aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellele vastab keegi, kes sellel kontol kinnitab. Tema vastus ilmub siia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne qui approuve sur ce compte y répond. Sa réponse s'affiche ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovo odgovara netko tko odobrava na ovom računu. Njegov se odgovor prikazuje ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erre a fiókban jóváhagyó valaki válaszol. A válasza itt jelenik meg."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սրան պատասխանում է նա, ով այս հաշվում հաստատում է։ Նրա պատասխանը կերևա այստեղ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang menyetujui di akun ini yang menjawabnya. Jawabannya muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risponde chi approva in questo account. La sua risposta compare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの承認者が回答します。回答はここに表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამას პასუხობს ის, ვინც ამ ანგარიშზე ამტკიცებს. მისი პასუხი აქ გამოჩნდება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 승인자가 답변합니다. 답변은 여기에 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Į tai atsako tas, kas šioje paskyroje tvirtina. Jo atsakymas bus rodomas čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz šo atbild kāds, kurš šajā kontā apstiprina. Atbilde parādīsies šeit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand die in dit account goedkeurt, beantwoordt dit. Het antwoord verschijnt hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiada na to osoba zatwierdzająca na tym koncie. Jej odpowiedź pojawi się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém que aprova nesta conta responde a isto. A resposta aparece aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém que aprova nesta conta responde a isto. A resposta aparece aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La aceasta răspunde cineva care aprobă în acest cont. Răspunsul său apare aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na toto odpovie niekto, kto v tomto účte schvaľuje. Jeho odpoveď sa zobrazí tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na to odgovori nekdo, ki v tem računu odobrava. Njegov odgovor se prikaže tukaj."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kësaj i përgjigjet dikush që miraton në këtë llogari. Përgjigjja e tij shfaqet këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovo odgovara netko ko odobrava na ovom nalogu. Njegov se odgovor prikazuje ovdje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ที่อนุมัติได้ในบัญชีนี้จะเป็นผู้ตอบ คำตอบของเขาจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu bu hesapta onaylayan biri yanıtlar. Yanıtı burada görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người phê duyệt trên tài khoản này sẽ trả lời việc này. Câu trả lời của họ hiện ở đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由此帳號中可核准的人回覆。他們的回覆會顯示在這裡。"
          }
        }
      }
    },
