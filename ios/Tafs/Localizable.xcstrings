        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անվտանգության բանալին չի կարող ստուգել PIN, ուստի չի կարող հաստատել։ Միացրեք այն, որը համապատասխանում է այս համակարգչին։"
