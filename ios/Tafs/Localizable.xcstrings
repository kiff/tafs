    "version.install_unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation von Version %1$@ wurde nicht abgeschlossen: KIFF hat ihre Card nicht bestätigt. %2$@ Dein taf läuft nicht, bis du sie abschließt oder abbrichst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing version %1$@ didn't finish: KIFF didn't confirm its Card. %2$@ Your taf doesn't run until you finish or cancel it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación de la versión %1$@ no terminó: KIFF no confirmó su Card. %2$@ Tu taf no se ejecuta hasta que la termines o la canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installation de la version %1$@ n'a pas abouti : KIFF n'a pas confirmé sa Card. %2$@ Votre taf ne s'exécute pas tant que vous ne la terminez pas ou ne l'annulez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installazione della versione %1$@ non è stata completata: KIFF non ha confermato la sua Card. %2$@ Il tuo taf non lavora finché non la completi o la annulli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het installeren van versie %1$@ is niet afgerond: KIFF heeft de Card niet bevestigd. %2$@ Je taf draait niet tot je het afrondt of annuleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacja wersji %1$@ nie została ukończona: KIFF nie potwierdził jej Card. %2$@ Twój taf nie działa, dopóki jej nie dokończysz albo nie anulujesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação da versão %1$@ não foi concluída: o KIFF não confirmou o seu Card. %2$@ O seu taf não é executado até a concluir ou cancelar."
          }
        }
      }
    },
