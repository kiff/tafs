    "approval.add_face_id_first": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف Face ID أو بصمة في الإعدادات أولًا: يوافق هذا الجهاز (%1$@) بواحد منهما."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlcə Parametrlərdə Face ID və ya barmaq izi əlavə edin: bu cihaz (%1$@) onlardan biri ilə təsdiq edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Първо добавете Face ID или пръстов отпечатък в Настройки: този %1$@ одобрява с някое от тях."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে সেটিংসে Face ID বা আঙুলের ছাপ যোগ করুন: এই %1$@ এর একটি দিয়ে অনুমোদন করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer afegeix Face ID o una empremta als Ajustos: aquest dispositiu (%1$@) aprova amb un d'ells."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív v Nastavení přidejte Face ID nebo otisk prstu: tento %1$@ jím schvaluje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte zuerst Face ID oder einen Fingerabdruck in den Einstellungen ein: Dieses %1$@ genehmigt damit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Face ID or a fingerprint in Settings first: this %1$@ approves with one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade Face ID o una huella en Ajustes: este %1$@ aprueba con ello."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa esmalt seadetes Face ID või sõrmejälg: see %1$@ kinnitab sellega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord Face ID ou une empreinte dans Réglages : %2$@ approuve avec l'un des deux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קודם יש להוסיף Face ID או טביעת אצבע בהגדרות: ההתקן הזה (%1$@) מאשר באחד מהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले सेटिंग में Face ID या फ़िंगरप्रिंट जोड़ें: यह %1$@ उनमें से किसी एक से मंज़ूर करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije dodajte Face ID ili otisak prsta u Postavkama: ovaj %1$@ odobrava jednim od njih."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb adj hozzá Face ID-t vagy ujjlenyomatot a Beállításokban: ez az eszköz (%1$@) azzal hagy jóvá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախ Կարգավորումներում ավելացրեք Face ID կամ մատնահետք․ այս սարքը (%1$@) հաստատում է դրանցից մեկով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan Face ID atau sidik jari di Pengaturan terlebih dahulu: %1$@ ini menyetujui dengan salah satunya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima Face ID o un'impronta in Impostazioni: questo %1$@ approva con uno dei due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に設定でFace IDまたは指紋を追加してください。この%1$@はそれで承認します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ პარამეტრებში დაამატეთ Face ID ან თითის ანაბეჭდი: ეს მოწყობილობა (%1$@) მათგან ერთ-ერთით ამტკიცებს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ថែម Face ID ឬស្នាមម្រាមដៃក្នុងការកំណត់ជាមុនសិន៖ %1$@ នេះអនុម័តដោយមួយក្នុងចំណោមពួកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 설정에서 Face ID나 지문을 추가하세요. 이 %1$@에서는 그것으로 승인합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມ Face ID ຫຼື ລາຍນິ້ວມືໃນການຕັ້ງຄ່າກ່ອນ: %1$@ ນີ້ອະນຸມັດດ້ວຍອັນໃດອັນໜຶ່ງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmiausia nustatymuose pridėkite Face ID arba piršto atspaudą: šis įrenginys (%1$@) tvirtina juo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vispirms iestatījumos pievieno Face ID vai pirksta nospiedumu: šis %1$@ apstiprina ar to."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прво додај Face ID или отисок во Поставки: овој %1$@ одобрува со еден од нив."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Эхлээд Тохиргоонд Face ID эсвэл хурууны хээ нэмнэ үү: энэ %1$@ тэдгээрийн аль нэгээр зөвшөөрдөг."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिले सेटिङमा Face ID वा फिंगरप्रिन्ट थप्नुहोस्: यो %1$@ ती मध्ये एकले स्वीकृत गर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg eerst Face ID of een vingerafdruk toe in Instellingen: deze %1$@ keurt daarmee goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw dodaj Face ID lub odcisk palca w Ustawieniach: ten %1$@ zatwierdza za ich pomocą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione primeiro o Face ID ou uma impressão digital nas Definições: este %1$@ aprova com um deles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione primeiro o Face ID ou uma impressão digital nas Configurações: este %1$@ aprova com um deles."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai întâi adăugați Face ID sau o amprentă în Configurări: acest dispozitiv (%1$@) aprobă cu una dintre ele."
