    "watch.recording_not_received": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazı telefonunuza çatmadı. Yenidən cəhd edin və ya əvəzində yazın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Записът не стигна до телефона ви. Опитайте отново или пишете вместо това."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávka se do telefonu nedostala. Zkuste to znovu, nebo to napište."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist nicht auf deinem Handy angekommen. Versuch es erneut oder tippe stattdessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording didn't reach your phone. Try again, or type instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación no llegó a tu teléfono. Vuelve a intentarlo o escribe."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestis ei jõudnud telefoni. Proovi uuesti või kirjuta hoopis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement n'est pas arrivé sur votre téléphone. Réessayez, ou saisissez votre texte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimka nije stigla do vašeg telefona. Pokušajte ponovno ili tipkajte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvétel nem érkezett meg a telefonodra. Próbáld újra, vagy írj inkább."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձայնագրությունը չհասավ ձեր հեռախոսին։ Փորձեք նորից կամ մուտքագրեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman tidak sampai ke ponsel Anda. Coba lagi, atau ketik saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione non è arrivata al telefono. Riprova, oppure scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音がスマートフォンに届きませんでした。もう一度お試しいただくか、入力してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩანაწერი თქვენს ტელეფონამდე ვერ მივიდა. სცადეთ ხელახლა ან აკრიფეთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 휴대폰에 전달되지 않았습니다. 다시 시도하거나 직접 입력하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įrašas nepasiekė telefono. Bandykite dar kartą arba rašykite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieraksts nesasniedza tālruni. Mēģini vēlreiz vai raksti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is niet op je telefoon aangekomen. Probeer het opnieuw, of typ het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagranie nie dotarło do telefonu. Spróbuj ponownie albo wpisz tekst."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação não chegou ao telemóvel. Tente novamente ou escreva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação não chegou ao celular. Tente novamente ou digite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea nu a ajuns pe telefon. Încercați din nou sau tastați în schimb."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávka sa do telefónu nedostala. Skúste to znova, alebo to napíšte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posnetek ni prišel do telefona. Poskusite znova ali tipkajte."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Regjistrimi nuk arriti te telefoni juaj. Provoni sërish, ose shkruani në vend të kësaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimka nije stigla do vašeg telefona. Pokušajte ponovo ili tipkajte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกเสียงไปไม่ถึงโทรศัพท์ของคุณ ลองอีกครั้ง หรือพิมพ์แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt telefonunuza ulaşmadı. Tekrar deneyin veya yazın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm chưa đến được điện thoại của bạn. Hãy thử lại, hoặc gõ thay thế."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音未傳到您的手機。請再試一次，或改用輸入。"
          }
        }
      }
    },
