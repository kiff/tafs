    "coach.digest_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sorğu istədiyi şeyə uyğun gəlmir, ona görə təsdiqlənə bilməz. Coach-dan onu yenidən təklif etməsini xahiş edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази заявка не съответства на това, което иска, така че не може да бъде одобрена. Помолете Coach да я предложи отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato žádost neodpovídá tomu, o co žádá, takže ji nelze schválit. Požádejte Coache, ať ji navrhne znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage stimmt nicht mit dem überein, worum sie bittet, daher kann sie nicht genehmigt werden. Frag Coach nach einem neuen Vorschlag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request doesn't match what it asks for, so it can't be approved. Ask Coach to propose it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud no coincide con lo que pide, así que no se puede aprobar. Pídele a Coach que la vuelva a proponer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See päring ei vasta sellele, mida see küsib, seega ei saa seda kinnitada. Palu Coachil see uuesti välja pakkuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande ne correspond pas à ce qu'elle demande : elle ne peut pas être approuvée. Demandez à Coach de la proposer à nouveau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj zahtjev ne odgovara onome što traži pa se ne može odobriti. Zamolite Coacha da ga ponovno predloži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kérés nem egyezik azzal, amit kér, ezért nem hagyható jóvá. Kérd meg a Coachot, hogy javasolja újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հարցումը չի համապատասխանում նրան, ինչ պահանջում է, ուստի չի կարող հաստատվել։ Խնդրեք Coach-ին նորից առաջարկել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan ini tidak cocok dengan yang diminta, jadi tidak dapat disetujui. Minta Coach mengusulkannya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa richiesta non corrisponde a ciò che chiede, quindi non può essere approvata. Chiedi a Coach di proporla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストは要求内容と一致しないため、承認できません。Coachにもう一度提案するよう頼んでください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოთხოვნა არ ემთხვევა იმას, რასაც ითხოვს, ამიტომ ვერ დამტკიცდება. სთხოვეთ Coach-ს ხელახლა შემოგთავაზოთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청은 요청 내용과 일치하지 않아 승인할 수 없습니다. Coach에게 다시 제안해 달라고 하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ši užklausa neatitinka to, ko ji prašo, todėl jos patvirtinti negalima. Paprašykite Coach pasiūlyti ją dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis pieprasījums neatbilst tam, ko tas lūdz, tāpēc to nevar apstiprināt. Palūdz Coach to piedāvāt vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verzoek komt niet overeen met wat het vraagt, dus het kan niet worden goedgekeurd. Je kunt Coach vragen het opnieuw voor te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prośba nie zgadza się z tym, o co prosi, więc nie można jej zatwierdzić. Poproś Coacha, aby zaproponował ją ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido não corresponde ao que pede, por isso não pode ser aprovado. Peça ao Coach para o propor novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido não corresponde ao que pede, por isso não pode ser aprovado. Peça ao Coach para o propor novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această solicitare nu corespunde cu ce cere, așa că nu poate fi aprobată. Cereți-i lui Coach să o propună din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto žiadosť nezodpovedá tomu, o čo žiada, takže ju nemožno schváliť. Požiadajte Coacha, nech ju navrhne znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta zahteva se ne ujema s tem, kar zahteva, zato je ni mogoče odobriti. Prosite Coacha, naj jo predlaga znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo kërkesë nuk përputhet me atë që kërkon, ndaj nuk mund të miratohet. Kërkojini Coach ta propozojë sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj zahtev ne odgovara onome šta traži pa se ne može odobriti. Zamolite Coacha da ga ponovo predloži."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอนี้ไม่ตรงกับสิ่งที่มันขอ จึงอนุมัติไม่ได้ ขอให้ Coach เสนออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istek, istediği şeyle eşleşmiyor, bu yüzden onaylanamaz. Coach'tan tekrar önermesini isteyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu này không khớp với điều nó xin, nên không thể phê duyệt. Hãy nhờ Coach đề xuất lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此請求與它所要求的內容不符，因此無法核准。請 Coach 重新提出。"
          }
        }
      }
    },
