    "knob.search": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل Coach أو ابحث عن أي شيء"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-dan soruşun və ya hər şeyi tapın"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Попитайте Coach или намерете каквото и да е"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-কে জিজ্ঞেস করুন বা কিছু খুঁজুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a Coach o troba qualsevol cosa"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptejte se Coache nebo cokoli najděte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach fragen oder etwas finden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Coach or find anything"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a Coach o busca lo que sea"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Küsi Coachilt või otsi midagi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander à Coach ou tout rechercher"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשאול את Coach או למצוא כל דבר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach से पूछें या कुछ भी खोजें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitajte Coacha ili pronađite bilo što"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérdezd a Coachot, vagy keress bármit"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարցրեք Coach-ին կամ գտեք ցանկացած բան"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanya Coach atau temukan apa saja"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a Coach o cerca qualsiasi cosa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coachに質問、または何でも検索"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჰკითხეთ Coach-ს ან მოძებნეთ ნებისმიერი რამ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សួរ Coach ឬស្វែងរកអ្វីក៏បាន"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach에게 묻거나 무엇이든 찾기"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຖາມ Coach ຫຼື ຄົ້ນຫາຫຍັງກໍໄດ້"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Klauskite Coach arba raskite bet ką"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jautā Coach vai atrodi jebko"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прашај го Coach или најди што било"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-аас асуух эсвэл юу ч хайх"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach लाई सोध्नुहोस् वा केही पनि खोज्नुहोस्"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach vragen of iets zoeken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj Coacha lub znajdź cokolwiek"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte ao Coach ou procure o que quiser"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte ao Coach ou procure o que quiser"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întrebați-l pe Coach sau căutați orice"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opýtajte sa Coacha alebo čokoľvek nájdite"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vprašajte Coacha ali poiščite karkoli"
