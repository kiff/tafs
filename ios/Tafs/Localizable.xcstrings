    "needs_you.expired_line": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgelaufen. Niemand hat rechtzeitig geantwortet, daher hat KIFF es abgelehnt, und es wurde nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expired. Nobody answered in time, so KIFF refused it and nothing was sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caducada. Nadie respondió a tiempo, así que KIFF la rechazó y no se envió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expiré. Personne n'a répondu à temps : KIFF l'a donc refusé et rien n'a été envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaduta. Nessuno ha risposto in tempo, quindi KIFF l'ha rifiutata e non è stato inviato nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlopen. Niemand antwoordde op tijd, dus KIFF heeft het geweigerd en is er niets verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygasło. Nikt nie odpowiedział na czas, więc KIFF to odrzucił i nic nie zostało wysłane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Expirado. Ninguém respondeu a tempo, por isso o KIFF recusou e nada foi enviado."
          }
        }
      }
    },
