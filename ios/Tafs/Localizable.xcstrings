        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ทำงานต่อตามที่เป็นอยู่ สิ่งที่เวอร์ชันนี้ทำเป็นของจริง ภายใต้ Card ของมันเอง"
