    "watch.check_phone_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«بانتظارك» مفتوحة هناك. وافق على الاستدعاء هناك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sizi gözləyir» orada açıqdır. Çağırışı orada təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Чака ви“ е отворено там. Одобрете заявката там."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "«আপনার অপেক্ষায়» সেখানে খোলা আছে। কলটি সেখানে অনুমোদন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«Et necessita» hi és obert. Aprova la crida allà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeká na vás je tam otevřené. Schvalte volání tam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht dich ist dort offen. Genehmige den Aufruf dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs you is open there. Approve the call there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te necesita está abierto allí. Aprueba la llamada allí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seal on avatud Vajab sind. Kinnita päring seal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous attend y est ouvert. Approuvez l'appel là-bas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "«זקוק לך» פתוח שם. יש לאשר שם את הקריאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका इंतज़ार वहाँ खुला है। कॉल को वहाँ मंज़ूर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeka vas je tamo otvoreno. Odobrite poziv tamo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Rád vár ott meg van nyitva. Ott hagyd jóvá a hívást."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«Սպասում է ձեզ»-ը այնտեղ բաց է։ Հաստատեք զանգը այնտեղ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu Anda terbuka di sana. Setujui panggilan di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti aspetta è aperto lì. Approva la chiamata lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンで要確認が開いています。そこで呼び出しを承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "„გელოდებათ“ იქ ღიაა. დაამტკიცეთ ზარი იქ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "«ត្រូវការអ្នក» បើកនៅទីនោះ។ អនុម័តការហៅនៅទីនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰에서 확인 필요가 열려 있습니다. 거기에서 호출을 승인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "«ຕ້ອງການທ່ານ» ເປີດຢູ່ບ່ອນນັ້ນ. ອະນຸມັດການໂທຢູ່ບ່ອນນັ້ນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten atidaryta „Laukia jūsų“. Patvirtinkite užklausą ten."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tur ir atvērts “Gaida tevi”. Apstiprini izsaukumu tur."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те чека е отворено таму. Одобри го барањето таму."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таныг хүлээж байна хэсэг тэнд нээлттэй байна. Дуудлагыг тэнд зөвшөөрнө үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको प्रतीक्षामा त्यहाँ खुला छ। कल त्यहीँ स्वीकृत गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht op jou staat daar open. Keur de aanroep daar goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czeka na Ciebie jest tam otwarte. Zatwierdź wywołanie tam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de si está aberto lá. Aprove a chamada lá."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de você está aberto lá. Aprove a chamada lá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă așteaptă este deschis acolo. Aprobați apelul acolo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čaká na vás je tam otvorené. Schváľte volanie tam."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam je odprto Čaka na vas. Tam odobrite klic."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ju pret është i hapur atje. Miratoni thirrjen atje."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeka vas je tamo otvoreno. Odobrite poziv tamo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอคุณอยู่เปิดอยู่ที่นั่น อนุมัติการเรียกที่นั่น"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Size garaşýar şol ýerde açyk. Çagyryşy şol ýerde tassyklaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizi bekliyor orada açık. Çağrıyı orada onaylayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ضرورت وہاں کھلی ہے۔ کال وہیں منظور کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ bạn đang mở ở đó. Hãy phê duyệt lượt gọi ở đó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「等您處理」已在那裡開啟。請在那裡核准呼叫。"
          }
        }
      }
    },
