    "voice.microphone_off_tafs_turn_settings": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميكروفون متوقف لـ tafs. شغّله من الإعدادات › tafs › الميكروفون."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon tafs üçün söndürülüb. Onu Parametrlər › tafs › Mikrofon bölməsində aktiv edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофонът е изключен за tafs. Включете го в Настройки › tafs › Микрофон."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোন tafs-এর জন্য বন্ধ। সেটিংস › tafs › মাইক্রোফোনে এটি চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El micròfon està desactivat per a tafs. Activa'l a Ajustos › tafs › Micròfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon je pro tafs vypnutý. Zapněte ho v Nastavení › tafs › Mikrofon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist für tafs ausgeschaltet. Schalte es unter Einstellungen › tafs › Mikrofon ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is off for tafs. Turn it on in Settings › tafs › Microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono está desactivado para tafs. Actívalo en Ajustes › tafs › Micrófono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon on tafsi jaoks välja lülitatud. Lülita see sisse menüüs Settings › tafs › Microphone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro est désactivé pour tafs. Activez-le dans Réglages › tafs › Micro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקרופון כבוי עבור tafs. יש להפעיל אותו בהגדרות › tafs › מיקרופון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन tafs के लिए बंद है। इसे Settings › tafs › Microphone में चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon je isključen za tafs. Uključite ga u Postavke › tafs › Mikrofon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofon ki van kapcsolva a tafs számára. Kapcsold be itt: Beállítások › tafs › Mikrofon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խոսափողը անջատված է tafs-ի համար։ Միացրեք՝ Կարգավորումներ › tafs › Խոսափող։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon nonaktif untuk tafs. Aktifkan di Pengaturan › tafs › Mikrofon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è disattivato per tafs. Attivalo in Impostazioni › tafs › Microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsのマイクがオフになっています。設定 › tafs › マイクでオンにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიკროფონი გამორთულია tafs-ისთვის. ჩართეთ პარამეტრები › tafs › მიკროფონი."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មីក្រូហ្វូនត្រូវបានបិទសម្រាប់ tafs។ បើកវាក្នុងការកំណត់ › tafs › មីក្រូហ្វូន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs의 마이크가 꺼져 있습니다. 설정 › tafs › 마이크에서 켜세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄມໂຄຣໂຟນປິດສຳລັບ tafs. ເປີດມັນໃນການຕັ້ງຄ່າ › tafs › ໄມໂຄຣໂຟນ."
