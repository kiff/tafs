    "pair.passkey_why_body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "O, bu %1$@ üzərində, %2$@ arxasında qalır. Onunla bu %1$@ taf-larınızın əməliyyatlarını təsdiq edir və heç nə siz olmadan təsdiqlənmir. Növbəti addımda Windows üzünüzü, barmaq izinizi və ya PIN-inizi istəyir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Остава на този %1$@, защитен с %2$@. С него този %1$@ одобрява действията на вашите tafs и нищо не се одобрява без вас. След това Windows ще поиска лицето, пръстовия ви отпечатък или ПИН."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstane na tomto zařízení (%1$@), chráněný přes %2$@. S ním toto zařízení schvaluje akce vašich tafů a bez vás se nic neschválí. Windows se pak zeptá na obličej, otisk prstu nebo PIN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bleibt auf diesem %1$@, geschützt durch %2$@. Damit genehmigt dieser %1$@ die Aktionen deiner tafs, und nichts wird ohne dich genehmigt. Windows fragt als Nächstes nach deinem Gesicht, deinem Fingerabdruck oder deiner PIN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays on this %1$@, behind %2$@. With it, this %1$@ approves your tafs' actions, and nothing is approved without you. Windows asks for your face, fingerprint or PIN next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en este %1$@, protegida por %2$@. Con ella, este %1$@ aprueba las acciones de tus tafs, y nada se aprueba sin ti. A continuación, Windows te pedirá tu cara, tu huella o tu PIN."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See jääb sellesse seadmesse (%1$@), kaitstuna %2$@ abil. Sellega kinnitab see %1$@ sinu tafide toiminguid ja ilma sinuta ei kinnitata midagi. Järgmiseks küsib Windows sinu nägu, sõrmejälge või PIN-koodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle reste sur %3$@, protégée par %2$@. Avec elle, %3$@ approuve les actions de vos tafs, et rien n'est approuvé sans vous. Windows vous demande ensuite votre visage, votre empreinte digitale ou votre code PIN."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostaje na ovom uređaju (%1$@) i otključava se uz: %2$@. S njim taj uređaj odobrava radnje vaših tafova, a ništa se ne odobrava bez vas. Windows zatim traži vaše lice, otisak prsta ili PIN."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen az eszközön (%1$@) marad, ezzel védve: %2$@. Vele ez az eszköz jóváhagyja a tafjaid műveleteit, és nélküled semmi sem lesz jóváhagyva. A Windows ezután az arcodat, ujjlenyomatodat vagy PIN-kódodat kéri."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն մնում է այս սարքում (%1$@), %2$@-ի հետևում։ Դրանով այս սարքը (%1$@) հաստատում է ձեր taf-երի գործողությունները, և ոչինչ չի հաստատվում առանց ձեզ։ Windows-ը հաջորդ քայլին կխնդրի ձեր դեմքը, մատնահետքը կամ PIN-ը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap berada di %1$@ ini dan dibuka dengan: %2$@. Dengannya %1$@ ini menyetujui tindakan tafs Anda, dan tidak ada yang disetujui tanpa Anda. Windows kemudian meminta wajah, sidik jari, atau PIN Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta su questo %1$@, protetta da %2$@. Così questo %1$@ può approvare le azioni dei tuoi tafs, e nulla viene approvato senza di te. Poi Windows ti chiederà il volto, l'impronta digitale o il PIN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスキーは%2$@で保護され、この%1$@に保存されます。これにより、この%1$@でtafsの操作を承認でき、あなたなしで承認されることはありません。次にWindowsが顔、指紋、またはPINを求めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ის რჩება ამ მოწყობილობაზე (%1$@), ამის უკან: %2$@. მისით ეს მოწყობილობა (%1$@) ამტკიცებს თქვენი taf-ების მოქმედებებს და არაფერი მტკიცდება თქვენ გარეშე. Windows შემდეგ გკითხავთ თქვენს სახეს, თითის ანაბეჭდს ან PIN-ს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패스키는 %2$@(으)로 보호되어 이 %1$@에 남습니다. 패스키가 있으면 이 %1$@에서 tafs의 행동을 승인하며, 내가 없으면 아무것도 승인되지 않습니다. 다음으로 Windows가 얼굴, 지문 또는 PIN을 요청합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jis lieka šiame įrenginyje (%1$@), apsaugotas: %2$@. Su juo šis įrenginys tvirtina jūsų taf veiksmus, ir niekas nepatvirtinama be jūsų. Toliau Windows paprašys jūsų veido, piršto atspaudo ar PIN."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā paliek šajā ierīcē (%1$@), aizsargāta ar %2$@. Ar to šis %1$@ apstiprina tavu taf darbības, un nekas netiek apstiprināts bez tevis. Tālāk Windows prasīs tavu seju, pirksta nospiedumu vai PIN."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij blijft op deze %1$@, beveiligd met %2$@. Daarmee keurt deze %1$@ de acties van je tafs goed, en niets wordt goedgekeurd zonder jou. Daarna vraagt Windows om je gezicht, vingerafdruk of pincode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaje na tym urządzeniu (%1$@), chroniony przez %2$@. Dzięki niemu to urządzenie zatwierdza działania Twoich tafs, a nic nie zostanie zatwierdzone bez Ciebie. Następnie Windows poprosi o twarz, odcisk palca lub PIN."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica neste %1$@, protegida pelo %2$@. Com ela, este %1$@ aprova as ações dos seus tafs, e nada é aprovado sem si. A seguir, o Windows pede o seu rosto, impressão digital ou PIN."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela fica neste %1$@, protegida por %2$@. Com ela, este %1$@ aprova as ações dos seus tafs, e nada é aprovado sem você. A seguir, o Windows pede o seu rosto, impressão digital ou PIN."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rămâne pe acest dispozitiv (%1$@), protejată de %2$@. Cu ea, acest dispozitiv aprobă acțiunile tafurilor dvs. și nimic nu se aprobă fără dvs. Windows vă cere apoi fața, amprenta sau PIN-ul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostane na tomto zariadení (%1$@), chránený cez %2$@. S ním toto zariadenie schvaľuje akcie vašich tafov a bez vás sa nič neschváli. Windows sa potom opýta na tvár, odtlačok prsta alebo PIN."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostane na tej napravi (%1$@), zaščiten z %2$@. Z njim ta naprava odobrava dejanja vaših tafov in brez vas ni odobreno nič. Windows vas bo nato vprašal za obraz, prstni odtis ali PIN."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Qëndron në këtë pajisje (%1$@), pas: %2$@. Me të, kjo pajisje (%1$@) miraton veprimet e tafs-eve tuaj, dhe asgjë nuk miratohet pa ju. Windows kërkon më pas fytyrën, gjurmën e gishtit ose PIN-in tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostaje na ovom uređaju (%1$@) i otključava se uz: %2$@. S njim taj uređaj odobrava radnje vaših tafova, a ništa se ne odobrava bez vas. Windows zatim traži vaše lice, otisak prsta ili PIN."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันอยู่บน%1$@เครื่องนี้ ภายใต้การป้องกันของ %2$@ ด้วยมัน %1$@เครื่องนี้อนุมัติการกระทำของ taf ของคุณได้ และจะไม่มีอะไรถูกอนุมัติโดยไม่มีคุณ ถัดไป Windows จะขอใบหน้า ลายนิ้วมือ หรือ PIN ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ üzerinde kalır ve şunun arkasında durur: %2$@. Onunla bu %1$@, tafs'larınızın eylemlerini onaylar ve sizsiz hiçbir şey onaylanmaz. Windows sonra yüzünüzü, parmak izinizi veya PIN'inizi ister."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó nằm lại trên %1$@ này và được mở bằng: %2$@. Nhờ nó, %1$@ này phê duyệt các hành động của tafs của bạn, và không có gì được phê duyệt nếu thiếu bạn. Windows sẽ hỏi khuôn mặt, vân tay hoặc PIN của bạn tiếp theo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會留在這部%1$@上，並受%2$@保護。有了它，這部%1$@就能核准您的 taf 的動作，且沒有您就不會核准任何項目。接下來 Windows 會要求您提供臉部、指紋或 PIN。"
          }
        }
      }
    },
