          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo taf non lavora finché non viene installata o non annulli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールするかキャンセルするまで、tafは動きません。"
