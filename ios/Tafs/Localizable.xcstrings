        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não conseguiu bloquear os seus tafs. %1$@ Abra o tafs para os bloquear."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nu a putut opri tafurile dvs. %1$@ Deschideți tafs pentru a le opri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nemohol zastaviť vaše tafy. %1$@ Zastavte ich v aplikácii tafs."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ni mogel ustaviti vaših tafov. %1$@ Ustavite jih v aplikaciji tafs."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nuk i bllokoi dot tafs-et tuaj. %1$@ Hapni tafs për t'i bllokuar."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nije mogao blokirati vaše tafove. %1$@ Otvorite tafs da ih blokirate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ระงับ taf ของคุณไม่ได้ %1$@ เปิด tafs เพื่อระงับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs, tafs'larınızı donduramadı. %1$@ Dondurmak için tafs'ı açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs không thể đóng băng các tafs của bạn. %1$@ Hãy mở tafs để đóng băng chúng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs 無法凍結您的 taf。%1$@請開啟 tafs 來凍結。"
          }
        }
      }
    },
    "halt_all.halted_all": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-larınız donduruldu. Siz davam etdirənə qədər heç nə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите tafs са спрени. Нищо ново не се изпраща, докато не възобновите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy jsou zastavené. Nic nového se neodešle, dokud je znovu nespustíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs sind angehalten. Nichts Neues wird gesendet, bis du fortsetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halted your tafs. Nothing new is sent until you resume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tafs están bloqueados. No se envía nada nuevo hasta que reanudes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tafid on peatatud. Midagi uut ei saadeta enne, kui jätkad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tafs sont bloqués. Rien de nouveau n'est envoyé tant que vous ne reprenez pas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafovi su blokirani. Ništa novo ne šalje se dok ne nastavite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafjaid leállítva. Semmi új nem megy ki, amíg nem folytatod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր taf-երը կանգնեցվեցին։ Ոչինչ չի ուղարկվում, մինչև չվերսկսեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tafs Anda dibekukan. Tidak ada yang baru dikirim sampai Anda melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tafs sono bloccati. Non viene inviato nulla di nuovo finché non riprendi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsを遮断しました。再開するまで、新しいものは何も送信されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი taf-ები გაჩერდა. არაფერი იგზავნება, სანამ არ განაახლებთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs를 차단했습니다. 재개할 때까지 새로 보내는 것은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų taf sustabdyti. Nieko naujo nesiunčiama, kol netęsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavi taf ir apturēti. Nekas jauns netiek sūtīts, līdz tu turpini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tafs zijn stilgezet. Er wordt niets nieuws verzonden tot je hervat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje tafs są zablokowane. Nic nowego nie zostanie wysłane, dopóki nie wznowisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs estão bloqueados. Nada de novo é enviado até retomar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs estão bloqueados. Nada de novo é enviado até retomar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafurile dvs. sunt oprite. Nimic nou nu se trimite până nu reluați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy sú zastavené. Nič nové sa neodošle, kým ich znova nespustíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafi so ustavljeni. Nič novega se ne pošlje, dokler jih ne zaženete znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs-et tuaj u bllokuan. Asgjë e re nuk dërgohet derisa t'i riniseni."
