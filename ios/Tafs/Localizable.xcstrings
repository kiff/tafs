    "door.api.paused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen werden abgelehnt, bis du sie öffnest. Was schon getan ist, wird nicht rückgängig gemacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests are refused until you open it. Nothing already done is undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes se rechazan hasta que la abras. No se deshace nada de lo ya hecho."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Päringutest keeldutakse, kuni selle avad. Juba tehtut tagasi ei võeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les requêtes sont refusées jusqu'à ce que vous l'ouvriez. Rien de ce qui est déjà fait n'est annulé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste vengono rifiutate finché non la apri. Nulla di ciò che è già stato fatto viene annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開くまでリクエストは拒否されます。すでに完了したものは元に戻りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열 때까지 요청이 거절됩니다. 이미 한 일은 되돌려지지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užklausos atmetamos, kol neatidarysite durų. Kas jau padaryta, neatšaukiama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieprasījumi tiek atteikti, līdz tu tās atver. Jau izdarītais paliek spēkā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzoeken worden geweigerd tot je hem opent. Wat al gedaan is, wordt niet teruggedraaid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądania są odrzucane, dopóki ich nie otworzysz. Nic, co już zrobiono, nie zostaje cofnięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos são recusados até a abrir. Nada do que já foi feito é desfeito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos são recusados até a abrir. Nada do que já foi feito é desfeito."
          }
        }
      }
    },
