    "version.intro": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiyanı quraşdırmaq onu irəliyə və ya geriyə işləyən versiya edir. Bir təsdiq hamısını əhatə edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирането на версия я прави активна, напред или назад. Едно потвърждение покрива всичко."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalace verze z ní udělá aktivní verzi, dopředu i zpět. Stačí jedno potvrzení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Version installierst, wird sie zur Live-Version, ob neuer oder älter. Eine Bestätigung genügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing a version makes it the live version, forward or back. One confirmation covers it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar una versión la convierte en la versión activa, hacia delante o hacia atrás. Una sola confirmación basta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiooni paigaldamine võtab selle kasutusele, olgu uuem või vanem. Selleks piisab ühest kinnitusest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer une version la met en service, plus récente ou plus ancienne. Une seule confirmation suffit."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacija verzije čini je verzijom u radu, naprijed ili natrag. Pokriva je jedna potvrda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy verzió telepítése azt teszi élő verzióvá, akár újabb, akár régebbi. Egyetlen megerősítés elég hozzá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տարբերակի տեղադրումը այն դարձնում է ակտիվ տարբերակ՝ առաջ կամ հետ։ Մեկ հաստատումը ծածկում է դա։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memasang sebuah versi menjadikannya versi aktif, maju atau mundur. Satu konfirmasi mencakupnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installare una versione la rende la versione attiva, in avanti o indietro. Basta una conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンをインストールすると、新しいものでも古いものでも、それが適用中のバージョンになります。確認は1回で済みます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერსიის დაყენება მას აქტიურ ვერსიად ხდის, წინ თუ უკან. ერთი დადასტურება ამას ფარავს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전을 설치하면 앞으로든 뒤로든 그 버전이 적용됩니다. 한 번의 확인으로 충분합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įdiegta versija tampa aktyvia, ar ji naujesnė, ar senesnė. Užtenka vieno patvirtinimo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalējot versiju, tā kļūst par darbā esošo versiju, uz priekšu vai atpakaļ. To aptver viens apstiprinājums."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een versie installeren maakt er de live versie van, vooruit of terug. Eén bevestiging is genoeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacja wersji czyni ją wersją działającą na żywo, nowszą lub starszą. Wystarczy jedno potwierdzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar uma versão torna-a a versão em produção, para a frente ou para trás. Uma confirmação basta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar uma versão torna-a a versão em produção, para a frente ou para trás. Uma confirmação basta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalarea unei versiuni o face versiunea activă, înainte sau înapoi. O singură confirmare acoperă totul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Inštalácia verzie z nej urobí aktívnu verziu, dopredu aj späť. Stačí jedno potvrdenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namestitev različice jo naredi za aktivno, naprej ali nazaj. Zadošča ena potrditev."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalimi i një versioni e bën atë versionin aktiv, përpara ose prapa. Një konfirmim e mbulon."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacija verzije čini je verzijom u radu, napred ili natrag. Pokriva je jedna potvrda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การติดตั้งเวอร์ชันจะทำให้เป็นเวอร์ชันที่ใช้งาน ไม่ว่าไปข้างหน้าหรือย้อนหลัง การยืนยันครั้งเดียวครอบคลุมทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sürümü kurmak onu, ileri ya da geri, yayındaki sürüm yapar. Tek bir onay yeter."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài một phiên bản sẽ đưa nó thành phiên bản đang chạy, dù tiến hay lùi. Một lần xác nhận là đủ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝一個版本會讓它成為生效的版本，不論是往前或往後。一次確認即可。"
          }
        }
      }
    },
