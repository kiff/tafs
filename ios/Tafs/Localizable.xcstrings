    "connect.disconnect.no_taf_uses": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein taf nutzt diese %1$@-Verbindung mehr. Ihre Tools verlassen KIFF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No taf uses this %1$@ connection now. Its tools leave KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún taf usa ahora esta conexión de %1$@. Sus herramientas salen de KIFF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun taf n'utilise cette connexion %1$@ désormais. Ses outils quittent KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun taf usa ora questo collegamento %1$@. I suoi strumenti escono da KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkel taf gebruikt deze %1$@-koppeling nu. De tools ervan verdwijnen uit KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden taf nie używa teraz tego połączenia %1$@. Jego narzędzia znikną z KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum taf usa agora esta ligação a %1$@. As suas ferramentas saem do KIFF."
          }
        }
      }
    },
    "connect.disconnect.rest": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Verbindungen zu %1$@ bleiben verbunden. Nutzt keine andere Verbindung diese Anmeldung, wird sie bei %1$@ widerrufen. Beim erneuten Verbinden wirst du gebeten, erneut zu genehmigen und dich erneut anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other connections to %1$@ stay connected. If no other connection uses this sign-in, it's revoked at %1$@. Connecting again asks you to approve and sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las demás conexiones a %1$@ siguen conectadas. Si ninguna otra conexión usa este inicio de sesión, se revoca en %1$@. Volver a conectar te pide aprobar e iniciar sesión otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres connexions à %1$@ restent connectées. Si aucune autre connexion n'utilise cet identifiant, il est révoqué chez %1$@. Connecter à nouveau vous demande d'approuver et de vous reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri collegamenti a %1$@ restano collegati. Se nessun altro collegamento usa questo accesso, viene revocato su %1$@. Per collegarlo di nuovo dovrai approvare e accedere di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere koppelingen met %1$@ blijven gekoppeld. Als geen andere koppeling deze login gebruikt, wordt die bij %1$@ ingetrokken. Opnieuw koppelen vraagt je opnieuw goed te keuren en in te loggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne połączenia z %1$@ pozostaną połączone. Jeśli żadne inne połączenie nie używa tego logowania, zostanie ono unieważnione w %1$@. Ponowne połączenie wymaga ponownego zatwierdzenia i zalogowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As outras ligações a %1$@ continuam ligadas. Se nenhuma outra ligação usar este início de sessão, é revogado em %1$@. Ligar novamente pede-lhe para aprovar e iniciar sessão novamente."
          }
        }
      }
    },
