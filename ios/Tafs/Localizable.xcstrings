    "alert.watch_first.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لترى الموافقات والإجابات كتنبيهات على هذا الهاتف وعلى ساعتك، شغّل التنبيهات لـ tafs. ستظل ساعتك تتلقى تحديثاتها حتى إن لم تفعل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təsdiqləri və cavabları bu telefonda və saatınızda bildiriş kimi görmək üçün tafs bildirişlərini aktiv edin. Aktiv etməsəniz də, saatınız yeniləmələrini almağa davam edəcək."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да виждате одобренията и отговорите като известия на този телефон и на часовника си, включете известията за tafs. Часовникът ви ще продължи да получава актуализациите си, дори и да не го направите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনে ও আপনার ঘড়িতে অনুমোদন ও উত্তর অ্যালার্ট হিসেবে দেখতে tafs-এর অ্যালার্ট চালু করুন। চালু না করলেও আপনার ঘড়ি আপডেট পেতে থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per veure les aprovacions i les respostes com a alertes, en aquest telèfon i al rellotge, activa les alertes de tafs. El rellotge continuarà rebent les actualitzacions encara que no ho facis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li vidět schválení a odpovědi jako upozornění v tomto telefonu i v hodinkách, zapněte upozornění pro tafs. Hodinky budou dostávat aktualizace, i když to neuděláte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Genehmigungen und Antworten als Benachrichtigungen zu sehen, auf diesem Telefon und auf deiner Uhr, schalte die Benachrichtigungen für tafs ein. Deine Uhr bekommt ihre Updates auch, wenn du es nicht tust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see approvals and answers as alerts, on this phone and on your watch, turn on alerts for tafs. Your watch keeps getting its updates even if you don't."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver las aprobaciones y respuestas como alertas, en este teléfono y en tu reloj, activa las alertas de tafs. Tu reloj seguirá recibiendo sus actualizaciones aunque no lo hagas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Et näha kinnitusi ja vastuseid teavitustena selles telefonis ja kellas, lülita tafsi teavitused sisse. Kell saab oma uuendusi ka siis, kui sa seda ei tee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour voir les approbations et les réponses en alertes, sur ce téléphone et sur votre montre, activez les alertes de tafs. Votre montre continue de recevoir ses mises à jour même si vous ne le faites pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לראות אישורים ותשובות כהתראות, בטלפון הזה ובשעון, יש להפעיל את ההתראות של tafs. השעון ימשיך לקבל את העדכונים שלו גם בלי זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन पर और अपनी घड़ी पर मंज़ूरियाँ और जवाब अलर्ट के रूप में देखने के लिए tafs के अलर्ट चालू करें। चालू न करें तब भी आपकी घड़ी को अपडेट मिलते रहेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da biste odobrenja i odgovore vidjeli kao obavijesti, na ovom telefonu i na satu, uključite obavijesti za tafs. Sat će i dalje primati svoja ažuriranja i ako to ne učinite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a jóváhagyásokat és a válaszokat riasztásként szeretnéd látni ezen a telefonon és az órádon, kapcsold be a tafs riasztásait. Az órád akkor is megkapja a frissítéseit, ha nem teszed meg."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաստատումներն ու պատասխանները ծանուցումների տեսքով այս հեռախոսում և ձեր ժամացույցում տեսնելու համար միացրեք tafs-ի ծանուցումները։ Ձեր ժամացույցը կշարունակի ստանալ իր թարմացումները, նույնիսկ եթե չմիացնեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat persetujuan dan jawaban sebagai peringatan, di ponsel ini dan di jam tangan Anda, aktifkan peringatan untuk tafs. Jam tangan Anda tetap menerima pembaruannya meski Anda tidak mengaktifkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per vedere approvazioni e risposte come avvisi, su questo telefono e sull'orologio, attiva gli avvisi di tafs. L'orologio continua a ricevere i suoi aggiornamenti anche se non lo fai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認や回答をこのスマートフォンとウォッチで通知として受け取るには、tafsの通知をオンにしてください。オンにしなくても、ウォッチは更新を受け取り続けます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დადასტურებებისა და პასუხების შეტყობინებებად სანახავად ამ ტელეფონზე და საათზე, ჩართეთ tafs-ის შეტყობინებები. საათი განახლებებს მაინც მიიღებს, თუნდაც არ ჩართოთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដើម្បីមើលការអនុម័ត និងចម្លើយជាការជូនដំណឹង នៅលើទូរសព្ទនេះ និងនាឡិការបស់អ្នក សូមបើកការជូនដំណឹងសម្រាប់ tafs។ នាឡិការបស់អ្នកនៅតែទទួលបានបច្ចុប្បន្នភាព ទោះបីអ្នកមិនបើកក៏ដោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰과 시계에서 승인과 답변을 알림으로 보려면 tafs 알림을 켜세요. 켜지 않아도 시계는 계속 업데이트를 받습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພື່ອເບິ່ງການອະນຸມັດ ແລະ ຄຳຕອບເປັນການແຈ້ງເຕືອນ, ໃນໂທລະສັບນີ້ ແລະ ໃນໂມງຂອງທ່ານ, ໃຫ້ເປີດການແຈ້ງເຕືອນສຳລັບ tafs. ໂມງຂອງທ່ານຍັງຈະໄດ້ຮັບການອັບເດດ ເຖິງທ່ານບໍ່ເປີດກໍຕາມ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad matytumėte patvirtinimus ir atsakymus kaip pranešimus šiame telefone ir laikrodyje, įjunkite tafs pranešimus. Laikrodis toliau gaus savo naujinius, net jei to nepadarysite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai redzētu apstiprinājumus un atbildes kā paziņojumus šajā tālrunī un pulkstenī, ieslēdz tafs paziņojumus. Pulkstenis turpinās saņemt savus atjauninājumus, pat ja to nedarīsi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "За да ги гледаш одобренијата и одговорите како известувања, на овој телефон и на часовникот, вклучи ги известувањата за tafs. Часовникот ќе продолжи да ги добива ажурирањата и ако не го направиш тоа."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөвшөөрөл, хариултыг энэ утас болон цагтаа мэдэгдэл хэлбэрээр харахын тулд tafs-ын мэдэгдлийг асаана уу. Асаахгүй байсан ч цаг тань шинэчлэлтээ авсаар байна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वीकृति र जवाफलाई यो फोन र तपाईंको घडीमा सूचनाको रूपमा हेर्न tafs को सूचना खोल्नुहोस्। नखोले पनि तपाईंको घडीले अपडेट पाइरहनेछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet meldingen voor tafs aan om goedkeuringen en antwoorden als melding te zien, op deze telefoon en op je horloge. Je horloge blijft zijn updates krijgen, ook als je dat niet doet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby widzieć zatwierdzenia i odpowiedzi jako alerty, na tym telefonie i na zegarku, włącz alerty tafs. Zegarek będzie dostawać swoje aktualizacje, nawet jeśli tego nie zrobisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver as aprovações e as respostas como alertas, neste telefone e no seu relógio, ative os alertas do tafs. O relógio continua a receber as atualizações mesmo que não o faça."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver as aprovações e as respostas como alertas, neste telefone e no seu relógio, ative os alertas do tafs. O relógio continua recebendo as atualizações mesmo que você não ative."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca să vedeți aprobările și răspunsurile ca alerte, pe acest telefon și pe ceas, activați alertele tafs. Ceasul va primi în continuare actualizările, chiar dacă nu o faceți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete vidieť schválenia a odpovede ako upozornenia v tomto telefóne aj v hodinkách, zapnite upozornenia pre tafs. Hodinky budú dostávať aktualizácie, aj keď to neurobíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite odobritve in odgovore videti kot opozorila na tem telefonu in na uri, vklopite opozorila za tafs. Ura bo še naprej dobivala svoje posodobitve, tudi če tega ne storite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Për të parë miratimet dhe përgjigjet si njoftime, në këtë telefon dhe në orën tuaj, aktivizoni njoftimet për tafs. Ora do të vazhdojë t'i marrë përditësimet edhe nëse nuk e bëni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Da biste odobrenja i odgovore videli kao obaveštenja, na ovom telefonu i na satu, uključite obaveštenja za tafs. Sat i dalje dobija svoja ažuriranja i ako to ne uradite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเห็นการอนุมัติและคำตอบเป็นการแจ้งเตือน บนโทรศัพท์เครื่องนี้และบนนาฬิกา ให้เปิดการแจ้งเตือนสำหรับ tafs นาฬิกาของคุณยังคงได้รับการอัปเดตแม้คุณไม่เปิด"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tassyklamalary we jogaplary bu telefonda we sagadyňyzda duýduryş hökmünde görmek üçin tafs duýduryşlaryny açyň. Açmasaňyz hem, sagadyňyz täzelenmelerini almagy dowam etdirer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayları ve yanıtları bu telefonda ve saatinizde uyarı olarak görmek için tafs uyarılarını açın. Açmasanız da saatiniz güncellemelerini almaya devam eder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فون اور اپنی گھڑی پر منظوریاں اور جوابات الرٹس کے طور پر دیکھنے کے لیے tafs کے الرٹس چالو کریں۔ چالو نہ کریں تب بھی آپ کی گھڑی کو اپڈیٹس ملتے رہیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xem phê duyệt và câu trả lời dưới dạng cảnh báo, trên điện thoại này và trên đồng hồ, hãy bật cảnh báo cho tafs. Đồng hồ của bạn vẫn tiếp tục nhận cập nhật kể cả khi bạn không bật."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在這部手機和手錶上以通知查看核准與回答，請開啟 tafs 的通知。即使不開啟，手錶仍會持續收到更新。"
          }
        }
      }
    },
