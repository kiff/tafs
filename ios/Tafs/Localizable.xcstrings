            "value": "Demander depuis la montre n'est pas encore activé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitanja sa sata još nisu uključena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az óráról való kérdezés még nincs bekapcsolva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր ժամացույցից հարցնելը դեռ միացված չէ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bertanya dari jam tangan Anda belum aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedere dall'orologio non è ancora attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチからの質問はまだオンになっていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
