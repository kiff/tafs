    "alert.open_tafs_answer_kiff_did": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cavab vermək üçün tafs-ı açın: KIFF hansı versiyanı gördüyünüzü demədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете tafs, за да отговорите: KIFF не каза коя версия сте видели."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete tafs a odpovězte: KIFF neřekl, kterou verzi jste viděli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne tafs, um zu antworten: KIFF hat nicht gesagt, welche Version du gesehen hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open tafs to answer it: KIFF didn't say which version of it you saw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre tafs para responder: KIFF no indicó qué versión viste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastamiseks ava tafs: KIFF ei öelnud, millist selle versiooni sa nägid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez tafs pour y répondre : KIFF n'a pas indiqué quelle version vous avez vue."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite tafs da odgovorite: KIFF nije rekao koju ste verziju vidjeli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a tafst a válaszhoz: a KIFF nem jelezte, melyik verzióját láttad."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացեք tafs-ը՝ պատասխանելու համար․ KIFF-ը չասաց, թե որ տարբերակը տեսաք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka tafs untuk menjawabnya: KIFF tidak menyebutkan versi mana yang Anda lihat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri tafs per rispondere: KIFF non ha indicato quale versione hai visto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsを開いて回答してください：KIFFは、あなたが見たバージョンを伝えませんでした。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გახსენით tafs, რომ უპასუხოთ: KIFF-მა არ თქვა, რომელი ვერსია ნახეთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs를 열어 응답하세요. KIFF가 내가 본 버전을 알려 주지 않았습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atidarykite tafs ir atsakykite: KIFF nenurodė, kurią jos versiją matėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atver tafs, lai atbildētu: KIFF nepateica, kuru tā versiju tu redzēji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open tafs om te antwoorden: KIFF gaf niet aan welke versie je hebt gezien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz tafs, aby odpowiedzieć: KIFF nie podał, którą jego wersję widzisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o tafs para responder: o KIFF não indicou que versão do pedido viu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o tafs para responder: o KIFF não indicou que versão do pedido viu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți tafs pentru a răspunde: KIFF nu a spus ce versiune ați văzut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte tafs a odpovedzte: KIFF nepovedal, ktorú verziu ste videli."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite tafs in odgovorite: KIFF ni povedal, katero različico ste videli."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapni tafs për t'u përgjigjur: KIFF nuk tha cilin version e keni parë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite tafs da odgovorite: KIFF nije rekao koju ste verziju videli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด tafs เพื่อตอบ: KIFF ไม่ได้บอกว่าคุณเห็นเวอร์ชันใดของมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlamak için tafs'ı açın: KIFF hangi sürümünü gördüğünüzü söylemedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở tafs để trả lời: KIFF không cho biết bạn đã thấy phiên bản nào của nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟 tafs 回覆：KIFF 未說明您看到的是哪個版本。"
          }
        }
      }
    },
