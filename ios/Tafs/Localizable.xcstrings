    "alert.allow_notifications": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Benachrichtigungen für tafs in den Einstellungen und versuch es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications for tafs in Settings, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las notificaciones de tafs en Ajustes y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications pour tafs dans Réglages, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le notifiche per tafs in Impostazioni, poi riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta meldingen voor tafs toe in Instellingen en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól tafs na powiadomienia w Ustawieniach, a potem spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita as notificações do tafs nas Definições e tente novamente."
          }
        }
      }
    },
