        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកដែលអនុម័តលើគណនីនេះឆ្លើយរឿងនេះ។ ចម្លើយរបស់ពួកគេបង្ហាញនៅទីនេះ។"
          }
