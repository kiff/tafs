        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gràcies. Algú de KIFF llegirà el teu informe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Děkujeme. Vaše hlášení si v KIFF někdo přečte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Jemand bei KIFF wird deine Meldung lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks. Someone at KIFF will read your report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias. Alguien de KIFF leerá tu reporte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aitäh. Keegi KIFFis loeb sinu teadet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci. Une personne chez KIFF lira votre signalement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תודה. מישהו ב-KIFF יקרא את הדיווח שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धन्यवाद। KIFF में कोई आपकी रिपोर्ट पढ़ेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvala. Netko iz KIFF-a pročitat će vašu prijavu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Köszönjük. Valaki a KIFF-nél elolvassa a jelentésedet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Շնորհակալություն։ KIFF-ում ինչ-որ մեկը կկարդա ձեր հաղորդումը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih. Seseorang di KIFF akan membaca laporan Anda."
