    "coach.taken.named": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach kann seine Tools noch nicht bekommen: Ein anderes Tool in KIFF heißt %1$@. Benenne es in KIFF um oder entferne es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach can't have its tools yet: another tool in KIFF is named %1$@. Rename or remove it in KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach aún no puede tener sus herramientas: otra herramienta en KIFF se llama %1$@. Cámbiale el nombre o elimínala en KIFF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ne peut pas encore avoir ses outils : un autre outil dans KIFF s'appelle %1$@. Renommez-le ou supprimez-le dans KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach non può ancora avere i suoi strumenti: un altro strumento in KIFF si chiama %1$@. Rinominalo o rimuovilo in KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach kan zijn tools nog niet krijgen: een andere tool in KIFF heet %1$@. Hernoem of verwijder die in KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach nie może jeszcze dostać swoich narzędzi: inne narzędzie w KIFF nazywa się %1$@. Zmień jego nazwę lub usuń je w KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach ainda não pode ter as suas ferramentas: outra ferramenta no KIFF chama-se %1$@. Mude-lhe o nome ou remova-a no KIFF."
          }
        }
      }
    },
    "coach.taken.unnamed": {
