    "alert.alerts_almost_tafs_cloud_did": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنبيهات على وشك التفعيل: لم يرد tafs cloud (%1$@). اضغط «تشغيل التنبيهات» مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişlər demək olar ki, aktivdir: tafs cloud cavab vermədi (%1$@). «Bildirişləri aktiv edin» düyməsinə yenidən toxunun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Известията са почти включени: tafs cloud не отговори (%1$@). Докоснете отново „Включване на известията“."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্ট প্রায় চালু: tafs cloud সাড়া দেয়নি (%1$@)। আবার «অ্যালার্ট চালু করুন» চাপুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes estan gairebé activades: tafs cloud no ha respost (%1$@). Torna a tocar «Activa les alertes»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění jsou skoro zapnutá: tafs cloud neodpověděl (%1$@). Klepněte znovu na Zapnout upozornění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
