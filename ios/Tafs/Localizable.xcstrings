    "taf.works_from_chat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er arbeitet, wenn du es ihm in seinem Chat sagst: Kein Zeitplan führt ihn aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It works when you tell it, in its chat: no schedule runs it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja cuando se lo dices, en su chat: ninguna programación lo ejecuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il travaille quand vous le lui demandez, dans son chat : aucun planning ne le lance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavora quando glielo dici, nella sua chat: nessuna pianificazione lo avvia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het werkt als je het zegt, in de chat: geen planning start het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa, gdy mu powiesz, w swoim czacie: żaden harmonogram go nie uruchamia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalha quando lhe diz, no seu chat: nenhum agendamento o executa."
          }
        }
      }
    },
