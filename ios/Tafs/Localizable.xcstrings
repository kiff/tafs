    "card.limit_can_not_raised_right": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit hazırda buradan artırıla bilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимитът не може да бъде увеличен оттук в момента."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit teď odsud nelze zvýšit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit lässt sich gerade nicht von hier aus erhöhen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limit can't be raised from here right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se puede subir el límite desde aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiiti ei saa praegu siit suurendada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite ne peut pas être relevée d'ici pour le moment."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograničenje se trenutačno ne može podići odavde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A limit most innen nem emelhető."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահմանաչափը հիմա այստեղից հնարավոր չէ բարձրացնել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas tidak dapat dinaikkan dari sini saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite non può essere aumentato da qui in questo momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、ここから上限を引き上げることはできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლიმიტი ახლა აქედან ვერ გაიზრდება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 여기서 한도를 올릴 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiuo metu limito čia padidinti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitu pašlaik nevar palielināt no šejienes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De limiet kan nu niet vanaf hier worden verhoogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitu nie można teraz podnieść stąd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento não é possível aumentar o limite a partir daqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento não é possível aumentar o limite a partir daqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita nu poate fi mărită de aici acum."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit teraz odtiaľto nemožno zvýšiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omejitve trenutno ni mogoče zvišati od tu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kufiri nuk mund të rritet që këtu tani."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograničenje trenutno ne može da se podigne odavde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้เพิ่มขีดจำกัดจากที่นี่ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit şu anda buradan yükseltilemiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chưa thể nâng giới hạn từ đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法從這裡提高上限。"
          }
        }
      }
    },
    "card.limit_raised_read_balance_again": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit artırıldı. Yenidən artırmazdan əvvəl balansı bir daha oxuyun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимитът беше увеличен. Прочетете наличността отново, преди да го увеличите пак."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit byl zvýšen. Než ho zvýšíte znovu, načtěte zůstatek znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit wurde erhöht. Lies das Guthaben erneut, bevor du es noch einmal erhöhst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limit was raised. Read the balance again before raising it once more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se subió el límite. Vuelve a leer el saldo antes de subirlo otra vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiiti suurendati. Enne uuesti suurendamist loe saldo uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite a été relevée. Relisez le solde avant de la relever encore."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograničenje je podignuto. Pročitajte stanje ponovno prije nego što ga podignete još jednom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A limit meg lett emelve. Mielőtt újra emeled, olvasd be újra az egyenleget."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահմանաչափը բարձրացվեց։ Նորից կարդացեք մնացորդը, նախքան կրկին բարձրացնելը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas dinaikkan. Baca saldo lagi sebelum menaikkannya sekali lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite è stato aumentato. Rileggi il saldo prima di aumentarlo ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限を引き上げました。もう一度引き上げる前に残高を再確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლიმიტი გაიზარდა. წაიკითხეთ ბალანსი ხელახლა, სანამ კიდევ გაზრდით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도를 올렸습니다. 다시 올리기 전에 잔액을 다시 확인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitas padidintas. Prieš didindami dar kartą, iš naujo nuskaitykite likutį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits tika palielināts. Pirms to palielini vēlreiz, vēlreiz nolasi atlikumu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De limiet is verhoogd. Lees het saldo opnieuw voordat je hem nog eens verhoogt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit został podniesiony. Odczytaj saldo ponownie, zanim podniesiesz go jeszcze raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite foi aumentado. Leia o saldo novamente antes de o aumentar outra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite foi aumentado. Leia o saldo novamente antes de o aumentar outra vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita a fost mărită. Citiți din nou soldul înainte de a o mări încă o dată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit bol zvýšený. Kým ho zvýšite znova, načítajte zostatok znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omejitev je bila zvišana. Preden jo znova zvišate, znova preberite stanje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kufiri u rrit. Lexoni sërish gjendjen para se ta rrisni edhe një herë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograničenje je podignuto. Ponovo pročitajte stanje pre nego što ga podignete još jednom."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มขีดจำกัดแล้ว อ่านยอดคงเหลืออีกครั้งก่อนเพิ่มอีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit yükseltildi. Bir kez daha yükseltmeden önce bakiyeyi tekrar okuyun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn đã được nâng. Hãy đọc lại số dư trước khi nâng thêm lần nữa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上限已提高。再次提高之前，請重新讀取餘額。"
          }
        }
      }
    },
