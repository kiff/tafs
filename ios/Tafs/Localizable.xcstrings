    "taf.memory.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts. Er schreibt auf, was er darüber lernt, wie du die Aufgabe erledigt haben möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet. It writes down what it learns about how you like the job done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada todavía. Anota lo que aprende sobre cómo te gusta que se haga el trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l'instant. Il note ce qu'il apprend sur la façon dont vous aimez que le travail soit fait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente. Annota ciò che impara su come preferisci che faccia il lavoro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets. Het schrijft op wat het leert over hoe jij het werk gedaan wilt hebben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nic. Zapisuje to, czego się dowie o tym, jak chcesz, żeby wykonywał zadanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada. Anota o que aprende sobre a forma como gosta que o trabalho seja feito."
          }
        }
      }
    },
    "taf.memory.explains": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Lauf und jeder Chat beginnt damit. Sie prägen, wie er arbeitet, nie, was seine Card erlaubt. „Vergessen“ entfernt genau diese Notiz und ihre früheren Versionen; frühere Chats und Laufberichte bleiben, bis der taf entfernt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every run and chat starts with these. They shape how it works, never what its Card allows. Forget removes that one note and its earlier versions; past chats and run reports stay until the taf is removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ejecución y cada chat empiezan con estas notas. Determinan cómo trabaja, nunca lo que permite su Card. Olvidar quita esa nota y sus versiones anteriores; los chats e informes de ejecución pasados se conservan hasta que se elimina el taf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque exécution et chaque chat commencent par celles-ci. Elles façonnent sa manière de travailler, jamais ce que sa Card autorise. Oublier supprime cette note et ses versions antérieures ; les anciens chats et rapports d'exécution restent jusqu'à la suppression du taf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni esecuzione e ogni chat partono da queste. Influenzano come lavora, mai ciò che la sua Card consente. Dimentica rimuove quella nota e le sue versioni precedenti; le chat passate e i resoconti delle esecuzioni restano finché il taf non viene rimosso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke run en chat begint hiermee. Ze bepalen hoe het werkt, nooit wat zijn Card toestaat. Vergeten verwijdert die ene notitie en de eerdere versies ervan; eerdere chats en runrapporten blijven tot het taf wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde uruchomienie i czat zaczyna się od tych notatek. Kształtują sposób jego pracy, nigdy to, na co pozwala jego Card. Zapomnij usuwa tę jedną notatkę i jej wcześniejsze wersje; dawne czaty i raporty z uruchomień zostają do usunięcia tafa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada execução e cada chat começam com estas notas. Moldam a forma como trabalha, nunca o que o seu Card permite. Esquecer remove essa nota e as suas versões anteriores; os chats e relatórios de execução passados mantêm-se até o taf ser removido."
          }
        }
      }
    },
    "taf.memory.forget": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergessen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimentica"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapomnij"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer"
          }
        }
      }
    },
    "taf.memory.forget_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“\n\nDas lässt sich nicht rückgängig machen: Der taf arbeitet ab seinem nächsten Lauf oder Chat nicht mehr damit. Andere Notizen bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nIt can't be undone: the taf stops working with it from its next run or chat. Other notes stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»\n\nNo se puede deshacer: el taf deja de tenerla en cuenta desde su próxima ejecución o chat. Las demás notas se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ »\n\nC'est irréversible : le taf cesse de l'utiliser dès sa prochaine exécution ou son prochain chat. Les autres notes restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»\n\nNon si può annullare: il taf smette di usarla dalla sua prossima esecuzione o chat. Le altre note restano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nDit kan niet ongedaan worden gemaakt: het taf werkt er vanaf de volgende run of chat niet meer mee. Andere notities blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@”\n\nNie można tego cofnąć: taf przestanie z nią pracować od następnego uruchomienia lub czatu. Inne notatki zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nNão pode ser desfeito: o taf deixa de trabalhar com ela a partir da próxima execução ou chat. As outras notas mantêm-se."
          }
        }
      }
    },
