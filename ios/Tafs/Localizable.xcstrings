            "value": "บนโทรศัพท์ที่คุณใช้กับ tafs อยู่แล้ว เปิด %1$@ → %2$@ → %3$@ แล้วสแกนรหัสนี้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs bilen eýýäm ulanýan telefonyňyzda %1$@ → %2$@ → %3$@ bölümini açyň we bu kody skanirläň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs'ı zaten kullandığınız telefonda %1$@ → %2$@ → %3$@ yolunu izleyin ve bu kodu tarayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جس فون کو آپ پہلے سے tafs کے ساتھ استعمال کرتے ہیں اس پر %1$@ ← %2$@ ← %3$@ کھولیں، اور یہ کوڈ اسکین کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên điện thoại bạn đã dùng với tafs, hãy mở %1$@ → %2$@ → %3$@, rồi quét mã này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您已用於 tafs 的手機上，開啟%1$@ →%2$@ →%3$@，然後掃描此代碼。"
          }
        }
      }
    },
