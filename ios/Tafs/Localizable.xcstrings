    "connect.apps.disconnect_why": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine trennst, werden ihre Tools nur von diesem taf entfernt und von jedem taf, dessen Card sie nutzt. Andere Verbindungen bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting one removes its tools from that taf only, and from any taf whose Card uses them. Other connections stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar una quita sus herramientas solo de ese taf y de cualquier taf cuya Card las use. Las demás conexiones se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En déconnecter une retire ses outils de ce taf uniquement, et de tout taf dont la Card les utilise. Les autres connexions restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scollegarne uno rimuove i suoi strumenti solo da quel taf, e da ogni taf la cui Card li usa. Gli altri collegamenti restano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontkoppel je er een, dan verdwijnen de tools ervan alleen bij dat taf, en bij elk taf waarvan de Card ze gebruikt. Andere koppelingen blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozłączenie jednego usuwa jego narzędzia tylko z tego tafa i z każdego tafa, którego Card ich używa. Inne połączenia zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligar uma remove as suas ferramentas apenas desse taf, e de qualquer taf cujo Card as use. As outras ligações mantêm-se."
          }
        }
      }
    },
