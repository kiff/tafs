          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastatud. KIFF pole veel kõike lisanud: tafs proovib uuesti, kui see avaneb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauré. KIFF n'a pas encore tout ajouté : tafs réessaie à son ouverture."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraćeno. KIFF još nije dodao sve: tafs pokušava ponovno kad se otvori."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítva. A KIFF még nem adott hozzá mindent: a tafs a következő megnyitáskor újra megpróbálja."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերականգնվեց։ KIFF-ը դեռ ամեն ինչ չի ավելացրել․ tafs-ը նորից կփորձի բացվելիս։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipulihkan. KIFF belum menambahkan semuanya: tafs mencoba lagi saat dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristinati. KIFF non ha ancora aggiunto tutto: tafs riprova quando si apre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元しました。KIFFはまだすべてを追加していません。tafsを開くと再試行します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აღდგა. KIFF-მა ყველაფერი ჯერ არ დაამატა: tafs ხელახლა ცდის გახსნისას."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원했습니다. KIFF가 아직 모두 추가하지 않았습니다. tafs를 열면 다시 시도합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atkurta. KIFF dar ne viską pridėjo: tafs bandys dar kartą atsidarius."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atjaunots. KIFF vēl nav visu pievienojis: tafs mēģinās vēlreiz, kad tiks atvērts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hersteld. KIFF heeft nog niet alles toegevoegd: tafs probeert het opnieuw wanneer het opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócono. KIFF jeszcze nie dodał wszystkiego: tafs spróbuje ponownie po otwarciu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurado. O KIFF ainda não adicionou tudo: o tafs tenta novamente quando abrir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurado. O KIFF ainda não adicionou tudo: o tafs tenta novamente quando abrir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurat. KIFF nu a adăugat încă totul: tafs reîncearcă la deschidere."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovené. KIFF ešte nepridal všetko: tafs to skúsi znova pri otvorení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovljeno. KIFF še ni dodal vsega: tafs poskusi znova, ko se odpre."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "U rikthye. KIFF ende nuk i ka shtuar të gjitha: tafs provon sërish kur hapet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraćeno. KIFF još nije dodao sve: tafs pokušava ponovo kad se otvori."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนแล้ว แต่ KIFF ยังเพิ่มไม่ครบ: tafs จะลองอีกครั้งเมื่อเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yüklendi. KIFF henüz her şeyi eklemedi: tafs açıldığında tekrar dener."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục. KIFF chưa thêm hết: tafs sẽ thử lại khi mở."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已回復。KIFF 尚未全部加入：tafs 會在開啟時重試。"
          }
        }
      }
    },
