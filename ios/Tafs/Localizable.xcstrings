        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی سیکیورٹی کلید کا PIN درج کریں۔ tafs ہر بار اسے مانگتا ہے اور کبھی محفوظ نہیں کرتا۔"
          }
