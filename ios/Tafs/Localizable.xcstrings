    "coach.nothing_reaches_until_you_resume": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts erreicht ihn, bis du ihn fortsetzt. Sende das dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing reaches it until you resume it. Then send this again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No le llega nada hasta que lo reanudes. Luego vuelve a enviar esto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinna ei jõua midagi enne, kui selle jätkad. Siis saada see uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne lui parvient tant que vous ne le reprenez pas. Renvoyez ensuite ceci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non gli arriva nulla finché non lo riprendi. Poi invialo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開するまで何も届きません。再開後にもう一度送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재개할 때까지 아무것도 전달되지 않습니다. 재개한 뒤 다시 보내세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas jo nepasieks, kol jo netęsite. Tada išsiųskite tai dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas to nesasniedz, kamēr tu to neturpini. Tad nosūti šo vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bereikt het niets tot je het hervat. Verzend dit daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic do niego nie dotrze, dopóki go nie wznowisz. Potem wyślij to ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada lhe chega até o retomar. Depois, envie isto novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada lhe chega até o retomar. Depois, envie isto novamente."
          }
        }
      }
    },
    "coach.nothing_to_approve": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist bereits verbunden. Es gibt nichts Neues zu genehmigen, daher wurde nichts genehmigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is already connected. There's nothing new to approve, so nothing was approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ya está conectado. No hay nada nuevo que aprobar, así que no se aprobó nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on juba ühendatud. Uut kinnitatavat pole, seega midagi ei kinnitatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est déjà connecté. Il n'y a rien de nouveau à approuver : rien n'a été approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è già collegato. Non c'è nulla di nuovo da approvare, quindi non è stato approvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はすでに接続されています。新たに承認するものはないため、何も承認されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 이미 연결되어 있습니다. 새로 승인할 것이 없어 승인된 것은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jau prijungta. Nėra nieko naujo, ką patvirtinti, todėl niekas nepatvirtinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jau ir pievienots. Nav nekā jauna, ko apstiprināt, tāpēc nekas netika apstiprināts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is al gekoppeld. Er is niets nieuws om goed te keuren, dus er is niets goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest już połączony. Nie ma nic nowego do zatwierdzenia, więc nic nie zostało zatwierdzone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ já está ligado. Não há nada de novo para aprovar, por isso nada foi aprovado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ já está conectado. Não há nada de novo para aprovar, por isso nada foi aprovado."
          }
        }
      }
    },
