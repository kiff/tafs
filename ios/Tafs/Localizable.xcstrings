    "record.tool_refused_amount": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat es abgelehnt. Es wurde nichts ausgeführt, aber es zählt trotzdem zur heutigen Summe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ refused it. Nothing was done, but it still counts against today's total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lo rechazó. No se hizo nada, pero sigue contando para el total de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ l'a refusé. Rien n'a été fait, mais cela compte quand même dans le total du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ l'ha rifiutata. Non è stato fatto nulla, ma conta comunque nel totale di oggi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft het geweigerd. Er is niets gedaan, maar het telt nog wel mee voor het totaal van vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to odrzucił. Nic nie zostało zrobione, ale nadal liczy się do dzisiejszej sumy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recusou. Nada foi feito, mas continua a contar para o total de hoje."
          }
        }
      }
    },
