    "approval.turned_off_tafs_open_settings": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist für tafs ausgeschaltet. Öffne die Einstellungen und schalte %2$@ für tafs ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is turned off for tafs. Open Settings and turn on %2$@ for tafs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está desactivado para tafs. Abre Ajustes y activa %2$@ para tafs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est désactivé pour tafs. Ouvrez Réglages et activez %2$@ pour tafs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è disattivato per tafs. Apri Impostazioni e attiva %2$@ per tafs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ staat uit voor tafs. Open Instellingen en zet %2$@ aan voor tafs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest wyłączone dla tafs. Otwórz Ustawienia i włącz %2$@ dla tafs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está desativado para o tafs. Abra as Definições e ative %2$@ para o tafs."
          }
        }
      }
    },
    "approval.turned_off_tafs_turn_tafs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist für tafs ausgeschaltet. Schalte es in den Einstellungen von tafs ein, um zu genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is turned off for tafs. Turn it on in tafs' settings to approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está desactivado para tafs. Actívalo en los ajustes de tafs para aprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est désactivé pour tafs. Activez-le dans les réglages de tafs pour approuver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è disattivato per tafs. Attivalo nelle impostazioni di tafs per approvare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ staat uit voor tafs. Zet het aan in de instellingen van tafs om goed te keuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest wyłączone dla tafs. Włącz je w ustawieniach tafs, aby zatwierdzać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está desativado para o tafs. Ative-o nas definições do tafs para aprovar."
          }
        }
      }
    },
    "approval.why": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Genehmigung, die du in tafs gibst, ob für eine Card, eine Verbindung oder eine Zahlung über einem Limit, wird auf diesem Telefon mit einem Schlüssel signiert, den nur dein Fingerabdruck entsperrt. Deine PIN oder dein Muster kann nicht genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every approval you give in tafs, a Card, a connection or a payment over a limit, is signed on this phone with a key only your fingerprint unlocks. Your PIN or pattern can't approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada aprobación que das en tafs, una Card, una conexión o un pago por encima de un límite, se firma en este teléfono con una clave que solo tu huella desbloquea. Tu PIN o patrón no pueden aprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque approbation que vous donnez dans tafs, une Card, une connexion ou un paiement au-delà d'une limite, est signée sur ce téléphone avec une clé que seule votre empreinte déverrouille. Votre code PIN ou votre schéma ne peut pas approuver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni approvazione che dai in tafs, una Card, un collegamento o un pagamento oltre un limite, viene firmata su questo telefono con una chiave che solo la tua impronta sblocca. Il PIN o la sequenza non possono approvare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke goedkeuring die je in tafs geeft, een Card, een koppeling of een betaling boven een limiet, wordt op deze telefoon ondertekend met een sleutel die alleen je vingerafdruk ontgrendelt. Je pincode of patroon kan niet goedkeuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde zatwierdzenie w tafs, Card, połączenie czy płatność ponad limit, jest podpisywane na tym telefonie kluczem, który odblokowuje tylko Twój odcisk palca. Twój PIN ani wzór nie mogą zatwierdzać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada aprovação que dá no tafs, seja um Card, uma ligação ou um pagamento acima de um limite, é assinada neste telefone com uma chave que só a sua impressão digital desbloqueia. O seu PIN ou padrão não pode aprovar."
          }
        }
      }
    },
    "approval.without_allows": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Genehmigungen kannst du dich weiterhin anmelden, prüfen, ablehnen und anhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without approvals you can still sign in, review, refuse and halt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin aprobaciones aún puedes iniciar sesión, revisar, rechazar y bloquear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans approbations, vous pouvez toujours vous connecter, consulter, refuser et bloquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza approvazioni puoi comunque accedere, controllare, rifiutare e bloccare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder goedkeuringen kun je nog steeds inloggen, bekijken, weigeren en stilzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez zatwierdzania nadal możesz się zalogować, przeglądać, odrzucać i blokować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem aprovações, pode continuar a iniciar sessão, rever, recusar e bloquear."
          }
        }
      }
    },
