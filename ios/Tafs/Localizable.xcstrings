    "onboarding.tafs_lead": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf sizin üçün bir iş görür: dəstək cavabları, gecikən bağlamalar və ya potensial müştərilərin təqibi kimi. Coach-dan xahiş edin, o, birini sizinlə birlikdə qurur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Един taf върши една работа за вас, например отговори на поддръжката, закъснели пратки или проследяване на потенциални клиенти. Попитайте Coach и той ще настрои такъв заедно с вас."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf za vás dělá jednu práci, třeba odpovědi zákazníkům, opožděné zásilky nebo navazování na poptávky. Zeptejte se Coache a nastaví ho s vámi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein taf erledigt eine Aufgabe für dich, etwa Support-Antworten, verspätete Pakete oder das Nachfassen bei Leads. Frag Coach, und er richtet einen mit dir ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A taf does one job for you, like support replies, late parcels or lead follow-ups. Ask Coach and it sets one up with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf hace un trabajo por ti, como respuestas de soporte, paquetes con retraso o seguimiento de contactos. Pídeselo a Coach y lo prepara contigo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf teeb sinu eest ühte tööd, näiteks vastab klientidele, jälgib hilinenud pakke või võtab müügivihjetega uuesti ühendust. Küsi Coachilt ja see seadistab selle koos sinuga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf fait un travail pour vous, comme les réponses au support, les colis en retard ou le suivi des prospects. Demandez à Coach, il le met en place avec vous."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf za vas radi jedan posao, poput odgovora podršci, kašnjenja paketa ili praćenja potencijalnih kupaca. Pitajte Coacha i on će ga postaviti s vama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy taf egy munkát végez el helyetted, például ügyfélszolgálati válaszokat, késő csomagokat vagy érdeklődők követését. Kérdezd a Coachot, és veled együtt beállít egyet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-ը ձեզ համար մեկ աշխատանք է անում, օրինակ՝ աջակցության պատասխաններ, ուշացած ծանրոցներ կամ պոտենցիալ հաճախորդների հետևում։ Խնդրեք Coach-ին, և նա ձեզ հետ մեկը կկարգավորի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah taf mengerjakan satu tugas untuk Anda, seperti balasan dukungan, paket terlambat, atau tindak lanjut calon pelanggan. Tanyakan kepada Coach dan ia menyiapkannya bersama Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf fa un lavoro per te, come le risposte al supporto, i pacchi in ritardo o il seguito dei contatti. Chiedi a Coach e lo prepara con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafは、サポートへの返信、配送遅延の連絡、見込み客へのフォローアップなど、ひとつの仕事を代わりに行います。Coachに頼めば、一緒に設定します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "taf თქვენთვის ერთ საქმეს აკეთებს, მაგალითად მხარდაჭერის პასუხებს, დაგვიანებულ ამანათებს ან პოტენციური კლიენტების გაყოლას. სთხოვეთ Coach-ს და ის თქვენთან ერთად დააყენებს ერთს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf는 고객 문의 답장, 늦은 택배, 리드 후속 연락처럼 한 가지 일을 맡아 합니다. Coach에게 말하면 함께 설정해 줍니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "taf atlieka vieną darbą už jus, pavyzdžiui, atsako klientams, seka vėluojančius siuntinius ar primena potencialiems klientams. Paklauskite Coach, ir jis kartu su jumis jį nustatys."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "taf tev veic vienu darbu, piemēram, atbildes atbalstam, kavētas pakas vai atgādinājumi interesentiem. Pajautā Coach, un tas kopā ar tevi to iestatīs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een taf doet één taak voor je, zoals supportantwoorden, late pakketten of opvolging van leads. Vraag het Coach en die zet er een met je op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf wykonuje za Ciebie jedno zadanie, np. odpowiedzi dla klientów, spóźnione paczki czy kontakt z potencjalnymi klientami. Poproś Coacha, a skonfiguruje go z Tobą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taf faz um trabalho por si, como respostas de suporte, encomendas atrasadas ou acompanhamento de contactos. Peça ao Coach e ele configura um consigo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taf faz um trabalho por você, como respostas de suporte, encomendas atrasadas ou acompanhamento de contatos. Peça ao Coach e ele configura um com você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf face o singură treabă pentru dvs., cum ar fi răspunsuri la suport, colete întârziate sau urmărirea clienților potențiali. Întrebați-l pe Coach și îl configurează împreună cu dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf za vás robí jednu prácu, napríklad odpovede zákazníkom, oneskorené zásielky alebo nadväzovanie na dopyty. Opýtajte sa Coacha a nastaví ho s vami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf za vas opravlja eno delo, na primer odgovore strankam, zamujene pošiljke ali sledenje povpraševanjem. Vprašajte Coacha in ga bo nastavil z vami."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një taf bën një punë për ju, si përgjigje mbështetjeje, pako të vonuara ose ndjekje klientësh të mundshëm. Pyesni Coach dhe ai e konfiguron një me ju."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf za vas radi jedan posao, poput odgovora podršci, kašnjenja paketa ili praćenja potencijalnih kupaca. Pitajte Coacha i on će ga podesiti s vama."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "taf ทำงานหนึ่งอย่างให้คุณ เช่น ตอบฝ่ายสนับสนุน พัสดุล่าช้า หรือติดตามลูกค้าเป้าหมาย ขอ Coach แล้วมันจะตั้งค่าให้ร่วมกับคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir taf sizin için tek bir iş yapar; destek yanıtları, geciken paketler veya potansiyel müşteri takipleri gibi. Coach'a sorun, sizinle bir tane kursun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một taf làm một việc cho bạn, như trả lời hỗ trợ, theo dõi bưu kiện trễ hoặc chăm sóc khách hàng tiềm năng. Hỏi Coach và nó sẽ cùng bạn thiết lập một taf."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個 taf 為您做一件事，例如客服回覆、延誤包裹或潛在客戶跟進。請 Coach 與您一起設定一個。"
          }
        }
      }
    },
