    "chat.cap.cost": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dayandı: bu tapşırıq bir tapşırıq üçün limitindən çox xərcləyərdi. Daha dar bir şey xahiş edin və ya %1$@-ı idarə edən biri limiti artıra bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ спря: тази задача би струвала повече от лимита му за една задача. Поискайте нещо по-тясно или някой, който управлява %1$@, може да увеличи лимита."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se zastavil: tento úkol by stál víc než jeho limit na jeden úkol. Požádejte o něco užšího, nebo limit může zvýšit ten, kdo %1$@ spravuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat gestoppt: Diese Aufgabe würde mehr kosten als sein Limit für eine Aufgabe. Bitte um etwas Engeres, oder jemand, der %1$@ verwaltet, kann das Limit erhöhen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stopped: this task would cost more than its limit for one task. Ask for something narrower, or someone who manages %1$@ can raise the limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detuvo: esta tarea costaría más que su límite por tarea. Pide algo más concreto, o alguien que gestione %1$@ puede subir el límite."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lõpetas: see ülesanne läheks maksma rohkem kui selle ühe ülesande limiit. Küsi midagi kitsamat või tafi %1$@ haldaja saab limiiti suurendada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s'est arrêté : cette tâche coûterait plus que sa limite pour une tâche. Demandez quelque chose de plus ciblé, ou une personne qui gère %1$@ peut relever la limite."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf %1$@ se zaustavio: ovaj bi zadatak koštao više od svog ograničenja za jedan zadatak. Zatražite nešto uže ili netko tko upravlja tafom %1$@ može podići ograničenje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ leállt: ez a feladat többe kerülne, mint az egy feladatra szóló limitje. Kérj valami szűkebbet, vagy aki a(z) %1$@ tafot kezeli, megemelheti a limitet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը կանգ առավ․ այս առաջադրանքը մեկ առաջադրանքի համար սահմանված սահմանաչափից ավելի կարժենար։ Խնդրեք ավելի նեղ բան, կամ նա, ով կառավարում է %1$@-ը, կարող է բարձրացնել սահմանաչափը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ berhenti: tugas ini akan menelan biaya lebih dari batasnya untuk satu tugas. Minta sesuatu yang lebih sempit, atau orang yang mengelola %1$@ dapat menaikkan batasnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si è fermato: questa attività costerebbe più del suo limite per un'attività. Chiedi qualcosa di più circoscritto, oppure chi gestisce %1$@ può aumentare il limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が停止しました：このタスクは1タスクあたりの費用の上限を超えます。範囲を絞って依頼するか、%1$@を管理する人に上限を引き上げてもらってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ გაჩერდა: ეს ამოცანა ერთი ამოცანისთვის დადგენილ ლიმიტზე მეტი დაჯდებოდა. მოითხოვეთ რაიმე უფრო ვიწრო, ან ვინც %1$@-ს მართავს, შეუძლია ლიმიტის გაზრდა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 멈췄습니다: 이 작업은 작업 1건 한도보다 비용이 많이 듭니다. 범위를 좁혀 요청하거나, %1$@을(를) 관리하는 사람이 한도를 올릴 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sustojo: ši užduotis kainuotų daugiau nei jos limitas vienai užduočiai. Paprašykite ko nors siauresnio arba limitą gali padidinti tas, kas valdo %1$@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ apstājās: šis uzdevums maksātu vairāk par tā limitu vienam uzdevumam. Palūdz kaut ko šaurāku, vai arī kāds, kas pārvalda %1$@, var palielināt limitu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gestopt: deze taak zou meer kosten dan de limiet voor één taak. Vraag om iets kleiners, of iemand die %1$@ beheert kan de limiet verhogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatrzymał się: to zadanie kosztowałoby więcej niż jego limit na jedno zadanie. Poproś o coś węższego albo osoba zarządzająca %1$@ może podnieść limit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: esta tarefa custaria mais do que o seu limite por tarefa. Peça algo mais restrito, ou alguém que gere %1$@ pode aumentar o limite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: esta tarefa custaria mais do que o seu limite por tarefa. Peça algo mais restrito, ou alguém que gerencia %1$@ pode aumentar o limite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s-a oprit: această sarcină ar costa mai mult decât limita sa pentru o sarcină. Cereți ceva mai restrâns sau cineva care gestionează %1$@ poate mări limita."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sa zastavil: táto úloha by stála viac než jeho limit na jednu úlohu. Požiadajte o niečo užšie, alebo limit môže zvýšiť ten, kto %1$@ spravuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se je ustavil: to opravilo bi stalo več od njegove omejitve za eno opravilo. Prosite za nekaj ožjega ali pa omejitev zviša tisti, ki upravlja %1$@."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ u ndal: kjo detyrë do të kushtonte më shumë se kufiri i saj për një detyrë. Kërkoni diçka më të ngushtë, ose dikush që menaxhon %1$@ mund ta rrisë kufirin."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf %1$@ se zaustavio: ovaj bi zadatak koštao više od svog ograničenja za jedan zadatak. Zatražite nešto uže ili netko ko upravlja tafom %1$@ može podići ograničenje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ หยุดแล้ว: งานนี้จะมีค่าใช้จ่ายเกินขีดจำกัดต่อหนึ่งงานของมัน ขอสิ่งที่แคบลง หรือผู้ที่จัดการ %1$@ เพิ่มขีดจำกัดได้"
          }
        },
        "tr": {
