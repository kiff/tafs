    "export.own_chats_each_taf_coach": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine eigenen Chats mit jedem taf, die mit Coach eingeschlossen, die Namen der Dateien, die du angehängt hast, und deine Notizen, als lesbare Datei und als JSON. Nur du kannst sie exportieren."
