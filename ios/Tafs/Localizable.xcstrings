            "state": "translated",
            "value": "%1$@、ただし送信できませんでした：アプリには何も届いていません%2$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, მაგრამ ვერ გაიგზავნა: არაფერი მიაღწია აპს%2$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ប៉ុន្តែមិនអាចផ្ញើបានទេ៖ គ្មានអ្វីទៅដល់កម្មវិធីទេ%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 하지만 보내지 못했습니다: 앱에 아무것도 도달하지 않았습니다%2$@"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ແຕ່ສົ່ງບໍ່ໄດ້: ບໍ່ມີຫຍັງເຖິງແອັບ%2$@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, bet jos nepavyko išsiųsti: niekas nepasiekė programėlės%2$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, bet to nevarēja nosūtīt: nekas nesasniedza lietotni%2$@"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, но не можеше да се испрати: ништо не стигна до апликацијата%2$@"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, гэхдээ илгээж чадсангүй: апп-д юу ч хүрээгүй%2$@"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, तर पठाउन सकिएन: एपमा केही पुगेन%2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, maar het kon niet worden verzonden: niets heeft de app bereikt%2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ale nie udało się tego wysłać: nic nie dotarło do aplikacji%2$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, mas não foi possível enviar: nada chegou à app%2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, mas não foi possível enviar: nada chegou ao app%2$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, dar nu a putut fi trimis: nimic nu a ajuns la aplicație%2$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ale nedalo sa to odoslať: do aplikácie sa nič nedostalo%2$@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, a tega ni bilo mogoče poslati: nič ni doseglo aplikacije%2$@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, por nuk u dërgua dot: asgjë nuk arriti te aplikacioni%2$@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ali nije se moglo poslati: ništa nije stiglo do aplikacije%2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ แต่ส่งไม่ได้: ไม่มีอะไรไปถึงแอป%2$@"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ýöne ibermek mümkin bolmady: programma hiç zat ýetmedi%2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ama gönderilemedi: uygulamaya hiçbir şey ulaşmadı%2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@، مگر بھیجا نہیں جا سکا: ایپ تک کچھ نہیں پہنچا%2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, nhưng không gửi được: không có gì đến được ứng dụng%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，但無法傳送：沒有任何內容傳達到 App%2$@"
          }
        }
      }
    },
