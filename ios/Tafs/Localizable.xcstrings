    "door.footer": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qapıya hər kəs yaza bilər. Yalnız cütləşdirdiyiniz insanlar %1$@ taf-ına iş verə bilər, qalanını isə Card-ı müəyyən edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки може да пише на врата. Само хората, които сдвоите, могат да дават работа на %1$@, а неговата Card решава останалото."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dveře může psát kdokoli. Práci %1$@ mohou dávat jen lidé, které spárujete, a o zbytku rozhoduje jeho Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder kann an eine Tür schreiben. Nur Personen, die du koppelst, können %1$@ Arbeit geben, und seine Card entscheidet den Rest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can write to a door. Only people you pair can give %1$@ work, and its Card decides the rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera puede escribir a una puerta. Solo las personas que vincules pueden dar trabajo a %1$@, y su Card decide el resto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uksele võib kirjutada igaüks. Tafile %1$@ saavad tööd anda ainult inimesed, kelle sa seod, ja ülejäänu otsustab selle Card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut écrire à une porte. Seules les personnes que vous associez peuvent donner du travail à %1$@, et sa Card décide du reste."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vrata može pisati svatko. Samo ljudi koje uparite mogu tafu %1$@ davati posao, a ostalo odlučuje njegov Card."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy ajtóra bárki írhat. Csak az általad párosított emberek adhatnak munkát neki (%1$@), a többit a Cardja dönti el."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դռանը ցանկացած մարդ կարող է գրել։ Միայն ձեր զուգակցած մարդիկ կարող են %1$@-ին աշխատանք տալ, իսկ մնացածը որոշում է նրա Card-ը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun dapat menulis ke sebuah pintu. Hanya orang yang Anda pasangkan yang dapat memberi %1$@ pekerjaan, dan Card-nya menentukan sisanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque può scrivere a una porta. Solo le persone che associ possono dare lavoro a %1$@, e la sua Card decide il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "窓口には誰でも連絡できます。%1$@に仕事を頼めるのは登録した人だけで、それ以外はCardが決めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კარზე ნებისმიერს შეუძლია წერა. მხოლოდ დაწყვილებულ ადამიანებს შეუძლიათ %1$@-ისთვის სამუშაოს მიცემა, დანარჩენს კი მისი Card წყვეტს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구나 창구로 연락할 수 있습니다. 내가 등록한 사람만 %1$@에게 작업을 맡길 수 있고, 나머지는 Card가 정합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Į duris gali rašyti bet kas. Darbą %1$@ gali duoti tik jūsų susieti žmonės, o visa kita lemia jo Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz durvīm var rakstīt ikviens. Tikai tie, ko tu savieno pārī, var dot %1$@ darbu, un pārējo nosaka tā Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen kan naar een deur schrijven. Alleen mensen die je koppelt kunnen %1$@ werk geven, en zijn Card bepaalt de rest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy może pisać do drzwi. Tylko osoby, które powiążesz, mogą zlecać pracę %1$@, a o reszcie decyduje jego Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa pode escrever para uma porta. Só as pessoas que associar podem dar trabalho a %1$@, e o seu Card decide o resto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa pode escrever para uma porta. Só as pessoas que associar podem dar trabalho a %1$@, e o seu Card decide o resto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine poate scrie la o ușă. Doar persoanele pe care le asociați îi pot da lui %1$@ de lucru, iar Cardul său decide restul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dvere môže písať ktokoľvek. Prácu %1$@ môžu dávať len ľudia, ktorých spárujete, a o zvyšku rozhoduje jeho Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vrata lahko piše vsakdo. Samo ljudje, ki jih seznanite, lahko %1$@ dajo delo, o ostalem pa odloča njegova Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdokush mund të shkruajë te një portë. Vetëm njerëzit që çiftoni mund t'i japin %1$@ punë, dhe Card-i i tij vendos pjesën tjetër."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vrata može pisati svatko. Samo ljudi koje uparite mogu tafu %1$@ davati posao, a ostalo odlučuje njegov Card."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครก็เขียนถึงประตูได้ เฉพาะผู้ที่คุณจับคู่เท่านั้นที่มอบงานให้ %1$@ ได้ และ Card ของมันตัดสินส่วนที่เหลือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kapıya herkes yazabilir. %1$@ taf'ına yalnızca eşleştirdiğiniz kişiler iş verebilir, gerisine Card'ı karar verir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cũng có thể viết tới một cửa. Chỉ những người bạn ghép đôi mới giao việc được cho %1$@, và Card của nó quyết định phần còn lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都可以寫信到門。只有您配對的人才能交付工作給 %1$@，其餘由它的 Card 決定。"
          }
        }
      }
    },
    "door.hi_like_back_order": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Salam, T-3001 sifarişi üzrə 15 $ geri almaq istəyirəm."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Здравейте, бих искал 15 $ обратно за поръчка T-3001."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobrý den, chtěl bych vrátit 15 $ za objednávku T-3001."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo, ich hätte gern 15 $ für Bestellung T-3001 zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I'd like $15 back on order T-3001."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola, quiero que me devuelvan 15 $ del pedido T-3001."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tere, sooviksin tellimuselt T-3001 15 $ tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour, j'aimerais être remboursé de 15 $ sur la commande T-3001."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bok, htio bih natrag 15 $ za narudžbu T-3001."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üdv, szeretnék 15 dollárt visszakapni a T-3001-es rendelésből."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բարև, կուզեի 15 $ ետ պատվերի համար T-3001։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
