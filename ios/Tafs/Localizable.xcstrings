            "state": "translated",
            "value": "Tu taf no se ejecuta hasta que se instale o la canceles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu taf ei tööta enne, kui see on paigaldatud või sa loobud."
