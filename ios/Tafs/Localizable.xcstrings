        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause. Plus rien ne part tant que vous ne me dites pas de continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושהה. שום דבר נוסף לא יוצא עד שתגיד לי להמשיך."
