            "state": "translated",
            "value": "במבט על מה שעשיתי לאחרונה, "
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल में मैंने जो किया उसे देखते हुए, "
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gledajući što sam nedavno radio, "
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha megnézem, mit csináltam mostanában, "
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նայելով՝ ինչ արեցի վերջերս, "
          }
        },
        "id": {
          "stringUnit": {
