        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההקלטה לא הגיעה לטלפון שלך. יש לנסות שוב, או להקליד במקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग आपके फ़ोन तक नहीं पहुँची। फिर कोशिश करें, या इसके बजाय टाइप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimka nije stigla do vašeg telefona. Pokušajte ponovno ili tipkajte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvétel nem érkezett meg a telefonodra. Próbáld újra, vagy írj inkább."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձայնագրությունը չհասավ ձեր հեռախոսին։ Փորձեք նորից կամ մուտքագրեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman tidak sampai ke ponsel Anda. Coba lagi, atau ketik saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione non è arrivata al telefono. Riprova, oppure scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音がスマートフォンに届きませんでした。もう一度お試しいただくか、入力してください。"
