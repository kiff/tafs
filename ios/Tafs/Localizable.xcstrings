          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคนในบัญชีอยู่ที่นี่ เชิญคนเพิ่มได้จากแผงควบคุม KIFF"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaptaki herkes burada. İnsanları KIFF panosundan davet edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người trong tài khoản đều ở đây. Hãy mời thêm người từ bảng điều khiển KIFF."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號中的所有人都在這裡。請從 KIFF 主控台邀請更多人。"
          }
        }
      }
