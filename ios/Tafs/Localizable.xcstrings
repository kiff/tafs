    "door.day.open|one": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ von %1$@ von dir und gekoppelten Absendern heute. Nur Text: Anhänge werden nicht geöffnet, und die Antwort sagt das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ of %1$@ from you and paired senders today. Text only: attachments aren't opened, and the reply says so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ de %1$@ tuyos y de remitentes vinculados hoy. Solo texto: los adjuntos no se abren, y la respuesta lo dice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ sur %1$@ de vous et des expéditeurs associés aujourd'hui. Texte uniquement : les pièces jointes ne sont pas ouvertes, et la réponse le précise."
          }
