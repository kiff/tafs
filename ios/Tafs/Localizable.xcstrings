    "halt.explain.halting": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Neues startet. „Angehalten“ erscheint, sobald KIFF und die Verbindung beide bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing new starts. Halted shows once KIFF and the connection both confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No empieza nada nuevo. Aparece Bloqueado cuando KIFF y la conexión lo confirman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau ne démarre. Bloqué s'affiche dès que KIFF et la connexion l'ont tous deux confirmé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non parte nulla di nuovo. Bloccato compare quando KIFF e il collegamento lo confermano entrambi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er start niets nieuws. Stilgezet verschijnt zodra KIFF en de koppeling het allebei bevestigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nowego się nie zaczyna. Zablokowane pojawi się, gdy potwierdzą to KIFF i połączenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de novo começa. Bloqueado aparece quando o KIFF e a ligação o confirmarem."
          }
        }
      }
    },
    "halt.explain.running_all": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhalten stoppt deine tafs: Kein Lauf startet, und nichts erreicht deine Apps, bis du fortsetzt. Ein Aufruf, der schon unterwegs ist, kann noch ankommen; nichts wird rückgängig gemacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halting stops your tafs: no run starts, and nothing reaches your apps until you resume. A call already on its way may still arrive; nothing is undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear detiene tus tafs: no empieza ninguna ejecución y nada llega a tus apps hasta que lo reanudes. Una llamada que ya esté en camino aún puede llegar; no se deshace nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquer arrête vos tafs : aucune exécution ne démarre, et rien n'atteint vos apps jusqu'à ce que vous repreniez. Un appel déjà en route peut encore arriver ; rien n'est annulé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccare ferma i tuoi tafs: non parte nessuna esecuzione, e non arriva nulla alle tue app finché non riprendi. Una chiamata già partita può ancora arrivare; non viene annullato nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilzetten stopt je tafs: er start geen run, en niets bereikt je apps tot je hervat. Een aanroep die al onderweg is, kan nog aankomen; niets wordt teruggedraaid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokada zatrzymuje Twoje tafs: żadne uruchomienie się nie zaczyna i nic nie dociera do Twoich aplikacji, dopóki ich nie wznowisz. Wywołanie, które jest już w drodze, może jeszcze dotrzeć; nic nie zostanie cofnięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear para os seus tafs: nenhuma execução começa, e nada chega às suas apps até retomar. Uma chamada já a caminho pode ainda chegar; nada é desfeito."
          }
        }
      }
    },
