    "card.line.more_asks": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "؛ والمزيد يسألك أولًا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "; çoxu əvvəlcə sizdən soruşur"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "; за повече първо ви пита"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "; বেশি হলে আগে আপনাকে জিজ্ঞেস করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "; més et pregunta primer"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "; víc se vás nejdřív zeptá"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "; für mehr fragt er dich zuerst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "; more asks you first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "; si es más, te pregunta primero"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "; rohkema korral küsib see kõigepealt sinult"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " ; au-delà, il vous demande d'abord"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "; יותר שואל אותך קודם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "; इससे ज़्यादा पर पहले आपसे पूछता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "; više pita vas najprije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "; a több előbb téged kérdez"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "․ ավելիի համար նախ հարցնում է ձեզ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "; selebihnya bertanya kepada Anda lebih dulu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "; oltre, ti chiede prima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "、それ以上はまずあなたに確認します"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "; მეტისთვის ჯერ გეკითხებათ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "; លើសពីនេះសួរអ្នកជាមុន"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "; 그 이상은 먼저 나에게 묻습니다"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "; ຫຼາຍກວ່ານັ້ນຖາມທ່ານກ່ອນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "; daugiau – pirmiausia klausia jūsų"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "; par vairāk tas vispirms jautā tev"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "; повеќе те прашува прво"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "; түүнээс илүүд эхлээд танаас асууна"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "; त्यसभन्दा बढीले पहिले तपाईंलाई सोध्छ"
          }
        },
