    "version.first_only": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ bir versiya var. Onu təkmilləşdirəndə hər dəyişiklik burada saxlanılır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Засега една версия. Когато го подобрите, всяка промяна се пази тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím jedna verze. Když ho vylepšíte, každá změna se uchová tady."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher eine Version. Wenn du ihn verbesserst, wird jede Änderung hier festgehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One version so far. When you improve it, each change is kept here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora, una versión. Cuando lo mejores, cada cambio se guarda aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni üks versioon. Kui seda täiustad, hoitakse iga muudatust siin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule version pour l'instant. Quand vous l'améliorez, chaque changement est conservé ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasad jedna verzija. Kad je poboljšate, svaka se promjena čuva ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eddig egy verzió van. Amikor javítod, minden módosítás itt marad meg."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մինչ այժմ մեկ տարբերակ։ Երբ բարելավեք այն, յուրաքանչյուր փոփոխություն պահվում է այստեղ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baru satu versi. Saat Anda meningkatkannya, setiap perubahan disimpan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finora una sola versione. Quando lo migliori, ogni modifica viene conservata qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだバージョンは1つです。改善するたびに、変更がここに残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერჯერობით ერთი ვერსიაა. როცა გააუმჯობესებთ, ყოველი ცვლილება აქ ინახება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 버전이 하나뿐입니다. 개선할 때마다 변경 내용이 여기에 남습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kol kas tik viena versija. Kai jį patobulinsite, kiekvienas pakeitimas bus saugomas čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagaidām viena versija. Kad to uzlabosi, katra izmaiņa tiks saglabāta šeit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot nu toe één versie. Als je het verbetert, wordt elke wijziging hier bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie jedna wersja. Gdy go ulepszysz, każda zmiana zostanie tu zachowana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma versão até agora. Quando o melhorar, cada alteração fica guardada aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma versão até agora. Quando o melhorar, cada alteração fica guardada aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O singură versiune deocamdată. Când îl îmbunătățiți, fiecare schimbare se păstrează aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ jedna verzia. Keď ho vylepšíte, každá zmena sa uchová tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaenkrat ena različica. Ko ga izboljšate, se vsaka sprememba hrani tukaj."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një version deri tani. Kur e përmirësoni, çdo ndryshim ruhet këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasad jedna verzija. Kad je poboljšate, svaka se promena čuva ovdje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้มีเวอร์ชันเดียว เมื่อคุณปรับปรุงมัน ทุกการเปลี่ยนแปลงจะถูกเก็บไว้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdilik tek sürüm. Geliştirdiğinizde her değişiklik burada saklanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện mới có một phiên bản. Khi bạn cải thiện nó, mỗi thay đổi được giữ ở đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有一個版本。當您改進它時，每次變更都會保留在這裡。"
          }
        }
      }
    },
