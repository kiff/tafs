    "report.person_kiff_reads_your_report": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-də bir nəfər bildirişinizi cavabın yazıldığı kimi oxuyur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Човек от KIFF чете доклада ви заедно с отговора, както е бил написан."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše hlášení si v KIFF přečte člověk, spolu s odpovědí tak, jak byla napsaná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Person bei KIFF liest deine Meldung, zusammen mit der Antwort, wie sie geschrieben wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A person at KIFF reads your report, with the answer as it was written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona de KIFF lee tu reporte, con la respuesta tal como se escribió."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu teadet loeb KIFFis inimene, koos vastusega nii, nagu see kirjutati."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne chez KIFF lit votre signalement, avec la réponse telle qu'elle a été écrite."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoba u KIFF-u čita vašu prijavu, s odgovorom onako kako je napisan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelentésedet egy ember olvassa el a KIFF-nél, a válasszal együtt, ahogy íródott."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ի մարդը կարդում է ձեր հաղորդումը՝ պատասխանի հետ միասին, ինչպես այն գրվել է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang di KIFF membaca laporan Anda, beserta jawaban seperti yang ditulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona di KIFF legge la tua segnalazione, con la risposta così come è stata scritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFの担当者が、書かれたままの回答とともにあなたの報告を読みます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ის ადამიანი კითხულობს თქვენს რეპორტს პასუხთან ერთად ისე, როგორც ის დაიწერა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF의 담당자가 작성된 그대로의 답변과 함께 신고 내용을 읽습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų pranešimą su atsakymu, kaip jis buvo parašytas, perskaitys KIFF darbuotojas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cilvēks KIFF izlasa tavu ziņojumu kopā ar atbildi tādu, kāda tā tika uzrakstīta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een medewerker van KIFF leest je melding, met het antwoord zoals het geschreven is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zgłoszenie przeczyta osoba z KIFF, razem z odpowiedzią w takiej formie, w jakiej została napisana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pessoa no KIFF lê o seu relatório, com a resposta tal como foi escrita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pessoa no KIFF lê o seu relatório, com a resposta tal como foi escrita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O persoană de la KIFF vă citește raportul, împreună cu răspunsul așa cum a fost scris."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše hlásenie si v KIFF prečíta človek, spolu s odpoveďou tak, ako bola napísaná."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vašo prijavo bo pri KIFF prebral človek, skupaj z odgovorom, kot je bil napisan."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një person te KIFF e lexon raportin tuaj, me përgjigjen siç u shkrua."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoba u KIFF-u čita vašu prijavu, s odgovorom onako kako je napisan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เจ้าหน้าที่ของ KIFF จะอ่านรายงานของคุณพร้อมคำตอบตามที่เขียนไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF'te bir kişi, yanıtı yazıldığı haliyle birlikte bildiriminizi okur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một người ở KIFF sẽ đọc báo cáo của bạn, cùng với câu trả lời đúng như đã viết."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF 的專人會閱讀您的回報，並附上原樣的回覆內容。"
          }
        }
      }
    },
