            "state": "translated",
            "value": "Iznos u ovom retku ne odgovara KIFF-ovoj potvrdi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ezen a soron lévő összeg nem egyezik a KIFF nyugtájával."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս տողի գումարը չի համապատասխանում KIFF-ի անդորրագրին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah di baris ini tidak cocok dengan tanda terima KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importo su questa riga non corrisponde alla ricevuta di KIFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この行の金額がKIFFの領収書と一致しません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თანხა ამ ხაზზე არ ემთხვევა KIFF-ის ქვითარს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목의 금액이 KIFF의 영수증과 일치하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma šioje eilutėje nesutampa su KIFF kvitu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Summa šajā rindā neatbilst KIFF kvītij."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bedrag op deze regel komt niet overeen met het ontvangstbewijs van KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota w tym wierszu nie zgadza się z potwierdzeniem KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O montante nesta linha não corresponde ao recibo do KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O montante nesta linha não corresponde ao recibo do KIFF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma de pe acest rând nu corespunde chitanței KIFF."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma na tomto riadku nezodpovedá potvrdeniu od KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znesek v tej vrstici se ne ujema s potrdilom KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuma në këtë rresht nuk përputhet me dëftesën e KIFF."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Iznos u ovom retku ne odgovara KIFF-ovoj potvrdi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเงินในบรรทัดนี้ไม่ตรงกับใบเสร็จของ KIFF"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu satırdaki tutar, KIFF'in makbuzuyla eşleşmiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số tiền ở dòng này không khớp với biên nhận của KIFF."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一行的金額與 KIFF 的收據不符。"
          }
        }
      }
    },
