            "state": "translated",
            "value": "As mensagens desta pessoa por %1$@ passam a dar trabalho a ele"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajele sale prin %1$@ îi dau de lucru de acum înainte"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho správy cez %1$@ mu odteraz dávajú prácu"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegova sporočila prek %1$@ mu odslej dajejo delo"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesazhet e tyre nga %1$@ i japin punë nga tani e tutje"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Njihove poruke putem: %1$@ od sada mu daju posao"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่อจากนี้ข้อความของพวกเขาผ่าน %1$@ จะมอบงานให้มัน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Olaryň %1$@ arkaly habarlary şu wagtdan bäri oňa iş berýär"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan sonra %1$@ üzerinden gelen mesajları ona iş verir"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اب سے %1$@ کے ذریعے ان کے پیغامات اسے کام دیتے ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ nay tin nhắn của họ qua %1$@ giao việc cho nó"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從現在起，他們透過%1$@傳來的訊息會交付工作給它"
          }
        }
      }
    },
