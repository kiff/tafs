        }
      }
    },
    "taf.remove.not_finished": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht abgeschlossen, nicht entfernt: %1$@. tafs versucht es bei jeder Aktualisierung erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not finished: its %1$@ couldn't be removed. tafs tries again each time it refreshes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin terminar: no se pudo eliminar su %1$@. tafs lo vuelve a intentar cada vez que se actualiza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non terminé : éléments non supprimés : %1$@. tafs réessaie à chaque actualisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non completato: non è stato possibile rimuovere %1$@. tafs riprova a ogni aggiornamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet afgerond: %1$@ kon niet worden verwijderd. tafs probeert het bij elke vernieuwing opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ukończono: nie udało się usunąć: %1$@. tafs próbuje ponownie przy każdym odświeżeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não concluído: não foi possível remover %1$@. O tafs tenta novamente sempre que atualiza."
          }
        }
      }
    },
