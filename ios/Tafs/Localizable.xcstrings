        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınızdaki kodun süresi doldu. Yeni bir kod gösterip tekrar tarayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã trên máy tính của bạn đã hết hạn. Hãy hiện mã mới và quét lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您電腦上的代碼已過期。請顯示新的代碼並再次掃描。"
          }
        }
      }
    },
    "settings.devices.pair_gives_enclave": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ taf-larınızın əməliyyatlarını Touch ID ilə təsdiq edə biləcək."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ще може да одобрява действията на вашите tafs с Touch ID."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bude moci schvalovat akce vašich tafů přes Touch ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kann dann die Aktionen deiner tafs mit Touch ID genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will be able to approve your tafs' actions with Touch ID."
          }
        },
        "es": {
          "stringUnit": {
