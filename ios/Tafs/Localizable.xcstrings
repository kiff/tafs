    "taf.halt.cloud_not_resumed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استأنف KIFF %1$@، لكن tafs cloud لم يستأنفه بعد. %2$@"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF %1$@ taf-ını davam etdirdi, amma tafs cloud hələ etmədi. %2$@"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF възобнови %1$@, но tafs cloud още не. %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF %1$@ আবার চালু করেছে, কিন্তু tafs cloud এখনও করেনি। %2$@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ha reprès %1$@, però tafs cloud encara no. %2$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF obnovil %1$@, ale tafs cloud zatím ne. %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hat %1$@ fortgesetzt, tafs cloud aber noch nicht. %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF resumed %1$@, but tafs cloud didn't yet. %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF reanudó %1$@, pero tafs cloud aún no. %2$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF jätkas tafi %1$@, kuid tafs cloud veel mitte. %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF a repris %1$@, mais tafs cloud pas encore. %2$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF חידש את %1$@, אבל tafs cloud עדיין לא. %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ने %1$@ फिर शुरू किया, पर tafs cloud ने अभी नहीं। %2$@"
