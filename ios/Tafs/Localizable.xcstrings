    "drive.ended.owner_took_over": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توليت الأمر، فترك Coach لك المتابعة"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz idarəni götürdünüz, ona görə Coach davam etməyi sizə buraxdı"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поехте управлението, така че Coach ви остави да продължите"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি নিয়ন্ত্রণ নিয়েছেন, তাই Coach আপনাকে চালিয়ে যেতে দিয়েছে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has pres el control, així que Coach t'ha deixat continuar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Převzali jste to, takže vás Coach nechal pokračovat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast übernommen, also lässt Coach dich weitermachen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You took over, so Coach let you carry on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomaste el control, así que Coach te deja seguir"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võtsid juhtimise üle, seega Coach lasi sul jätkata"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez pris la main, alors Coach vous laisse continuer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתלטת, ולכן Coach הניח לך להמשיך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने ले लिया, इसलिए Coach ने आपको जारी रखने दिया"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzeli ste pa je Coach prepustio vama"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átvetted, ezért a Coach hagyta, hogy folytasd"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դուք վերցրիք վերահսկողությունը, ուստի Coach-ը թողեց, որ շարունակեք"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda mengambil alih, jadi Coach membiarkan Anda melanjutkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai preso il controllo, quindi Coach ti lascia continuare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが操作を引き継いだため、Coachは任せました"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენ გადაიბარეთ, ამიტომ Coach-მა გააგრძელებინა"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកបានទទួលយកការគ្រប់គ្រង ដូច្នេះ Coach ឱ្យអ្នកបន្ត"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 직접 조작을 시작해 Coach가 넘겨주었습니다"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທ່ານຮັບຕໍ່ ສະນັ້ນ Coach ໃຫ້ທ່ານສືບຕໍ່"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perėmėte valdymą, todėl Coach leido jums tęsti"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pārņēmi vadību, tāpēc Coach ļāva tev turpināt"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти презеде, па Coach те остави да продолжиш"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та авсан тул Coach танд үргэлжлүүлэхийг үлдээлээ"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले नियन्त्रण लिनुभयो, त्यसैले Coach ले तपाईंलाई जारी राख्न दियो"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je nam het over, dus Coach laat je verdergaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejęto sterowanie, więc Coach pozwala kontynuować"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assumiu o controlo, por isso o Coach deixa que continue"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assumiu o controle, por isso o Coach deixa que continue"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ați preluat controlul, așa că Coach v-a lăsat să continuați"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevzali ste to, takže vás Coach nechal pokračovať"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevzeli ste, zato vas je Coach pustil nadaljevati"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ju e morët në dorë, ndaj Coach ju la të vazhdoni"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzeli ste pa je Coach prepustio vama"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเข้าควบคุมเอง Coach จึงให้คุณทำต่อ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz ele aldyňyz, şonuň üçin Coach dowam etmäge ýol berdi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz devraldınız, bu yüzden Coach devam etmenize izin verdi"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے کنٹرول سنبھال لیا، اس لیے Coach نے آپ کو جاری رکھنے دیا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã tiếp quản nên Coach để bạn làm tiếp"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您接手了，因此 Coach 讓您繼續"
          }
        }
      }
    },
