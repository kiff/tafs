    "coach.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سمِّ تطبيقًا للـ taf لديك، مثل مزوّد الدفع الخاص بك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-ınız üçün tətbiqin adını deyin, məsələn ödəniş provayderinizi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Посочете приложение за вашия taf, например доставчика ви на плащания."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার taf-এর জন্য একটি অ্যাপের নাম বলুন, যেমন আপনার পেমেন্ট প্রদানকারী।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Digues el nom d'una aplicació per al teu taf, com el teu proveïdor de pagaments."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojmenujte aplikaci pro svůj taf, třeba svého poskytovatele plateb."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne eine App für deinen taf, etwa deinen Zahlungsanbieter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name an app for your taf, like your payment provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra una app para tu taf, como tu proveedor de pagos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeta oma tafile rakendus, näiteks oma makseteenuse pakkuja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez une app pour votre taf, comme votre prestataire de paiement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לציין אפליקציה עבור ה-taf שלך, כמו ספק התשלומים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने taf के लिए किसी ऐप का नाम बताएँ, जैसे आपका भुगतान प्रदाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imenujte aplikaciju za svoj taf, poput svojeg pružatelja plaćanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevezz meg egy alkalmazást a tafodnak, például a fizetési szolgáltatódat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անվանեք հավելված ձեր taf-ի համար, օրինակ՝ ձեր վճարումների մատակարարը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebutkan sebuah aplikasi untuk taf Anda, seperti penyedia pembayaran Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un'app per il tuo taf, come il tuo fornitore di pagamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決済サービスなど、tafに使うアプリを指定してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაასახელეთ აპი თქვენი taf-ისთვის, მაგალითად თქვენი გადახდების პროვაიდერი."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដាក់ឈ្មោះកម្មវិធីសម្រាប់ taf របស់អ្នក ដូចជាអ្នកផ្តល់សេវាទូទាត់របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf가 쓸 앱을 말하세요. 예: 결제 서비스."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບອກຊື່ແອັບສຳລັບ taf ຂອງທ່ານ ເຊັ່ນຜູ້ໃຫ້ບໍລິການຊຳລະເງິນຂອງທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nurodykite programėlę savo taf, pavyzdžiui, savo mokėjimų paslaugą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosauc lietotni savam taf, piemēram, savu maksājumu nodrošinātāju."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Именувај апликација за твојот taf, како твојот давател на плаќања."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-даа зориулсан аппыг нэрлээрэй, жишээ нь төлбөрийн үйлчилгээ үзүүлэгчээ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आफ्नो taf का लागि एपको नाम भन्नुहोस्, जस्तै तपाईंको भुक्तानी प्रदायक।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noem een app voor je taf, zoals je betaalprovider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj aplikację dla swojego tafa, np. Twojego dostawcę płatności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique uma app para o seu taf, como o seu fornecedor de pagamentos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique um app para o seu taf, como o seu fornecedor de pagamentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numiți o aplicație pentru taful dvs., de exemplu furnizorul de plăți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomenujte aplikáciu pre svoj taf, napríklad svojho poskytovateľa platieb."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poimenujte aplikacijo za svoj taf, na primer svojega ponudnika plačil."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Emërtoni një aplikacion për taf-in tuaj, si ofruesi juaj i pagesave."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Imenujte aplikaciju za svoj taf, poput svojeg pružatelja plaćanja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุแอปให้ taf ของคุณ เช่น ผู้ให้บริการชำระเงินของคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "taf-yňyz üçin bir programma atlandyryň, meselem töleg üpjün edijiňizi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf'ınız için, ödeme sağlayıcınız gibi bir uygulamanın adını verin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے taf کے لیے کسی ایپ کا نام لیں، جیسے آپ کا ادائیگی فراہم کنندہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nêu tên một ứng dụng cho taf của bạn, như nhà cung cấp thanh toán."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為您的 taf 指定一個 App，例如您的付款服務供應商。"
          }
        }
      }
    },
