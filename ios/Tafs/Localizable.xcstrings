    "needs_you.answer_in_kiff": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buna KIFF-də cavab verin. Telefondan cavab vermək KIFF telefonun imzasını yoxlayandan sonra gəlir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговорете на това в KIFF. Отговорът от телефона пристига, след като KIFF провери подписа на телефона."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tohle odpovězte v KIFF. Odpověď z telefonu dorazí, až KIFF ověří podpis telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworte diese in KIFF. Antworten vom Telefon kommen an, sobald KIFF die Signatur des Telefons prüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer this one in KIFF. Answering from the phone arrives once KIFF checks the phone's signature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde a esta en KIFF. Las respuestas desde el teléfono llegarán cuando KIFF compruebe la firma del teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasta sellele KIFFis. Telefonist vastamine jõuab kohale, kui KIFF on telefoni allkirja kontrollinud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez à celle-ci dans KIFF. Une réponse depuis le téléphone arrive dès que KIFF vérifie la signature du téléphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovaj odgovorite u KIFF-u. Odgovaranje s telefona stiže kad KIFF provjeri potpis telefona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erre a KIFF-ben válaszolj. A telefonról adott válasz akkor érkezik meg, amikor a KIFF ellenőrzi a telefon aláírását."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատասխանեք սրան KIFF-ում։ Հեռախոսից պատասխանը հասանելի կդառնա, երբ KIFF-ը ստուգի հեռախոսի ստորագրությունը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawab yang ini di KIFF. Menjawab dari ponsel tersedia setelah KIFF memeriksa tanda tangan ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi a questa in KIFF. Le risposte dal telefono arrivano quando KIFF verifica la firma del telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはKIFFで回答してください。スマートフォンからの回答は、KIFFがスマートフォンの署名を確認した後に届きます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამას უპასუხეთ KIFF-ში. ტელეფონიდან პასუხი ხელმისაწვდომი გახდება, როცა KIFF ტელეფონის ხელმოწერას შეამოწმებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청은 KIFF에서 답변하세요. 휴대폰에서 한 답변은 KIFF가 휴대폰의 서명을 확인한 뒤에 도착합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Į šią atsakykite KIFF. Atsakymas iš telefono bus priimtas, kai KIFF patikrins telefono parašą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbildi uz šo KIFF. Atbilde no tālruņa pienāks, kad KIFF pārbaudīs tālruņa parakstu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord deze in KIFF. Antwoorden vanaf de telefoon komt aan zodra KIFF de handtekening van de telefoon controleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedz na to w KIFF. Odpowiadanie z telefonu zadziała, gdy KIFF zacznie sprawdzać podpis telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda a este no KIFF. As respostas a partir do telefone chegam quando o KIFF verificar a assinatura do telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda a este no KIFF. As respostas a partir do telefone chegam quando o KIFF verificar a assinatura do telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspundeți la aceasta în KIFF. Răspunsul de pe telefon ajunge după ce KIFF verifică semnătura telefonului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na toto odpovedzte v KIFF. Odpoveď z telefónu dorazí, keď KIFF overí podpis telefónu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na to odgovorite v KIFF. Odgovor iz telefona prispe, ko KIFF preveri podpis telefona."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigjuni kësaj në KIFF. Përgjigjja nga telefoni vjen kur KIFF kontrollon nënshkrimin e telefonit."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovaj odgovorite u KIFF-u. Odgovaranje s telefona stiže kad KIFF proveri potpis telefona."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอบรายการนี้ใน KIFF การตอบจากโทรศัพท์จะใช้ได้เมื่อ KIFF ตรวจลายเซ็นของโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu KIFF'te yanıtlayın. Telefondan yanıtlama, KIFF telefonun imzasını doğrulayınca gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy trả lời cái này trong KIFF. Trả lời từ điện thoại sẽ có khi KIFF kiểm tra chữ ký của điện thoại."
