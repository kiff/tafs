    "pair.keychain_refused": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac giriş məlumatını Keychain-də saxlaya bilmədi (xəta %1$@), ona görə əlavə edilmədi. Yeni kod göstərin və yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този Mac не можа да запази входа си в Keychain (грешка %1$@), така че не беше добавен. Покажете нов код и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento Mac nemohl uložit přihlášení do Klíčenky (chyba %1$@), takže se nepřidal. Zobrazte nový kód a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac konnte seine Anmeldung nicht im Schlüsselbund sichern (Fehler %1$@) und wurde nicht hinzugefügt. Zeig einen neuen Code und versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac couldn't save its sign-in to the Keychain (error %1$@), so it wasn't added. Show a new code and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no pudo guardar su inicio de sesión en el llavero (error %1$@), así que no se añadió. Muestra un código nuevo y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See Mac ei saanud oma sisselogimist võtmehoidjasse (Keychain) salvestada (viga %1$@), seega jäi see lisamata. Näita uut koodi ja proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n'a pas pu enregistrer sa connexion dans le trousseau (erreur %1$@), il n'a donc pas été ajouté. Affichez un nouveau code et réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac nije mogao spremiti svoju prijavu u Privjesak ključeva (pogreška %1$@) pa nije dodan. Prikažite novi kôd i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a Mac nem tudta menteni a bejelentkezést a Kulcskarikába (hiba: %1$@), ezért nem lett hozzáadva. Jeleníts meg új kódot, és próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս Mac-ը չկարողացավ պահել իր մուտքը Keychain-ում (սխալ %1$@), ուստի չավելացվեց։ Ցույց տվեք նոր կոդ և փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini tidak dapat menyimpan informasi masuknya di Rantai Kunci (galat %1$@), jadi tidak ditambahkan. Tampilkan kode baru lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non è riuscito a salvare l'accesso nel portachiavi (errore %1$@), quindi non è stato aggiunto. Mostra un nuovo codice e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはサインイン情報をキーチェーンに保存できなかったため（エラー %1$@）、追加されませんでした。新しいコードを表示して、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ Mac-მა თავისი შესვლა ვერ შეინახა Keychain-ში (შეცდომა %1$@), ამიტომ არ დაემატა. აჩვენეთ ახალი კოდი და სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac이 키체인에 로그인 정보를 저장하지 못해(오류 %1$@) 추가되지 않았습니다. 새 코드를 표시하고 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis Mac negalėjo išsaugoti prisijungimo Keychain (klaida %1$@), todėl nepridėtas. Parodykite naują kodą ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis Mac nevarēja saglabāt savu pierakstīšanos Keychain (kļūda %1$@), tāpēc tas netika pievienots. Parādi jaunu kodu un mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac kon zijn login niet in de sleutelhanger bewaren (fout %1$@) en is dus niet toegevoegd. Toon een nieuwe code en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie mógł zapisać logowania w pęku kluczy (błąd %1$@), więc nie został dodany. Pokaż nowy kod i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não conseguiu guardar o início de sessão no porta-chaves (erro %1$@), por isso não foi adicionado. Mostre um código novo e tente outra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não conseguiu guardar o login no porta-chaves (erro %1$@), por isso não foi adicionado. Mostre um código novo e tente outra vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest Mac nu și-a putut salva conectarea în Keychain (eroarea %1$@), așa că nu a fost adăugat. Afișați un cod nou și încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento Mac nemohol uložiť prihlásenie do Kľúčenky (chyba %1$@), takže sa nepridal. Zobrazte nový kód a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Mac ni mogel shraniti prijave v Obesek za ključe (napaka %1$@), zato ni bil dodan. Prikažite novo kodo in poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky Mac nuk e ruajti dot hyrjen e vet në Keychain (gabimi %1$@), ndaj nuk u shtua. Shfaqni një kod të ri dhe provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac nije mogao sačuvati svoju prijavu u Privjesak ključeva (greška %1$@) pa nije dodan. Prikažite novi kôd i pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้บันทึกการเข้าสู่ระบบลงพวงกุญแจไม่ได้ (ข้อผิดพลาด %1$@) จึงยังไม่ได้เพิ่ม แสดงรหัสใหม่แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac oturum bilgisini Anahtar Zinciri'ne kaydedemedi (hata %1$@), bu yüzden eklenmedi. Yeni bir kod gösterip tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac này không thể lưu thông tin đăng nhập vào Chuỗi khóa (lỗi %1$@) nên chưa được thêm. Hãy hiện mã mới và thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 無法將登入資訊儲存到鑰匙圈（錯誤 %1$@），因此未新增。請顯示新代碼後再試一次。"
          }
        }
      }
    },
    "pair.keyring_refused": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kompüter giriş məlumatını saxlaya bilmədi, ona görə əlavə edilmədi: ona işləyən və kilidi açılmış açar saxlayıcısı lazımdır, məsələn GNOME Keyring, KWallet və ya KeePassXC. Birini qurun və ya kilidini açın, sonra yeni kod göstərin və yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този компютър не можа да запази входа си, така че не беше добавен: нужен е работещ и отключен keyring, например GNOME Keyring, KWallet или KeePassXC. Настройте или отключете такъв, след това покажете нов код и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento počítač nemohl uložit přihlášení, takže se nepřidal: potřebuje spuštěnou a odemčenou klíčenku, například GNOME Keyring, KWallet nebo KeePassXC. Nastavte ji nebo odemkněte, pak zobrazte nový kód a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Computer konnte seine Anmeldung nicht sichern und wurde nicht hinzugefügt: Er braucht einen laufenden, entsperrten Schlüsselbund wie GNOME Keyring, KWallet oder KeePassXC. Richte einen ein oder entsperre ihn, zeig dann einen neuen Code und versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer couldn't save its sign-in, so it wasn't added: it needs a keyring that's running and unlocked, such as GNOME Keyring, KWallet or KeePassXC. Set one up or unlock it, then show a new code and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ordenador no pudo guardar su inicio de sesión, así que no se añadió: necesita un llavero en marcha y desbloqueado, como GNOME Keyring, KWallet o KeePassXC. Configura uno o desbloquéalo, y después muestra un código nuevo y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See arvuti ei saanud oma sisselogimist salvestada, seega jäi see lisamata: vaja on töötavat ja lukust lahti võtmehoidjat, näiteks GNOME Keyring, KWallet või KeePassXC. Seadista või ava see, siis näita uut koodi ja proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet ordinateur n'a pas pu enregistrer sa connexion, il n'a donc pas été ajouté : il lui faut un trousseau actif et déverrouillé, comme GNOME Keyring, KWallet ou KeePassXC. Configurez-en un ou déverrouillez-le, puis affichez un nouveau code et réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo računalo nije moglo spremiti svoju prijavu pa nije dodano: treba mu pokrenut i otključan spremnik ključeva, kao što su GNOME Keyring, KWallet ili KeePassXC. Postavite ga ili ga otključajte, zatim prikažite novi kôd i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a számítógép nem tudta menteni a bejelentkezést, ezért nem lett hozzáadva: futó és feloldott kulcstartóra van szükség, például GNOME Keyring, KWallet vagy KeePassXC. Állíts be egyet vagy oldd fel, majd jeleníts meg új kódot, és próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս համակարգիչը չկարողացավ պահել իր մուտքը, ուստի չավելացվեց․ նրան պետք է բանալիների պահոց, որը աշխատում է և ապակողպված է, օրինակ՝ GNOME Keyring, KWallet կամ KeePassXC։ Կարգավորեք կամ ապակողպեք այն, ապա ցույց տվեք նոր կոդ և փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer ini tidak dapat menyimpan informasi masuknya, jadi tidak ditambahkan: perlu gantungan kunci yang berjalan dan tidak terkunci, seperti GNOME Keyring, KWallet, atau KeePassXC. Siapkan atau buka kuncinya, lalu tampilkan kode baru dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo computer non è riuscito a salvare l'accesso, quindi non è stato aggiunto: serve un portachiavi attivo e sbloccato, come GNOME Keyring, KWallet o KeePassXC. Configurane uno o sbloccalo, poi mostra un nuovo codice e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータはサインイン情報を保存できなかったため、追加されませんでした。GNOME Keyring、KWallet、KeePassXCなど、実行中でロック解除されたキーリングが必要です。設定するかロックを解除してから、新しいコードを表示してもう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ კომპიუტერმა თავისი შესვლა ვერ შეინახა, ამიტომ არ დაემატა: მას სჭირდება გასაღებების საცავი, რომელიც მუშაობს და განბლოკილია, მაგალითად GNOME Keyring, KWallet ან KeePassXC. დააყენეთ ან განბლოკეთ ის, შემდეგ აჩვენეთ ახალი კოდი და სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터가 로그인 정보를 저장하지 못해 추가되지 않았습니다. GNOME Keyring, KWallet, KeePassXC처럼 실행 중이고 잠금 해제된 키링이 필요합니다. 키링을 설정하거나 잠금 해제한 뒤, 새 코드를 표시하고 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis kompiuteris negalėjo išsaugoti prisijungimo, todėl nepridėtas: reikia veikiančios ir atrakintos raktų saugyklos (keyring), pvz., GNOME Keyring, KWallet ar KeePassXC. Nustatykite ar atrakinkite ją, tada parodykite naują kodą ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis dators nevarēja saglabāt savu pierakstīšanos, tāpēc tas netika pievienots: vajag palaistu un atbloķētu atslēgu glabātuvi (keyring), piemēram, GNOME Keyring, KWallet vai KeePassXC. Iestati vai atbloķē to, tad parādi jaunu kodu un mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze computer kon zijn login niet bewaren en is dus niet toegevoegd: er is een actieve, ontgrendelde sleutelhanger nodig, zoals GNOME Keyring, KWallet of KeePassXC. Stel er een in of ontgrendel hem, toon dan een nieuwe code en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten komputer nie mógł zapisać logowania, więc nie został dodany: potrzebuje działającego, odblokowanego pęku kluczy, takiego jak GNOME Keyring, KWallet lub KeePassXC. Skonfiguruj go lub odblokuj, a potem pokaż nowy kod i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este computador não conseguiu guardar o início de sessão, por isso não foi adicionado: precisa de um porta-chaves ativo e desbloqueado, como o GNOME Keyring, o KWallet ou o KeePassXC. Configure um ou desbloqueie-o e, depois, mostre um código novo e tente outra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este computador não conseguiu guardar o login, por isso não foi adicionado: precisa de um porta-chaves ativo e desbloqueado, como o GNOME Keyring, o KWallet ou o KeePassXC. Configure um ou desbloqueie-o e, depois, mostre um código novo e tente outra vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest computer nu și-a putut salva conectarea, așa că nu a fost adăugat: are nevoie de un keyring pornit și deblocat, cum ar fi GNOME Keyring, KWallet sau KeePassXC. Configurați sau deblocați unul, apoi afișați un cod nou și încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento počítač nemohol uložiť prihlásenie, takže sa nepridal: potrebuje spustenú a odomknutú kľúčenku, napríklad GNOME Keyring, KWallet alebo KeePassXC. Nastavte ju alebo odomknite, potom zobrazte nový kód a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta računalnik ni mogel shraniti prijave, zato ni bil dodan: potrebuje zagnan in odklenjen shranjevalnik ključev, na primer GNOME Keyring, KWallet ali KeePassXC. Nastavite ga ali odklenite, nato prikažite novo kodo in poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky kompjuter nuk e ruajti dot hyrjen e vet, ndaj nuk u shtua: ka nevojë për një varg çelësash që është aktiv dhe i zhbllokuar, si GNOME Keyring, KWallet ose KeePassXC. Konfigurojeni ose zhbllokojeni, pastaj shfaqni një kod të ri dhe provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo računar nije moglo sačuvati svoju prijavu pa nije dodano: treba mu pokrenut i otključan spremnik ključeva, kao šta su GNOME Keyring, KWallet ili KeePassXC. Podesite ga ili ga otključajte, zatim prikažite novi kôd i pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คอมพิวเตอร์เครื่องนี้บันทึกการเข้าสู่ระบบไม่ได้ จึงยังไม่ได้เพิ่ม: ต้องมีพวงกุญแจที่ทำงานอยู่และปลดล็อกแล้ว เช่น GNOME Keyring, KWallet หรือ KeePassXC ตั้งค่าหรือปลดล็อกมัน แล้วแสดงรหัสใหม่และลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgisayar oturum bilgisini kaydedemedi, bu yüzden eklenmedi: çalışan ve kilidi açık bir anahtar deposu gerekir; örneğin GNOME Keyring, KWallet veya KeePassXC. Birini kurun veya kilidini açın, sonra yeni bir kod gösterip tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tính này không thể lưu thông tin đăng nhập nên chưa được thêm: cần một chuỗi khóa đang chạy và đã mở khóa, như GNOME Keyring, KWallet hoặc KeePassXC. Hãy thiết lập hoặc mở khóa nó, rồi hiện mã mới và thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部電腦無法儲存登入資訊，因此未新增：需要一個正在執行且已解鎖的金鑰環，例如 GNOME Keyring、KWallet 或 KeePassXC。請設定或解鎖它，然後顯示新代碼後再試一次。"
          }
        }
      }
    },
