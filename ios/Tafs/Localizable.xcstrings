    "settings.devices.pair_expired": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompüterinizdəki kodun vaxtı bitdi. Yenisini göstərin və yenidən skan edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодът на компютъра ви изтече. Покажете нов и го сканирайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnost kódu na vašem počítači vypršela. Zobrazte nový a naskenujte ho znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code auf deinem Computer ist abgelaufen. Lass einen neuen anzeigen und scanne ihn erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code on your computer expired. Show a new one and scan it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de tu ordenador ha caducado. Muestra uno nuevo y escanéalo otra vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu arvuti kood aegus. Näita uut ja skanni see uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code sur votre ordinateur a expiré. Affichez-en un nouveau et scannez-le à nouveau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôd na vašem računalu je istekao. Prikažite novi i skenirajte ga ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A számítógépeden lévő kód lejárt. Jeleníts meg egy újat, és olvasd be újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր համակարգչի կոդի ժամկետը լրացավ։ Ցույց տվեք նորը և նորից սկանավորեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode di komputer Anda kedaluwarsa. Tampilkan yang baru lalu pindai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice sul tuo computer è scaduto. Mostrane uno nuovo e scansionalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータのコードの有効期限が切れました。新しいコードを表示して、もう一度スキャンしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენს კომპიუტერზე კოდის ვადა ამოიწურა. აჩვენეთ ახალი და ხელახლა დაასკანერეთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터의 코드가 만료되었습니다. 새 코드를 표시하고 다시 스캔하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodas jūsų kompiuteryje nebegalioja. Parodykite naują ir nuskaitykite jį dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda derīgums tavā datorā beidzās. Parādi jaunu un skenē to vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code op je computer is verlopen. Toon een nieuwe en scan die opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod na Twoim komputerze wygasł. Wyświetl nowy i zeskanuj go ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O código no seu computador expirou. Mostre um novo e leia-o outra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código no seu computador expirou. Mostre um novo e leia-o outra vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codul de pe computer a expirat. Afișați unul nou și scanați-l din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnosť kódu na vašom počítači vypršala. Zobrazte nový a naskenujte ho znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda na vašem računalniku je potekla. Prikažite novo in jo znova skenirajte."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodi në kompjuterin tuaj skadoi. Shfaqni një të ri dhe skanojeni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôd na vašem računaru je istekao. Prikažite novi i skenirajte ga ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสบนคอมพิวเตอร์ของคุณหมดอายุ แสดงรหัสใหม่แล้วสแกนอีกครั้ง"
