    "watch.kept_to_send": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ على هذه الساعة. يُرسل عندما يعود هاتفك في المتناول."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu saatda saxlanılıb. Telefonunuz yenidən əlçatan olanda göndərilir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазено на този часовник. Изпраща се, когато телефонът ви отново е наблизо."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ঘড়িতে রাখা আছে। আপনার ফোন আবার নাগালে এলে এটি পাঠানো হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardat en aquest rellotge. S'envia quan el telèfon torni a ser a l'abast."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo v těchto hodinkách. Odešle se, až bude telefon zase na dosah."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dieser Uhr gespeichert. Wird gesendet, sobald dein Handy wieder in Reichweite ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept on this watch. It's sent when your phone is in reach again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en este reloj. Se envía cuando tu teléfono vuelva a estar al alcance."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoitakse selles kellas. See saadetakse, kui telefon on jälle käeulatuses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardé sur cette montre. Il part dès que votre téléphone est de nouveau à portée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר בשעון הזה. הוא יישלח כשהטלפון שלך יהיה שוב בטווח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस घड़ी पर रखा गया। आपके फ़ोन के फिर पहुँच में आने पर भेजा जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržano na ovom satu. Šalje se kad vaš telefon opet bude u dometu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen az órán megtartva. Akkor megy el, amikor a telefonod újra elérhető közelségben lesz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահվում է այս ժամացույցում։ Կուղարկվի, երբ ձեր հեռախոսը նորից հասանելի լինի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan di jam tangan ini. Dikirim saat ponsel Anda kembali terjangkau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenuto su questo orologio. Viene inviato quando il telefono torna raggiungibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウォッチに保存しました。スマートフォンが近くに戻ると送信します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ინახება ამ საათზე. გაიგზავნება, როცა თქვენი ტელეფონი ისევ მიმწვდომი იქნება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានរក្សាទុកនៅលើនាឡិកានេះ។ វាត្រូវបានផ្ញើនៅពេលទូរសព្ទរបស់អ្នកស្ថិតក្នុងចម្ងាយម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 워치에 보관했습니다. 휴대폰이 다시 가까이 오면 보냅니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເກັບໄວ້ໃນໂມງນີ້. ມັນຖືກສົ່ງເມື່ອໂທລະສັບຂອງທ່ານຢູ່ໃນໄລຍະອີກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išsaugota šiame laikrodyje. Bus išsiųsta, kai telefonas vėl bus pasiekiamas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saglabāts šajā pulkstenī. Tas tiks nosūtīts, kad tālrunis atkal būs tuvumā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чувано на овој часовник. Се испраќа кога телефонот пак ќе биде на дофат."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ цагт хадгалсан. Утас тань дахин ойртмогц илгээгдэнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो घडीमा राखिएको छ। फोन फेरि पहुँचमा आएपछि पठाइन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaard op dit horloge. Het gaat zodra je telefoon weer binnen bereik is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano na tym zegarku. Zostanie wysłane, gdy telefon znów będzie w zasięgu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado neste relógio. É enviado quando o telemóvel voltar a estar ao alcance."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado neste relógio. É enviado quando o celular voltar a estar ao alcance."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrat pe acest ceas. Se trimite când telefonul este din nou în apropiere."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené v týchto hodinkách. Odošle sa, keď bude telefón znova na dosah."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranjeno na tej uri. Poslano bo, ko bo telefon spet v dosegu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbahet në këtë orë. Dërgohet kur telefoni juaj të jetë sërish në rreze."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržano na ovom satu. Šalje se kad vaš telefon opet bude u dometu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บไว้บนนาฬิกาเรือนนี้ จะส่งเมื่อโทรศัพท์ของคุณอยู่ในระยะอีกครั้ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sagatda saklandy. Telefonyňyz ýene elýeterli bolanda iberilýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu saatte saklandı. Telefonunuz tekrar erişilebilir olunca gönderilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس گھڑی پر رکھا گیا۔ آپ کا فون پہنچ میں آنے پر بھیجا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được giữ trên đồng hồ này. Nó sẽ được gửi khi điện thoại của bạn trong tầm với trở lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留在這支手錶上。待您的手機再次在範圍內時會傳送。"
          }
        }
      }
    },
