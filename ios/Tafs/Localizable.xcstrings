    "door.remove_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Adresse gehört nicht mehr %1$@. Nachrichten, die schon in seinem Chat sind, bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its address stops being %2$@. Messages already in its chat stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su dirección deja de ser de %1$@. Los mensajes que ya están en su chat se conservan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle aadress ei kuulu enam tafile %1$@. Selle vestluses juba olevad sõnumid jäävad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son adresse n'est plus celle de %1$@. Les messages déjà dans son chat restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo indirizzo non appartiene più a %1$@. I messaggi già nella sua chat restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのアドレスは%1$@のものではなくなります。すでにチャットにあるメッセージは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소는 더 이상 %1$@의 것이 아닙니다. 이미 채팅에 있는 메시지는 남습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jų adresas nebepriklauso taf %1$@. Jau pokalbyje esančios žinutės lieka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tās adrese vairs nepieder %1$@. Ziņas, kas jau ir tā sarunā, paliek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres is dan niet meer van %1$@. Berichten die al in de chat staan, blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego adres przestaje należeć do %1$@. Wiadomości, które są już w czacie, zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu endereço deixa de ser de %1$@. As mensagens já no chat mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu endereço deixa de ser de %1$@. As mensagens já no chat mantêm-se."
