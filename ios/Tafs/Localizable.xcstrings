    "halt.explain.halted": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angehalten. Fortsetzen startet nur neue Arbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halted. Resuming starts only new work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. Al reanudar, solo empieza trabajo nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peatatud. Jätkamisel algab ainult uus töö."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqué. La reprise ne lance que du nouveau travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccato. Riprendendo, parte solo lavoro nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮断済みです。再開すると新しい作業だけが始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단됨. 재개하면 새 작업만 시작됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustabdyta. Tęsiant pradedamas tik naujas darbas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apturēts. Turpinot sākas tikai jauns darbs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilgezet. Hervatten start alleen nieuw werk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowane. Wznowienie uruchamia tylko nową pracę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. Ao retomar, só começa trabalho novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. Ao retomar, só começa trabalho novo."
          }
        }
