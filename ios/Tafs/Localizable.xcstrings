        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz bu dilde konuşmayı kendi başına metne çeviremiyor. Bunun yerine yazın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại của bạn không thể tự chuyển giọng nói thành văn bản bằng ngôn ngữ này. Hãy gõ thay thế."
          }
