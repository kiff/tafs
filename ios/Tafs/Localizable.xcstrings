          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gestopt: deze taak had meer stappen nodig dan de limiet voor één taak. Vraag om iets kleiners."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatrzymał się: to zadanie wymagało więcej kroków niż jego limit na jedno zadanie. Poproś o coś węższego."
