    "needs_you.second_step": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əlavə yer keçdi. Bu çağırış öz limiti üçün yenidən saxlanılır: %1$@. Onu buraxmaq üçün bir dəfə təsdiq edin və ya rədd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Допълнителният лимит мина. Тази заявка е задържана отново заради собствен лимит: %1$@. Одобрете я еднократно, за да я пуснете, или я откажете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Víc prostoru prošlo. Toto volání je znovu zadrženo kvůli vlastnímu limitu: %1$@. Schvalte ho jednou, aby prošlo, nebo ho odmítněte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zusatzspielraum ist durchgegangen. Dieser Aufruf wird wegen eines eigenen Limits erneut zurückgehalten: %1$@. Genehmige ihn einmal, damit er durchgeht, oder lehne ihn ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra room went through. This call is held again for a limit of its own: %1$@. Approve it once to let it go, or refuse it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El margen extra se aplicó. Esta llamada vuelve a estar retenida por un límite propio: %1$@. Aprueba una vez para dejarla pasar, o recházala."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisaruum läks läbi. See päring on uuesti kinni peetud oma limiidi tõttu: %1$@. Läbi laskmiseks kinnita see üks kord või keeldu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La marge supplémentaire a été accordée. Cet appel est à nouveau retenu pour une limite qui lui est propre : %1$@. Approuvez-le une fois pour le laisser passer, ou refusez-le."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatni prostor je prošao. Ovaj je poziv ponovno zadržan zbog vlastitog ograničenja: %1$@. Odobrite ga jednom da ode ili ga odbijte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az extra keret átment. Ez a hívás egy saját limit miatt újra vissza van tartva: %1$@. Hagyd jóvá egyszer, hogy továbbmenjen, vagy utasítsd el."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Լրացուցիչ տարածքն անցավ։ Այս զանգը նորից պահվում է իր սեփական սահմանաչափի պատճառով՝ %1$@։ Հաստատեք մեկ անգամ՝ թողնելու համար, կամ մերժեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang tambahan sudah lolos. Panggilan ini ditahan lagi karena batasnya sendiri: %1$@. Setujui sekali agar lewat, atau tolak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il margine extra è stato applicato. Questa chiamata è di nuovo trattenuta per un suo limite: %1$@. Approvala una volta per lasciarla passare, o rifiutala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "枠の追加は完了しました。この呼び出しは、別の上限のために再び保留されています：%1$@。1回だけ承認して通すか、拒否してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დამატებითმა სივრცემ გაიარა. ეს ზარი ხელახლა დაკავდა საკუთარი ლიმიტის გამო: %1$@. დაამტკიცეთ ერთხელ, რომ წავიდეს, ან უარყავით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 허용이 적용되었습니다. 이 호출은 자체 한도 때문에 다시 보류되었습니다: %1$@. 한 번 승인해 보내거나 거절하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Papildomas rezervas suteiktas. Ši užklausa vėl sulaikyta dėl savo limito: %1$@. Patvirtinkite ją vieną kartą, kad ji būtų išsiųsta, arba atmeskite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Papildu rezerve tika piešķirta. Šis izsaukums atkal ir aizturēts sava limita dēļ: %1$@. Apstiprini to vienreiz, lai to izpildītu, vai atsaki to."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra ruimte is gelukt. Deze aanroep wordt opnieuw vastgehouden voor een eigen limiet: %1$@. Je kunt het eenmalig goedkeuren om het door te laten, of het weigeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowy zapas został przyznany. To wywołanie jest znowu oczekujące z powodu własnego limitu: %1$@. Zatwierdź je raz, aby je przepuścić, albo je odrzuć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A margem extra foi concedida. Esta chamada está novamente retida por um limite próprio: %1$@. Aprove-a uma vez para a deixar seguir, ou recuse-a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A margem extra foi concedida. Esta chamada está novamente retida por um limite próprio: %1$@. Aprove-a uma vez para a deixar seguir, ou recuse-a."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiul suplimentar a trecut. Acest apel este reținut din nou pentru o limită proprie: %1$@. Aprobați-l o dată pentru a-l lăsa să plece sau refuzați-l."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Viac priestoru prešlo. Toto volanie je znova pozdržané pre vlastný limit: %1$@. Schváľte ho raz, aby prešlo, alebo ho odmietnite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaten prostor je šel skozi. Ta klic je znova zadržan zaradi lastne omejitve: %1$@. Enkrat ga odobrite, da gre, ali ga zavrnite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapësira shtesë kaloi. Kjo thirrje mbahet sërish për një kufi të vetin: %1$@. Miratojeni një herë që të shkojë, ose refuzojeni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatni prostor je prošao. Ovaj je poziv ponovo zadržan zbog vlastitog ograničenja: %1$@. Odobrite ga jednom da ode ili ga odbijte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเพิ่มพื้นที่ผ่านแล้ว การเรียกนี้ถูกพักไว้อีกครั้งเพราะขีดจำกัดของมันเอง: %1$@ อนุมัติครั้งเดียวเพื่อปล่อยผ่าน หรือปฏิเสธ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek pay geçti. Bu çağrı kendi limiti yüzünden tekrar tutuldu: %1$@. Geçmesi için bir kez onaylayın veya reddedin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm hạn mức đã đi qua. Lệnh gọi này lại bị giữ vì một hạn mức riêng của nó: %1$@. Hãy phê duyệt một lần để cho đi qua, hoặc từ chối."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "額外額度已通過。這次呼叫因它自己的上限而再次被保留：%1$@。核准一次即可放行，或拒絕。"
          }
        }
      }
    },
