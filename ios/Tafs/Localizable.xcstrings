            "state": "translated",
            "value": "Perubahan ini bukan yang ditawarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa modifica non è quella proposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変更は提案されたものではありません。"
          }
        },
        "ka": {
          "stringUnit": {
