        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন থেকে %1$@-এর মাধ্যমে তাঁর বার্তা এটিকে কাজ দেয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir d'ara els seus missatges per %1$@ li donen feina"
