    "billing.ask.line_raise": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Admins deines Kontos erhalten deine Anfrage. Sobald einer das Ausgabenlimit erhöht, arbeiten deine tafs weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account's admins get your request. When one raises the spend limit, your tafs go on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los administradores de tu cuenta reciben tu solicitud. Cuando uno suba el límite de gasto, tus tafs seguirán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les administrateurs de votre compte reçoivent votre demande. Dès que l'un d'eux relève le plafond de dépenses, vos tafs continuent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli amministratori del tuo account ricevono la tua richiesta. Quando uno aumenta il limite di spesa, i tuoi tafs continuano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beheerders van je account krijgen je verzoek. Zodra er een de uitgavenlimiet verhoogt, gaan je tafs verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratorzy Twojego konta otrzymają Twoją prośbę. Gdy któryś podniesie limit wydatków, Twoje tafs będą działać dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os administradores da sua conta recebem o seu pedido. Quando um deles aumentar o limite de gastos, os seus tafs continuam."
          }
        }
      }
    },
