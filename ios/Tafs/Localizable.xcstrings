    "coach.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne eine App, mit der ein taf arbeiten soll, etwa deinen Zahlungsanbieter. Du meldest dich auf der eigenen Seite der App an, und deine Anmeldung bleibt versiegelt: Kein taf sieht sie je."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name an app a taf should work with, like your payment provider. You sign in on the app's own page, and your sign-in is kept sealed: no taf ever sees it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra una app con la que debería trabajar un taf, como tu proveedor de pagos. Inicias sesión en la propia página de la app, y tu inicio de sesión se guarda sellado: ningún taf lo ve nunca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez une app avec laquelle un taf doit travailler, comme votre prestataire de paiement. Vous vous connectez sur la page de l'app, et votre connexion reste scellée : aucun taf ne la voit jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un'app con cui un taf dovrebbe lavorare, come il tuo fornitore di pagamenti. Accedi sulla pagina dell'app, e il tuo accesso resta sigillato: nessun taf lo vede mai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noem een app waarmee een taf moet werken, zoals je betaalprovider. Je logt in op de eigen pagina van de app, en je login blijft verzegeld: geen enkel taf ziet hem ooit."
          }
        },
        "pl": {
