    "voice.voice_becomes_text_device_not": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səsiniz bu cihazda mətnə çevrilir. Siz göndərməyincə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гласът ви става текст на това устройство. Не се изпраща, докато не го изпратите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš hlas se v tomto zařízení změní na text. Neodešle se, dokud ho neodešlete vy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme wird auf diesem Gerät zu Text. Sie wird erst gesendet, wenn du sendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice becomes text on this device. It isn't sent until you send it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz se convierte en texto en este dispositivo. No se envía hasta que lo envíes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu hääl muutub selles seadmes tekstiks. Seda ei saadeta enne, kui sa selle saadad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre voix devient du texte sur cet appareil. Elle n'est envoyée que lorsque vous l'envoyez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš glas postaje tekst na ovom uređaju. Ne šalje se dok ga vi ne pošaljete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangod ezen az eszközön lesz szöveg. Nem megy el, amíg el nem küldöd."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր ձայնը վերածվում է տեքստի այս սարքում։ Այն չի ուղարկվում, մինչև չուղարկեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara Anda menjadi teks di perangkat ini. Teks tidak dikirim sampai Anda mengirimnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua voce diventa testo su questo dispositivo. Non viene inviata finché non la invii tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声はこのデバイス上でテキストになります。あなたが送信するまで送られません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი ხმა ტექსტად იქცევა ამ მოწყობილობაზე. ის არ იგზავნება, სანამ თქვენ არ გააგზავნით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성은 이 기기에서 텍스트로 바뀝니다. 직접 보내기 전까지는 보내지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų balsas paverčiamas tekstu šiame įrenginyje. Niekas nesiunčiama, kol neišsiųsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tava balss šajā ierīcē kļūst par tekstu. Tas netiek sūtīts, kamēr tu to nenosūti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je stem wordt op dit apparaat tekst. Er wordt niets verzonden tot je het verzendt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój głos zamienia się w tekst na tym urządzeniu. Nie zostanie wysłany, dopóki go nie wyślesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua voz torna-se texto neste dispositivo. Não é enviada até a enviar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua voz torna-se texto neste dispositivo. Não é enviada até a enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocea dvs. devine text pe acest dispozitiv. Nu este trimisă până nu o trimiteți dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš hlas sa v tomto zariadení zmení na text. Neodošle sa, kým ho neodošlete vy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš glas postane besedilo na tej napravi. Ne pošlje se, dokler ga ne pošljete vi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Zëri juaj kthehet në tekst në këtë pajisje. Nuk dërgohet derisa ta dërgoni ju."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš glas postaje tekst na ovom uređaju. Ne šalje se dok ga vi ne pošaljete."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงของคุณกลายเป็นข้อความบนอุปกรณ์นี้ ข้อความจะไม่ถูกส่งจนกว่าคุณจะกดส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiniz bu cihazda metne dönüşür. Siz göndermeden gönderilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng nói của bạn được chuyển thành văn bản trên thiết bị này. Văn bản không được gửi cho đến khi bạn gửi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的語音會在這部裝置上轉成文字。在您傳送之前不會送出。"
          }
        }
      }
    },
    "voice.what_you_said_stays_message": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dediyiniz mesaj qutusunda, göndərilməmiş qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това, което казахте, остава в полето за съобщение, неизпратено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jste řekli, zůstane v poli zprávy, neodeslané."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du gesagt hast, bleibt ungesendet im Nachrichtenfeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you said stays in the message box, unsent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que dijiste se queda en el cuadro de mensaje, sin enviar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See, mida ütlesid, jääb sõnumikasti saatmata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez dit reste dans le champ de message, non envoyé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ono što ste rekli ostaje u okviru za poruku, neposlano."
