    "receipt.if_it_stays": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das so bleibt, nenn uns die Beleg-ID unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this stays, tell us the receipt id below."
