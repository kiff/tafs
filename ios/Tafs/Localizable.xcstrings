    "sample.brief.next_move": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "7 gündən sonra cavab verməyən bu 3 potensial müştəri üçün ikinci təqib layihəsi hazırlansın?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да подготвим ли второ напомняне за тези 3 потенциални клиенти без отговор след 7 дни?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsat druhou připomínku těmto 3 poptávkám, které 7 dní neodpověděly?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein zweites Nachfassen für diese 3 Leads entwerfen, die nach 7 Tagen nicht geantwortet haben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft a second follow-up for these 3 leads with no reply after 7 days?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Redactar un segundo seguimiento para estos 3 contactos sin respuesta tras 7 días?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas koostada teine järelsõnum neile 3 müügivihjele, kes pole 7 päeva jooksul vastanud?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédiger une deuxième relance pour ces 3 prospects sans réponse après 7 jours ?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sastaviti drugo praćenje za ova 3 potencijalna kupca bez odgovora nakon 7 dana?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írjunk egy második követő üzenetet ennek a 3 érdeklődőnek, akik 7 nap után sem válaszoltak?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կազմե՞լ երկրորդ շարունակական հաղորդագրություն այս 3 պոտենցիալ հաճախորդների համար, որոնք 7 օրում չեն պատասխանել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun tindak lanjut kedua untuk 3 calon pelanggan yang tidak membalas setelah 7 hari?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparare un secondo ricontatto per questi 3 contatti senza risposta dopo 7 giorni?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日間返信のない見込み客3件に、2回目のフォローアップの下書きを作りますか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შედგეს მეორე შემდგომი შეტყობინება ამ 3 პოტენციური კლიენტისთვის, რომლებმაც 7 დღეში არ უპასუხეს?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일 동안 답이 없는 리드 3곳에 두 번째 후속 메시지 초안을 쓸까요?"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parengti antrą priminimą šiems 3 potencialiems klientams, kurie neatsakė per 7 dienas?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagatavot otru atgādinājumu šiem 3 interesentiem, kas nav atbildējuši 7 dienas?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tweede opvolging opstellen voor deze 3 leads zonder antwoord na 7 dagen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotować drugą wiadomość do tych 3 leadów bez odpowiedzi od 7 dni?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparar um segundo seguimento para estes 3 contactos sem resposta há 7 dias?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparar um segundo acompanhamento para estes 3 contatos sem resposta há 7 dias?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schițăm un al doilea mesaj de urmărire pentru acești 3 clienți potențiali fără răspuns după 7 zile?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napísať druhú pripomienku týmto 3 dopytom, ktoré 7 dní neodpovedali?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripravim drugo nadaljevanje za ta 3 povpraševanja brez odgovora po 7 dneh?"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Të hartohet një ndjekje e dytë për këta 3 klientë të mundshëm pa përgjigje pas 7 ditësh?"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sastaviti drugo praćenje za ova 3 potencijalna kupca bez odgovora nakon 7 dana?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ร่างการติดตามครั้งที่สองสำหรับลูกค้าเป้าหมาย 3 รายนี้ที่ยังไม่ตอบหลัง 7 วันหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 gün sonra yanıt vermeyen bu 3 potansiyel müşteri için ikinci bir takip taslağı hazırlansın mı?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soạn lần theo dõi thứ hai cho 3 khách tiềm năng này, vì chưa có phản hồi sau 7 ngày?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要為這 3 位 7 天沒回覆的潛在客戶草擬第二次跟進嗎？"
          }
        }
      }
    },
