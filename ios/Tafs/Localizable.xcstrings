    "coach.sign_in_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigene Seite des Anbieters öffnet sich. Dein Passwort und deine Schlüssel werden hier nie angezeigt, und deine Anmeldung bleibt versiegelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vendor's own page opens. Your password and keys are never shown here, and your sign-in is kept sealed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre la propia página del proveedor. Tu contraseña y tus claves nunca se muestran aquí, y tu inicio de sesión se guarda sellado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page du fournisseur s'ouvre. Votre mot de passe et vos clés ne s'affichent jamais ici, et votre connexion reste scellée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apre la pagina del fornitore. La tua password e le tue chiavi non vengono mai mostrate qui, e il tuo accesso resta sigillato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eigen pagina van de leverancier opent. Je wachtwoord en sleutels worden hier nooit getoond, en je login blijft verzegeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otworzy się strona samego dostawcy. Twoje hasło i klucze nigdy nie są tu pokazywane, a Twoje logowanie pozostaje zapieczętowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre-se a própria página do fornecedor. A sua palavra-passe e as suas chaves nunca são mostradas aqui, e o seu início de sessão fica selado."
          }
        }
      }
    },
