    "settings.account_zone_changed_schedules_could": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت المنطقة الزمنية للحساب. تعذّر تحديث جداوله بعد: %1$@"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın saat qurşağı dəyişdi. Cədvəlləri hələ yenilənə bilmədi: %1$@"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовата зона на акаунта се промени. Графиците му още не можаха да бъдат актуализирани: %1$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্টের সময় অঞ্চল বদলেছে। এর সূচি এখনও হালনাগাদ করা যায়নি: %1$@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona horària del compte ha canviat. Les seves programacions encara no s'han pogut actualitzar: %1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Časové pásmo účtu se změnilo. Jeho plány se zatím nepodařilo aktualizovat: %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeitzone des Kontos hat sich geändert. Seine Zeitpläne konnten noch nicht aktualisiert werden: %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account's zone changed. Its schedules couldn't be updated yet: %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona horaria de la cuenta cambió. Aún no se pudieron actualizar sus programaciones: %1$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto ajavöönd muutus. Selle ajakavasid ei õnnestunud veel uuendada: %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fuseau horaire du compte a changé. Ses plannings n'ont pas encore pu être mis à jour : %1$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אזור הזמן של החשבון השתנה. לא ניתן היה לעדכן עדיין את התזמונים שלו: %1$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते का समय क्षेत्र बदला। इसके निर्धारित समय अभी अपडेट नहीं हो सके: %1$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vremenska zona računa se promijenila. Njegove rasporede još nije bilo moguće ažurirati: %1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiók időzónája megváltozott. Az ütemezéseit még nem sikerült frissíteni: %1$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվի գոտին փոխվել է։ Նրա ժամանակացույցները դեռ չկարողացան թարմացվել՝ %1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona waktu akun berubah. Jadwalnya belum dapat diperbarui: %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fuso orario dell'account è cambiato. Non è stato ancora possibile aggiornare le sue pianificazioni: %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのタイムゾーンが変更されました。スケジュールはまだ更新できていません：%1$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშის ზონა შეიცვალა. მისი განრიგები ჯერ ვერ განახლდა: %1$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ល្វែងម៉ោងរបស់គណនីបានផ្លាស់ប្តូរ។ មិនទាន់អាចអាប់ដេតកាលវិភាគបានទេ៖ %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정의 시간대가 바뀌었습니다. 아직 일정을 업데이트하지 못했습니다: %1$@"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຂດເວລາຂອງບັນຊີປ່ຽນ. ຍັງອັບເດດຕາຕະລາງຂອງມັນບໍ່ໄດ້: %1$@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paskyros laiko juosta pasikeitė. Jos tvarkaraščių dar nepavyko atnaujinti: %1$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konta laika josla mainījās. Tā grafikus vēl nevarēja atjaunināt: %1$@"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Временската зона на сметката се промени. Распоредите сè уште не можеа да се ажурираат: %1$@"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүртгэлийн бүс өөрчлөгдсөн. Хуваариудыг одоохондоо шинэчилж чадсангүй: %1$@"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "खाताको समय क्षेत्र परिवर्तन भयो। तालिका अहिलेसम्म अपडेट गर्न सकिएन: %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijdzone van het account is gewijzigd. De planningen konden nog niet worden bijgewerkt: %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strefa czasowa konta się zmieniła. Jego harmonogramów nie udało się jeszcze zaktualizować: %1$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O fuso horário da conta mudou. Ainda não foi possível atualizar os seus agendamentos: %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fuso horário da conta mudou. Ainda não foi possível atualizar os seus agendamentos: %1$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusul orar al contului s-a schimbat. Programele sale nu au putut fi actualizate încă: %1$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Časové pásmo účtu sa zmenilo. Jeho plány sa zatiaľ nepodarilo aktualizovať: %1$@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Časovni pas računa se je spremenil. Njegovih urnikov še ni bilo mogoče posodobiti: %1$@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona e llogarisë ndryshoi. Oraret e saj nuk u përditësuan dot ende: %1$@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vremenska zona naloga se promenila. Njegove rasporede još nije bilo moguće ažurirati: %1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขตเวลาของบัญชีเปลี่ยนแล้ว ยังอัปเดตกำหนดการไม่ได้: %1$@"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasabyň wagt zolagy üýtgedi. Onuň tertipleri heniz täzelenip bilinmedi: %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın saat dilimi değişti. Zamanlamaları henüz güncellenemedi: %1$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹ کا ٹائم زون بدل گیا۔ اس کے شیڈول ابھی اپ ڈیٹ نہیں ہو سکے: %1$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Múi giờ của tài khoản đã đổi. Chưa thể cập nhật các lịch của nó: %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號的時區已變更。尚無法更新它的排程：%1$@"
          }
        }
      }
    },
