            "value": "Enne kinnitamist kontrolli, et KIFF näitab sama koodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que KIFF affiche le même code avant d'approuver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che KIFF mostri lo stesso codice prima di approvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認する前に、KIFFに同じコードが表示されていることを確認してください。"
          }
