    "taf.try_version_first_you_chat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب نسخة أولًا، تحت Card خاصة بها. تبقى النسخة الفعّالة تعمل. وتثبيت واحدة يجعلها فعّالة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlcə versiyanı öz Card-ı altında sınayın. İşləyən versiya işləməyə davam edir. Quraşdırmaq onu işləyən edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Първо пробвайте версия, под собствена Card. Активната версия продължава да работи. Инсталирането на версия я прави активна."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে একটি সংস্করণ নিজস্ব Card-এর অধীনে চেষ্টা করুন। চালু সংস্করণ কাজ করতে থাকে। ইনস্টল করলে সেটি চালু হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova primer una versió, sota un Card propi. La versió activa continua treballant. Instal·lar-la l'activa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív vyzkoušejte verzi pod vlastní Card. Aktivní verze dál pracuje. Instalací se verze stane aktivní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere eine Version zuerst aus, unter einer eigenen Card. Die Live-Version arbeitet weiter. Installierst du eine, geht sie live."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a version first, under a Card of its own. The live version keeps working. Installing one makes it live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba antes una versión, con una Card propia. La versión activa sigue trabajando. Al instalarla, pasa a estar activa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi versiooni kõigepealt, selle oma Cardi all. Kasutusel olev versioon töötab edasi. Paigaldamine võtab selle kasutusele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez d'abord une version, sous sa propre Card. La version en service continue de travailler. L'installer la met en service."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קודם כדאי לנסות גרסה, תחת Card משלה. הגרסה הפעילה ממשיכה לעבוד. התקנה הופכת אותה לפעילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले एक संस्करण अपने ही Card के तहत आज़माएँ। चालू संस्करण काम करता रहता है। एक को इंस्टॉल करने से वह चालू हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije isprobajte verziju, pod njezinim vlastitim Cardom. Verzija u radu i dalje radi. Instaliranje jedne pušta je u rad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb próbálj ki egy verziót, saját Carddal. Az élő verzió közben tovább dolgozik. A telepítés teszi élővé."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախ փորձեք տարբերակ՝ իր սեփական Card-ի ներքո։ Ակտիվ տարբերակը շարունակում է աշխատել։ Տեղադրումը այն դարձնում է ակտիվ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba sebuah versi terlebih dahulu, di bawah Card miliknya sendiri. Versi yang aktif tetap bekerja. Memasang satu menjadikannya aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova prima una versione, con una Card tutta sua. La versione attiva continua a lavorare. Installarla la rende attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず専用のCardのもとでバージョンを試せます。適用中のバージョンは動き続けます。インストールすると適用されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ სცადეთ ვერსია საკუთარი Card-ით. აქტიური ვერსია აგრძელებს მუშაობას. ერთის დაყენება მას აქტიურს ხდის."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សាកល្បងកំណែមួយជាមុន ក្រោម Card ផ្ទាល់ខ្លួន។ កំណែដែលកំពុងដំណើរការបន្តធ្វើការ។ ការដំឡើងមួយធ្វើឱ្យវាដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 별도의 Card로 버전을 시험해 보세요. 적용된 버전은 계속 작동합니다. 설치하면 그 버전이 적용됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລອງເວີຊັນກ່ອນ ພາຍໃຕ້ Card ຂອງມັນເອງ. ເວີຊັນທີ່ໃຊ້ງານຢູ່ເຮັດວຽກຕໍ່. ການຕິດຕັ້ງຈະເຮັດໃຫ້ມັນໃຊ້ງານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmiausia išbandykite versiją su atskira Card. Aktyvi versija dirba toliau. Įdiegus versiją, ji tampa aktyvi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vispirms izmēģini versiju ar savu Card. Darbā esošā versija turpina strādāt. Instalējot versiju, tā tiek laista darbā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прво пробај верзија, под сопствен Card. Активната верзија продолжува да работи. Инсталирањето на една ја прави активна."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Эхлээд хувилбарыг өөрийн Card-ын дор туршина уу. Идэвхтэй хувилбар ажиллсаар байна. Суулгах нь үүнийг идэвхтэй болгоно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिले संस्करण आफ्नै Card अन्तर्गत प्रयास गर्नुहोस्। सक्रिय संस्करण काम गरिरहन्छ। स्थापना गर्दा त्यो सक्रिय हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer eerst een versie uit, onder een eigen Card. De live versie blijft werken. Installeer je er een, dan wordt die live."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw wypróbuj wersję, w ramach jej własnej Card. Wersja działająca na żywo pracuje dalej. Instalacja wersji uruchamia ją na żywo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente primeiro uma versão, ao abrigo de um Card próprio. A versão em produção continua a trabalhar. Instalar uma coloca-a em produção."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente primeiro uma versão, ao abrigo de um Card próprio. A versão em produção continua trabalhando. Instalar uma coloca-a em produção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încercați mai întâi o versiune, sub un Card propriu. Versiunea activă continuă să lucreze. Instalarea uneia o face activă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv vyskúšajte verziu pod vlastnou Card. Aktívna verzia ďalej pracuje. Inštaláciou sa verzia stane aktívnou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej preizkusite različico pod njeno lastno Card. Aktivna različica še naprej dela. Namestitev jo naredi aktivno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Provoni më parë një version, nën një Card të vetin. Versioni aktiv vazhdon të punojë. Instalimi i një versioni e bën aktiv."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo isprobajte verziju, pod njenim vlastitim Cardom. Verzija u radu i dalje radi. Instaliranje jedne pušta je u rad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองเวอร์ชันหนึ่งก่อน ภายใต้ Card ของมันเอง เวอร์ชันที่ใช้งานอยู่ยังทำงานต่อ การติดตั้งเวอร์ชันหนึ่งจะทำให้มันเป็นเวอร์ชันที่ใช้งาน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilki bir wersiýany öz Card-y astynda synanyşyň. Işjeň wersiýa işlemegini dowam etdirýär. Birini gurmak ony işjeň edýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir sürümü kendi Card'ı altında deneyin. Yayındaki sürüm çalışmaya devam eder. Birini kurmak onu yayına alır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے ایک ورژن آزمائیں، اس کے اپنے Card کے تحت۔ لائیو ورژن کام کرتا رہتا ہے۔ ایک کو انسٹال کرنے سے وہ لائیو ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thử một phiên bản trước, dưới một Card riêng. Phiên bản đang chạy vẫn tiếp tục hoạt động. Cài một phiên bản sẽ đưa nó vào hoạt động."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先試用一個版本，使用它自己的 Card。目前生效的版本會繼續運作。安裝一個版本會讓它生效。"
          }
        }
      }
    },
