        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពាក្យរបស់ KIFF សម្រាប់ការតភ្ជាប់នេះមិនទាន់ត្រូវបានអានទេ។ គ្មានអ្វីត្រូវបានអនុម័តទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에 대한 KIFF의 설명을 아직 읽지 않았습니다. 승인된 것은 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍັງບໍ່ໄດ້ອ່ານຄຳເວົ້າຂອງ KIFF ສຳລັບການເຊື່ອມຕໍ່ນີ້. ບໍ່ມີຫຍັງຖືກອະນຸມັດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formuluotė šiam ryšiui dar neperskaityta. Niekas nepatvirtinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formulējums šim savienojumam vēl nav nolasīts. Nekas netika apstiprināts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зборовите на KIFF за оваа врска сè уште не се прочитани. Ништо не е одобрено."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ холболтод зориулсан KIFF-ийн үгсийг хараахан уншаагүй байна. Юу ч зөвшөөрөгдсөнгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो जडानका लागि KIFF का शब्द अझै पढिएका छैनन्। केही स्वीकृत भएन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woorden van KIFF voor deze koppeling zijn nog niet gelezen. Er is niets goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opis KIFF dla tego połączenia nie został jeszcze odczytany. Nic nie zostało zatwierdzone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras do KIFF para esta ligação ainda não foram lidas. Nada foi aprovado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras do KIFF para esta conexão ainda não foram lidas. Nada foi aprovado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul KIFF pentru această conexiune nu a fost citit încă. Nu s-a aprobat nimic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slová KIFF k tomuto pripojeniu ešte nie sú načítané. Nič sa neschválilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besede KIFF za to povezavo še niso prebrane. Nič ni bilo odobreno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjalët e KIFF për këtë lidhje nuk janë lexuar ende. Asgjë nuk u miratua."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ove reči za ovu vezu još nisu pročitane. Ništa nije odobreno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้อ่านถ้อยคำของ KIFF สำหรับการเชื่อมต่อนี้ ยังไม่ได้อนุมัติอะไร"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu birikme üçin KIFF-iň sözleri heniz okalmady. Hiç zat tassyklanmady."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF'in bu bağlantı için sözleri henüz okunmadı. Hiçbir şey onaylanmadı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کنکشن کے لیے KIFF کے الفاظ ابھی پڑھے نہیں گئے۔ کچھ منظور نہیں ہوا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời của KIFF cho kết nối này chưa được đọc. Chưa phê duyệt gì."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未讀取 KIFF 針對此連線的文字。未核准任何項目。"
          }
        }
      }
    },
