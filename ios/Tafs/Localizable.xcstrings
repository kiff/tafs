    "settings.alerts_off.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت عندما سُجّل الخروج من هذا الهاتف. شغّلها لتحصل على تنبيه عندما يحتاجك taf."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon çıxış edəndə onlar söndü. Taf-a sizin lazım olduğunuz zaman bildiriş almaq üçün aktiv edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изключиха се, когато този телефон излезе. Включете ги, за да получавате известие, когато taf има нужда от вас."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোন সাইন আউট হওয়ার সময় সেগুলো বন্ধ হয়ে গেছে। কোনো taf-এর আপনাকে দরকার হলে অ্যালার্ট পেতে চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'han desactivat quan aquest telèfon ha tancat la sessió. Activa-les per rebre una alerta quan un taf et necessiti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnula se, když se tento telefon odhlásil. Zapněte je a dostávejte upozornění, když vás taf potřebuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurden ausgeschaltet, als sich dieses Telefon abgemeldet hat. Schalte sie ein, um benachrichtigt zu werden, wenn ein taf dich braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They went off when this phone signed out. Turn them on to get an alert when a taf needs you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desactivaron cuando este teléfono cerró sesión. Actívalas para recibir una alerta cuando un taf te necesite."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Need lülitusid välja, kui see telefon välja logis. Lülita need sisse, et saada teavitus, kui taf vajab sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles se sont désactivées quand ce téléphone s'est déconnecté. Activez-les pour recevoir une alerte quand un taf vous attend."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הן כבו כשהטלפון הזה יצא מהחשבון. יש להפעיל אותן כדי לקבל התראה כש-taf זקוק לך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब यह फ़ोन साइन आउट हुआ तो वे बंद हो गए। जब किसी taf को आपकी ज़रूरत हो तो अलर्ट पाने के लिए उन्हें चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključile su se kad se ovaj telefon odjavio. Uključite ih da primite obavijest kad taf treba vas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsoltak, amikor ez a telefon kijelentkezett. Kapcsold be őket, hogy riasztást kapj, ha egy taf rád vár."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դրանք անջատվեցին, երբ այս հեռախոսը դուրս եկավ։ Միացրեք՝ ծանուցում ստանալու համար, երբ taf-ին ձեր օգնությունն է պետք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan mati saat ponsel ini keluar. Aktifkan untuk mendapat peringatan saat sebuah taf membutuhkan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sono disattivati quando questo telefono è uscito dall'account. Attivali per ricevere un avviso quando un taf ti aspetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンがサインアウトしたときに通知がオフになりました。tafがあなたを必要としたときに通知を受け取るには、オンにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ისინი გამოირთო, როცა ეს ტელეფონი გამოვიდა. ჩართეთ, რომ შეტყობინება მიიღოთ, როცა taf-ს თქვენი დახმარება სჭირდება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពួកវាបានបិទ ពេលទូរសព្ទនេះចាកចេញ។ បើកវាដើម្បីទទួលការជូនដំណឹងនៅពេល taf ត្រូវការអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰이 로그아웃할 때 알림이 꺼졌습니다. taf에 내가 필요할 때 알림을 받으려면 켜세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມັນປິດເມື່ອໂທລະສັບນີ້ອອກຈາກລະບົບ. ເປີດເພື່ອຮັບການແຈ້ງເຕືອນເມື່ອ taf ຕ້ອງການທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jie išsijungė, kai šis telefonas atsijungė. Įjunkite juos, kad gautumėte pranešimą, kai taf jūsų laukia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie izslēdzās, kad šis tālrunis izrakstījās. Ieslēdz tos, lai saņemtu paziņojumu, kad taf gaida tevi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Се исклучија кога овој телефон се одјави. Вклучи ги за да добиваш известување кога некој taf те чека."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ утас гарахад тэдгээр унтарсан. Taf таныг хэрэгтэй үед мэдэгдэл авахын тулд асаана уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो फोन साइन आउट हुँदा ती बन्द भए। कुनै taf लाई तपाईं चाहिँदा सूचना पाउन तिनलाई खोल्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze gingen uit toen deze telefoon werd uitgelogd. Zet ze aan om een melding te krijgen als een taf op jou wacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączyły się, gdy ten telefon został wylogowany. Włącz je, aby otrzymywać alert, gdy taf czeka na Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram desativados quando este telefone terminou a sessão. Ative-os para receber um alerta quando um taf precisar de si."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram desativados quando a sessão deste telefone foi encerrada. Ative-os para receber um alerta quando um taf precisar de você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "S-au dezactivat când acest telefon s-a deconectat. Activați-le pentru a primi o alertă când un taf are nevoie de dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypli sa, keď sa tento telefón odhlásil. Zapnite ich a dostávajte upozornenia, keď vás taf potrebuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izklopila so se, ko se je ta telefon odjavil. Vklopite jih, da prejmete opozorilo, ko vas taf potrebuje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "U çaktivizuan kur ky telefon doli. Aktivizojini për të marrë një njoftim kur një taf ka nevojë për ju."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključile su se kad se ovaj telefon odjavio. Uključite ih da primite obaveštenje kad taf treba vas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนปิดไปเมื่อโทรศัพท์เครื่องนี้ออกจากระบบ เปิดเพื่อรับการแจ้งเตือนเมื่อ taf ต้องการคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon çykanda olar öçdi. Taf size zerur bolanda duýduryş almak üçin olary açyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonun oturumu kapandığında kapandılar. Bir taf'ın size ihtiyacı olduğunda uyarı almak için açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اس فون کے سائن آؤٹ ہونے پر بند ہو گئے۔ جب کسی taf کو آپ کی ضرورت ہو تو الرٹ پانے کے لیے انہیں چالو کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng đã tắt khi điện thoại này đăng xuất. Hãy bật để nhận thông báo khi một taf cần bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部手機登出時通知已關閉。開啟後，當 taf 需要您時即可收到通知。"
          }
        }
      }
    },
