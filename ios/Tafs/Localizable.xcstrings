      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genehmigungen sind auf diesem Telefon eingerichtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approvals are set up on this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aprobaciones están configuradas en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les approbations sont configurées sur ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le approvazioni sono configurate su questo telefono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goedkeuringen zijn ingesteld op deze telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdzanie jest skonfigurowane na tym telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As aprovações estão configuradas neste telefone."
          }
        }
      }
    },
    "approval.state.temporarily_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fingerabdrucksensor kann gerade nicht verwendet werden. Warte einen Moment oder entsperre das Telefon einmal und prüfe dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fingerprint sensor can't be used just now. Wait a moment, or unlock the phone once, then check again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se puede usar el sensor de huellas. Espera un momento, o desbloquea el teléfono una vez, y vuelve a comprobarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le capteur d'empreintes ne peut pas être utilisé pour le moment. Patientez un instant, ou déverrouillez le téléphone une fois, puis vérifiez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sensore di impronte non può essere usato ora. Attendi un attimo, o sblocca il telefono una volta, poi controlla di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vingerafdruksensor kan nu niet worden gebruikt. Wacht even of ontgrendel de telefoon één keer, en controleer het dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytnika linii papilarnych nie można teraz użyć. Poczekaj chwilę albo raz odblokuj telefon, a potem sprawdź ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível usar o sensor de impressões digitais neste momento. Aguarde um pouco, ou desbloqueie o telefone uma vez, e verifique novamente."
          }
        }
      }
    },
    "approval.state.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon hat keinen Fingerabdrucksensor, den tafs für Genehmigungen nutzen kann. Genehmige auf einem anderen Telefon oder einem unterstützten Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no fingerprint sensor tafs can use for approvals. Approve from another phone or a supported device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no tiene un sensor de huellas que tafs pueda usar para aprobar. Aprueba desde otro teléfono o un dispositivo compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n'a pas de capteur d'empreintes que tafs peut utiliser pour les approbations. Approuvez depuis un autre téléphone ou un appareil compatible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non ha un sensore di impronte che tafs possa usare per le approvazioni. Approva da un altro telefono o da un dispositivo supportato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon heeft geen vingerafdruksensor die tafs voor goedkeuringen kan gebruiken. Keur goed vanaf een andere telefoon of een ondersteund apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon nie ma czytnika linii papilarnych, którego tafs może użyć do zatwierdzania. Zatwierdź z innego telefonu lub obsługiwanego urządzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone não tem um sensor de impressões digitais que o tafs possa usar para aprovações. Aprove a partir de outro telefone ou de um dispositivo compatível."
          }
        }
      }
    },
    "approval.taf_asks_before_does_anything": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein taf fragt, bevor er etwas außerhalb seiner Card tut, und Coach fragt, bevor er eine App verbindet oder eine Card ausstellt. Du genehmigst auf diesem Gerät, und dafür brauchst du Face ID oder Touch ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A taf asks before it does anything outside its Card, and Coach asks before it connects an app or issues a Card. You approve on this device, and that needs Face ID or Touch ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf pregunta antes de hacer nada fuera de su Card, y Coach pregunta antes de conectar una app o emitir una Card. Apruebas en este dispositivo, y para eso se necesita Face ID o Touch ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf demande avant de faire quoi que ce soit hors de sa Card, et Coach demande avant de connecter une app ou d'émettre une Card. Vous approuvez sur cet appareil, ce qui nécessite Face ID ou Touch ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf chiede prima di fare qualsiasi cosa fuori dalla sua Card, e Coach chiede prima di collegare un'app o emettere una Card. Approvi su questo dispositivo, e serve Face ID o Touch ID."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een taf vraagt het voordat het iets doet buiten zijn Card, en Coach vraagt het voordat het een app koppelt of een Card uitgeeft. Je keurt goed op dit apparaat, en daarvoor is Face ID of Touch ID nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf pyta, zanim zrobi cokolwiek poza swoją Card, a Coach pyta, zanim połączy aplikację lub wyda Card. Zatwierdzasz na tym urządzeniu, a to wymaga Face ID lub Touch ID."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taf pergunta antes de fazer algo fora do seu Card, e o Coach pergunta antes de ligar uma app ou emitir um Card. Aprova neste dispositivo, e isso requer Face ID ou Touch ID."
          }
        }
      }
    },
