            "value": "窓口・回して選び、押して開く"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კარები · შეატრიალეთ ასარჩევად, დააჭირეთ გასახსნელად"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទ្វារ · បង្វិលដើម្បីជ្រើសរើស ចុចដើម្បីបើក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창구 · 돌려서 고르고 눌러서 열기"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ປະຕູ · ໝຸນເພື່ອເລືອກ, ກົດເພື່ອເປີດ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durys · pasukite, kad pasirinktumėte, paspauskite, kad atidarytumėte"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Durvis · pagriez, lai izvēlētos, nospied, lai atvērtu"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Врати · врти за да избереш, притисни за да отвориш"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаалгууд · сонгохын тулд эргүүл, нээхийн тулд дар"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "ढोकाहरू · छान्न घुमाउनुहोस्, खोल्न थिच्नुहोस्"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deuren · draai om te kiezen, druk om te openen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drzwi · obróć, aby wybrać, naciśnij, aby otworzyć"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Portas · rode para escolher, prima para abrir"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Portas · gire para escolher, pressione para abrir"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Uși · rotiți pentru a alege, apăsați pentru a deschide"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvere · otočením vyberte, stlačením otvorte"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrata · zavrtite za izbiro, pritisnite za odpiranje"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Portat · ktheni për të zgjedhur, shtypni për të hapur"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrata · okrenite za odabir, pritisnite za otvaranje"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประตู · หมุนเพื่อเลือก กดเพื่อเปิด"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gapylar · saýlamak üçin öwüriň, açmak üçin basyň"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapılar · seçmek için çevirin, açmak için basın"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دروازے · چننے کے لیے گھمائیں، کھولنے کے لیے دبائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa · xoay để chọn, nhấn để mở"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "門 · 旋轉以選擇，按下以開啟"
          }
        }
      }
    },
    "door.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستطيع أي شخص الكتابة إلى باب. وحدهم من تقرنهم يستطيعون إعطاء %1$@ عملًا، وتقرر الـ Card الخاصة به الباقي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qapıya hər kəs yaza bilər. Yalnız cütləşdirdiyiniz insanlar %1$@ taf-ına iş verə bilər, qalanını isə Card-ı müəyyən edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки може да пише на врата. Само хората, които сдвоите, могат да дават работа на %1$@, а неговата Card решава останалото."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে কেউ একটি দরজায় লিখতে পারে। শুধু আপনার জোড়া লাগানো লোকেরাই %1$@-কে কাজ দিতে পারে, বাকিটা এর Card ঠিক করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsevol persona pot escriure a una porta. Només les persones que aparelles poden donar feina a %1$@, i el seu Card decideix la resta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dveře může psát kdokoli. Práci %1$@ mohou dávat jen lidé, které spárujete, a o zbytku rozhoduje jeho Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder kann an eine Tür schreiben. Nur Personen, die du koppelst, können %1$@ Arbeit geben, und seine Card entscheidet den Rest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can write to a door. Only people you pair can give %1$@ work, and its Card decides the rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera puede escribir a una puerta. Solo las personas que vincules pueden dar trabajo a %1$@, y su Card decide el resto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uksele võib kirjutada igaüks. Tafile %1$@ saavad tööd anda ainult inimesed, kelle sa seod, ja ülejäänu otsustab selle Card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut écrire à une porte. Seules les personnes que vous associez peuvent donner du travail à %1$@, et sa Card décide du reste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל אחד יכול לכתוב לדלת. רק אנשים שתצמד יכולים לתת ל-%1$@ עבודה, וה-Card שלו מחליט על השאר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी द्वार पर लिख सकता है। केवल आपके जोड़े लोग %1$@ को काम दे सकते हैं, और बाकी उसका Card तय करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vrata može pisati svatko. Samo ljudi koje uparite mogu tafu %1$@ davati posao, a ostalo odlučuje njegov Card."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy ajtóra bárki írhat. Csak az általad párosított emberek adhatnak munkát neki (%1$@), a többit a Cardja dönti el."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դռանը ցանկացած մարդ կարող է գրել։ Միայն ձեր զուգակցած մարդիկ կարող են %1$@-ին աշխատանք տալ, իսկ մնացածը որոշում է նրա Card-ը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa pun dapat menulis ke sebuah pintu. Hanya orang yang Anda pasangkan yang dapat memberi %1$@ pekerjaan, dan Card-nya menentukan sisanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque può scrivere a una porta. Solo le persone che associ possono dare lavoro a %1$@, e la sua Card decide il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "窓口には誰でも連絡できます。%1$@に仕事を頼めるのは登録した人だけで、それ以外はCardが決めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კარზე ნებისმიერს შეუძლია წერა. მხოლოდ დაწყვილებულ ადამიანებს შეუძლიათ %1$@-ისთვის სამუშაოს მიცემა, დანარჩენს კი მისი Card წყვეტს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកណាក៏អាចសរសេរទៅទ្វារបាន។ មានតែអ្នកដែលអ្នកផ្គូផ្គងប៉ុណ្ណោះដែលអាចផ្តល់ការងារឱ្យ %1$@ ហើយ Card របស់វាសម្រេចរឿងដែលនៅសល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구나 창구로 연락할 수 있습니다. 내가 등록한 사람만 %1$@에게 작업을 맡길 수 있고, 나머지는 Card가 정합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທຸກຄົນຂຽນຫາປະຕູໄດ້. ມີແຕ່ຄົນທີ່ທ່ານຈັບຄູ່ທີ່ມອບວຽກໃຫ້ %1$@ ໄດ້, ແລະ Card ຂອງມັນຕັດສິນສ່ວນທີ່ເຫຼືອ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Į duris gali rašyti bet kas. Darbą %1$@ gali duoti tik jūsų susieti žmonės, o visa kita lemia jo Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz durvīm var rakstīt ikviens. Tikai tie, ko tu savieno pārī, var dot %1$@ darbu, un pārējo nosaka tā Card."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секој може да пишува на врата. Само луѓето што ги спаруваш можат да му дадат работа на %1$@, а неговиот Card одлучува за остатокот."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаалганд хэн ч бичиж болно. Зөвхөн таны хослуулсан хүмүүс %1$@-д ажил өгч чадах бөгөөд үлдсэнийг нь түүний Card шийднэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "ढोकामा जोसुकैले लेख्न सक्छ। तपाईंले जोडेका मानिसहरूले मात्र %1$@ लाई काम दिन सक्छन्, र बाँकी यसको Card ले निर्णय गर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen kan naar een deur schrijven. Alleen mensen die je koppelt kunnen %1$@ werk geven, en zijn Card bepaalt de rest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy może pisać do drzwi. Tylko osoby, które powiążesz, mogą zlecać pracę %1$@, a o reszcie decyduje jego Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa pode escrever para uma porta. Só as pessoas que associar podem dar trabalho a %1$@, e o seu Card decide o resto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa pode escrever para uma porta. Só as pessoas que associar podem dar trabalho a %1$@, e o seu Card decide o resto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricine poate scrie la o ușă. Doar persoanele pe care le asociați îi pot da lui %1$@ de lucru, iar Cardul său decide restul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dvere môže písať ktokoľvek. Prácu %1$@ môžu dávať len ľudia, ktorých spárujete, a o zvyšku rozhoduje jeho Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vrata lahko piše vsakdo. Samo ljudje, ki jih seznanite, lahko %1$@ dajo delo, o ostalem pa odloča njegova Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdokush mund të shkruajë te një portë. Vetëm njerëzit që çiftoni mund t'i japin %1$@ punë, dhe Card-i i tij vendos pjesën tjetër."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vrata može pisati svatko. Samo ljudi koje uparite mogu tafu %1$@ davati posao, a ostalo odlučuje njegov Card."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครก็เขียนถึงประตูได้ เฉพาะผู้ที่คุณจับคู่เท่านั้นที่มอบงานให้ %1$@ ได้ และ Card ของมันตัดสินส่วนที่เหลือ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Islendik adam gapa ýazyp biler. Diňe siziň goşalaýan adamlaryňyz %1$@-a iş berip biler, galan zady Card kesgitleýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kapıya herkes yazabilir. %1$@ taf'ına yalnızca eşleştirdiğiniz kişiler iş verebilir, gerisine Card'ı karar verir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دروازے پر کوئی بھی لکھ سکتا ہے۔ صرف آپ کے جوڑے ہوئے لوگ %1$@ کو کام دے سکتے ہیں، اور باقی اس کا Card طے کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cũng có thể viết tới một cửa. Chỉ những người bạn ghép đôi mới giao việc được cho %1$@, và Card của nó quyết định phần còn lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都可以寫信到門。只有您配對的人才能交付工作給 %1$@，其餘由它的 Card 決定。"
          }
        }
      }
    },
    "door.hi_like_back_order": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا، أريد استرداد 15 $ عن الطلب T-3001."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Salam, T-3001 sifarişi üzrə 15 $ geri almaq istəyirəm."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Здравейте, бих искал 15 $ обратно за поръчка T-3001."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হ্যালো, অর্ডার T-3001-এ ১৫ ডলার ফেরত চাই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola, voldria que em tornessin 15 $ de la comanda T-3001."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobrý den, chtěl bych vrátit 15 $ za objednávku T-3001."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo, ich hätte gern 15 $ für Bestellung T-3001 zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I'd like $15 back on order T-3001."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola, quiero que me devuelvan 15 $ del pedido T-3001."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tere, sooviksin tellimuselt T-3001 15 $ tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour, j'aimerais être remboursé de 15 $ sur la commande T-3001."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלום, הייתי רוצה לקבל חזרה 15 דולר על הזמנה T-3001."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमस्ते, मैं ऑर्डर T-3001 पर $15 वापस चाहता हूँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bok, htio bih natrag 15 $ za narudžbu T-3001."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üdv, szeretnék 15 dollárt visszakapni a T-3001-es rendelésből."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բարև, կուզեի 15 $ ետ պատվերի համար T-3001։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halo, saya ingin pengembalian $15 untuk pesanan T-3001."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao, vorrei un rimborso di 15 $ sull'ordine T-3001."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは。注文T-3001の15ドルを返金してほしいです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამარჯობა, მინდა 15 $ დამიბრუნდეს შეკვეთაზე T-3001."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សួស្តី ខ្ញុំចង់បាន $15 ត្រឡប់មកវិញសម្រាប់ការបញ្ជាទិញ T-3001។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요, 주문 T-3001에서 $15 환불받고 싶어요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສະບາຍດີ, ຂ້ອຍຢາກໄດ້ເງິນຄືນ $15 ສຳລັບຄຳສັ່ງຊື້ T-3001."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveiki, norėčiau susigrąžinti 15 $ už užsakymą T-3001."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveiki, vēlos atpakaļ 15 $ par pasūtījumu T-3001."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Здраво, би сакал да ми се вратат 15 $ за нарачката T-3001."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайн байна уу, T-3001 захиалгын $15-ыг буцаан авмаар байна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "नमस्ते, अर्डर T-3001 को $१५ फिर्ता चाहन्छु।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoi, ik wil graag $15 terug voor bestelling T-3001."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień dobry, proszę o zwrot 15 $ za zamówienie T-3001."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá, gostaria de receber de volta 15 $ da encomenda T-3001."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá, gostaria de receber de volta US$ 15 do pedido T-3001."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bună, aș vrea 15 $ înapoi pentru comanda T-3001."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobrý deň, chcel by som vrátiť 15 $ za objednávku T-3001."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozdravljeni, rad bi vračilo 15 $ za naročilo T-3001."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përshëndetje, do të doja 15 $ prapa për porosinë T-3001."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bok, htio bih natrag 15 $ za porudžbinu T-3001."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สวัสดี ฉันอยากได้เงินคืน 15 ดอลลาร์สำหรับออเดอร์ T-3001"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Salam, T-3001 sargydy boýunça $15 yzyna gaýtarylmagyny isleýärin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merhaba, T-3001 numaralı siparişin 15 $ iadesini istiyorum."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہیلو، مجھے آرڈر T-3001 پر $15 واپس چاہییں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xin chào, tôi muốn được hoàn lại 15 đô la cho đơn T-3001."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您好，我想要為訂單 T-3001 退回 15 美元。"
          }
        }
      }
    },
