    "card.limit_raised_read_balance_again": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفع الحد. اقرأ الرصيد مرة أخرى قبل رفعه مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit artırıldı. Yenidən artırmazdan əvvəl balansı bir daha oxuyun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимитът беше увеличен. Прочетете наличността отново, преди да го увеличите пак."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমা বাড়ানো হয়েছে। আবার বাড়ানোর আগে ব্যালেন্স আবার পড়ুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El límit s'ha pujat. Torna a llegir el saldo abans de tornar-lo a pujar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit byl zvýšen. Než ho zvýšíte znovu, načtěte zůstatek znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit wurde erhöht. Lies das Guthaben erneut, bevor du es noch einmal erhöhst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limit was raised. Read the balance again before raising it once more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se subió el límite. Vuelve a leer el saldo antes de subirlo otra vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiiti suurendati. Enne uuesti suurendamist loe saldo uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite a été relevée. Relisez le solde avant de la relever encore."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המגבלה הועלתה. יש לקרוא את היתרה שוב לפני שמעלים אותה פעם נוספת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमा बढ़ाई गई। इसे फिर बढ़ाने से पहले शेष राशि फिर पढ़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograničenje je podignuto. Pročitajte stanje ponovno prije nego što ga podignete još jednom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A limit meg lett emelve. Mielőtt újra emeled, olvasd be újra az egyenleget."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահմանաչափը բարձրացվեց։ Նորից կարդացեք մնացորդը, նախքան կրկին բարձրացնելը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas dinaikkan. Baca saldo lagi sebelum menaikkannya sekali lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite è stato aumentato. Rileggi il saldo prima di aumentarlo ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限を引き上げました。もう一度引き上げる前に残高を再確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლიმიტი გაიზარდა. წაიკითხეთ ბალანსი ხელახლა, სანამ კიდევ გაზრდით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដែនកំណត់ត្រូវបានបង្កើន។ អានសមតុល្យម្តងទៀតមុនពេលបង្កើនវាម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도를 올렸습니다. 다시 올리기 전에 잔액을 다시 확인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມຂີດຈຳກັດແລ້ວ. ອ່ານຍອດຄົງເຫຼືອອີກກ່ອນເພີ່ມອີກຄັ້ງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitas padidintas. Prieš didindami dar kartą, iš naujo nuskaitykite likutį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits tika palielināts. Pirms to palielini vēlreiz, vēlreiz nolasi atlikumu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимитот е зголемен. Прочитај го салдото повторно пред да го зголемиш уште еднаш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хязгаарыг нэмэгдүүлсэн. Дахин нэмэгдүүлэхээсээ өмнө үлдэгдлийг дахин уншина уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमा बढाइयो। फेरि बढाउनुअघि बाँकी फेरि पढ्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De limiet is verhoogd. Lees het saldo opnieuw voordat je hem nog eens verhoogt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit został podniesiony. Odczytaj saldo ponownie, zanim podniesiesz go jeszcze raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite foi aumentado. Leia o saldo novamente antes de o aumentar outra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite foi aumentado. Leia o saldo novamente antes de o aumentar outra vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita a fost mărită. Citiți din nou soldul înainte de a o mări încă o dată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit bol zvýšený. Kým ho zvýšite znova, načítajte zostatok znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omejitev je bila zvišana. Preden jo znova zvišate, znova preberite stanje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kufiri u rrit. Lexoni sërish gjendjen para se ta rrisni edhe një herë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograničenje je podignuto. Ponovo pročitajte stanje pre nego što ga podignete još jednom."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มขีดจำกัดแล้ว อ่านยอดคงเหลืออีกครั้งก่อนเพิ่มอีก"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Çäk ýokary galdyryldy. Ony ýene ýokary galdyrmazdan öň galyndyny täzeden okaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit yükseltildi. Bir kez daha yükseltmeden önce bakiyeyi tekrar okuyun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حد بڑھائی گئی۔ اسے دوبارہ بڑھانے سے پہلے بقیہ رقم دوبارہ پڑھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn đã được nâng. Hãy đọc lại số dư trước khi nâng thêm lần nữa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上限已提高。再次提高之前，請重新讀取餘額。"
          }
        }
      }
    },
