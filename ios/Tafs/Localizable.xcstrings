    "sample.brief.case.dubois_line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الرد يوم الثلاثاء · بانتظار ردهم · التحقق التالي يوم الجمعة"
