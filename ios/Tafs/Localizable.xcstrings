    "voice.microphone_off_tafs_turn_settings_mac": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon tafs üçün söndürülüb. Onu Sistem parametrləri › Məxfilik və təhlükəsizlik › Mikrofon bölməsində aktiv edin (macOS 12-də: Sistem tərcihləri › Təhlükəsizlik və məxfilik › Məxfilik › Mikrofon)."
