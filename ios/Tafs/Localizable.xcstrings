    "usage.company_billed_kiff_solo_bought": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Company wird jetzt über KIFF abgerechnet. Das im App Store gekaufte Solo verlängert sich am %1$@, sofern es nicht über den Apple-Account gekündigt wird, mit dem es gekauft wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Company is billed by KIFF now. The Solo bought in the App Store renews on %1$@ unless it's cancelled, from the Apple account that bought it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Company ahora la factura KIFF. El Solo comprado en App Store se renueva el %1$@ salvo que se cancele, desde la cuenta de Apple que lo compró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Company est désormais facturé par KIFF. Le Solo acheté sur l'App Store se renouvelle le %1$@ sauf s'il est résilié, depuis le compte Apple qui l'a acheté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Company ora è fatturato da KIFF. Il Solo acquistato nell'App Store si rinnova il %1$@ se non viene annullato, dall'account Apple che l'ha acquistato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Company wordt nu gefactureerd door KIFF. De Solo die in de App Store is gekocht, wordt op %1$@ verlengd tenzij die wordt opgezegd, via het Apple-account waarmee hij is gekocht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Company jest teraz rozliczane przez KIFF. Solo kupione w App Store odnowi się %1$@, chyba że zostanie anulowane z konta Apple, z którego je kupiono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Company é agora faturado pelo KIFF. O Solo comprado na App Store renova-se a %1$@ a menos que seja cancelado, a partir da conta Apple que o comprou."
          }
        }
      }
    },
