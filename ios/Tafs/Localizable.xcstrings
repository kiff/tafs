        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza osluškuje, ali je brojčanik još nije zabilježio. Odobrite ponovo da je zabilježite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อกำลังรับฟังอยู่ แต่ปุ่มหมุนยังไม่ได้บันทึก อนุมัติอีกครั้งเพื่อบันทึก"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Birikme diňleýär, ýöne teker ony heniz ýazmady. Ýazmak üçin täzeden tassyklaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı dinliyor ama kadran henüz kaydetmedi. Kaydetmek için tekrar onaylayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کنکشن سن رہا ہے، مگر ڈائل نے اسے ابھی درج نہیں کیا۔ درج کرنے کے لیے دوبارہ منظور کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối đang lắng nghe, nhưng núm xoay chưa ghi lại. Hãy phê duyệt lại để ghi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線正在監聽，但旋鈕尚未記錄。請再次核准以記錄。"
          }
        }
      }
    },
