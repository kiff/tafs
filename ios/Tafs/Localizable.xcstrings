    "receipt.if_it_stays": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qalırsa, aşağıdakı qəbz identifikatorunu bizə bildirin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
