    "work.answer_within_line": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hal bundan uzun gözləyəndə sizə xəbər verilir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще ви бъде казано, когато случай чака по-дълго."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dáme vám vědět, když případ čeká déle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst benachrichtigt, wenn ein Fall länger wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're told when a case waits longer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisamos cuando un caso espera más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulle teatatakse, kui juhtum ootab kauem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes prévenu quand un cas attend plus longtemps."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobit ćete obavijest kad slučaj čeka dulje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szólunk, ha egy eset tovább vár."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեզ կտեղեկացնեն, երբ դեպքը ավելի երկար է սպասում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda diberi tahu saat sebuah kasus menunggu lebih lama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisiamo quando un caso aspetta di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "案件がこれより長く待つとお知らせします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაცნობებთ, როცა საქმე უფრო დიდხანს ელოდება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건이 이보다 오래 기다리면 알려 드립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jums pranešama, kai atvejis laukia ilgiau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tev paziņo, kad lieta gaida ilgāk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hoort het als een zaak langer wacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostaniesz powiadomienie, gdy sprawa czeka dłużej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisamos quando um caso espera mais."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisamos quando um caso espera mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunteți anunțat când un caz așteaptă mai mult."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dáme vám vedieť, keď prípad čaká dlhšie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvestimo vas, ko primer čaka dlje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Njoftoheni kur një rast pret më gjatë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobit ćete obaveštenje kad slučaj čeka duže."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะได้รับแจ้งเมื่อมีเรื่องที่รอนานกว่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir vaka bundan uzun beklerse haber verilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ được báo khi một trường hợp phải chờ lâu hơn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "案件等待超過此時間時，您會收到通知。"
          }
        }
      }
    },
