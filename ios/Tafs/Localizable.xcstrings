      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo ist ein Abonnement für %2$@ pro %1$@, abgerechnet über deinen Apple-Account. Es verlängert sich nach jedem Abrechnungszeitraum (%3$@), bis du kündigst."
          }
        },
        "en": {
