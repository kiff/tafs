          "stringUnit": {
            "state": "translated",
            "value": "Tieto slová patria k inému pripojeniu, než je zobrazené. Nedá sa nič schváliť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te besede so za drugo povezavo, kot je prikazana. Ničesar ni mogoče odobriti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Këto fjalë janë për një lidhje tjetër nga ajo e shfaqur. Asgjë nuk mund të miratohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove reči odnose se na drugu vezu od prikazane. Ništa se ne može odobriti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้อยคำเหล่านี้เป็นของการเชื่อมต่ออื่นที่ไม่ใช่รายการที่แสดง อนุมัติอะไรไม่ได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sözler görkezilenden başga birikme üçin. Hiç zat tassyklanyp bilinmeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sözler gösterilenden başka bir bağlantıya ait. Hiçbir şey onaylanamaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ الفاظ دکھائے گئے کنکشن سے الگ کنکشن کے لیے ہیں۔ کچھ بھی منظور نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những lời này dành cho một kết nối khác với kết nối đang hiện. Không thể phê duyệt gì."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些文字屬於另一個連線，而不是所顯示的這個。無法核准任何項目。"
          }
        }
      }
    },
    "connect.words_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمات KIFF لهذا الاتصال لا تجتاز التحقق (%1$@). لم تتم الموافقة على شيء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-in bu qoşulma üçün sözləri yoxlamadan keçmir (%1$@). Heç nə təsdiqlənmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстът на KIFF за тази връзка не се потвърждава (%1$@). Нищо не беше одобрено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সংযোগের জন্য KIFF-এর কথা যাচাইয়ে টেকে না (%1$@)। কিছু অনুমোদিত হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paraules de KIFF per a aquesta connexió no quadren (%1$@). No s'ha aprovat res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slova KIFF k tomuto připojení nesedí (%1$@). Nic se neschválilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFs Worte zu dieser Verbindung lassen sich nicht bestätigen (%1$@). Es wurde nichts genehmigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF's words for this connection don't check out (%1$@). Nothing was approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras de KIFF para esta conexión no cuadran (%1$@). No se aprobó nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFi sõnad selle ühenduse kohta ei pea paika (%1$@). Midagi ei kinnitatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les textes de KIFF pour cette connexion ne sont pas vérifiés (%1$@). Rien n'a été approuvé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המילים של KIFF לחיבור הזה לא עומדות בבדיקה (%1$@). שום דבר לא אושר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कनेक्शन के लिए KIFF के शब्द जाँच में खरे नहीं उतरते (%1$@)। कुछ मंज़ूर नहीं हुआ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ove riječi za ovu vezu ne prolaze provjeru (%1$@). Ništa nije odobreno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF szövege ehhez a kapcsolathoz nem stimmel (%1$@). Semmi sem lett jóváhagyva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ի բառերը այս կապի համար չեն հաստատվում (%1$@)։ Ոչինչ չհաստատվեց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata KIFF untuk koneksi ini tidak lolos pemeriksaan (%1$@). Tidak ada yang disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole di KIFF per questo collegamento non tornano (%1$@). Non è stato approvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続に関するKIFFの説明が一致しません（%1$@）。何も承認されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ის სიტყვები ამ კავშირისთვის არ დასტურდება (%1$@). არაფერი დამტკიცებულა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពាក្យរបស់ KIFF សម្រាប់ការតភ្ជាប់នេះមិនត្រូវគ្នាទេ (%1$@)។ គ្មានអ្វីត្រូវបានអនុម័តទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에 대한 KIFF의 설명이 확인되지 않습니다(%1$@). 승인된 것은 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຳເວົ້າຂອງ KIFF ສຳລັບການເຊື່ອມຕໍ່ນີ້ກວດບໍ່ຜ່ານ (%1$@). ບໍ່ມີຫຍັງຖືກອະນຸມັດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formuluotė šiam ryšiui nesutampa (%1$@). Niekas nepatvirtinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formulējums šim savienojumam neatbilst pārbaudei (%1$@). Nekas netika apstiprināts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зборовите на KIFF за оваа врска не се совпаѓаат (%1$@). Ништо не е одобрено."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ холболтод зориулсан KIFF-ийн үгс таарахгүй байна (%1$@). Юу ч зөвшөөрөгдсөнгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो जडानका लागि KIFF का शब्द मेल खाँदैनन् (%1$@)। केही स्वीकृत भएन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woorden van KIFF voor deze koppeling kloppen niet (%1$@). Er is niets goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opis KIFF dla tego połączenia się nie zgadza (%1$@). Nic nie zostało zatwierdzone."
          }
        },
        "pt": {
