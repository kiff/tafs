    "card.rule.total_then_asks": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ cəmi %1$@, sonra sizdən soruşur"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "общо %1$@ %2$@, след това ви пита"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "celkem %1$@ %2$@, pak se zeptá vás"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ insgesamt %2$@, dann fragt er dich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in total %2$@, then it asks you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en total %2$@, después te pregunta"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kokku %2$@, siis küsib see sinult"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ au total %2$@, puis il vous demande"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ukupno %2$@, zatim pita vas"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "összesen %1$@ %2$@, utána téged kérdez"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ընդհանուր %2$@, ապա հարցնում է ձեզ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ total %2$@, lalu ia bertanya kepada Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in totale %2$@, poi ti chiede"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@合計%1$@、それを超えるとあなたに確認します"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ სულ %2$@, შემდეგ გეკითხებათ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 합계 %1$@, 그 이상은 나에게 묻습니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ iš viso %2$@, paskui klausia jūsų"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kopā %2$@, pēc tam tas jautā tev"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in totaal %2$@, daarna vraagt het jou"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ łącznie %2$@, potem pyta Ciebie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no total %2$@, depois pergunta-lhe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no total %2$@, depois pergunta a você"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ în total %2$@, apoi vă întreabă"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "spolu %1$@ %2$@, potom sa opýta vás"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "skupno %1$@ %2$@, nato vpraša vas"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gjithsej %2$@, pastaj ju pyet"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ukupno %2$@, zatim pita vas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวม %1$@ %2$@ จากนั้นมันจะถามคุณ"
          }
        },
        "tr": {
          "stringUnit": {
