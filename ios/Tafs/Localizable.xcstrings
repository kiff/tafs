    "attachment.wrong_kind": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kann nicht angehängt werden. Fotos, PDFs, Text, CSV, Markdown sowie Word- und Excel-Dateien schon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ can't be attached. Photos, PDFs, text, CSV, Markdown, Word and Excel files can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede adjuntar %1$@. Se pueden adjuntar fotos, PDF, texto, CSV, Markdown y archivos de Word y Excel."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili %1$@ ei saa lisada. Lisada saab fotosid, PDF-e, teksti-, CSV-, Markdowni-, Wordi- ja Exceli faile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne peut pas être joint. Seuls les photos, PDF, fichiers texte, CSV, Markdown, Word et Excel peuvent l'être."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non può essere allegato. Si possono allegare foto, PDF, testo, CSV, Markdown, file Word ed Excel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は添付できません。写真、PDF、テキスト、CSV、Markdown、Word、Excelファイルを添付できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 첨부할 수 없습니다. 사진, PDF, 텍스트, CSV, Markdown, Word, Excel 파일을 첨부할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ negalima pridėti. Galima pridėti nuotraukas, PDF, tekstą, CSV, Markdown, Word ir Excel failus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nevar pievienot. Var pievienot fotoattēlus, PDF, teksta, CSV, Markdown, Word un Excel failus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kan niet worden bijgevoegd. Foto's, pdf's, tekst, CSV, Markdown, Word- en Excel-bestanden wel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można załączyć: %1$@. Można załączać zdjęcia, pliki PDF, tekst, CSV, Markdown, Word i Excel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível anexar %1$@. Pode anexar fotografias, PDF, texto, CSV, Markdown, Word e Excel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível anexar %1$@. Pode anexar fotografias, PDF, texto, CSV, Markdown, Word e Excel."
          }
        }
      }
    },
