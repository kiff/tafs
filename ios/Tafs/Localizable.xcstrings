        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ منظور نہ کریں کچھ نہیں بھیجا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì được gửi cho đến khi bạn phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您核准之前不會傳送任何內容。"
          }
        }
      }
    },
