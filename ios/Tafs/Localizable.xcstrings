    "connect.kept.for_cards|few": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُبقيت %1$@ اتصالات لـ %2$@، تستخدمها Cards الخاصة به."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechána %1$@ pro %2$@, jehož Card je používají."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržane su %1$@ veze: koriste ih Cardovi od: %2$@."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išlaikyti %1$@, nes juos naudoja %2$@ Card."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowano %1$@ dla: %2$@, bo używają ich ich Card."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ păstrate pentru %2$@, ale căror Carduri le folosesc."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechané %1$@ pre %2$@, ktorého Card ich používajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obdržane %1$@ za %2$@, katerega Card jih uporabljajo."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržane su %1$@ veze: koriste ih Cardovi od: %2$@."
          }
        }
      }
    },
