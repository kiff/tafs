    "card.card_got_room_call_needed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Card hat den Spielraum bekommen, den dieser Aufruf brauchte, bis diese Summe zurückgesetzt wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its Card got the room this call needed, until that total resets"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su Card obtuvo el margen que necesitaba esta llamada, hasta que ese total se reinicie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Card a obtenu la marge dont cet appel avait besoin, jusqu'à la remise à zéro de ce total"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua Card ha ricevuto il margine che serviva a questa chiamata, finché quel totale non si azzera"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zijn Card kreeg de ruimte die deze aanroep nodig had, tot dat totaal wordt gereset"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego Card dostała zapas, którego potrzebowało to wywołanie, do czasu wyzerowania tej sumy"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu Card recebeu a margem de que esta chamada precisava, até esse total ser reposto"
          }
        }
      }
    },
