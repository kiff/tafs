    "chat.jump_latest_something_new": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ən sonuncuya keçin, yenilik var"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Към най-новото, има нещо ново"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejít na nejnovější, je tu něco nového"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Neuesten springen, es gibt etwas Neues"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump to the latest, something new"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir a lo más reciente, hay algo nuevo"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mine uusimale, on midagi uut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aller au plus récent, il y a du nouveau"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skočite na najnovije, ima nešto novo"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugrás a legújabbra, van valami új"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անցեք վերջինին, ինչ-որ նոր բան կա"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lompat ke yang terbaru, ada yang baru"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai all'ultimo, c'è qualcosa di nuovo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新へ移動（新着あり）"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადადით უახლესზე, არის რაღაც ახალი"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 내용이 있습니다. 최신으로 이동"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pereiti prie naujausių, yra naujų"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pāriet uz jaunāko, ir kas jauns"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar het nieuwste, er is iets nieuws"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź do najnowszych, jest coś nowego"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir para o mais recente, há algo novo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir para o mais recente, há algo novo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt la cele mai noi, e ceva nou"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejsť na najnovšie, je tu niečo nové"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoči na najnovejše, nekaj novega"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shkoni te e fundit, ka diçka të re"
