            "value": "The amount on this line doesn't match KIFF's receipt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importe de esta línea no coincide con el recibo de KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle rea summa ei vasta KIFFi kviitungile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant de cette ligne ne correspond pas au reçu de KIFF."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסכום בשורה הזו לא תואם לקבלה של KIFF."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पंक्ति की राशि KIFF की रसीद से मेल नहीं खाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Iznos u ovom retku ne odgovara KIFF-ovoj potvrdi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ezen a soron lévő összeg nem egyezik a KIFF nyugtájával."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս տողի գումարը չի համապատասխանում KIFF-ի անդորրագրին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah di baris ini tidak cocok dengan tanda terima KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importo su questa riga non corrisponde alla ricevuta di KIFF."
          }
