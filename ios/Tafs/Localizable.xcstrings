          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ PIN ของกุญแจความปลอดภัย tafs จะถามทุกครั้งและไม่เก็บไว้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Howpsuzlyk açaryňyzyň PIN-ini giriziň. tafs ony her gezek soraýar we hiç haçan saklamaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik anahtarınızın PIN'ini girin. tafs her seferinde ister ve asla saklamaz."
