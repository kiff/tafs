    "chat.cap.cost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat gestoppt: Diese Aufgabe würde mehr kosten als sein Limit für eine Aufgabe. Bitte um etwas Engeres, oder jemand, der %1$@ verwaltet, kann das Limit erhöhen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stopped: this task would cost more than its limit for one task. Ask for something narrower, or someone who manages %1$@ can raise the limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detuvo: esta tarea costaría más que su límite por tarea. Pide algo más concreto, o alguien que gestione %1$@ puede subir el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s'est arrêté : cette tâche coûterait plus que sa limite pour une tâche. Demandez quelque chose de plus ciblé, ou une personne qui gère %1$@ peut relever la limite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si è fermato: questa attività costerebbe più del suo limite per un'attività. Chiedi qualcosa di più circoscritto, oppure chi gestisce %1$@ può aumentare il limite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gestopt: deze taak zou meer kosten dan de limiet voor één taak. Vraag om iets kleiners, of iemand die %1$@ beheert kan de limiet verhogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatrzymał się: to zadanie kosztowałoby więcej niż jego limit na jedno zadanie. Poproś o coś węższego albo osoba zarządzająca %1$@ może podnieść limit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: esta tarefa custaria mais do que o seu limite por tarefa. Peça algo mais restrito, ou alguém que gere %1$@ pode aumentar o limite."
          }
        }
      }
    },
    "chat.cap.turns": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat gestoppt: Diese Aufgabe brauchte mehr Schritte als sein Limit für eine Aufgabe. Bitte um etwas Engeres."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stopped: this task took more steps than its limit for one task. Ask for something narrower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detuvo: esta tarea necesitó más pasos que su límite por tarea. Pide algo más concreto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s'est arrêté : cette tâche a pris plus d'étapes que sa limite pour une tâche. Demandez quelque chose de plus ciblé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si è fermato: questa attività ha richiesto più passi del suo limite per un'attività. Chiedi qualcosa di più circoscritto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gestopt: deze taak had meer stappen nodig dan de limiet voor één taak. Vraag om iets kleiners."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
