    "door.remove_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف عنوانه عن أن يكون عنوان %1$@. تبقى الرسائل الموجودة في محادثته."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onun ünvanı %1$@ taf-ınınkı olmaqdan çıxır. Söhbətində artıq olan mesajlar qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Адресът ѝ вече не принадлежи на %1$@. Съобщенията, които вече са в чата му, остават."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর ঠিকানা %1$@-এর থাকে না। এর চ্যাটে ইতিমধ্যে থাকা বার্তা থেকে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La seva adreça deixa de ser de %1$@. Els missatges que ja són al seu xat es conserven."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho adresa přestane patřit tafu %1$@. Zprávy, které už jsou v jeho chatu, zůstávají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Adresse gehört nicht mehr %1$@. Nachrichten, die schon in seinem Chat sind, bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its address stops being %2$@. Messages already in its chat stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su dirección deja de ser de %1$@. Los mensajes que ya están en su chat se conservan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle aadress ei kuulu enam tafile %1$@. Selle vestluses juba olevad sõnumid jäävad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son adresse n'est plus celle de %1$@. Les messages déjà dans son chat restent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכתובת שלה כבר לא של %1$@. הודעות שכבר בשיחה שלו נשארות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसका पता %1$@ का नहीं रहता। उसकी चैट में पहले से मौजूद संदेश रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegova adresa prestaje biti adresa tafa %1$@. Poruke koje su već u njegovu razgovoru ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címe többé nem tartozik hozzá (%1$@). A csevegésében már lévő üzenetek megmaradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրա հասցեն դադարում է %1$@-ինը լինել։ Արդեն նրա զրույցում եղած հաղորդագրությունները մնում են։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamatnya tidak lagi menjadi milik %1$@. Pesan yang sudah ada di obrolannya tetap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo indirizzo non appartiene più a %1$@. I messaggi già nella sua chat restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのアドレスは%1$@のものではなくなります。すでにチャットにあるメッセージは残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისი მისამართი %1$@-ის აღარ არის. შეტყობინებები, რომლებიც უკვე მის ჩატშია, რჩება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អាសយដ្ឋានរបស់វាឈប់ជារបស់ %1$@។ សារដែលមានរួចហើយក្នុងការសន្ទនារបស់វានៅដដែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소는 더 이상 %1$@의 것이 아닙니다. 이미 채팅에 있는 메시지는 남습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທີ່ຢູ່ຂອງມັນເຊົາເປັນຂອງ %1$@. ຂໍ້ຄວາມທີ່ຢູ່ໃນການສົນທະນາຂອງມັນແລ້ວຍັງຢູ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jų adresas nebepriklauso taf %1$@. Jau pokalbyje esančios žinutės lieka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tās adrese vairs nepieder %1$@. Ziņas, kas jau ir tā sarunā, paliek."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неговата адреса престанува да биде на %1$@. Пораките што веќе се во неговиот разговор остануваат."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түүний хаяг %1$@-ынх байхаа болино. Чатад нь аль хэдийн байгаа мессежүүд үлдэнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसको ठेगाना %1$@ को हुन छोड्छ। यसको च्याटमा पहिल्यै भएका सन्देश रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres is dan niet meer van %1$@. Berichten die al in de chat staan, blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego adres przestaje należeć do %1$@. Wiadomości, które są już w czacie, zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu endereço deixa de ser de %1$@. As mensagens já no chat mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu endereço deixa de ser de %1$@. As mensagens já no chat mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa sa nu mai aparține lui %1$@. Mesajele deja din conversația sa rămân."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho adresa prestane patriť tafu %1$@. Správy, ktoré už sú v jeho chate, zostávajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegov naslov ne pripada več tafu %1$@. Sporočila, ki so že v njegovem klepetu, ostanejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa e tij pushon së qeni e: %1$@. Mesazhet që janë tashmë në bisedën e tij mbeten."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegova adresa prestaje biti adresa tafa %1$@. Poruke koje su već u njegovu razgovoru ostaju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่อยู่ของมันจะไม่ใช่ของ %1$@ อีกต่อไป ข้อความที่อยู่ในแชตของมันแล้วจะยังอยู่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Onuň salgysy %1$@-yňky bolmagyny bes edýär. Eýýäm onuň söhbetdeşligindäki habarlar galýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresi artık %1$@ taf'ına ait olmaktan çıkar. Sohbetindeki mevcut mesajlar kalır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کا پتہ %1$@ کا نہیں رہتا۔ اس کی چیٹ میں موجود پیغامات رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ của nó không còn là của %1$@. Các tin nhắn đã có trong cuộc trò chuyện vẫn được giữ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的地址將不再屬於 %1$@。已在它對話中的訊息會保留。"
          }
        }
      }
    },
