    "coach.tools_unknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hat zu den Tools von Coach nicht geantwortet. Versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF didn't answer about Coach's tools. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no respondió sobre las herramientas de Coach. Vuelve a intentarlo en un momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei vastanud Coachi tööriistade kohta. Proovi hetke pärast uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas répondu au sujet des outils de Coach. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non ha risposto sugli strumenti di Coach. Riprova tra un attimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFからCoachのツールについての応答がありませんでした。少し待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 Coach의 도구에 대해 응답하지 않았습니다. 잠시 후 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF neatsakė apie Coach įrankius. Netrukus bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF neatbildēja par Coach rīkiem. Pēc brīža mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF gaf geen antwoord over de tools van Coach. Probeer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie odpowiedział w sprawie narzędzi Coacha. Spróbuj ponownie za chwilę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não respondeu sobre as ferramentas do Coach. Tente novamente daqui a pouco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não respondeu sobre as ferramentas do Coach. Tente novamente daqui a pouco."
          }
        }
      }
    },
    "coach.unknown_answer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup hat etwas geantwortet, das diese App nicht lesen kann. Aktualisiere die App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup answered something this app doesn't read. Update the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración respondió algo que esta app no sabe leer. Actualiza la app."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup vastas midagi, mida see rakendus ei loe. Uuenda rakendust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Configuration a répondu quelque chose que cette app ne sait pas lire. Mettez l'app à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione ha risposto qualcosa che questa app non sa leggere. Aggiorna l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットアップがこのアプリでは読めない内容を返しました。アプリをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성에서 이 앱이 읽을 수 없는 응답을 보냈습니다. 앱을 업데이트하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup atsakė tai, ko ši programėlė neperskaito. Atnaujinkite programėlę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup atbildēja kaut ko, ko šī lietotne nevar nolasīt. Atjaunini lietotni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup gaf een antwoord dat deze app niet kan lezen. Werk de app bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja odpowiedziała czymś, czego ta aplikacja nie odczytuje. Zaktualizuj aplikację."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Configuração respondeu algo que esta app não lê. Atualize a app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Configuração respondeu algo que este app não lê. Atualize o app."
          }
        }
      }
    },
    "coach.waiting_for_app": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich die Anmeldeseite von %1$@ geöffnet hat, schließ die Anmeldung dort ab und komm zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If %1$@'s sign-in page opened, finish it there and come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se abrió la página de inicio de sesión de %1$@, termina allí y vuelve."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui rakenduse %1$@ sisselogimisleht avanes, lõpeta seal ja tule tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la page de connexion de %1$@ s'est ouverte, terminez-la là-bas et revenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se si è aperta la pagina di accesso di %1$@, completala lì e torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のサインインページが開いた場合は、そこで完了してから戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 로그인 페이지가 열렸다면 거기서 마친 뒤 돌아오세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei atsidarė %1$@ prisijungimo puslapis, užbaikite ten ir grįžkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja atvērās %1$@ pierakstīšanās lapa, pabeidz to tur un atgriezies."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de inlogpagina van %1$@ is geopend, rond het daar af en kom terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli otworzyła się strona logowania do %1$@, dokończ tam i wróć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a página de início de sessão de %1$@ abriu, conclua-o lá e volte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a página de login de %1$@ abriu, conclua-o lá e volte."
          }
        }
      }
    },
    "coach.waiting_for_vendor": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich die Anmeldeseite des Anbieters geöffnet hat, schließ die Anmeldung dort ab und komm zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the vendor's sign-in page opened, finish it there and come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se abrió la página de inicio de sesión del proveedor, termina allí y vuelve."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
