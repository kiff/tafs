            "value": "Lõikelaud tühjendatakse pärast kleepimist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers est vidé après le collage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הלוח מתנקה אחרי ההדבקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चिपकाने के बाद क्लिपबोर्ड साफ़ हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Međuspremnik se briše nakon što zalijepite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap a beillesztés után törlődik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխանակման բուֆերը մաքրվում է ներդնելուց հետո։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan klip dibersihkan setelah Anda menempel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli appunti vengono svuotati dopo che incolli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けた後、クリップボードは消去されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბუფერი იწმინდება ჩასმის შემდეგ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ក្តារតម្បៀតខ្ទាស់ត្រូវបានសម្អាតបន្ទាប់ពីអ្នកបិទភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여 넣은 뒤 클립보드가 지워집니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄລິບບອດຖືກລ້າງຫຼັງທ່ານວາງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įklijavus iškarpinė išvaloma."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pēc ielīmēšanas starpliktuve tiek notīrīta."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Привремената меморија се чисти откако ќе залепиш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Буулгасны дараа санах ой цэвэрлэгдэнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "टाँसेपछि क्लिपबोर्ड खाली गरिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het klembord wordt gewist nadat je plakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schowek jest czyszczony po wklejeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência é limpa depois de colar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência é limpa depois de colar."
          }
        },
        "ro": {
