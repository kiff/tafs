    "settings.alerts_off.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurden ausgeschaltet, als sich dieses Telefon abgemeldet hat. Schalte sie ein, um benachrichtigt zu werden, wenn ein taf dich braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They went off when this phone signed out. Turn them on to get an alert when a taf needs you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desactivaron cuando este teléfono cerró sesión. Actívalas para recibir una alerta cuando un taf te necesite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles se sont désactivées quand ce téléphone s'est déconnecté. Activez-les pour recevoir une alerte quand un taf vous attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sono disattivati quando questo telefono è uscito dall'account. Attivali per ricevere un avviso quando un taf ti aspetta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze gingen uit toen deze telefoon werd uitgelogd. Zet ze aan om een melding te krijgen als een taf op jou wacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączyły się, gdy ten telefon został wylogowany. Włącz je, aby otrzymywać alert, gdy taf czeka na Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram desativados quando este telefone terminou a sessão. Ative-os para receber um alerta quando um taf precisar de si."
          }
        }
      }
    },
