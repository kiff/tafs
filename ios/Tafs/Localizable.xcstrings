    "error.changed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hat sich inzwischen geändert. Was jetzt angezeigt wird, ist der aktuelle Stand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It changed in the meantime. What's shown now is how it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambió mientras tanto. Lo que se muestra ahora es como está."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See muutus vahepeal. Nüüd on näha selle praegune seis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela a changé entre-temps. Ce qui s'affiche maintenant est l'état actuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel frattempo è cambiato. Ciò che vedi ora è lo stato attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その間に変更されました。現在の状態を表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그사이에 바뀌었습니다. 지금 보이는 것이 현재 상태입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo metu tai pasikeitė. Dabar rodoma tikroji būsena."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas pa to laiku mainījās. Tagad redzamais ir pašreizējais stāvoklis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is intussen gewijzigd. Wat nu wordt getoond, is hoe het is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W międzyczasie coś się zmieniło. To, co jest teraz widoczne, to stan aktualny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou entretanto. O que é mostrado agora é o estado atual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou nesse meio-tempo. O que aparece agora é o estado atual."
