          "stringUnit": {
            "state": "translated",
            "value": "Slack बोटले अहिलेसम्म कुनै च्यानल देख्दैन। यसलाई Slack मा कुनै च्यानलमा थपेर फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Slack-bot ziet nog geen kanaal. Voeg hem in Slack toe aan een kanaal en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Slacka nie widzi jeszcze żadnego kanału. Dodaj go do kanału w Slacku, a potem spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot do Slack ainda não vê nenhum canal. Adicione-o a um canal no Slack e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot do Slack ainda não vê nenhum canal. Adicione-o a um canal no Slack e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Botul Slack nu vede încă niciun canal. Adăugați-l într-un canal în Slack, apoi încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Slacku zatiaľ nevidí žiadny kanál. Pridajte ho v Slacku do kanála a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Slack še ne vidi nobenega kanala. V Slacku ga dodajte v kanal in poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Boti i Slack ende nuk sheh asnjë kanal. Shtojeni në një kanal në Slack, pastaj provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack bot još ne vidi nijedan kanal. Dodajte ga u kanal u Slacku, pa pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอต Slack ยังไม่เห็นช่องใด เพิ่มมันในช่องหนึ่งใน Slack แล้วลองอีกครั้ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack boty heniz hiç bir kanaly görmeýär. Ony Slack-da kanala goşuň, soňra täzeden synanyşyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack botu henüz hiçbir kanalı göremiyor. Slack'te onu bir kanala ekleyin, sonra tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack بوٹ کو ابھی کوئی چینل نظر نہیں آتا۔ Slack میں اسے کسی چینل میں شامل کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Slack chưa thấy kênh nào. Hãy thêm nó vào một kênh trong Slack, rồi thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack 機器人目前看不到任何頻道。請在 Slack 中將它加入某個頻道，然後再試一次。"
          }
        }
      }
    },
    "door.slack.reason": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
