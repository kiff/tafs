            "value": "ระงับทั้งหมดทันที"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemmesini indi togtadyň"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepsini şimdi dondur"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب کو ابھی روکیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng băng tất cả ngay"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即全部凍結"
          }
        }
      }
    },
    "halt.explain.halted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجمّد. الاستئناف يبدأ العمل الجديد فقط."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Donduruldu. Davam etdirmə yalnız yeni işə başlayır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спряно. Възобновяването стартира само нова работа."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "থামানো হয়েছে। আবার চালু করলে শুধু নতুন কাজ শুরু হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquejat. Reprendre només inicia feina nova."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaveno. Obnovení spustí jen novou práci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angehalten. Fortsetzen startet nur neue Arbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halted. Resuming starts only new work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. Al reanudar, solo empieza trabajo nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peatatud. Jätkamisel algab ainult uus töö."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqué. La reprise ne lance que du nouveau travail."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נעצר. חידוש מתחיל רק עבודה חדשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोका गया। फिर शुरू करने पर केवल नया काम शुरू होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokirano. Nastavak pokreće samo novi rad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leállítva. A folytatás csak új munkát indít."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանգնեցված է։ Վերսկսումը սկսում է միայն նոր աշխատանք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibekukan. Melanjutkan hanya memulai pekerjaan baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccato. Riprendendo, parte solo lavoro nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮断済みです。再開すると新しい作業だけが始まります。"
