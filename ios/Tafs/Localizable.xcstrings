    "push.channel.other_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات المهام وردودها، بلا صوت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapşırıq sorğuları və onların cavabları, səssiz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявки за задачи и отговорите им, без звук."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাস্কের অনুরোধ ও তাদের উত্তর, শব্দ ছাড়া।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol·licituds de tasques i les seves respostes, sense so."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádosti o úkoly a jejich odpovědi, bez zvuku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
