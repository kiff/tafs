          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխարկման ընթացքում ձեր taf-ը չի աշխատում։ Մեկ անգամ հաստատելը (%1$@) թողարկում է այս Card-երը KIFF-ում և հեռացնում նրանք, որ այս տարբերակը չունի, ապա այս տարբերակը դառնում է ակտիվ։"
          }
        },
        "id": {
          "stringUnit": {
