    "setup.knob.events_not_set_up": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadisələrin təsdiqi bu hesab üçün bu telefondan qurulmayıb."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобряването на събития не е настроено за този акаунт от този телефон."
          }
        },
        "cs": {
