    "watch.sign_out_sub": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz daxil olmuş qalır. Bu saat taf-larınızı, söhbətlərinizi və gələnlər qutusunu unudur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонът ви остава влязъл. Този часовник забравя вашите tafs, чатове и входящи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon zůstane přihlášený. Tyto hodinky zapomenou vaše tafy, chaty a Doručené."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Handy bleibt angemeldet. Diese Uhr vergisst deine tafs, Chats und deinen Eingang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone stays signed in. This watch forgets your tafs, chats and inbox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono sigue con la sesión iniciada. Este reloj olvida tus tafs, chats y bandeja."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon jääb sisse logituks. See kell unustab sinu tafid, vestlused ja postkasti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléphone reste connecté. Cette montre oublie vos tafs, vos chats et votre boîte de réception."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš telefon ostaje prijavljen. Ovaj sat zaboravlja vaše tafove, razgovore i pristigle."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefonod bejelentkezve marad. Ez az óra elfelejti a tafjaidat, csevegéseidet és a Bejövőt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր հեռախոսը մնում է մուտք գործած։ Այս ժամացույցը մոռանում է ձեր taf-երը, զրույցները և մուտքայինը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel Anda tetap masuk. Jam tangan ini melupakan tafs, obrolan, dan kotak masuk Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono resta connesso. Questo orologio dimentica i tuoi tafs, le chat e In arrivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンはサインインしたままです。このウォッチはtafs、チャット、受信トレイを消去します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი ტელეფონი შესული რჩება. ეს საათი ივიწყებს თქვენს taf-ებს, ჩატებს და შემოსულებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰은 로그인 상태로 유지됩니다. 이 워치는 taf, 채팅, 받은편지함을 지웁니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonas lieka prisijungęs. Šis laikrodis pamirš jūsų taf, pokalbius ir gautuosius."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tālrunis paliek pierakstījies. Šis pulkstenis aizmirst tavus taf, sarunas un iesūtni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon blijft ingelogd. Dit horloge vergeet je tafs, chats en Inbox."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon pozostaje zalogowany. Ten zegarek zapomina Twoje tafs, czaty i Skrzynkę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O telemóvel continua com sessão iniciada. Este relógio esquece os seus tafs, chats e Caixa de entrada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular continua conectado à sua conta. Este relógio esquece os seus tafs, chats e Caixa de entrada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonul rămâne conectat. Acest ceas uită tafurile, conversațiile și mesajele primite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefón zostane prihlásený. Tieto hodinky zabudnú vaše tafy, chaty a Doručené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon ostane prijavljen. Ta ura pozabi vaše tafe, klepete in Nabiralnik."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefoni juaj mbetet i hyrë. Kjo orë harron tafs-et, bisedat dhe kutinë tuaj hyrëse."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš telefon ostaje prijavljen. Ovaj sat zaboravlja vaše tafove, razgovore i pristigle."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์ของคุณยังเข้าสู่ระบบอยู่ นาฬิกาเรือนนี้จะลืม taf แชต และกล่องข้อความของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuzda oturum açık kalır. Bu saat tafs'larınızı, sohbetlerinizi ve gelen kutunuzu unutur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại của bạn vẫn đăng nhập. Đồng hồ này sẽ quên các taf, cuộc trò chuyện và hộp thư của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的手機仍保持登入。這支手錶會忘記您的 taf、對話和收件匣。"
          }
        }
      }
    },
