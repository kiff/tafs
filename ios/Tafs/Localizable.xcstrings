          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilinenud pakid ei käivitunud kell 07:00: selle vedaja sisselogimine vajab sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Colis en retard » ne s'est pas lancé à 07:00 : sa connexion au transporteur a besoin de vous."
