    "settings.delete_account.confirm_with": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تؤكد بـ %1$@. وتُسجَّل الخروج من الأجهزة الأخرى أيضًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz təsdiq edirsiniz: %1$@. Digər cihazlar da çıxış edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Потвърждавате с %1$@. Другите устройства също излизат."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি %1$@ দিয়ে নিশ্চিত করেন। অন্য ডিভাইসও সাইন আউট হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmes amb %1$@. Els altres dispositius també tanquen la sessió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdíte přes %1$@. Odhlásí se i ostatní zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bestätigst mit %1$@. Andere Geräte werden auch abgemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You confirm with %1$@. Other devices sign out too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmas con %1$@. También se cierra la sesión en otros dispositivos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinnitad %1$@ abil. Ka teised seadmed logitakse välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous confirmez avec %1$@. Les autres appareils sont aussi déconnectés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה מאשר באמצעות %1$@. התקנים אחרים יוצאים גם הם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %1$@ से पुष्टि करते हैं। बाकी डिवाइस भी साइन आउट हो जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrđujete: %1$@. Ostali se uređaji također odjavljuju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel erősíted meg: %1$@. A többi eszköz is kijelentkezik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաստատում եք՝ %1$@։ Մյուս սարքերը նույնպես դուրս են գալիս։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda mengonfirmasi dengan %1$@. Perangkat lain juga keluar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermi con %1$@. Anche gli altri dispositivi vengono disconnessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@で確認します。他のデバイスもサインアウトされます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ადასტურებთ: %1$@. სხვა მოწყობილობებიც გამოდის."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកបញ្ជាក់ដោយ %1$@។ ឧបករណ៍ផ្សេងទៀតក៏ចាកចេញដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(으)로 확인합니다. 다른 기기도 로그아웃됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທ່ານຢືນຢັນດ້ວຍ %1$@. ອຸປະກອນອື່ນອອກຈາກລະບົບນຳ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Patvirtinate: %1$@. Kiti įrenginiai taip pat atjungiami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu apstiprini ar %1$@. Arī citas ierīces tiek izrakstītas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потврдуваш со %1$@. Другите уреди исто така се одјавуваат."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та %1$@-ээр баталгаажуулна. Бусад төхөөрөмж ч гарна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईं %1$@ ले पुष्टि गर्नुहुन्छ। अन्य उपकरण पनि साइन आउट हुन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bevestigt met %1$@. Andere apparaten worden ook uitgelogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdzasz przez %1$@. Inne urządzenia też zostaną wylogowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma com %1$@. A sessão também é terminada noutros dispositivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você confirma com %1$@. A sessão também é encerrada nos outros dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmați cu %1$@. Și celelalte dispozitive se deconectează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdíte cez %1$@. Odhlásia sa aj ostatné zariadenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrdite z %1$@. Odjavijo se tudi druge naprave."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmoni me: %1$@. Edhe pajisjet e tjera dalin."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrđujete: %1$@. Ostali se uređaji takođe odjavljuju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยืนยันด้วย %1$@ อุปกรณ์อื่นจะออกจากระบบด้วย"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz %1$@ bilen tassyklaýarsyňyz. Beýleki enjamlar hem çykýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylarsınız: %1$@. Diğer cihazların oturumu da kapanır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ %1$@ سے تصدیق کرتے ہیں۔ دوسری ڈیوائسز بھی سائن آؤٹ ہو جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn xác nhận bằng %1$@. Các thiết bị khác cũng sẽ đăng xuất."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您用%1$@確認。其他裝置也會登出。"
          }
        }
      }
    },
    "settings.delete_account.connections_left": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُذفت tafs لديك، لكن اتصالاتك لم تُحذف بعد. %1$@"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-larınız silindi, amma qoşulmalarınız hələ silinməyib. %1$@"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите tafs са изтрити, но връзките ви още не. %1$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার taf মুছে ফেলা হয়েছে, কিন্তু আপনার সংযোগ এখনও মোছা হয়নি। %1$@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus taf s'han esborrat, però les teves connexions encara no. %1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy jsou vymazané, ale vaše připojení zatím ne. %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs sind gelöscht, deine Verbindungen aber noch nicht. %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tafs are erased, but your connections aren't yet. %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tafs se borraron, pero tus conexiones aún no. %1$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tafid on kustutatud, kuid sinu ühendused veel mitte. %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tafs sont effacés, mais pas encore vos connexions. %1$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-taf שלך נמחקו, אבל החיבורים שלך עדיין לא. %1$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके taf मिटा दिए गए, पर आपके कनेक्शन अभी नहीं। %1$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši su tafovi izbrisani, ali vaše veze još nisu. %1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafjaid törölve, de a kapcsolataid még nem. %1$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր taf-երը ջնջվեցին, բայց ձեր կապերը դեռ ոչ։ %1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs Anda dihapus, tetapi koneksi Anda belum. %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tafs sono cancellati, ma i tuoi collegamenti non ancora. %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsは消去されましたが、接続はまだ消去されていません。%1$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი taf-ები წაიშალა, მაგრამ თქვენი კავშირები ჯერ არა. %1$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "taf របស់អ្នកត្រូវបានលុប ប៉ុន្តែការតភ្ជាប់របស់អ្នកមិនទាន់ត្រូវបានលុបទេ។ %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs는 삭제되었지만 연결은 아직 삭제되지 않았습니다. %1$@"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "taf ຂອງທ່ານຖືກລຶບແລ້ວ ແຕ່ການເຊື່ອມຕໍ່ຍັງບໍ່ທັນ. %1$@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų taf ištrinti, bet ryšiai dar ne. %1$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavi taf ir izdzēsti, bet tavi savienojumi vēl ne. %1$@"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоите tafови се избришани, но твоите врски сè уште не. %1$@"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны taf-ууд устсан боловч холболтууд хараахан устаагүй. %1$@"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंका taf मेटिए, तर जडानहरू अझै मेटिएका छैनन्। %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tafs zijn gewist, maar je koppelingen nog niet. %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje tafs zostały usunięte, ale Twoje połączenia jeszcze nie. %1$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs foram apagados, mas as suas ligações ainda não. %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs foram apagados, mas as suas conexões ainda não. %1$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafurile dvs. sunt șterse, dar conexiunile încă nu. %1$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy sú vymazané, ale vaše pripojenia zatiaľ nie. %1$@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafi so izbrisani, vaše povezave pa še ne. %1$@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs-et tuaj u fshinë, por lidhjet tuaja ende jo. %1$@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši su tafovi izbrisani, ali vaše veze još nisu. %1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ taf ของคุณแล้ว แต่ยังไม่ได้ลบการเชื่อมต่อ %1$@"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs-laryňyz pozuldy, ýöne birikmeleriňiz heniz däl. %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs'larınız silindi ama bağlantılarınız henüz silinmedi. %1$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے tafs مٹا دیے گئے، مگر آپ کے کنکشنز ابھی نہیں۔ %1$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các taf của bạn đã bị xóa, nhưng các kết nối của bạn thì chưa. %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 taf 已清除，但您的連線尚未清除。%1$@"
          }
        }
      }
    },
