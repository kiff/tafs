    "sign_in.pair_no_key": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع هذا الجهاز (%1$@) حفظ مفتاح فلا يمكن إقرانه. سجّل الدخول عبر KIFF بدلًا من ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ açar saxlaya bilmir, ona görə cütləşdirilə bilməz. Əvəzində KIFF ilə daxil olun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този %1$@ не може да съхранява ключ, така че не може да бъде сдвоен. Влезте с KIFF вместо това."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই %1$@ কী ধরে রাখতে পারে না, তাই জোড়া লাগানো যায় না। এর বদলে KIFF দিয়ে সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest dispositiu (%1$@) no pot guardar una clau, així que no es pot aparellar. Inicia la sessió amb KIFF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení (%1$@) neumí uložit klíč, takže ho nelze spárovat. Přihlaste se raději přes KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses %1$@ kann keinen Schlüssel halten und lässt sich daher nicht koppeln. Melde dich stattdessen mit KIFF an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ can't hold a key, so it can't be paired. Sign in with KIFF instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ no puede guardar una clave, así que no se puede vincular. Inicia sesión con KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See %1$@ ei saa võtit hoida, seega ei saa seda siduda. Logi selle asemel KIFFiga sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ne peut pas conserver de clé, il ne peut donc pas être associé. Connectez-vous plutôt avec KIFF."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתקן הזה (%1$@) לא יכול להחזיק מפתח, ולכן אי אפשר לצמד אותו. יש להיכנס עם KIFF במקום זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह %1$@ कुंजी नहीं रख सकता, इसलिए इसकी जोड़ी नहीं बन सकती। इसके बजाय KIFF से साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj (%1$@) ne može držati ključ pa se ne može upariti. Umjesto toga prijavite se KIFF-om."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz (%1$@) nem tud kulcsot tárolni, ezért nem párosítható. Jelentkezz be inkább a KIFF-fel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքը (%1$@) չի կարող բանալի պահել, ուստի չի կարող զուգակցվել։ Փոխարենը մուտք գործեք KIFF-ով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ini tidak dapat menyimpan kunci, jadi tidak dapat dipasangkan. Masuk dengan KIFF sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo %1$@ non può conservare una chiave, quindi non si può associare. Accedi invece con KIFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%1$@は鍵を保持できないため、ペアリングできません。代わりにKIFFでサインインしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოწყობილობა (%1$@) გასაღებს ვერ ინახავს, ამიტომ ვერ დაწყვილდება. სამაგიეროდ შედით KIFF-ით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ នេះមិនអាចកាន់កូនសោបានទេ ដូច្នេះមិនអាចផ្គូផ្គងបានទេ។ ចូលដោយ KIFF ជំនួសវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %1$@에는 키를 보관할 수 없어 페어링할 수 없습니다. 대신 KIFF로 로그인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ນີ້ເກັບກຸນແຈບໍ່ໄດ້ ສະນັ້ນຈັບຄູ່ບໍ່ໄດ້. ເຂົ້າສູ່ລະບົບດ້ວຍ KIFF ແທນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis įrenginys (%1$@) negali saugoti rakto, todėl jo susieti negalima. Verčiau prisijunkite su KIFF."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis %1$@ nevar glabāt atslēgu, tāpēc to nevar savienot pārī. Tā vietā pieraksties ar KIFF."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој %1$@ не може да чува клуч, па не може да се спари. Најави се со KIFF наместо тоа."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ %1$@ түлхүүр хадгалж чадахгүй тул хослуулах боломжгүй. Оронд нь KIFF-ээр нэвтэрнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो %1$@ ले कुञ्जी राख्न सक्दैन, त्यसैले जोड्न सकिँदैन। बरु KIFF बाट साइन इन गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %1$@ kan geen sleutel bewaren en kan dus niet gekoppeld worden. Log in plaats daarvan in met KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie (%1$@) nie może przechowywać klucza, więc nie da się go sparować. Zaloguj się przez KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ não consegue guardar uma chave, por isso não pode ser associado. Inicie sessão com o KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ não consegue guardar uma chave, por isso não pode ser associado. Entre com o KIFF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv (%1$@) nu poate păstra o cheie, așa că nu poate fi asociat. Conectați-vă cu KIFF în schimb."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zariadenie (%1$@) nevie uložiť kľúč, takže ho nemožno spárovať. Prihláste sa radšej cez KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta naprava (%1$@) ne more hraniti ključa, zato je ni mogoče seznaniti. Raje se prijavite s KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo pajisje (%1$@) nuk mund të mbajë çelës, ndaj nuk mund të çiftohet. Hyni me KIFF në vend të kësaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj (%1$@) ne može držati ključ pa se ne može upariti. Umesto toga prijavite se KIFF-om."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@เครื่องนี้เก็บกุญแจไม่ได้ จึงจับคู่ไม่ได้ เข้าสู่ระบบด้วย KIFF แทน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ açar saklap bilmeýär, şonuň üçin goşalanyp bilinmeýär. Ýerine KIFF bilen giriň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ cihazı anahtar tutamıyor, bu yüzden eşleştirilemez. Bunun yerine KIFF ile oturum açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ %1$@ کلید نہیں رکھ سکتا، اس لیے جوڑا نہیں جا سکتا۔ اس کے بجائے KIFF سے سائن اِن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ này không thể giữ khóa nên không thể ghép đôi. Hãy đăng nhập bằng KIFF."
