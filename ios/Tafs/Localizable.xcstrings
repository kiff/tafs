    "settings.devices.pair_prompt": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cütləşdirin: o, əməliyyatları təsdiq edə bilər"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сдвояване на %1$@: може да одобрява действия"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spárovat %1$@: může schvalovat akce"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ koppeln: Er kann Aktionen genehmigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair %1$@: it can approve actions"
