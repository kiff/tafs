        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que %1$@ ouça as novas mensagens em #%2$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lăsați-l pe %1$@ să audă mesajele noi din #%2$@"
