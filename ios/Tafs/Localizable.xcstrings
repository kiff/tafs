    "door.day.open|one": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ من %1$@ منك ومن المرسلين المقترنين اليوم. نص فقط: لا تُفتح المرفقات، ويذكر الرد ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün sizdən və cütləşmiş göndərənlərdən %1$@ içindən %2$@. Yalnız mətn: əlavələr açılmır və cavab bunu bildirir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ от %1$@ от вас и сдвоените податели днес. Само текст: прикачените файлове не се отварят и отговорът го казва."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ আপনার ও জোড়া লাগানো প্রেরকদের কাছ থেকে %1$@-এর মধ্যে %2$@। শুধু লেখা: সংযুক্তি খোলা হয় না, এবং উত্তরে তা বলা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ de %1$@ teu i de remitents aparellats avui. Només text: els fitxers adjunts no s'obren, i la resposta ho diu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes %2$@ z %1$@ od vás a spárovaných odesílatelů. Jen text: přílohy se neotevírají a odpověď to uvede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ von %1$@ von dir und gekoppelten Absendern heute. Nur Text: Anhänge werden nicht geöffnet, und die Antwort sagt das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ of %1$@ from you and paired senders today. Text only: attachments aren't opened, and the reply says so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ de %1$@ tuyos y de remitentes vinculados hoy. Solo texto: los adjuntos no se abren, y la respuesta lo dice."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täna sinult ja seotud saatjatelt %2$@/%1$@. Ainult tekst: manuseid ei avata ja vastus ütleb seda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ sur %1$@ de vous et des expéditeurs associés aujourd'hui. Texte uniquement : les pièces jointes ne sont pas ouvertes, et la réponse le précise."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ מתוך %1$@ ממך ומשולחים מוצמדים היום. טקסט בלבד: קבצים מצורפים לא נפתחים, והתשובה אומרת זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आपसे और जोड़े गए भेजने वालों से %1$@ में से %2$@। केवल टेक्स्ट: संलग्नक नहीं खोले जाते, और उत्तर यह बताता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ od %1$@ od vas i uparenih pošiljatelja danas. Samo tekst: privici se ne otvaraju, a odgovor to kaže."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma %2$@ / %1$@ tőled és a párosított küldőktől. Csak szöveg: a mellékletek nem nyílnak meg, és a válasz ezt jelzi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@-ից ձեզանից և զուգակցված ուղարկողներից այսօր։ Միայն տեքստ․ կցորդները չեն բացվում, և պատասխանն այդ մասին ասում է։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ su %1$@ da te e dai mittenti associati oggi. Solo testo: gli allegati non vengono aperti, e la risposta lo dice."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@-დან თქვენგან და დაწყვილებული გამგზავნებისგან დღეს. მხოლოდ ტექსტი: დანართები არ იხსნება და პასუხი ამას ამბობს."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien: %2$@ iš %1$@ – iš jūsų ir susietų siuntėjų. Tik tekstas: priedai neatidaromi, ir atsakyme tai pasakoma."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "No tevis un pārī savienotajiem sūtītājiem šodien: %2$@ no %1$@. Tikai teksts: pielikumi netiek atvērti, un atbildē tas ir pateikts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ од %1$@ од тебе и спарени испраќачи денес. Само текст: прилозите не се отвораат, а одговорот го кажува тоа."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өнөөдөр таны болон хослуулсан илгээгчдийн %1$@-аас %2$@. Зөвхөн текст: хавсралтыг нээдэггүй бөгөөд хариу үүнийг хэлнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आज तपाईं र जोडिएका पठाउनेहरूबाट %1$@ मध्ये %2$@। केवल पाठ: संलग्नहरू खोलिँदैनन्, र जवाफले यो भन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ van %1$@ van jou en gekoppelde afzenders vandaag. Alleen tekst: bijlagen worden niet geopend, en het antwoord zegt dat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ z %1$@ od Ciebie i powiązanych nadawców dziś. Tylko tekst: załączniki nie są otwierane, a odpowiedź to mówi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ de %1$@ mensagem sua e de remetentes associados hoje. Só texto: os anexos não são abertos, e a resposta indica-o."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ de %1$@ mensagem sua e de remetentes associados hoje. Só texto: os anexos não são abertos, e a resposta indica-o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ din %1$@ de la dvs. și de la expeditorii asociați azi. Doar text: atașamentele nu se deschid, iar răspunsul spune asta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes %2$@ z %1$@ od vás a spárovaných odosielateľov. Len text: prílohy sa neotvárajú a odpoveď to uvedie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes %2$@ od %1$@ od vas in seznanjenih pošiljateljev. Samo besedilo: priponke se ne odpirajo in odgovor to pove."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ nga %1$@ nga ju dhe dërguesit e çiftuar sot. Vetëm tekst: bashkëngjitjet nuk hapen, dhe përgjigjja e thotë këtë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ od %1$@ od vas i uparenih pošiljatelja danas. Samo tekst: privici se ne otvaraju, a odgovor to kaže."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu gün siz we goşalanan iberijiler tarapyndan %1$@-dan %2$@. Diňe tekst: goşundylar açylmaýar, we jogap muny aýdýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün sizden ve eşleştirilmiş gönderenlerden %2$@ / %1$@. Yalnızca metin: ekler açılmaz ve yanıt bunu belirtir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج آپ اور جوڑی گئی جانب سے %1$@ میں سے %2$@۔ صرف متن: منسلکات نہیں کھولے جاتے، اور جواب میں یہ بتایا جاتا ہے۔"
          }
        }
      }
    },
