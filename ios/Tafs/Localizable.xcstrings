    "record.did_this_happen.what_no_does": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nein“ gibt der Card ihren Spielraum zurück. „Ja“ lässt es gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No gives the Card its room back. Yes keeps it counted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«No» devuelve el margen a la Card. «Sí» lo mantiene contado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ei” annab Cardile ruumi tagasi. „Jah” jätab selle arvesse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non rend sa marge à la Card. Oui le garde compté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No restituisce il margine alla Card. Sì lo lascia conteggiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「いいえ」を選ぶとCardの枠が戻ります。「はい」を選ぶとカウントされたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아니요를 누르면 Card의 여유가 돌아옵니다. 예를 누르면 계속 집계됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ne“ grąžina Card rezervą. „Taip“ palieka tai įskaičiuotą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Nē” atdod Card tās rezervi atpakaļ. “Jā” to patur ieskaitītu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nee geeft de Card zijn ruimte terug. Ja laat het meetellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nie” przywraca zapas Card. „Tak” pozostawia to policzone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não devolve a margem ao Card. Sim mantém-na contada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não devolve a margem ao Card. Sim mantém-na contada."
          }
        }
      }
    },
    "record.did_this_happen.why_lost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Antwort ging verloren, daher kann KIFF nicht sagen, ob es durchgegangen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its answer was lost, so KIFF can't tell whether it went through."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió su respuesta, así que KIFF no puede saber si se completó."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle vastus läks kaotsi, seega ei saa KIFF öelda, kas see läks läbi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa réponse a été perdue : KIFF ne peut pas savoir s'il a abouti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua risposta è andata persa, quindi KIFF non può sapere se è andata a buon fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答が失われたため、完了したかどうかKIFFには分かりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 사라져 KIFF가 처리 여부를 알 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos atsakymas prarastas, todėl KIFF negali nustatyti, ar ji įvykdyta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā atbilde pazuda, tāpēc KIFF nevar zināt, vai tas tika izpildīts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het antwoord is verloren gegaan, dus KIFF kan niet zien of het is gelukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego odpowiedź zaginęła, więc KIFF nie wie, czy to przeszło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta perdeu-se, por isso o KIFF não sabe se foi concluída."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta perdeu-se, por isso o KIFF não sabe se foi concluída."
          }
        }
      }
    },
    "record.did_this_happen.why_probation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist einer der ersten Aufrufe eines neuen Geldvorgangs, daher fragt KIFF dich, was passiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is one of the first calls of a new money operation, so KIFF asks you what happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una de las primeras llamadas de una nueva operación de dinero, así que KIFF te pregunta qué pasó."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on üks uue rahatoimingu esimestest päringutest, seega küsib KIFF sinult, mis juhtus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'un des premiers appels d'une nouvelle opération financière : KIFF vous demande donc ce qui s'est passé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una delle prime chiamate di una nuova operazione con denaro, quindi KIFF ti chiede cosa è successo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいお金の操作の最初の呼び出しの1つなので、KIFFが何が起きたかを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 금전 작업의 첫 호출 중 하나라서 KIFF가 어떻게 되었는지 묻습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai viena pirmųjų naujos pinigų operacijos užklausų, todėl KIFF klausia jūsų, kas nutiko."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis ir viens no pirmajiem jaunas naudas darbības izsaukumiem, tāpēc KIFF jautā tev, kas notika."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een van de eerste aanroepen van een nieuwe geldoperatie, dus KIFF vraagt je wat er gebeurde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jedno z pierwszych wywołań nowej operacji pieniężnej, więc KIFF pyta Cię, co się stało."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma das primeiras chamadas de uma nova operação com dinheiro, por isso o KIFF pergunta-lhe o que aconteceu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma das primeiras chamadas de uma nova operação com dinheiro, por isso o KIFF pergunta a você o que aconteceu."
          }
        }
      }
    },
    "record.did_this_happen.why_refused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App hat es abgelehnt, aber nichts zeigt, dass es keine Wirkung hatte."
