    "taf.halt.not_resumed_unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم الاستئناف: لم يتم التأكيد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Davam etdirilmədi: təsdiq alınmadı."
