            "state": "translated",
            "value": "De acties ervan werken niet meer voor dit taf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jej akcje przestaną działać dla tego tafa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas ações deixam de funcionar para este taf."
          }
        },
        "pt-BR": {
          "stringUnit": {
