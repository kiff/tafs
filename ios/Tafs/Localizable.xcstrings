    },
    "approval.has_no_face_id_touch": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses %1$@ hat weder Face ID noch Touch ID und kann daher nicht genehmigen. Genehmige auf einem anderen iPhone, iPad oder Android-Telefon, das bei deinem Konto angemeldet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ has no Face ID or Touch ID, so it can't approve. Approve on another iPhone, iPad or Android phone signed in to your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ no tiene Face ID ni Touch ID, así que no puede aprobar. Aprueba en otro iPhone, iPad o teléfono Android con la sesión iniciada en tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet %1$@ n'a ni Face ID ni Touch ID : il ne peut pas approuver. Approuvez sur un autre iPhone, iPad ou téléphone Android connecté à votre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo %1$@ non ha Face ID né Touch ID, quindi non può approvare. Approva su un altro iPhone, iPad o telefono Android connesso al tuo account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %1$@ heeft geen Face ID of Touch ID en kan dus niet goedkeuren. Keur goed op een andere iPhone, iPad of Android-telefoon die met je account is ingelogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten %1$@ nie ma Face ID ani Touch ID, więc nie może zatwierdzać. Zatwierdź na innym iPhonie, iPadzie lub telefonie z Androidem zalogowanym na Twoje konto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ não tem Face ID nem Touch ID, por isso não pode aprovar. Aprove noutro iPhone, iPad ou telefone Android com sessão iniciada na sua conta."
          }
        }
      }
    },
    "approval.has_no_passcode_needs_one": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses %1$@ hat keinen Code, und %2$@ braucht einen. Lege unter %3$@ einen Code fest, füge dann %4$@ hinzu und komm zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ has no passcode, and %2$@ needs one. Set a passcode in %3$@, then add %4$@, then come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ no tiene código, y %2$@ lo necesita. Establece un código en %3$@, añade %4$@ y vuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet %1$@ n'a pas de code, et %2$@ en nécessite un. Définissez un code dans %3$@, ajoutez %4$@, puis revenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo %1$@ non ha un codice, e %2$@ ne richiede uno. Imposta un codice in %3$@, poi aggiungi %4$@, poi torna qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %1$@ heeft geen toegangscode, en %2$@ vereist er een. Stel een toegangscode in via %3$@, voeg daarna %4$@ toe en kom dan terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten %1$@ nie ma kodu, a %2$@ go wymaga. Ustaw kod w %3$@, potem dodaj %4$@ i wróć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ não tem código, e %2$@ precisa de um. Defina um código em %3$@, adicione %4$@ e depois volte."
          }
        }
      }
    },
