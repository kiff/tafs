    "sample.access.job": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib neuen Leuten ihre Apps und entferne Ausscheidende an ihrem letzten Tag. Nur Rollen aus der genehmigten Liste. Deaktivieren, nie löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give new joiners their apps and remove leavers the day they go. Roles from the approved list only. Deactivate, never delete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da a las nuevas incorporaciones sus apps y retira las de quienes se van el día que se marchan. Solo roles de la lista aprobada. Desactivar, nunca eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donner leurs apps aux nouveaux arrivants et retirer celles des partants le jour de leur départ. Rôles de la liste approuvée uniquement. Désactiver, jamais supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai ai nuovi arrivati le loro app e rimuovi chi se ne va il giorno stesso. Solo ruoli dall'elenco approvato. Disattiva, non eliminare mai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef nieuwe collega's hun apps en verwijder vertrekkers op hun laatste dag. Alleen rollen van de goedgekeurde lijst. Deactiveren, nooit verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawaj nowym osobom ich aplikacje i odbieraj je odchodzącym w dniu odejścia. Tylko role z zatwierdzonej listy. Dezaktywuj, nigdy nie usuwaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar aos novos colaboradores as suas apps e remover quem sai no próprio dia. Só funções da lista aprovada. Desativar, nunca eliminar."
          }
        }
      }
    },
