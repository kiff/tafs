    "door.api.draft_scope": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ taf-ına yalnız iş verə bilər. %2$@ taf-ının nə edə biləcəyi onun Card-ında qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ може само да дава работа на %2$@. Какво може да прави %2$@, решава неговата Card."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ může %2$@ jen předávat práci. Co %2$@ smí dělat, určuje dál jeho Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kann %2$@ nur Arbeit geben. Was %2$@ darf, bestimmt weiter seine Card."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ can only hand %2$@ work. What %2$@ may do stays its Card's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ solo puede darle trabajo a %2$@. Lo que %2$@ puede hacer lo sigue decidiendo su Card."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ saab tafile %2$@ ainult tööd anda. See, mida %2$@ tohib teha, jääb selle Cardi otsustada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ peut seulement confier du travail à %2$@. Ce que %2$@ peut faire reste décidé par sa Card."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ može samo predavati posao tafu %2$@. Što taf %2$@ smije raditi ostaje stvar njegova Carda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ csak munkát adhat neki (%2$@). Hogy %2$@ mit tehet, az továbbra is a Cardján múlik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը կարող է %2$@-ին միայն աշխատանք տալ։ Ինչ կարող է անել %2$@-ը, մնում է նրա Card-ինը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hanya dapat menyerahkan pekerjaan kepada %2$@. Apa yang boleh dilakukan %2$@ tetap menjadi urusan Card-nya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ può solo affidare lavoro a %2$@. Cosa può fare %2$@ lo decide sempre la sua Card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@に仕事を渡すことしかできません。%2$@にできることは引き続きCardが決めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ს მხოლოდ %2$@-ისთვის სამუშაოს მიცემა შეუძლია. რისი გაკეთებაც შეუძლია %2$@-ს, მისი Card-ის საქმეა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) %2$@에게 작업을 맡기는 것만 할 수 있습니다. %2$@이(가) 할 수 있는 일은 Card가 정합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gali tik perduoti darbą %2$@. Ką %2$@ gali daryti, lemia jo Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ var tikai nodot %2$@ darbu. Ko %2$@ drīkst darīt, joprojām nosaka tā Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kan %2$@ alleen werk geven. Wat %2$@ mag, blijft aan zijn Card."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja %1$@ może tylko zlecać pracę dla %2$@. O tym, co %2$@ może robić, nadal decyduje jego Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ só pode entregar trabalho a %2$@. O que %2$@ pode fazer continua a ser decidido pela sua Card."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ só pode entregar trabalho a %2$@. O que %2$@ pode fazer continua sendo decidido pelo seu Card."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ îi poate da lui %2$@ doar de lucru. Ce poate face %2$@ rămâne decis de Cardul său."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ môže %2$@ len odovzdávať prácu. Čo %2$@ smie robiť, určuje ďalej jeho Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lahko %2$@ samo predaja delo. Kaj %2$@ sme, ostane stvar njegove Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mund t'i japë %2$@ vetëm punë. Ajo që mund të bëjë %2$@ mbetet e Card-it të tij."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ može samo predavati posao tafu %2$@. Šta taf %2$@ sme raditi ostaje stvar njegova Carda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ มอบงานให้ %2$@ ได้เท่านั้น สิ่งที่ %2$@ ทำได้ยังเป็นของ Card ของมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yalnızca %2$@ taf'ına iş verebilir. %2$@ taf'ının ne yapabileceğini yine Card'ı belirler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chỉ có thể giao việc cho %2$@. Những gì %2$@ được phép làm vẫn do Card của nó quyết định."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 只能交付工作給 %2$@。%2$@ 能做什麼仍由它的 Card 決定。"
          }
        }
      }
    },
