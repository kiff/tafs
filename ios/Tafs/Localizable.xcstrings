          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach weet het en geeft het opnieuw door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach wie i przekaże to ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach sabe e volta a passá-lo."
          }
        },
        "pt-BR": {
