    "chrome.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs können ein gekoppeltes Chrome nur auf den Websites nutzen, die eine Verbindung nennt, und riskante Schritte bestätigst du hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tafs can use a paired Chrome only on the sites a connection lists, and you approve risky steps here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tafs solo pueden usar un Chrome vinculado en los sitios que indica una conexión, y tú apruebas aquí los pasos arriesgados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tafid saavad seotud Chrome'i kasutada ainult ühenduses loetletud saitidel ja riskantsed sammud kinnitad sina siin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tafs ne peuvent utiliser un Chrome associé que sur les sites qu'une connexion indique, et vous approuvez ici les étapes risquées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tafs possono usare un Chrome associato solo sui siti indicati da un collegamento, e i passaggi rischiosi li approvi qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsがペアリング済みのChromeを使えるのは、接続に指定されたサイトだけです。リスクのある操作はここで承認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs는 페어링된 Chrome을 연결에 지정된 사이트에서만 사용할 수 있으며, 위험한 단계는 여기서 승인합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų taf susietą Chrome gali naudoti tik ryšyje nurodytose svetainėse, o rizikingus veiksmus patvirtinate čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavi taf var izmantot savienoto Chrome tikai savienojumā norādītajās vietnēs, un riskantus soļus tu apstiprini šeit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tafs kunnen een gekoppelde Chrome alleen gebruiken op de sites die een koppeling noemt, en riskante stappen keur je hier goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje tafs mogą używać powiązanego Chrome tylko na stronach, które wskazuje połączenie, a ryzykowne kroki zatwierdzasz tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs só podem usar um Chrome associado nos sites que uma ligação indica, e os passos arriscados são aprovados aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus tafs só podem usar um Chrome associado nos sites que uma conexão indica, e você aprova aqui os passos arriscados."
          }
        }
      }
    },
