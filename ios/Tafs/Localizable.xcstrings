        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zegt van %1$@ te komen, maar het is niet door de afzendercontrole gekomen, dus het wordt behandeld als dat van een onbekende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaje, że jest od %1$@, ale nie przeszła weryfikacji nadawcy, więc jest traktowana jak wiadomość od nieznajomego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz ser de %1$@, mas não passou a verificação do remetente, por isso é tratado como de um desconhecido."
          }
        }
      }
    },
