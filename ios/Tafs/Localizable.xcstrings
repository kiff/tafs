        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện có quá nhiều lần thử. Hãy thử lại sau một phút."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剛才嘗試次數過多。請於一分鐘後再試。"
          }
        }
      }
    },
    "error.changed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu arada dəyişib. İndi göstərilən cari vəziyyətdir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Междувременно се промени. Това, което виждате сега, е актуалното състояние."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezitím se to změnilo. Teď vidíte aktuální stav."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hat sich inzwischen geändert. Was jetzt angezeigt wird, ist der aktuelle Stand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It changed in the meantime. What's shown now is how it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambió mientras tanto. Lo que se muestra ahora es como está."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See muutus vahepeal. Nüüd on näha selle praegune seis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela a changé entre-temps. Ce qui s'affiche maintenant est l'état actuel."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U međuvremenu se promijenilo. Ono što se sada prikazuje stvarno je stanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Közben megváltozott. Most a jelenlegi állapotot látod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այդ ընթացքում փոխվել է։ Այն, ինչ ցուցադրվում է հիմա, ներկա վիճակն է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berubah sementara itu. Yang ditampilkan sekarang adalah keadaan sebenarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel frattempo è cambiato. Ciò che vedi ora è lo stato attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その間に変更されました。現在の状態を表示しています。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამასობაში შეიცვალა. ახლა ნაჩვენებია მიმდინარე მდგომარეობა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그사이에 바뀌었습니다. 지금 보이는 것이 현재 상태입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo metu tai pasikeitė. Dabar rodoma tikroji būsena."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas pa to laiku mainījās. Tagad redzamais ir pašreizējais stāvoklis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is intussen gewijzigd. Wat nu wordt getoond, is hoe het is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W międzyczasie coś się zmieniło. To, co jest teraz widoczne, to stan aktualny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou entretanto. O que é mostrado agora é o estado atual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou nesse meio-tempo. O que aparece agora é o estado atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "S-a schimbat între timp. Ce vedeți acum este starea actuală."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Medzitým sa to zmenilo. Teraz vidíte aktuálny stav."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medtem se je spremenilo. Zdaj vidite, kako je."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndryshoi ndërkohë. Ajo që shfaqet tani është si është."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "U međuvremenu se promenilo. Ono šta se sada prikazuje stvarno je stanje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการเปลี่ยนแปลงในระหว่างนั้น สิ่งที่แสดงอยู่ตอนนี้คือสถานะปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu arada değişti. Şu an gösterilen güncel durumdur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó đã thay đổi trong lúc đó. Những gì hiển thị bây giờ là tình trạng thực tế."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "期間內容已有變動。目前顯示的即是最新狀況。"
          }
        }
      }
    },
