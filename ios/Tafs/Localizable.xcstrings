    "chrome.profile_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل tafs في ملف Chrome خاص به. سجّل الدخول هناك فقط إلى المواقع التي تريد أن تستخدمها tafs لديك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs öz Chrome profilində işləyir. Orada yalnız tafs-ınızın istifadə etməsini istədiyiniz saytlara daxil olun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs работи в собствен профил на Chrome. Влизайте там само в сайтовете, които искате вашите tafs да използват."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs নিজের Chrome প্রোফাইলে কাজ করে। শুধু যেসব সাইট আপনার taf ব্যবহার করুক চান, সেখানেই সেখানে সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs treballa en el seu propi perfil de Chrome. Inicia-hi la sessió només als llocs que vulguis que utilitzin els teus taf."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs pracuje ve vlastním profilu Chromu. Přihlaste se v něm jen k webům, které mají vaše tafy používat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs arbeitet in einem eigenen Chrome-Profil. Melde dich dort nur bei den Websites an, die deine tafs nutzen sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs works in its own Chrome profile. Sign in there only to the sites you want your tafs to use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs trabaja en su propio perfil de Chrome. Inicia sesión ahí solo en los sitios que quieras que usen tus tafs."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs töötab oma Chrome'i profiilis. Logi seal sisse ainult saitidele, mida tahad, et su tafid kasutaksid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs travaille dans son propre profil Chrome. Connectez-vous-y uniquement aux sites que vos tafs doivent utiliser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs פועל בפרופיל Chrome משלו. יש להיכנס שם רק לאתרים שרצית שה-taf שלך ישתמשו בהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs अपनी ही Chrome प्रोफ़ाइल में काम करता है। वहाँ केवल उन्हीं साइटों में साइन इन करें जिन्हें आप अपने taf से उपयोग करवाना चाहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs radi u vlastitom Chromeovu profilu. Prijavite se u njemu samo na stranice koje želite da vaši tafovi koriste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafs saját Chrome-profilban dolgozik. Ott csak azokba a webhelyekbe jelentkezz be, amelyeket a tafjaidnak használniuk kell."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-ը աշխատում է իր սեփական Chrome պրոֆիլում։ Այնտեղ մուտք գործեք միայն այն կայքեր, որոնք ուզում եք, որ ձեր tafs-ը օգտագործի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs bekerja di profil Chrome-nya sendiri. Masuklah di sana hanya ke situs yang ingin Anda gunakan untuk tafs Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs lavora in un proprio profilo di Chrome. Lì accedi solo ai siti che vuoi far usare ai tuoi tafs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsは専用のChromeプロファイルで動作します。そこでは、tafsに使わせたいサイトだけにサインインしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs მუშაობს საკუთარ Chrome პროფილში. შედით იქ მხოლოდ იმ საიტებზე, რომელთა გამოყენებაც გსურთ თქვენს tafs-ს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ធ្វើការនៅក្នុងប្រូហ្វាល Chrome ផ្ទាល់ខ្លួនរបស់វា។ ចូលនៅទីនោះតែទៅគេហទំព័រដែលអ្នកចង់ឱ្យ taf របស់អ្នកប្រើប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs는 자체 Chrome 프로필에서 작동합니다. 그곳에서는 tafs가 사용할 사이트에만 로그인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ເຮັດວຽກໃນໂປຣໄຟລ໌ Chrome ຂອງມັນເອງ. ເຂົ້າສູ່ລະບົບຢູ່ບ່ອນນັ້ນສະເພາະເວັບໄຊທີ່ທ່ານຕ້ອງການໃຫ້ taf ຂອງທ່ານໃຊ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs veikia savo Chrome profilyje. Ten prisijunkite tik prie svetainių, kurias norite, kad naudotų jūsų taf."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs strādā savā Chrome profilā. Piesakies tur tikai vietnēs, kuras vēlies, lai tavi taf izmanto."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs работи во свој профил на Chrome. Најави се таму само на сајтовите што сакаш да ги користат твоите tafови."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs өөрийн Chrome профайлд ажилладаг. Таны taf-уудад ашиглуулахыг хүссэн сайтуудад л тэнд нэвтэрнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs आफ्नै Chrome प्रोफाइलमा काम गर्छ। तपाईंका taf हरूले प्रयोग गरून् भन्ने साइटमा मात्र त्यहाँ साइन इन गर्नुहोस्।"
