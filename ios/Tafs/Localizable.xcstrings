    "door.swipe_up_down_pick_door": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach oben oder unten, um eine Tür zu wählen. Doppeltippe, um sie zu öffnen oder zu schließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up or down to pick a door. Double-tap to open or close it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba o abajo para elegir una puerta. Toca dos veces para abrirla o cerrarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers le haut ou le bas pour choisir une porte. Touchez deux fois pour l'ouvrir ou la fermer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri su o giù per scegliere una porta. Tocca due volte per aprirla o chiuderla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg omhoog of omlaag om een deur te kiezen. Tik twee keer om hem te openen of te sluiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w górę lub w dół, aby wybrać drzwi. Stuknij dwukrotnie, aby je otworzyć lub zamknąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para cima ou para baixo para escolher uma porta. Toque duas vezes para a abrir ou fechar."
          }
        }
      }
    },
