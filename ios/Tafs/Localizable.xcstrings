    "alert.answer_nothing_sent_until_you": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. الرد قبل %3$@. لا يُرسل شيء حتى توافق."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Cavab verin: %3$@ vaxtınadək. Siz təsdiq etməyincə heç nə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Отговорете до %3$@. Нищо не се изпраща, докато не одобрите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@। %3$@-এর মধ্যে উত্তর দিন। আপনি অনুমোদন না করা পর্যন্ত কিছু পাঠানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Respon abans de %3$@. No s'envia res fins que ho aprovis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Odpovězte do %3$@. Nic se neodešle, dokud neschválíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Antworte bis %3$@. Nichts wird gesendet, bevor du genehmigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Answer by %3$@. Nothing is sent until you approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Responde antes de %3$@. No se envía nada hasta que apruebes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Vasta hiljemalt %3$@. Midagi ei saadeta enne, kui kinnitad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Répondez avant %3$@. Rien n'est envoyé tant que vous n'approuvez pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. יש להשיב עד %3$@. שום דבר לא נשלח עד שתאשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@। %3$@ तक उत्तर दें। आपके मंज़ूर करने तक कुछ नहीं भेजा जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Odgovorite do: %3$@. Ništa se ne šalje dok ne odobrite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Válaszolj eddig: %3$@. Semmi sem megy ki, amíg jóvá nem hagyod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Պատասխանեք մինչև՝ %3$@. Ոչինչ չի ուղարկվի, մինչև չհաստատեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Jawab sebelum %3$@. Tidak ada yang dikirim sampai Anda menyetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Rispondi entro le %3$@. Non viene inviato nulla finché non approvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@・%2$@。%3$@までに回答してください。承認するまで何も送信されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. უპასუხეთ ამ დრომდე: %3$@. არაფერი იგზავნება, სანამ არ დაამტკიცებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@។ ឆ្លើយមុន %3$@។ គ្មានអ្វីត្រូវបានផ្ញើទេ រហូតដល់អ្នកអនុម័ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. %3$@까지 응답하세요. 승인할 때까지 아무것도 보내지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. ຕອບກ່ອນ %3$@. ບໍ່ມີຫຍັງຖືກສົ່ງຈົນກວ່າທ່ານຈະອະນຸມັດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Atsakykite iki %3$@. Niekas nesiunčiama, kol nepatvirtinsite."
