    "connect.other_connections_stay_connected_no": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Andere tafs, die %1$@ nutzen, behalten ihren Zugriff. Nutzt kein anderer taf dasselbe Konto dort, wird die Anmeldung bei %2$@ widerrufen; sonst, wenn der letzte entfernt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Other tafs that use %1$@ keep their access. If no other taf uses the same account there, the sign-in is revoked at %2$@; otherwise, when the last one is removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Los demás tafs que usan %1$@ conservan su acceso. Si ningún otro taf usa la misma cuenta, el inicio de sesión se revoca en %2$@; si no, cuando se quita el último."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": " Teised tafid, mis kasutavad teenust %1$@, säilitavad oma juurdepääsu. Kui ükski teine taf ei kasuta seal sama kontot, tühistatakse sisselogimine teenuses %2$@; vastasel juhul siis, kui viimane neist eemaldatakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les autres tafs qui utilisent %1$@ gardent leur accès. Si aucun autre taf n'utilise le même compte, l'identifiant est révoqué chez %2$@ ; sinon, quand le dernier est retiré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Gli altri taf che usano %1$@ mantengono il loro accesso. Se nessun altro taf usa lo stesso account, il login viene revocato presso %2$@; altrimenti, quando viene rimosso l'ultimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を使う他のtafはアクセスを保持します。同じアカウントを使う他のtafがなければ、%2$@でサインインが取り消されます。あれば、最後のtafを外したときに取り消されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$@을(를) 쓰는 다른 tafs는 접근 권한을 유지합니다. 같은 계정을 쓰는 다른 taf가 없으면 %2$@에서 로그인이 취소되고, 있으면 마지막 taf를 제거할 때 취소됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": " Kiti %1$@ naudojantys taf išlaiko savo prieigą. Jei joks kitas taf nenaudoja tos pačios paskyros ten, prisijungimas atšaukiamas %2$@ pusėje; kitu atveju – kai pašalinamas paskutinis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": " Citi taf, kas izmanto %1$@, patur savu piekļuvi. Ja neviens cits taf tur neizmanto to pašu kontu, pierakstīšanās %2$@ tiek atsaukta; citādi – kad tiek noņemts pēdējais."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " Andere tafs die %1$@ gebruiken, houden hun toegang. Als geen andere taf hetzelfde account gebruikt, wordt de aanmelding bij %2$@ ingetrokken; anders pas als de laatste wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Inne tafy, które używają %1$@, zachowują dostęp. Jeśli żaden inny taf nie używa tego samego konta, logowanie zostanie cofnięte w %2$@; w przeciwnym razie, gdy usuniesz ostatni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " Os outros tafs que usam %1$@ mantêm o seu acesso. Se nenhum outro taf usar a mesma conta, o início de sessão é revogado em %2$@; caso contrário, quando o último for removido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Os outros tafs que usam %1$@ mantêm o seu acesso. Se nenhum outro taf usar a mesma conta, o login é revogado em %2$@; caso contrário, quando o último for removido."
          }
        }
      }
    },
    "connect.profile_words_not_read": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFs Worte zu dieser Verbindung konnten nicht gelesen werden. %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF's words for this connection couldn't be read. %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer las palabras de KIFF para esta conexión. %1$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFi sõnu selle ühenduse kohta ei õnnestunud lugeda. %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les textes de KIFF pour cette connexion n'ont pas pu être lus. %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere le parole di KIFF per questo collegamento. %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続に関するKIFFの説明を読み込めませんでした。%1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에 대한 KIFF의 설명을 읽지 못했습니다. %1$@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko nuskaityti KIFF formuluotės šiam ryšiui. %1$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formulējumu šim savienojumam nevarēja nolasīt. %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woorden van KIFF voor deze koppeling konden niet worden gelezen. %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać opisu KIFF dla tego połączenia. %1$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as palavras do KIFF para esta ligação. %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as palavras do KIFF para esta conexão. %1$@"
          }
        }
      }
    },
    "connect.profile_words_unread": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFs Worte zu dieser Verbindung sind noch nicht gelesen. Es wurde nichts genehmigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF's words for this connection aren't read yet. Nothing was approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras de KIFF para esta conexión aún no se han leído. No se aprobó nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFi sõnu selle ühenduse kohta pole veel loetud. Midagi ei kinnitatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les textes de KIFF pour cette connexion ne sont pas encore lus. Rien n'a été approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole di KIFF per questo collegamento non sono ancora state lette. Non è stato approvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続に関するKIFFの説明はまだ読み込まれていません。何も承認されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에 대한 KIFF의 설명을 아직 읽지 않았습니다. 승인된 것은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formuluotė šiam ryšiui dar neperskaityta. Niekas nepatvirtinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formulējums šim savienojumam vēl nav nolasīts. Nekas netika apstiprināts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woorden van KIFF voor deze koppeling zijn nog niet gelezen. Er is niets goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opis KIFF dla tego połączenia nie został jeszcze odczytany. Nic nie zostało zatwierdzone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras do KIFF para esta ligação ainda não foram lidas. Nada foi aprovado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras do KIFF para esta conexão ainda não foram lidas. Nada foi aprovado."
          }
        }
      }
    },
