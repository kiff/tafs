    "error.no_device_name": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaza ad vermək üçün KIFF-ə qoşulmaq alınmadı. Bağlantını yoxlayın və yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можа да се стигне до KIFF, за да се именува това устройство. Проверете връзката и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se spojit s KIFF a pojmenovat toto zařízení. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF war nicht erreichbar, um dieses Gerät zu benennen. Prüfe die Verbindung und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach KIFF to name this device. Check the connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con KIFF para nombrar este dispositivo. Comprueba la conexión y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFini ei jõutud, et sellele seadmele nimi anda. Kontrolli ühendust ja proovi uuesti."
