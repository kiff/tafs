            "value": "„Zatwierdź” podpisuje na tym urządzeniu (%1$@); aplikacja zaczyna powiadamiać tafa dopiero potem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar assina neste %1$@; só depois disso a app começa a avisar o taf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar assina neste %1$@; só depois disso o app começa a avisar o taf."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobarea se semnează pe acest dispozitiv (%1$@); abia după aceea aplicația începe să-i transmită tafului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Schválenie sa podpíše na tomto zariadení (%1$@); aplikácia začne taf informovať až potom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobritev se podpiše na tej napravi (%1$@); aplikacija začne obveščati taf šele nato."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Miratimi nënshkruhet në këtë pajisje (%1$@); aplikacioni fillon t'i tregojë taf-it vetëm pas kësaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobravanje potpisuje na ovom uređaju (%1$@); aplikacija tek nakon toga počinje obaveštavati taf."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอนุมัติจะลงนามบน%1$@เครื่องนี้ แอปจะเริ่มบอก taf หลังจากนั้นเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay bu %1$@ üzerinde imzalanır; uygulama taf'a ancak ondan sonra haber vermeye başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phê duyệt sẽ ký trên %1$@ này; ứng dụng chỉ bắt đầu báo cho taf sau đó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准會在這部%1$@上簽署；App 要等到那之後，才會開始通知 taf。"
          }
        }
      }
    },
