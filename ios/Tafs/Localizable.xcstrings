    "watch.type_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب إلى Coach…"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-a yazın…"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишете на Coach…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-কে লিখুন…"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriu a Coach…"
          }
