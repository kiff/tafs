          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากหน้าเข้าสู่ระบบของผู้ให้บริการเปิดขึ้น ให้ทำให้เสร็จที่นั่นแล้วกลับมา"
