    "sign_in.tafs_had_no_window_screen": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-ın girişi üstündə açmaq üçün ekranda pəncərəsi yox idi. tafs-ı açın və yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs нямаше прозорец на екрана, върху който да отвори входа. Отворете tafs и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs neměl na obrazovce okno, přes které by otevřel přihlášení. Otevřete tafs a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs hatte kein Fenster auf dem Bildschirm, über dem sich die Anmeldung öffnen konnte. Öffne tafs und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs had no window on screen to open the sign-in over. Open tafs and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs no tenía ninguna ventana en pantalla sobre la que abrir el inicio de sesión. Abre tafs y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsil polnud ekraanil akent, mille peale sisselogimist avada. Ava tafs ja proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs n'avait aucune fenêtre à l'écran pour y ouvrir la connexion. Ouvrez tafs et réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nije imao prozor na zaslonu iznad kojeg bi otvorio prijavu. Otvorite tafs i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafsnek nem volt ablaka a képernyőn, amely felett megnyithatta volna a bejelentkezést. Nyisd meg a tafst, és próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-ը էկրանին պատուհան չուներ, որի վրա բացեր մուտքը։ Բացեք tafs-ը և փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs tidak memiliki jendela di layar untuk membuka proses masuk. Buka tafs dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs non aveva una finestra sullo schermo su cui aprire l'accesso. Apri tafs e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインを開くためのtafsのウインドウが画面にありませんでした。tafsを開いてもう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-ს ეკრანზე ფანჯარა არ ჰქონდა, რომ შესვლა მასზე გაეხსნა. გახსენით tafs და სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 창을 띄울 tafs 창이 화면에 없었습니다. tafs를 열고 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs neturėjo ekrane lango, virš kurio atidaryti prisijungimą. Atidarykite tafs ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ekrānā nebija loga, virs kura atvērt pierakstīšanos. Atver tafs un mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs had geen venster op het scherm om de login over te openen. Open tafs en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nie miał na ekranie okna, nad którym mógłby otworzyć logowanie. Otwórz tafs i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não tinha nenhuma janela no ecrã sobre a qual abrir o início de sessão. Abra o tafs e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não tinha nenhuma janela na tela sobre a qual abrir o login. Abra o tafs e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nu avea nicio fereastră pe ecran peste care să deschidă conectarea. Deschideți tafs și încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nemal na obrazovke okno, cez ktoré by otvoril prihlásenie. Otvorte tafs a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs na zaslonu ni imel okna, čez katerega bi odprl prijavo. Odprite tafs in poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nuk kishte dritare në ekran për të hapur hyrjen mbi të. Hapni tafs dhe provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nije imao prozor na ekranu iznad kog bi otvorio prijavu. Otvorite tafs i pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ไม่มีหน้าต่างบนหน้าจอให้เปิดหน้าเข้าสู่ระบบ เปิด tafs แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs'ın oturum açmayı üzerinde açabileceği, ekranda bir penceresi yoktu. tafs'ı açıp tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs không có cửa sổ nào trên màn hình để mở trang đăng nhập. Hãy mở tafs và thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs 在螢幕上沒有可用來開啟登入的視窗。請開啟 tafs 後再試一次。"
          }
        }
      }
    },
