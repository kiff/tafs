    "door.knock.rest_keys|one": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Tür hatte für heute ihre Nachrichten von dir und gekoppelten Absendern. %1$@ weitere wurde verworfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This door had its messages from you and paired senders for today. %1$@ more was dropped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta puerta ya recibió hoy sus mensajes tuyos y de remitentes vinculados. Se descartó %1$@ más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle ukse sõnumid sinult ja seotud saatjatelt on tänaseks täis. Veel %1$@ jäeti vastu võtmata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette porte a reçu ses messages de vous et des expéditeurs associés pour aujourd'hui. %1$@ de plus a été ignoré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa porta ha già ricevuto i messaggi di oggi da te e dai mittenti associati. %1$@ altro è stato scartato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien šios durys jau gavo visas leidžiamas jūsų ir susietų siuntėjų žinutes. Dar %1$@ atmesta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šīs durvis šodien saņēma visas atļautās ziņas no tevis un pārī savienotajiem sūtītājiem. Vēl %1$@ tika atmesta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze deur heeft zijn berichten van jou en gekoppelde afzenders voor vandaag gehad. Nog %1$@ is genegeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
