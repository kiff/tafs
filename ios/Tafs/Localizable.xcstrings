    "door.day.open|few": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes %2$@ z %1$@ od vás a spárovaných odesílatelů. Jen text: přílohy se neotevírají a odpověď to uvede."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ od %1$@ od vas i uparenih pošiljatelja danas. Samo tekst: privici se ne otvaraju, a odgovor to kaže."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien: %2$@ iš %1$@ – iš jūsų ir susietų siuntėjų. Tik tekstas: priedai neatidaromi, ir atsakyme tai pasakoma."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ z %1$@ od Ciebie i powiązanych nadawców dziś. Tylko tekst: załączniki nie są otwierane, a odpowiedź to mówi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ din %1$@ de la dvs. și de la expeditorii asociați azi. Doar text: atașamentele nu se deschid, iar răspunsul spune asta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes %2$@ z %1$@ od vás a spárovaných odosielateľov. Len text: prílohy sa neotvárajú a odpoveď to uvedie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes %2$@ od %1$@ od vas in seznanjenih pošiljateljev. Samo besedilo: priponke se ne odpirajo in odgovor to pove."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ od %1$@ od vas i uparenih pošiljatelja danas. Samo tekst: privici se ne otvaraju, a odgovor to kaže."
          }
        }
      }
    },
