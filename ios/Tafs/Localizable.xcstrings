    "report.thanks": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا. سيقرأ أحد في KIFF بلاغك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təşəkkürlər. KIFF-də kimsə bildirişinizi oxuyacaq."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Благодарим. Някой от KIFF ще прочете доклада ви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধন্যবাদ। KIFF-এর কেউ আপনার রিপোর্ট পড়বেন।"
