    "chat.stopped.out_of_room": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat gestoppt: Seine Antwort hatte keinen Platz mehr. Bitte um etwas Kürzeres oder um einen Teil nach dem anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stopped: its reply ran out of room. Ask for something shorter, or for one part at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detuvo: su respuesta se quedó sin espacio. Pide algo más corto, o una parte cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s'est arrêté : sa réponse a manqué de place. Demandez quelque chose de plus court, ou une partie à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si è fermato: la sua risposta ha esaurito lo spazio. Chiedi qualcosa di più breve, o una parte alla volta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gestopt: het antwoord had geen ruimte meer. Vraag om iets korters, of om één deel tegelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatrzymał się: w jego odpowiedzi zabrakło miejsca. Poproś o coś krótszego albo o jedną część naraz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: a resposta ficou sem espaço. Peça algo mais curto, ou uma parte de cada vez."
          }
        }
      }
    },
