        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ახლა ვერ გამოიყენება. სცადეთ ცოტა ხანში."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចប្រើ %1$@ បានឥឡូវនេះទេ។ សូមព្យាយាមម្តងទៀតបន្តិចទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 %1$@을(를) 사용할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດຽວນີ້ໃຊ້ %1$@ ບໍ່ໄດ້. ລອງໃໝ່ໃນອີກຄູ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiuo metu negalima naudoti: %1$@. Netrukus bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pašlaik nevar izmantot. Pēc brīža mēģini vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не може да се користи во моментов. Обиди се повторно за малку."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ийг яг одоо ашиглах боломжгүй. Түр хүлээгээд дахин оролдоно уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ अहिले प्रयोग गर्न सकिँदैन। केही बेरमा फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kan nu niet worden gebruikt. Probeer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nie może być teraz użyte. Spróbuj ponownie za chwilę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível usar %1$@ neste momento. Tente novamente daqui a pouco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível usar %1$@ neste momento. Tente novamente daqui a pouco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nu poate fi folosit acum. Încercați din nou peste câteva momente."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ teraz nemožno použiť. Skúste to o chvíľu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trenutno ni mogoče uporabiti. Poskusite čez trenutek."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nuk mund të përdoret tani. Provoni sërish pas pak."
