    "watch.needs_lock": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu saatdan rədd etmək və ya dondurmaq üçün onda ekran kilidi qurun və kilidini açın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да отказвате или спирате от този часовник, задайте заключване на екрана му и го отключете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li z těchto hodinek odmítat nebo zastavovat, nastavte na nich zámek obrazovky a odemkněte je."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mit dieser Uhr abzulehnen oder anzuhalten, richte eine Displaysperre ein und entsperre sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To refuse or halt from this watch, set a screen lock on it and unlock it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para rechazar o bloquear desde este reloj, pon un bloqueo de pantalla y desbloquéalo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellest kellast keeldumiseks või peatamiseks sea sellele ekraanilukk ja ava see."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour refuser ou bloquer depuis cette montre, définissez un verrouillage de l'écran et déverrouillez-la."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da odbijete ili blokirate s ovog sata, postavite na njemu zaključavanje zaslona i otključajte ga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahhoz, hogy erről az óráról elutasíthass vagy leállíthass, állíts be rajta képernyőzárat, és oldd fel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ժամացույցից մերժելու կամ կանգնեցնելու համար դրա վրա կարգավորեք էկրանի կողպում և ապակողպեք այն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menolak atau membekukan dari jam tangan ini, atur kunci layar di jam tangan dan buka kuncinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rifiutare o bloccare da questo orologio, imposta un blocco schermo e sbloccalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウォッチから拒否や遮断をするには、画面ロックを設定してロックを解除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ საათიდან უარის სათქმელად ან გასაჩერებლად დააყენეთ მასზე ეკრანის ჩაკეტვა და განბლოკეთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 워치에서 거절하거나 차단하려면 화면 잠금을 설정하고 잠금을 해제하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad galėtumėte atmesti ar sustabdyti iš šio laikrodžio, nustatykite jo ekrano užraktą ir jį atrakinkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai atteiktu vai apturētu no šī pulksteņa, iestati tam ekrāna bloķēšanu un atbloķē to."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een schermvergrendeling in op dit horloge en ontgrendel het om vanaf hier te weigeren of stil te zetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby odrzucać lub blokować z tego zegarka, ustaw blokadę ekranu i odblokuj go."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recusar ou bloquear a partir deste relógio, defina um bloqueio de ecrã e desbloqueie-o."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recusar ou bloquear a partir deste relógio, defina um bloqueio de tela e desbloqueie-o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a refuza sau a opri de pe acest ceas, setați-i o blocare a ecranului și deblocați-l."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete z týchto hodiniek odmietať alebo zastavovať, nastavte na nich zámku obrazovky a odomknite ich."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za zavračanje ali ustavljanje s te ure nastavite na njej zaklepanje zaslona in jo odklenite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Për të refuzuar ose bllokuar nga kjo orë, vendosni një kyçje ekrani në të dhe zhbllokojeni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Da odbijete ili blokirate s ovog sata, podesite na njemu zaključavanje ekrana i otključajte ga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการปฏิเสธหรือระงับจากนาฬิกาเรือนนี้ ให้ตั้งการล็อกหน้าจอและปลดล็อก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu saatten reddetmek veya dondurmak için saatte bir ekran kilidi ayarlayın ve kilidini açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để từ chối hoặc đóng băng từ đồng hồ này, hãy đặt khóa màn hình cho nó và mở khóa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要從這支手錶拒絕或凍結，請先設定螢幕鎖定並解鎖。"
          }
        }
      }
    },
