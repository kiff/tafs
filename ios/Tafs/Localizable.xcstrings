    "door.slack_still_listens": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال روبوت Slack يستمع إلى تلك القناة، لذا يبقى الباب. %1$@"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack botu hələ də bu kanalı dinləyir, ona görə qapı qalır. %1$@"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ботът на Slack още слуша този канал, така че вратата остава. %1$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack বট এখনও সেই চ্যানেল শোনে, তাই দরজা থাকে। %1$@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El bot de Slack encara escolta aquell canal, així que la porta es manté. %1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Slacku pořád naslouchá tomu kanálu, takže dveře zůstávají. %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Slack-Bot hört diesem Kanal weiterhin zu, daher bleibt die Tür. %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Slack bot still listens to that channel, so the door stays. %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bot de Slack sigue escuchando ese canal, así que la puerta se mantiene. %1$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Slacki bot kuulab seda kanalit ikka, seega uks jääb. %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bot Slack écoute toujours ce canal : la porte reste. %1$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בוט ה-Slack עדיין מאזין לערוץ הזה, ולכן הדלת נשארת. %1$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack बॉट अब भी उस चैनल को सुनता है, इसलिए द्वार रहता है। %1$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack bot i dalje osluškuje taj kanal pa vrata ostaju. %1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Slack-bot még figyel arra a csatornára, ezért az ajtó marad. %1$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack բոտը դեռ լսում է այդ ալիքը, ուստի դուռը մնում է։ %1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Slack masih mendengarkan saluran itu, jadi pintu tetap ada. %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bot Slack ascolta ancora quel canale, quindi la porta resta. %1$@"
