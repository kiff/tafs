    "chrome.code_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في Chrome افتح إضافة tafs واكتب هذا الرمز. صالح لمدة 10 دقائق."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome-da tafs genişlənməsini açın və bu kodu yazın. 10 dəqiqə etibarlıdır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В Chrome отворете разширението tafs и въведете този код. Валиден е 10 минути."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome-এ tafs এক্সটেনশন খুলুন এবং এই কোডটি লিখুন। এটি ১০ মিনিট কাজ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A Chrome, obre l'extensió de tafs i escriu aquest codi. Funciona durant 10 minuts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Chromu otevřete rozšíření tafs a zadejte tento kód. Platí 10 minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in Chrome die tafs-Erweiterung und gib diesen Code ein. Er gilt 10 Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Chrome, open the tafs extension and type this code. It works for 10 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Chrome, abre la extensión de tafs y escribe este código. Sirve durante 10 minutos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Chrome'is tafsi laiendus ja sisesta see kood. See kehtib 10 minutit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Chrome, ouvrez l'extension tafs et saisissez ce code. Il est valable 10 minutes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-Chrome יש לפתוח את התוסף של tafs ולהקליד את הקוד הזה. הוא תקף ל-10 דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome में tafs एक्सटेंशन खोलें और यह कोड टाइप करें। यह 10 मिनट चलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U Chromeu otvorite proširenje tafs i upišite ovaj kôd. Vrijedi 10 minuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Chrome-ban nyisd meg a tafs bővítményt, és írd be ezt a kódot. 10 percig érvényes."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome-ում բացեք tafs-ի ընդլայնումը և մուտքագրեք այս կոդը։ Գործում է 10 րոպե։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Chrome, buka ekstensi tafs dan ketik kode ini. Berlaku selama 10 menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Chrome, apri l'estensione tafs e inserisci questo codice. Vale 10 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromeでtafs拡張機能を開き、このコードを入力してください。10分間有効です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome-ში გახსენით tafs-ის გაფართოება და აკრიფეთ ეს კოდი. მოქმედებს 10 წუთი."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅក្នុង Chrome សូមបើកផ្នែកបន្ថែម tafs ហើយវាយលេខកូដនេះ។ វាមានសុពលភាព ១០ នាទី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome에서 tafs 확장 프로그램을 열고 이 코드를 입력하세요. 10분 동안 유효합니다."
          }
        },
        "lo": {
