    "connect.disconnect.tools_stop": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ üçün %2$@ alətləri işləməyi dayandırır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструментите на %2$@ за %1$@ спират да работят."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroje %2$@ tafu %1$@ přestanou fungovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %2$@-Tools von %1$@ funktionieren nicht mehr."
          }
        },
        "en": {
