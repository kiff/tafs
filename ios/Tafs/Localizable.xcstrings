    "needs_you.answer_in_kiff_until": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten vom Telefon kommen an, sobald KIFF die Signatur des Telefons prüft. Bis dahin antworte in KIFF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answering from the phone arrives once KIFF checks the phone's signature. Until then, answer in KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas desde el teléfono llegarán cuando KIFF compruebe la firma del teléfono. Hasta entonces, responde en KIFF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réponse depuis le téléphone arrive dès que KIFF vérifie la signature du téléphone. D'ici là, répondez dans KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte dal telefono arrivano quando KIFF verifica la firma del telefono. Fino ad allora, rispondi in KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden vanaf de telefoon komt aan zodra KIFF de handtekening van de telefoon controleert. Antwoord tot dan in KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadanie z telefonu zadziała, gdy KIFF zacznie sprawdzać podpis telefonu. Do tego czasu odpowiadaj w KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas a partir do telefone chegam quando o KIFF verificar a assinatura do telefone. Até lá, responda no KIFF."
          }
        }
      }
    },
