          "stringUnit": {
            "state": "translated",
            "value": "音声入力が停止しました。もう一度始めるにはマイクをタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기가 멈췄습니다. 다시 시작하려면 마이크를 탭하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktavimas sustojo. Palieskite mikrofoną, kad pradėtumėte iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktēšana apstājās. Pieskaries mikrofonam, lai sāktu vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren gestopt. Tik op de microfoon om opnieuw te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie zatrzymane. Dotknij mikrofonu, aby zacząć ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado parou. Toque no microfone para recomeçar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado parou. Toque no microfone para recomeçar."
          }
        }
      }
    },
    "voice.tafs_turns_your_voice_into": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs wandelt deine Stimme auf diesem Gerät in Text um. Deine Stimme wird nirgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs turns your voice into text on this device. Your voice isn't sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs convierte tu voz en texto en este dispositivo. Tu voz no se envía a ningún sitio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs muudab sinu hääle selles seadmes tekstiks. Sinu häält ei saadeta kuhugi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs transforme votre voix en texte sur cet appareil. Votre voix n'est envoyée nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs trasforma la tua voce in testo su questo dispositivo. La tua voce non viene inviata da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsはこのデバイス上で声をテキストに変換します。声はどこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs는 이 기기에서 음성을 텍스트로 바꿉니다. 음성은 어디에도 보내지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs paverčia jūsų balsą tekstu šiame įrenginyje. Jūsų balsas niekur nesiunčiamas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs šajā ierīcē pārvērš tavu balsi tekstā. Tava balss netiek nekur sūtīta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs zet je stem op dit apparaat om in tekst. Je stem wordt nergens heen gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs zamienia Twój głos w tekst na tym urządzeniu. Twój głos nie jest nigdzie wysyłany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs transforma a sua voz em texto neste dispositivo. A sua voz não é enviada para lado nenhum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs transforma a sua voz em texto neste dispositivo. A sua voz não é enviada para lado nenhum."
          }
        }
      }
    },
