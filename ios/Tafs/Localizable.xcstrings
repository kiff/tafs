    "attachment.not_taken": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs kann diese Datei nicht anhängen: Art oder Größe werden nicht unterstützt. Wähle eine andere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs can't attach this file: it isn't a kind or size it takes. Pick another one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs no puede adjuntar este archivo: no es de un tipo o tamaño que acepte. Elige otro."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ei saa seda faili lisada: see ei ole sobivat tüüpi või suurusega. Vali mõni teine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ne peut pas joindre ce fichier : son type ou sa taille n'est pas accepté. Choisissez-en un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs non può allegare questo file: non è di un tipo o di una dimensione accettati. Scegline un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsはこのファイルを添付できません：対応する種類やサイズではありません。別のファイルを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs가 이 파일을 첨부할 수 없습니다. 지원하는 종류나 크기가 아닙니다. 다른 파일을 선택하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs negali pridėti šio failo: jo tipas ar dydis netinka. Pasirinkite kitą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nevar pievienot šo failu: tas nav pieņemama veida vai izmēra. Izvēlies citu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs kan dit bestand niet bijvoegen: het soort of de grootte wordt niet ondersteund. Kies een ander bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nie może załączyć tego pliku: ma nieobsługiwany typ lub rozmiar. Wybierz inny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não pode anexar este ficheiro: não é de um tipo ou tamanho aceite. Escolha outro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não pode anexar este arquivo: não é de um tipo ou tamanho aceito. Escolha outro."
          }
        }
      }
    },
