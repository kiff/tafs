    "needs_you.when_taf_asks_something_outside": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Benachrichtigung erreicht dich auf diesem %1$@, auch wenn tafs geschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An alert reaches you on this %1$@, even with tafs closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una alerta te llega en este %1$@, aunque tafs esté cerrado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teavitus jõuab sinuni selles seadmes (%1$@), isegi kui tafs on suletud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alerte vous parvient sur %2$@, même si tafs est fermé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avviso ti raggiunge su questo %1$@, anche con tafs chiusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsを閉じていても、この%1$@に通知が届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs를 닫아 두어도 이 %1$@(으)로 알림이 옵니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pranešimas jus pasieks šiame įrenginyje (%1$@), net kai tafs uždaryta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paziņojums tevi sasniedz šajā ierīcē (%1$@), pat ja tafs ir aizvērts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een melding bereikt je op deze %1$@, ook als tafs gesloten is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert dotrze do Ciebie na tym urządzeniu (%1$@), nawet gdy tafs jest zamknięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um alerta chega-lhe neste %1$@, mesmo com o tafs fechado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um alerta chega a você neste %1$@, mesmo com o tafs fechado."
