    "sample.brief.pay.meanwhile": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستمر الرسائل الأخرى؛ وتنتظر هذه الثلاث."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "digər mesajlar davam edir; bu üçü gözləyir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "другите съобщения продължават; тези три чакат."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য বার্তা চলতে থাকে; এই তিনটি অপেক্ষা করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "els altres missatges continuen; aquests tres esperen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "ostatní zprávy pokračují; tyto tři čekají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "andere Nachrichten laufen weiter; diese drei warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "other messages carry on; these three wait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "los demás mensajes siguen; estos tres esperan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "teised sõnumid lähevad edasi; need kolm ootavad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "les autres messages continuent ; ces trois-là attendent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הודעות אחרות ממשיכות; שלוש אלה ממתינות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाकी संदेश चलते रहते हैं; ये तीन इंतज़ार करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "ostale poruke idu dalje; ove tri čekaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "a többi üzenet halad; ez a három vár."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "մյուս հաղորդագրությունները շարունակվում են․ այս երեքը սպասում են։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "pesan lain tetap berjalan; ketiga ini menunggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "gli altri messaggi proseguono; questi tre aspettano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のメッセージは続行し、この3件は待機します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვა შეტყობინებები გრძელდება; ეს სამი ელოდება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សារផ្សេងទៀតបន្ត; ទាំងបីនេះរង់ចាំ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
