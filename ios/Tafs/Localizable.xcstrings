    "settings.sign_in_again_confirm.body_device": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses %1$@ meldet sich zuerst von KIFF ab, dann meldest du dich in deinem Browser erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ signs out of KIFF first, then you sign in again in your browser."
