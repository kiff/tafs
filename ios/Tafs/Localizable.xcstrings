    "door.no_door_yet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لـ %1$@ باب بعد. يستطيع من يديره إضافة واحد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ taf-ının hələ qapısı yoxdur. Onu idarə edən biri əlavə edə bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ още няма врата. Някой, който го управлява, може да добави такава."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-এর এখনও কোনো দরজা নেই। যিনি একে পরিচালনা করেন তিনি একটি যোগ করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ encara no té cap porta. Qui el gestiona en pot afegir una."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatím nemá žádné dveře. Může je přidat ten, kdo ho spravuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat noch keine Tür. Jemand, der ihn verwaltet, kann eine hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has no door yet. Someone who manages it can add one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aún no tiene puerta. Alguien que lo gestione puede añadir una."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafil %1$@ pole veel ust. Selle haldaja saab ühe lisada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n'a pas encore de porte. Une personne qui le gère peut en ajouter une."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-%1$@ עדיין אין דלת. מי שמנהל אותו יכול להוסיף אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ का अभी कोई द्वार नहीं। उसे सँभालने वाला कोई जोड़ सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf %1$@ još nema vrata. Netko tko njime upravlja može ih dodati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafnak még nincs ajtaja. Aki kezeli, hozzáadhat egyet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը դեռ դուռ չունի։ Նա, ով կառավարում է այն, կարող է ավելացնել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ belum punya pintu. Orang yang mengelolanya dapat menambahkan satu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non ha ancora una porta. Chi lo gestisce può aggiungerne una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@にはまだ窓口がありません。管理する人が追加できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ს ჯერ კარი არ აქვს. ვინც მას მართავს, შეუძლია დაამატოს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ មិនទាន់មានទ្វារទេ។ អ្នកដែលគ្រប់គ្រងវាអាចបន្ថែមមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에게는 아직 창구가 없습니다. 관리하는 사람이 추가할 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ຍັງບໍ່ມີປະຕູ. ຜູ້ທີ່ຈັດການມັນເພີ່ມໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dar neturi durų. Jas gali pridėti tas, kas jį valdo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vēl nav durvju. Tās var pievienot kāds, kas to pārvalda."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ сè уште нема врата. Некој што управува со него може да додаде."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-д хаалга хараахан алга. Түүнийг удирддаг хүн нэмж чадна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को अहिलेसम्म ढोका छैन। यसलाई व्यवस्थापन गर्ने कसैले थप्न सक्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft nog geen deur. Iemand die het beheert, kan er een toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nie ma jeszcze drzwi. Może je dodać osoba, która nim zarządza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ainda não tem porta. Alguém que o gere pode adicionar uma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ainda não tem porta. Alguém que o gerencia pode adicionar uma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nu are încă nicio ușă. Cineva care îl gestionează poate adăuga una."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatiaľ nemá žiadne dvere. Môže ich pridať ten, kto ho spravuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ še nima vrat. Doda jih lahko nekdo, ki ga upravlja."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ende nuk ka portë. Dikush që e menaxhon mund të shtojë një."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf %1$@ još nema vrata. Netko ko njime upravlja može ih dodati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ยังไม่มีประตู ผู้ที่จัดการมันเพิ่มได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-yň heniz gapysy ýok. Ony dolandyrýan biri gapy goşup biler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ taf'ının henüz kapısı yok. Onu yöneten biri ekleyebilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کا ابھی کوئی دروازہ نہیں۔ اسے منظم کرنے والا کوئی ایک شامل کر سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chưa có cửa nào. Người quản lý nó có thể thêm một cửa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 還沒有門。管理它的人可以新增。"
          }
        }
      }
    },
