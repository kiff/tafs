    "sample.leads.job": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworte neuen Leads innerhalb einer Stunde und vereinbare ein Gespräch. Rabatte warten auf dich. Versprich nie einen Preis, der nicht in der Preisliste steht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply to new leads within the hour and book a call. Discounts wait for you. Never promise a price that isn't on the price list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder a los nuevos contactos en menos de una hora y reservar una llamada. Los descuentos esperan tu aprobación. Nunca prometer un precio que no esté en la lista de precios."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasta uutele müügivihjetele tunni jooksul ja broneeri kõne. Allahindlused ootavad sind. Ära kunagi luba hinda, mida hinnakirjas pole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondre aux nouveaux prospects dans l'heure et fixer un appel. Les remises vous attendent. Ne jamais promettre un prix absent de la grille tarifaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondere ai nuovi contatti entro un'ora e fissare una chiamata. Gli sconti aspettano te. Non promettere mai un prezzo che non è nel listino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい見込み客に1時間以内に返信し、通話を予約します。値引きはあなたの承認を待ちます。価格表にない価格は約束しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 리드에게 1시간 이내에 답장하고 통화를 예약합니다. 할인은 내 승인을 기다립니다. 가격표에 없는 가격은 약속하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsakyti naujiems potencialiems klientams per valandą ir suplanuoti skambutį. Nuolaidos laukia jūsų. Niekada nežadėti kainos, kurios nėra kainoraštyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbildēt jauniem interesentiem stundas laikā un ieplānot zvanu. Atlaides gaida tevi. Nekad neapsolīt cenu, kuras nav cenrādī."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord nieuwe leads binnen een uur en plan een gesprek. Kortingen wachten op jou. Beloof nooit een prijs die niet in de prijslijst staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadaj nowym leadom w ciągu godziny i umawiaj rozmowę. Rabaty czekają na Ciebie. Nigdy nie obiecuj ceny spoza cennika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder a novos contactos em menos de uma hora e marcar uma chamada. Os descontos esperam por si. Nunca prometer um preço que não esteja na tabela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder a novos contatos em menos de uma hora e marcar uma chamada. Os descontos esperam por você. Nunca prometer um preço que não esteja na tabela."
          }
        }
      }
    },
