    "sample.parcels.job": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag Kunden Bescheid, wenn ein Paket sich verspätet, bevor sie fragen. Neuversand wartet auf dich. Ändere nie eine Lieferadresse aufgrund einer E-Mail."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell customers when a parcel runs late, before they ask. Reships wait for you. Never change a delivery address from an email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar a los clientes cuando un paquete se retrasa, antes de que pregunten. Los reenvíos esperan tu aprobación. Nunca cambiar una dirección de entrega por un correo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teata klientidele, kui pakk hilineb, enne kui nad küsivad. Uuesti saatmised ootavad sind. Ära kunagi muuda tarneaadressi e-kirja põhjal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévenir les clients quand un colis prend du retard, avant qu'ils ne demandent. Les renvois vous attendent. Ne jamais changer une adresse de livraison à partir d'un e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisare i clienti quando un pacco è in ritardo, prima che chiedano. Le rispedizioni aspettano te. Non cambiare mai un indirizzo di consegna per un'email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顧客に聞かれる前に、荷物の遅延を知らせます。再発送はあなたの承認を待ちます。メールだけで配送先住所を変えることはしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고객이 묻기 전에 소포가 늦어지면 알립니다. 재발송은 내 승인을 기다립니다. 이메일만 보고 배송 주소를 바꾸지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pranešti klientams, kai siuntinys vėluoja, dar jiems nepaklausus. Pakartotinis siuntimas laukia jūsų. Niekada nekeisti pristatymo adreso pagal el. laišką."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastāstīt klientiem, kad paka kavējas, pirms viņi jautā. Atkārtota nosūtīšana gaida tevi. Nekad nemainīt piegādes adresi pēc e-pasta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat klanten weten dat een pakket vertraagd is, voordat ze het vragen. Herzendingen wachten op jou. Wijzig nooit een afleveradres op basis van een e-mail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informuj klientów o spóźnionej paczce, zanim zapytają. Ponowne wysyłki czekają na Ciebie. Nigdy nie zmieniaj adresu dostawy na podstawie e-maila."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar os clientes quando uma encomenda se atrasa, antes de perguntarem. Os reenvios esperam por si. Nunca mudar uma morada de entrega a partir de um email."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar os clientes quando uma encomenda se atrasa, antes de perguntarem. Os reenvios esperam por você. Nunca mudar um endereço de entrega a partir de um email."
          }
        }
      }
    },
