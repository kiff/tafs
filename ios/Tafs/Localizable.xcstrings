        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 분 사이에 메시지가 너무 많습니다. %1$@에게 잠시 시간을 준 뒤 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per kelias minutes – daug žinučių. Duokite %1$@ akimirką ir bandykite dar kartą."
