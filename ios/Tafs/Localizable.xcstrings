        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "És per a un Chrome que no està vinculat a aquest telèfon, així que no es pot permetre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je pro Chrome, který není spárovaný s tímto telefonem, proto ho nelze povolit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie ist für ein Chrome, das nicht mit diesem Telefon gekoppelt ist, und kann daher nicht erlaubt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's for a Chrome this phone isn't paired with, so it can't be allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es para un Chrome que no está vinculado a este teléfono, así que no se puede permitir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on Chrome'i jaoks, mis pole selle telefoniga seotud, seega ei saa seda lubada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est destiné à un Chrome qui n'est pas associé à ce téléphone, il ne peut donc pas être autorisé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא מיועד ל-Chrome שלא מוצמד לטלפון הזה, ולכן אי אפשר לאשר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऐसे Chrome के लिए है जो इस फ़ोन से जुड़ा नहीं है, इसलिए इसकी अनुमति नहीं दी जा सकती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namijenjeno je Chromeu koji nije uparen s ovim telefonom, pa se ne može dopustiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olyan Chrome-hoz szól, amely nincs párosítva ezzel a telefonnal, ezért nem engedélyezhető."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն նախատեսված է Chrome-ի համար, որը զուգակցված չէ այս հեռախոսի հետ, ուստի այն հնարավոր չէ թույլատրել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini untuk Chrome yang tidak disandingkan dengan ponsel ini, jadi tidak bisa diizinkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È per un Chrome non associato a questo telefono, quindi non può essere consentita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンとペア設定していないChrome向けのため、許可できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ის განკუთვნილია Chrome-ისთვის, რომელიც ამ ტელეფონთან დაწყვილებული არ არის, ამიტომ მისი დაშვება შეუძლებელია."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាសម្រាប់ Chrome ដែលមិនបានផ្គូផ្គងជាមួយទូរសព្ទនេះ ដូច្នេះមិនអាចអនុញ្ញាតបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰과 페어링되지 않은 Chrome용이라 허용할 수 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມັນແມ່ນສຳລັບ Chrome ທີ່ບໍ່ໄດ້ຈັບຄູ່ກັບໂທລະສັບນີ້ ຈຶ່ງອະນຸຍາດບໍ່ໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jis skirtas Chrome, kuris nesusietas su šiuo telefonu, todėl jo leisti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā ir paredzēta Chrome, kas nav savienots pārī ar šo tālruni, tāpēc to nevar atļaut."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наменето е за Chrome што не е спарен со овој телефон, па не може да се дозволи."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ утастай хослоогүй Chrome-д зориулагдсан тул зөвшөөрөх боломжгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो यस फोनसँग जोडा नबनाइएको Chrome का लागि हो, त्यसैले अनुमति दिन सकिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze is voor een Chrome die niet aan deze telefoon is gekoppeld, dus kan ze niet worden toegestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy Chrome, który nie jest sparowany z tym telefonem, więc nie można na nie zezwolić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É para um Chrome que não está associado a este telemóvel, por isso não pode ser permitido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É para um Chrome que não está pareado com este celular, então não pode ser permitido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pentru un Chrome care nu e asociat cu acest telefon, deci nu poate fi permisă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je pre Chrome, ktorý nie je spárovaný s týmto telefónom, preto ho nemožno povoliť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namenjena je Chromu, ki ni seznanjen s tem telefonom, zato je ni mogoče dovoliti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Është për një Chrome që nuk është çiftuar me këtë telefon, ndaj nuk mund të lejohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Namenjeno je Chrome-u koji nije uparen sa ovim telefonom, pa ne može da se dozvoli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกรอกนี้สำหรับ Chrome ที่ไม่ได้จับคู่กับโทรศัพท์เครื่องนี้ จึงอนุญาตไม่ได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ol bu telefon bilen goşalanmadyk Chrome üçin, şonuň üçin oňa rugsat berip bolmaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonla eşlenmemiş bir Chrome için, bu yüzden izin verilemez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ایسے Chrome کے لیے ہے جو اس فون سے جوڑا نہیں گیا، اس لیے اس کی اجازت نہیں دی جا سکتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần điền này dành cho một Chrome chưa ghép nối với điện thoại này nên không thể cho phép."
          }
        },
        "zh-Hant": {
