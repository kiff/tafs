    "needs_you.empty_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein taf um etwas außerhalb seiner Card bittet, erscheint es hier und auf deinem Sperrbildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a taf asks for something outside its Card, it shows up here and on your lock screen."
          }
        },
        "es": {
