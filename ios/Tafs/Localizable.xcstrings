    "connect.disconnect.no_taf_uses": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein taf nutzt %1$@ mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No taf uses %1$@ now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún taf usa %1$@ ahora."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ükski taf ei kasuta nüüd teenust %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun taf n'utilise %1$@ désormais."
          }
        },
        "it": {
