        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellest telefonist kinnitamiseks lisa sellele sõrmejälg. Keeldumine töötab ikka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
