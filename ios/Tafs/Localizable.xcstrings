        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та яриан дотор зөвшөөрөх хүртэл ноорог."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले कुराकानीमा स्वीकृत नगरेसम्म मस्यौदा।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een concept tot je het in het gesprek goedkeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szkic, dopóki nie zatwierdzisz go w rozmowie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um rascunho até o aprovar na conversa."
