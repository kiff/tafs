    "taf.try_version_first_you_chat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere eine Version zuerst aus, unter einer eigenen Card. Die Live-Version arbeitet weiter. Installierst du eine, geht sie live."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a version first, under a Card of its own. The live version keeps working. Installing one makes it live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba antes una versión, con una Card propia. La versión activa sigue trabajando. Al instalarla, pasa a estar activa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi versiooni kõigepealt, selle oma Cardi all. Kasutusel olev versioon töötab edasi. Paigaldamine võtab selle kasutusele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez d'abord une version, sous sa propre Card. La version en service continue de travailler. L'installer la met en service."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova prima una versione, con una Card tutta sua. La versione attiva continua a lavorare. Installarla la rende attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず専用のCardのもとでバージョンを試せます。適用中のバージョンは動き続けます。インストールすると適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 별도의 Card로 버전을 시험해 보세요. 적용된 버전은 계속 작동합니다. 설치하면 그 버전이 적용됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmiausia išbandykite versiją su atskira Card. Aktyvi versija dirba toliau. Įdiegus versiją, ji tampa aktyvi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vispirms izmēģini versiju ar savu Card. Darbā esošā versija turpina strādāt. Instalējot versiju, tā tiek laista darbā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer eerst een versie uit, onder een eigen Card. De live versie blijft werken. Installeer je er een, dan wordt die live."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw wypróbuj wersję, w ramach jej własnej Card. Wersja działająca na żywo pracuje dalej. Instalacja wersji uruchamia ją na żywo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente primeiro uma versão, ao abrigo de um Card próprio. A versão em produção continua a trabalhar. Instalar uma coloca-a em produção."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente primeiro uma versão, ao abrigo de um Card próprio. A versão em produção continua trabalhando. Instalar uma coloca-a em produção."
          }
        }
      }
    },
