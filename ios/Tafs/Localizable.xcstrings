    "version.try_first": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere eine Version zuerst aus, unter einer eigenen Card. Die Live-Version arbeitet weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a version first, under a Card of its own. The live version keeps working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba antes una versión, con una Card propia. La versión activa sigue trabajando."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi versiooni kõigepealt, selle oma Cardi all. Kasutusel olev versioon töötab edasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez d'abord une version, sous sa propre Card. La version en service continue de travailler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova prima una versione, con una Card tutta sua. La versione attiva continua a lavorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず専用のCardのもとでバージョンを試せます。適用中のバージョンは動き続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 자체 Card로 버전을 시험해 보세요. 적용된 버전은 계속 작동합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmiausia išbandykite versiją su atskira Card. Aktyvi versija dirba toliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vispirms izmēģini versiju ar savu Card. Darbā esošā versija turpina strādāt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer eerst een versie uit, onder een eigen Card. De live versie blijft werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw wypróbuj wersję, w ramach jej własnej Card. Wersja działająca na żywo pracuje dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente primeiro uma versão, ao abrigo de um Card próprio. A versão em produção continua a trabalhar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente primeiro uma versão, ao abrigo de um Card próprio. A versão em produção continua trabalhando."
          }
        }
      }
    },
