    "kiff.kiff_can_not_do_sign": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kann das noch nicht: Melde dich in den Einstellungen erneut an, um auf diesem %1$@ zu genehmigen."
