            "state": "translated",
            "value": "Tidak dilanjutkan: belum dikonfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ripreso: non è stato confermato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開されていません：確認されませんでした。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არ განახლდა: არ დადასტურდა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនបានបន្តទេ៖ វាមិនត្រូវបានបញ្ជាក់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재개하지 않았습니다: 확인되지 않았습니다."
