    "halt_all.halting_all": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs werden angehalten: Kein Lauf startet. KIFF hat noch nicht jeden Teil bestätigt; tafs zeigt, wann es so weit ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halting your tafs: no run starts. KIFF hasn't confirmed every part yet; tafs shows when it has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueando tus tafs: no empieza ninguna ejecución. KIFF aún no ha confirmado todas las partes; tafs lo muestra cuando lo haga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocage de vos tafs : aucune exécution ne démarre. KIFF n'a pas encore tout confirmé ; tafs l'indique dès que c'est fait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocco dei tuoi tafs in corso: nessuna esecuzione parte. KIFF non ha ancora confermato ogni parte; tafs lo mostra quando l'ha fatto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tafs worden stilgezet: er start geen run. KIFF heeft nog niet alles bevestigd; tafs laat het zien zodra dat zo is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokowanie Twoich tafs: żadne uruchomienie się nie zaczyna. KIFF nie potwierdził jeszcze wszystkiego; tafs pokaże, kiedy to nastąpi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A bloquear os seus tafs: nenhuma execução começa. O KIFF ainda não confirmou todas as partes; o tafs mostra quando o fizer."
          }
        }
      }
    },
