    "coach.not_connectable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verbinden von Apps ist für dieses Konto auf diesem Telefon nicht eingerichtet. Öffne Coach, um es zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting apps isn't set up for this account from this phone. Open Coach to start it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión de apps no está configurada para esta cuenta desde este teléfono. Abre Coach para empezar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakenduste ühendamine pole selle konto jaoks selles telefonis seadistatud. Alustamiseks ava Coach."
          }
        },
        "fr": {
