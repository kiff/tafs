    "approval.first_taf": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen taf einzurichten braucht Genehmigungen: Coach bittet dich, seine Tools und die Card des tafs zu genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting up a taf needs approvals: Coach asks you to approve its tools and the taf's Card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurar un taf requiere aprobaciones: Coach te pide que apruebes sus apps y la Card del taf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurer un taf nécessite des approbations : Coach vous demande d'approuver ses outils et la Card du taf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurare un taf richiede approvazioni: Coach ti chiede di approvare i suoi strumenti e la Card del taf."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een taf instellen vraagt om goedkeuringen: Coach vraagt je zijn tools en de Card van het taf goed te keuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
