          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten %1$@ jest gotowy do zatwierdzania przez %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ está pronto para aprovar com %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ está pronto para aprovar com %2$@."
          }
        },
        "ro": {
