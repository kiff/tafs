        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trenutno nije moguće koristiti. Pokušajte ponovo za trenutak."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ใช้ %1$@ ไม่ได้ ลองอีกครั้งในอีกสักครู่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ häzir ulanylyp bilinmeýär. Birazdan täzeden synanyşyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda kullanılamıyor: %1$@. Biraz sonra tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ابھی استعمال نہیں ہو سکتا۔ تھوڑی دیر بعد دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không dùng được %1$@. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法使用%1$@。請稍後再試。"
          }
        }
      }
    },
