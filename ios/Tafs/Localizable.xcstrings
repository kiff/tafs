            "value": "Ouvrir une nouvelle porte vers %1$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת דלת חדשה אל %1$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ के लिए नया द्वार खोलें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite nova vrata za taf %1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Új ajtó nyitása ide: %1$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացեք նոր դուռ %1$@-ի համար"
          }
        },
        "id": {
