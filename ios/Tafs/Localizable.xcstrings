        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas no tā nedarbojas, līdz tu to turpini"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er draait niets van tot je het hervat"
