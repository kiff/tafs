    "door.paired_senders_today_more_dropped": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@ von dir und gekoppelten Absendern heute. Weitere werden bis morgen verworfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@ from you and paired senders today. More are dropped until tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ tuyos y de remitentes vinculados hoy. Los siguientes se descartan hasta mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@ de vous et des expéditeurs associés aujourd'hui. Les suivants sont ignorés jusqu'à demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ su %2$@ da te e dai mittenti associati oggi. I successivi vengono scartati fino a domani."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van %2$@ van jou en gekoppelde afzenders vandaag. Meer worden tot morgen genegeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ z %2$@ od Ciebie i powiązanych nadawców dziś. Kolejne są odrzucane do jutra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ mensagens suas e de remetentes associados hoje. As seguintes são descartadas até amanhã."
          }
        }
      }
    },
    "door.paired_senders_today_text_only": {
