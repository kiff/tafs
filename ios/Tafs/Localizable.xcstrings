    "needs_you.no_gives_card_room_back": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nein“ gibt seiner Card den Spielraum zurück. Zum Antworten wird %1$@ abgefragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No gives its Card the room back. Answering asks for %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«No» devuelve el margen a su Card. Para responder se pide %1$@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ei” annab selle Cardile ruumi tagasi. Vastad %1$@ abil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non rend sa marge à la Card. Répondre demande %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No restituisce il margine alla sua Card. Per rispondere serve %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいえを選ぶと、Cardの枠が戻ります。回答には%1$@が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거절하면 Card의 여유가 돌아옵니다. 답변하려면 %1$@이(가) 필요합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ne“ grąžina jo Card rezervą. Atsakant bus paprašyta: %1$@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Nē” atdod tā Card rezervi atpakaļ. Atbildot prasīs %1$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nee geeft zijn Card de ruimte terug. Antwoorden vraagt om %1$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nie” przywraca zapas jego Card. Odpowiedź wymaga %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não devolve a margem ao seu Card. Responder pede %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não devolve a margem ao seu Card. Responder pede %1$@."
          }
        }
      }
    },
    "needs_you.nothing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
