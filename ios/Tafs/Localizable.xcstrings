    "sample.memory.ask_first": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor allem Ungewöhnlichen fragen, auch wenn es zur Card passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask before anything unusual, even when it fits the Card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta antes de cualquier cosa inusual, aunque encaje en la Card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander avant toute chose inhabituelle, même si cela entre dans la Card."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi prima di qualsiasi cosa insolita, anche quando rientra nella Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag het eerst bij alles wat ongewoon is, ook als het binnen de Card past."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytaj przed wszystkim, co nietypowe, nawet jeśli mieści się w Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar antes de qualquer coisa invulgar, mesmo quando cabe no Card."
          }
        }
      }
    },
    "sample.memory.explain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du möchtest Entscheidungen lieber in einer Zeile erklärt bekommen als in einem Absatz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'd rather I explain a decision in one line than in a paragraph."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefieres que explique una decisión en una línea antes que en un párrafo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous préférez que j'explique une décision en une ligne plutôt qu'en un paragraphe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferisci che spieghi una decisione in una riga piuttosto che in un paragrafo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wilt liever dat ik een beslissing in één regel uitleg dan in een alinea."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolisz, żebym wyjaśniał decyzję w jednym zdaniu, a nie w akapicie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefere que explique uma decisão numa linha em vez de num parágrafo."
          }
        }
      }
    },
    "sample.memory.regulars": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunden, die jede Woche schreiben, bekommen am selben Morgen eine Antwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customers who write every week get a reply the same morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clientes que escriben cada semana reciben respuesta esa misma mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clients qui écrivent chaque semaine reçoivent une réponse le matin même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I clienti che scrivono ogni settimana ricevono una risposta la mattina stessa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klanten die elke week schrijven, krijgen dezelfde ochtend antwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klienci, którzy piszą co tydzień, dostają odpowiedź tego samego ranka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clientes que escrevem todas as semanas recebem resposta na mesma manhã."
          }
        }
      }
    },
