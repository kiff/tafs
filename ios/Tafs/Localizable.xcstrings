            "value": "%1$@ od %2$@ od vas i uparenih pošiljatelja danas. Samo tekst: privici se ne otvaraju, a odgovor to kaže."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma %1$@ / %2$@ tőled és a párosított küldőktől. Csak szöveg: a mellékletek nem nyílnak meg, és a válasz ezt jelzi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-ից ձեզանից և զուգակցված ուղարկողներից այսօր։ Միայն տեքստ․ կցորդները չեն բացվում, և պատասխանն այդ մասին ասում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dari %2$@ dari Anda dan pengirim yang dipasangkan hari ini. Hanya teks: lampiran tidak dibuka, dan balasan menyebutkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ su %2$@ da te e dai mittenti associati oggi. Solo testo: gli allegati non vengono aperti, e la risposta lo dice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のあなたと登録済みの送信者からの連絡：%2$@件中%1$@件。テキストのみ：添付ファイルは開かれず、返信でその旨を伝えます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-დან თქვენგან და დაწყვილებული გამგზავნებისგან დღეს. მხოლოდ ტექსტი: დანართები არ იხსნება და პასუხი ამას ამბობს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ក្នុងចំណោម %2$@ ពីអ្នក និងអ្នកផ្ញើដែលបានផ្គូផ្គងថ្ងៃនេះ។ អត្ថបទតែប៉ុណ្ណោះ៖ ឯកសារភ្ជាប់មិនត្រូវបានបើកទេ ហើយចម្លើយនិយាយដូច្នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 나와 등록된 발신자에게서 %2$@건 중 %1$@건. 텍스트만 받습니다: 첨부 파일은 열지 않으며, 답장에서 그렇게 알립니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ຈາກ %2$@ ຈາກທ່ານ ແລະ ຜູ້ສົ່ງທີ່ຈັບຄູ່ໃນມື້ນີ້. ຂໍ້ຄວາມເທົ່ານັ້ນ: ໄຟລ໌ແນບບໍ່ຖືກເປີດ, ແລະ ຄຳຕອບບອກແນວນັ້ນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien: %1$@ iš %2$@ – iš jūsų ir susietų siuntėjų. Tik tekstas: priedai neatidaromi, ir atsakyme tai pasakoma."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šodien %1$@ no %2$@ no tevis un pārī savienotajiem sūtītājiem. Tikai teksts: pielikumi netiek atvērti, un atbildē tas ir pateikts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ од %2$@ од тебе и спарени испраќачи денес. Само текст: прилозите не се отвораат, а одговорот го кажува тоа."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өнөөдөр таны болон хослуулсан илгээгчдийн %2$@-аас %1$@. Зөвхөн текст: хавсралтыг нээдэггүй бөгөөд хариу үүнийг хэлнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आज तपाईं र जोडिएका पठाउनेहरूबाट %2$@ मध्ये %1$@। केवल पाठ: संलग्नहरू खोलिँदैनन्, र जवाफले यो भन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van %2$@ van jou en gekoppelde afzenders vandaag. Alleen tekst: bijlagen worden niet geopend, en het antwoord zegt dat."
