    "taf.remove.not_finished_after": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Tamamlanmadı: onun %2$@ silinə bilmədi. tafs hər yenilənəndə yenidən cəhd edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Не е завършено: %2$@ не можаха да бъдат премахнати. tafs опитва отново при всяко опресняване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Nedokončeno: jeho %2$@ se nepodařilo odstranit. tafs to zkusí znovu při každém obnovení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Nicht abgeschlossen, nicht entfernt: %2$@. tafs versucht es bei jeder Aktualisierung erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Not finished: its %2$@ couldn't be removed. tafs tries again each time it refreshes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Sin terminar: no se pudo eliminar su %2$@. tafs lo vuelve a intentar cada vez que se actualiza."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Pooleli: neid ei õnnestunud eemaldada: %2$@. tafs proovib uuesti iga värskendusega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Non terminé : éléments non supprimés : %2$@. tafs réessaie à chaque actualisation."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Nije dovršeno: nije bilo moguće ukloniti: %2$@. tafs pokušava ponovno svaki put kad se osvježi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Nincs befejezve: ezt nem sikerült eltávolítani: %2$@. A tafs minden frissítéskor újra megpróbálja."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Չավարտվեց․ նրա %2$@-ը չկարողացավ հեռացվել։ tafs-ը նորից կփորձի ամեն թարմացման ժամանակ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Belum selesai: %2$@ tidak dapat dihapus. tafs mencoba lagi setiap kali menyegarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Non completato: non è stato possibile rimuovere %2$@. tafs riprova a ogni aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 完了していません：%2$@を削除できませんでした。tafsは更新のたびに再試行します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ არ დასრულდა: მისი %2$@ ვერ ამოიღო. tafs ცდის ხელახლა ყოველ განახლებაზე."
