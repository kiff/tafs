    "sample.bill_pay.job": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezahle routinemäßige Lieferantenrechnungen, die zu einer Bestellung passen. Nur bestehende Lieferanten. Ändere nie Bankdaten und füge keinen Zahlungsempfänger hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay routine vendor bills that match a purchase order. Existing vendors only. Never change bank details or add a payee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga facturas habituales de proveedores que coincidan con una orden de compra. Solo proveedores existentes. Nunca cambies datos bancarios ni añadas un beneficiario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payer les factures courantes des fournisseurs qui correspondent à un bon de commande. Fournisseurs existants uniquement. Ne jamais modifier les coordonnées bancaires ni ajouter de bénéficiaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga le fatture ordinarie dei fornitori che corrispondono a un ordine d'acquisto. Solo fornitori esistenti. Non cambiare mai le coordinate bancarie e non aggiungere beneficiari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaal gewone leveranciersrekeningen die bij een inkooporder passen. Alleen bestaande leveranciers. Wijzig nooit bankgegevens en voeg nooit een begunstigde toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłacaj rutynowe faktury dostawców zgodne z zamówieniem. Tylko istniejący dostawcy. Nigdy nie zmieniaj danych bankowych ani nie dodawaj odbiorcy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar faturas habituais de fornecedores que correspondam a uma nota de encomenda. Só fornecedores existentes. Nunca alterar dados bancários nem adicionar um beneficiário."
          }
        }
      }
    },
