    "voice.no_microphone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ tafs باستخدام الميكروفون للإملاء. يتحوّل صوتك إلى نص على هذا الهاتف ولا يُرسل إلى أي مكان."
          }
