          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odložišče se po prilepljanju počisti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kujtesa e kopjimit pastrohet pasi të ngjitni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Privremenu memoriju se briše nakon šta nalepite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิปบอร์ดจะถูกล้างหลังจากคุณวาง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Goýanyňyzdan soň alyş-çalyş buferi arassalanýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
