    "alert.sound_words": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız saxlama və ya dondurma üçün"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само за задържане или спиране"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen pro zadržení nebo zastavení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur beim Zurückhalten oder Anhalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a hold or a halt only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para una retención o un bloqueo"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainult kinnipidamise või peatamise korral"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour un appel retenu ou un blocage"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo za zadržavanje ili blokiranje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak visszatartásnál vagy leállításnál"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն պահման կամ կանգնեցման համար"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk penahanan atau pembekuan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per una trattenuta o un blocco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留または遮断のときだけ"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მხოლოდ დაკავებისთვის ან გაჩერებისთვის"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류나 차단일 때만"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik sulaikius ar sustabdžius"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikai aizturēšanai vai apturēšanai"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen bij vasthouden of stilzetten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko przy oczekującym wywołaniu lub blokadzie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para uma retenção ou um bloqueio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para uma retenção ou um bloqueio"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pentru o reținere sau o oprire"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len pre pozdržanie alebo zastavenie"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo za zadržanje ali ustavitev"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetëm për një mbajtje ose një bllokim"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo za zadržavanje ili blokiranje"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเมื่อมีการพักหรือการระงับ"
