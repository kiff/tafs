    "alert.alerts_almost_tafs_cloud_did": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind fast an: tafs cloud hat nicht geantwortet (%1$@). Tippe erneut auf „Benachrichtigungen einschalten“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts are almost on: tafs cloud didn't answer (%1$@). Tap Turn on alerts again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas están casi activadas: tafs cloud no respondió (%1$@). Toca Activar alertas otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sont presque activées : tafs cloud n'a pas répondu (%1$@). Touchez à nouveau Activer les alertes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi sono quasi attivi: tafs cloud non ha risposto (%1$@). Tocca di nuovo Attiva avvisi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan bijna aan: tafs cloud antwoordde niet (%1$@). Tik nogmaals op Meldingen aanzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty są prawie włączone: tafs cloud nie odpowiedział (%1$@). Dotknij ponownie Włącz alerty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas estão quase ativos: o tafs cloud não respondeu (%1$@). Toque novamente em Ativar alertas."
          }
        }
      }
    },
    "alert.all_halted": {
