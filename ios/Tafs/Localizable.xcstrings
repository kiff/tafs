    "settings.devices.pair_gives_view": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ taf-larınızı göstərəcək və təsdiqləri bu telefona göndərəcək."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ще показва вашите tafs и ще изпраща одобренията към този телефон."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bude zobrazovat vaše tafy a posílat schválení do tohoto telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zeigt deine tafs und schickt Genehmigungen an dieses Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will show your tafs and send approvals to this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mostrará tus tafs y enviará las aprobaciones a este teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ näitab sinu tafisid ja saadab kinnitused sellesse telefoni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ affichera vos tafs et enverra les approbations à ce téléphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređaj %1$@ prikazivat će vaše tafove i slati odobrenja na ovaj telefon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ megjeleníti a tafjaidat, és a jóváhagyásokat erre a telefonra küldi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը ցույց կտա ձեր taf-երը և հաստատումները կուղարկի այս հեռախոսին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ akan menampilkan tafs Anda dan mengirim persetujuan ke ponsel ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mostrerà i tuoi tafs e invierà le approvazioni a questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@にtafsが表示され、承認はこのスマートフォンに送られます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ აჩვენებს თქვენს taf-ებს და დამტკიცებებს ამ ტელეფონს გაუგზავნის."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 tafs가 표시되고, 승인 요청은 이 휴대폰으로 보내집니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rodys jūsų taf ir siųs patvirtinimus į šį telefoną."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rādīs tavus taf un sūtīs apstiprinājumus uz šo tālruni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ toont je tafs en stuurt goedkeuringen naar deze telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ będzie pokazywać Twoje tafs i wysyłać zatwierdzenia na ten telefon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vai mostrar os seus tafs e enviar as aprovações para este telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vai mostrar os seus tafs e enviar as aprovações para este telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ va afișa tafurile dvs. și va trimite aprobările către acest telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bude zobrazovať vaše tafy a posielať schválenia do tohto telefónu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bo prikazoval vaše tafe in pošiljal odobritve v ta telefon."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ do të shfaqë tafs-et tuaj dhe do t'i dërgojë miratimet te ky telefon."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređaj %1$@ prikazivat će vaše tafove i slati odobrenja na ovaj telefon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จะแสดง taf ของคุณและส่งการอนุมัติไปยังโทรศัพท์เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, tafs'larınızı gösterecek ve onayları bu telefona gönderecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sẽ hiển thị các taf của bạn và gửi các phê duyệt tới điện thoại này."
