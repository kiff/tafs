    "coach.ask_anything_line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهّز taf جديدًا، أو اربط تطبيقًا، أو غيّر طريقة عمل أحدها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni taf qurun, tətbiq qoşun və ya birinin necə işlədiyini dəyişin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте нов taf, свържете приложение или променете как работи някой."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন taf সেট আপ করুন, একটি অ্যাপ সংযুক্ত করুন, বা কোনোটির কাজের ধরন বদলান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un taf nou, connecta una aplicació o canvia com en funciona un."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte nový taf, připojte aplikaci nebo změňte, jak některý funguje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte einen neuen taf ein, verbinde eine App oder ändere, wie einer arbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up a new taf, connect an app, or change how one works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un taf nuevo, conecta una app o cambia cómo funciona uno."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadista uus taf, ühenda rakendus või muuda, kuidas mõni taf töötab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez un nouveau taf, connectez une app ou changez le fonctionnement d'un taf."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להגדיר taf חדש, לחבר אפליקציה, או לשנות איך אחד עובד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया taf बनाएँ, कोई ऐप जोड़ें, या किसी के काम करने का तरीका बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite novi taf, povežite aplikaciju ili promijenite kako jedan radi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állíts be egy új tafot, csatlakoztass egy alkalmazást, vagy módosítsd, hogyan működik egy taf."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարգավորեք նոր taf, միացրեք հավելված կամ փոխեք, թե ինչպես է աշխատում մեկը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapkan taf baru, hubungkan aplikasi, atau ubah cara kerja salah satunya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un nuovo taf, collega un'app o cambia come funziona un taf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいtafの設定、アプリの接続、tafの動作の変更ができます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დააყენეთ ახალი taf, დააკავშირეთ აპი, ან შეცვალეთ, როგორ მუშაობს ერთი."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រៀបចំ taf ថ្មី ភ្ជាប់កម្មវិធី ឬផ្លាស់ប្តូររបៀបដែលមួយដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 taf를 설정하거나, 앱을 연결하거나, taf의 작동 방식을 바꾸세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕັ້ງ taf ໃໝ່, ເຊື່ອມຕໍ່ແອັບ ຫຼື ປ່ຽນວິທີທີ່ມັນເຮັດວຽກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nustatykite naują taf, prijunkite programėlę arba pakeiskite, kaip jis dirba."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iestati jaunu taf, pievieno lietotni vai maini, kā kāds strādā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постави нов taf, поврзи апликација или промени како работи еден."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэ taf тохируулах, апп холбох, эсвэл нэгийнх нь ажиллах байдлыг өөрчлөх."
          }
        },
        "ne": {
