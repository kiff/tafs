    "billing.play_cant_sell": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play kann auf diesem Telefon nichts verkaufen, daher kann hier nichts gekauft werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play can't sell on this phone, so nothing can be bought here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play no puede vender en este teléfono, así que aquí no se puede comprar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play ne peut pas vendre sur ce téléphone : rien ne peut être acheté ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play non può vendere su questo telefono, quindi qui non si può acquistare nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play kan op deze telefoon niet verkopen, dus hier kan niets worden gekocht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play nie może sprzedawać na tym telefonie, więc nic nie można tu kupić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Google Play não pode vender neste telefone, por isso não é possível comprar nada aqui."
          }
        }
      }
