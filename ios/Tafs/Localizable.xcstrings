          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās nolasīt šīs versijas Card. %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon de Card van deze versie niet lezen. %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać Card tej wersji. %1$@"
          }
        },
        "pt": {
