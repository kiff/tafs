    "sample.reply.more_room": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Özümə daha çox yer verə bilmərəm: bunu yalnız siz, Card-ımı dəyişərək edə bilərsiniz. Ondan artıq hər şey «Sizi gözləyir» bölməsində sizi gözləyir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не мога сам да си дам повече лимит: само вие можете, като промените моята Card. Всичко над нея ви чака в „Чака ви“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Víc prostoru si dát nemůžu: to můžete jen vy, změnou mé Card. Cokoli nad ni na vás čeká v Čeká na vás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann mir selbst keinen weiteren Spielraum geben: Nur du kannst das, indem du meine Card änderst. Alles darüber wartet unter „Braucht dich“ auf dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't give myself more room: only you can, by changing my Card. Anything over it waits for you in Needs you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedo darme más margen: solo tú puedes, cambiando mi Card. Todo lo que lo supere te espera en Te necesita."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma ei saa endale rohkem ruumi anda: seda saad teha ainult sina, muutes minu Cardi. Kõik, mis seda ületab, ootab sind vaates Vajab sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne peux pas me donner plus de marge : vous seul le pouvez, en modifiant ma Card. Tout ce qui la dépasse vous attend dans Vous attend."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne mogu si sam dati više prostora: samo vi možete, promjenom mog Carda. Sve iznad toga čeka vas u Čeka vas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem adhatok magamnak nagyobb keretet: csak te, a Cardom módosításával. Ami túllépi, az a Rád vár részben vár rád."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ես չեմ կարող ինձ ավելի շատ տարածք տալ․ միայն դուք կարող եք՝ փոխելով իմ Card-ը։ Դրանից ավելին սպասում է ձեզ «Սպասում է ձեզ» բաժնում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya tidak dapat memberi diri saya ruang lebih: hanya Anda yang bisa, dengan mengubah Card saya. Apa pun di atasnya menunggu Anda di Menunggu Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non posso darmi più margine: puoi farlo solo tu, modificando la mia Card. Tutto ciò che la supera ti aspetta in Ti aspetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で範囲を広げることはできません。広げられるのは、Cardを変更するあなただけです。範囲を超えることは要確認で待ちます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თავს მეტ სივრცეს ვერ მივცემ: მხოლოდ თქვენ შეგიძლიათ, ჩემი Card-ის შეცვლით. მის გადამეტებულს თქვენ გელოდებათ განყოფილებაში „გელოდებათ“."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저 스스로 범위를 넓힐 수는 없습니다. 직접 Card를 바꾸셔야만 넓힐 수 있습니다. 범위를 넘는 일은 확인 필요에서 기다립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Negaliu sau suteikti daugiau rezervo: tai galite tik jūs, pakeisdami mano Card. Viskas, kas viršija jos ribas, laukia jūsų skiltyje „Laukia jūsų“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Es nevaru sev dot vairāk rezerves: to vari tikai tu, mainot manu Card. Viss, kas to pārsniedz, gaida tevi sadaļā “Gaida tevi”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kan mezelf geen extra ruimte geven: alleen jij kunt dat, door mijn Card te wijzigen. Alles daarboven wacht op je in Wacht op jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogę dać sobie więcej zapasu: możesz to zrobić tylko Ty, zmieniając moją Card. Wszystko ponad nią czeka na Ciebie w sekcji Czeka na Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não posso dar-me mais margem: só você pode, alterando o meu Card. Tudo o que o exceda aguarda por si em Precisa de si."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não posso me dar mais margem: só você pode, alterando o meu Card. Tudo o que passar dele aguarda por você em Precisa de você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu îmi pot da singur mai mult spațiu: doar dvs. puteți, schimbându-mi Cardul. Orice îl depășește vă așteaptă în Vă așteaptă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Viac priestoru si dať nemôžem: to môžete len vy, zmenou mojej Card. Čokoľvek nad ňu na vás čaká v Čaká na vás."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Več prostora si ne morem dati: to lahko storite samo vi, s spremembo moje Card. Vse, kar jo presega, čaka na vas v Čaka na vas."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuk mund t'i jap vetes më shumë hapësirë: vetëm ju mundeni, duke ndryshuar Card-in tim. Çdo gjë përtej tij pret ju te Ju pret."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne mogu si sam dati više prostora: samo vi možete, promenom mog Carda. Sve iznad toga čeka vas u Čeka vas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันให้พื้นที่เพิ่มกับตัวเองไม่ได้ มีเพียงคุณที่ทำได้ โดยเปลี่ยน Card ของฉัน สิ่งที่เกินกว่านั้นจะรอคุณในรอคุณอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendime daha fazla pay veremem: yalnızca siz verebilirsiniz, Card'ımı değiştirerek. Bunun ötesindeki her şey Sizi bekliyor'da sizi bekler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi không thể tự cho mình thêm phạm vi: chỉ bạn mới làm được, bằng cách đổi Card của tôi. Mọi việc vượt quá nó sẽ chờ bạn trong Đang chờ bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我無法替自己爭取更多空間：只有您能做到，方法是變更我的 Card。任何超出範圍的事項，都會在「等您處理」中等您。"
          }
        }
      }
    },
    "sample.reply.note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "(Nümunə cavab. KIFF ilə daxil olduqda taf-ınız həqiqətən cavab verir.)"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "(Примерен отговор. Когато сте влезли с KIFF, вашият taf отговаря наистина.)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "(Ukázková odpověď. Po přihlášení přes KIFF odpovídá váš taf doopravdy.)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(Beispielantwort. Mit KIFF angemeldet antwortet dein taf wirklich.)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(Sample reply. Signed in with KIFF, your taf answers for real.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(Respuesta de ejemplo. Con la sesión iniciada en KIFF, tu taf responde de verdad.)"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "(Näidisvastus. KIFFiga sisse logides vastab sinu taf päriselt.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(Réponse d'exemple. Connecté avec KIFF, votre taf répond pour de vrai.)"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "(Primjer odgovora. Prijavljeni KIFF-om, vaš taf odgovara stvarno.)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "(Mintaválasz. A KIFF-fel bejelentkezve a tafod valóban válaszol.)"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "(Օրինակելի պատասխան։ KIFF-ով մուտք գործելիս ձեր taf-ը իսկապես պատասխանում է։)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "(Balasan contoh. Saat masuk dengan KIFF, taf Anda menjawab sungguhan.)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "(Risposta di esempio. Con l'accesso a KIFF, il tuo taf risponde davvero.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（サンプルの返信です。KIFFでサインインすると、tafが実際に回答します。）"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "(ნიმუშის პასუხი. KIFF-ით შესვლისას თქვენი taf სინამდვილეში პასუხობს.)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(샘플 답장입니다. KIFF로 로그인하면 taf가 실제로 답합니다.)"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "(Pavyzdinis atsakymas. Prisijungus su KIFF, jūsų taf atsako iš tikrųjų.)"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "(Parauga atbilde. Kad pierakstīsies ar KIFF, tavs taf atbildēs pa īstam.)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "(Voorbeeldantwoord. Ingelogd met KIFF antwoordt je taf echt.)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "(Przykładowa odpowiedź. Po zalogowaniu przez KIFF Twój taf odpowiada naprawdę.)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "(Resposta de exemplo. Com sessão iniciada no KIFF, o seu taf responde a sério.)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "(Resposta de exemplo. Com login feito no KIFF, o seu taf responde de verdade.)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "(Răspuns exemplu. Conectat cu KIFF, taful dvs. răspunde cu adevărat.)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "(Ukážková odpoveď. Po prihlásení cez KIFF odpovedá váš taf naozaj.)"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "(Vzorčni odgovor. Ko se prijavite s KIFF, vaš taf odgovarja zares.)"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "(Përgjigje shembull. Kur keni hyrë me KIFF, taf-i juaj përgjigjet vërtet.)"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "(Primer odgovora. Prijavljeni KIFF-om, vaš taf odgovara stvarno.)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "(คำตอบตัวอย่าง เมื่อเข้าสู่ระบบด้วย KIFF taf ของคุณจะตอบจริง)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "(Örnek yanıt. KIFF ile oturum açtığınızda taf'ınız gerçekten yanıt verir.)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "(Phản hồi mẫu. Khi đăng nhập bằng KIFF, taf của bạn trả lời thật.)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（範例回覆。以 KIFF 登入後，您的 taf 會實際回覆。）"
          }
        }
      }
    },
    "sample.reply.nothing_done": {
