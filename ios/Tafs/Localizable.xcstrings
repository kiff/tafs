    "sign_in.ios_did_not_open_sign": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat die Anmeldeseite nicht geöffnet (Fehler %1$@; %2$@). Versuch es erneut, während tafs geöffnet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS didn't open the sign-in page (error %1$@; %2$@). Try again with tafs open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no abrió la página de inicio de sesión (error %1$@; %2$@). Vuelve a intentarlo con tafs abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n'a pas ouvert la page de connexion (erreur %1$@ ; %2$@). Réessayez avec tafs ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non ha aperto la pagina di accesso (errore %1$@; %2$@). Riprova con tafs aperta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS heeft de inlogpagina niet geopend (fout %1$@; %2$@). Probeer het opnieuw met tafs geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS nie otworzył strony logowania (błąd %1$@; %2$@). Spróbuj ponownie przy otwartym tafs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não abriu a página de início de sessão (erro %1$@; %2$@). Tente novamente com o tafs aberto."
          }
        }
      }
    },
    "sign_in.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs handeln unter KIFF-Cards. Genehmige dieses %1$@ in KIFF, und die Cards, die du ausgestellt hast, erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tafs act under KIFF Cards. Approve this %1$@ in KIFF, and the Cards you issued show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tafs actúan con Cards de KIFF. Aprueba este %1$@ en KIFF y aquí aparecerán las Cards que emitiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tafs agissent sous des Cards KIFF. Approuvez cet %1$@ dans KIFF, et les Cards que vous avez émises s'affichent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tafs agiscono con le Card di KIFF. Approva questo %1$@ in KIFF, e le Card che hai emesso compaiono qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tafs handelen onder KIFF-Cards. Je kunt deze %1$@ goedkeuren in KIFF, waarna de Cards die je hebt uitgegeven hier verschijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje tafs działają w ramach Card KIFF. Zatwierdź to urządzenie (%1$@) w KIFF, a wydane przez Ciebie Card pojawią się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs agem ao abrigo de Cards do KIFF. Aprove este %1$@ no KIFF, e os Cards que emitiu aparecem aqui."
          }
        }
      }
    },
    "sign_in.not_signed_out": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei KIFF noch nicht abgemeldet. Versuch es erneut oder melde dieses Telefon über „Geräte“ auf einem anderen Gerät ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed out at KIFF yet. Try again, or sign this phone out from another device's Devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha cerrado la sesión en KIFF. Vuelve a intentarlo, o cierra la sesión de este teléfono desde Dispositivos en otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore déconnecté de KIFF. Réessayez, ou déconnectez ce téléphone depuis Appareils sur un autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora disconnesso da KIFF. Riprova, o disconnetti questo telefono da Dispositivi su un altro dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet uitgelogd bij KIFF. Probeer het opnieuw, of log deze telefoon uit via Apparaten op een ander apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie wylogowano w KIFF. Spróbuj ponownie albo wyloguj ten telefon z sekcji Urządzenia na innym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem sessão terminada no KIFF. Tente novamente, ou termine a sessão deste telefone em Dispositivos noutro dispositivo."
          }
        }
