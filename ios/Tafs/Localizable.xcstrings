    "coach.ask_anything_line": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni taf qurun, tətbiq qoşun və ya birinin necə işlədiyini dəyişin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте нов taf, свържете приложение или променете как работи някой."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte nový taf, připojte aplikaci nebo změňte, jak některý funguje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte einen neuen taf ein, verbinde eine App oder ändere, wie einer arbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up a new taf, connect an app, or change how one works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un taf nuevo, conecta una app o cambia cómo funciona uno."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadista uus taf, ühenda rakendus või muuda, kuidas mõni taf töötab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez un nouveau taf, connectez une app ou changez le fonctionnement d'un taf."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite novi taf, povežite aplikaciju ili promijenite kako jedan radi."
