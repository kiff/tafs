    "knob.event_changed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hadisə dəyişdi. O, indiki halda yenidən göstərilir: onu təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това събитие се промени. Показано е отново, както е сега: одобрете него."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato událost se změnila. Znovu se ukazuje tak, jak je teď: schvalte tuto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Ereignis hat sich geändert. Es wird so angezeigt, wie es jetzt ist: Genehmige dieses."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This event changed. It's shown again as it is now: approve that one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este evento cambió. Se muestra de nuevo tal como está ahora: aprueba ese."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See sündmus muutus. Seda näidatakse uuesti praegusel kujul: kinnita see."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet événement a changé. Il s'affiche à nouveau tel qu'il est maintenant : approuvez celui-ci."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj se događaj promijenio. Prikazan je ponovno onakav kakav je sada: odobrite taj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az esemény megváltozott. Újra a mostani állapotában látszik: azt hagyd jóvá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս իրադարձությունը փոխվել է։ Այն նորից ցուցադրվում է ինչպես հիմա է․ հաստատեք այդ մեկը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peristiwa ini berubah. Ditampilkan lagi seperti sekarang: setujui yang itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo evento è cambiato. Viene mostrato di nuovo com'è ora: approva quello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このイベントは変更されました。現在の内容で再表示しているので、そちらを承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოვლენა შეიცვალა. ის ხელახლა ნაჩვენებია ისე, როგორიც ახლაა: დაამტკიცეთ ის."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이벤트가 바뀌었습니다. 현재 상태로 다시 표시되니, 그것을 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis įvykis pasikeitė. Jis vėl rodomas toks, koks yra dabar: patvirtinkite jį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis notikums mainījās. Tas ir parādīts vēlreiz tāds, kāds tas ir tagad: apstiprini to."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit event is gewijzigd. Het wordt opnieuw getoond zoals het nu is: keur dat goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zdarzenie się zmieniło. Jest pokazane ponownie w obecnej postaci: zatwierdź je."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este evento mudou. É mostrado novamente como está agora: aprove esse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este evento mudou. É mostrado novamente como está agora: aprove esse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest eveniment s-a schimbat. Este afișat din nou așa cum e acum: aprobați-l pe acesta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto udalosť sa zmenila. Znova sa ukazuje tak, ako je teraz: schváľte túto."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta dogodek se je spremenil. Znova je prikazan, kakršen je zdaj: odobrite tega."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo ngjarje ndryshoi. Shfaqet sërish siç është tani: miratoni atë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj se događaj promenio. Prikazan je ponovo onakav kakav je sada: odobrite taj."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหตุการณ์นี้เปลี่ยนไป แสดงอีกครั้งตามที่เป็นอยู่ตอนนี้: อนุมัติฉบับนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu olay değişti. Şimdiki haliyle yeniden gösteriliyor: onu onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự kiện này đã thay đổi. Nó được hiện lại như hiện tại: hãy phê duyệt bản đó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此事件已變更。已依目前狀況重新顯示：請核准該版本。"
          }
        }
      }
    },
    "knob.event_changed_read_dial_again": {
