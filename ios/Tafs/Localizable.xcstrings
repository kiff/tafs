        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses %1$@ funktioniert für dein Konto nicht mehr, bis du dich erneut anmeldest. Deine tafs arbeiten weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ stops working for your account until you sign in again. Your tafs keep working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ deja de funcionar para tu cuenta hasta que vuelvas a iniciar sesión. Tus tafs siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet %1$@ cesse de fonctionner pour votre compte jusqu'à ce que vous vous reconnectiez. Vos tafs continuent de travailler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo %1$@ smette di funzionare per il tuo account finché non accedi di nuovo. I tuoi tafs continuano a lavorare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %1$@ werkt niet meer voor je account tot je opnieuw inlogt. Je tafs blijven werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten %1$@ przestanie działać dla Twojego konta, dopóki nie zalogujesz się ponownie. Twoje tafs będą działać dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ deixa de funcionar para a sua conta até iniciar sessão novamente. Os seus tafs continuam a trabalhar."
          }
        }
      }
    },
