    "approval.security_key.pin_paused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind drei falsche PINs hintereinander. Zieh den Schlüssel ab, steck ihn wieder ein und versuch es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's three wrong PINs in a row. Unplug the key, plug it in again, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tres PIN incorrectos seguidos. Desconecta la llave, vuelve a conectarla y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolm valet PIN-koodi järjest. Eemalda võti, ühenda see uuesti ja proovi siis uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois codes PIN incorrects de suite. Débranchez la clé, rebranchez-la, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono tre PIN errati di fila. Scollega la chiave, ricollegala, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PINを3回続けて間違えました。キーを抜いて差し直してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN을 연속으로 세 번 틀렸습니다. 키를 뽑았다가 다시 꽂은 뒤 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tris kartus iš eilės įvestas neteisingas PIN. Atjunkite raktą, vėl jį prijunkite ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trīs nepareizi PIN pēc kārtas. Atvieno atslēgu, pievieno to vēlreiz, tad mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zijn drie verkeerde pincodes achter elkaar. Haal de sleutel eruit, steek hem er weer in en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To trzy złe PIN-y z rzędu. Odłącz klucz, podłącz go ponownie i spróbuj jeszcze raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São três PIN errados seguidos. Desligue a chave, volte a ligá-la e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São três PIN errados seguidos. Desconecte a chave, conecte-a novamente e tente novamente."
          }
        }
      }
    },
