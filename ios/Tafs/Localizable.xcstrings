          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "lõpeb %1$@, kui seda ei kasutata"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "prend fin le %1$@ si inutilisé"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "završava %1$@ ako se ne koristi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "véget ér: %1$@, ha nem használod"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "ավարտվում է %1$@-ին, եթե չօգտագործվի"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "berakhir %1$@ jika tidak dipakai"
