        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការតភ្ជាប់កំពុងស្តាប់ ប៉ុន្តែកុងតាក់មិនទាន់កត់ត្រាវានៅឡើយ។ អនុម័តម្តងទៀតដើម្បីកត់ត្រា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결은 수신 중이지만 다이얼에 아직 기록되지 않았습니다. 기록하려면 다시 승인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການເຊື່ອມຕໍ່ກຳລັງຟັງ ແຕ່ປຸ່ມໝຸນຍັງບໍ່ໄດ້ບັນທຶກມັນ. ອະນຸມັດອີກເພື່ອບັນທຶກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryšys klausosi, bet ratukas to dar neįrašė. Patvirtinkite dar kartą, kad tai būtų įrašyta."
