          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coachに届くのはあなたの言葉のテキストだけで、声は届きません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach თქვენს სიტყვებს იღებს ტექსტად, არასოდეს თქვენს ხმას."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach는 내 말을 음성이 아닌 텍스트로만 받습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach gauna jūsų žodžius kaip tekstą, niekada ne jūsų balsą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach saņem tavus vārdus kā tekstu, nekad tavu balsi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach krijgt je woorden als tekst, nooit je stem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dostaje Twoje słowa jako tekst, nigdy Twój głos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach recebe as suas palavras como texto, nunca a sua voz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach recebe as suas palavras como texto, nunca a sua voz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach primește cuvintele dvs. ca text, niciodată vocea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dostane vaše slová ako text, nikdy váš hlas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dobi vaše besede kot besedilo, nikoli vašega glasu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach i merr fjalët tuaja si tekst, kurrë zërin."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dobiva vaše reči kao tekst, nikad vaš glas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ได้รับถ้อยคำของคุณเป็นข้อความ ไม่เคยได้รับเสียงของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach sözlerinizi metin olarak alır, sesinizi asla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach nhận lời của bạn dưới dạng văn bản, không bao giờ nhận giọng nói."
          }
