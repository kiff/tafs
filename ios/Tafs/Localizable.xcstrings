    "usage.raised_unread": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-larınız davam edə bilər. Bu dövrün kreditləri bundan sonra oxuna bilmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите tafs могат да продължат. Кредитите за този период не можаха да бъдат прочетени оттогава."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy mohou pokračovat. Kredity za toto období se od té doby nepodařilo načíst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs können weiterarbeiten. Die Credits dieses Zeitraums konnten seitdem nicht gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tafs can go on. This period's credits couldn't be read since."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tafs pueden seguir. Desde entonces no se han podido leer los créditos de este periodo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tafid saavad jätkata. Selle perioodi krediite pole sellest ajast õnnestunud lugeda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tafs peuvent continuer. Les crédits de cette période n'ont pas pu être relus depuis."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafovi mogu nastaviti. Krediti ovog razdoblja od tada nisu mogli biti pročitani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafjaid folytathatják. Ennek az időszaknak a kreditjeit azóta nem sikerült beolvasni."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր taf-երը կարող են շարունակել։ Այս ժամանակահատվածի կրեդիտները այդ ժամանակից չկարողացան կարդացվել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs Anda dapat berlanjut. Kredit periode ini belum dapat dibaca sejak itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tafs possono continuare. Da allora non è stato possibile leggere i crediti di questo periodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsは引き続き動作できます。その後、今期のクレジットを読み込めていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი taf-ები შეიძლება გაგრძელდეს. ამ პერიოდის კრედიტები მას შემდეგ ვერ წაიკითხა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf는 계속 작동할 수 있습니다. 그 이후 이번 기간의 크레딧을 읽지 못했습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų taf gali dirbti toliau. Nuo tada šio laikotarpio kreditų nuskaityti nepavyko."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavi taf var turpināt. Šī perioda kredītus kopš tā laika nevarēja nolasīt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tafs kunnen verder. De credits van deze periode konden sindsdien niet worden gelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje tafs mogą działać dalej. Od tego czasu nie udało się odczytać kredytów z tego okresu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs podem continuar. Desde então, não foi possível ler os créditos deste período."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs podem continuar. Desde então, não foi possível ler os créditos deste período."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafurile dvs. pot continua. Creditele acestei perioade nu au mai putut fi citite de atunci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy môžu pokračovať. Kredity za toto obdobie sa odvtedy nepodarilo načítať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafi lahko nadaljujejo. Kreditov tega obdobja od takrat ni bilo mogoče prebrati."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs-et tuaj mund të vazhdojnë. Kreditet e kësaj periudhe nuk u lexuan dot që atëherë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafovi mogu nastaviti. Krediti ovog razdoblja od tada nisu mogli biti pročitani."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "taf ของคุณทำงานต่อได้ ยังอ่านเครดิตของรอบนี้ไม่ได้นับจากนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs'larınız devam edebilir. Bu dönemin kredileri o zamandan beri okunamadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tafs của bạn có thể tiếp tục. Tín dụng của kỳ này chưa đọc được kể từ đó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 taf 可以繼續運作。此後尚無法讀取本期的點數。"
          }
        }
      }
    },
