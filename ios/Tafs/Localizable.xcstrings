    "pair.passkey_why_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bleibt auf diesem %1$@, geschützt durch %2$@. Damit genehmigt dieser %1$@ die Aktionen deiner tafs, und nichts wird ohne dich genehmigt. Windows fragt als Nächstes nach deinem Gesicht, deinem Fingerabdruck oder deiner PIN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays on this %1$@, behind %2$@. With it, this %1$@ approves your tafs' actions, and nothing is approved without you. Windows asks for your face, fingerprint or PIN next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en este %1$@, protegida por %2$@. Con ella, este %1$@ aprueba las acciones de tus tafs, y nada se aprueba sin ti. A continuación, Windows te pedirá tu cara, tu huella o tu PIN."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See jääb sellesse seadmesse (%1$@), kaitstuna %2$@ abil. Sellega kinnitab see %1$@ sinu tafide toiminguid ja ilma sinuta ei kinnitata midagi. Järgmiseks küsib Windows sinu nägu, sõrmejälge või PIN-koodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle reste sur %3$@, protégée par %2$@. Avec elle, %3$@ approuve les actions de vos tafs, et rien n'est approuvé sans vous. Windows vous demande ensuite votre visage, votre empreinte digitale ou votre code PIN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta su questo %1$@, protetta da %2$@. Così questo %1$@ può approvare le azioni dei tuoi tafs, e nulla viene approvato senza di te. Poi Windows ti chiederà il volto, l'impronta digitale o il PIN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスキーは%2$@で保護され、この%1$@に保存されます。これにより、この%1$@でtafsの操作を承認でき、あなたなしで承認されることはありません。次にWindowsが顔、指紋、またはPINを求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패스키는 %2$@(으)로 보호되어 이 %1$@에 남습니다. 패스키가 있으면 이 %1$@에서 tafs의 행동을 승인하며, 내가 없으면 아무것도 승인되지 않습니다. 다음으로 Windows가 얼굴, 지문 또는 PIN을 요청합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jis lieka šiame įrenginyje (%1$@), apsaugotas: %2$@. Su juo šis įrenginys tvirtina jūsų taf veiksmus, ir niekas nepatvirtinama be jūsų. Toliau Windows paprašys jūsų veido, piršto atspaudo ar PIN."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā paliek šajā ierīcē (%1$@), aizsargāta ar %2$@. Ar to šis %1$@ apstiprina tavu taf darbības, un nekas netiek apstiprināts bez tevis. Tālāk Windows prasīs tavu seju, pirksta nospiedumu vai PIN."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij blijft op deze %1$@, beveiligd met %2$@. Daarmee keurt deze %1$@ de acties van je tafs goed, en niets wordt goedgekeurd zonder jou. Daarna vraagt Windows om je gezicht, vingerafdruk of pincode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaje na tym urządzeniu (%1$@), chroniony przez %2$@. Dzięki niemu to urządzenie zatwierdza działania Twoich tafs, a nic nie zostanie zatwierdzone bez Ciebie. Następnie Windows poprosi o twarz, odcisk palca lub PIN."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica neste %1$@, protegida pelo %2$@. Com ela, este %1$@ aprova as ações dos seus tafs, e nada é aprovado sem si. A seguir, o Windows pede o seu rosto, impressão digital ou PIN."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela fica neste %1$@, protegida por %2$@. Com ela, este %1$@ aprova as ações dos seus tafs, e nada é aprovado sem você. A seguir, o Windows pede o seu rosto, impressão digital ou PIN."
          }
        }
      }
    },
