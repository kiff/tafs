    "connect.other_connections_stay_connected_no": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Andere Verbindungen zu %1$@ bleiben verbunden. Nutzt keine andere Verbindung diese Anmeldung, wird sie bei %2$@ widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Other connections to %1$@ stay connected. If no other connection uses this sign-in, it's revoked at %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Las demás conexiones a %1$@ siguen conectadas. Si ninguna otra conexión usa este inicio de sesión, se revoca en %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les autres connexions à %1$@ restent connectées. Si aucune autre connexion n'utilise cet identifiant, il est révoqué chez %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Gli altri collegamenti a %1$@ restano collegati. Se nessun altro collegamento usa questo accesso, viene revocato su %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " Andere koppelingen met %1$@ blijven gekoppeld. Als geen andere koppeling deze login gebruikt, wordt die bij %2$@ ingetrokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Inne połączenia z %1$@ pozostaną połączone. Jeśli żadne inne połączenie nie używa tego logowania, zostanie ono unieważnione w %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " As outras ligações a %1$@ continuam ligadas. Se nenhuma outra ligação usar este início de sessão, é revogado em %2$@."
          }
        }
      }
    },
    "connect.profile_words_not_read": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
