    "approval.security_key.unplugged": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təhlükəsizlik açarı çıxarıldı, ona görə heç nə təsdiqlənmədi. Sorğu saxlanılıb: hazır olanda yenidən təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът за сигурност беше изваден, така че нищо не беше одобрено. Заявката се запазва: одобрете отново, когато сте готови."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostní klíč byl odpojen, takže se nic neschválilo. Žádost zůstává: schvalte znovu, až budete připraveni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sicherheitsschlüssel wurde abgezogen, also wurde nichts genehmigt. Die Anfrage bleibt erhalten: Genehmige erneut, wenn du so weit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The security key was unplugged, so nothing was approved. The request is kept: approve again when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llave de seguridad se desconectó, así que no se aprobó nada. La solicitud se conserva: vuelve a aprobar cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Turvavõti eemaldati, seega midagi ei kinnitatud. Päring jääb alles: kinnita uuesti, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de sécurité a été débranchée : rien n'a été approuvé. La demande est conservée : approuvez à nouveau quand vous êtes prêt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosni ključ je iskopčan pa ništa nije odobreno. Zahtjev je sačuvan: odobrite ponovno kad budete spremni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biztonsági kulcsot kihúzták, így semmi sem lett jóváhagyva. A kérés megmarad: hagyd jóvá újra, ha készen állsz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անվտանգության բանալին անջատվեց, ուստի ոչինչ չհաստատվեց։ Հարցումը պահպանվել է․ հաստատեք նորից, երբ պատրաստ լինեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci keamanan dicabut, jadi tidak ada yang disetujui. Permintaan tetap disimpan: setujui lagi saat Anda siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di sicurezza è stata scollegata, quindi non è stato approvato nulla. La richiesta resta: approva di nuovo quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティキーが抜かれたため、何も承認されていません。リクエストは保持されています。準備ができたらもう一度承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უსაფრთხოების გასაღები გამოეთიშა, ამიტომ არაფერი დამტკიცებულა. მოთხოვნა შენახულია: დაამტკიცეთ ხელახლა, როცა მზად იქნებით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 키가 뽑혀 승인된 것은 없습니다. 요청은 남아 있으니 준비되면 다시 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saugos raktas atjungtas, todėl niekas nepatvirtinta. Užklausa išsaugota: patvirtinkite dar kartą, kai būsite pasirengę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drošības atslēga tika atvienota, tāpēc nekas netika apstiprināts. Pieprasījums ir saglabāts: apstiprini vēlreiz, kad esi gatavs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beveiligingssleutel is eruit gehaald, dus er is niets goedgekeurd. Het verzoek blijft bewaard: keur het goed wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz bezpieczeństwa został odłączony, więc nic nie zostało zatwierdzone. Prośba zostaje zachowana: zatwierdź ją ponownie, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança foi desligada, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança foi desconectada, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia de securitate a fost scoasă, așa că nu s-a aprobat nimic. Solicitarea se păstrează: aprobați din nou când sunteți gata."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostný kľúč bol odpojený, takže sa nič neschválilo. Žiadosť zostáva: schváľte znova, keď budete pripravení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Varnostni ključ je bil izključen, zato ni bilo nič odobreno. Zahteva ostane: odobrite znova, ko boste pripravljeni."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çelësi i sigurisë u hoq, ndaj asgjë nuk u miratua. Kërkesa ruhet: miratoni sërish kur të jeni gati."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosni ključ je isključen, pa ništa nije odobreno. Zahtev je sačuvan: odobrite ponovo kad budete spremni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กุญแจความปลอดภัยถูกถอดออก จึงไม่มีอะไรถูกอนุมัติ คำขอยังอยู่: อนุมัติอีกครั้งเมื่อคุณพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik anahtarı çıkarıldı, bu yüzden hiçbir şey onaylanmadı. İstek korunuyor: hazır olduğunuzda tekrar onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa bảo mật đã bị rút ra nên không có gì được phê duyệt. Yêu cầu vẫn được giữ: hãy phê duyệt lại khi bạn sẵn sàng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全金鑰已被拔出，因此未核准任何項目。請求仍保留：準備好時再次核准。"
          }
        }
      }
    },
