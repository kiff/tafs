    "settings.time_zone.uses_this": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fristen zurückgehaltener Aufrufe, Aktivität, das Protokoll und was deine tafs schreiben nutzen diese Zeitzone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds' deadlines, Activity, the Record and what your tafs write use this time zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plazos de las retenciones, la Actividad, el Registro y lo que escriben tus tafs usan esta zona horaria."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinnipidamiste tähtajad, Tegevus, Logi ja see, mida sinu tafid kirjutavad, kasutavad seda ajavööndit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les échéances des appels retenus, l'Activité, le Registre et ce qu'écrivent vos tafs utilisent ce fuseau horaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scadenze delle trattenute, l'Attività, il Registro e ciò che scrivono i tuoi tafs usano questo fuso orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留の期限、アクティビティ、記録、tafsが書く内容にはこのタイムゾーンが使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류 기한, 활동, 기록, tafs가 쓰는 내용은 이 시간대를 사용합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulaikymų terminai, Veikla, Žurnalas ir tai, ką rašo jūsų taf, naudoja šią laiko juostą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aizturējumu termiņi, Aktivitāte, Žurnāls un tas, ko raksta tavi taf, izmanto šo laika joslu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines van vastgehouden aanroepen, Activiteit, het Logboek en wat je tafs schrijven gebruiken deze tijdzone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminy oczekujących wywołań, Aktywność, Rejestr i to, co piszą Twoje tafs, używają tej strefy czasowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os prazos das retenções, a Atividade, o Registo e o que os seus tafs escrevem usam este fuso horário."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os prazos das retenções, a Atividade, o Registro e o que os seus tafs escrevem usam este fuso horário."
          }
        }
      }
    },
    "settings.time_zone_offer.text_device": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fristen zurückgehaltener Aufrufe, Aktivität, das Protokoll und was deine tafs schreiben würden die Zeitzone auf diesem %1$@ nutzen. Dein Konto nutzt jetzt %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds' deadlines, Activity, the Record and what your tafs write would use this %3$@ time zone. Your account uses %2$@ now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plazos de las retenciones, la Actividad, el Registro y lo que escriben tus tafs usarían la zona horaria de este %1$@. Ahora tu cuenta usa %2$@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinnipidamiste tähtajad, Tegevus, Logi ja see, mida sinu tafid kirjutavad, kasutaksid selle seadme (%1$@) ajavööndit. Sinu konto kasutab praegu ajavööndit %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les échéances des appels retenus, l'Activité, le Registre et ce qu'écrivent vos tafs utiliseraient le fuseau horaire de %4$@. Votre compte utilise actuellement %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scadenze delle trattenute, l'Attività, il Registro e ciò che scrivono i tuoi tafs userebbero il fuso orario di questo %1$@. Ora il tuo account usa %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留の期限、アクティビティ、記録、tafsが書く内容に、この%1$@のタイムゾーンを使えます。現在のアカウントは%2$@を使っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류 기한, 활동, 기록, tafs가 쓰는 내용에 이 %1$@의 시간대를 사용합니다. 지금 계정은 %2$@을(를) 사용합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulaikymų terminai, Veikla, Žurnalas ir tai, ką rašo jūsų taf, naudotų šio įrenginio (%1$@) laiko juostą. Dabar jūsų paskyra naudoja %2$@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aizturējumu termiņi, Aktivitāte, Žurnāls un tas, ko raksta tavi taf, izmantotu šīs ierīces (%1$@) laika joslu. Tavs konts pašlaik izmanto %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines van vastgehouden aanroepen, Activiteit, het Logboek en wat je tafs schrijven zouden de tijdzone van deze %1$@ gebruiken. Je account gebruikt nu %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminy oczekujących wywołań, Aktywność, Rejestr i to, co piszą Twoje tafs, używałyby strefy czasowej tego urządzenia (%1$@). Twoje konto używa teraz %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os prazos das retenções, a Atividade, o Registo e o que os seus tafs escrevem passariam a usar o fuso horário deste %1$@. A sua conta usa agora %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os prazos das retenções, a Atividade, o Registro e o que os seus tafs escrevem passariam a usar o fuso horário deste %1$@. A sua conta usa agora %2$@."
          }
        }
      }
    },
