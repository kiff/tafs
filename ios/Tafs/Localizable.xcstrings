            "value": "tafs-аас асуухаасаа өмнө утсан дээрээ tafs-д хиймэл оюун ашиглахыг зөвшөөрнө үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs लाई सोध्नुअघि आफ्नो फोनमा tafs मा AI प्रयोगलाई अनुमति दिनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta eerst AI-gebruik toe in tafs op je telefoon voordat je tafs iets vraagt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
