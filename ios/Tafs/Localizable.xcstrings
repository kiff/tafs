    "chat.stopped.declined": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dayandı: süni intellekt davam etməkdən imtina etdi. Başqa cür soruşmağa çalışın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ спря: ИИ отказа да продължи. Опитайте да попитате по друг начин."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se zastavil: AI odmítla pokračovat. Zkuste se zeptat jinak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat gestoppt: Die KI hat es abgelehnt, fortzufahren. Versuch es anders zu formulieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stopped: the AI declined to continue. Try asking another way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detuvo: la IA se negó a continuar. Prueba a pedirlo de otra forma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lõpetas: tehisintellekt (AI) keeldus jätkamast. Proovi küsida teisiti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s'est arrêté : l'IA a refusé de continuer. Essayez de demander autrement."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf %1$@ se zaustavio: AI je odbio nastaviti. Pokušajte pitati na drugi način."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ leállt: az MI nem volt hajlandó folytatni. Próbáld másképp kérni."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը կանգ առավ․ AI-ը հրաժարվեց շարունակել։ Փորձեք հարցնել այլ կերպ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ berhenti: AI menolak melanjutkan. Coba bertanya dengan cara lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si è fermato: l'IA si è rifiutata di continuare. Prova a chiederlo in un altro modo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が停止しました：AIが続行を断りました。別の聞き方を試してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ გაჩერდა: AI-მ გაგრძელებაზე უარი თქვა. სცადეთ სხვანაირად ჰკითხოთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 멈췄습니다: AI가 계속하기를 거부했습니다. 다른 방식으로 요청해 보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sustojo: AI atsisakė tęsti. Pabandykite paklausti kitaip."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ apstājās: AI atteicās turpināt. Pamēģini pajautāt citādi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gestopt: de AI weigerde verder te gaan. Vraag het op een andere manier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatrzymał się: AI odmówiła kontynuowania. Spróbuj zapytać inaczej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: a IA recusou-se a continuar. Experimente pedir de outra forma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: a IA recusou-se a continuar. Experimente pedir de outra forma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s-a oprit: AI a refuzat să continue. Încercați să cereți altfel."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sa zastavil: AI odmietla pokračovať. Skúste sa opýtať inak."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se je ustavil: umetna inteligenca je zavrnila nadaljevanje. Poskusite vprašati drugače."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ u ndal: AI-ja refuzoi të vazhdojë. Provoni të pyesni ndryshe."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf %1$@ se zaustavio: AI je odbio nastaviti. Pokušajte pitati na drugi način."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ หยุดแล้ว: AI ปฏิเสธที่จะทำต่อ ลองถามด้วยวิธีอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ durdu: yapay zekâ devam etmeyi reddetti. Başka bir şekilde sormayı deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã dừng: AI từ chối tiếp tục. Hãy thử hỏi theo cách khác."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已停止：AI 拒絕繼續。請嘗試換個方式詢問。"
          }
        }
      }
    },
    "chat.stopped.out_of_room": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dayandı: cavabı yerə sığmadı. Daha qısa bir şey və ya hər dəfə bir hissə xahiş edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ спря: отговорът му не се побра. Поискайте нещо по-кратко или по една част наведнъж."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se zastavil: jeho odpovědi došlo místo. Požádejte o něco kratšího, nebo o jednu část najednou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat gestoppt: Seine Antwort hatte keinen Platz mehr. Bitte um etwas Kürzeres oder um einen Teil nach dem anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stopped: its reply ran out of room. Ask for something shorter, or for one part at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detuvo: su respuesta se quedó sin espacio. Pide algo más corto, o una parte cada vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lõpetas: selle vastusel sai ruum otsa. Küsi midagi lühemat või üks osa korraga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s'est arrêté : sa réponse a manqué de place. Demandez quelque chose de plus court, ou une partie à la fois."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf %1$@ se zaustavio: njegov je odgovor ostao bez prostora. Zatražite nešto kraće ili jedan dio po jedan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ leállt: a válaszának elfogyott a helye. Kérj valami rövidebbet, vagy egyszerre csak egy részt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը կանգ առավ․ նրա պատասխանի համար տեղը սպառվեց։ Խնդրեք ավելի կարճ, կամ մեկ մաս՝ մեկ անգամ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ berhenti: balasannya kehabisan ruang. Minta sesuatu yang lebih pendek, atau satu bagian sekali waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si è fermato: la sua risposta ha esaurito lo spazio. Chiedi qualcosa di più breve, o una parte alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が停止しました：返信が長すぎて収まりませんでした。短く頼むか、一部ずつ頼んでください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ გაჩერდა: მისი პასუხისთვის ადგილი ამოიწურა. მოითხოვეთ უფრო მოკლე, ან ერთხელ ერთი ნაწილი."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 멈췄습니다: 답변이 길이 한도를 넘었습니다. 더 짧게, 또는 한 부분씩 요청하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sustojo: jo atsakymui pritrūko vietos. Paprašykite ko nors trumpesnio arba po vieną dalį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ apstājās: tā atbildei pietrūka vietas. Palūdz kaut ko īsāku vai pa vienai daļai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gestopt: het antwoord had geen ruimte meer. Vraag om iets korters, of om één deel tegelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatrzymał się: w jego odpowiedzi zabrakło miejsca. Poproś o coś krótszego albo o jedną część naraz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: a resposta ficou sem espaço. Peça algo mais curto, ou uma parte de cada vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: a resposta ficou sem espaço. Peça algo mais curto, ou uma parte de cada vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s-a oprit: răspunsul său a rămas fără spațiu. Cereți ceva mai scurt sau câte o parte pe rând."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sa zastavil: jeho odpovedi došlo miesto. Požiadajte o niečo kratšie, alebo o jednu časť naraz."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se je ustavil: njegovemu odgovoru je zmanjkalo prostora. Prosite za nekaj krajšega ali za en del naenkrat."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ u ndal: përgjigjja e tij mbaroi vendin. Kërkoni diçka më të shkurtër, ose një pjesë një nga një."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf %1$@ se zaustavio: njegov je odgovor ostao bez prostora. Zatražite nešto kraće ili jedan dio po jedan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ หยุดแล้ว: คำตอบของมันเต็มพื้นที่ ขอให้สั้นลง หรือทีละส่วน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ durdu: yanıtının yeri kalmadı. Daha kısa bir şey veya her seferinde bir parça isteyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã dừng: phản hồi của nó hết chỗ. Hãy xin một câu ngắn hơn, hoặc từng phần một."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已停止：它的回覆超出長度上限。請要求更短的內容，或一次一個部分。"
          }
        }
      }
    },
