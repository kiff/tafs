    "version.card_note.removes": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während des Wechsels läuft dein taf nicht. Eine Bestätigung stellt diese Cards in KIFF aus und entfernt die, die diese Version nicht hat, dann geht diese Version live."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While it switches, your taf doesn't run. Confirming once issues these Cards in KIFF and removes the ones this version doesn't have, then this version goes live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras cambia, tu taf no se ejecuta. Al confirmar una vez se emiten estas Cards en KIFF y se eliminan las que esta versión no tiene, y luego esta versión se activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le changement, votre taf ne s'exécute pas. Une seule confirmation émet ces Cards dans KIFF et supprime celles que cette version n'a pas, puis cette version est mise en service."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante il passaggio, il tuo taf non lavora. Una sola conferma emette queste Card in KIFF e rimuove quelle che questa versione non ha, poi questa versione diventa attiva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens het overschakelen draait je taf niet. Eén keer bevestigen geeft deze Cards uit in KIFF en verwijdert de Cards die deze versie niet heeft, daarna gaat deze versie live."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas przełączania Twój taf nie działa. Jedno potwierdzenie wydaje te Card w KIFF i usuwa te, których ta wersja nie ma, a potem ta wersja zaczyna działać na żywo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a mudança, o seu taf não é executado. Confirmar uma vez emite estes Cards no KIFF e remove os que esta versão não tem, e depois esta versão entra em produção."
          }
        }
      }
    },
