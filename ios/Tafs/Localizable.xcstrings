    "alert.blocked.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا الجهاز (%1$@) يسأل، لذا فإن تنبيهات tafs متوقفة في الإعدادات. شغّلها هناك لتصلك الموافقات والإجابات."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz (%1$@) artıq soruşmur, buna görə tafs bildirişləri Ayarlarda söndürülüb. Təsdiqlər və cavablar sizə çatsın deyə onları orada aktiv edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този %1$@ вече не пита, затова известията за tafs са изключени в Настройки. Включете ги там, за да ви стигат одобренията и отговорите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই %1$@ আর জিজ্ঞাসা করে না, তাই সেটিংসে tafs-এর অ্যালার্ট বন্ধ আছে। অনুমোদন ও উত্তর যেন আপনার কাছে পৌঁছায়, সেজন্য সেখানে সেগুলো চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest dispositiu (%1$@) ja no ho pregunta, així que les alertes de tafs estan desactivades a Configuració. Activa-les allà perquè les aprovacions i les respostes t'arribin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento %1$@ se už neptá, takže upozornění pro tafs jsou v Nastavení vypnutá. Zapněte je tam, aby vám schválení a odpovědi chodily."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses %1$@ fragt nicht mehr, deshalb sind die Benachrichtigungen für tafs in den Einstellungen aus. Schalte sie dort ein, damit dich Genehmigungen und Antworten erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %1$@ no longer asks, so alerts for tafs are off in Settings. Turn them on there so approvals and answers reach you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ ya no pregunta, así que las alertas de tafs están desactivadas en Ajustes. Actívalas ahí para que las aprobaciones y respuestas te lleguen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See seade (%1$@) enam ei küsi, seega on tafsi teavitused seadetes välja lülitatud. Lülita need seal sisse, et kinnitused ja vastused jõuaksid sinuni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ne pose plus la question, donc les alertes de tafs sont désactivées dans Réglages. Activez-les là pour que les approbations et les réponses vous parviennent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתקן הזה (%1$@) כבר לא שואל, ולכן ההתראות של tafs כבויות בהגדרות. יש להפעיל אותן שם כדי שאישורים ותשובות יגיעו אליך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह %1$@ अब नहीं पूछता, इसलिए सेटिंग्स में tafs के अलर्ट बंद हैं। उन्हें वहाँ चालू करें ताकि मंज़ूरियाँ और जवाब आप तक पहुँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj %1$@ više ne pita, pa su obavijesti za tafs isključene u Postavkama. Uključite ih ondje kako bi odobrenja i odgovori stizali do vas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz (%1$@) már nem kérdez rá, ezért a tafs riasztásai ki vannak kapcsolva a Beállításokban. Kapcsold be őket ott, hogy a jóváhagyások és a válaszok eljussanak hozzád."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքը (%1$@) այլևս չի հարցնում, ուստի tafs-ի ծանուցումներն անջատված են Կարգավորումներում։ Միացրեք դրանք այնտեղ, որպեսզի հաստատումներն ու պատասխանները հասնեն ձեզ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ini tidak lagi bertanya, jadi peringatan untuk tafs nonaktif di Pengaturan. Aktifkan di sana agar persetujuan dan jawaban sampai ke Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo %1$@ non lo chiede più, quindi gli avvisi di tafs sono disattivati in Impostazioni. Attivali lì perché approvazioni e risposte ti raggiungano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%1$@ではもう確認されないため、設定でtafsの通知がオフになっています。承認や回答が届くよう、そこで通知をオンにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოწყობილობა (%1$@) აღარ გეკითხებათ, ამიტომ tafs-ის შეტყობინებები გამორთულია პარამეტრებში. ჩართეთ ისინი იქ, რომ დადასტურებები და პასუხები მოგივიდეთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ នេះលែងសួរទៀតហើយ ដូច្នេះការជូនដំណឹងសម្រាប់ tafs ត្រូវបានបិទក្នុងការកំណត់។ បើកវានៅទីនោះ ដើម្បីឱ្យការអនុម័ត និងចម្លើយទៅដល់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %1$@에서는 더 이상 묻지 않아 설정에서 tafs 알림이 꺼져 있습니다. 승인과 답변을 받으려면 설정에서 알림을 켜세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ນີ້ບໍ່ຖາມອີກແລ້ວ, ສະນັ້ນການແຈ້ງເຕືອນສຳລັບ tafs ຖືກປິດໃນການຕັ້ງຄ່າ. ເປີດມັນຢູ່ບ່ອນນັ້ນ ເພື່ອໃຫ້ການອະນຸມັດ ແລະ ຄຳຕອບມາຮອດທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis įrenginys (%1$@) daugiau nebeklausia, todėl tafs pranešimai nustatymuose išjungti. Įjunkite juos ten, kad patvirtinimai ir atsakymai jus pasiektų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī ierīce (%1$@) vairs nejautā, tāpēc tafs paziņojumi iestatījumos ir izslēgti. Ieslēdz tos tur, lai apstiprinājumi un atbildes tevi sasniegtu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој %1$@ повеќе не прашува, па известувањата за tafs се исклучени во Поставки. Вклучи ги таму за одобренијата и одговорите да стигнуваат до тебе."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ %1$@ дахин асуухгүй тул Тохиргоонд tafs-ын мэдэгдэл унтраастай байна. Зөвшөөрөл, хариулт танд ирэхийн тулд тэнд асаана уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो %1$@ ले अब सोध्दैन, त्यसैले सेटिङमा tafs को सूचना बन्द छ। स्वीकृति र जवाफ तपाईंसम्म आइपुगून् भनेर त्यहाँ खोल्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %1$@ vraagt het niet meer, dus meldingen voor tafs staan uit in Instellingen. Zet ze daar aan zodat goedkeuringen en antwoorden je bereiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten %1$@ już nie pyta, więc alerty tafs są wyłączone w Ustawieniach. Włącz je tam, aby zatwierdzenia i odpowiedzi do Ciebie docierały."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ já não pergunta, por isso os alertas do tafs estão desativados em Definições. Ative-os lá para que as aprovações e as respostas cheguem até si."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ não pergunta mais, por isso os alertas do tafs estão desativados em Ajustes. Ative-os lá para que as aprovações e as respostas cheguem até você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv (%1$@) nu mai întreabă, așa că alertele tafs sunt dezactivate în Configurări. Activați-le acolo ca aprobările și răspunsurile să ajungă la dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento %1$@ sa už nepýta, takže upozornenia pre tafs sú v Nastaveniach vypnuté. Zapnite ich tam, aby vám schválenia a odpovede chodili."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta %1$@ ne sprašuje več, zato so opozorila za tafs v Nastavitvah izklopljena. Vklopite jih tam, da bodo odobritve in odgovori prihajali do vas."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo pajisje (%1$@) nuk pyet më, ndaj njoftimet për tafs janë të çaktivizuara te Cilësimet. Aktivizojini atje që miratimet dhe përgjigjet t'ju arrijnë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj (%1$@) više ne pita, pa su obaveštenja za tafs isključena u Podešavanjima. Uključite ih tamo da bi odobrenja i odgovori stizali do vas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@เครื่องนี้ไม่ถามอีกแล้ว การแจ้งเตือนสำหรับ tafs จึงปิดอยู่ในการตั้งค่า เปิดที่นั่นเพื่อให้การอนุมัติและคำตอบมาถึงคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ indi soramaýar, şonuň üçin tafs duýduryşlary Sazlamalarda öçürilen. Tassyklamalar we jogaplar size ýetip gelsin diýip, olary şol ýerde açyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ cihazı artık sormuyor, bu yüzden tafs uyarıları Ayarlar'da kapalı. Onaylar ve yanıtlar size ulaşsın diye onları orada açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ %1$@ اب نہیں پوچھتا، اس لیے سیٹنگز میں tafs کے الرٹس بند ہیں۔ انہیں وہاں چالو کریں تاکہ منظوریاں اور جوابات آپ تک پہنچیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ này không hỏi nữa, nên cảnh báo cho tafs đang tắt trong Cài đặt. Hãy bật ở đó để phê duyệt và câu trả lời đến được với bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部%1$@不會再詢問，因此 tafs 的通知在「設定」中為關閉。請在那裡開啟，讓核准與回答傳到您手上。"
          }
        }
      }
    },
    "alert.blocked.body_android": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد Android يسأل، لذا فإن تنبيهات tafs متوقفة في إعدادات هاتفك. شغّلها هناك لتصلك الموافقات والإجابات على هذا الهاتف وعلى ساعتك. تصل التحديثات إلى ساعتك في كل الأحوال."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Android artıq soruşmur, buna görə tafs bildirişləri telefonunuzun ayarlarında söndürülüb. Təsdiqlər və cavablar bu telefona və saatınıza çatsın deyə onları orada aktiv edin. Saatınız yeniləmələrini hər halda alır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Android вече не пита, затова известията за tafs са изключени в настройките на телефона ви. Включете ги там, за да ви стигат одобренията и отговорите на този телефон и на часовника ви. Часовникът ви получава актуализациите си и без това."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Android আর জিজ্ঞাসা করে না, তাই আপনার ফোনের সেটিংসে tafs-এর অ্যালার্ট বন্ধ আছে। অনুমোদন ও উত্তর যেন এই ফোনে ও আপনার ঘড়িতে পৌঁছায়, সেজন্য সেখানে সেগুলো চালু করুন। আপনার ঘড়ি যেকোনোভাবেই আপডেট পায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ja no ho pregunta, així que les alertes de tafs estan desactivades a la configuració del telèfon. Activa-les allà perquè les aprovacions i les respostes t'arribin, en aquest telèfon i al rellotge. El rellotge rep les actualitzacions igualment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Android se už neptá, takže upozornění pro tafs jsou v nastavení telefonu vypnutá. Zapněte je tam, aby vám schválení a odpovědi chodily do tohoto telefonu i do hodinek. Hodinky dostávají aktualizace tak jako tak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android fragt nicht mehr, deshalb sind die Benachrichtigungen für tafs in den Einstellungen deines Telefons aus. Schalte sie dort ein, damit dich Genehmigungen und Antworten erreichen, auf diesem Telefon und auf deiner Uhr. Deine Uhr bekommt ihre Updates so oder so."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no longer asks, so alerts for tafs are off in your phone's settings. Turn them on there so approvals and answers reach you, on this phone and on your watch. Your watch gets its updates either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ya no pregunta, así que las alertas de tafs están desactivadas en los ajustes del teléfono. Actívalas ahí para que las aprobaciones y respuestas te lleguen, en este teléfono y en tu reloj. Tu reloj recibe sus actualizaciones de todos modos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Android enam ei küsi, seega on tafsi teavitused telefoni seadetes välja lülitatud. Lülita need seal sisse, et kinnitused ja vastused jõuaksid sinuni, selles telefonis ja kellas. Kell saab oma uuendused igal juhul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ne pose plus la question, donc les alertes de tafs sont désactivées dans les réglages du téléphone. Activez-les là pour que les approbations et les réponses vous parviennent, sur ce téléphone et sur votre montre. Votre montre reçoit ses mises à jour de toute façon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Android כבר לא שואל, ולכן ההתראות של tafs כבויות בהגדרות הטלפון. יש להפעיל אותן שם כדי שאישורים ותשובות יגיעו אליך, בטלפון הזה ובשעון. השעון מקבל את העדכונים שלו בכל מקרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android अब नहीं पूछता, इसलिए आपके फ़ोन की सेटिंग में tafs के अलर्ट बंद हैं। उन्हें वहाँ चालू करें ताकि मंज़ूरियाँ और जवाब इस फ़ोन पर और आपकी घड़ी पर पहुँचें। आपकी घड़ी को अपडेट हर हाल में मिलते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android više ne pita, pa su obavijesti za tafs isključene u postavkama telefona. Uključite ih ondje kako bi odobrenja i odgovori stizali do vas, na ovaj telefon i na sat. Sat ionako prima svoja ažuriranja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Android már nem kérdez rá, ezért a tafs riasztásai ki vannak kapcsolva a telefon beállításaiban. Kapcsold be őket ott, hogy a jóváhagyások és a válaszok eljussanak hozzád, ezen a telefonon és az órádon. Az órád így is megkapja a frissítéseit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-ն այլևս չի հարցնում, ուստի tafs-ի ծանուցումներն անջատված են ձեր հեռախոսի կարգավորումներում։ Միացրեք դրանք այնտեղ, որպեսզի հաստատումներն ու պատասխանները հասնեն ձեզ՝ այս հեռախոսին և ձեր ժամացույցին։ Ձեր ժամացույցն ամեն դեպքում ստանում է իր թարմացումները։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android tidak lagi bertanya, jadi peringatan untuk tafs nonaktif di pengaturan ponsel Anda. Aktifkan di sana agar persetujuan dan jawaban sampai ke Anda, di ponsel ini dan di jam tangan Anda. Jam tangan Anda tetap menerima pembaruannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non lo chiede più, quindi gli avvisi di tafs sono disattivati nelle impostazioni del telefono. Attivali lì perché approvazioni e risposte ti raggiungano, su questo telefono e sul tuo orologio. L'orologio riceve comunque i suoi aggiornamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Androidはもう確認しないため、スマートフォンの設定でtafsの通知がオフになっています。承認や回答がこのスマートフォンとウォッチに届くよう、そこで通知をオンにしてください。ウォッチはどちらの場合も更新を受け取ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Android აღარ გეკითხებათ, ამიტომ tafs-ის შეტყობინებები გამორთულია ტელეფონის პარამეტრებში. ჩართეთ ისინი იქ, რომ დადასტურებები და პასუხები მოგივიდეთ ამ ტელეფონზე და საათზე. საათი განახლებებს ნებისმიერ შემთხვევაში იღებს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Android លែងសួរទៀតហើយ ដូច្នេះការជូនដំណឹងសម្រាប់ tafs ត្រូវបានបិទក្នុងការកំណត់ទូរសព្ទរបស់អ្នក។ បើកវានៅទីនោះ ដើម្បីឱ្យការអនុម័ត និងចម្លើយទៅដល់អ្នក នៅលើទូរសព្ទនេះ និងនាឡិការបស់អ្នក។ នាឡិការបស់អ្នកនៅតែទទួលបានបច្ចុប្បន្នភាពរបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 더 이상 묻지 않아 휴대폰 설정에서 tafs 알림이 꺼져 있습니다. 승인과 답변이 이 휴대폰과 시계로 오도록 설정에서 알림을 켜세요. 시계는 어느 쪽이든 업데이트를 받습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ບໍ່ຖາມອີກແລ້ວ, ສະນັ້ນການແຈ້ງເຕືອນສຳລັບ tafs ຖືກປິດໃນການຕັ້ງຄ່າໂທລະສັບຂອງທ່ານ. ເປີດມັນຢູ່ບ່ອນນັ້ນ ເພື່ອໃຫ້ການອະນຸມັດ ແລະ ຄຳຕອບມາຮອດທ່ານ, ໃນໂທລະສັບນີ້ ແລະ ໃນໂມງຂອງທ່ານ. ໂມງຂອງທ່ານຍັງໄດ້ຮັບການອັບເດດຢູ່ດີ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Android daugiau nebeklausia, todėl tafs pranešimai telefono nustatymuose išjungti. Įjunkite juos ten, kad patvirtinimai ir atsakymai jus pasiektų, šiame telefone ir laikrodyje. Laikrodis savo naujinius gauna bet kuriuo atveju."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Android vairs nejautā, tāpēc tafs paziņojumi tālruņa iestatījumos ir izslēgti. Ieslēdz tos tur, lai apstiprinājumi un atbildes tevi sasniegtu, šajā tālrunī un pulkstenī. Pulkstenis savus atjauninājumus saņem jebkurā gadījumā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Android повеќе не прашува, па известувањата за tafs се исклучени во поставките на телефонот. Вклучи ги таму за одобренијата и одговорите да стигнуваат до тебе, на овој телефон и на часовникот. Часовникот ги добива ажурирањата во секој случај."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Android дахин асуухгүй тул утасны тохиргоонд tafs-ын мэдэгдэл унтраастай байна. Зөвшөөрөл, хариулт энэ утас болон цагт тань ирэхийн тулд тэнд асаана уу. Цаг тань шинэчлэлтээ ямар ч байсан авна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ले अब सोध्दैन, त्यसैले तपाईंको फोनको सेटिङमा tafs को सूचना बन्द छ। स्वीकृति र जवाफ यो फोन र तपाईंको घडीमा आइपुगून् भनेर त्यहाँ खोल्नुहोस्। तपाईंको घडीले जसरी पनि अपडेट पाउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Android vraagt het niet meer, dus meldingen voor tafs staan uit in de instellingen van je telefoon. Zet ze daar aan zodat goedkeuringen en antwoorden je bereiken, op deze telefoon en op je horloge. Je horloge krijgt zijn updates hoe dan ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Android już nie pyta, więc alerty tafs są wyłączone w ustawieniach telefonu. Włącz je tam, aby zatwierdzenia i odpowiedzi do Ciebie docierały, na tym telefonie i na zegarku. Zegarek i tak dostaje swoje aktualizacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android já não pergunta, por isso os alertas do tafs estão desativados nas definições do telefone. Ative-os lá para que as aprovações e as respostas cheguem até si, neste telefone e no seu relógio. O relógio recebe as atualizações de qualquer forma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android não pergunta mais, por isso os alertas do tafs estão desativados nas configurações do telefone. Ative-os lá para que as aprovações e as respostas cheguem até você, neste telefone e no seu relógio. O relógio recebe as atualizações de qualquer forma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Android nu mai întreabă, așa că alertele tafs sunt dezactivate în setările telefonului. Activați-le acolo ca aprobările și răspunsurile să ajungă la dvs., pe acest telefon și pe ceas. Ceasul își primește actualizările oricum."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Android sa už nepýta, takže upozornenia pre tafs sú v nastaveniach telefónu vypnuté. Zapnite ich tam, aby vám schválenia a odpovede chodili do tohto telefónu aj do hodiniek. Hodinky dostávajú aktualizácie tak či tak."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ne sprašuje več, zato so opozorila za tafs v nastavitvah telefona izklopljena. Vklopite jih tam, da bodo odobritve in odgovori prihajali do vas, na ta telefon in na uro. Ura svoje posodobitve dobi v vsakem primeru."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Android nuk pyet më, ndaj njoftimet për tafs janë të çaktivizuara në cilësimet e telefonit. Aktivizojini atje që miratimet dhe përgjigjet t'ju arrijnë, në këtë telefon dhe në orën tuaj. Ora i merr përditësimet e saj gjithsesi."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Android više ne pita, pa su obaveštenja za tafs isključena u podešavanjima telefona. Uključite ih tamo da bi odobrenja i odgovori stizali do vas, na ovaj telefon i na sat. Sat ionako dobija svoja ažuriranja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ไม่ถามอีกแล้ว การแจ้งเตือนสำหรับ tafs จึงปิดอยู่ในการตั้งค่าโทรศัพท์ของคุณ เปิดที่นั่นเพื่อให้การอนุมัติและคำตอบมาถึงคุณ ทั้งบนโทรศัพท์เครื่องนี้และบนนาฬิกา นาฬิกาของคุณได้รับการอัปเดตอยู่แล้วไม่ว่ากรณีใด"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Android indi soramaýar, şonuň üçin tafs duýduryşlary telefonyňyzyň sazlamalarynda öçürilen. Tassyklamalar we jogaplar size, bu telefonda we sagadyňyzda ýetip gelsin diýip, olary şol ýerde açyň. Sagadyňyz täzelenmelerini islendik ýagdaýda alýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android artık sormuyor, bu yüzden tafs uyarıları telefonunuzun ayarlarında kapalı. Onaylar ve yanıtlar size, bu telefonda ve saatinizde ulaşsın diye onları orada açın. Saatiniz güncellemelerini her durumda alır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Android اب نہیں پوچھتا، اس لیے آپ کے فون کی سیٹنگز میں tafs کے الرٹس بند ہیں۔ انہیں وہاں چالو کریں تاکہ منظوریاں اور جوابات اس فون اور آپ کی گھڑی پر پہنچیں۔ آپ کی گھڑی کو اپڈیٹس ہر صورت ملتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android không hỏi nữa, nên cảnh báo cho tafs đang tắt trong cài đặt điện thoại của bạn. Hãy bật ở đó để phê duyệt và câu trả lời đến được với bạn, trên điện thoại này và trên đồng hồ. Đồng hồ của bạn vẫn nhận cập nhật dù thế nào."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 不會再詢問，因此 tafs 的通知在手機設定中為關閉。請在那裡開啟，讓核准與回答傳到這部手機和您的手錶。無論如何，手錶都會收到更新。"
          }
        }
      }
    },
    "alert.blocked.body_watch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد جهاز iPhone الخاص بك يسأل، لذا فإن تنبيهات tafs متوقفة في الإعدادات. شغّلها هناك لتصلك الموافقات والإجابات على هذا الـ iPhone وعلى ساعتك. تصل التحديثات إلى ساعتك في كل الأحوال."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-unuz artıq soruşmur, buna görə tafs bildirişləri Ayarlarda söndürülüb. Təsdiqlər və cavablar bu iPhone-a və saatınıza çatsın deyə onları orada aktiv edin. Saatınız yeniləmələrini hər halda alır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашият iPhone вече не пита, затова известията за tafs са изключени в Настройки. Включете ги там, за да ви стигат одобренията и отговорите на този iPhone и на часовника ви. Часовникът ви получава актуализациите си и без това."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iPhone আর জিজ্ঞাসা করে না, তাই সেটিংসে tafs-এর অ্যালার্ট বন্ধ আছে। অনুমোদন ও উত্তর যেন এই iPhone-এ ও আপনার ঘড়িতে পৌঁছায়, সেজন্য সেখানে সেগুলো চালু করুন। আপনার ঘড়ি যেকোনোভাবেই আপডেট পায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu iPhone ja no ho pregunta, així que les alertes de tafs estan desactivades a Configuració. Activa-les allà perquè les aprovacions i les respostes t'arribin, en aquest iPhone i al rellotge. El rellotge rep les actualitzacions igualment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš iPhone se už neptá, takže upozornění pro tafs jsou v Nastavení vypnutá. Zapněte je tam, aby vám schválení a odpovědi chodily do tohoto iPhonu i do hodinek. Hodinky dostávají aktualizace tak jako tak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein iPhone fragt nicht mehr, deshalb sind die Benachrichtigungen für tafs in den Einstellungen aus. Schalte sie dort ein, damit dich Genehmigungen und Antworten erreichen, auf diesem iPhone und auf deiner Uhr. Deine Uhr bekommt ihre Updates so oder so."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone no longer asks, so alerts for tafs are off in Settings. Turn them on there so approvals and answers reach you, on this iPhone and on your watch. Your watch gets its updates either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPhone ya no pregunta, así que las alertas de tafs están desactivadas en Ajustes. Actívalas ahí para que las aprobaciones y respuestas te lleguen, en este iPhone y en tu reloj. Tu reloj recibe sus actualizaciones de todos modos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu iPhone enam ei küsi, seega on tafsi teavitused seadetes välja lülitatud. Lülita need seal sisse, et kinnitused ja vastused jõuaksid sinuni, selles iPhone'is ja kellas. Kell saab oma uuendused igal juhul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre iPhone ne pose plus la question, donc les alertes de tafs sont désactivées dans Réglages. Activez-les là pour que les approbations et les réponses vous parviennent, sur cet iPhone et sur votre montre. Votre montre reçoit ses mises à jour de toute façon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-iPhone שלך כבר לא שואל, ולכן ההתראות של tafs כבויות בהגדרות. יש להפעיל אותן שם כדי שאישורים ותשובות יגיעו אליך, ב-iPhone הזה ובשעון. השעון מקבל את העדכונים שלו בכל מקרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका iPhone अब नहीं पूछता, इसलिए सेटिंग्स में tafs के अलर्ट बंद हैं। उन्हें वहाँ चालू करें ताकि मंज़ूरियाँ और जवाब इस iPhone पर और आपकी घड़ी पर पहुँचें। आपकी घड़ी को अपडेट हर हाल में मिलते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš iPhone više ne pita, pa su obavijesti za tafs isključene u Postavkama. Uključite ih ondje kako bi odobrenja i odgovori stizali do vas, na ovaj iPhone i na sat. Sat ionako prima svoja ažuriranja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iPhone-od már nem kérdez rá, ezért a tafs riasztásai ki vannak kapcsolva a Beállításokban. Kapcsold be őket ott, hogy a jóváhagyások és a válaszok eljussanak hozzád, ezen az iPhone-on és az órádon. Az órád így is megkapja a frissítéseit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր iPhone-ն այլևս չի հարցնում, ուստի tafs-ի ծանուցումներն անջատված են Կարգավորումներում։ Միացրեք դրանք այնտեղ, որպեսզի հաստատումներն ու պատասխանները հասնեն ձեզ՝ այս iPhone-ին և ձեր ժամացույցին։ Ձեր ժամացույցն ամեն դեպքում ստանում է իր թարմացումները։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Anda tidak lagi bertanya, jadi peringatan untuk tafs nonaktif di Pengaturan. Aktifkan di sana agar persetujuan dan jawaban sampai ke Anda, di iPhone ini dan di jam tangan Anda. Jam tangan Anda tetap menerima pembaruannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo iPhone non lo chiede più, quindi gli avvisi di tafs sono disattivati in Impostazioni. Attivali lì perché approvazioni e risposte ti raggiungano, su questo iPhone e sul tuo orologio. L'orologio riceve comunque i suoi aggiornamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneではもう確認されないため、設定でtafsの通知がオフになっています。承認や回答がこのiPhoneとウォッチに届くよう、そこで通知をオンにしてください。ウォッチはどちらの場合も更新を受け取ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი iPhone აღარ გეკითხებათ, ამიტომ tafs-ის შეტყობინებები გამორთულია პარამეტრებში. ჩართეთ ისინი იქ, რომ დადასტურებები და პასუხები მოგივიდეთ ამ iPhone-ზე და საათზე. საათი განახლებებს ნებისმიერ შემთხვევაში იღებს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone របស់អ្នកលែងសួរទៀតហើយ ដូច្នេះការជូនដំណឹងសម្រាប់ tafs ត្រូវបានបិទក្នុងការកំណត់។ បើកវានៅទីនោះ ដើម្បីឱ្យការអនុម័ត និងចម្លើយទៅដល់អ្នក នៅលើ iPhone នេះ និងនាឡិការបស់អ្នក។ នាឡិការបស់អ្នកនៅតែទទួលបានបច្ចុប្បន្នភាពរបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 더 이상 묻지 않아 설정에서 tafs 알림이 꺼져 있습니다. 승인과 답변이 이 iPhone과 시계로 오도록 설정에서 알림을 켜세요. 시계는 어느 쪽이든 업데이트를 받습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ຂອງທ່ານບໍ່ຖາມອີກແລ້ວ, ສະນັ້ນການແຈ້ງເຕືອນສຳລັບ tafs ຖືກປິດໃນການຕັ້ງຄ່າ. ເປີດມັນຢູ່ບ່ອນນັ້ນ ເພື່ອໃຫ້ການອະນຸມັດ ແລະ ຄຳຕອບມາຮອດທ່ານ, ໃນ iPhone ນີ້ ແລະ ໃນໂມງຂອງທ່ານ. ໂມງຂອງທ່ານຍັງໄດ້ຮັບການອັບເດດຢູ່ດີ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų iPhone daugiau nebeklausia, todėl tafs pranešimai nustatymuose išjungti. Įjunkite juos ten, kad patvirtinimai ir atsakymai jus pasiektų, šiame iPhone ir laikrodyje. Laikrodis savo naujinius gauna bet kuriuo atveju."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavs iPhone vairs nejautā, tāpēc tafs paziņojumi iestatījumos ir izslēgti. Ieslēdz tos tur, lai apstiprinājumi un atbildes tevi sasniegtu, šajā iPhone un pulkstenī. Pulkstenis savus atjauninājumus saņem jebkurā gadījumā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твојот iPhone повеќе не прашува, па известувањата за tafs се исклучени во Поставки. Вклучи ги таму за одобренијата и одговорите да стигнуваат до тебе, на овој iPhone и на часовникот. Часовникот ги добива ажурирањата во секој случај."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны iPhone дахин асуухгүй тул Тохиргоонд tafs-ын мэдэгдэл унтраастай байна. Зөвшөөрөл, хариулт энэ iPhone болон цагт тань ирэхийн тулд тэнд асаана уу. Цаг тань шинэчлэлтээ ямар ч байсан авна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको iPhone ले अब सोध्दैन, त्यसैले सेटिङमा tafs को सूचना बन्द छ। स्वीकृति र जवाफ यो iPhone र तपाईंको घडीमा आइपुगून् भनेर त्यहाँ खोल्नुहोस्। तपाईंको घडीले जसरी पनि अपडेट पाउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je iPhone vraagt het niet meer, dus meldingen voor tafs staan uit in Instellingen. Zet ze daar aan zodat goedkeuringen en antwoorden je bereiken, op deze iPhone en op je horloge. Je horloge krijgt zijn updates hoe dan ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój iPhone już nie pyta, więc alerty tafs są wyłączone w Ustawieniach. Włącz je tam, aby zatwierdzenia i odpowiedzi do Ciebie docierały, na tym iPhonie i na zegarku. Zegarek i tak dostaje swoje aktualizacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu iPhone já não pergunta, por isso os alertas do tafs estão desativados em Definições. Ative-os lá para que as aprovações e as respostas cheguem até si, neste iPhone e no seu relógio. O relógio recebe as atualizações de qualquer forma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu iPhone não pergunta mais, por isso os alertas do tafs estão desativados em Ajustes. Ative-os lá para que as aprovações e as respostas cheguem até você, neste iPhone e no seu relógio. O relógio recebe as atualizações de qualquer forma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-ul dvs. nu mai întreabă, așa că alertele tafs sunt dezactivate în Configurări. Activați-le acolo ca aprobările și răspunsurile să ajungă la dvs., pe acest iPhone și pe ceas. Ceasul își primește actualizările oricum."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš iPhone sa už nepýta, takže upozornenia pre tafs sú v Nastaveniach vypnuté. Zapnite ich tam, aby vám schválenia a odpovede chodili do tohto iPhonu aj do hodiniek. Hodinky dostávajú aktualizácie tak či tak."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš iPhone ne sprašuje več, zato so opozorila za tafs v Nastavitvah izklopljena. Vklopite jih tam, da bodo odobritve in odgovori prihajali do vas, na ta iPhone in na uro. Ura svoje posodobitve dobi v vsakem primeru."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-i juaj nuk pyet më, ndaj njoftimet për tafs janë të çaktivizuara te Cilësimet. Aktivizojini atje që miratimet dhe përgjigjet t'ju arrijnë, në këtë iPhone dhe në orën tuaj. Ora i merr përditësimet e saj gjithsesi."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš iPhone više ne pita, pa su obaveštenja za tafs isključena u Podešavanjima. Uključite ih tamo da bi odobrenja i odgovori stizali do vas, na ovaj iPhone i na sat. Sat ionako dobija svoja ažuriranja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ของคุณไม่ถามอีกแล้ว การแจ้งเตือนสำหรับ tafs จึงปิดอยู่ในการตั้งค่า เปิดที่นั่นเพื่อให้การอนุมัติและคำตอบมาถึงคุณ ทั้งบน iPhone เครื่องนี้และบนนาฬิกา นาฬิกาของคุณได้รับการอัปเดตอยู่แล้วไม่ว่ากรณีใด"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-yňyz indi soramaýar, şonuň üçin tafs duýduryşlary Sazlamalarda öçürilen. Tassyklamalar we jogaplar size, bu iPhone-da we sagadyňyzda ýetip gelsin diýip, olary şol ýerde açyň. Sagadyňyz täzelenmelerini islendik ýagdaýda alýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'unuz artık sormuyor, bu yüzden tafs uyarıları Ayarlar'da kapalı. Onaylar ve yanıtlar size, bu iPhone'da ve saatinizde ulaşsın diye onları orada açın. Saatiniz güncellemelerini her durumda alır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا iPhone اب نہیں پوچھتا، اس لیے سیٹنگز میں tafs کے الرٹس بند ہیں۔ انہیں وہاں چالو کریں تاکہ منظوریاں اور جوابات اس iPhone اور آپ کی گھڑی پر پہنچیں۔ آپ کی گھڑی کو اپڈیٹس ہر صورت ملتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone của bạn không hỏi nữa, nên cảnh báo cho tafs đang tắt trong Cài đặt. Hãy bật ở đó để phê duyệt và câu trả lời đến được với bạn, trên iPhone này và trên đồng hồ. Đồng hồ của bạn vẫn nhận cập nhật dù thế nào."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 iPhone 不會再詢問，因此 tafs 的通知在「設定」中為關閉。請在那裡開啟，讓核准與回答傳到這部 iPhone 和您的手錶。無論如何，手錶都會收到更新。"
          }
        }
      }
    },
