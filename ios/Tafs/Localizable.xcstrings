    "halt_all.signed_out": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-dan çıxış etmisiniz. Taf-larınızı dondurmaq üçün daxil olun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Излезли сте от tafs. Влезте, за да спрете вашите tafs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste z tafs odhlášeni. Přihlaste se, abyste mohli zastavit své tafy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist bei tafs abgemeldet. Melde dich an, um deine tafs anzuhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're signed out of tafs. Sign in to halt your tafs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has cerrado sesión en tafs. Inicia sesión para bloquear tus tafs."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Oled tafsist välja logitud. Tafide peatamiseks logi sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes déconnecté de tafs. Connectez-vous pour bloquer vos tafs."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavljeni ste iz tafsa. Prijavite se da blokirate svoje tafove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki vagy jelentkezve a tafsből. Jelentkezz be a tafjaid leállításához."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դուք դուրս եք եկել tafs-ից։ Մուտք գործեք՝ ձեր taf-երը կանգնեցնելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda keluar dari tafs. Masuk untuk membekukan tafs Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei disconnesso da tafs. Accedi per bloccare i tuoi tafs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsからサインアウトしています。tafsを遮断するにはサインインしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-იდან გამოხვედით. შედით თქვენი taf-ების გასაჩერებლად."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs에서 로그아웃되었습니다. 로그인해 tafs를 차단하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esate atsijungę nuo tafs. Prisijunkite, kad galėtumėte sustabdyti savo taf."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu esi izrakstījies no tafs. Pieraksties, lai apturētu savus taf."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent uitgelogd bij tafs. Log in om je tafs stil te zetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowano z tafs. Zaloguj się, aby zablokować swoje tafs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminou sessão no tafs. Inicie sessão para bloquear os seus tafs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você saiu do tafs. Entre para bloquear os seus tafs."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunteți deconectat de la tafs. Conectați-vă pentru a opri tafurile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste odhlásení z tafs. Prihláste sa, aby ste mohli zastaviť svoje tafy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iz tafs ste odjavljeni. Prijavite se, da boste lahko ustavili svoje tafe."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Keni dalë nga tafs. Hyni për të bllokuar tafs-et tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavljeni ste iz tafsa. Prijavite se da blokirate svoje tafove."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออกจากระบบ tafs แล้ว เข้าสู่ระบบเพื่อระงับ taf ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs'ta oturumunuz kapalı. tafs'larınızı dondurmak için oturum açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đăng xuất khỏi tafs. Hãy đăng nhập để đóng băng các tafs của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已登出 tafs。請登入以凍結您的 taf。"
          }
        }
      }
    },
