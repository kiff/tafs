        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono tanti messaggi in pochi minuti. Aspetta un po', poi invialo di nuovo: non è stato inviato nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zijn veel berichten in een paar minuten. Wacht even en verzend het dan opnieuw: er is niets verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To dużo wiadomości w kilka minut. Poczekaj chwilę, a potem wyślij ponownie: nic nie zostało wysłane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São muitas mensagens em poucos minutos. Aguarde um pouco e envie novamente: nada foi enviado."
          }
        }
      }
    },
