        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n'a pas de capteur d'empreintes que tafs peut utiliser pour les approbations. Approuvez depuis un autre téléphone ou un appareil compatible."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon nema senzor otiska prsta koji tafs može koristiti za odobrenja. Odobrite s drugog telefona ili podržanog uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a telefonnak nincs olyan ujjlenyomat-érzékelője, amelyet a tafs jóváhagyásra használhatna. Hagyd jóvá egy másik telefonról vagy támogatott eszközről."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հեռախոսը չունի մատնահետքի սենսոր, որը tafs-ը կարող է օգտագործել հաստատումների համար։ Հաստատեք մեկ այլ հեռախոսից կամ աջակցվող սարքից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini tidak memiliki sensor sidik jari yang dapat dipakai tafs untuk persetujuan. Setujui dari ponsel lain atau perangkat yang didukung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non ha un sensore di impronte che tafs possa usare per le approvazioni. Approva da un altro telefono o da un dispositivo supportato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンには、tafsが承認に使える指紋センサーがありません。別のスマートフォンか対応デバイスから承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ტელეფონს არ აქვს თითის ანაბეჭდის სენსორი, რომელსაც tafs დამტკიცებისთვის გამოიყენებს. დაამტკიცეთ სხვა ტელეფონიდან ან მხარდაჭერილი მოწყობილობიდან."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에는 tafs가 승인에 사용할 수 있는 지문 센서가 없습니다. 다른 휴대폰이나 지원되는 기기에서 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis telefonas neturi piršto atspaudo jutiklio, kurį tafs galėtų naudoti patvirtinimams. Tvirtinkite kitame telefone ar palaikomame įrenginyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šim tālrunim nav pirkstu nospiedumu sensora, ko tafs var izmantot apstiprināšanai. Apstiprini no cita tālruņa vai atbalstītas ierīces."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon heeft geen vingerafdruksensor die tafs voor goedkeuringen kan gebruiken. Keur goed vanaf een andere telefoon of een ondersteund apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon nie ma czytnika linii papilarnych, którego tafs może użyć do zatwierdzania. Zatwierdź z innego telefonu lub obsługiwanego urządzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone não tem um sensor de impressões digitais que o tafs possa usar para aprovações. Aprove a partir de outro telefone ou de um dispositivo compatível."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone não tem um sensor de impressões digitais que o tafs possa usar para aprovações. Aprove a partir de outro telefone ou de um dispositivo compatível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest telefon nu are un senzor de amprentă pe care tafs să-l poată folosi pentru aprobări. Aprobați de pe alt telefon sau de pe un dispozitiv compatibil."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento telefón nemá snímač odtlačkov, ktorý by tafs mohol použiť na schvaľovanie. Schváľte z iného telefónu alebo podporovaného zariadenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta telefon nima bralnika prstnih odtisov, ki bi ga tafs lahko uporabil za odobritve. Odobrite z drugega telefona ali podprte naprave."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky telefon nuk ka sensor gjurme gishti që tafs mund ta përdorë për miratime. Miratoni nga një telefon tjetër ose një pajisje e mbështetur."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon nema senzor otiska prsta koji tafs može da koristi za odobravanja. Odobrite sa drugog telefona ili podržanog uređaja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์เครื่องนี้ไม่มีเซนเซอร์ลายนิ้วมือที่ tafs ใช้อนุมัติได้ ให้อนุมัติจากโทรศัพท์เครื่องอื่นหรืออุปกรณ์ที่รองรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonda tafs'ın onaylar için kullanabileceği bir parmak izi sensörü yok. Başka bir telefondan veya desteklenen bir cihazdan onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại này không có cảm biến vân tay mà tafs dùng được để phê duyệt. Hãy phê duyệt từ điện thoại khác hoặc một thiết bị được hỗ trợ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部手機沒有 tafs 可用於核准的指紋感應器。請從另一部手機或支援的裝置核准。"
          }
        }
      }
    },
    "approval.taf_asks_before_does_anything": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf öz Card-ından kənar hər hansı bir şey etməzdən əvvəl soruşur, Coach isə tətbiq qoşmazdan və ya Card verməzdən əvvəl soruşur. Siz bu cihazda təsdiq edirsiniz və bu Face ID və ya Touch ID tələb edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf пита, преди да направи нещо извън своята Card, а Coach пита, преди да свърже приложение или да издаде Card. Одобрявате на това устройство и за това е нужен Face ID или Touch ID."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf se zeptá, než udělá cokoli mimo svou Card, a Coach se zeptá, než připojí aplikaci nebo vydá Card. Schvalujete na tomto zařízení a potřebujete k tomu Face ID nebo Touch ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein taf fragt, bevor er etwas außerhalb seiner Card tut, und Coach fragt, bevor er eine App verbindet oder eine Card ausstellt. Du genehmigst auf diesem Gerät, und dafür brauchst du Face ID oder Touch ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A taf asks before it does anything outside its Card, and Coach asks before it connects an app or issues a Card. You approve on this device, and that needs Face ID or Touch ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf pregunta antes de hacer nada fuera de su Card, y Coach pregunta antes de conectar una app o emitir una Card. Apruebas en este dispositivo, y para eso se necesita Face ID o Touch ID."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf küsib enne, kui teeb midagi väljaspool oma Cardi, ja Coach küsib enne, kui ühendab rakenduse või väljastab Cardi. Kinnitad selles seadmes ja selleks on vaja Face ID-d või Touch ID-d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf demande avant de faire quoi que ce soit hors de sa Card, et Coach demande avant de connecter une app ou d'émettre une Card. Vous approuvez sur cet appareil, ce qui nécessite Face ID ou Touch ID."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf pita prije nego što napravi bilo što izvan svog Carda, a Coach pita prije nego što poveže aplikaciju ili izda Card. Odobravate na ovom uređaju, a za to je potreban Face ID ili Touch ID."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy taf megkérdez, mielőtt bármit tenne a Cardján kívül, a Coach pedig megkérdez, mielőtt alkalmazást csatlakoztatna vagy Cardot adna ki. Ezen az eszközön hagyod jóvá, és ehhez Face ID vagy Touch ID kell."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-ը հարցնում է, նախքան իր Card-ից դուրս որևէ բան անելը, իսկ Coach-ը հարցնում է, նախքան հավելված կապելը կամ Card թողարկելը։ Դուք հաստատում եք այս սարքում, և դա պահանջում է Face ID կամ Touch ID։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah taf bertanya sebelum melakukan apa pun di luar Card-nya, dan Coach bertanya sebelum menghubungkan aplikasi atau menerbitkan Card. Anda menyetujui di perangkat ini, dan itu memerlukan Face ID atau Touch ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf chiede prima di fare qualsiasi cosa fuori dalla sua Card, e Coach chiede prima di collegare un'app o emettere una Card. Approvi su questo dispositivo, e serve Face ID o Touch ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafはCardの範囲外のことをする前に確認し、Coachはアプリを接続したりCardを発行したりする前に確認します。承認はこのデバイスで行い、Face IDまたはTouch IDが必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "taf გეკითხებათ, სანამ რამეს გააკეთებს თავისი Card-ის გარეთ, ხოლო Coach გეკითხებათ, სანამ აპს დააკავშირებს ან Card-ს გასცემს. ამტკიცებთ ამ მოწყობილობაზე და ამას Face ID ან Touch ID სჭირდება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf는 Card 밖의 일을 하기 전에 묻고, Coach는 앱을 연결하거나 Card를 발급하기 전에 묻습니다. 승인은 이 기기에서 하며, Face ID나 Touch ID가 필요합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "taf paklausia prieš darydamas ką nors už savo Card ribų, o Coach paklausia prieš prijungdamas programėlę ar išduodamas Card. Tvirtinate šiame įrenginyje, ir tam reikia Face ID arba Touch ID."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "taf jautā, pirms dara jebko ārpus savas Card, un Coach jautā, pirms pievieno lietotni vai izsniedz Card. Tu apstiprini šajā ierīcē, un tam vajag Face ID vai Touch ID."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een taf vraagt het voordat het iets doet buiten zijn Card, en Coach vraagt het voordat het een app koppelt of een Card uitgeeft. Je keurt goed op dit apparaat, en daarvoor is Face ID of Touch ID nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf pyta, zanim zrobi cokolwiek poza swoją Card, a Coach pyta, zanim połączy aplikację lub wyda Card. Zatwierdzasz na tym urządzeniu, a to wymaga Face ID lub Touch ID."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taf pergunta antes de fazer algo fora do seu Card, e o Coach pergunta antes de ligar uma app ou emitir um Card. Aprova neste dispositivo, e isso requer Face ID ou Touch ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taf pergunta antes de fazer algo fora do seu Card, e o Coach pergunta antes de conectar um app ou emitir um Card. Aprova neste dispositivo, e isso requer Face ID ou Touch ID."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf întreabă înainte să facă ceva în afara Cardului său, iar Coach întreabă înainte să conecteze o aplicație sau să emită un Card. Aprobați pe acest dispozitiv, iar asta necesită Face ID sau Touch ID."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf sa opýta, kým urobí čokoľvek mimo svojej Card, a Coach sa opýta, kým pripojí aplikáciu alebo vydá Card. Schvaľujete na tomto zariadení a potrebujete na to Face ID alebo Touch ID."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf vpraša, preden naredi karkoli zunaj svoje Card, Coach pa vpraša, preden poveže aplikacijo ali izda Card. Odobrite na tej napravi, za kar potrebujete Face ID ali Touch ID."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një taf pyet para se të bëjë çdo gjë jashtë Card-it të tij, dhe Coach pyet para se të lidhë një aplikacion ose të lëshojë një Card. Miratoni në këtë pajisje, dhe kjo kërkon Face ID ose Touch ID."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf pita pre nego što uradi bilo šta izvan svog Carda, a Coach pita pre nego što poveže aplikaciju ili izda Card. Odobravate na ovom uređaju, a za to je potreban Face ID ili Touch ID."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "taf จะถามก่อนทำสิ่งใดนอก Card ของมัน และ Coach จะถามก่อนเชื่อมต่อแอปหรือออก Card คุณอนุมัติบนอุปกรณ์นี้ ซึ่งต้องใช้ Face ID หรือ Touch ID"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir taf, Card'ının dışındaki her şeyden önce size sorar; Coach da bir uygulama bağlamadan veya Card vermeden önce sorar. Bu cihazda onaylarsınız ve bunun için Face ID veya Touch ID gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một taf hỏi trước khi làm bất cứ điều gì ngoài Card của nó, và Coach hỏi trước khi kết nối ứng dụng hoặc cấp Card. Bạn phê duyệt trên thiết bị này, và điều đó cần Face ID hoặc Touch ID."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "taf 在做任何超出其 Card 範圍的事之前會先詢問，而 Coach 在連接 App 或發出 Card 之前也會先詢問。您在這部裝置上核准，這需要 Face ID 或 Touch ID。"
          }
        }
      }
    },
