    "door.do_it.default": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu, worum es bittet, innerhalb deiner Card."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do what it asks, within your Card."
          }
        },
        "es": {
          "stringUnit": {
