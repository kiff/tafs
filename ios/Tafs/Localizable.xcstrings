    "card.kiff_did_not_revoke_cards": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF Card-larından %1$@ ədədini ləğv etmədi: onları KIFF-də ləğv edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF не оттегли %1$@ от неговите Cards: оттеглете ги в KIFF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF neodvolal %1$@ jeho Card: odvolejte je v KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hat %1$@ seiner Cards nicht widerrufen: Widerrufe sie in KIFF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF didn't revoke %1$@ of its Cards: revoke them in KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no revocó %1$@ de sus Cards: revócalas en KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei tühistanud selle Cardidest %1$@: tühista need KIFFis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas révoqué %1$@ de ses Cards : révoquez-les dans KIFF."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nije opozvao %1$@ njegovih Cardova: opozovite ih u KIFF-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF nem vonta vissza a Cardjai közül ennyit: %1$@. Vond vissza őket a KIFF-ben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը չեղարկեց նրա Card-երից %1$@-ը․ չեղարկեք դրանք KIFF-ում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF tidak mencabut %1$@ dari Card-nya: cabut di KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non ha revocato %1$@ delle sue Card: revocale in KIFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFはCardのうち%1$@枚を取り消しませんでした。KIFFで取り消してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-მა მისი %1$@ Card არ გააუქმა: გააუქმეთ ისინი KIFF-ში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 Card %1$@개를 취소하지 않았습니다. KIFF에서 취소하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF neatšaukė kai kurių jo Card (%1$@): atšaukite jas KIFF."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF neatsauca daļu tā Card (%1$@): atsauc tās KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF heeft %1$@ van zijn Cards niet ingetrokken: trek ze in bij KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie unieważnił części jego Card (%1$@): unieważnij je w KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não revogou %1$@ dos seus Cards: revogue-os no KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não revogou %1$@ dos seus Cards: revogue-os no KIFF."
