    "connect.apps.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App mit diesem Namen. Coach kann eine verbinden, die nicht aufgeführt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app by that name. Coach can connect one that isn't listed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna app con ese nombre. Coach puede conectar una que no esté en la lista."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellise nimega rakendust pole. Coach saab ühendada rakenduse, mida loendis pole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app de ce nom. Coach peut en connecter une qui n'est pas listée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna app con quel nome. Coach può collegarne una che non è in elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前のアプリはありません。一覧にないアプリはCoachが接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 이름의 앱이 없습니다. 목록에 없는 앱도 Coach가 연결할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programėlės tokiu pavadinimu nėra. Coach gali prijungti ir nesąraše esančią."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav lietotnes ar tādu nosaukumu. Coach var pievienot arī lietotni, kuras nav sarakstā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen app met die naam. Coach kan een app koppelen die hier niet staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak aplikacji o tej nazwie. Coach może połączyć taką, której nie ma na liście."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma app com esse nome. O Coach pode ligar uma que não esteja na lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app com esse nome. O Coach pode conectar um que não esteja na lista."
          }
