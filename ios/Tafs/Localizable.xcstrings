        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ üçün yeni qapı açın"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отваряне на нова врата към %1$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-এর জন্য একটি নতুন দরজা খুলুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre una porta nova a %1$@"
