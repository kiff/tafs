        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle käivitusi ei õnnestunud lugeda. %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses exécutions n'ont pas pu être lues. %1$@"
