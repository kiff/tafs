    "coach.nothing_reaches_until_you_resume": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts erreicht ihn, bis du ihn fortsetzt. Sende das dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing reaches it until you resume it. Then send this again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No le llega nada hasta que lo reanudes. Luego vuelve a enviar esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne lui parvient tant que vous ne le reprenez pas. Renvoyez ensuite ceci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non gli arriva nulla finché non lo riprendi. Poi invialo di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bereikt het niets tot je het hervat. Verzend dit daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic do niego nie dotrze, dopóki go nie wznowisz. Potem wyślij to ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada lhe chega até o retomar. Depois, envie isto novamente."
          }
        }
      }
    },
    "coach.nothing_to_approve": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist bereits verbunden. Es gibt nichts Neues zu genehmigen, daher wurde nichts genehmigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is already connected. There's nothing new to approve, so nothing was approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ya está conectado. No hay nada nuevo que aprobar, así que no se aprobó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est déjà connecté. Il n'y a rien de nouveau à approuver : rien n'a été approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è già collegato. Non c'è nulla di nuovo da approvare, quindi non è stato approvato nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is al gekoppeld. Er is niets nieuws om goed te keuren, dus er is niets goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest już połączony. Nie ma nic nowego do zatwierdzenia, więc nic nie zostało zatwierdzone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ já está ligado. Não há nada de novo para aprovar, por isso nada foi aprovado."
          }
        }
      }
    },
