      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind viele Nachrichten in wenigen Minuten. Warte kurz und sende es dann erneut: Es wurde nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's a lot of messages in a few minutes. Wait a little, then send it again: nothing was sent."
