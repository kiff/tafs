    "onboarding.terms_changed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qutunu işarələdiyinizdən bəri Şərtlər dəyişdi. Onları oxuyun, sonra yenidən işarələyin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Условията се промениха, откакто отметнахте полето. Прочетете ги и го отметнете отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podmínky se změnily od chvíle, kdy jste zaškrtli políčko. Přečtěte si je a zaškrtněte ho znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzungsbedingungen haben sich geändert, seit du das Kästchen angehakt hast. Lies sie und hake es dann erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Terms changed since you ticked the box. Read them, then tick it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las condiciones han cambiado desde que marcaste la casilla. Léelas y vuelve a marcarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingimused on muutunud pärast seda, kui kasti märkisid. Loe need läbi ja märgi kast uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conditions ont changé depuis que vous avez coché la case. Lisez-les, puis cochez-la à nouveau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvjeti su se promijenili otkako ste označili okvir. Pročitajte ih, pa ga označite ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A feltételek megváltoztak, mióta bejelölted a négyzetet. Olvasd el őket, majd jelöld be újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պայմանները փոխվել են այն բանից հետո, երբ նշեցիք վանդակը։ Կարդացեք դրանք, ապա նորից նշեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketentuan berubah sejak Anda mencentang kotaknya. Bacalah, lalu centang lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le condizioni sono cambiate da quando hai spuntato la casella. Leggile, poi spuntala di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックを入れた後に規約が変更されました。内容を確認してから、もう一度チェックを入れてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პირობები შეიცვალა მას შემდეგ, რაც ველი მონიშნეთ. წაიკითხეთ ისინი, შემდეგ მონიშნეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크한 뒤로 약관이 바뀌었습니다. 약관을 읽고 다시 체크하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sąlygos pasikeitė nuo tada, kai pažymėjote langelį. Perskaitykite jas ir pažymėkite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteikumi mainījās, kopš tu atzīmēji izvēles rūtiņu. Izlasi tos, tad atzīmē vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voorwaarden zijn gewijzigd sinds je het vakje aanvinkte. Lees ze en vink het dan opnieuw aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warunki zmieniły się od zaznaczenia pola. Przeczytaj je i zaznacz pole ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os termos mudaram desde que marcou a caixa. Leia-os e marque-a novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os termos mudaram desde que marcou a caixa. Leia-os e marque-a novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Termenii s-au schimbat de când ați bifat caseta. Citiți-i, apoi bifați-o din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podmienky sa zmenili od chvíle, keď ste zaškrtli políčko. Prečítajte si ich a zaškrtnite ho znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogoji so se spremenili, odkar ste označili polje. Preberite jih in ga označite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kushtet ndryshuan që kur e shënuat kutinë. Lexojini, pastaj shënojeni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uslovi su se promenili otkako ste označili okvir. Pročitajte ih, pa ga označite ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อกำหนดเปลี่ยนไปนับตั้งแต่คุณทำเครื่องหมาย โปรดอ่าน แล้วทำเครื่องหมายอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutuyu işaretledikten sonra Şartlar değişti. Okuyun, sonra kutuyu tekrar işaretleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều khoản đã thay đổi kể từ khi bạn đánh dấu ô. Hãy đọc chúng, rồi đánh dấu lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自您勾選以來，條款已有變更。請閱讀後再勾選一次。"
          }
        }
      }
    },
