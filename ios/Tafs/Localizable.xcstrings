    "door.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder kann an eine Tür schreiben. Nur Personen, die du koppelst, können %1$@ Arbeit geben, und seine Card entscheidet den Rest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can write to a door. Only people you pair can give %1$@ work, and its Card decides the rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera puede escribir a una puerta. Solo las personas que vincules pueden dar trabajo a %1$@, y su Card decide el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut écrire à une porte. Seules les personnes que vous associez peuvent donner du travail à %1$@, et sa Card décide du reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque può scrivere a una porta. Solo le persone che associ possono dare lavoro a %1$@, e la sua Card decide il resto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen kan naar een deur schrijven. Alleen mensen die je koppelt kunnen %1$@ werk geven, en zijn Card bepaalt de rest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy może pisać do drzwi. Tylko osoby, które powiążesz, mogą zlecać pracę %1$@, a o reszcie decyduje jego Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa pode escrever para uma porta. Só as pessoas que associar podem dar trabalho a %1$@, e o seu Card decide o resto."
          }
        }
      }
    },
    "door.hi_like_back_order": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo, ich hätte gern 15 $ für Bestellung T-3001 zurück."
          }
        },
        "en": {
