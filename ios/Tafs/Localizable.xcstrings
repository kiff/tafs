        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs'larınız eşleştirilmiş bir Chrome'u yalnızca bir bağlantının listelediği sitelerde kullanabilir ve riskli adımları burada onaylarsınız."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے tafs جوڑا ہوا Chrome صرف انہی سائٹس پر استعمال کر سکتے ہیں جو کنکشن میں درج ہوں، اور خطرناک مراحل آپ یہاں منظور کرتے ہیں۔"
