        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qərarı paraqrafla yox, bir cümlə ilə izah etməyimi üstün tutursunuz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпочитате да обяснявам решение с един ред, а не с абзац."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি চান আমি একটি সিদ্ধান্ত অনুচ্ছেদে নয়, এক লাইনে ব্যাখ্যা করি।"
