        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una delle prime chiamate di una nuova operazione con denaro, quindi KIFF ti chiede cosa è successo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een van de eerste aanroepen van een nieuwe geldoperatie, dus KIFF vraagt je wat er gebeurde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jedno z pierwszych wywołań nowej operacji pieniężnej, więc KIFF pyta Cię, co się stało."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma das primeiras chamadas de uma nova operação com dinheiro, por isso o KIFF pergunta-lhe o que aconteceu."
          }
        }
      }
    },
