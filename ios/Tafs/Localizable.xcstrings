          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Associa %1$@: potrà approvare azioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@をペアリング：操作を承認できます"
