            "state": "translated",
            "value": "थमा हुआ। जब तक आप आगे बढ़ने को नहीं कहते, कुछ और नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzirano. Ništa više ne ide dok mi ne kažete da nastavim."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szüneteltetve. Semmi sem megy ki, amíg nem szólsz, hogy folytassam."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դադարեցված է։ Ոչինչ չի ուղարկվում, մինչև չասեք շարունակել։"
