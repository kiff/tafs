    "connect.words_another_connection_than_one": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Worte gehören zu einer anderen Verbindung als der angezeigten. Es kann nichts genehmigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These words are for another connection than the one shown. Nothing can be approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas palabras son para otra conexión distinta de la que se muestra. No se puede aprobar nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Need sõnad on teise ühenduse kohta kui näidatu. Midagi ei saa kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces textes concernent une autre connexion que celle affichée. Rien ne peut être approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste parole sono per un collegamento diverso da quello mostrato. Non si può approvare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この説明は表示されている接続とは別の接続のものです。何も承認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설명은 표시된 것과 다른 연결에 대한 것입니다. 승인할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ši formuluotė skirta kitam ryšiui, nei rodomas. Nieko negalima patvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis formulējums ir citam savienojumam, nevis parādītajam. Neko nevar apstiprināt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze woorden zijn voor een andere koppeling dan de getoonde. Er kan niets worden goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten opis dotyczy innego połączenia niż pokazane. Nic nie można zatwierdzić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas palavras são para outra ligação que não a mostrada. Nada pode ser aprovado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas palavras são para outra conexão que não a mostrada. Nada pode ser aprovado."
          }
        }
      }
    },
    "connect.words_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFs Worte zu dieser Verbindung lassen sich nicht bestätigen (%1$@). Es wurde nichts genehmigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF's words for this connection don't check out (%1$@). Nothing was approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras de KIFF para esta conexión no cuadran (%1$@). No se aprobó nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFi sõnad selle ühenduse kohta ei pea paika (%1$@). Midagi ei kinnitatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les textes de KIFF pour cette connexion ne sont pas vérifiés (%1$@). Rien n'a été approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole di KIFF per questo collegamento non tornano (%1$@). Non è stato approvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続に関するKIFFの説明が一致しません（%1$@）。何も承認されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에 대한 KIFF의 설명이 확인되지 않습니다(%1$@). 승인된 것은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formuluotė šiam ryšiui nesutampa (%1$@). Niekas nepatvirtinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formulējums šim savienojumam neatbilst pārbaudei (%1$@). Nekas netika apstiprināts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woorden van KIFF voor deze koppeling kloppen niet (%1$@). Er is niets goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opis KIFF dla tego połączenia się nie zgadza (%1$@). Nic nie zostało zatwierdzone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras do KIFF para esta ligação não batem certo (%1$@). Nada foi aprovado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras do KIFF para esta conexão não conferem (%1$@). Nada foi aprovado."
          }
        }
      }
    },
