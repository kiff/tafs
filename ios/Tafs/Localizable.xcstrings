        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស្នាមម្រាមដៃរបស់អ្នកទើបតែផ្លាស់ប្តូរ។ សូមព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 지문이 바뀌었습니다. 다시 시도하세요."
