    "alert.answer_nothing_sent_until_you": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Cavab verin: %3$@ vaxtınadək. Siz təsdiq etməyincə heç nə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Отговорете до %3$@. Нищо не се изпраща, докато не одобрите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Odpovězte do %3$@. Nic se neodešle, dokud neschválíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Antworte bis %3$@. Nichts wird gesendet, bevor du genehmigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Answer by %3$@. Nothing is sent until you approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Responde antes de %3$@. No se envía nada hasta que apruebes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Vasta hiljemalt %3$@. Midagi ei saadeta enne, kui kinnitad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Répondez avant %3$@. Rien n'est envoyé tant que vous n'approuvez pas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Odgovorite do: %3$@. Ništa se ne šalje dok ne odobrite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Válaszolj eddig: %3$@. Semmi sem megy ki, amíg jóvá nem hagyod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Պատասխանեք մինչև՝ %3$@. Ոչինչ չի ուղարկվի, մինչև չհաստատեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Jawab sebelum %3$@. Tidak ada yang dikirim sampai Anda menyetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Rispondi entro le %3$@. Non viene inviato nulla finché non approvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@・%2$@。%3$@までに回答してください。承認するまで何も送信されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. უპასუხეთ ამ დრომდე: %3$@. არაფერი იგზავნება, სანამ არ დაამტკიცებთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. %3$@까지 응답하세요. 승인할 때까지 아무것도 보내지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Atsakykite iki %3$@. Niekas nesiunčiama, kol nepatvirtinsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Atbildi līdz %3$@. Nekas netiek nosūtīts, kamēr tu neapstiprini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Antwoord vóór %3$@. Er wordt niets verzonden tot je goedkeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Odpowiedz do %3$@. Nic nie zostanie wysłane, dopóki nie zatwierdzisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Responda até %3$@. Nada é enviado até aprovar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Responda até %3$@. Nada é enviado até aprovar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Răspundeți până la %3$@. Nimic nu se trimite până nu aprobați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Odpovedzte do %3$@. Nič sa neodošle, kým neschválite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Odgovorite do %3$@. Nič se ne pošlje, dokler ne odobrite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Përgjigjuni deri më: %3$@. Asgjë nuk dërgohet derisa të miratoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Odgovorite do: %3$@. Ništa se ne šalje dok ne odobrite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ ตอบภายใน %3$@ จะไม่มีอะไรถูกส่งจนกว่าคุณจะอนุมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Yanıt süresi: %3$@. Siz onaylayana kadar hiçbir şey gönderilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Hãy trả lời trước %3$@. Không có gì được gửi cho đến khi bạn phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@。請於%3$@前回覆。在您核准之前不會傳送任何內容。"
