    "receipt.signed_on_device_why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بـ %1$@، بمفتاح لا يغادر هذا الجهاز أبدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ilə, bu cihazı heç vaxt tərk etməyən açarla."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "С %1$@, с ключ, който никога не напуска това устройство."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ দিয়ে, এমন একটি কী দিয়ে যা এই ডিভাইস কখনও ছাড়ে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb %1$@, per una clau que no surt mai d'aquest dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přes %1$@, klíčem, který nikdy neopustí toto zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %1$@, durch einen Schlüssel, der dieses Gerät nie verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With %1$@, by a key that never leaves this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con %1$@, con una clave que nunca sale de este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ abil, võtmega, mis ei lahku kunagi sellest seadmest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec %1$@, par une clé qui ne quitte jamais cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באמצעות %1$@, במפתח שאף פעם לא עוזב את ההתקן הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ से, एक कुंजी से जो इस डिवाइस से कभी बाहर नहीं जाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
