        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach touche, écrit et fait défiler dans cette app sous vos yeux. Il ne confirme jamais rien. Touchez l'app pour le mettre en pause, ou touchez Arrêter pour terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tocca, scrive e scorre in questa app mentre guardi. Non conferma mai nulla. Tocca l'app per metterlo in pausa o tocca Ferma per terminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが見ている間に、Coachがこのアプリでタップ、入力、スクロールを行います。何かを確定することはありません。一時停止するにはアプリに触れ、終了するには「停止」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach는 내가 지켜보는 동안 이 앱에서 탭하고, 입력하고, 스크롤합니다. 무엇도 확정하지 않습니다. 일시 중지하려면 앱을 터치하고, 끝내려면 중지를 탭하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach liečia, rašo ir slenka šioje programėlėje, kol jūs stebite. Jis niekada nieko netvirtina. Palieskite programėlę, kad jį pristabdytumėte, arba palieskite „Nutraukti Coach“, kad baigtumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach pieskaras, raksta un ritina šajā lietotnē, kamēr tu skaties. Tas nekad neko neapstiprina. Pieskaries lietotnei, lai to iepauzētu, vai pieskaries “Pārtraukt”, lai to beigtu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tikt, typt en scrollt in deze app terwijl je kijkt. Het bevestigt nooit iets. Raak de app aan om het te pauzeren, of tik op Stoppen om het te beëindigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dotyka, pisze i przewija w tej aplikacji, gdy patrzysz. Nigdy niczego nie potwierdza. Dotknij aplikacji, aby go wstrzymać, lub Zatrzymaj, aby zakończyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach toca, escreve e desliza nesta app enquanto observa. Nunca confirma nada. Toque na app para o pausar ou em Parar para terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach toca, escreve e desliza neste app enquanto você observa. Nunca confirma nada. Toque no app para pausar ou em Parar para terminar."
          }
        }
      }
    },
