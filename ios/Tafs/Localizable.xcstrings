    "push.channel.holds_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Aufruf wird für deine Antwort zurückgehalten. Nichts wird gesendet, bevor du ihn genehmigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A call is held for your answer. Nothing is sent until you approve it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una llamada está retenida a la espera de tu respuesta. No se envía nada hasta que la apruebes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appel est retenu en attente de votre réponse. Rien n'est envoyé tant que vous ne l'approuvez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chiamata è trattenuta in attesa della tua risposta. Non viene inviato nulla finché non la approvi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aanroep wordt vastgehouden voor je antwoord. Er wordt niets verzonden tot je het goedkeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wywołanie jest oczekujące na Twoją odpowiedź. Nic nie zostanie wysłane, dopóki go nie zatwierdzisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma chamada está retida à espera da sua resposta. Nada é enviado até a aprovar."
          }
        }
      }
    },
