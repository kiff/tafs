            "value": "Asnjë taf nuk përdor %1$@ tani."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedan taf sada ne koristi aplikaciju %1$@."
          }
        },
        "th": {
