        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome naršyklėje atidarykite tafs plėtinį ir įveskite šį kodą. Jis galioja 10 minučių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārlūkā Chrome atver tafs paplašinājumu un ievadi šo kodu. Tas derīgs 10 minūtes."
