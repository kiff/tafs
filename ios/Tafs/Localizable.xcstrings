    "sample.brief.expires.question": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Daşıyıcının iddia müddəti 12:00-da bitməzdən əvvəl #5098 sifarişi üçün yeni bağlama göndərilsin?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да изпратим ли нова пратка за поръчка № 5098, преди срокът за рекламация на куриера да изтече в 12:00?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslat novou zásilku k objednávce č. 5098, než ve 12:00 skončí lhůta na reklamaci u dopravce?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neues Paket für Bestellung #5098 senden, bevor die Reklamationsfrist des Versanddienstes um 12:00 endet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a new parcel for order #5098 before the carrier's claim window closes at 12:00?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Enviar un paquete nuevo para el pedido #5098 antes de que cierre el plazo de reclamación del transportista a las 12:00?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas saata tellimusele #5098 uus pakk enne, kui vedaja nõuete aeg kell 12:00 sulgub?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer un nouveau colis pour la commande #5098 avant la fin du délai de réclamation du transporteur à 12:00 ?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslati novu pošiljku za narudžbu #5098 prije nego što se u 12:00 zatvori rok za reklamaciju kod prijevoznika?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Küldjünk új csomagot az 5098-as rendeléshez, mielőtt a fuvarozó reklamációs határideje 12:00-kor lejár?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ուղարկե՞լ նոր ծանրոց #5098 պատվերի համար, նախքան փոխադրողի հայցի ժամկետը փակվելը 12:00-ին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim paket baru untuk pesanan #5098 sebelum batas klaim kurir ditutup pukul 12:00?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spedire un nuovo pacco per l'ordine #5098 prima che il termine di reclamo del corriere scada alle 12:00?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配送業者の補償申請期限の12:00までに、注文 #5098の荷物を再送しますか？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაიგზავნოს ახალი ამანათი შეკვეთისთვის #5098, სანამ გადამზიდავის საჩივრის ვადა 12:00-ზე ჩაიკეტება?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "택배사 클레임 기간이 12:00에 끝나기 전에 주문 #5098의 새 소포를 보낼까요?"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išsiųsti naują siuntinį pagal užsakymą #5098, kol 12:00 baigsis vežėjo pretenzijų terminas?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosūtīt jaunu paku pasūtījumam #5098, pirms 12:00 beidzas pārvadātāja pretenziju termiņš?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nieuw pakket sturen voor bestelling #5098 voordat de claimtermijn van de vervoerder om 12:00 sluit?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłać nową paczkę do zamówienia #5098, zanim termin reklamacji u przewoźnika minie o 12:00?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar uma nova encomenda para o pedido #5098 antes de o prazo de reclamação da transportadora fechar às 12:00?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar uma nova encomenda para o pedido #5098 antes de o prazo de reclamação da transportadora fechar às 12:00?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiteți un colet nou pentru comanda nr. 5098 înainte să se închidă termenul de reclamație al curierului, la 12:00?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslať novú zásielku k objednávke č. 5098, kým o 12:00 skončí lehota na reklamáciu u prepravcu?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošljem novo pošiljko za naročilo št. 5098, preden se ob 12:00 zapre rok za reklamacijo pri prevozniku?"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Të dërgohet një pako e re për porosinë #5098 para se të mbyllet në 12:00 afati i kërkesës së transportuesit?"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslati novu pošiljku za porudžbinu #5098 pre nego šta se u 12:00 zatvori rok za reklamaciju kod prevoznika?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งพัสดุชิ้นใหม่สำหรับออเดอร์ #5098 ก่อนที่ช่วงเวลาเคลมของผู้ขนส่งจะปิดเวลา 12:00 หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşıyıcının talep süresi saat 12:00'de kapanmadan önce #5098 numaralı sipariş için yeni bir paket gönderilsin mi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi một bưu kiện mới cho đơn #5098 trước khi thời hạn khiếu nại của hãng vận chuyển kết thúc lúc 12:00?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要在貨運公司的理賠期限於 12:00 結束前，為訂單 #5098 補寄新包裹嗎？"
          }
        }
      }
    },
    "sample.brief.expires.why": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yolda itib, 10 gündür skan yoxdur; %1$@ bu səhər daşıyıcını yoxladı."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изгубена при транспорта, 10 дни без сканиране; %1$@ провери при куриера тази сутрин."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ztracena při přepravě, 10 dní bez skenu; %1$@ dnes ráno ověřil stav u dopravce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterwegs verloren, seit 10 Tagen kein Scan; %1$@ hat heute Morgen beim Versanddienst nachgesehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost in transit, 10 days without a scan; %1$@ checked the carrier this morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdido en tránsito, 10 días sin escaneo; %1$@ consultó al transportista esta mañana."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadunud teel, 10 päeva ilma skannimiseta; %1$@ kontrollis vedajat täna hommikul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdu en transit, 10 jours sans scan ; %1$@ a vérifié auprès du transporteur ce matin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgubljeno u prijevozu, 10 dana bez skeniranja; %1$@ je jutros provjerio prijevoznika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szállítás közben elveszett, 10 napja nincs beolvasás; %1$@ ma reggel ellenőrizte a fuvarozónál."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կորել է տրանզիտում, 10 օր առանց սկանավորման․ %1$@-ը այսօր առավոտյան ստուգեց փոխադրողին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilang dalam pengiriman, 10 hari tanpa pemindaian; %1$@ memeriksa kurir pagi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perso in transito, 10 giorni senza scansione; %1$@ ha controllato con il corriere stamattina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輸送中に紛失、10日間スキャン記録なし。%1$@が今朝配送業者を確認しました。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაიკარგა ტრანზიტში, 10 დღე სკანირების გარეშე; %1$@-მა გადამზიდავი დღეს დილით შეამოწმა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배송 중 분실, 10일 동안 스캔 기록 없음. %1$@이(가) 오늘 아침 택배사를 확인했습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamestas pakeliui, 10 dienų be nuskaitymo; %1$@ šį rytą patikrino vežėją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazudusi ceļā, 10 dienas bez skenēšanas; %1$@ šorīt pārbaudīja pārvadātāju."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderweg kwijt, 10 dagen geen scan; %1$@ heeft vanochtend bij de vervoerder gekeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaginęła w drodze, 10 dni bez skanu; %1$@ sprawdził u przewoźnika dziś rano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdida em trânsito, 10 dias sem leitura; o %1$@ consultou a transportadora esta manhã."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdida em trânsito, 10 dias sem leitura; o %1$@ consultou a transportadora esta manhã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierdut în tranzit, 10 zile fără scanare; %1$@ a verificat la curier azi-dimineață."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stratená pri preprave, 10 dní bez skenu; %1$@ dnes ráno overil stav u prepravcu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgubljena med prevozom, 10 dni brez skeniranja; %1$@ je zjutraj preveril pri prevozniku."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Humbur gjatë transportit, 10 ditë pa skanim; %1$@ e kontrolloi transportuesin këtë mëngjes."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgubljeno u prevozu, 10 dana bez skeniranja; %1$@ je jutros proverio prevoznika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูญหายระหว่างขนส่ง 10 วันไม่มีการสแกน %1$@ ตรวจสอบผู้ขนส่งเมื่อเช้านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşıma sırasında kayboldu, 10 gündür taranmadı; %1$@ bu sabah taşıyıcıyı kontrol etti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thất lạc khi vận chuyển, 10 ngày không có lần quét nào; %1$@ đã kiểm tra hãng vận chuyển sáng nay."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "運送途中遺失，10 天沒有掃描紀錄；%1$@ 今天早上已向貨運公司查詢。"
          }
        }
      }
    },
