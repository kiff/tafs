    "coach.ask_anything_line": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte einen neuen taf ein, verbinde eine App oder ändere, wie einer arbeitet. Jede Verbindung und jede Card wartet auf deine Genehmigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up a new taf, connect an app, or change how one works. Each connection and each Card waits for your approval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un taf nuevo, conecta una app o cambia cómo funciona uno. Cada conexión y cada Card esperan tu aprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez un nouveau taf, connectez une app ou changez le fonctionnement d'un taf. Chaque connexion et chaque Card attend votre approbation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un nuovo taf, collega un'app o cambia come funziona un taf. Ogni collegamento e ogni Card aspettano la tua approvazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een nieuw taf in, koppel een app of verander hoe er een werkt. Elke koppeling en elke Card wacht op je goedkeuring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skonfiguruj nowego tafa, połącz aplikację albo zmień sposób działania tafa. Każde połączenie i każda Card czekają na Twoje zatwierdzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure um novo taf, ligue uma app ou altere o funcionamento de um. Cada ligação e cada Card aguardam a sua aprovação."
          }
        }
      }
    },
    "coach.ask_not_this_cards": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup hat dieses Telefon gebeten, etwas zu signieren, das nicht zu dieser Karte gehört. Es wurde nichts signiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup asked this phone to sign something that isn't this card's. Nothing was signed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración pidió a este teléfono firmar algo que no es de esta tarjeta. No se firmó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Configuration a demandé à ce téléphone de signer quelque chose qui n'appartient pas à cette fiche. Rien n'a été signé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione ha chiesto a questo telefono di firmare qualcosa che non appartiene a questa scheda. Non è stato firmato nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup vroeg deze telefoon iets te ondertekenen dat niet bij deze kaart hoort. Er is niets ondertekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja poprosiła ten telefon o podpisanie czegoś, co nie należy do tej karty. Nic nie zostało podpisane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Configuração pediu a este telefone para assinar algo que não pertence a este cartão. Nada foi assinado."
          }
        }
      }
    },
