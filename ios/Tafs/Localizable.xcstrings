    "taf.remove.cards_left|one": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF Card-larından %1$@ ədədini ləğv etmədi: onları KIFF-də ləğv edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF не оттегли %1$@ от неговите Cards: оттеглете я в KIFF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF neodvolal %1$@ jeho Card: odvolejte ji v KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hat %1$@ seiner Cards nicht widerrufen: Widerrufe sie in KIFF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF didn't revoke %1$@ of its Cards: revoke them in KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no revocó %1$@ de sus Cards: revócala en KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei tühistanud selle Cardidest %1$@: tühista see KIFFis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas révoqué %1$@ de ses Cards : révoquez-la dans KIFF."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nije opozvao %1$@ njegov Card: opozovite ga u KIFF-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF nem vonta vissza %1$@ Cardját: vond vissza a KIFF-ben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը չեղարկեց նրա Card-երից %1$@-ը․ չեղարկեք KIFF-ում։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non ha revocato %1$@ delle sue Card: revocala in KIFF."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-მა მისი %1$@ Card არ გააუქმა: გააუქმეთ KIFF-ში."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF neatšaukė %1$@ jo Card: atšaukite ją KIFF."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF neatsauca %1$@ no tā Card: atsauc to KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF heeft %1$@ van zijn Cards niet ingetrokken: trek die in bij KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie unieważnił %1$@ z jego Card: unieważnij ją w KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não revogou %1$@ dos seus Cards: revogue-o no KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não revogou %1$@ dos seus Cards: revogue-o no KIFF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nu a revocat %1$@ dintre Cardurile sale: revocați-l în KIFF."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF neodvolal %1$@ jeho Card: odvolajte ju v KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ni odvzel %1$@ njegove Card: odvzemite jo v KIFF."
          }
        },
        "sq": {
          "stringUnit": {
