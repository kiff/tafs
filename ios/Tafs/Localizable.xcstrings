    "needs_you.expired_line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت المهلة. لم يرد أحد في الوقت المناسب فرفضه KIFF ولم يُرسل شيء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtı bitdi. Heç kim vaxtında cavab vermədi, ona görə KIFF onu rədd etdi və heç nə göndərilmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтекло. Никой не отговори навреме, затова KIFF го отказа и нищо не беше изпратено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেয়াদ শেষ। কেউ সময়মতো উত্তর দেয়নি, তাই KIFF এটি প্রত্যাখ্যান করেছে এবং কিছু পাঠানো হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Caducat. Ningú no ha respost a temps, així que KIFF ho ha rebutjat i no s'ha enviat res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypršelo. Nikdo neodpověděl včas, takže to KIFF odmítl a nic se neodeslalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgelaufen. Niemand hat rechtzeitig geantwortet, daher hat KIFF es abgelehnt, und es wurde nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expired. Nobody answered in time, so KIFF refused it and nothing was sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caducada. Nadie respondió a tiempo, así que KIFF la rechazó y no se envió nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aegunud. Keegi ei vastanud õigel ajal, seega KIFF keeldus ja midagi ei saadetud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expiré. Personne n'a répondu à temps : KIFF l'a donc refusé et rien n'a été envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פג תוקף. אף אחד לא השיב בזמן, ולכן KIFF דחה והבקשה לא נשלחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय खत्म। किसी ने समय पर उत्तर नहीं दिया, इसलिए KIFF ने इसे अस्वीकार कर दिया और कुछ नहीं भेजा गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isteklo. Nitko nije odgovorio na vrijeme pa je KIFF to odbio i ništa nije poslano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejárt. Senki sem válaszolt időben, ezért a KIFF elutasította, és semmi sem ment el."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ժամկետը լրացավ։ Ոչ ոք ժամանակին չպատասխանեց, ուստի KIFF-ը մերժեց, և ոչինչ չուղարկվեց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedaluwarsa. Tidak ada yang menjawab tepat waktu, jadi KIFF menolaknya dan tidak ada yang dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaduta. Nessuno ha risposto in tempo, quindi KIFF l'ha rifiutata e non è stato inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限切れです。時間内に誰も回答しなかったため、KIFFが拒否し、何も送信されませんでした。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვადა გაუვიდა. ვერავინ უპასუხა დროზე, ამიტომ KIFF-მა უარი თქვა და არაფერი გაიგზავნა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផុតកំណត់។ គ្មាននរណាឆ្លើយទាន់ពេលទេ ដូច្នេះ KIFF បានបដិសេធ ហើយគ្មានអ្វីត្រូវបានផ្ញើទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만료되었습니다. 제때 답변한 사람이 없어 KIFF가 거절했고, 아무것도 보내지 않았습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໝົດອາຍຸ. ບໍ່ມີໃຜຕອບທັນເວລາ ສະນັ້ນ KIFF ປະຕິເສດ ແລະ ບໍ່ມີຫຍັງຖືກສົ່ງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebegalioja. Niekas neatsakė laiku, todėl KIFF ją atmetė ir niekas neišsiųsta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beidzies. Neviens laikus neatbildēja, tāpēc KIFF to atteica un nekas netika nosūtīts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Истечено. Никој не одговори навреме, па KIFF го одби и ништо не е испратено."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хугацаа дууссан. Хэн ч цагтаа хариулаагүй тул KIFF татгалзсан бөгөөд юу ч илгээгдээгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "समय सकियो। कसैले समयमा जवाफ दिएनन्, त्यसैले KIFF ले अस्वीकार गर्‍यो र केही पठाइएन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlopen. Niemand antwoordde op tijd, dus KIFF heeft het geweigerd en is er niets verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygasło. Nikt nie odpowiedział na czas, więc KIFF to odrzucił i nic nie zostało wysłane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Expirado. Ninguém respondeu a tempo, por isso o KIFF recusou e nada foi enviado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expirado. Ninguém respondeu a tempo, por isso o KIFF recusou e nada foi enviado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Expirat. Nimeni nu a răspuns la timp, așa că KIFF l-a refuzat și nu s-a trimis nimic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypršalo. Nikto neodpovedal včas, takže to KIFF odmietol a nič sa neodoslalo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poteklo. Nihče ni pravočasno odgovoril, zato je KIFF to zavrnil in nič ni bilo poslano."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Skadoi. Askush nuk u përgjigj në kohë, ndaj KIFF e refuzoi dhe asgjë nuk u dërgua."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Isteklo. Nitko nije odgovorio na vreme pa je KIFF to odbio i ništa nije poslano."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมดอายุแล้ว ไม่มีใครตอบทันเวลา KIFF จึงปฏิเสธและไม่มีอะไรถูกส่ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Möhleti gutardy. Hiç kim wagtynda jogap bermedi, şonuň üçin KIFF ony ret etdi we hiç zat iberilmedi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süresi doldu. Kimse zamanında yanıtlamadı, bu yüzden KIFF reddetti ve hiçbir şey gönderilmedi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ختم ہو گیا۔ کسی نے وقت پر جواب نہیں دیا، اس لیے KIFF نے اسے مسترد کر دیا اور کچھ نہیں بھیجا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hết hạn. Không ai trả lời kịp thời nên KIFF đã từ chối và không có gì được gửi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已過期。沒有人及時回覆，因此 KIFF 已拒絕，也沒有傳送任何內容。"
          }
        }
      }
    },
