          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいtafの設定、アプリの接続、tafの動作の変更ができます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დააყენეთ ახალი taf, დააკავშირეთ აპი, ან შეცვალეთ, როგორ მუშაობს ერთი."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 taf를 설정하거나, 앱을 연결하거나, taf의 작동 방식을 바꾸세요."
