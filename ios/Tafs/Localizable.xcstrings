            "value": "Instalacija verzije %1$@ nije završena. %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@. verzió telepítése nem fejeződött be. %2$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տարբերակ %1$@-ի տեղադրումը չավարտվեց։ %2$@"
          }
        },
        "id": {
