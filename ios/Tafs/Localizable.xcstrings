    "connect.request_does_not_match_what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الطلب لا يطابق ما يعرضه، لذا لا يمكن الموافقة عليه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sorğu göstərdiyi şeyə uyğun gəlmir, ona görə təsdiqlənə bilməz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази заявка не съответства на това, което показва, така че не може да бъде одобрена."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অনুরোধ যা দেখাচ্ছে তার সঙ্গে মেলে না, তাই অনুমোদন করা যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta sol·licitud no coincideix amb el que mostra, així que no es pot aprovar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato žádost neodpovídá tomu, co ukazuje, takže ji nelze schválit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage stimmt nicht mit dem überein, was sie zeigt, daher kann sie nicht genehmigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request doesn't match what it shows, so it can't be approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud no coincide con lo que muestra, así que no se puede aprobar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See päring ei vasta sellele, mida see näitab, seega ei saa seda kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande ne correspond pas à ce qu'elle affiche : elle ne peut pas être approuvée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבקשה הזו לא תואמת למה שהיא מציגה, ולכן אי אפשר לאשר אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अनुरोध उससे मेल नहीं खाता जो वह दिखाता है, इसलिए मंज़ूर नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj zahtjev ne odgovara onome što prikazuje pa se ne može odobriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kérés nem egyezik azzal, amit mutat, ezért nem hagyható jóvá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հարցումը չի համապատասխանում նրան, ինչ ցույց է տալիս, ուստի չի կարող հաստատվել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan ini tidak cocok dengan yang ditampilkan, jadi tidak dapat disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa richiesta non corrisponde a ciò che mostra, quindi non può essere approvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストは表示内容と一致しないため、承認できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოთხოვნა არ ემთხვევა იმას, რასაც აჩვენებს, ამიტომ ვერ დამტკიცდება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សំណើនេះមិនត្រូវនឹងអ្វីដែលវាបង្ហាញទេ ដូច្នេះមិនអាចអនុម័តបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청은 표시된 내용과 일치하지 않아 승인할 수 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຳຂໍນີ້ບໍ່ກົງກັບສິ່ງທີ່ມັນສະແດງ ສະນັ້ນອະນຸມັດບໍ່ໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ši užklausa neatitinka to, ką rodo, todėl jos patvirtinti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis pieprasījums neatbilst tam, ko tas rāda, tāpēc to nevar apstiprināt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова барање не одговара на она што го покажува, па не може да се одобри."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ хүсэлт өөрийн харуулсантай таарахгүй тул зөвшөөрч болохгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो अनुरोध यसले देखाएको कुरासँग मेल खाँदैन, त्यसैले स्वीकृत गर्न सकिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verzoek komt niet overeen met wat het toont, dus het kan niet worden goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prośba nie zgadza się z tym, co pokazuje, więc nie można jej zatwierdzić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido não corresponde ao que mostra, por isso não pode ser aprovado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido não corresponde ao que mostra, por isso não pode ser aprovado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această solicitare nu corespunde cu ce afișează, așa că nu poate fi aprobată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto žiadosť nezodpovedá tomu, čo ukazuje, takže ju nemožno schváliť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta zahteva se ne ujema s tem, kar prikazuje, zato je ni mogoče odobriti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo kërkesë nuk përputhet me atë që shfaq, ndaj nuk mund të miratohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj zahtev ne odgovara onome šta prikazuje pa se ne može odobriti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอนี้ไม่ตรงกับสิ่งที่มันแสดง จึงอนุมัติไม่ได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu haýyş görkezýän zadyna gabat gelmeýär, şonuň üçin tassyklanyp bilinmeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istek, gösterdiğiyle eşleşmiyor, bu yüzden onaylanamaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ درخواست اس سے نہیں ملتی جو وہ دکھاتی ہے، اس لیے منظور نہیں کی جا سکتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu này không khớp với điều nó hiển thị nên không thể phê duyệt."
          }
        },
        "zh-Hant": {
