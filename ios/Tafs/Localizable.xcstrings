        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս դուռն այսօրվա համար ստացավ հաղորդագրություններ զուգակցված չեղած մարդկանցից։ %1$@ ավելին դեն գցվեց։"
