    "taf.revoke_body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Heç bir yeni əməliyyat keçmir. Artıq edilmiş hər şey edilmiş qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Никое ново действие не минава. Вече направеното остава направено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná nová akce neprojde. Co už je hotové, zůstává hotové."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine neue Aktion geht durch. Was schon erledigt ist, bleibt erledigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No new action goes through. Anything already done stays done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se completa ninguna acción nueva. Lo que ya se hizo se mantiene."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ükski uus toiming ei lähe läbi. See, mis on juba tehtud, jääb tehtuks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune nouvelle action ne passe. Ce qui est déjà fait le reste."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedna nova radnja ne prolazi. Sve što je već učinjeno ostaje učinjeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmilyen új művelet nem megy át. Ami már megtörtént, az megtörtént marad."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոչ մի նոր գործողություն չի անցնում։ Ինչ արդեն արվել է, արված է մնում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tindakan baru yang lolos. Apa pun yang sudah dilakukan tetap telah dilakukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna nuova azione va a buon fine. Ciò che è già stato fatto resta fatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい操作は通りません。すでに完了したものはそのままです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არც ერთი ახალი მოქმედება არ გადის. რაც უკვე გაკეთდა, გაკეთებული რჩება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 행동은 더 이상 진행되지 않습니다. 이미 한 일은 그대로 남습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Joks naujas veiksmas neatliekamas. Kas jau padaryta, lieka padaryta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neviena jauna darbība netiek izpildīta. Jau izdarītais paliek izdarīts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er gaat geen nieuwe actie meer door. Wat al is gedaan, blijft gedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna nowa akcja nie przejdzie. To, co już zostało zrobione, pozostaje zrobione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma ação nova é concluída. O que já foi feito mantém-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma ação nova é concluída. O que já foi feito continua."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio acțiune nouă nu trece. Ce s-a făcut deja rămâne făcut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadna nová akcia neprejde. Čo už je hotové, zostáva hotové."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobeno novo dejanje ne gre skozi. Kar je že opravljeno, ostane opravljeno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Asnjë veprim i ri nuk kalon. Çdo gjë që është bërë tashmë mbetet e bërë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedna nova radnja ne prolazi. Sve šta je već učinjeno ostaje učinjeno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการกระทำใหม่ผ่านไปได้ สิ่งที่ทำไปแล้วยังคงเป็นอย่างนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir yeni eylem geçmez. Daha önce yapılan her şey yapılmış kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không hành động mới nào được đi qua. Những gì đã làm vẫn giữ nguyên."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會再有新的動作通過。已完成的事項維持不變。"
          }
        }
      }
    },
    "taf.revoke_needs_approver": {
      "extractionState": "manual",
      "localizations": {
        "az": {
