    "watch.glance_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele dich brauchen, nie was oder wer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many need you, never what or who."
          }
        },
        "es": {
