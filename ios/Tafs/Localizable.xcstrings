    "needs_you.your_step.set_up_hello": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط Windows Hello (يكفي رمز PIN) لتردّ هنا، أو ردّ على هاتفك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada cavab vermək üçün Windows Hello qurun (PIN kifayətdir) və ya telefonunuzda cavab verin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте Windows Hello (достатъчен е ПИН), за да отговаряте тук, или отговорете на телефона си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে উত্তর দিতে Windows Hello সেট আপ করুন (একটি PIN-ই যথেষ্ট), অথবা আপনার ফোনে উত্তর দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura Windows Hello (n'hi ha prou amb un PIN) per respondre aquí, o respon al telèfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte Windows Hello (stačí PIN) a odpovídejte tady, nebo odpovězte v telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte Windows Hello ein (eine PIN reicht), um hier zu antworten, oder antworte auf deinem Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up Windows Hello (a PIN is enough) to answer here, or answer on your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura Windows Hello (basta con un PIN) para responder aquí, o responde desde tu teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Siin vastamiseks seadista Windows Hello (piisab PIN-koodist) või vasta telefonis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez Windows Hello (un code PIN suffit) pour répondre ici, ou répondez depuis votre téléphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להגדיר Windows Hello (מספיק PIN) כדי להשיב כאן, או להשיב בטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ उत्तर देने के लिए Windows Hello सेट करें (PIN काफ़ी है), या अपने फ़ोन पर उत्तर दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite Windows Hello (dovoljan je PIN) da biste odgovarali ovdje ili odgovorite na telefonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsd be a Windows Hellót (egy PIN-kód elég), hogy itt válaszolhass, vagy válaszolj a telefonodon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարգավորեք Windows Hello (PIN-ը բավական է)՝ այստեղ պատասխանելու համար, կամ պատասխանեք ձեր հեռախոսով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapkan Windows Hello (PIN sudah cukup) untuk menjawab di sini, atau jawab di ponsel Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura Windows Hello (basta un PIN) per rispondere qui, oppure rispondi dal tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで回答するにはWindows Hello（PINだけでも可）を設定するか、スマートフォンで回答してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დააყენეთ Windows Hello (PIN საკმარისია) აქ საპასუხოდ, ან უპასუხეთ ტელეფონზე."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រៀបចំ Windows Hello (PIN គ្រប់គ្រាន់) ដើម្បីឆ្លើយនៅទីនេះ ឬឆ្លើយនៅលើទូរសព្ទរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 답변하려면 Windows Hello를 설정하세요(PIN이면 충분합니다). 또는 휴대폰에서 답변하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕັ້ງ Windows Hello (PIN ກໍພໍ) ເພື່ອຕອບຢູ່ນີ້ ຫຼື ຕອບໃນໂທລະສັບຂອງທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nustatykite Windows Hello (pakanka PIN), kad galėtumėte atsakyti čia, arba atsakykite telefone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iestati Windows Hello (pietiek ar PIN), lai atbildētu šeit, vai atbildi savā tālrunī."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постави Windows Hello (доволен е PIN) за да одговараш тука, или одговори на твојот телефон."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энд хариулахын тулд Windows Hello (PIN хангалттай) тохируулна уу, эсвэл утсан дээрээ хариулна уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ जवाफ दिन Windows Hello (PIN पर्याप्त छ) सेट गर्नुहोस्, वा आफ्नो फोनमा जवाफ दिनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel Windows Hello in (een pincode is genoeg) om hier te antwoorden, of antwoord vanaf je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skonfiguruj Windows Hello (wystarczy PIN), aby odpowiadać tutaj, lub odpowiedz na telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o Windows Hello (basta um PIN) para responder aqui, ou responda a partir do seu telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o Windows Hello (basta um PIN) para responder aqui, ou responda a partir do seu telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurați Windows Hello (un PIN e suficient) pentru a răspunde aici sau răspundeți pe telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte Windows Hello (stačí PIN) a odpovedajte tu, alebo odpovedzte v telefóne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavite Windows Hello (zadošča PIN), da odgovarjate tukaj, ali odgovorite v telefonu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguroni Windows Hello (mjafton një PIN) për t'u përgjigjur këtu, ose përgjigjuni në telefonin tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Podesite Windows Hello (dovoljan je PIN) da biste odgovarali ovdje ili odgovorite na telefonu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่า Windows Hello (ใช้ PIN ก็พอ) เพื่อตอบที่นี่ หรือตอบบนโทรศัพท์ของคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ýerde jogap bermek üçin Windows Hello guruň (PIN ýeterlik), ýa-da telefonyňyzda jogap beriň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada yanıtlamak için Windows Hello'yu kurun (bir PIN yeterli) veya telefonunuzdan yanıtlayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں جواب دینے کے لیے Windows Hello سیٹ اپ کریں (PIN کافی ہے)، یا اپنے فون پر جواب دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thiết lập Windows Hello (một PIN là đủ) để trả lời tại đây, hoặc trả lời trên điện thoại của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請設定 Windows Hello（PIN 即可）以便在此回覆，或在您的手機上回覆。"
          }
        }
      }
    },
    "onboarding.age": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب ألا يقل عمرك عن 16 عامًا، أو عن سن الموافقة الرقمية في بلدك إن كانت أعلى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ən azı 16 yaşınız olmalıdır, ya da ölkənizin rəqəmsal razılıq yaşı bundan yüksəkdirsə, o yaş."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Трябва да сте навършили поне 16 години или възрастта за цифрово съгласие във вашата държава, ако тя е по-висока."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বয়স কমপক্ষে ১৬ হতে হবে, অথবা আপনার দেশের ডিজিটাল সম্মতির বয়স এর চেয়ে বেশি হলে সেটি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has de tenir almenys 16 anys, o l'edat de consentiment digital del teu país si és més alta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Musí vám být alespoň 16 let, nebo víc, pokud je věk digitálního souhlasu ve vaší zemi vyšší."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst mindestens 16 sein, oder so alt wie das Alter für digitale Einwilligung in deinem Land, wenn es höher ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You must be at least 16, or your country's age of digital consent if it's higher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes tener al menos 16 años, o la edad de consentimiento digital de tu país si es mayor."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pead olema vähemalt 16-aastane või, kui sinu riigis on digitaalse nõusoleku vanus kõrgem, vähemalt selles vanuses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez avoir au moins 16 ans, ou l'âge du consentement numérique de votre pays s'il est plus élevé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עליך להיות בן 16 לפחות, או בגיל ההסכמה הדיגיטלית של המדינה שלך אם הוא גבוה יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी आयु कम से कम 16 वर्ष होनी चाहिए, या आपके देश में डिजिटल सहमति की आयु अधिक हो तो वह।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Morate imati najmanje 16 godina ili dob za digitalnu privolu u svojoj državi, ako je viša."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legalább 16 évesnek kell lenned, vagy annyinak, amennyi az országodban a digitális beleegyezési korhatár, ha az magasabb."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դուք պետք է առնվազն 16 տարեկան լինեք, կամ ձեր երկրի թվային համաձայնության տարիքի, եթե այն ավելի բարձր է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Usia Anda minimal 16 tahun, atau usia persetujuan digital di negara Anda jika lebih tinggi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi avere almeno 16 anni, o l'età del consenso digitale del tuo paese se è più alta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "16歳以上、またはお住まいの国のデジタル同意年齢がそれより高い場合はその年齢以上である必要があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უნდა იყოთ მინიმუმ 16 წლის, ან თქვენი ქვეყნის ციფრული თანხმობის ასაკის, თუ ის უფრო მაღალია."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកត្រូវមានអាយុយ៉ាងតិច ១៦ ឆ្នាំ ឬអាយុនៃការយល់ព្រមឌីជីថលរបស់ប្រទេសអ្នក ប្រសិនបើវាខ្ពស់ជាង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만 16세 이상이어야 하며, 거주 국가의 디지털 동의 연령이 더 높으면 그 연령 이상이어야 합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທ່ານຕ້ອງມີອາຍຸຢ່າງໜ້ອຍ 16 ປີ ຫຼື ອາຍຸຍິນຍອມດິຈິຕອນຂອງປະເທດທ່ານ ຖ້າສູງກວ່າ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jums turi būti ne mažiau kaip 16 metų arba tiek, koks yra jūsų šalies skaitmeninio sutikimo amžius, jei jis didesnis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tev jābūt vismaz 16 gadus vecam vai jābūt sasniegušam savas valsts digitālās piekrišanas vecumu, ja tas ir augstāks."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мора да имаш најмалку 16 години, или возраст на дигитална согласност во твојата земја ако е повисока."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та хамгийн багадаа 16 настай байх ёстой, эсвэл таны улсын дижитал зөвшөөрлийн нас үүнээс өндөр бол тэр насанд хүрсэн байх ёстой."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईं कम्तीमा १६ वर्षको हुनुपर्छ, वा तपाईंको देशको डिजिटल सहमतिको उमेर त्यसभन्दा बढी भए सोही उमेरको।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet minstens 16 zijn, of de leeftijd voor digitale toestemming in je land als die hoger is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Musisz mieć co najmniej 16 lat albo tyle, ile wynosi wiek zgody cyfrowej w Twoim kraju, jeśli jest wyższy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem de ter pelo menos 16 anos, ou a idade de consentimento digital do seu país, se for superior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você precisa ter pelo menos 16 anos, ou a idade de consentimento digital do seu país, se for maior."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trebuie să aveți cel puțin 16 ani sau vârsta consimțământului digital din țara dvs., dacă aceasta este mai mare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Musí vám byť aspoň 16 rokov, alebo viac, ak je vek digitálneho súhlasu vo vašej krajine vyšší."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stari morate biti vsaj 16 let ali več, če je starost za digitalno privolitev v vaši državi višja."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Duhet të jeni të paktën 16 vjeç, ose mosha e vendit tuaj për pëlqimin dixhital nëse është më e lartë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Morate imati najmanje 16 godina ili dob za digitalnu privolu u svojoj državi, ako je viša."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณต้องมีอายุอย่างน้อย 16 ปี หรือเท่ากับอายุที่ให้ความยินยอมทางดิจิทัลได้ในประเทศของคุณ หากสูงกว่านั้น"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýaşyňyz azyndan 16 bolmaly, ýa-da ýurduňyzyň sanly razylyk ýaşy has ýokary bolsa, şol."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az 16 yaşında olmalısınız; ülkenizin dijital rıza yaşı daha yüksekse o yaşta."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی عمر کم از کم 16 سال ہونی چاہیے، یا آپ کے ملک میں ڈیجیٹل رضامندی کی عمر اگر اس سے زیادہ ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn phải từ 16 tuổi trở lên, hoặc đủ tuổi đồng ý kỹ thuật số của quốc gia bạn nếu cao hơn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您必須年滿 16 歲，或達到您所在國家的數位同意年齡（若較高）。"
          }
        }
      }
    },
