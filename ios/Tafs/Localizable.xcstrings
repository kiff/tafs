    "needs_you.knocks|one": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat an seine Tür geklopft. Es wurde nichts unternommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone knocked at its door. Nothing was done."
          }
        },
        "es": {
