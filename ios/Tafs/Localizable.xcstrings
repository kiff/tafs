    "sample.log.s4_line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطرد 5098، للرد على عميله. مرجع، وليس بياناته."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlama 5098, müştərisinə cavab üçün. İstinaddır, məlumatları deyil."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пратка 5098, за отговор до клиента. Препратка, не данните ѝ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পার্সেল 5098, এর গ্রাহককে উত্তরের জন্য। একটি রেফারেন্স, এর তথ্য নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquet 5098, per a una resposta al seu client. Una referència, no les seves dades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásilka 5098, pro odpověď jejímu zákazníkovi. Odkaz, ne její data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket 5098, für eine Antwort an den Kunden. Ein Verweis, nicht seine Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcel 5098, for a reply to its customer. A reference, not its data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquete 5098, para responder a su cliente. Una referencia, no sus datos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakk 5098, vastuseks selle kliendile. Viide, mitte selle andmed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colis 5098, pour une réponse à son client. Une référence, pas ses données."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חבילה 5098, למענה ללקוח שלה. הפניה, לא הנתונים שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पार्सल 5098, उसके ग्राहक को उत्तर के लिए। एक संदर्भ, उसका डेटा नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošiljka 5098, za odgovor njezinu kupcu. Referenca, ne njezini podaci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az 5098-as csomag, a vásárlónak szóló válaszhoz. Hivatkozás, nem az adatai."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծանրոց 5098՝ նրա հաճախորդին պատասխանելու համար։ Հղում, ոչ թե նրա տվյալները։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket 5098, untuk membalas pelanggannya. Sebuah referensi, bukan datanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacco 5098, per una risposta al suo cliente. Un riferimento, non i suoi dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "荷物5098、顧客への返信のために引き渡し。データではなく参照のみ。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამანათი 5098, მისი კლიენტისთვის პასუხისთვის. მითითება და არა მისი მონაცემები."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កញ្ចប់ 5098 សម្រាប់ការឆ្លើយតបទៅអតិថិជនរបស់វា។ ជាឯកសារយោង មិនមែនទិន្នន័យរបស់វាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소포 5098, 고객에게 답장하기 위해 전달. 데이터가 아닌 참조만 전달."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ພັດສະດຸ 5098, ສຳລັບຄຳຕອບຫາລູກຄ້າຂອງມັນ. ການອ້າງອີງ, ບໍ່ແມ່ນຂໍ້ມູນຂອງມັນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Siuntinys 5098, atsakymui jo klientui. Nuoroda, o ne jo duomenys."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paka 5098, atbildei tās klientam. Atsauce, nevis tās dati."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пратка 5098, за одговор до нејзиниот клиент. Референца, не нејзините податоци."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Илгээмж 5098, үйлчлүүлэгчид нь хариулахад зориулсан. Лавлагаа, түүний өгөгдөл биш."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पार्सल ५०९८, यसका ग्राहकलाई जवाफ दिन। सन्दर्भ, यसको डेटा होइन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakket 5098, voor een antwoord aan de klant. Een verwijzing, niet de gegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paczka 5098, do odpowiedzi dla klienta. Odwołanie, nie jej dane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encomenda 5098, para uma resposta ao cliente. Uma referência, não os seus dados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encomenda 5098, para uma resposta ao cliente. Uma referência, não os seus dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coletul 5098, pentru un răspuns către client. O referință, nu datele sale."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásielka 5098, pre odpoveď jej zákazníkovi. Odkaz, nie jej údaje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošiljka 5098, za odgovor njeni stranki. Sklic, ne njeni podatki."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakoja 5098, për një përgjigje te klienti i saj. Një referencë, jo të dhënat e saj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošiljka 5098, za odgovor njenu kupcu. Referenca, ne njeni podaci."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พัสดุ 5098 เพื่อตอบลูกค้าของมัน เป็นเพียงการอ้างอิง ไม่ใช่ข้อมูลของมัน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket 5098, müşderisine jogap üçin. Salgylanma, onuň maglumaty däl."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket 5098, müşterisine yanıt için. Bir referans, verisi değil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پارسل 5098، اس کے گاہک کو جواب کے لیے۔ ایک حوالہ، اس کا ڈیٹا نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bưu kiện 5098, để trả lời khách hàng của nó. Chỉ là một tham chiếu, không phải dữ liệu của nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包裹 5098，用於回覆其客戶。僅是參照，不是它的資料。"
          }
        }
      }
    },
