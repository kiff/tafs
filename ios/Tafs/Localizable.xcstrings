    "alert.foot.cant_answer_holds": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişlər saxlanılan zənglərə cavab verə bilən insanlara gedir. Bu hesabda sizin rolunuz bunu edə bilməz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Известията отиват при хората, които могат да отговарят на задържани заявки. Ролята ви в този акаунт не може."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění chodí lidem, kteří smějí odpovídat na zadržená volání. Vaše role v tomto účtu nesmí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen gehen an die Personen, die zurückgehaltene Aufrufe beantworten dürfen. Deine Rolle in diesem Konto darf das nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts go to the people who may answer held calls. Your role on this account can't."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas van a las personas que pueden responder a las llamadas retenidas. Tu rol en esta cuenta no puede."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teavitused lähevad inimestele, kes tohivad kinni peetud päringutele vastata. Sinu roll sellel kontol ei tohi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes vont aux personnes qui peuvent répondre aux appels retenus. Votre rôle sur ce compte ne le peut pas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti idu ljudima koji smiju odgovarati na zadržane pozive. Vaša uloga na ovom računu ne smije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések azokhoz mennek, akik válaszolhatnak a visszatartott hívásokra. A szerepköröd ebben a fiókban erre nem jogosult."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծանուցումները գնում են նրանց, ովքեր կարող են պատասխանել պահված զանգերին։ Այս հաշվում ձեր դերը չի կարող։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan dikirim ke orang yang boleh menjawab panggilan yang ditahan. Peran Anda di akun ini tidak bisa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi vanno alle persone che possono rispondere alle chiamate trattenute. Il tuo ruolo in questo account non può."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は、保留中の呼び出しに回答できる人に届きます。このアカウントでのあなたの役割では回答できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეტყობინებები მიდის მათთან, ვისაც შეუძლია დაკავებულ ზარებზე პასუხი. ამ ანგარიშზე თქვენს როლს არ შეუძლია."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 보류된 호출에 답할 수 있는 사람에게 갑니다. 이 계정에서 내 역할로는 답할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pranešimai siunčiami žmonėms, kurie gali atsakyti į sulaikytas užklausas. Jūsų vaidmuo šioje paskyroje to neleidžia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paziņojumi tiek sūtīti tiem, kas drīkst atbildēt uz aizturētiem izsaukumiem. Tava loma šajā kontā to neļauj."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen gaan naar de mensen die vastgehouden aanroepen mogen beantwoorden. Jouw rol in dit account mag dat niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty trafiają do osób, które mogą odpowiadać na oczekujące wywołania. Twoja rola na tym koncie nie może."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas vão para as pessoas que podem responder a chamadas retidas. A sua função nesta conta não pode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas vão para as pessoas que podem responder a chamadas retidas. A sua função nesta conta não pode."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertele merg la persoanele care pot răspunde la apelurile reținute. Rolul dvs. în acest cont nu poate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenia chodia ľuďom, ktorí smú odpovedať na pozdržané volania. Vaša rola v tomto účte nesmie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opozorila gredo ljudem, ki smejo odgovarjati na zadržane klice. Vaša vloga v tem računu ne sme."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Njoftimet shkojnë te njerëzit që mund t'u përgjigjen thirrjeve të mbajtura. Roli juaj në këtë llogari nuk mundet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Obaveštenja idu ljudima koji smeju da odgovaraju na zadržane pozive. Vaša uloga na ovom nalogu ne sme."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนจะส่งถึงผู้ที่ตอบการเรียกที่ถูกพักไว้ได้ บทบาทของคุณในบัญชีนี้ทำไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarılar, tutulan çağrıları yanıtlayabilenlere gider. Bu hesaptaki rolünüz yanıtlayamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo được gửi tới những người có thể trả lời các yêu cầu đang giữ. Vai trò của bạn trong tài khoản này thì không."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知會傳給可回覆已保留呼叫的人。您在此帳號中的角色無法這麼做。"
          }
        }
      }
    },
    "alert.foot.tells_you_device": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-a sizin köməyiniz lazım olanda bu cihaz (%1$@) tafs bağlı olsa belə sizə xəbər verir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато taf има нужда от вас, този %1$@ ви уведомява, дори когато tafs е затворен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když vás taf potřebuje, tento %1$@ vám to oznámí, i když je tafs zavřený."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein taf dich braucht, meldet sich dieses %1$@, auch wenn tafs geschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a taf needs you, this %1$@ tells you, even with tafs closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un taf te necesita, este %1$@ te avisa aunque tafs esté cerrado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui taf vajab sind, annab see %1$@ sulle teada, isegi kui tafs on suletud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un taf vous attend, %2$@ vous prévient même si tafs est fermé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad taf treba vas, ovaj uređaj (%1$@) vas obavještava, čak i kad je tafs zatvoren."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha egy tafnak szüksége van rád, ez az eszköz (%1$@) szól, akkor is, ha a tafs be van zárva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երբ taf-ին ձեր օգնությունն է պետք, այս սարքը (%1$@) ձեզ կտեղեկացնի, նույնիսկ երբ tafs-ը փակ է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat sebuah taf membutuhkan Anda, %1$@ ini memberi tahu Anda, bahkan saat tafs ditutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un taf ti aspetta, questo %1$@ te lo dice anche con tafs chiusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafがあなたを必要とすると、tafsを閉じていてもこの%1$@でお知らせします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "როცა taf-ს თქვენი დახმარება სჭირდება, ეს მოწყობილობა (%1$@) გაცნობებთ, tafs დახურულიც რომ იყოს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf에 내가 필요하면 tafs가 닫혀 있어도 이 %1$@에서 알려 줍니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai taf jūsų laukia, šis įrenginys (%1$@) jums praneša, net kai tafs uždaryta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad taf gaida tevi, šis %1$@ tev to pasaka, pat ja tafs ir aizvērts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een taf op jou wacht, laat deze %1$@ het je weten, ook als tafs gesloten is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy taf czeka na Ciebie, ten %1$@ Cię o tym powiadomi, nawet gdy tafs jest zamknięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf precisa de si, este %1$@ avisa-o mesmo com o tafs fechado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf precisa de você, este %1$@ avisa você mesmo com o tafs fechado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când un taf are nevoie de dvs., acest dispozitiv (%1$@) vă anunță, chiar și cu tafs închis."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď vás taf potrebuje, tento %1$@ vám to oznámi, aj keď je tafs zatvorený."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko vas taf potrebuje, vam ta %1$@ to sporoči, tudi ko je tafs zaprt."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur një taf ka nevojë për ju, kjo pajisje (%1$@) ju njofton, edhe kur tafs është mbyllur."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad taf treba vas, ovaj uređaj (%1$@) vas obaveštava, čak i kad je tafs zatvoren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อ taf ต้องการคุณ %1$@เครื่องนี้จะแจ้งคุณ แม้ปิด tafs อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir taf'ın size ihtiyacı olduğunda, tafs kapalı olsa bile bu %1$@ size haber verir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một taf cần bạn, %1$@ này sẽ báo cho bạn, kể cả khi tafs đã đóng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 taf 需要您時，這部%1$@會通知您，即使 tafs 已關閉。"
          }
        }
      }
    },
