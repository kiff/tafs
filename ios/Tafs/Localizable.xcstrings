    "halt_all.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف كل taf دفعة واحدة. لا يُرسل شيء جديد حتى تستأنفها في tafs."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün taf-ları bir anda dayandırır. Siz tafs-da onları davam etdirənə qədər heç nə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спира всички tafs наведнъж. Нищо ново не се изпраща, докато не ги възобновите в tafs."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি taf একসঙ্গে বন্ধ করে। tafs-এ আবার চালু না করা পর্যন্ত নতুন কিছু পাঠানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Atura cada taf alhora. No s'envia res de nou fins que els reprenguis a tafs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví všechny tafy najednou. Nic nového se neodešle, dokud je v tafs znovu nespustíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält jeden taf sofort an. Nichts Neues wird gesendet, bis du sie in tafs fortsetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops every taf at once. Nothing new is sent until you resume them in tafs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea todos los tafs a la vez. No se envía nada nuevo hasta que los reanudes en tafs."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peatab kõik tafid korraga. Midagi uut ei saadeta enne, kui jätkad neid tafsis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque tous les tafs d'un coup. Rien de nouveau n'est envoyé tant que vous ne les reprenez pas dans tafs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוצר כל taf בבת אחת. שום דבר חדש לא נשלח עד שתחדש אותם ב-tafs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर taf को एक साथ रोकता है। जब तक आप tafs में उन्हें फिर शुरू नहीं करते, कुछ नया नहीं भेजा जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaustavlja svakog tafa odjednom. Ništa novo ne šalje se dok ih ne nastavite u tafsu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszerre leállítja az összes tafot. Semmi új nem megy ki, amíg a tafsban nem folytatod őket."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանգնեցնում է բոլոր taf-երը միանգամից։ Ոչինչ չի ուղարկվում, մինչև tafs-ում չվերսկսեք դրանք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan setiap taf sekaligus. Tidak ada yang baru dikirim sampai Anda melanjutkannya di tafs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca tutti i tafs in una volta. Non viene inviato nulla di nuovo finché non li riprendi in tafs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのtafを一度に止めます。tafsで再開するまで、新しいものは何も送信されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველა taf-ს ერთდროულად აჩერებს. არაფერი იგზავნება, სანამ tafs-ში არ განაახლებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ឈប់ taf ទាំងអស់ក្នុងពេលតែមួយ។ គ្មានអ្វីថ្មីត្រូវបានផ្ញើទេ រហូតដល់អ្នកបន្តពួកវានៅក្នុង tafs។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 taf를 한 번에 멈춥니다. tafs에서 재개할 때까지 새로 보내는 것은 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຢຸດທຸກ taf ພ້ອມກັນ. ບໍ່ມີຫຍັງໃໝ່ຖືກສົ່ງຈົນກວ່າທ່ານຈະສືບຕໍ່ພວກມັນໃນ tafs."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iškart sustabdo visus taf. Nieko naujo nesiunčiama, kol jų netęsite tafs programėlėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptur visus taf uzreiz. Nekas jauns netiek sūtīts, līdz tu tos turpini tafs lietotnē."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ги стопира сите tafови одеднаш. Ништо ново не се испраќа додека не ги продолжиш во tafs."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүх taf-ыг нэгэн зэрэг зогсооно. Та tafs дотор үргэлжлүүлэх хүртэл шинээр юу ч илгээгдэхгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सबै taf एकैपटक रोक्छ। तपाईंले tafs मा फेरि सुरु नगरेसम्म केही नयाँ पठाइँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet alle tafs in één keer stil. Er wordt niets nieuws verzonden tot je ze in tafs hervat."
          }
        },
        "pl": {
