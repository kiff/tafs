    "version.trial.ends_if_unused": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "istifadə olunmasa, %1$@ tarixində bitir"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "приключва на %1$@, ако не се използва"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "skončí %1$@, pokud se nepoužije"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "endet am %1$@, wenn ungenutzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ends %1$@ if unused"
          }
        },
        "es": {
