    "usage.solo_terms": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@. يتجدد في نهاية كل فترة (%2$@) حتى يُلغى. يمكنك الإلغاء في أي وقت من اشتراكات Google Play، قبل التجديد بيوم على الأقل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər %2$@ üçün %1$@. Ləğv edilənə qədər hər %2$@ yenilənir. İstənilən vaxt, yenilənmədən ən azı bir gün əvvəl, Google Play abunəliklərində ləğv edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ на %2$@. Подновява се всеки %2$@ до анулиране. Можете да анулирате по всяко време в абонаментите на Google Play, поне един ден преди подновяването."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি %2$@ %1$@। বাতিল না করা পর্যন্ত প্রতি %2$@ নবায়ন হয়। যেকোনো সময়, নবায়নের অন্তত একদিন আগে, Google Play-র সাবস্ক্রিপশনে বাতিল করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ per %2$@. Es renova cada %2$@ fins que es cancel·li. Cancel·la quan vulguis a les subscripcions de Google Play, almenys un dia abans de la renovació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ za %2$@. Obnovuje se každý %2$@, dokud ho nezrušíte. Zrušit můžete kdykoli v předplatných Google Play, nejpozději den před obnovením."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pro %2$@. Verlängert sich nach jedem Abrechnungszeitraum (%2$@), bis du kündigst. Kündige jederzeit unter den Abonnements von Google Play, spätestens einen Tag vor der Verlängerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a %2$@. Renews every %2$@ until cancelled. Cancel any time in Google Play's subscriptions, at least a day before it renews."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ por %2$@. Se renueva cada %2$@ hasta que se cancele. Cancela cuando quieras en las suscripciones de Google Play, al menos un día antes de la renovación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@. Uueneb iga %2$@, kuni tühistad. Tühista igal ajal Google Play tellimustes, vähemalt päev enne uuenemist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ par %2$@. Se renouvelle chaque %2$@ jusqu'à résiliation. Résiliez à tout moment dans les abonnements Google Play, au moins un jour avant le renouvellement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ל%2$@. מתחדש כל %2$@ עד לביטול. אפשר לבטל בכל עת במנויים של Google Play, לפחות יום לפני החידוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ प्रति %2$@। रद्द होने तक हर %2$@ नवीनीकृत होता है। नवीनीकरण से कम से कम एक दिन पहले, Google Play की सदस्यताओं में किसी भी समय रद्द करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@. Obnavlja se na kraju svakog razdoblja (%2$@) dok se ne otkaže. Otkažite bilo kada u pretplatama Google Playa, najmanje dan prije obnove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@. Minden új %2$@ elején megújul, amíg le nem mondod. Bármikor lemondhatod a Google Play előfizetéseiben, legalább egy nappal a megújulás előtt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-ի համար։ Նորացվում է յուրաքանչյուր %2$@, մինչև չեղարկվի։ Չեղարկեք ցանկացած ժամանակ Google Play-ի բաժանորդագրություններում՝ նորացումից առնվազն մեկ օր առաջ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@. Diperpanjang di akhir setiap periode (%2$@) sampai dibatalkan. Batalkan kapan saja di langganan Google Play, minimal sehari sebelum diperpanjang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@/%2$@. Si rinnova ogni %2$@ finché non viene annullato. Annulla quando vuoi negli abbonamenti di Google Play, almeno un giorno prima del rinnovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@/%2$@。解約するまで%2$@ごとに更新されます。更新の1日前までなら、Google Playの定期購入でいつでも解約できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ამ პერიოდში: %2$@. ახლდება ყოველ პერიოდში (%2$@), სანამ არ გაუქმდება. გააუქმეთ ნებისმიერ დროს Google Play-ის გამოწერებში, განახლებამდე მინიმუმ ერთი დღით ადრე."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ក្នុងមួយ%2$@។ បន្តរាល់%2$@ រហូតដល់បោះបង់។ បោះបង់គ្រប់ពេលក្នុងការជាវរបស់ Google Play យ៉ាងតិចមួយថ្ងៃមុនពេលវាបន្ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매%2$@ %1$@. 취소할 때까지 매%2$@ 갱신됩니다. 갱신 최소 하루 전까지 Google Play 구독에서 언제든지 취소할 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ຕໍ່%2$@. ຕໍ່ອາຍຸທຸກ%2$@ ຈົນກວ່າຈະຍົກເລີກ. ຍົກເລີກໄດ້ທຸກເວລາໃນການສະໝັກຂອງ Google Play, ຢ່າງໜ້ອຍໜຶ່ງມື້ກ່ອນມັນຕໍ່ອາຍຸ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ per %2$@. Atnaujinama kas %2$@, kol atšauksite. Atšaukite bet kada Google Play prenumeratose, ne vėliau kaip likus dienai iki atnaujinimo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@. Atjaunojas reizi %2$@, līdz tiek atcelts. Atcel jebkurā laikā Google Play abonementos, vismaz dienu pirms atjaunošanas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ на %2$@. Се обновува секој %2$@ додека не се откаже. Откажи во кое било време во претплатите на Google Play, најмалку еден ден пред да се обнови."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-д %1$@. Цуцлах хүртэл %2$@ бүр сунгагдана. Сунгагдахаас дор хаяж нэг өдрийн өмнө Google Play-ийн захиалгууд хэсгээс хэдийд ч цуцлаж болно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति %2$@ %1$@। रद्द नगरेसम्म प्रत्येक %2$@ नवीकरण हुन्छ। नवीकरणभन्दा कम्तीमा एक दिन अघि Google Play का सदस्यताहरूमा जुनसुकै बेला रद्द गर्न सकिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ per %2$@. Wordt elke %2$@ verlengd tot je opzegt. Je kunt altijd opzeggen in de abonnementen van Google Play, minstens een dag voor de verlenging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@. Odnawia się co %2$@, dopóki nie anulujesz. Anuluj w dowolnym momencie w subskrypcjach Google Play, co najmniej dzień przed odnowieniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ por %2$@. Renova-se a cada %2$@ até ser cancelado. Cancele quando quiser nas subscrições do Google Play, pelo menos um dia antes da renovação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ por %2$@. É renovada a cada %2$@ até ser cancelada. Cancele quando quiser nas assinaturas do Google Play, pelo menos um dia antes da renovação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pe %2$@. Se reînnoiește în fiecare %2$@ până la anulare. Puteți anula oricând în abonamentele Google Play, cu cel puțin o zi înainte de reînnoire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ za %2$@. Obnovuje sa každý %2$@, kým ho nezrušíte. Zrušiť môžete kedykoľvek v predplatnom Google Play, najneskôr deň pred obnovením."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ na %2$@. Podaljša se vsak %2$@, dokler ga ne prekličete. Prekličete ga lahko kadar koli v naročninah Google Play, vsaj dan pred podaljšanjem."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ për: %2$@. Rinovohet çdo: %2$@ derisa të anulohet. Anuloni në çdo kohë te abonimet e Google Play, të paktën një ditë para se të rinovohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@. Obnavlja se na kraju svakog razdoblja (%2$@) dok se ne otkaže. Otkažite bilo kada u pretplatama Google Playa, najmanje dan pre obnove."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@ ต่ออายุอัตโนมัติเมื่อสิ้นสุดแต่ละรอบ (%2$@) จนกว่าจะยกเลิก ยกเลิกได้ทุกเมื่อในการสมัครใช้งานของ Google Play อย่างน้อยหนึ่งวันก่อนต่ออายุ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@. Ýatyrylýança her %2$@ täzelenýär. Täzelenmeden azyndan bir gün öň, Google Play abunalarynda islendik wagt ýatyryň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@. İptal edilene kadar her dönem sonunda (%2$@) yenilenir. Yenilenmesinden en az bir gün önce, Google Play aboneliklerinden istediğiniz zaman iptal edin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ فی %2$@۔ منسوخ ہونے تک ہر %2$@ تجدید ہوتا ہے۔ تجدید سے کم از کم ایک دن پہلے Google Play کی سبسکرپشنز میں کسی بھی وقت منسوخ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@. Tự gia hạn vào cuối mỗi kỳ (%2$@) cho đến khi bị hủy. Hủy bất cứ lúc nào trong mục đăng ký của Google Play, ít nhất một ngày trước khi gia hạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@。每期結束時（%2$@）自動續訂，直到取消為止。可隨時在 Google Play 的訂閱中取消，請至少在續訂前一天取消。"
          }
        }
      }
    },
    "usage.solo_terms_trial": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجانًا لمدة %1$@، ثم %2$@ / %3$@. يتجدد في نهاية كل فترة (%3$@) حتى يُلغى. يمكنك الإلغاء في أي وقت من اشتراكات Google Play، قبل التجديد بيوم على الأقل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pulsuz, sonra hər %3$@ üçün %2$@. Ləğv edilənə qədər hər %3$@ yenilənir. İstənilən vaxt, yenilənmədən ən azı bir gün əvvəl, Google Play abunəliklərində ləğv edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Безплатно за %1$@, после %2$@ на %3$@. Подновява се всеки %3$@ до анулиране. Можете да анулирате по всяко време в абонаментите на Google Play, поне един ден преди подновяването."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ বিনামূল্যে, তারপর প্রতি %3$@ %2$@। বাতিল না করা পর্যন্ত প্রতি %3$@ নবায়ন হয়। যেকোনো সময়, নবায়নের অন্তত একদিন আগে, Google Play-র সাবস্ক্রিপশনে বাতিল করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis durant %1$@, després %2$@ per %3$@. Es renova cada %3$@ fins que es cancel·li. Cancel·la quan vulguis a les subscripcions de Google Play, almenys un dia abans de la renovació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdarma na %1$@, pak %2$@ za %3$@. Obnovuje se každý %3$@, dokud ho nezrušíte. Zrušit můžete kdykoli v předplatných Google Play, nejpozději den před obnovením."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kostenlos, dann %2$@ pro %3$@. Verlängert sich nach jedem Abrechnungszeitraum (%3$@), bis du kündigst. Kündige jederzeit unter den Abonnements von Google Play, spätestens einen Tag vor der Verlängerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free for %1$@, then %2$@ a %3$@. Renews every %3$@ until cancelled. Cancel any time in Google Play's subscriptions, at least a day before it renews."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis durante %1$@, luego %2$@ por %3$@. Se renueva cada %3$@ hasta que se cancele. Cancela cuando quieras en las suscripciones de Google Play, al menos un día antes de la renovación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasuta: %1$@, seejärel %2$@ / %3$@. Uueneb iga %3$@, kuni tühistad. Tühista igal ajal Google Play tellimustes, vähemalt päev enne uuenemist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pendant %1$@, puis %2$@ par %3$@. Se renouvelle chaque %3$@ jusqu'à résiliation. Résiliez à tout moment dans les abonnements Google Play, au moins un jour avant le renouvellement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חינם ל-%1$@, ואז %2$@ ל%3$@. מתחדש כל %3$@ עד לביטול. אפשר לבטל בכל עת במנויים של Google Play, לפחות יום לפני החידוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ मुफ़्त, फिर %2$@ प्रति %3$@। रद्द होने तक हर %3$@ नवीनीकृत होता है। नवीनीकरण से कम से कम एक दिन पहले, Google Play की सदस्यताओं में किसी भी समय रद्द करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besplatno: %1$@, zatim %2$@ / %3$@. Obnavlja se na kraju svakog razdoblja (%3$@) dok se ne otkaže. Otkažite bilo kada u pretplatama Google Playa, najmanje dan prije obnove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ingyen, utána %2$@ / %3$@. Minden új %3$@ elején megújul, amíg le nem mondod. Bármikor lemondhatod a Google Play előfizetéseiben, legalább egy nappal a megújulás előtt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անվճար՝ %1$@, ապա %2$@ %3$@-ի համար։ Նորացվում է յուրաքանչյուր %3$@, մինչև չեղարկվի։ Չեղարկեք ցանկացած ժամանակ Google Play-ի բաժանորդագրություններում՝ նորացումից առնվազն մեկ օր առաջ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis selama %1$@, lalu %2$@ / %3$@. Diperpanjang di akhir setiap periode (%3$@) sampai dibatalkan. Batalkan kapan saja di langganan Google Play, minimal sehari sebelum diperpanjang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per %1$@, poi %2$@/%3$@. Si rinnova ogni %3$@ finché non viene annullato. Annulla quando vuoi negli abbonamenti di Google Play, almeno un giorno prima del rinnovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@無料、その後%2$@/%3$@。解約するまで%3$@ごとに更新されます。更新の1日前までなら、Google Playの定期購入でいつでも解約できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უფასოდ: %1$@, შემდეგ %2$@ ამ პერიოდში: %3$@. ახლდება ყოველ პერიოდში (%3$@), სანამ არ გაუქმდება. გააუქმეთ ნებისმიერ დროს Google Play-ის გამოწერებში, განახლებამდე მინიმუმ ერთი დღით ადრე."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឥតគិតថ្លៃ %1$@ បន្ទាប់មក %2$@ ក្នុងមួយ%3$@។ បន្តរាល់%3$@ រហូតដល់បោះបង់។ បោះបង់គ្រប់ពេលក្នុងការជាវរបស់ Google Play យ៉ាងតិចមួយថ្ងៃមុនពេលវាបន្ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 동안 무료, 이후 매%3$@ %2$@. 취소할 때까지 매%3$@ 갱신됩니다. 갱신 최소 하루 전까지 Google Play 구독에서 언제든지 취소할 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຟຣີ %1$@, ຈາກນັ້ນ %2$@ ຕໍ່%3$@. ຕໍ່ອາຍຸທຸກ%3$@ ຈົນກວ່າຈະຍົກເລີກ. ຍົກເລີກໄດ້ທຸກເວລາໃນການສະໝັກຂອງ Google Play, ຢ່າງໜ້ອຍໜຶ່ງມື້ກ່ອນມັນຕໍ່ອາຍຸ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemokamai: %1$@, vėliau %2$@ per %3$@. Atnaujinama kas %3$@, kol atšauksite. Atšaukite bet kada Google Play prenumeratose, ne vėliau kaip likus dienai iki atnaujinimo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bez maksas, pēc tam %2$@ %3$@. Atjaunojas reizi %3$@, līdz tiek atcelts. Atcel jebkurā laikā Google Play abonementos, vismaz dienu pirms atjaunošanas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно за %1$@, потоа %2$@ на %3$@. Се обновува секој %3$@ додека не се откаже. Откажи во кое било време во претплатите на Google Play, најмалку еден ден пред да се обнови."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ үнэгүй, дараа нь %3$@-д %2$@. Цуцлах хүртэл %3$@ бүр сунгагдана. Сунгагдахаас дор хаяж нэг өдрийн өмнө Google Play-ийн захиалгууд хэсгээс хэдийд ч цуцлаж болно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ निःशुल्क, त्यसपछि प्रति %3$@ %2$@। रद्द नगरेसम्म प्रत्येक %3$@ नवीकरण हुन्छ। नवीकरणभन्दा कम्तीमा एक दिन अघि Google Play का सदस्यताहरूमा जुनसुकै बेला रद्द गर्न सकिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis gedurende %1$@, daarna %2$@ per %3$@. Wordt elke %3$@ verlengd tot je opzegt. Je kunt altijd opzeggen in de abonnementen van Google Play, minstens een dag voor de verlenging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpłatnie przez %1$@, potem %2$@ / %3$@. Odnawia się co %3$@, dopóki nie anulujesz. Anuluj w dowolnym momencie w subskrypcjach Google Play, co najmniej dzień przed odnowieniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis durante %1$@, depois %2$@ por %3$@. Renova-se a cada %3$@ até ser cancelado. Cancele quando quiser nas subscrições do Google Play, pelo menos um dia antes da renovação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis durante %1$@, depois %2$@ por %3$@. É renovada a cada %3$@ até ser cancelada. Cancele quando quiser nas assinaturas do Google Play, pelo menos um dia antes da renovação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit %1$@, apoi %2$@ pe %3$@. Se reînnoiește în fiecare %3$@ până la anulare. Puteți anula oricând în abonamentele Google Play, cu cel puțin o zi înainte de reînnoire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadarmo na %1$@, potom %2$@ za %3$@. Obnovuje sa každý %3$@, kým ho nezrušíte. Zrušiť môžete kedykoľvek v predplatnom Google Play, najneskôr deň pred obnovením."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brezplačno %1$@, nato %2$@ na %3$@. Podaljša se vsak %3$@, dokler ga ne prekličete. Prekličete ga lahko kadar koli v naročninah Google Play, vsaj dan pred podaljšanjem."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Falas për: %1$@, pastaj %2$@ për: %3$@. Rinovohet çdo: %3$@ derisa të anulohet. Anuloni në çdo kohë te abonimet e Google Play, të paktën një ditë para se të rinovohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Besplatno: %1$@, zatim %2$@ / %3$@. Obnavlja se na kraju svakog razdoblja (%3$@) dok se ne otkaže. Otkažite bilo kada u pretplatama Google Playa, najmanje dan pre obnove."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟรี %1$@ จากนั้น %2$@ / %3$@ ต่ออายุอัตโนมัติเมื่อสิ้นสุดแต่ละรอบ (%3$@) จนกว่าจะยกเลิก ยกเลิกได้ทุกเมื่อในการสมัครใช้งานของ Google Play อย่างน้อยหนึ่งวันก่อนต่ออายุ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mugt, soňra %3$@ %2$@. Ýatyrylýança her %3$@ täzelenýär. Täzelenmeden azyndan bir gün öň, Google Play abunalarynda islendik wagt ýatyryň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ücretsiz, sonra %2$@ / %3$@. İptal edilene kadar her dönem sonunda (%3$@) yenilenir. Yenilenmesinden en az bir gün önce, Google Play aboneliklerinden istediğiniz zaman iptal edin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کے لیے مفت، پھر %2$@ فی %3$@۔ منسوخ ہونے تک ہر %3$@ تجدید ہوتا ہے۔ تجدید سے کم از کم ایک دن پہلے Google Play کی سبسکرپشنز میں کسی بھی وقت منسوخ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miễn phí %1$@, sau đó %2$@ / %3$@. Tự gia hạn vào cuối mỗi kỳ (%3$@) cho đến khi bị hủy. Hủy bất cứ lúc nào trong mục đăng ký của Google Play, ít nhất một ngày trước khi gia hạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費%1$@，之後 %2$@ / %3$@。每期結束時（%3$@）自動續訂，直到取消為止。可隨時在 Google Play 的訂閱中取消，請至少在續訂前一天取消。"
          }
        }
      }
    },
