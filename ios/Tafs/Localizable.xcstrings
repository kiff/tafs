    "door.do_it.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht von %1$@ geht als Information mit deinen Worten mit. %2$@ handelt nach dem, was du sagst, innerhalb seiner Card, und schreibt nicht zurück, außer du bittest darum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ message goes with your words, as information. %2$@ acts on what you say, within its Card, and doesn't write back to them unless you ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje de %1$@ va con tus palabras, como información. %2$@ actúa según lo que dices, dentro de su Card, y no le responde a menos que se lo pidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message de %1$@ accompagne vos mots, à titre d'information. %2$@ agit selon ce que vous dites, dans sa Card, et ne répond pas à cette personne sauf si vous le demandez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio di %1$@ accompagna le tue parole, come informazione. %2$@ agisce in base a ciò che dici, entro la sua Card, e non risponde a quella persona se non glielo chiedi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bericht van %1$@ gaat als informatie mee met jouw woorden. %2$@ doet wat jij zegt, binnen zijn Card, en schrijft niet terug tenzij je erom vraagt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomość od %1$@ trafia razem z Twoimi słowami, jako informacja. %2$@ działa według tego, co mówisz, w ramach swojej Card, i nie odpisuje tej osobie, chyba że o to poprosisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem de %1$@ segue com as suas palavras, como informação. %2$@ age de acordo com o que diz, dentro do seu Card, e não responde a essa pessoa a menos que o peça."
          }
        }
      }
    },
    "door.do_it.intro_it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht von %1$@ geht als Information mit deinen Worten mit. Er handelt nach dem, was du sagst, innerhalb seiner Card, und schreibt nicht zurück, außer du bittest darum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ message goes with your words, as information. It acts on what you say, within its Card, and doesn't write back to them unless you ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje de %1$@ va con tus palabras, como información. Actúa según lo que dices, dentro de su Card, y no le responde a menos que se lo pidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message de %1$@ accompagne vos mots, à titre d'information. Il agit selon ce que vous dites, dans sa Card, et ne répond pas à cette personne sauf si vous le demandez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio di %1$@ accompagna le tue parole, come informazione. Agisce in base a ciò che dici, entro la sua Card, e non risponde a quella persona se non glielo chiedi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bericht van %1$@ gaat als informatie mee met jouw woorden. Het doet wat jij zegt, binnen zijn Card, en schrijft niet terug tenzij je erom vraagt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomość od %1$@ trafia razem z Twoimi słowami, jako informacja. Działa według tego, co mówisz, w ramach swojej Card, i nie odpisuje tej osobie, chyba że o to poprosisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem de %1$@ segue com as suas palavras, como informação. Age de acordo com o que diz, dentro do seu Card, e não responde a essa pessoa a menos que o peça."
