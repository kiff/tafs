          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝั่งเราทำงานไม่ได้ในตอนนี้ ลองอีกครั้งภายหลัง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ol häzir biziň tarapymyzda işlemeýär. Soňrak täzeden synanyşyň."
