            "value": "ตอนนี้ไม่มี taf ใดใช้ %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda hiçbir taf %1$@ kullanmıyor."
          }
        },
        "vi": {
