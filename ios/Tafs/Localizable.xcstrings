    "knob.event_changed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر هذا الحدث. يُعرض مرة أخرى كما هو الآن: وافق على ذلك."
