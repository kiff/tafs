        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas atkal strādā tāpat kā pirms apturēšanas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het werkt weer zoals voor het stilzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa znowu tak jak przed blokadą."
          }
        },
        "pt": {
