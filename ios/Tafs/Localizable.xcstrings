        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ejecuta nada suyo hasta que lo reanudes"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellest ei tööta midagi enne, kui selle jätkad"
