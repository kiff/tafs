          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras cambia, tu taf no se ejecuta. Al confirmar una vez con %1$@ se emiten estas Cards en KIFF y se eliminan las que esta versión no tiene, y luego esta versión se activa."
          }
        },
        "et": {
          "stringUnit": {
