    "connect.apps_connect_taf_make_one": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps werden für einen taf verbunden. Erstelle zuerst einen und verbinde dann hier seine Apps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps connect for a taf. Make one first, then connect its apps here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps se conectan para un taf. Crea uno primero y luego conecta aquí sus apps."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendused ühendatakse tafi jaoks. Loo kõigepealt taf, siis ühenda siin selle rakendused."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps se connectent pour un taf. Créez-en un d'abord, puis connectez ses apps ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app si collegano per un taf. Creane prima uno, poi collega qui le sue app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはtafのために接続します。先にtafを作ってから、ここでアプリを接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 taf를 위해 연결됩니다. 먼저 taf를 만든 뒤 여기서 앱을 연결하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programėlės prijungiamos taf. Pirmiausia sukurkite jį, tada čia prijunkite jo programėles."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotnes tiek pievienotas taf. Vispirms izveido taf, tad pievieno tā lietotnes šeit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps worden voor een taf gekoppeld. Maak eerst een taf en koppel hier dan de apps ervan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje łączy się dla tafa. Najpierw go utwórz, a potem połącz tu jego aplikacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As apps ligam-se para um taf. Crie primeiro um e depois ligue aqui as suas apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps se conectam para um taf. Crie primeiro um e depois conecte aqui os seus apps."
          }
        }
      }
    },
