    "voice.cannot": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع هذا الهاتف التعرّف على اللغة (%1$@) على الهاتف نفسه، لذا لا يعمل الميكروفون هنا. يمكنك الكتابة بدلًا من ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon %1$@ dilini telefonun özündə tanıya bilmir, ona görə mikrofon burada işləmir. Əvəzində yaza bilərsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този телефон не може да разпознава %1$@ на самия телефон, така че микрофонът не работи тук. Можете да пишете вместо това."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোন %1$@ ফোনেই চিনতে পারে না, তাই এখানে মাইক কাজ করে না। এর বদলে আপনি টাইপ করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest telèfon no pot reconèixer %1$@ al propi telèfon, així que el micròfon no funciona aquí. Pots escriure en lloc d'això."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento telefon neumí rozpoznat jazyk %1$@ přímo v telefonu, takže mikrofon tu nefunguje. Můžete psát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon kann %1$@ nicht direkt auf dem Gerät erkennen, daher funktioniert das Mikrofon hier nicht. Du kannst stattdessen tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can't recognise %1$@ on the phone itself, so the mic doesn't work here. You can type instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no puede reconocer %1$@ en el propio teléfono, así que el micrófono no funciona aquí. Puedes escribir en su lugar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See telefon ei tunne keelt %1$@ telefonis endas ära, seega mikrofon siin ei tööta. Võid hoopis kirjutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone ne peut pas reconnaître le %1$@ sur l'appareil même : le micro ne fonctionne donc pas ici. Vous pouvez écrire à la place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטלפון הזה לא יכול לזהות %1$@ על הטלפון עצמו, ולכן המיקרופון לא עובד כאן. אפשר להקליד במקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोन %1$@ को फ़ोन पर ही पहचान नहीं सकता, इसलिए माइक यहाँ काम नहीं करता। आप इसके बजाय टाइप कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon ne može prepoznavati jezik (%1$@) na samom telefonu pa mikrofon ovdje ne radi. Umjesto toga možete tipkati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a telefon nem tudja magán a telefonon felismerni ezt a nyelvet: %1$@, ezért a mikrofon itt nem működik. Gépelhetsz helyette."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հեռախոսը չի կարող ճանաչել %1$@-ը հենց հեռախոսում, ուստի խոսափողն այստեղ չի աշխատում։ Փոխարենը կարող եք մուտքագրել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini tidak dapat mengenali %1$@ di ponsel itu sendiri, sehingga mikrofon tidak berfungsi di sini. Anda dapat mengetik sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non sa riconoscere %1$@ sul telefono stesso, quindi il microfono qui non funziona. Puoi scrivere invece."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンは端末上で%1$@を認識できないため、ここではマイクが使えません。代わりに入力できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ტელეფონს %1$@ თავად ტელეფონზე ვერ ცნობს, ამიტომ მიკროფონი აქ არ მუშაობს. სამაგიეროდ შეგიძლიათ აკრიფოთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទូរសព្ទនេះមិនអាចស្គាល់ភាសា %1$@ នៅលើទូរសព្ទផ្ទាល់បានទេ ដូច្នេះមីក្រូហ្វូនមិនដំណើរការនៅទីនេះទេ។ អ្នកអាចវាយជំនួសបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰은 기기 자체에서 %1$@을(를) 인식할 수 없어 여기서는 마이크가 작동하지 않습니다. 대신 입력할 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂທລະສັບນີ້ຮັບຮູ້ %1$@ ໃນຕົວໂທລະສັບເອງບໍ່ໄດ້ ສະນັ້ນໄມໂຄຣໂຟນບໍ່ເຮັດວຽກຢູ່ນີ້. ທ່ານພິມແທນໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis telefonas pats negali atpažinti kalbos (%1$@), todėl mikrofonas čia neveikia. Vietoj to galite rašyti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis tālrunis pats nevar atpazīt valodu: %1$@, tāpēc mikrofons šeit nedarbojas. Tā vietā vari rakstīt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој телефон не може да препознава %1$@ на самиот телефон, па микрофонот не работи тука. Наместо тоа можеш да пишуваш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ утас %1$@ хэлийг утсан дээрээ танихгүй тул микрофон энд ажиллахгүй. Оронд нь бичиж болно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो फोनले आफैँमा %1$@ पहिचान गर्न सक्दैन, त्यसैले यहाँ माइक काम गर्दैन। बरु टाइप गर्न सक्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon kan %1$@ niet op het toestel zelf herkennen, dus de microfoon werkt hier niet. Je kunt in plaats daarvan typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon nie potrafi rozpoznawać mowy w języku %1$@ na samym urządzeniu, więc mikrofon tu nie działa. Możesz zamiast tego pisać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone não consegue reconhecer %1$@ no próprio telefone, por isso o microfone não funciona aqui. Pode escrever em vez disso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone não consegue reconhecer %1$@ no próprio telefone, por isso o microfone não funciona aqui. Pode escrever em vez disso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest telefon nu poate recunoaște limba %1$@ pe telefonul însuși, așa că microfonul nu funcționează aici. Puteți tasta în schimb."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento telefón nevie rozpoznať jazyk %1$@ priamo v telefóne, takže mikrofón tu nefunguje. Môžete písať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta telefon ne more prepoznati jezika %1$@ v samem telefonu, zato mikrofon tu ne deluje. Lahko tipkate."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky telefon nuk e njeh %1$@ në vetë telefonin, ndaj mikrofoni nuk funksionon këtu. Mund të shkruani në vend të kësaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon ne može prepoznavati jezik (%1$@) na samom telefonu pa mikrofon ovdje ne radi. Umesto toga možete tipkati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์เครื่องนี้จดจำ%1$@บนตัวเครื่องเองไม่ได้ ไมค์จึงใช้ที่นี่ไม่ได้ คุณพิมพ์แทนได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon %1$@ dilini telefonyň özünde tanap bilmeýär, şonuň üçin mikrofon bu ýerde işlemeýär. Ýerine ýazyp bilersiňiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon %1$@ dilini telefonun kendisinde tanıyamıyor, bu yüzden mikrofon burada çalışmıyor. Bunun yerine yazabilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ فون خود فون پر %1$@ کو پہچان نہیں سکتا، اس لیے یہاں مائیک کام نہیں کرتا۔ آپ اس کے بجائے ٹائپ کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại này không thể nhận dạng %1$@ ngay trên điện thoại, nên micrô không hoạt động ở đây. Bạn có thể gõ thay thế."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部手機無法在本機辨識%1$@，因此這裡無法使用麥克風。您可以改用輸入。"
          }
        }
      }
    },
