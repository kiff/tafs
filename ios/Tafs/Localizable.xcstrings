    "door.paired_senders_today_more_dropped": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ من %2$@ منك ومن المرسلين المقترنين اليوم. تُسقط البقية حتى الغد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün sizdən və cütləşmiş göndərənlərdən %2$@ içindən %1$@. Çoxu sabaha qədər atılır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ от %2$@ от вас и сдвоените податели днес. Останалите се отхвърлят до утре."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ আপনার ও জোড়া লাগানো প্রেরকদের কাছ থেকে %2$@-এর মধ্যে %1$@। আগামীকাল পর্যন্ত আরও বাদ দেওয়া হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ teus i de remitents aparellats avui. Els següents es descarten fins demà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes %1$@ z %2$@ od vás a spárovaných odesílatelů. Další se do zítřka zahazují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@ von dir und gekoppelten Absendern heute. Weitere werden bis morgen verworfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@ from you and paired senders today. More are dropped until tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ tuyos y de remitentes vinculados hoy. Los siguientes se descartan hasta mañana."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täna sinult ja seotud saatjatelt %1$@/%2$@. Rohkem sõnumeid jäetakse homseni vastu võtmata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@ de vous et des expéditeurs associés aujourd'hui. Les suivants sont ignorés jusqu'à demain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ מתוך %2$@ ממך ומשולחים מוצמדים היום. השאר נזרקים עד מחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आपसे और जोड़े गए भेजने वालों से %2$@ में से %1$@। और कल तक छोड़ दिए जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ od %2$@ od vas i uparenih pošiljatelja danas. Ostale se odbacuju do sutra."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma %1$@ / %2$@ tőled és a párosított küldőktől. A többi holnapig elvész."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-ից ձեզանից և զուգակցված ուղարկողներից այսօր։ Ավելինները դեն են գցվում մինչև վաղը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dari %2$@ dari Anda dan pengirim yang dipasangkan hari ini. Selebihnya dibuang sampai besok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ su %2$@ da te e dai mittenti associati oggi. I successivi vengono scartati fino a domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のあなたと登録済みの送信者からの連絡：%2$@件中%1$@件。明日まで、それ以上は破棄されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-დან თქვენგან და დაწყვილებული გამგზავნებისგან დღეს. მეტი ხვალამდე იგდება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ក្នុងចំណោម %2$@ ពីអ្នក និងអ្នកផ្ញើដែលបានផ្គូផ្គងថ្ងៃនេះ។ ចំនួនលើសត្រូវបានទម្លាក់ រហូតដល់ថ្ងៃស្អែក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 나와 등록된 발신자에게서 %2$@건 중 %1$@건. 내일까지 더 오는 것은 버려집니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ຈາກ %2$@ ຈາກທ່ານ ແລະ ຜູ້ສົ່ງທີ່ຈັບຄູ່ໃນມື້ນີ້. ອັນທີ່ເກີນຖືກຖິ້ມຈົນຮອດມື້ອື່ນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien: %1$@ iš %2$@ – iš jūsų ir susietų siuntėjų. Kitos atmetamos iki rytojaus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šodien %1$@ no %2$@ no tevis un pārī savienotajiem sūtītājiem. Pārējie līdz rītdienai tiek atmesti."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ од %2$@ од тебе и спарени испраќачи денес. Повеќето се отфрлаат до утре."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өнөөдөр таны болон хослуулсан илгээгчдийн %2$@-оос %1$@. Үлдсэнийг маргааш хүртэл хаяна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आज तपाईं र जोडिएका पठाउनेहरूबाट %2$@ मध्ये %1$@। बाँकी भोलिसम्म छोडिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van %2$@ van jou en gekoppelde afzenders vandaag. Meer worden tot morgen genegeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ z %2$@ od Ciebie i powiązanych nadawców dziś. Kolejne są odrzucane do jutra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ mensagens suas e de remetentes associados hoje. As seguintes são descartadas até amanhã."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ mensagens suas e de remetentes associados hoje. As seguintes são descartadas até amanhã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ din %2$@ de la dvs. și de la expeditorii asociați azi. Restul se pierd până mâine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes %1$@ z %2$@ od vás a spárovaných odosielateľov. Ďalšie sa do zajtra zahadzujú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes %1$@ od %2$@ od vas in seznanjenih pošiljateljev. Nadaljnja se do jutri zavržejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nga %2$@ nga ju dhe dërguesit e çiftuar sot. Më shumë hidhen poshtë deri nesër."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ od %2$@ od vas i uparenih pošiljatelja danas. Ostale se odbacuju do sutra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จาก %2$@ จากคุณและผู้ส่งที่จับคู่แล้ววันนี้ ที่เกินจะถูกทิ้งจนถึงพรุ่งนี้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu gün siz we goşalanan iberijiler tarapyndan %2$@-dan %1$@. Has köpüsi ertire çenli taşlanýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün sizden ve eşleştirilmiş gönderenlerden %1$@ / %2$@. Fazlası yarına kadar bırakılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج آپ اور جوڑے گئے بھیجنے والوں کی طرف سے %2$@ میں سے %1$@۔ مزید کل تک چھوڑ دیے جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@ từ bạn và những người gửi đã ghép đôi hôm nay. Phần còn lại bị bỏ cho đến ngày mai."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天來自您和已配對寄件者的有 %1$@ / %2$@。超出的部分會捨棄，直到明天。"
          }
        }
      }
    },
    "door.paired_senders_today_text_only": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ من %2$@ منك ومن المرسلين المقترنين اليوم. نص فقط: لا تُفتح المرفقات، ويذكر الرد ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün sizdən və cütləşmiş göndərənlərdən %2$@ içindən %1$@. Yalnız mətn: əlavələr açılmır və cavab bunu bildirir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ от %2$@ от вас и сдвоените податели днес. Само текст: прикачените файлове не се отварят и отговорът го казва."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ আপনার ও জোড়া লাগানো প্রেরকদের কাছ থেকে %2$@-এর মধ্যে %1$@। শুধু লেখা: সংযুক্তি খোলা হয় না, এবং উত্তরে তা বলা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
