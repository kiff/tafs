    "door.key.foot": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Eine Nachricht gilt nur dann als ihre, wenn das zutrifft; alle anderen klopfen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. A message counts as theirs only when that holds; anyone else knocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un mensaje cuenta como suyo solo cuando eso se cumple; los de cualquier otra persona llegan como llamada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Sõnum loetakse nende omaks ainult siis, kui see kehtib; kõik teised koputavad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un message n'est considéré comme le sien que si c'est le cas ; toute autre personne fait une demande d'accès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un messaggio conta come suo solo se questo è vero; per chiunque altro è una bussata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。それが確認できたときだけ、その人のメッセージとして扱われます。それ以外の人はノックになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. 이것이 확인될 때만 그 사람의 메시지로 봅니다. 그 밖의 사람은 노크만 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Žinutė laikoma jų tik tada, kai tai patvirtinama; visi kiti tik beldžiasi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Ziņa tiek uzskatīta par viņu ziņu tikai tad, ja tas izpildās; visi pārējie klauvē."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Een bericht telt alleen als het hunne als dat zo is; ieder ander klopt aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Wiadomość liczy się jako ich tylko wtedy, gdy to się zgadza; każdy inny puka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Uma mensagem só conta como dessa pessoa quando isso se verifica; qualquer outra pessoa faz um pedido de contacto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Uma mensagem só conta como dessa pessoa quando isso se verifica; qualquer outra pessoa faz um pedido de contato."
          }
        }
      }
    },
    "door.key.no_one_paired": {
      "extractionState": "manual",
      "localizations": {
