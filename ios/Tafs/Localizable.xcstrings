    "halt.explain.halted": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angehalten. Nichts erreicht deine Apps. Wenn du fortsetzt, läuft nur neue Arbeit: Nichts von vor dem Anhalten wird wieder aufgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halted. Nothing reaches your apps. When you resume, only new work runs: nothing from before the halt picks up again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. Nada llega a tus apps. Cuando lo reanudes, solo se ejecuta trabajo nuevo: nada de antes del bloqueo se retoma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqué. Rien n'atteint vos apps. Quand vous reprendrez, seul le nouveau travail s'exécutera : rien d'antérieur au blocage ne repart."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccato. Non arriva nulla alle tue app. Quando riprendi, viene eseguito solo il lavoro nuovo: nulla di quanto c'era prima del blocco riparte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilgezet. Niets bereikt je apps. Als je hervat, draait alleen nieuw werk: niets van vóór het stilzetten gaat verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowane. Nic nie dociera do Twoich aplikacji. Po wznowieniu działa tylko nowa praca: nic sprzed blokady nie zostanie podjęte ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. Nada chega às suas apps. Quando retomar, só é executado trabalho novo: nada de antes do bloqueio é retomado."
          }
        }
      }
    },
    "halt.explain.halted_since": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
