    "sign_in.deletes_every_taf_runs_chats": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف كل taf وتشغيلاته ومحادثاته وملاحظاته، وCards لديك واتصالاتك. لا يمكن التراجع عن ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər taf-ı, onun işlərini, söhbətlərini və qeydlərini, Card-larınızı və qoşulmalarınızı silir. Bunu geri qaytarmaq olmaz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтрива всеки taf, изпълненията, чатовете и бележките му, вашите Cards и връзките ви. Това не може да бъде отменено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি taf, এর রান, চ্যাট ও নোট, আপনার Card এবং আপনার সংযোগ মুছে দেয়। এটি ফেরানো যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina cada taf, les seves execucions, xats i notes, els teus Card i les teves connexions. No es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže každý taf, jeho běhy, chaty a poznámky, vaše Card a vaše připojení. Nelze to vrátit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht jeden taf, seine Läufe, Chats und Notizen, deine Cards und deine Verbindungen. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes every taf, its runs, chats and notes, your Cards and your connections. It can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina cada taf, sus ejecuciones, chats y notas, tus Cards y tus conexiones. No se puede deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustutab kõik tafid, nende käivitused, vestlused ja märkmed, sinu Cardid ja ühendused. Seda ei saa tagasi võtta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime chaque taf, ses exécutions, chats et notes, vos Cards et vos connexions. C'est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחק כל taf, את הריצות, השיחות וההערות שלו, את ה-Card ואת החיבורים שלך. אי אפשר לבטל את זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर taf, उसकी रन, चैट और नोट, आपके Card और आपके कनेक्शन हटाता है। इसे पलटा नहीं जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Briše svakog tafa, njegova izvođenja, razgovore i bilješke, vaše Cardove i vaše veze. Ne može se poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Töröl minden tafot, a futásaikat, csevegéseiket és jegyzeteiket, a Cardjaidat és a kapcsolataidat. Ez nem vonható vissza."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ջնջում է յուրաքանչյուր taf, նրա գործարկումները, զրույցներն ու նշումները, ձեր Card-երը և ձեր կապերը։ Սա հնարավոր չէ հետ շրջել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus setiap taf, eksekusi, obrolan, dan catatannya, Card Anda, dan koneksi Anda. Tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina ogni taf, le sue esecuzioni, chat e note, le tue Card e i tuoi collegamenti. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのtaf、その実行、チャット、メモ、Card、接続を削除します。元に戻すことはできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შლის ყველა taf-ს, მის გაშვებებს, ჩატებს და ჩანაწერებს, თქვენს Card-ებს და თქვენს კავშირებს. ამის გაუქმება შეუძლებელია."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លុប taf ទាំងអស់ ការដំណើរការ ការសន្ទនា និងកំណត់ត្រារបស់វា Card និងការតភ្ជាប់របស់អ្នក។ មិនអាចត្រឡប់វិញបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 taf와 그 실행 기록, 채팅, 메모, Card, 연결을 삭제합니다. 되돌릴 수 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລຶບທຸກ taf, ການເຮັດວຽກ, ການສົນທະນາ ແລະ ບັນທຶກຂອງມັນ, Card ແລະ ການເຊື່ອມຕໍ່ຂອງທ່ານ. ບໍ່ສາມາດຍົກເລີກໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištrinami visi taf, jų paleidimai, pokalbiai ir pastabos, jūsų Card ir ryšiai. To negalima atšaukti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzēš katru taf, tā palaišanas, sarunas un piezīmes, tavas Card un tavus savienojumus. To vairs nevarēs atjaunot."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Го брише секој taf, неговите извршувања, разговори и белешки, твоите Card и твоите врски. Не може да се врати."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf бүр, түүний ажиллалт, чат, тэмдэглэл, таны Card-ууд болон холболтуудыг устгана. Үүнийг буцаах боломжгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "हरेक taf, यसका चलाइ, च्याट र टिपोट, तपाईंका Card र जडानहरू मेटिन्छन्। यो फिर्ता गर्न सकिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert elk taf, met zijn runs, chats en notities, je Cards en je koppelingen. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa każdego tafa, jego uruchomienia, czaty i notatki, Twoje Card i Twoje połączenia. Nie można tego cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todos os tafs, as suas execuções, chats e notas, os seus Cards e as suas ligações. Não pode ser desfeito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui todos os tafs, as execuções, chats e notas deles, os Cards e as conexões. Não pode ser desfeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge fiecare taf, rulările, conversațiile și notițele sale, Cardurile și conexiunile dvs. Acțiunea nu poate fi anulată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni každý taf, jeho behy, chaty a poznámky, vaše Card a vaše pripojenia. Nedá sa to vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbriše vsak taf, njegove zagone, klepete in zapiske, vaše Card in vaše povezave. Tega ni mogoče razveljaviti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fshin çdo taf, ekzekutimet, bisedat dhe shënimet e tij, Card-et tuaj dhe lidhjet tuaja. Nuk mund të zhbëhet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Briše svakog tafa, njegova izvršavanja, razgovore i beleške, vaše Cardove i vaše veze. Ne može se poništiti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบทุก taf การทำงาน แชต และบันทึกของมัน Card และการเชื่อมต่อของคุณ ไม่สามารถย้อนกลับได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Her taf-y, onuň işlemelerini, söhbetdeşliklerini we bellikleriňizi, Card-laryňyzy we birikmeleriňizi pozýar. Muny yzyna gaýtaryp bolmaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her taf'ı, çalıştırmalarını, sohbetlerini ve notlarını, Card'larınızı ve bağlantılarınızı siler. Geri alınamaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر taf، اس کے رنز، چیٹس اور نوٹس، آپ کے Cards اور آپ کے کنکشنز حذف کر دیتا ہے۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa mọi taf, các lượt chạy, cuộc trò chuyện và ghi chú của chúng, các Card và các kết nối của bạn. Không thể hoàn tác."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除每個 taf、它們的執行紀錄、對話和備註、您的 Card 以及您的連線。此操作無法復原。"
          }
        }
      }
    },
