    "billing.pack_adds_credits_once_never": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Paket fügt einmalig Credits hinzu, und sie verfallen nie. Zuerst werden die inklusiven Credits jedes Zeitraums verbraucht, dann die der Pakete."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pack adds credits once, and they never expire. Each period's included credits are used first, then the packs'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paquete añade créditos una sola vez, y nunca caducan. Primero se usan los créditos incluidos de cada periodo y luego los de los paquetes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pack ajoute des crédits une fois, et ils n'expirent jamais. Les crédits inclus de chaque période sont utilisés d'abord, puis ceux des packs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pacchetto aggiunge crediti una volta sola, e non scadono mai. Prima si usano i crediti inclusi di ogni periodo, poi quelli dei pacchetti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een pakket voegt eenmalig credits toe, en die verlopen nooit. De inbegrepen credits van elke periode worden eerst gebruikt, daarna die van de pakketten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakiet dodaje kredyty jednorazowo i nigdy nie wygasają. Najpierw zużywane są kredyty z okresu, potem z pakietów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pacote adiciona créditos uma vez, e estes nunca expiram. Os créditos incluídos em cada período são usados primeiro, depois os dos pacotes."
          }
        }
      }
    },
    "billing.pending_credits": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wartet auf Genehmigung. Deine Credits werden hinzugefügt, sobald er abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase is waiting for approval. Your credits are added once it's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra está esperando aprobación. Tus créditos se añaden cuando se complete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat attend une approbation. Vos crédits sont ajoutés dès qu'elle est donnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto è in attesa di approvazione. I tuoi crediti vengono aggiunti una volta completato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoop wacht op goedkeuring. Je credits worden toegevoegd zodra die rond is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup czeka na zatwierdzenie. Twoje kredyty zostaną dodane, gdy się zakończy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra está à espera de aprovação. Os seus créditos são adicionados quando estiver concluída."
          }
        }
      }
    },
