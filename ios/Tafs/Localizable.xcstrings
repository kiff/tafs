    "sample.brief.expires.question": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neues Paket für Bestellung #5098 senden, bevor die Reklamationsfrist des Versanddienstes um 12:00 endet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a new parcel for order #5098 before the carrier's claim window closes at 12:00?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Enviar un paquete nuevo para el pedido #5098 antes de que cierre el plazo de reclamación del transportista a las 12:00?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas saata tellimusele #5098 uus pakk enne, kui vedaja nõuete aeg kell 12:00 sulgub?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer un nouveau colis pour la commande #5098 avant la fin du délai de réclamation du transporteur à 12:00 ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spedire un nuovo pacco per l'ordine #5098 prima che il termine di reclamo del corriere scada alle 12:00?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配送業者の補償申請期限の12:00までに、注文 #5098の荷物を再送しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "택배사 클레임 기간이 12:00에 끝나기 전에 주문 #5098의 새 소포를 보낼까요?"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išsiųsti naują siuntinį pagal užsakymą #5098, kol 12:00 baigsis vežėjo pretenzijų terminas?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosūtīt jaunu paku pasūtījumam #5098, pirms 12:00 beidzas pārvadātāja pretenziju termiņš?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nieuw pakket sturen voor bestelling #5098 voordat de claimtermijn van de vervoerder om 12:00 sluit?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłać nową paczkę do zamówienia #5098, zanim termin reklamacji u przewoźnika minie o 12:00?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar uma nova encomenda para o pedido #5098 antes de o prazo de reclamação da transportadora fechar às 12:00?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar uma nova encomenda para o pedido #5098 antes de o prazo de reclamação da transportadora fechar às 12:00?"
          }
        }
      }
    },
    "sample.brief.expires.why": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterwegs verloren, seit 10 Tagen kein Scan; %1$@ hat heute Morgen beim Versanddienst nachgesehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost in transit, 10 days without a scan; %1$@ checked the carrier this morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdido en tránsito, 10 días sin escaneo; %1$@ consultó al transportista esta mañana."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadunud teel, 10 päeva ilma skannimiseta; %1$@ kontrollis vedajat täna hommikul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdu en transit, 10 jours sans scan ; %1$@ a vérifié auprès du transporteur ce matin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perso in transito, 10 giorni senza scansione; %1$@ ha controllato con il corriere stamattina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輸送中に紛失、10日間スキャン記録なし。%1$@が今朝配送業者を確認しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배송 중 분실, 10일 동안 스캔 기록 없음. %1$@이(가) 오늘 아침 택배사를 확인했습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamestas pakeliui, 10 dienų be nuskaitymo; %1$@ šį rytą patikrino vežėją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazudusi ceļā, 10 dienas bez skenēšanas; %1$@ šorīt pārbaudīja pārvadātāju."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderweg kwijt, 10 dagen geen scan; %1$@ heeft vanochtend bij de vervoerder gekeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaginęła w drodze, 10 dni bez skanu; %1$@ sprawdził u przewoźnika dziś rano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdida em trânsito, 10 dias sem leitura; o %1$@ consultou a transportadora esta manhã."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdida em trânsito, 10 dias sem leitura; o %1$@ consultou a transportadora esta manhã."
          }
        }
      }
    },
