    "billing.another_account": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه العملية تخص حساب tafs آخر على حساب Google هذا، لذا لم تتم إضافة شيء هنا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alış bu Google hesabındakı başqa tafs hesabına aiddir, ona görə burada heç nə əlavə edilmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази покупка принадлежи на друг акаунт в tafs в този акаунт в Google, така че нищо не беше добавено тук."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কেনাকাটা এই Google অ্যাকাউন্টের অন্য একটি tafs অ্যাকাউন্টের, তাই এখানে কিছু যোগ হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta compra pertany a un altre compte de tafs d'aquest compte de Google, així que aquí no s'ha afegit res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento nákup patří jinému účtu tafs v tomto účtu Google, takže se sem nic nepřidalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kauf gehört zu einem anderen tafs-Konto mit diesem Google-Konto, daher wurde hier nichts hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This purchase belongs to another tafs account on this Google account, so nothing was added here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
