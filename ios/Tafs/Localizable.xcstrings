    "taf.remove_body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-ları ləğv edilir, cədvəli dayandırılır, söhbətləri, iş hesabatları, yaddaşı və açarı silinir, adı azad olur. KIFF qəbzləri qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Неговите Cards се оттеглят, графикът му спира, чатовете, отчетите за изпълнения, паметта и ключът му се изтриват, а името му се освобождава. Разписките на KIFF остават."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho Card se odvolají, plán se zastaví, chaty, zprávy z běhů, paměť a klíč se smažou a jeho název se uvolní. Potvrzení od KIFF zůstávají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Cards werden widerrufen, sein Zeitplan gestoppt, seine Chats, Laufberichte, sein Gedächtnis und sein Schlüssel gelöscht und sein Name freigegeben. KIFFs Belege bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its Cards are revoked, its schedule stopped, its chats, run reports, memory and key deleted, and its name freed. KIFF's receipts stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se revocan sus Cards, se detiene su programación, se eliminan sus chats, informes de ejecución, memoria y clave, y se libera su nombre. Los recibos de KIFF se conservan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle Cardid tühistatakse, ajakava lõpetatakse, vestlused, käivituste aruanded, mälu ja võti kustutatakse ning nimi vabastatakse. KIFFi kviitungid jäävad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses Cards sont révoquées, son planning arrêté, ses chats, rapports d'exécution, mémoire et clé supprimés, et son nom libéré. Les reçus de KIFF restent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegovi se Cardovi opozivaju, raspored zaustavlja, razgovori, izvješća izvođenja, memorija i ključ brišu, a naziv oslobađa. KIFF-ove potvrde ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cardjai visszavonásra kerülnek, az ütemezése leáll, a csevegései, futási jelentései, memóriája és kulcsa törlődik, a neve pedig felszabadul. A KIFF nyugtái megmaradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրա Card-երը չեղարկվում են, ժամանակացույցը դադարում է, զրույցները, գործարկումների հաշվետվությունները, հիշողությունը և բանալին ջնջվում են, և անունը ազատվում է։ KIFF-ի անդորրագրերը մնում են։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-nya dicabut, jadwalnya dihentikan, obrolan, laporan eksekusi, memori, dan kuncinya dihapus, dan namanya dibebaskan. Tanda terima KIFF tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue Card vengono revocate, la sua pianificazione fermata, le chat, i resoconti delle esecuzioni, la memoria e la chiave eliminati, e il suo nome liberato. Le ricevute di KIFF restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardは取り消され、スケジュールは停止し、チャット、実行レポート、メモ、キーは削除され、名前は解放されます。KIFFの領収書は残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისი Card-ები უქმდება, განრიგი ჩერდება, ჩატები, გაშვების ანგარიშები, მეხსიერება და გასაღები იშლება, და სახელი თავისუფლდება. KIFF-ის ქვითრები რჩება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Card가 취소되고, 일정이 멈추고, 채팅, 실행 보고서, 기억, 키가 삭제되며, 이름을 다시 쓸 수 있게 됩니다. KIFF의 영수증은 남습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo Card atšaukiamos, tvarkaraštis išjungiamas, pokalbiai, paleidimų ataskaitos, atmintis ir raktas ištrinami, o pavadinimas atlaisvinamas. KIFF kvitai lieka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā Card tiek atsauktas, grafiks atcelts, sarunas, palaišanu ziņojumi, atmiņa un atslēga dzēsti, un nosaukums atbrīvots. KIFF kvītis paliek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zijn Cards worden ingetrokken, de planning gestopt, de chats, runrapporten, het geheugen en de sleutel verwijderd, en de naam komt vrij. De ontvangstbewijzen van KIFF blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego Card zostaną unieważnione, harmonogram zatrzymany, czaty, raporty z uruchomień, pamięć i klucz usunięte, a nazwa zwolniona. Potwierdzenia KIFF zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus Cards são revogados, o seu agendamento parado, os seus chats, relatórios de execução, memória e chave eliminados, e o seu nome libertado. Os recibos do KIFF mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Cards dele são revogados, o agendamento é parado, os chats, relatórios de execução, memória e chave são excluídos, e o nome fica livre. Os recibos do KIFF são mantidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardurile sale sunt revocate, programul oprit, conversațiile, rapoartele de rulare, memoria și cheia șterse, iar numele eliberat. Chitanțele KIFF rămân."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho Card sa odvolajú, plán sa zastaví, chaty, správy z behov, pamäť a kľúč sa odstránia a jeho názov sa uvoľní. Potvrdenia od KIFF zostávajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegove Card so odvzete, urnik ustavljen, klepeti, poročila o zagonih, spomin in ključ izbrisani, ime pa sproščeno. Potrdila KIFF ostanejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-et e tij revokohen, orari i tij ndalet, bisedat, raportet e ekzekutimeve, kujtesa dhe çelësi fshihen, dhe emri i tij lirohet. Dëftesat e KIFF mbeten."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegovi se Cardovi opozivaju, raspored zaustavlja, razgovori, izveštaja izvršavanja, memorija i ključ brišu, a naziv oslobađa. KIFF-ove potvrde ostaju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Card ของมันถูกเพิกถอน กำหนดการหยุด แชต รายงานการทำงาน ความจำ และกุญแจถูกลบ และชื่อของมันว่าง ใบเสร็จของ KIFF ยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Card'ları iptal edilir, zamanlaması durdurulur, sohbetleri, çalıştırma raporları, belleği ve anahtarı silinir ve adı serbest kalır. KIFF'in makbuzları kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các Card của nó bị thu hồi, lịch bị dừng, các cuộc trò chuyện, báo cáo lượt chạy, bộ nhớ và khóa bị xóa, và tên của nó được giải phóng. Biên nhận của KIFF vẫn còn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的 Card 會被撤銷、排程停止、對話、執行報告、記憶和金鑰會被刪除，名稱會釋出。KIFF 的收據會保留。"
          }
        }
      }
    },
