        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अस्वीकार करना उसके Card को जगह लौटा देता है। उत्तर देने के लिए %1$@ चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako odbijete, Card dobiva prostor natrag. Odgovaranje traži: %1$@."
