        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon je isključen za tafs. Uključite ga u Podešavanja › tafs › Mikrofon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟนปิดอยู่สำหรับ tafs เปิดได้ที่การตั้งค่า › tafs › ไมโครโฟน"
