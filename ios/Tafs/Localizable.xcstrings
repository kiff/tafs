          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodas nustojo galioti anksčiau, nei buvo patvirtintas naršyklėje. Bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda derīgums beidzās, pirms tas tika apstiprināts tavā pārlūkā. Mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code is verlopen voordat hij in je browser werd goedgekeurd. Probeer het opnieuw."
