        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je %1$@ is gewijzigd of niet herkend, dus dit apparaat kan niet goedkeuren tot je het opnieuw goedkeurt in je browser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje %1$@ się zmieniło albo nie zostało rozpoznane, więc to urządzenie nie może zatwierdzać, dopóki nie zatwierdzisz go ponownie w przeglądarce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu %1$@ mudou ou não foi reconhecido, por isso este dispositivo não pode aprovar até o aprovar novamente no seu navegador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu %1$@ mudou ou não foi reconhecido, por isso este dispositivo não pode aprovar até o aprovar novamente no seu navegador."
          }
        }
      }
    },
