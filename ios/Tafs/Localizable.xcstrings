        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বলে লেখার জন্য tafs-কে মাইক্রোফোন ব্যবহারের অনুমতি দিন। আপনার কণ্ঠ এই ফোনেই লেখায় রূপান্তরিত হয়, কোথাও পাঠানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que tafs faci servir el micròfon per dictar. La teva veu es converteix en text en aquest telèfon i no s'envia enlloc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte tafs používat mikrofon k diktování. Váš hlas se v tomto telefonu změní na text a nikam se neodesílá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube tafs, das Mikrofon zum Diktieren zu nutzen. Deine Stimme wird auf diesem Telefon zu Text und nirgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow tafs to use the microphone to dictate. Your voice becomes text on this phone and isn't sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que tafs use el micrófono para dictar. Tu voz se convierte en texto en este teléfono y no se envía a ningún sitio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimiseks luba tafsil mikrofoni kasutada. Sinu hääl muutub selles telefonis tekstiks ja seda ei saadeta kuhugi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez tafs à utiliser le micro pour dicter. Votre voix devient du texte sur ce téléphone et n'est envoyée nulle part."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לאפשר ל-tafs להשתמש במיקרופון כדי להכתיב. הקול שלך הופך לטקסט בטלפון הזה ולא נשלח לשום מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोलकर लिखने के लिए tafs को माइक्रोफ़ोन उपयोग करने दें। आपकी आवाज़ इस फ़ोन पर टेक्स्ट बनती है और कहीं नहीं भेजी जाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite tafsu upotrebu mikrofona za diktiranje. Vaš glas postaje tekst na ovom telefonu i ne šalje se nikamo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a tafsnak a mikrofon használatát a diktáláshoz. A hangod ezen a telefonon lesz szöveg, és sehová sem kerül el."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թույլ տվեք tafs-ին օգտագործել խոսափողը թելադրելու համար։ Ձեր ձայնը վերածվում է տեքստի այս հեռախոսում և ոչ մի տեղ չի ուղարկվում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan tafs memakai mikrofon untuk dikte. Suara Anda menjadi teks di ponsel ini dan tidak dikirim ke mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a tafs di usare il microfono per dettare. La tua voce diventa testo su questo telefono e non viene inviata da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力するには、tafsにマイクの使用を許可してください。声はこのスマートフォン上でテキストになり、どこにも送信されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიეცით tafs-ს მიკროფონის გამოყენების უფლება კარნახისთვის. თქვენი ხმა ტექსტად იქცევა ამ ტელეფონზე და არსად იგზავნება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតឱ្យ tafs ប្រើមីក្រូហ្វូនដើម្បីនិយាយឱ្យវាយ។ សំឡេងរបស់អ្នកក្លាយជាអត្ថបទនៅលើទូរសព្ទនេះ ហើយមិនត្រូវបានផ្ញើទៅកន្លែងណាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기를 하려면 tafs의 마이크 사용을 허용하세요. 음성은 이 휴대폰에서 텍스트로 바뀌며 어디에도 보내지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອະນຸຍາດໃຫ້ tafs ໃຊ້ໄມໂຄຣໂຟນເພື່ອເວົ້າໃຫ້ພິມ. ສຽງຂອງທ່ານກາຍເປັນຂໍ້ຄວາມໃນໂທລະສັບນີ້ ແລະ ບໍ່ຖືກສົ່ງໄປບ່ອນໃດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiskite tafs naudoti mikrofoną diktavimui. Jūsų balsas paverčiamas tekstu šiame telefone ir niekur nesiunčiamas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atļauj lietotnei tafs izmantot mikrofonu, lai diktētu. Tava balss šajā tālrunī kļūst par tekstu un netiek nekur sūtīta."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволи му на tafs да го користи микрофонот за диктирање. Твојот глас станува текст на овој телефон и не се испраќа никаде."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэлж бичихийн тулд tafs-д микрофон ашиглахыг зөвшөөрнө үү. Таны дуу хоолой энэ утсан дээр текст болж, хаашаа ч илгээгдэхгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "बोलेर लेख्न tafs लाई माइक्रोफोन प्रयोग गर्न दिनुहोस्। तपाईंको आवाज यस फोनमा पाठ बन्छ र कहीँ पठाइँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta tafs toe de microfoon te gebruiken om te dicteren. Je stem wordt op deze telefoon tekst en wordt nergens heen gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól tafs używać mikrofonu do dyktowania. Twój głos zamienia się w tekst na tym telefonie i nie jest nigdzie wysyłany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o tafs use o microfone para ditar. A sua voz torna-se texto neste telefone e não é enviada para lado nenhum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o tafs use o microfone para ditar. A sua voz torna-se texto neste telefone e não é enviada para lado nenhum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți-i lui tafs să folosească microfonul pentru dictare. Vocea dvs. devine text pe acest telefon și nu este trimisă nicăieri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte tafs používať mikrofón na diktovanie. Váš hlas sa v tomto telefóne zmení na text a nikam sa neposiela."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite tafs, da za narekovanje uporablja mikrofon. Vaš glas postane besedilo v tem telefonu in se nikamor ne pošlje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejoni tafs të përdorë mikrofonin për të diktuar. Zëri juaj kthehet në tekst në këtë telefon dhe nuk dërgohet askund."
          }
