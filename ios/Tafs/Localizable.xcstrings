        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nhập PIN của khóa bảo mật. tafs hỏi mỗi lần và không bao giờ lưu nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入安全金鑰的 PIN。tafs 每次都會詢問，且不會儲存。"
