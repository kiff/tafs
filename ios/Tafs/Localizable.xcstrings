        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलर्ट लगभग चालू हैं: tafs cloud ने उत्तर नहीं दिया (%1$@)। फिर से अलर्ट चालू करें पर टैप करें।"
