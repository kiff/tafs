            "value": "Aby dodać klucz dostępu, użyj urządzenia, które może zatwierdzać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar uma chave de acesso, use um dispositivo que possa aprovar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar uma chave de acesso, use um dispositivo que possa aprovar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a adăuga o cheie de acces, folosiți un dispozitiv care poate aproba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete pridať prístupový kľúč, použite zariadenie, ktoré môže schvaľovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dodajanje ključa za dostop uporabite napravo, ki lahko odobrava."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Për të shtuar një çelës kalimi, përdorni një pajisje që mund të miratojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Da dodate pristupni ključ, upotrebite uređaj koji može odobravati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเพิ่มพาสคีย์ ให้ใช้อุปกรณ์ที่อนุมัติได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey goşmak üçin tassyklap biljek enjamy ulanyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir geçiş anahtarı eklemek için onay verebilen bir cihaz kullanın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پاس کی شامل کرنے کے لیے ایسی ڈیوائس استعمال کریں جو منظور کر سکتی ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để thêm khóa truy cập, hãy dùng một thiết bị có thể phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要新增密碼金鑰，請使用可以核准的裝置。"
          }
