    "door.whatsapp_android": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine WhatsApp-Tür lässt sich in der Android-App noch nicht hinzufügen. Füge sie in tafs auf einem iPhone hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding a WhatsApp door isn't in the Android app yet. Add it from tafs on an iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir una puerta de WhatsApp aún no está en la app de Android. Añádela desde tafs en un iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ajout d'une porte WhatsApp n'est pas encore disponible dans l'app Android. Ajoutez-la depuis tafs sur un iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aggiunta di una porta WhatsApp non è ancora nell'app Android. Aggiungila da tafs su un iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een WhatsApp-deur toevoegen kan nog niet in de Android-app. Voeg hem toe vanuit tafs op een iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawania drzwi WhatsApp nie ma jeszcze w aplikacji na Androida. Dodaj je z tafs na iPhonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não é possível adicionar uma porta do WhatsApp na app Android. Adicione-a a partir do tafs num iPhone."
          }
        }
      }
    },
    "door.whatsapp_elsewhere": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp-Türen werden vorerst in tafs auf einem iPhone hinzugefügt; danach erscheinen sie hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp doors are added from tafs on an iPhone for now; once added, they show here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora, las puertas de WhatsApp se añaden desde tafs en un iPhone; una vez añadidas, aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les portes WhatsApp s'ajoutent pour l'instant depuis tafs sur un iPhone ; une fois ajoutées, elles s'affichent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora le porte WhatsApp si aggiungono da tafs su un iPhone; una volta aggiunte, compaiono qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp-deuren worden voorlopig toegevoegd vanuit tafs op een iPhone; daarna verschijnen ze hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drzwi WhatsApp dodaje się na razie z tafs na iPhonie; po dodaniu pojawią się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por agora, as portas do WhatsApp são adicionadas a partir do tafs num iPhone; depois de adicionadas, aparecem aqui."
          }
        }
      }
    },
