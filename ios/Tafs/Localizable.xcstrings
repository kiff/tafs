        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai taf jūsų laukia, jis laukia skiltyje „Laukia jūsų“. Tvirtinate su Touch ID ar telefone arba atmetate."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad taf vajag tavu atbildi, tas gaida sadaļā “Gaida tevi”. Tu apstiprini ar Touch ID vai savā tālrunī vai atsaki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een taf je nodig heeft, wacht hij in ‘Wacht op jou’. Je keurt goed met Touch ID of op je telefoon, of weigert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy taf Cię potrzebuje, czeka w „Czeka na Ciebie”. Zatwierdzasz przez Touch ID lub na telefonie albo odrzucasz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf precisa de si, espera em «Precisa de si». Aprova com Touch ID ou no telemóvel, ou recusa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf precisa de você, espera em «Precisa de você». Aprova com Touch ID ou no celular, ou recusa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când un taf are nevoie de dvs., așteaptă în Vă așteaptă. Aprobați cu Touch ID sau pe telefon, ori refuzați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď vás taf potrebuje, čaká v Čaká na vás. Schválite cez Touch ID alebo v telefóne, alebo odmietnete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko vas taf potrebuje, čaka v Čaka na vas. Odobrite s Touch ID ali v telefonu ali zavrnete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur një taf ka nevojë për ju, pret te Ju pret. Miratoni me Touch ID ose në telefonin tuaj, ose refuzoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad tafu trebate vi, čeka u Čeka vas. Odobravate Touch ID-jem ili na telefonu ili odbijate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อ taf ต้องการคุณ มันจะรออยู่ในรอคุณอยู่ คุณอนุมัติด้วย Touch ID หรือบนโทรศัพท์ หรือปฏิเสธ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir taf'ın size ihtiyacı olduğunda Sizi bekliyor'da bekler. Touch ID ile veya telefonunuzdan onaylar ya da reddedersiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một taf cần bạn, nó chờ trong Đang chờ bạn. Bạn phê duyệt bằng Touch ID hoặc trên điện thoại, hoặc từ chối."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 taf 需要您時，它會在「等您處理」中等候。您可用 Touch ID 或在手機上核准，或拒絕。"
          }
        }
      }
    },
