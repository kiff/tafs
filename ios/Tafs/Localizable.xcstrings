    "approval.new_fingerprint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonradan başqa barmaq izi əlavə etsəniz, bu telefonda təsdiq yenidən təsdiq edənə qədər dayanır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако по-късно добавите друг пръстов отпечатък, одобряването на този телефон спира, докато не го одобрите отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud později přidáte další otisk prstu, schvalování v tomto telefonu přestane fungovat, dokud ho znovu neschválíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügst du später einen weiteren Fingerabdruck hinzu, kann dieses Telefon nicht mehr genehmigen, bis du es erneut genehmigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you add another fingerprint later, approving on this phone stops until you approve it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si más adelante añades otra huella, aprobar en este teléfono deja de funcionar hasta que lo vuelvas a aprobar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui lisad hiljem veel ühe sõrmejälje, ei saa selles telefonis kinnitada enne, kui kinnitad selle uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous ajoutez plus tard une autre empreinte, l'approbation sur ce téléphone s'arrête jusqu'à ce que vous l'approuviez à nouveau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako kasnije dodate još jedan otisak prsta, odobravanje na ovom telefonu prestaje dok ga ponovno ne odobrite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha később újabb ujjlenyomatot adsz hozzá, a jóváhagyás ezen a telefonon leáll, amíg újra jóvá nem hagyod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե հետագայում ավելացնեք ևս մեկ մատնահետք, այս հեռախոսով հաստատումը կդադարի, մինչև նորից չհաստատեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda menambahkan sidik jari lain nanti, persetujuan di ponsel ini berhenti sampai Anda menyetujuinya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se in seguito aggiungi un'altra impronta, le approvazioni su questo telefono si fermano finché non lo approvi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で別の指紋を追加すると、もう一度承認するまで、このスマートフォンでの承認は停止します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ მოგვიანებით სხვა თითის ანაბეჭდს დაამატებთ, ამ ტელეფონზე დამტკიცება შეწყდება, სანამ ხელახლა არ დაამტკიცებთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 지문을 더 추가하면, 이 휴대폰을 다시 승인할 때까지 이 휴대폰에서는 승인할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei vėliau pridėsite dar vieną piršto atspaudą, tvirtinti šiame telefone nebus galima, kol jo dar kartą nepatvirtinsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja vēlāk pievienosi vēl kādu pirksta nospiedumu, apstiprināšana šajā tālrunī apstāsies, līdz tu to vēlreiz apstiprināsi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg je later nog een vingerafdruk toe, dan stopt goedkeuren op deze telefoon tot je hem opnieuw goedkeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli później dodasz kolejny odcisk palca, zatwierdzanie na tym telefonie przestanie działać, dopóki nie zatwierdzisz go ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se adicionar outra impressão digital mais tarde, as aprovações neste telefone param até o aprovar novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se adicionar outra impressão digital mais tarde, as aprovações neste telefone param até o aprovar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă adăugați mai târziu o altă amprentă, aprobarea pe acest telefon se oprește până îl aprobați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak neskôr pridáte ďalší odtlačok prsta, schvaľovanie v tomto telefóne prestane fungovať, kým ho znova neschválite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če pozneje dodate še en prstni odtis, se odobravanje v tem telefonu ustavi, dokler ga znova ne odobrite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse shtoni një gjurmë gishti tjetër më vonë, miratimi në këtë telefon ndalon derisa ta miratoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako kasnije dodate još jedan otisak prsta, odobravanje na ovom telefonu prestaje dok ga ponovo ne odobrite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณเพิ่มลายนิ้วมืออื่นภายหลัง การอนุมัติบนโทรศัพท์เครื่องนี้จะหยุดจนกว่าคุณจะอนุมัติอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha sonra başka bir parmak izi eklerseniz, bu telefonda onaylama, tekrar onaylayana kadar durur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu sau này bạn thêm một vân tay khác, việc phê duyệt trên điện thoại này sẽ dừng cho đến khi bạn phê duyệt lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您之後新增其他指紋，在您重新核准之前，這部手機將無法核准。"
          }
        }
      }
    },
    "approval.no_fingerprint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefondan təsdiq etmək üçün ona barmaq izi əlavə edin. Rədd etmək yenə də işləyir."
          }
        },
        "bg": {
