    "needs_you.get_alert_when_call_waits": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على تنبيه عندما ينتظر طلب استدعاء ردك، حتى مع إغلاق tafs."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çağırış cavabınızı gözləyəndə, tafs bağlı olsa belə, bildiriş alın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Получавайте известие, когато заявка чака вашия отговор, дори когато tafs е затворен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো কল আপনার উত্তরের অপেক্ষায় থাকলে, tafs বন্ধ থাকলেও, অ্যালার্ট পান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rep una alerta quan una crida espera la teva resposta, fins i tot amb tafs tancat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostávejte upozornění, když volání čeká na vaši odpověď, i když je tafs zavřený."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dich benachrichtigen, wenn ein Aufruf auf deine Antwort wartet, auch wenn tafs geschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get an alert when a call waits for your answer, even with tafs closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe una alerta cuando una llamada espere tu respuesta, aunque tafs esté cerrado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa teavitus, kui päring ootab sinu vastust, isegi kui tafs on suletud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une alerte quand un appel attend votre réponse, même si tafs est fermé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבלת התראה כשקריאה ממתינה לתשובה שלך, גם כש-tafs סגור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई कॉल आपके उत्तर का इंतज़ार करे तो अलर्ट पाएँ, tafs बंद होने पर भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primite obavijest kad poziv čeka vaš odgovor, čak i kad je tafs zatvoren."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapj riasztást, ha egy hívás a válaszodra vár, akkor is, ha a tafs be van zárva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ստացեք ծանուցում, երբ զանգը սպասում է ձեր պատասխանին, նույնիսկ երբ tafs-ը փակ է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan peringatan saat sebuah panggilan menunggu jawaban Anda, bahkan saat tafs ditutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi un avviso quando una chiamata aspetta la tua risposta, anche con tafs chiusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsを閉じていても、呼び出しが回答を待っているときに通知を受け取ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიიღეთ შეტყობინება, როცა ზარი თქვენს პასუხს ელოდება, tafs დახურულიც რომ იყოს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទទួលការជូនដំណឹងនៅពេលការហៅមួយរង់ចាំចម្លើយរបស់អ្នក ទោះ tafs បិទក៏ដោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호출이 내 답변을 기다리면, tafs를 닫아 두어도 알림을 받습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຮັບການແຈ້ງເຕືອນເມື່ອມີການໂທລໍຖ້າຄຳຕອບຂອງທ່ານ ເຖິງວ່າ tafs ປິດຢູ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaukite pranešimą, kai užklausa laukia jūsų atsakymo, net kai tafs uždaryta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saņem paziņojumu, kad izsaukums gaida tavu atbildi, pat ja tafs ir aizvērts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Добиј известување кога некое барање чека на твојот одговор, дури и кога tafs е затворен."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуудлага таны хариуг хүлээх үед tafs хаалттай байсан ч мэдэгдэл аваарай."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कुनै कल तपाईंको जवाफको प्रतीक्षामा हुँदा tafs बन्द भए पनि सूचना पाउनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg een melding als een aanroep op je antwoord wacht, ook als tafs gesloten is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj alert, gdy wywołanie czeka na Twoją odpowiedź, nawet gdy tafs jest zamknięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba um alerta quando uma chamada aguardar a sua resposta, mesmo com o tafs fechado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba um alerta quando uma chamada aguardar a sua resposta, mesmo com o tafs fechado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primiți o alertă când un apel așteaptă răspunsul dvs., chiar și cu tafs închis."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostávajte upozornenie, keď volanie čaká na vašu odpoveď, aj keď je tafs zatvorený."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejmite opozorilo, ko klic čaka na vaš odgovor, tudi ko je tafs zaprt."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Merrni një njoftim kur një thirrje pret përgjigjen tuaj, edhe kur tafs është mbyllur."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Primite obaveštenje kad poziv čeka vaš odgovor, čak i kad je tafs zatvoren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับการแจ้งเตือนเมื่อมีการเรียกรอคำตอบของคุณ แม้ปิด tafs อยู่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Çagyryş jogabyňyza garaşanda, tafs ýapyk wagty hem duýduryş alyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çağrı yanıtınızı beklediğinde, tafs kapalı olsa bile uyarı alın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کوئی کال آپ کے جواب کی منتظر ہو تو الرٹ پائیں، چاہے tafs بند ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận cảnh báo khi một lệnh gọi chờ bạn trả lời, kể cả khi tafs đã đóng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當有呼叫等待您回覆時收到通知，即使 tafs 已關閉。"
          }
        }
      }
    },
    "needs_you.install_from_card": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّته من بطاقته: تصبح النسخة فعّالة ثم يعلم Coach."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onu kartından quraşdırın: versiya işə düşür, sonra Coach xəbər tutur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирайте я от картата ѝ: версията става активна, после Coach разбира."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর কার্ড থেকে ইনস্টল করুন: সংস্করণটি চালু হয়, তারপর Coach জানতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal·la-la des de la seva targeta: la versió entra en producció i després Coach ho sap."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nainstalujte ho z jeho karty: verze se aktivuje a pak se to Coach dozví."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere sie über ihre Karte: Die Version geht live, dann erfährt Coach davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install it from its card: the version goes live, then Coach hears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instálala desde su tarjeta: la versión se activa y luego Coach se entera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigalda see selle kaardilt: versioon võetakse kasutusele, siis saab Coach teada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez-la depuis sa fiche : la version est mise en service, puis Coach est prévenu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להתקין אותה מהכרטיס שלה: הגרסה נהיית פעילה, ואז Coach מקבל הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे इसके कार्ड से इंस्टॉल करें: संस्करण चालू होता है, फिर Coach सुनता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirajte ga iz njegova okvira: verzija ide uživo, a zatim Coach to čuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepítsd a kártyájáról: a verzió élesedik, aztán a Coach értesül."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեղադրեք այն իր քարտից․ տարբերակը դառնում է ակտիվ, ապա Coach-ը իմանում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang dari kartunya: versi mulai aktif, lalu Coach tahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installala dalla sua scheda: la versione diventa attiva, poi Coach viene informato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードからインストールしてください。バージョンが適用された後、Coachに伝わります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დააყენეთ მისი ბარათიდან: ვერსია აქტიური ხდება, შემდეგ Coach იგებს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដំឡើងវាពីកាតរបស់វា៖ កំណែចាប់ផ្តើមដំណើរការ បន្ទាប់មក Coach ដឹង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드에서 설치하세요. 버전이 적용된 뒤 Coach에게 전달됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕິດຕັ້ງຈາກບັດຂອງມັນ: ເວີຊັນເລີ່ມໃຊ້ງານ ແລ້ວ Coach ຮູ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įdiekite ją iš jos kortelės: versija aktyvuojama, tada apie tai sužino Coach."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalē to no tās kartītes: versija tiek laista darbā, tad Coach par to uzzina."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирај ја од нејзината картичка: верзијата станува активна, па Coach слуша."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түүний картаас суулгана уу: хувилбар идэвхжиж, дараа нь Coach мэднэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसको कार्डबाट स्थापना गर्नुहोस्: संस्करण सक्रिय हुन्छ, त्यसपछि Coach ले थाहा पाउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer het vanaf de kaart: de versie gaat live, daarna hoort Coach het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj ją z jej karty: wersja zacznie działać na żywo, a potem Coach się o tym dowie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale-a a partir do seu cartão: a versão entra em produção e depois o Coach é informado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale-a a partir do seu cartão: a versão entra em produção e depois o Coach é informado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalați-o din cardul ei: versiunea devine activă, apoi Coach află."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nainštalujte ho z jeho karty: verzia sa aktivuje a potom sa to Coach dozvie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namestite ga s njegove kartice: različica postane aktivna, nato izve Coach."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalojeni nga karta e tij: versioni bëhet aktiv, pastaj Coach e merr vesh."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirajte ga iz njegova okvira: verzija ide uživo, a zatim Coach to čuje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งจากการ์ดของมัน: เวอร์ชันจะเริ่มใช้งาน แล้ว Coach จะรับรู้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ony kartasyndan guruň: wersiýa işjeň bolýar, soňra Coach eşidýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartından kurun: sürüm yayına girer, sonra Coach haber alır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے اس کے card سے انسٹال کریں: ورژن لائیو ہو جاتا ہے، پھر Coach کو پتہ چلتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt từ thẻ của nó: phiên bản bắt đầu hoạt động, rồi Coach được biết."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從它的卡片安裝：該版本會上線，然後 Coach 會收到通知。"
          }
        }
      }
    },
