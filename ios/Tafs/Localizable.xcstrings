    "chat.not_on_cloud": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu taf tafs cloud-da işləmir, ona görə ona yazmaq olmur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този taf не работи в tafs cloud, така че не може да му се пишат съобщения."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento taf neběží v tafs cloud, takže mu nelze psát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser taf läuft nicht auf tafs cloud, daher kann man ihm keine Nachricht schreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This taf isn't running on tafs cloud, so it can't be messaged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este taf no se ejecuta en tafs cloud, así que no se le pueden enviar mensajes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See taf ei tööta tafs cloudis, seega ei saa sellele kirjutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce taf ne tourne pas sur tafs cloud : on ne peut pas lui écrire."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj taf ne radi na tafs cloudu pa mu se ne može slati poruka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a taf nem a tafs cloudon fut, ezért nem lehet neki üzenni."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս taf-ը չի աշխատում tafs cloud-ում, ուստի նրան հաղորդագրություն չի կարելի գրել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf ini tidak berjalan di tafs cloud, jadi tidak dapat dikirimi pesan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo taf non funziona su tafs cloud, quindi non puoi scrivergli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このtafはtafsクラウドで動いていないため、メッセージを送れません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს taf tafs cloud-ზე არ მუშაობს, ამიტომ მას შეტყობინებას ვერ გაუგზავნით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 taf는 tafs cloud에서 실행되지 않아 메시지를 보낼 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis taf neveikia tafs cloud, todėl jam rašyti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis taf nedarbojas tafs cloud, tāpēc tam nevar rakstīt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit taf draait niet op tafs cloud, dus je kunt het geen bericht sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten taf nie działa w tafs cloud, więc nie można do niego pisać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este taf não está a funcionar no tafs cloud, por isso não pode receber mensagens."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este taf não está funcionando no tafs cloud, por isso não pode receber mensagens."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest taf nu rulează în tafs cloud, așa că nu i se pot trimite mesaje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento taf nebeží v tafs cloud, takže mu nemožno písať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta taf ne teče v tafs cloud, zato mu ni mogoče pisati."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky taf nuk po ekzekutohet në tafs cloud, ndaj nuk mund t'i dërgohet mesazh."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj taf ne radi na tafs cloudu pa mu se ne može slati poruka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "taf นี้ไม่ได้ทำงานบน tafs cloud จึงส่งข้อความถึงไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu taf tafs cloud'da çalışmıyor, bu yüzden ona mesaj gönderilemez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf này không chạy trên tafs cloud nên không thể nhắn cho nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 taf 並非在 tafs cloud 上執行，因此無法傳訊息給它。"
          }
        }
      }
