    "approval.state.none_enrolled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Telefon ist kein Fingerabdruck eingerichtet. Füge in seinen Einstellungen einen hinzu und komm dann zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No fingerprint is set up on this phone. Add one in its settings, then come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna huella configurada en este teléfono. Añade una en sus ajustes y vuelve."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selles telefonis pole sõrmejälge seadistatud. Lisa see telefoni seadetes ja tule siis tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune empreinte n'est configurée sur ce téléphone. Ajoutez-en une dans ses paramètres, puis revenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna impronta è configurata su questo telefono. Aggiungine una nelle sue impostazioni, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンには指紋が設定されていません。設定で追加してから戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에 등록된 지문이 없습니다. 설정에서 추가한 뒤 돌아오세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiame telefone nenustatytas joks piršto atspaudas. Pridėkite jį telefono nustatymuose ir grįžkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šajā tālrunī nav iestatīts neviens pirksta nospiedums. Pievieno to tālruņa iestatījumos, tad atgriezies."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen vingerafdruk ingesteld op deze telefoon. Voeg er een toe in de instellingen en kom dan terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym telefonie nie skonfigurowano odcisku palca. Dodaj go w ustawieniach telefonu, a potem wróć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nenhuma impressão digital configurada neste telefone. Adicione uma nas definições e depois volte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nenhuma impressão digital configurada neste telefone. Adicione uma nas configurações e depois volte."
          }
        }
      }
    },
