        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perėmėte valdymą, todėl Coach leido jums tęsti"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pārņēmi vadību, tāpēc Coach ļāva tev turpināt"
