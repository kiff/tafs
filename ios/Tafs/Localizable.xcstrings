        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 끝나지 않았습니다: %2$@을(를) 삭제하지 못했습니다. 새로 고칠 때마다 tafs가 다시 시도합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Nebaigta: nepavyko pašalinti: %2$@. tafs bandys dar kartą kaskart atsinaujindama."
