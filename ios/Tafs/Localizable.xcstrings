        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे केवल खाते का स्वामी हटा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Račun može izbrisati samo njegov vlasnik."
