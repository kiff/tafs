    "people.manager_explains": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Manager fügt Mitglieder der Gruppe hinzu und entfernt sie. Verwalten erlaubt nicht, die Cards eines tafs zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A manager adds and removes the group's members. Managing doesn't let them change a taf's Cards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un responsable añade y quita a los miembros del grupo. Ser responsable no le permite cambiar las Cards de un taf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un responsable ajoute et retire les membres du groupe. Être responsable ne permet pas de modifier les Cards d'un taf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un responsabile aggiunge e rimuove i membri del gruppo. Gestire il gruppo non gli permette di cambiare le Card di un taf."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een manager voegt leden van de groep toe en verwijdert ze. Managen geeft geen recht om de Cards van een taf te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Menedżer dodaje i usuwa członków grupy. Zarządzanie nie pozwala mu zmieniać Card tafa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gestor adiciona e remove os membros do grupo. Gerir não lhe permite alterar os Cards de um taf."
          }
        }
      }
    },
