        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez sok üzenet néhány perc alatt. Adj egy kis időt neki (%1$@), aztán próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա շատ հաղորդագրություն է մի քանի րոպեում։ Տվեք %1$@-ին մի պահ, ապա փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu banyak sekali pesan dalam beberapa menit. Beri %1$@ waktu sebentar, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono tanti messaggi in pochi minuti. Dai a %1$@ un momento, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数分間にメッセージが多すぎます。少し%1$@を待ってから、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ძალიან ბევრი შეტყობინებაა რამდენიმე წუთში. მიეცით %1$@-ს მცირე დრო, შემდეგ სცადეთ ხელახლა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នោះជាសារច្រើនក្នុងរយៈពេលពីរបីនាទី។ ឱ្យ %1$@ មួយភ្លែត រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 분 사이에 메시지가 너무 많습니다. %1$@에게 잠시 시간을 준 뒤 다시 시도하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຂໍ້ຄວາມຫຼາຍເກີນໄປໃນສອງສາມນາທີ. ໃຫ້ %1$@ ຊົ່ວຄາວ ແລ້ວລອງໃໝ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per kelias minutes – daug žinučių. Duokite %1$@ akimirką ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dažās minūtēs ir daudz ziņu. Dod %1$@ brīdi laika, tad mēģini vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тоа се многу пораки за неколку минути. Дај му на %1$@ момент, па обиди се повторно."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэдхэн минутад маш олон мессеж байна. %1$@-д түр завсарлага өгөөд дахин оролдоно уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "केही मिनेटमा धेरै सन्देश भए। %1$@ लाई केही क्षण दिनुहोस्, त्यसपछि फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zijn veel berichten in een paar minuten. Geef %1$@ even de tijd en probeer het dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To dużo wiadomości w kilka minut. Daj %1$@ chwilę, a potem spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São muitas mensagens em poucos minutos. Dê um momento a %1$@ e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São muitas mensagens em poucos minutos. Dê um momento a %1$@ e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt multe mesaje în câteva minute. Lăsați-i lui %1$@ un moment, apoi încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Za pár minút je to veľa správ. Dajte %1$@ chvíľku a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je veliko sporočil v nekaj minutah. Dajte %1$@ trenutek, nato poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Janë shumë mesazhe për pak minuta. I jepni %1$@ një çast, pastaj provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "To je puno poruka u nekoliko minuta. Dajte tafu %1$@ trenutak, pa pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีข้อความมากเกินไปในไม่กี่นาที ให้เวลา %1$@ สักครู่ แล้วลองอีกครั้ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu birnäçe minutda gaty köp habar. %1$@-a bir salym beriň, soňra täzeden synanyşyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç dakikada çok fazla mesaj. %1$@ taf'ına bir an tanıyın, sonra tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چند منٹوں میں یہ بہت سارے پیغامات ہیں۔ %1$@ کو تھوڑا وقت دیں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có quá nhiều tin nhắn trong vài phút. Hãy cho %1$@ một lát, rồi thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短時間內訊息過多。請讓 %1$@ 稍候片刻，再試一次。"
          }
        }
      }
    },
