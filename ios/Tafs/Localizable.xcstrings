            "state": "translated",
            "value": "Остатокот е на твојот телефон."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлдсэн нь таны утсан дээр байна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "बाँकी तपाईंको फोनमा छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rest staat op je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reszta jest na telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resto está no telemóvel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resto está no celular."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restul este pe telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvyšok je v telefóne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostalo je v telefonu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pjesa tjetër është në telefonin tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostalo je na vašem telefonu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่เหลืออยู่บนโทรศัพท์ของคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Galany telefonyňyzda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerisi telefonunuzda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باقی آپ کے فون پر ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần còn lại ở trên điện thoại của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其餘內容在您的手機上。"
