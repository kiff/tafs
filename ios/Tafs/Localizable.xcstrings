    "version.first_only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher eine Version. Wenn du ihn verbesserst, wird jede Änderung hier festgehalten."
          }
        },
        "en": {
