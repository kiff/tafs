          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen taf gebruikt %1$@ nu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden taf nie używa teraz %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum taf usa %1$@ agora."
          }
        },
        "pt-BR": {
