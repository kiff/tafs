          "stringUnit": {
            "state": "translated",
            "value": "Váš hlas sa v tomto zariadení zmení na text. Neodošle sa, kým ho neodošlete vy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš glas postane besedilo na tej napravi. Ne pošlje se, dokler ga ne pošljete vi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Zëri juaj kthehet në tekst në këtë pajisje. Nuk dërgohet derisa ta dërgoni ju."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš glas postaje tekst na ovom uređaju. Ne šalje se dok ga vi ne pošaljete."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงของคุณกลายเป็นข้อความบนอุปกรณ์นี้ ข้อความจะไม่ถูกส่งจนกว่าคุณจะกดส่ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiňiz bu enjamda tekste öwrülýär. Siz ibermeýänçäňiz ol iberilmeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiniz bu cihazda metne dönüşür. Siz göndermeden gönderilmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی آواز اس ڈیوائس پر متن بن جاتی ہے۔ جب تک آپ بھیجیں نہیں یہ نہیں بھیجی جاتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng nói của bạn được chuyển thành văn bản trên thiết bị này. Văn bản không được gửi cho đến khi bạn gửi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的語音會在這部裝置上轉成文字。在您傳送之前不會送出。"
          }
        }
      }
    },
    "voice.what_you_said_stays_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما قلته يبقى في مربع الرسالة، غير مُرسل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dediyiniz mesaj qutusunda, göndərilməmiş qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това, което казахте, остава в полето за съобщение, неизпратено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যা বলেছেন তা বার্তার বাক্সে, না পাঠানো অবস্থায় থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El que has dit es queda al quadre de missatge, sense enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jste řekli, zůstane v poli zprávy, neodeslané."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du gesagt hast, bleibt ungesendet im Nachrichtenfeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you said stays in the message box, unsent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que dijiste se queda en el cuadro de mensaje, sin enviar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See, mida ütlesid, jääb sõnumikasti saatmata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez dit reste dans le champ de message, non envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה שאמרת נשאר בתיבת ההודעה, לא נשלח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो आपने कहा वह संदेश बॉक्स में, बिना भेजे रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ono što ste rekli ostaje u okviru za poruku, neposlano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit mondtál, az üzenetmezőben marad, elküldetlenül."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչ ասացիք, մնում է հաղորդագրության դաշտում՝ չուղարկված։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang Anda ucapkan tetap di kotak pesan, belum terkirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che hai detto resta nella casella del messaggio, non inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容は、未送信のままメッセージ欄に残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რაც თქვით, რჩება შეტყობინების ველში, გაუგზავნელი."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីដែលអ្នកបាននិយាយនៅក្នុងប្រអប់សារ ដោយមិនទាន់ផ្ញើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말한 내용은 보내지 않은 채 메시지 입력란에 남아 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສິ່ງທີ່ທ່ານເວົ້າຢູ່ໃນກ່ອງຂໍ້ຄວາມ, ຍັງບໍ່ໄດ້ສົ່ງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai, ką pasakėte, lieka žinutės laukelyje, neišsiųsta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas, ko teici, paliek ziņas laukā, nenosūtīts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Она што го рече останува во полето за порака, неиспратено."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны хэлсэн нь илгээгдээгүй, мессежийн талбарт үлдэнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले भनेको कुरा नपठाइएको अवस्थामा सन्देश बाकसमै रहन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je zei, blijft onverzonden in het berichtvak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podyktowany tekst zostaje w polu wiadomości, niewysłany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que disse fica na caixa de mensagem, por enviar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que disse fica na caixa de mensagem, por enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ați spus rămâne în caseta de mesaj, netrimis."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo ste povedali, zostane v poli správy, neodoslané."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kar ste povedali, ostane v polju za sporočilo, neposlano."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajo që thatë qëndron në kutinë e mesazhit, e padërguar."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ono šta ste rekli ostaje u okviru za poruku, neposlano."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คุณพูดจะอยู่ในช่องข้อความ โดยยังไม่ได้ส่ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aýdanyňyz habar gutusynda, iberilmän galýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Söyledikleriniz mesaj kutusunda, gönderilmemiş olarak kalır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو آپ نے کہا وہ پیغام کے خانے میں بغیر بھیجے رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều bạn đã nói vẫn ở trong hộp tin nhắn, chưa gửi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您說的內容會留在訊息框中，尚未傳送。"
          }
