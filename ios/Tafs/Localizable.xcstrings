    "version.doesnt_run_until": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-ınız quraşdırılana və ya siz ləğv edənə qədər işləmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашият taf не работи, докато не бъде инсталиран или докато не откажете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš taf neběží, dokud se nenainstaluje nebo to nezrušíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein taf läuft nicht, bis sie installiert ist oder du abbrichst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your taf doesn't run until it's installed or you cancel."
          }
        },
        "es": {
