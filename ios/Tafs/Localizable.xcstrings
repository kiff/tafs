        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido não corresponde ao que mostra, por isso não pode ser aprovado."
          }
        }
      }
    },
    "connect.schedule_chats_run_reports_memory": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Sein Zeitplan, seine Chats, Laufberichte, sein Gedächtnis und sein Schlüssel werden gelöscht, und der Name %2$@ wird frei. KIFFs Belege bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Its schedule, chats, run reports, memory and key are deleted, and the name %2$@ is free. KIFF's receipts stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Se eliminan su programación, sus chats, sus informes de ejecución, su memoria y su clave, y el nombre %2$@ queda libre. Los recibos de KIFF se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Son planning, ses chats, ses rapports d'exécution, sa mémoire et sa clé sont supprimés, et le nom %2$@ redevient libre. Les reçus de KIFF restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ La sua pianificazione, le chat, i resoconti delle esecuzioni, la memoria e la chiave vengono eliminati, e il nome %2$@ torna libero. Le ricevute di KIFF restano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ De planning, chats, runrapporten, het geheugen en de sleutel worden verwijderd, en de naam %2$@ komt vrij. De ontvangstbewijzen van KIFF blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Jego harmonogram, czaty, raporty z uruchomień, pamięć i klucz zostaną usunięte, a nazwa %2$@ będzie wolna. Potwierdzenia KIFF zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ O seu agendamento, chats, relatórios de execução, memória e chave são eliminados, e o nome %2$@ fica livre. Os recibos do KIFF mantêm-se."
          }
        }
      }
    },
