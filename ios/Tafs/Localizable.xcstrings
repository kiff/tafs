            "value": "Pas de réponse envoyée : cela n'a pas été confirmé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije odgovoreno: nije potvrđeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs megválaszolva: nem lett megerősítve."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չպատասխանվեց․ չհաստատվեց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dijawab: belum dikonfirmasi."
