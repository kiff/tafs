    "sample.credits.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحتسب كل تشغيل مرة واحدة، عند انتهائه، بأرصدة كاملة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər iş bir dəfə, bitəndə, tam kreditlərlə hesablanır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко изпълнение се отчита веднъж, когато приключи, в цели кредити."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি রান শেষ হওয়ার সময় একবার, পূর্ণ ক্রেডিটে গণনা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada execució compta una vegada, quan acaba, en crèdits enters."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý běh se počítá jednou, když skončí, v celých kreditech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Lauf zählt einmal, wenn er endet, in ganzen Credits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each run counts once, when it ends, in whole credits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ejecución cuenta una vez, al terminar, en créditos enteros."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga käivitus arvestatakse üks kord, kui see lõpeb, täiskrediitides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque exécution compte une fois, à sa fin, en crédits entiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל ריצה נספרת פעם אחת, כשהיא מסתיימת, בקרדיטים שלמים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर रन खत्म होने पर, पूरे क्रेडिट में, एक बार गिनी जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako se izvođenje računa jednom, kad završi, u cijelim kreditima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden futás egyszer számít, amikor véget ér, egész kreditekben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր գործարկում հաշվվում է մեկ անգամ, երբ ավարտվում է, ամբողջ կրեդիտներով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap eksekusi dihitung sekali, saat berakhir, dalam kredit utuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni esecuzione conta una volta, quando termina, in crediti interi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各実行は終了時に1回、クレジット単位でカウントされます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყოველი გაშვება ითვლება ერთხელ, როცა მთავრდება, მთელ კრედიტებში."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការដំណើរការនីមួយៗរាប់ម្តង នៅពេលវាបញ្ចប់ ជាក្រេឌីតទាំងមូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 실행은 끝날 때 한 번, 크레딧 단위로 계산됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແຕ່ລະການເຮັດວຽກນັບຄັ້ງດຽວ, ເມື່ອຈົບ, ເປັນເຄຣດິດເຕັມ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas paleidimas skaičiuojamas vieną kartą, jam pasibaigus, sveikais kreditais."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katra palaišana tiek skaitīta vienreiz, kad tā beidzas, veselos kredītos."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секое извршување се брои еднаш, кога ќе заврши, во цели кредити."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ажиллалт бүр дуусахад нэг удаа, бүхэл кредитээр тооцогдоно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक चलाइ सकिँदा एकपटक, पूरा क्रेडिटमा गनिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke run telt één keer, wanneer die eindigt, in hele credits."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde uruchomienie liczy się raz, gdy się kończy, w pełnych kredytach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada execução conta uma vez, quando termina, em créditos inteiros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada execução conta uma vez, quando termina, em créditos inteiros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare rulare se numără o dată, când se încheie, în credite întregi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý beh sa počíta raz, keď skončí, v celých kreditoch."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak zagon se šteje enkrat, ko se konča, v celih kreditih."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo ekzekutim numërohet një herë, kur mbaron, në kredite të plota."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako se izvršavanje naloga jednom, kad završi, u celim kreditima."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละการทำงานนับครั้งเดียวเมื่อสิ้นสุด เป็นเครดิตเต็มหน่วย"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Her işleme gutaranda, bütin kredit bilen, bir gezek hasaplanýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her çalıştırma, bittiğinde, tam kredi olarak bir kez sayılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر رن ختم ہونے پر ایک بار، پورے کریڈٹس میں شمار ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lượt chạy được tính một lần, khi nó kết thúc, theo số tín dụng nguyên."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次執行在結束時計算一次，以整數點數計。"
          }
        }
      }
    },
