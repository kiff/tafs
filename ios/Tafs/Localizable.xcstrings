    "people.manager_explains": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف المدير أعضاء المجموعة ويزيلهم. لا تتيح له الإدارة تغيير Cards الخاصة بأي taf."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Menecer qrupun üzvlərini əlavə edir və çıxarır. İdarə etmək ona taf-ın Card-larını dəyişməyə icazə vermir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мениджърът добавя и премахва членовете на групата. Управлението не му позволява да променя Cards на taf."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যানেজার গ্রুপের সদস্য যোগ ও সরান। পরিচালনা করলে তিনি taf-এর Card বদলাতে পারেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gestor afegeix i treu els membres del grup. Gestionar no li permet canviar els Card d'un taf."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Správce přidává a odebírá členy skupiny. Správa mu nedovoluje měnit Card tafu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Manager fügt Mitglieder der Gruppe hinzu und entfernt sie. Verwalten erlaubt nicht, die Cards eines tafs zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A manager adds and removes the group's members. Managing doesn't let them change a taf's Cards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un responsable añade y quita a los miembros del grupo. Ser responsable no le permite cambiar las Cards de un taf."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Haldur lisab ja eemaldab grupi liikmeid. Haldamine ei luba muuta tafi Carde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un responsable ajoute et retire les membres du groupe. Être responsable ne permet pas de modifier les Cards d'un taf."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנהל מוסיף ומסיר את חברי הקבוצה. ניהול לא מאפשר לו לשנות את ה-Card של taf."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रबंधक समूह के सदस्य जोड़ता और हटाता है। प्रबंध करने से वे किसी taf के Card नहीं बदल सकते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voditelj dodaje članove grupe i uklanja ih. Voditeljstvo mu ne dopušta mijenjati Cardove tafa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezelő hozzáadja és eltávolítja a csoport tagjait. A kezelés nem jogosít fel egy taf Cardjainak módosítására."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կառավարիչը ավելացնում և հեռացնում է խմբի անդամներին։ Կառավարումը նրան թույլ չի տալիս փոխել taf-ի Card-երը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengelola menambah dan menghapus anggota grup. Mengelola tidak memungkinkan mereka mengubah Card sebuah taf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un responsabile aggiunge e rimuove i membri del gruppo. Gestire il gruppo non gli permette di cambiare le Card di un taf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者はグループのメンバーを追加・削除します。管理者でもtafのCardは変更できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მენეჯერი ამატებს და ართმევს ჯგუფის წევრებს. მართვა არ აძლევს მას taf-ის Card-ების შეცვლის უფლებას."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកគ្រប់គ្រងបន្ថែម និងដកសមាជិកក្រុមចេញ។ ការគ្រប់គ្រងមិនអនុញ្ញាតឱ្យពួកគេផ្លាស់ប្តូរ Card របស់ taf ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자는 그룹의 멤버를 추가하고 제거합니다. 관리자라도 taf의 Card는 변경할 수 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຜູ້ຈັດການເພີ່ມ ແລະ ລຶບສະມາຊິກຂອງກຸ່ມ. ການຈັດການບໍ່ໄດ້ໃຫ້ເຂົາເຈົ້າປ່ຽນ Card ຂອງ taf."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vadovas prideda ir šalina grupės narius. Vadovavimas neleidžia keisti taf Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vadītājs pievieno un noņem grupas dalībniekus. Vadīšana neļauj mainīt taf Card."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Менаџерот додава и отстранува членови на групата. Управувањето не му дозволува да ги менува Card на tafовите."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Менежер бүлгийн гишүүдийг нэмж, хасдаг. Удирдах нь тэдэнд taf-ын Card-уудыг өөрчлөх эрх өгдөггүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवस्थापकले समूहका सदस्य थप्छन् र हटाउँछन्। व्यवस्थापनले उनीहरूलाई कुनै taf का Card परिवर्तन गर्न दिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een manager voegt leden van de groep toe en verwijdert ze. Managen geeft geen recht om de Cards van een taf te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Menedżer dodaje i usuwa członków grupy. Zarządzanie nie pozwala mu zmieniać Card tafa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gestor adiciona e remove os membros do grupo. Gerir não lhe permite alterar os Cards de um taf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gestor adiciona e remove os membros do grupo. Gerenciar não lhe permite alterar os Cards de um taf."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un manager adaugă și elimină membrii grupului. Gestionarea nu îi permite să schimbe Cardurile unui taf."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Správca pridáva a odoberá členov skupiny. Správa mu nedovoľuje meniť Card tafu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravitelj dodaja in odstranjuje člane skupine. Upravljanje mu ne dovoli spreminjati Card tafa."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një menaxher shton dhe heq anëtarët e grupit. Menaxhimi nuk e lë të ndryshojë Card-et e një taf."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Voditelj dodaje članove grupe i uklanja ih. Voditeljstvo mu ne dopušta menjati Cardove tafa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้จัดการเพิ่มและนำสมาชิกของกลุ่มออก การเป็นผู้จัดการไม่ได้ทำให้เปลี่ยน Card ของ taf ได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolandyryjy toparyň agzalaryny goşýar we aýyrýar. Dolandyrmak olara taf-yň Card-laryny üýtgetmäge rugsat bermeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yönetici grubun üyelerini ekler ve çıkarır. Yönetmek, bir taf'ın Card'larını değiştirmesine izin vermez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مینیجر گروپ کے ارکان کو شامل اور ہٹاتا ہے۔ منظم کرنے سے انہیں کسی taf کے Cards بدلنے کا اختیار نہیں ملتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý thêm và gỡ thành viên của nhóm. Việc quản lý không cho phép họ thay đổi Card của một taf."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理員可新增和移除群組成員。管理員身分不代表可以變更 taf 的 Card。"
          }
        }
      }
    },
