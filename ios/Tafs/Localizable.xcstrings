    "connect.taf_not_tafs_cloud_apps": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu taf hələ tafs cloud-da deyil, ona görə onun üçün tətbiq qoşula bilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този taf още не е в tafs cloud, така че не могат да му се свързват приложения."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento taf ještě není v tafs cloud, takže pro něj nelze připojit aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser taf ist noch nicht auf tafs cloud, daher können keine Apps für ihn verbunden werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This taf isn't on tafs cloud yet, so apps can't be connected for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este taf aún no está en tafs cloud, así que no se le pueden conectar apps."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See taf pole veel tafs cloudis, seega ei saa sellele rakendusi ühendada."
