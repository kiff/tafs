    "approval.first_taf": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-ın qurulması təsdiqlər tələb edir: Coach sizdən onun alətlərini və taf-ın Card-ını təsdiq etməyi xahiş edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройването на taf изисква одобрения: Coach ви моли да одобрите инструментите му и Card на taf."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení tafu potřebuje schvalování: Coach vás požádá o schválení svých nástrojů a Card tafu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen taf einzurichten braucht Genehmigungen: Coach bittet dich, seine Tools und die Card des tafs zu genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting up a taf needs approvals: Coach asks you to approve its tools and the taf's Card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurar un taf requiere aprobaciones: Coach te pide que apruebes sus apps y la Card del taf."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafi seadistamine vajab kinnitusi: Coach palub sul kinnitada selle tööriistad ja tafi Cardi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurer un taf nécessite des approbations : Coach vous demande d'approuver ses outils et la Card du taf."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavljanje tafa traži odobrenja: Coach traži da odobrite njegove alate i Card tafa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy taf beállításához jóváhagyások kellenek: a Coach megkér, hogy hagyd jóvá az eszközeit és a taf Cardját."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-ի կարգավորումը պահանջում է հաստատումներ․ Coach-ը խնդրում է ձեզ հաստատել իր գործիքները և taf-ի Card-ը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyiapkan taf memerlukan persetujuan: Coach meminta Anda menyetujui alatnya dan Card taf tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurare un taf richiede approvazioni: Coach ti chiede di approvare i suoi strumenti e la Card del taf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafの設定には承認が必要です。Coachが、ツールとtafのCardの承認を求めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "taf-ის დაყენებას დამტკიცებები სჭირდება: Coach გთხოვთ, დაამტკიცოთ მისი ინსტრუმენტები და taf-ის Card."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf를 설정하려면 승인이 필요합니다. Coach가 도구와 taf의 Card를 승인해 달라고 요청합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nustatant taf reikia patvirtinimų: Coach paprašys patvirtinti jo įrankius ir taf Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "taf iestatīšanai vajag apstiprinājumus: Coach lūgs tev apstiprināt tā rīkus un taf Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een taf instellen vraagt om goedkeuringen: Coach vraagt je zijn tools en de Card van het taf goed te keuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja tafa wymaga zatwierdzeń: Coach poprosi Cię o zatwierdzenie swoich narzędzi i Card tafa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurar um taf requer aprovações: o Coach pede-lhe para aprovar as suas ferramentas e o Card do taf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurar um taf requer aprovações: o Coach pede que você aprove as ferramentas dele e o Card do taf."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurarea unui taf are nevoie de aprobări: Coach vă cere să-i aprobați instrumentele și Cardul tafului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavenie tafu potrebuje schvaľovanie: Coach vás požiada o schválenie svojich nástrojov a Card tafu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavitev tafa potrebuje odobritve: Coach vas prosi, da odobrite njegova orodja in Card tafa."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurimi i një taf kërkon miratime: Coach ju kërkon të miratoni mjetet e tij dhe Card-in e taf-it."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Podešavanje tafa traži odobravanja: Coach traži da odobrite njegove alate i Card tafa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า taf ต้องมีการอนุมัติ: Coach จะขอให้คุณอนุมัติเครื่องมือของมันและ Card ของ taf"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir taf kurmak onay gerektirir: Coach, araçlarını ve taf'ın Card'ını onaylamanızı ister."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết lập một taf cần phê duyệt: Coach nhờ bạn phê duyệt các công cụ của nó và Card của taf."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 taf 需要核准：Coach 會請您核准它的工具以及該 taf 的 Card。"
          }
        }
      }
    },
    "approval.has_no_face_id_touch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda (%1$@) Face ID və ya Touch ID yoxdur, ona görə təsdiq edə bilmir. Hesabınıza daxil olmuş başqa iPhone, iPad və ya Android telefonda təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този %1$@ няма Face ID или Touch ID, така че не може да одобрява. Одобрявайте на друг iPhone, iPad или телефон с Android, влязъл в акаунта ви."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento %1$@ nemá Face ID ani Touch ID, takže nemůže schvalovat. Schvalte na jiném iPhonu, iPadu nebo telefonu s Androidem přihlášeném k vašemu účtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses %1$@ hat weder Face ID noch Touch ID und kann daher nicht genehmigen. Genehmige auf einem anderen iPhone, iPad oder Android-Telefon, das bei deinem Konto angemeldet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ has no Face ID or Touch ID, so it can't approve. Approve on another iPhone, iPad or Android phone signed in to your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ no tiene Face ID ni Touch ID, así que no puede aprobar. Aprueba en otro iPhone, iPad o teléfono Android con la sesión iniciada en tu cuenta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selles seadmes (%1$@) pole Face ID-d ega Touch ID-d, seega ei saa see kinnitada. Kinnita mõnes teises iPhone'is, iPadis või Android-telefonis, mis on sinu kontole sisse logitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ n'a ni Face ID ni Touch ID : il ne peut pas approuver. Approuvez sur un autre iPhone, iPad ou téléphone Android connecté à votre compte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj %1$@ nema Face ID ni Touch ID pa ne može odobravati. Odobrite na drugom iPhoneu, iPadu ili Android telefonu prijavljenom na vaš račun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen az eszközön (%1$@) nincs Face ID vagy Touch ID, ezért nem tud jóváhagyni. Hagyd jóvá egy másik, a fiókodba bejelentkezett iPhone-on, iPaden vagy Android-telefonon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքը (%1$@) չունի Face ID կամ Touch ID, ուստի չի կարող հաստատել։ Հաստատեք ձեր հաշվում մուտք գործած մեկ այլ iPhone-ում, iPad-ում կամ Android հեռախոսում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ini tidak memiliki Face ID atau Touch ID, jadi tidak dapat menyetujui. Setujui di iPhone, iPad, atau ponsel Android lain yang masuk ke akun Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo %1$@ non ha Face ID né Touch ID, quindi non può approvare. Approva su un altro iPhone, iPad o telefono Android connesso al tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%1$@にはFace IDもTouch IDもないため、承認できません。アカウントにサインインしている別のiPhone、iPad、またはAndroidスマートフォンで承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ მოწყობილობას (%1$@) არ აქვს Face ID ან Touch ID, ამიტომ დამტკიცება არ შეუძლია. დაამტკიცეთ სხვა iPhone-ზე, iPad-ზე ან Android ტელეფონზე, რომელიც თქვენს ანგარიშშია შესული."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %1$@에는 Face ID나 Touch ID가 없어 승인할 수 없습니다. 내 계정으로 로그인한 다른 iPhone, iPad 또는 Android 휴대폰에서 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis įrenginys (%1$@) neturi Face ID ar Touch ID, todėl negali tvirtinti. Tvirtinkite kitame iPhone, iPad ar Android telefone, prisijungusiame prie jūsų paskyros."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šajā ierīcē (%1$@) nav Face ID vai Touch ID, tāpēc tā nevar apstiprināt. Apstiprini citā iPhone, iPad vai Android tālrunī, kurā esi pierakstījies savā kontā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %1$@ heeft geen Face ID of Touch ID en kan dus niet goedkeuren. Keur goed op een andere iPhone, iPad of Android-telefoon die met je account is ingelogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten %1$@ nie ma Face ID ani Touch ID, więc nie może zatwierdzać. Zatwierdź na innym iPhonie, iPadzie lub telefonie z Androidem zalogowanym na Twoje konto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ não tem Face ID nem Touch ID, por isso não pode aprovar. Aprove noutro iPhone, iPad ou telefone Android com sessão iniciada na sua conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ não tem Face ID nem Touch ID, por isso não pode aprovar. Aprove em outro iPhone, iPad ou telefone Android conectado à sua conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv (%1$@) nu are Face ID sau Touch ID, așa că nu poate aproba. Aprobați pe alt iPhone, iPad sau telefon Android conectat la contul dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento %1$@ nemá Face ID ani Touch ID, takže nemôže schvaľovať. Schváľte na inom iPhone, iPade alebo telefóne s Androidom prihlásenom k vášmu účtu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta %1$@ nima Face ID ali Touch ID, zato ne more odobravati. Odobrite na drugem iPhonu, iPadu ali telefonu Android, prijavljenem v vaš račun."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo pajisje (%1$@) nuk ka Face ID ose Touch ID, ndaj nuk mund të miratojë. Miratoni në një iPhone, iPad ose telefon Android tjetër të hyrë në llogarinë tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj (%1$@) nema Face ID ni Touch ID, pa ne može da odobrava. Odobrite na drugom iPhone-u, iPad-u ili Android telefonu prijavljenom na vaš nalog."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@เครื่องนี้ไม่มี Face ID หรือ Touch ID จึงอนุมัติไม่ได้ ให้อนุมัติบน iPhone, iPad หรือโทรศัพท์ Android เครื่องอื่นที่เข้าสู่ระบบบัญชีของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ cihazında Face ID veya Touch ID yok, bu yüzden onay veremez. Hesabınızda oturum açık olan başka bir iPhone, iPad veya Android telefondan onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ này không có Face ID hay Touch ID nên không thể phê duyệt. Hãy phê duyệt trên iPhone, iPad hoặc điện thoại Android khác đã đăng nhập vào tài khoản của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
