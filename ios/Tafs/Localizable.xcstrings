        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창구는 누가 썼는지 증명할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šios durys negali įrodyti, kas tai parašė."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šīs durvis nevar pierādīt, kas to uzrakstīja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze deur kan niet bewijzen wie het heeft geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te drzwi nie mogą potwierdzić, kto to napisał."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta porta não consegue provar quem o escreveu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta porta não consegue provar quem o escreveu."
          }
        }
