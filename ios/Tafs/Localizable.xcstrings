    "door.replies_only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten gehen nur an den, der geschrieben hat. Alles andere, was der taf tut, läuft weiterhin über KIFF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies go only to who wrote. Anything else the taf does still goes through KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas van solo a quien escribió. Todo lo demás que hace el taf sigue pasando por KIFF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses ne vont qu'à la personne qui a écrit. Tout ce que fait le taf par ailleurs passe toujours par KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte vanno solo a chi ha scritto. Tutto il resto che fa il taf passa comunque da KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden gaan alleen naar wie er schreef. Al het andere dat het taf doet, gaat nog steeds via KIFF."
          }
        },
        "pl": {
