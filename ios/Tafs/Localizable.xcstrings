        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ მოგვიანებით სხვა თითის ანაბეჭდს დაამატებთ, ამ ტელეფონზე დამტკიცება შეწყდება, სანამ ხელახლა არ დაამტკიცებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រសិនបើអ្នកបន្ថែមស្នាមម្រាមដៃមួយទៀតពេលក្រោយ ការអនុម័តនៅលើទូរសព្ទនេះឈប់ រហូតដល់អ្នកអនុម័តវាម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 지문을 더 추가하면, 이 휴대폰을 다시 승인할 때까지 이 휴대폰에서는 승인할 수 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຖ້າທ່ານເພີ່ມລາຍນິ້ວມືອື່ນພາຍຫຼັງ ການອະນຸມັດໃນໂທລະສັບນີ້ຢຸດຈົນກວ່າທ່ານຈະອະນຸມັດມັນອີກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei vėliau pridėsite dar vieną piršto atspaudą, tvirtinti šiame telefone nebus galima, kol jo dar kartą nepatvirtinsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja vēlāk pievienosi vēl kādu pirksta nospiedumu, apstiprināšana šajā tālrunī apstāsies, līdz tu to vēlreiz apstiprināsi."
          }
