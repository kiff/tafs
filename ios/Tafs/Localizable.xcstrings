        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv začnite z Pripojených aplikácií na tomto zariadení (%1$@)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej začnite iz Povezanih aplikacij na tej napravi (%1$@)."
