    "chrome.expired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الرمز فلم يتم إقران شيء. ابدأ من جديد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodun vaxtı bitdi, ona görə heç nə cütləşmədi. Yenidən başlayın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодът изтече, така че нищо не беше сдвоено. Започнете отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোডের মেয়াদ শেষ হয়েছে, তাই কিছু জোড়া লাগেনি। আবার শুরু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El codi ha caducat, així que no s'ha aparellat res. Torna a començar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnost kódu vypršela, takže se nic nespárovalo. Začněte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code ist abgelaufen, also wurde nichts gekoppelt. Fang noch einmal an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code expired, so nothing was paired. Start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código caducó, así que no se vinculó nada. Empieza de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kood aegus, seega midagi ei seotud. Alusta uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code a expiré, rien n'a donc été associé. Recommencez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף הקוד פג, ולכן שום דבר לא הוצמד. יש להתחיל מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड की अवधि खत्म हो गई, इसलिए कुछ जोड़ा नहीं गया। फिर शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôd je istekao pa ništa nije upareno. Počnite ispočetka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kód lejárt, így semmi sem lett párosítva. Kezdd újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կոդի ժամկետը լրացավ, ուստի ոչինչ չզուգակցվեց։ Սկսեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode kedaluwarsa, jadi tidak ada yang dipasangkan. Mulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice è scaduto, quindi non è stato associato nulla. Ricomincia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードの有効期限が切れたため、何もペアリングされませんでした。もう一度やり直してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კოდის ვადა ამოიწურა, ამიტომ არაფერი დაწყვილდა. დაიწყეთ თავიდან."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លេខកូដផុតកំណត់ ដូច្នេះគ្មានអ្វីត្រូវបានផ្គូផ្គងទេ។ សូមចាប់ផ្តើមឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 만료되어 아무것도 페어링되지 않았습니다. 다시 시작하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລະຫັດໝົດອາຍຸ ສະນັ້ນບໍ່ມີຫຍັງຖືກຈັບຄູ່. ເລີ່ມໃໝ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodas nebegalioja, todėl niekas nesusieta. Pradėkite iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda derīgums beidzās, tāpēc nekas netika savienots pārī. Sāc no jauna."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодот истече, па ништо не е спарено. Почни одново."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодын хугацаа дууссан тул юу ч хослуулаагүй. Дахин эхлүүлнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कोडको समय सकियो, त्यसैले केही जोडिएन। फेरि सुरु गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code is verlopen, dus er is niets gekoppeld. Begin opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod wygasł, więc nic nie zostało powiązane. Zacznij od nowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O código expirou, por isso nada foi associado. Comece de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código expirou, por isso nada foi associado. Comece de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codul a expirat, așa că nu s-a asociat nimic. Începeți din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnosť kódu vypršala, takže sa nič nespárovalo. Začnite znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda je potekla, zato ni bilo nič seznanjeno. Začnite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodi skadoi, ndaj asgjë nuk u çiftua. Filloni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôd je istekao, pa ništa nije upareno. Počnite ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสหมดอายุ จึงยังไม่ได้จับคู่อะไร เริ่มใหม่อีกครั้ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Koduň möhleti gutardy, şonuň üçin hiç zat goşalanmady. Täzeden başlaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodun süresi doldu, bu yüzden hiçbir şey eşleştirilmedi. Baştan başlayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوڈ کی مدت ختم ہو گئی، اس لیے کچھ نہیں جوڑا گیا۔ دوبارہ شروع کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã đã hết hạn nên chưa có gì được ghép đôi. Hãy bắt đầu lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼已過期，因此未配對任何項目。請重新開始。"
          }
        }
      }
    },
