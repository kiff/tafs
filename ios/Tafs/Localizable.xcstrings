    "sample.brief.remind.why": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlar daha yaxşı qiymət istədilər və təklif 9 gün əvvəlkidir."
