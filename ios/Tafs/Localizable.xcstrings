    "sample.log.s5_line": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecikən bağlamalar 07:00-da işləmədi: daşıyıcıya girişi sizi gözləyir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Закъснели пратки“ не се изпълни в 07:00: входът при куриера ви чака."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opožděné zásilky v 07:00 neběžely: přihlášení u dopravce na vás čeká."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Verspätete Pakete“ lief um 07:00 nicht: Die Anmeldung beim Versanddienst braucht dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Late parcels didn't run at 07:00: its carrier sign-in needs you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Paquetes con retraso» no se ejecutó a las 07:00: su inicio de sesión con el transportista te necesita."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilinenud pakid ei käivitunud kell 07:00: selle vedaja sisselogimine vajab sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Colis en retard » ne s'est pas lancé à 07:00 : sa connexion au transporteur a besoin de vous."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasne pošiljke nisu se pokrenule u 07:00: potrebna je prijava kod njihova prijevoznika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Késő csomagok nem futott 07:00-kor: a fuvarozói bejelentkezése rád vár."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ուշացած ծանրոցները 07:00-ին չգործարկվեցին․ նրա փոխադրողի մուտքը ձեր կարիքն ունի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket terlambat tidak berjalan pukul 07:00: login kurirnya menunggu Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Pacchi in ritardo» non è partito alle 07:00: l'accesso al corriere ha bisogno di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配送遅延は07:00に実行されませんでした：配送業者のサインインにあなたの確認が必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაგვიანებული ამანათები 07:00-ზე არ გაეშვა: მისი გადამზიდავის შესვლა თქვენ გჭირდებათ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배송 지연이 07:00에 실행되지 않았습니다. 택배사 로그인에 내 확인이 필요합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vėluojantys siuntiniai nebuvo paleisti 07:00: jo prisijungimas prie vežėjo laukia jūsų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kavētās pakas netika palaistas 07:00: pārvadātāja pierakstīšanās gaida tevi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Vertraagde pakketten’ draaide om 07:00 niet: de aanmelding bij de vervoerder heeft jou nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Spóźnione paczki” nie uruchomił się o 07:00: logowanie u przewoźnika czeka na Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«Encomendas atrasadas» não correu às 07:00: o início de sessão na transportadora precisa de si."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Encomendas atrasadas» não rodou às 07:00: o login na transportadora precisa de você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Colete întârziate nu a rulat la 07:00: conectarea la curier vă așteaptă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Oneskorené zásielky o 07:00 nebežali: prihlásenie u prepravcu na vás čaká."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamujene pošiljke se ob 07:00 niso zagnale: prijava pri prevozniku čaka na vas."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pako të vonuara nuk u ekzekutua në 07:00: hyrja e transportuesit të tij ka nevojë për ju."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasne pošiljke nisu se pokrenule u 07:00: potrebna je prijava kod njihova prevoznika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พัสดุล่าช้าไม่ได้ทำงานเวลา 07:00: ต้องให้คุณเข้าสู่ระบบผู้ขนส่งของมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geciken paketler 07:00'de çalışmadı: taşıyıcı oturumu sizi bekliyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bưu kiện trễ không chạy lúc 07:00: cần bạn đăng nhập hãng vận chuyển của nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "延誤包裹在 07:00 沒有執行：它的貨運公司登入需要您處理。"
          }
        }
      }
    },
