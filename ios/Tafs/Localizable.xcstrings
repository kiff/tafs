    "watch.trust": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu saatda parol və ya açar yoxdur və o, heç nəyi təsdiq etmir: sizin «bəli»-nizi gözləyən hər şey telefonunuzu gözləyir. Taf-larınız yalnız Card-larının icazə verdiyini edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този часовник не съхранява парола или ключ и не одобрява нищо: това, което чака вашето „да“, чака телефона ви. Вашите tafs правят само това, което Cards им позволяват."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto hodinky neuchovávají žádné heslo ani klíč a nic neschvalují: co potřebuje vaše ano, čeká na telefon. Vaše tafy dělají jen to, co dovolují jejich Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Uhr speichert kein Passwort und keinen Schlüssel und genehmigt nichts: Was dein Ja braucht, wartet auf dein Handy. Deine tafs tun nur, was ihre Cards erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This watch holds no password or key, and approves nothing: what needs your yes waits for your phone. Your tafs only do what their Cards allow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este reloj no guarda contraseñas ni claves y no aprueba nada: lo que necesita tu sí espera a tu teléfono. Tus tafs solo hacen lo que permiten sus Cards."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See kell ei hoia ühtegi parooli ega võtit ega kinnita midagi: see, mis vajab sinu jah-vastust, ootab telefonis. Sinu tafid teevad ainult seda, mida nende Cardid lubavad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette montre ne garde ni mot de passe ni clé, et n'approuve rien : ce qui demande votre accord attend votre téléphone. Vos tafs ne font que ce que leurs Cards permettent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj sat ne drži nikakvu lozinku ni ključ i ništa ne odobrava: ono što treba vaše da čeka na vašem telefonu. Vaši tafovi rade samo ono što njihovi Cardovi dopuštaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az óra nem tárol jelszót vagy kulcsot, és semmit sem hagy jóvá: ami az igenedre vár, az a telefonodra vár. A tafjaid csak azt teszik, amit a Cardjaik engednek."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ժամացույցը գաղտնաբառ կամ բանալի չի պահում և ոչինչ չի հաստատում․ այն, ինչ ձեր համաձայնությունն է պահանջում, սպասում է ձեր հեռախոսին։ Ձեր taf-երը անում են միայն այն, ինչ թույլատրում են իրենց Card-երը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tangan ini tidak menyimpan kata sandi atau kunci apa pun, dan tidak menyetujui apa pun: yang memerlukan persetujuan Anda menunggu ponsel Anda. tafs Anda hanya melakukan apa yang diizinkan Card-nya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo orologio non conserva password né chiavi e non approva nulla: ciò che richiede il tuo sì aspetta il telefono. I tuoi tafs fanno solo ciò che le loro Card consentono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウォッチはパスワードやキーを保持せず、何も承認しません。あなたの承認が必要なものはスマートフォンで待ちます。tafsはCardが許可することだけを行います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ საათს არც პაროლი აქვს, არც გასაღები და არაფერს ამტკიცებს: რაც თქვენს თანხმობას საჭიროებს, თქვენს ტელეფონს ელოდება. თქვენი taf-ები მხოლოდ იმას აკეთებენ, რასაც მათი Card-ები უშვებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 워치는 비밀번호나 키를 보관하지 않으며 아무것도 승인하지 않습니다. 내 승인이 필요한 일은 휴대폰에서 기다립니다. taf는 Card가 허용하는 일만 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis laikrodis nesaugo jokio slaptažodžio ar rakto ir nieko netvirtina: tai, kam reikia jūsų sutikimo, laukia telefone. Jūsų taf daro tik tai, ką leidžia jų Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis pulkstenis neglabā paroli vai atslēgu un neko neapstiprina: tas, kam vajag tavu “jā”, gaida tavu tālruni. Tavi taf dara tikai to, ko atļauj to Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit horloge bewaart geen wachtwoord of sleutel en keurt niets goed: wat jouw ja nodig heeft, wacht op je telefoon. Je tafs doen alleen wat hun Cards toestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten zegarek nie przechowuje haseł ani kluczy i niczego nie zatwierdza: to, co wymaga Twojej zgody, czeka na telefon. Twoje tafs robią tylko to, na co pozwalają ich Cards."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relógio não guarda palavras-passe nem chaves e não aprova nada: o que precisa do seu sim espera pelo telemóvel. Os seus tafs só fazem o que os seus Cards permitem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relógio não guarda senhas nem chaves e não aprova nada: o que precisa do seu sim espera pelo celular. Os seus tafs só fazem o que os seus Cards permitem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest ceas nu păstrează nicio parolă sau cheie și nu aprobă nimic: ce are nevoie de acordul dvs. așteaptă telefonul. Tafurile dvs. fac doar ce le permit Cardurile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto hodinky neuchovávajú žiadne heslo ani kľúč a nič neschvaľujú: čo potrebuje vaše áno, čaká na telefón. Vaše tafy robia len to, čo dovoľujú ich Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta ura ne hrani gesla ali ključa in ničesar ne odobri: kar potrebuje vaš da, čaka na telefon. Vaši tafi naredijo samo to, kar dovolijo njihove Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo orë nuk mban fjalëkalim ose çelës, dhe nuk miraton asgjë: ajo që ka nevojë për pëlqimin tuaj pret telefonin tuaj. Tafs-et tuaj bëjnë vetëm atë që lejojnë Card-et e tyre."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj sat ne drži nikakvu lozinku ni ključ i ništa ne odobrava: ono šta treba vaše da čeka na vašem telefonu. Vaši tafovi rade samo ono šta njihovi Cardovi dopuštaju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาเรือนนี้ไม่เก็บรหัสผ่านหรือกุญแจ และไม่อนุมัติอะไร: สิ่งที่ต้องการการตอบตกลงของคุณจะรอที่โทรศัพท์ของคุณ taf ของคุณทำเฉพาะสิ่งที่ Card ของมันอนุญาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu saat hiçbir parola veya anahtar tutmaz ve hiçbir şeyi onaylamaz: onayınızı gerektiren her şey telefonunuzu bekler. Tafs'larınız yalnızca Card'larının izin verdiğini yapar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng hồ này không giữ mật khẩu hay khóa nào, và không phê duyệt gì: những việc cần bạn đồng ý sẽ chờ ở điện thoại của bạn. Các taf của bạn chỉ làm những gì Card của chúng cho phép."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手錶不保存任何密碼或金鑰，也不核准任何事：需要您同意的事項會等您的手機處理。您的 taf 只會做它們的 Card 允許的事。"
          }
        }
      }
    },
