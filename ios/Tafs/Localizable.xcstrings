            "state": "translated",
            "value": "eindigt %1$@ als hij niet wordt gebruikt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "kończy się %1$@, jeśli nieużywana"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "termina a %1$@ se não for usada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "termina a %1$@ se não for usada"
          }
        },
        "ro": {
