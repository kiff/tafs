    "alert.kiff_did_not_take_refusal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hat die Ablehnung nicht angenommen. Öffne tafs, um zu antworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF didn't take the refusal. Open tafs to answer it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no aceptó el rechazo. Abre tafs para responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas pris en compte le refus. Ouvrez tafs pour y répondre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non ha accettato il rifiuto. Apri tafs per rispondere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF heeft de weigering niet aangenomen. Open tafs om te antwoorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie przyjął odrzucenia. Otwórz tafs, aby odpowiedzieć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não aceitou a recusa. Abra o tafs para responder."
          }
        }
      }
    },
