            "state": "translated",
            "value": "Jos veiksmai šiam taf nustos veikti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tās darbības šim taf pārstāj darboties."
          }
        },
        "nl": {
