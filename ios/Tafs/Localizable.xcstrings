    "approval.locked_after_too_many_tries": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ çox cəhddən sonra kilidləndi. Bu cihazı (%2$@) kilidləyin, parolla kilidini açın, sonra yenidən yoxlayın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ е заключено след твърде много опити. Заключете този %2$@, отключете го с кода за достъп и проверете отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je po příliš mnoha pokusech zamčené. Zamkněte tento %2$@, odemkněte ho kódem a zkontrolujte to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist nach zu vielen Versuchen gesperrt. Sperre dieses %2$@, entsperre es mit seinem Code und prüfe dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is locked after too many tries. Lock this %2$@, unlock it with its passcode, then check again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está bloqueado tras demasiados intentos. Bloquea este %2$@, desbloquéalo con su código y vuelve a comprobarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liiga palju katseid, seega on lukus: %1$@. Lukusta see %2$@, ava see pääsukoodiga ja kontrolli siis uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est verrouillé après trop de tentatives. Verrouillez %3$@, déverrouillez-le avec son code, puis vérifiez à nouveau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaključano zbog previše pokušaja: %1$@. Zaključajte ovaj uređaj (%2$@), otključajte ga šifrom, pa provjerite ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok próbálkozás után zárolva: %1$@. Zárold le ezt az eszközt (%2$@), oldd fel a jelkódjával, majd ellenőrizd újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը կողպվեց չափազանց շատ փորձերից հետո։ Կողպեք այս սարքը (%2$@), ապակողպեք իր կոդով, ապա նորից ստուգեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ terkunci setelah terlalu banyak percobaan. Kunci %2$@ ini, buka dengan kode sandinya, lalu periksa lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è bloccato dopo troppi tentativi. Blocca questo %2$@, sbloccalo con il codice, poi controlla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試行回数が多すぎるため、%1$@がロックされています。この%2$@をロックし、パスコードでロックを解除してから、もう一度確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ჩაიკეტა ზედმეტი მცდელობის შემდეგ. ჩაკეტეთ ეს მოწყობილობა (%2$@), განბლოკეთ მისი პაროლით, შემდეგ შეამოწმეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시도 횟수가 너무 많아 %1$@이(가) 잠겼습니다. 이 %2$@을(를) 잠근 뒤 암호로 잠금을 해제하고 다시 확인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Po per daug bandymų užrakinta: %1$@. Užrakinkite šį įrenginį (%2$@), atrakinkite jį prieigos kodu ir patikrinkite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ir bloķēts pēc pārāk daudziem mēģinājumiem. Bloķē šo ierīci (%2$@), atbloķē to ar piekļuves kodu, tad pārbaudi vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is vergrendeld na te veel pogingen. Vergrendel deze %2$@, ontgrendel hem met de toegangscode en controleer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest zablokowane po zbyt wielu próbach. Zablokuj ten %2$@, odblokuj go kodem, a potem sprawdź ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está bloqueado após demasiadas tentativas. Bloqueie este %2$@, desbloqueie-o com o código e verifique novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está bloqueado após muitas tentativas. Bloqueie este %2$@, desbloqueie-o com o código e verifique novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ este blocat după prea multe încercări. Blocați acest dispozitiv (%2$@), deblocați-l cu codul de acces, apoi verificați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je po príliš mnohých pokusoch zamknuté. Zamknite tento %2$@, odomknite ho kódom a skontrolujte to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je po preveč poskusih zaklenjeno. Zaklenite ta %2$@, ga odklenite z geslom in preverite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ është kyçur pas shumë përpjekjesh. Kyçeni këtë pajisje (%2$@), zhbllokojeni me kodin e saj, pastaj kontrolloni sërish."
