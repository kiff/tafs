        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Čia rodomi su jumis bendrinami taf."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šeit parādās ar tevi kopīgotie taf."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafовите споделени со тебе се прикажуваат тука."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тантай хуваалцсан taf-ууд энд харагдана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंसँग साझा गरिएका taf यहाँ देखिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs die met je zijn gedeeld, verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs udostępnione Tobie pojawią się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tafs partilhados consigo aparecem aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tafs compartilhados com você aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafurile partajate cu dvs. apar aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazia tafy zdieľané s vami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu se prikažejo tafi, ki so deljeni z vami."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs-et e ndarë me ju shfaqen këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje se prikazuju tafovi podeljeni s vama."
