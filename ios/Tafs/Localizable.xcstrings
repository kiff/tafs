        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sətirdəki məbləğ KIFF-in qəbzinə uyğun gəlmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумата на този ред не съвпада с разписката на KIFF."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সারির অঙ্ক KIFF-এর রসিদের সঙ্গে মেলে না।"
          }
        },
        "ca": {
