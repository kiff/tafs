        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni është joaktiv për tafs. Aktivizojeni te Cilësimet e Sistemit › Privatësia dhe Siguria › Mikrofoni (në macOS 12: Preferencat e Sistemit › Siguria dhe Privatësia › Privatësia › Mikrofoni)."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon je isključen za tafs. Uključite ga u Podešavanja sistema › Privatnost i sigurnost › Mikrofon (macOS 12: Podešavanja sistema › Sigurnost i privatnost › Privatnost › Mikrofon)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟนปิดอยู่สำหรับ tafs เปิดได้ที่การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › ไมโครโฟน (บน macOS 12: ค่ากำหนดระบบ › ความปลอดภัยและความเป็นส่วนตัว › ความเป็นส่วนตัว › ไมโครโฟน)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon, tafs için kapalı. Sistem Ayarları › Gizlilik ve Güvenlik › Mikrofon'dan açın (macOS 12'de: Sistem Tercihleri › Güvenlik ve Gizlilik › Gizlilik › Mikrofon)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrô đang tắt đối với tafs. Hãy bật trong Cài đặt Hệ thống › Quyền riêng tư & Bảo mật › Micrô (trên macOS 12: Tùy chọn Hệ thống › Bảo mật & Quyền riêng tư › Quyền riêng tư › Micrô)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風已對 tafs 關閉。請在「系統設定」›「隱私權與安全性」›「麥克風」中開啟（macOS 12：「系統偏好設定」›「安全性與隱私權」›「隱私權」›「麥克風」）。"
          }
        }
      }
    },
    "voice.no_microphone": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səsli yazmaq üçün tafs-a mikrofondan istifadə icazəsi verin. Səsiniz bu telefonda mətnə çevrilir və heç yerə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешете на tafs да използва микрофона за диктовка. Гласът ви става текст на този телефон и не се изпраща никъде."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte tafs používat mikrofon k diktování. Váš hlas se v tomto telefonu změní na text a nikam se neodesílá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube tafs, das Mikrofon zum Diktieren zu nutzen. Deine Stimme wird auf diesem Telefon zu Text und nirgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow tafs to use the microphone to dictate. Your voice becomes text on this phone and isn't sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que tafs use el micrófono para dictar. Tu voz se convierte en texto en este teléfono y no se envía a ningún sitio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimiseks luba tafsil mikrofoni kasutada. Sinu hääl muutub selles telefonis tekstiks ja seda ei saadeta kuhugi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez tafs à utiliser le micro pour dicter. Votre voix devient du texte sur ce téléphone et n'est envoyée nulle part."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite tafsu upotrebu mikrofona za diktiranje. Vaš glas postaje tekst na ovom telefonu i ne šalje se nikamo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a tafsnak a mikrofon használatát a diktáláshoz. A hangod ezen a telefonon lesz szöveg, és sehová sem kerül el."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թույլ տվեք tafs-ին օգտագործել խոսափողը թելադրելու համար։ Ձեր ձայնը վերածվում է տեքստի այս հեռախոսում և ոչ մի տեղ չի ուղարկվում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan tafs memakai mikrofon untuk dikte. Suara Anda menjadi teks di ponsel ini dan tidak dikirim ke mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a tafs di usare il microfono per dettare. La tua voce diventa testo su questo telefono e non viene inviata da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力するには、tafsにマイクの使用を許可してください。声はこのスマートフォン上でテキストになり、どこにも送信されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიეცით tafs-ს მიკროფონის გამოყენების უფლება კარნახისთვის. თქვენი ხმა ტექსტად იქცევა ამ ტელეფონზე და არსად იგზავნება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기를 하려면 tafs의 마이크 사용을 허용하세요. 음성은 이 휴대폰에서 텍스트로 바뀌며 어디에도 보내지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiskite tafs naudoti mikrofoną diktavimui. Jūsų balsas paverčiamas tekstu šiame telefone ir niekur nesiunčiamas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atļauj lietotnei tafs izmantot mikrofonu, lai diktētu. Tava balss šajā tālrunī kļūst par tekstu un netiek nekur sūtīta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta tafs toe de microfoon te gebruiken om te dicteren. Je stem wordt op deze telefoon tekst en wordt nergens heen gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól tafs używać mikrofonu do dyktowania. Twój głos zamienia się w tekst na tym telefonie i nie jest nigdzie wysyłany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o tafs use o microfone para ditar. A sua voz torna-se texto neste telefone e não é enviada para lado nenhum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o tafs use o microfone para ditar. A sua voz torna-se texto neste telefone e não é enviada para lado nenhum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți-i lui tafs să folosească microfonul pentru dictare. Vocea dvs. devine text pe acest telefon și nu este trimisă nicăieri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte tafs používať mikrofón na diktovanie. Váš hlas sa v tomto telefóne zmení na text a nikam sa neposiela."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite tafs, da za narekovanje uporablja mikrofon. Vaš glas postane besedilo v tem telefonu in se nikamor ne pošlje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejoni tafs të përdorë mikrofonin për të diktuar. Zëri juaj kthehet në tekst në këtë telefon dhe nuk dërgohet askund."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite tafsu upotrebu mikrofona za diktiranje. Vaš glas postaje tekst na ovom telefonu i ne šalje se nikamo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ tafs ใช้ไมโครโฟนเพื่อบอกให้เขียน เสียงของคุณจะกลายเป็นข้อความบนโทรศัพท์เครื่องนี้และไม่ถูกส่งไปที่ไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte için tafs'ın mikrofonu kullanmasına izin verin. Sesiniz bu telefonda metne dönüşür ve hiçbir yere gönderilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép tafs dùng micrô để đọc chính tả. Giọng nói của bạn được chuyển thành văn bản trên điện thoại này và không được gửi đi đâu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 tafs 使用麥克風以進行聽寫。您的語音會在這部手機上轉成文字，不會傳送到任何地方。"
          }
        }
      }
    },
    "voice.not_on_device": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon nitqi telefonun özündə tanıya bilmir, ona görə mikrofon burada işləmir: səsiniz onu tərk etməli olardı. Əvəzində yaza bilərsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този телефон не може да разпознава реч на самия телефон, така че микрофонът не работи тук: гласът ви би трябвало да го напусне. Можете да пишете вместо това."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento telefon neumí rozpoznat řeč přímo v telefonu, takže mikrofon tu nefunguje: váš hlas by ho musel opustit. Můžete psát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon kann Sprache nicht direkt auf dem Gerät erkennen, daher funktioniert das Mikrofon hier nicht: Deine Stimme müsste es verlassen. Du kannst stattdessen tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can't recognise speech on the phone itself, so the mic doesn't work here: your voice would have to leave it. You can type instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no puede reconocer la voz en el propio teléfono, así que el micrófono no funciona aquí: tu voz tendría que salir de él. Puedes escribir en su lugar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See telefon ei tunne kõnet telefonis endas ära, seega mikrofon siin ei tööta: sinu hääl peaks sealt lahkuma. Võid hoopis kirjutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone ne peut pas reconnaître la parole sur l'appareil même : le micro ne fonctionne donc pas ici, car votre voix devrait le quitter. Vous pouvez écrire à la place."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon ne može prepoznavati govor na samom telefonu pa mikrofon ovdje ne radi: vaš bi glas morao otići s njega. Umjesto toga možete tipkati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a telefon nem tudja magán a telefonon felismerni a beszédet, ezért a mikrofon itt nem működik: a hangodnak el kellene hagynia. Gépelhetsz helyette."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հեռախոսը չի կարող ճանաչել խոսքը հենց հեռախոսում, ուստի խոսափողն այստեղ չի աշխատում․ ձեր ձայնը պետք է լքեր այն։ Փոխարենը կարող եք մուտքագրել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini tidak dapat mengenali ucapan di ponsel itu sendiri, sehingga mikrofon tidak berfungsi di sini: suara Anda harus keluar dari ponsel. Anda dapat mengetik sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non sa riconoscere il parlato sul telefono stesso, quindi il microfono qui non funziona: la tua voce dovrebbe lasciarlo. Puoi scrivere invece."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンは端末上で音声を認識できないため、ここではマイクが使えません。声が端末の外に出てしまうためです。代わりに入力できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ტელეფონს მეტყველების ამოცნობა თავად ტელეფონზე არ შეუძლია, ამიტომ მიკროფონი აქ არ მუშაობს: თქვენი ხმა მას უნდა დაეტოვებინა. სამაგიეროდ შეგიძლიათ აკრიფოთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰은 기기 자체에서 음성을 인식할 수 없어 여기서는 마이크가 작동하지 않습니다. 음성이 기기 밖으로 나가야 하기 때문입니다. 대신 입력할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis telefonas pats negali atpažinti kalbos, todėl mikrofonas čia neveikia: jūsų balsas turėtų jį palikti. Vietoj to galite rašyti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis tālrunis pats nevar atpazīt runu, tāpēc mikrofons šeit nedarbojas: tavai balsij būtu jāatstāj tālrunis. Tā vietā vari rakstīt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon kan spraak niet op het toestel zelf herkennen, dus de microfoon werkt hier niet: je stem zou het toestel moeten verlaten. Je kunt in plaats daarvan typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon nie potrafi rozpoznawać mowy na samym urządzeniu, więc mikrofon tu nie działa: Twój głos musiałby je opuścić. Możesz zamiast tego pisać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone não consegue reconhecer a fala no próprio telefone, por isso o microfone não funciona aqui: a sua voz teria de sair dele. Pode escrever em vez disso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone não consegue reconhecer a fala no próprio telefone, por isso o microfone não funciona aqui: a sua voz teria de sair dele. Pode escrever em vez disso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest telefon nu poate recunoaște vorbirea pe telefonul însuși, așa că microfonul nu funcționează aici: vocea dvs. ar trebui să-l părăsească. Puteți tasta în schimb."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento telefón nevie rozpoznať reč priamo v telefóne, takže mikrofón tu nefunguje: váš hlas by ho musel opustiť. Môžete písať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta telefon ne more prepoznati govora v samem telefonu, zato mikrofon tu ne deluje: vaš glas bi ga moral zapustiti. Lahko tipkate."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky telefon nuk e njeh të folurit në vetë telefonin, ndaj mikrofoni nuk funksionon këtu: zëri juaj do të duhej ta linte. Mund të shkruani në vend të kësaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon ne može prepoznavati govor na samom telefonu pa mikrofon ovdje ne radi: vaš bi glas morao otići s njega. Umesto toga možete tipkati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์เครื่องนี้จดจำเสียงพูดบนตัวเครื่องเองไม่ได้ ไมค์จึงใช้ที่นี่ไม่ได้: เสียงของคุณจะต้องออกจากเครื่อง คุณพิมพ์แทนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon konuşmayı telefonun kendisinde tanıyamıyor, bu yüzden mikrofon burada çalışmıyor: sesinizin telefondan çıkması gerekirdi. Bunun yerine yazabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại này không thể nhận dạng giọng nói ngay trên điện thoại, nên micrô không hoạt động ở đây: giọng nói của bạn sẽ phải rời khỏi nó. Bạn có thể gõ thay thế."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部手機無法在本機辨識語音，因此這裡無法使用麥克風：您的語音必須離開裝置。您可以改用輸入。"
          }
        }
      }
    },
