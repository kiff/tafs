    "usage.runs_could_not_read_pull": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Läufe konnten nicht gelesen werden. Zum erneuten Versuchen ziehen."
