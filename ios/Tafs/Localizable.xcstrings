    "watch.didnt_catch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم أسمع ذلك. اضغط للمحاولة مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başa düşülmədi. Yenidən cəhd etmək üçün toxunun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не разбрах. Докоснете, за да опитате отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বোঝা যায়নি। আবার চেষ্টা করতে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No t'he entès. Toca per tornar-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerozuměl jsem. Klepnutím to zkusíte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht verstanden. Tippe, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't catch that. Tap to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No lo he entendido. Toca para volver a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei saanud aru. Puuduta, et uuesti proovida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas compris. Touchez pour réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הובן. יש ללחוץ כדי לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समझ नहीं आया। फिर कोशिश करने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisam razumio. Dodirnite da pokušate ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem értettem. Koppints az újrapróbáláshoz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհասկացա։ Հպեք՝ նորից փորձելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak terdengar. Ketuk untuk mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ho capito. Tocca per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞き取れませんでした。タップしてもう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერ გავიგე. შეეხეთ ხელახლა საცდელად."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស្តាប់មិនបាន។ ចុចដើម្បីព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘 듣지 못했습니다. 탭하여 다시 시도하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຟັງບໍ່ທັນ. ແຕະເພື່ອລອງໃໝ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesupratau. Palieskite ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesadzirdēju. Pieskaries, lai mēģinātu vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не разбрав. Допри за да се обидеш повторно."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сонсож авсангүй. Дахин оролдохын тулд товшино уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "बुझिएन। फेरि प्रयास गर्न ट्याप गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet verstaan. Tik om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zrozumieć. Dotknij, aby spróbować ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não percebi. Toque para tentar novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não percebi. Toque para tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am înțeles. Atingeți pentru a reîncerca."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerozumel som. Ťuknutím to skúsite znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisem razumel. Tapnite za nov poskus."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuk e kapa. Prekni për të provuar sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisam razumio. Dodirnite da pokušate ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟังไม่ทัน แตะเพื่อลองอีกครั้ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşitmedim. Täzeden synanyşmak üçin basyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlayamadım. Tekrar denemek için dokunun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سمجھ نہیں آیا۔ دوبارہ کوشش کے لیے ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nghe rõ. Chạm để thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有聽清楚。輕點以再試一次。"
          }
        }
