    "halt_all.halted_all": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تجميد جميع tafs لديك. لا يُرسل شيء جديد حتى تستأنف."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-larınız donduruldu. Siz davam etdirənə qədər heç nə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите tafs са спрени. Нищо ново не се изпраща, докато не възобновите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার taf থামানো হয়েছে। আবার চালু না করা পর্যন্ত নতুন কিছু পাঠানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'han bloquejat els teus taf. No s'envia res de nou fins que ho reprenguis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy jsou zastavené. Nic nového se neodešle, dokud je znovu nespustíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs sind angehalten. Nichts Neues wird gesendet, bis du fortsetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halted your tafs. Nothing new is sent until you resume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tafs están bloqueados. No se envía nada nuevo hasta que reanudes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tafid on peatatud. Midagi uut ei saadeta enne, kui jätkad."
