          "stringUnit": {
            "state": "translated",
            "value": "Կանգնեցումը դադարեցնում է այն, մինչև վերսկսեք։ Արդեն ուղարկված զանգը դեռ կարող է հասնել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembekuan menghentikannya sampai Anda melanjutkan. Panggilan yang sudah terkirim mungkin masih tiba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccare lo ferma finché non riprendi. Una chiamata già inviata può ancora arrivare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮断すると、再開するまで止まります。すでに送信された呼び出しは届く場合があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაჩერება მას აჩერებს, სანამ არ განაახლებთ. უკვე გაგზავნილი ზარი შეიძლება მაინც მივიდეს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការបញ្ឈប់ធ្វើឱ្យវាឈប់ រហូតដល់អ្នកបន្ត។ ការហៅដែលបានផ្ញើរួចហើយ អាចនៅតែមកដល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단하면 재개할 때까지 멈춥니다. 이미 보낸 호출은 도착할 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການຢຸດເຮັດໃຫ້ມັນຢຸດຈົນກວ່າທ່ານຈະສືບຕໍ່. ການໂທທີ່ສົ່ງໄປແລ້ວອາດຍັງມາຮອດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustabdžius jis nedirbs, kol netęsite. Jau išsiųsta užklausa vis tiek gali būti gauta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apturēšana to aptur, līdz tu to turpini. Jau nosūtīts izsaukums var tomēr pienākt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запирањето го стопира додека не продолжиш. Веќе испратено барање може сепак да пристигне."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зогсоовол та үргэлжлүүлэх хүртэл зогсоно. Аль хэдийн илгээсэн дуудлага ирж магадгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रोक्दा यो तपाईंले फेरि सुरु नगरेसम्म रोकिन्छ। पहिल्यै पठाइएको कल अझै आइपुग्न सक्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilzetten stopt het tot je hervat. Een al verzonden aanroep kan nog aankomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokada go zatrzymuje, dopóki go nie wznowisz. Wysłane już wywołanie może jeszcze dotrzeć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear para-o até retomar. Uma chamada já enviada pode ainda chegar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear para-o até retomar. Uma chamada já enviada pode ainda chegar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprirea îl oprește până îl reluați. Un apel deja trimis poate totuși să ajungă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavenie ho drží, kým ho neobnovíte. Volanie, ktoré už odišlo, môže ešte doraziť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustavitev ga zadrži, dokler ga ne nadaljujete. Klic, ki je že odšel, lahko še prispe."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bllokimi e ndalon derisa ta riniseni. Një thirrje e dërguar tashmë mund të arrijë prapë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje ga zaustavlja dok ne nastavite. Već poslan poziv još može stići."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การระงับจะหยุดมันจนกว่าคุณจะทำต่อ การเรียกที่ส่งไปแล้วอาจยังไปถึง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Togtatmak ony siz dowam edýänçäňiz durzýar. Eýýäm iberilen çagyryş entek gelip biler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dondurma, siz devam ettirene kadar onu durdurur. Gönderilmiş bir çağrı yine de ulaşabilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روکنے سے وہ تب تک تھمتا ہے جب تک آپ دوبارہ شروع نہ کریں۔ پہلے سے بھیجی گئی کال پھر بھی پہنچ سکتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng băng dừng nó cho đến khi bạn tiếp tục. Một lệnh gọi đã gửi vẫn có thể đến nơi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "凍結會讓它停止，直到您繼續。已傳送的呼叫可能仍會抵達。"
          }
        }
      }
    },
