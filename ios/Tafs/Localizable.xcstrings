    "usage.runs_could_not_read_pull": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlər oxuna bilmədi. Yenidən cəhd etmək üçün aşağı çəkin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тези изпълнения не можаха да бъдат прочетени. Плъзнете надолу, за да опитате отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto běhy se nepodařilo načíst. Stažením dolů to zkusíte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Läufe konnten nicht gelesen werden. Zum erneuten Versuchen ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These runs couldn't be read. Pull to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer estas ejecuciones. Desliza para volver a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Neid käivitusi ei õnnestunud lugeda. Uuesti proovimiseks tõmba alla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces exécutions n'ont pas pu être lues. Tirez pour réessayer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta izvođenja nije bilo moguće pročitati. Povucite za ponovni pokušaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezeket a futásokat nem sikerült beolvasni. Húzd le az újrapróbáláshoz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գործարկումները չկարողացան կարդացվել։ Քաշեք՝ նորից փորձելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksekusi ini tidak dapat dibaca. Tarik untuk mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere queste esecuzioni. Trascina per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの実行を読み込めませんでした。下に引いて再試行してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს გაშვებები ვერ წაიკითხა. გადაწიეთ ხელახლა საცდელად."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 실행들을 읽지 못했습니다. 아래로 당겨 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko nuskaityti šių paleidimų. Patraukite, kad bandytumėte dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šīs palaišanas nevarēja nolasīt. Pavelc, lai mēģinātu vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze runs konden niet worden gelezen. Trek omlaag om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać tych uruchomień. Pociągnij, aby spróbować ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler estas execuções. Puxe para tentar novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler estas execuções. Puxe para tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste rulări nu au putut fi citite. Trageți în jos pentru a reîncerca."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto behy sa nepodarilo načítať. Potiahnutím nadol to skúsite znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teh zagonov ni bilo mogoče prebrati. Povlecite za nov poskus."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Këto ekzekutime nuk u lexuan dot. Tërhiqni për të provuar sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta izvršavanja nije bilo moguće pročitati. Povucite za ponovni pokušaj."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านการทำงานเหล่านี้ไม่ได้ ดึงเพื่อลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalıştırmalar okunamadı. Tekrar denemek için aşağı çekin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc các lượt chạy này. Kéo để thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取這些執行紀錄。下拉即可重試。"
          }
        }
      }
    },
