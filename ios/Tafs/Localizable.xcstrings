    "coach.name_tool_taf_should_work": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne eine App, mit der ein taf arbeiten soll, etwa deinen Zahlungsanbieter. Du meldest dich auf der eigenen Seite der App an, und deine Anmeldung bleibt versiegelt: Kein taf sieht sie je. Jede Verbindung und jede Card wartet auf %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name an app a taf should work with, like your payment provider. You sign in on the app's own page, and your sign-in is kept sealed: no taf ever sees it. Each connection and each Card waits for %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra una app con la que debería trabajar un taf, como tu proveedor de pagos. Inicias sesión en la propia página de la app, y tu inicio de sesión se guarda sellado: ningún taf lo ve nunca. Cada conexión y cada Card esperan %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez une app avec laquelle un taf doit travailler, comme votre prestataire de paiement. Vous vous connectez sur la page de l'app, et votre connexion reste scellée : aucun taf ne la voit jamais. Chaque connexion et chaque Card attend %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un'app con cui un taf dovrebbe lavorare, come il tuo fornitore di pagamenti. Accedi sulla pagina dell'app, e il tuo accesso resta sigillato: nessun taf lo vede mai. Ogni collegamento e ogni Card aspettano %1$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noem een app waarmee een taf moet werken, zoals je betaalprovider. Je logt in op de eigen pagina van de app, en je login blijft verzegeld: geen enkel taf ziet hem ooit. Elke koppeling en elke Card wacht op %1$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj aplikację, z którą taf ma pracować, np. Twojego dostawcę płatności. Logujesz się na stronie samej aplikacji, a Twoje logowanie pozostaje zapieczętowane: żaden taf go nigdy nie widzi. Każde połączenie i każda Card czekają na %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique uma app com que um taf deva trabalhar, como o seu fornecedor de pagamentos. Inicia sessão na própria página da app, e o seu início de sessão fica selado: nenhum taf o vê. Cada ligação e cada Card aguardam %1$@."
          }
        }
      }
    },
