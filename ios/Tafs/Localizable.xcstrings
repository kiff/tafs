    "connect.cancel_sign_in.body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ heç nə qoşulmayıb. Hazır olanda %1$@ xidmətini Coach-dan və ya «Tətbiqləri qoşun» bölməsindən yenidən qoşun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още нищо не е свързано. Свържете %1$@ отново от Coach или от „Свързване на приложения“, когато сте готови."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím není nic připojeno. %1$@ připojte znovu z Coache nebo z Připojit aplikace, až budete připraveni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch ist nichts verbunden. Verbinde %1$@ erneut über Coach oder „Apps verbinden“, wenn du so weit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is connected yet. Connect %1$@ again from Coach or Connect apps when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada conectado. Vuelve a conectar %1$@ desde Coach o Conectar apps cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi pole veel ühendatud. Ühenda %1$@ uuesti Coachis või vaates Ühenda rakendused, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est encore connecté. Connectez à nouveau %1$@ depuis Coach ou Connecter des apps quand vous êtes prêt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa još nije povezano. Ponovno povežite aplikaciju %1$@ iz Coacha ili Poveži aplikacije kad budete spremni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még semmi sincs csatlakoztatva. Ha készen állsz, csatlakoztasd újra ezt (%1$@) a Coachból vagy az Alkalmazások csatlakoztatása részből."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ ոչինչ միացված չէ։ Միացրեք %1$@-ը նորից Coach-ից կամ «Հավելվածների միացում»-ից, երբ պատրաստ լինեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang terhubung. Hubungkan %1$@ lagi dari Coach atau Hubungkan aplikasi saat Anda siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora collegato nulla. Collega di nuovo %1$@ da Coach o da Collega app quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も接続されていません。準備ができたら、Coachまたはアプリを接続から、もう一度%1$@を接続してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არაფერია დაკავშირებული. დააკავშირეთ %1$@ ხელახლა Coach-იდან ან „აპების დაკავშირებიდან“, როცა მზად იქნებით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 연결된 것은 없습니다. 준비되면 Coach나 앱 연결에서 %1$@을(를) 다시 연결하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas dar neprijungta. Kai būsite pasirengę, vėl prijunkite %1$@ per Coach arba skiltyje „Prijungti programėles“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēl nekas nav pievienots. Kad būsi gatavs, vēlreiz pievieno %1$@ no Coach vai sadaļā “Pievienot lietotnes”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog niets gekoppeld. Koppel %1$@ opnieuw vanuit Coach of Apps koppelen wanneer je zover bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest jeszcze połączone. Połącz %1$@ ponownie z Coacha lub z Połącz aplikacje, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada está ligado. Ligue %1$@ novamente a partir do Coach ou de Ligar apps quando estiver pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada está conectado. Conecte %1$@ novamente a partir do Coach ou de Conectar apps quando estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu este conectat încă. Conectați din nou %1$@ din Coach sau din Conectați aplicații când sunteți gata."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nie je nič pripojené. %1$@ pripojte znova z Coacha alebo z Pripojiť aplikácie, keď budete pripravení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še nič ni povezano. Ko boste pripravljeni, %1$@ znova povežite iz Coacha ali Poveži aplikacije."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende nuk është lidhur asgjë. Lidhni %1$@ sërish nga Coach ose Lidhni aplikacione kur të jeni gati."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa još nije povezano. Ponovo povežite aplikaciju %1$@ iz Coacha ili Poveži aplikacije kad budete spremni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้เชื่อมต่ออะไร เชื่อมต่อ %1$@ อีกครั้งจาก Coach หรือเชื่อมต่อแอปเมื่อคุณพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz hiçbir şey bağlanmadı. Hazır olduğunuzda %1$@ uygulamasını Coach'tan veya Uygulamaları bağla'dan tekrar bağlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì được kết nối. Hãy kết nối lại %1$@ từ Coach hoặc Kết nối ứng dụng khi bạn sẵn sàng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未連接任何項目。準備好時，請從 Coach 或「連接 App」再次連接 %1$@。"
          }
        }
      }
    },
