          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone télécharge le %1$@ pour la dictée. Le micro fonctionnera dès qu'il sera prêt, d'ici une minute ou deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono sta scaricando %1$@ per la dettatura. Il microfono funziona appena è pronto, tra un minuto o due."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon downloadt %1$@ voor dicteren. De microfoon werkt zodra dat klaar is, over een minuut of twee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon pobiera język %1$@ do dyktowania. Mikrofon zadziała, gdy będzie gotowy, za minutę lub dwie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone está a obter %1$@ para o ditado. O microfone funciona quando estiver pronto, dentro de um ou dois minutos."
          }
        }
      }
    },
