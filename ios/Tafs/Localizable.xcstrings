    "alert.answer_nothing_sent_until_you": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Antworte bis %3$@. Nichts wird gesendet, bevor du genehmigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Answer by %3$@. Nothing is sent until you approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Responde antes de %3$@. No se envía nada hasta que apruebes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Vasta hiljemalt %3$@. Midagi ei saadeta enne, kui kinnitad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Répondez avant %3$@. Rien n'est envoyé tant que vous n'approuvez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Rispondi entro le %3$@. Non viene inviato nulla finché non approvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@・%2$@。%3$@までに回答してください。承認するまで何も送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. %3$@까지 응답하세요. 승인할 때까지 아무것도 보내지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Atsakykite iki %3$@. Niekas nesiunčiama, kol nepatvirtinsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Atbildi līdz %3$@. Nekas netiek nosūtīts, kamēr tu neapstiprini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Antwoord vóór %3$@. Er wordt niets verzonden tot je goedkeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Odpowiedz do %3$@. Nic nie zostanie wysłane, dopóki nie zatwierdzisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Responda até %3$@. Nada é enviado até aprovar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Responda até %3$@. Nada é enviado até aprovar."
          }
        }
      }
    },
