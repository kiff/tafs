        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ i wysłane, ale odpowiedź aplikacji zaginęła: sprawdź własne rejestry aplikacji"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
