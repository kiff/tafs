          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Զուգակցեք մեկին"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasangkan seseorang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Associa qualcuno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かを登録"
          }
        },
        "ka": {
