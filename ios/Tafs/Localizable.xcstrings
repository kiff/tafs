            "value": "Nie powiodło się. Nic nie zostało połączone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi concluído. Nada foi ligado."
          }
        },
        "pt-BR": {
          "stringUnit": {
