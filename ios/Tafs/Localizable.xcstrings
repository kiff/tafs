        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A medida que avanza la conversación, aquí aparecen el plan, las apps que se conectan y la Card del taf."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vestluse käigus kuvatakse siin plaan, ühendatavad rakendused ja tafi Card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au fil de la conversation, le plan, les apps en cours de connexion et la Card du taf s'affichent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ככל שהשיחה מתקדמת, התוכנית, האפליקציות שמתחברות וה-Card של ה-taf מוצגים כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत के साथ, प्लान, जोड़े जा रहे ऐप और taf का Card यहाँ दिखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako razgovor teče, ovdje se prikazuju plan, aplikacije koje se povezuju i Card tafa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszélgetés során itt jelenik meg a terv, a csatlakoztatott alkalmazások és a taf Cardja."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Զրույցի ընթացքում այստեղ երևում են պլանը, միացվող հավելվածները և taf-ի Card-ը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiring percakapan berjalan, paket, aplikasi yang sedang dihubungkan, dan Card taf muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Man mano che la conversazione procede, qui compaiono il piano, le app da collegare e la Card del taf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話が進むにつれて、プラン、接続中のアプリ、tafのCardがここに表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საუბრის მიმდინარეობისას აქ ჩანს გეგმა, დასაკავშირებელი აპები და taf-ის Card."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅពេលការសន្ទនាដំណើរការ គម្រោង កម្មវិធីដែលកំពុងភ្ជាប់ និង Card របស់ taf បង្ហាញនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화가 진행되면서 계획, 연결 중인 앱, taf의 Card가 여기에 표시됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເມື່ອການສົນທະນາດຳເນີນໄປ ແຜນ, ແອັບທີ່ກຳລັງເຊື່ອມຕໍ່ ແລະ Card ຂອງ taf ຈະສະແດງຢູ່ທີ່ນີ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokalbiui vykstant, čia rodomas planas, jungiamos programėlės ir taf Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarunas gaitā šeit parādās plāns, pievienojamās lietotnes un taf Card."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Како тече разговорот, тука се прикажуваат планот, апликациите што се поврзуваат и Card на tafот."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Яриа үргэлжлэх тусам төлөвлөгөө, холбож буй аппууд болон taf-ын Card энд харагдана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कुराकानी अघि बढ्दै जाँदा योजना, जडान हुँदै गरेका एप र taf को Card यहाँ देखिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naarmate het gesprek vordert, verschijnen hier het plan, de apps die worden gekoppeld en de Card van het taf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W miarę rozmowy pojawią się tu plan, łączone aplikacje i Card tafa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "À medida que a conversa avança, o plano, as apps a ligar e o Card do taf aparecem aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À medida que a conversa avança, o plano, os apps a conectar e o Card do taf aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe măsură ce conversația avansează, aici apar planul, aplicațiile care se conectează și Cardul tafului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako rozhovor pokračuje, zobrazuje sa tu plán, pripájané aplikácie a Card tafu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med pogovorom se tu prikažejo načrt, aplikacije, ki se povezujejo, in Card tafa."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjatë bisedës, plani, aplikacionet që po lidhen dhe Card-i i taf-it shfaqen këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako razgovor teče, ovde se prikazuju plan, aplikacije koje se povezuju i Card tafa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อการสนทนาดำเนินไป แพ็กเกจ แอปที่กำลังเชื่อมต่อ และ Card ของ taf จะแสดงที่นี่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gürrüň dowam edende, meýilnama, birikdirilýän programmalar we taf-yň Card-y bu ýerde görünýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet ilerledikçe plan, bağlanan uygulamalar ve taf'ın Card'ı burada görünür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بات چیت کے ساتھ، پلان، جوڑی جانے والی ایپس اور taf کا Card یہاں دکھائی دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi cuộc trò chuyện tiến triển, gói, các ứng dụng đang được kết nối và Card của taf hiện ở đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨著對話進行，方案、正在連接的 App 以及 taf 的 Card 會顯示在這裡。"
          }
        }
      }
