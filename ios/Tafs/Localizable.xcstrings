            "value": "Vispirms sāc sadaļā “Pievienotās lietotnes” šajā ierīcē (%1$@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin eerst bij Gekoppelde apps op deze %1$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zacznij od Połączonych aplikacji na tym urządzeniu (%1$@)."
