    "door.api.paused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرفض الطلبات حتى تفتحه. لا يُلغى شيء تم بالفعل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz açana qədər sorğular rədd edilir. Artıq edilmiş heç nə geri qaytarılmır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявките се отказват, докато не я отворите. Вече направеното не се отменя."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি খোলা পর্যন্ত অনুরোধ প্রত্যাখ্যাত হয়। যা ইতিমধ্যে করা হয়েছে তা ফেরানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sol·licituds es rebutgen fins que l'obris. No es desfà res del que ja s'ha fet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádosti se odmítají, dokud je neotevřete. Co už se udělalo, se nevrací."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen werden abgelehnt, bis du sie öffnest. Was schon getan ist, wird nicht rückgängig gemacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests are refused until you open it. Nothing already done is undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes se rechazan hasta que la abras. No se deshace nada de lo ya hecho."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Päringutest keeldutakse, kuni selle avad. Juba tehtut tagasi ei võeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les requêtes sont refusées jusqu'à ce que vous l'ouvriez. Rien de ce qui est déjà fait n'est annulé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקשות נדחות עד שתפתח אותה. שום דבר שכבר בוצע לא מתבטל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खोलने तक अनुरोध अस्वीकार होते हैं। जो पहले हो चुका उसे पलटा नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtjevi se odbijaju dok ih ne otvorite. Ništa što je već učinjeno ne poništava se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kérések elutasításra kerülnek, amíg meg nem nyitod. Ami már megtörtént, nem vonódik vissza."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարցումները մերժվում են, մինչև չբացեք այն։ Արդեն արվածը չի չեղարկվում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan ditolak sampai Anda membukanya. Apa pun yang sudah dilakukan tidak dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste vengono rifiutate finché non la apri. Nulla di ciò che è già stato fatto viene annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開くまでリクエストは拒否されます。すでに完了したものは元に戻りません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოთხოვნები უარყოფილია, სანამ არ გახსნით. არაფერი, რაც უკვე გაკეთდა, არ უქმდება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សំណើត្រូវបានបដិសេធ រហូតដល់អ្នកបើកវា។ អ្វីដែលបានធ្វើរួចមិនត្រូវបានលុបចោលទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열 때까지 요청이 거절됩니다. 이미 한 일은 되돌려지지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຳຂໍຖືກປະຕິເສດຈົນກວ່າທ່ານເປີດມັນ. ສິ່ງທີ່ເຮັດແລ້ວບໍ່ຖືກຍົກເລີກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užklausos atmetamos, kol neatidarysite durų. Kas jau padaryta, neatšaukiama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieprasījumi tiek atteikti, līdz tu tās atver. Jau izdarītais paliek spēkā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барањата се одбиваат додека не ги отвориш. Ништо веќе направено не се враќа."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та нээх хүртэл хүсэлтүүдээс татгалзана. Аль хэдийн хийгдсэн зүйл буцахгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले नखोलेसम्म अनुरोध अस्वीकार गरिन्छन्। पहिल्यै भइसकेको कुरा फिर्ता हुँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzoeken worden geweigerd tot je hem opent. Wat al gedaan is, wordt niet teruggedraaid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądania są odrzucane, dopóki ich nie otworzysz. Nic, co już zrobiono, nie zostaje cofnięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos são recusados até a abrir. Nada do que já foi feito é desfeito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos são recusados até a abrir. Nada do que já foi feito é desfeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitările sunt refuzate până o deschideți. Ce s-a făcut deja nu se anulează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadosti sa odmietajú, kým ich neotvoríte. Čo sa už urobilo, sa nevracia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahteve se zavračajo, dokler jih ne odprete. Kar je že opravljeno, se ne razveljavi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kërkesat refuzohen derisa ta hapni. Asgjë që është bërë tashmë nuk zhbëhet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtevi se odbijaju dok ih ne otvorite. Ništa šta je već učinjeno ne poništava se."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอจะถูกปฏิเสธจนกว่าคุณจะเปิด สิ่งที่ทำไปแล้วจะไม่ถูกยกเลิก"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Haýyşlar siz açýançaňyz ret edilýär. Eýýäm edilen zat yzyna gaýtarylmaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz açana kadar istekler reddedilir. Daha önce yapılan hiçbir şey geri alınmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ اسے نہ کھولیں درخواستیں مسترد ہوتی ہیں۔ جو پہلے ہو چکا وہ واپس نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các yêu cầu bị từ chối cho đến khi bạn mở nó. Những gì đã làm không bị hoàn tác."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您開啟之前，請求會被拒絕。已完成的事項不會被復原。"
          }
        }
      }
    },
