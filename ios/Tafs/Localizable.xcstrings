    "card.line.more_asks": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "; çoxu əvvəlcə sizdən soruşur"
          }
        },
        "bg": {
          "stringUnit": {
