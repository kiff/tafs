        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son muchos mensajes en pocos minutos. Espera un poco y vuelve a enviarlo: no se envió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
