    "chat.failed.after": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat mittendrin aufgehört, nachdem das durchging: %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stopped part-way, after this went through: %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detuvo a medias, después de que se completara esto: %2$@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lõpetas poole pealt, pärast seda, kui see läks läbi: %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s'est arrêté en cours de route, après que ceci a abouti : %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si è fermato a metà, dopo che questa è andata a buon fine: %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は途中で停止しました。次の処理は完了しています：%2$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 도중에 멈췄습니다. 이것은 처리된 뒤였습니다: %2$@."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sustojo pusiaukelėje, kai tai jau buvo atlikta: %2$@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ apstājās pusceļā, kad šis jau bija izpildīts: %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is halverwege gestopt, nadat dit was gelukt: %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: zatrzymało się w połowie, po tym, jak przeszło to: %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou a meio, depois de isto ter sido concluído: %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou a meio, depois de isto ter sido concluído: %2$@."
          }
        }
      }
    },
