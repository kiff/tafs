    "connect.signed_in": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ xidmətinə daxil olundu. Sonra Coach onun əməliyyatlarını seçir, siz isə onları təsdiq edirsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ е влязло. След това Coach избира действията му, а вие ги одобрявате."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je přihlášená. Teď Coach vybere její akce a vy je schválíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist angemeldet. Als Nächstes wählt Coach seine Aktionen, und du genehmigst sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is signed in. Next, Coach chooses its actions and you approve them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tiene la sesión iniciada. Ahora Coach elige sus acciones y tú las apruebas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on sisse logitud. Järgmiseks valib Coach selle toimingud ja sina kinnitad need."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est connecté. Ensuite, Coach choisit ses actions et vous les approuvez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavljeni ste u aplikaciju %1$@. Zatim Coach bira njezine radnje, a vi ih odobravate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bejelentkezve. Ezután a Coach kiválasztja a műveleteit, te pedig jóváhagyod őket."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը մուտք է գործել։ Հաջորդը Coach-ը ընտրում է նրա գործողությունները, և դուք հաստատում եք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sudah masuk. Selanjutnya, Coach memilih tindakannya dan Anda menyetujuinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso a %1$@ effettuato. Ora Coach sceglie le sue azioni e tu le approvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@にサインインしました。次に、Coachが操作を選び、あなたが承認します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ შესულია. შემდეგ Coach ირჩევს მის მოქმედებებს და თქვენ ამტკიცებთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 로그인했습니다. 다음으로 Coach가 행동을 고르고 내가 승인합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ prisijungta. Toliau Coach pasirenka jos veiksmus, o jūs juos patvirtinate."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierakstīšanās %1$@ ir veikta. Tālāk Coach izvēlas tās darbības, un tu tās apstiprini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is ingelogd. Daarna kiest Coach de acties en keur jij ze goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest zalogowana. Teraz Coach wybierze jej akcje, a Ty je zatwierdzisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tem sessão iniciada. A seguir, o Coach escolhe as suas ações e você aprova-as."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Login feito em %1$@. A seguir, o Coach escolhe as ações dele e você as aprova."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ este conectat. Apoi Coach îi alege acțiunile, iar dvs. le aprobați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je prihlásená. Teraz Coach vyberie jej akcie a vy ich schválite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je prijavljena. Nato Coach izbere njena dejanja, vi pa jih odobrite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ka hyrë. Më pas, Coach zgjedh veprimet e tij dhe ju i miratoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavljeni ste u aplikaciju %1$@. Zatim Coach bira njene radnje, a vi ih odobravate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบ %1$@ แล้ว ถัดไป Coach เลือกการกระทำของมันและคุณอนุมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hesabında oturum açıldı. Sonra Coach eylemlerini seçer ve siz onaylarsınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã đăng nhập. Tiếp theo, Coach chọn các hành động của nó và bạn phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已登入。接下來由 Coach 選擇它的動作，並由您核准。"
          }
        }
      }
    },
