    "coach.shape.draft_until_approved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسودة إلى أن توافق عليها في المحادثة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söhbətdə təsdiq edənə qədər layihədir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чернова, докато не я одобрите в разговора."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কথোপকথনে আপনি অনুমোদন না করা পর্যন্ত একটি খসড়া।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un esborrany fins que l'aprovis a la conversa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Návrh, dokud ho v rozhovoru neschválíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Entwurf, bis du ihn im Gespräch genehmigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A draft until you approve it in the conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un borrador hasta que lo apruebes en la conversación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mustand, kuni selle vestluses kinnitad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brouillon jusqu'à ce que vous l'approuviez dans la conversation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיוטה עד שתאשר אותה בשיחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मसौदा, जब तक आप उसे बातचीत में मंज़ूर नहीं करते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nacrt dok ga ne odobrite u razgovoru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vázlat, amíg jóvá nem hagyod a beszélgetésben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սևագիր, մինչև չհաստատեք զրույցում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah draf sampai Anda menyetujuinya di percakapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bozza finché non la approvi nella conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の中で承認するまでは下書きです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დრაფტი, სანამ საუბარში არ დაამტკიცებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សេចក្តីព្រាង រហូតដល់អ្នកអនុម័តវាក្នុងការសន្ទនា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화에서 승인하기 전까지는 초안입니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເປັນຮ່າງຈົນກວ່າທ່ານອະນຸມັດໃນການສົນທະນາ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Juodraštis, kol jo nepatvirtinsite pokalbyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Melnraksts, līdz tu to apstiprini sarunā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нацрт додека не го одобриш во разговорот."
