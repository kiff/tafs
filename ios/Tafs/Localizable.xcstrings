    "people.new_group_hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlcə onun adamlarını əlavə edin, sonra taf-ın səhifəsindən taf-ı onunla paylaşın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "След това добавете хората ѝ, а после споделете taf с нея от страницата на taf."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pak přidejte její lidi a sdílejte s ní taf ze stránky tafu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge als Nächstes ihre Personen hinzu und teile dann auf der Seite eines tafs den taf mit ihr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add its people next, then share a taf with it from the taf's page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade después a sus personas y luego comparte un taf con él desde la página del taf."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa järgmiseks selle inimesed. Tafi saad sellega jagada tafi enda lehelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez ensuite ses membres, puis partagez un taf avec lui depuis la page du taf."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatim dodajte njezine ljude, pa s njom podijelite taf sa stranice tafa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezután add hozzá a tagjait, majd oszd meg vele a tafot a taf oldaláról."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաջորդ քայլին ավելացրեք նրա մարդկանց, ապա կիսեք taf-ը նրա հետ taf-ի էջից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan anggotanya berikutnya, lalu bagikan taf dengannya dari halaman taf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi aggiungi le sue persone, quindi condividi un taf con il gruppo dalla pagina del taf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にメンバーを追加し、tafのページからこのグループとtafを共有してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაამატეთ მისი ადამიანები შემდეგ, შემდეგ გაუზიარეთ taf taf-ის გვერდიდან."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음으로 사람을 추가한 후, taf의 페이지에서 이 그룹과 taf를 공유하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toliau pridėkite jos narius, tada bendrinkite su ja taf iš taf puslapio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tālāk pievieno tās cilvēkus, tad kopīgo ar to taf no taf lapas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg er daarna mensen aan toe en deel een taf ermee vanaf de pagina van het taf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnie dodaj jej członków, a potem udostępnij jej tafa ze strony tafa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A seguir, adicione as suas pessoas e depois partilhe um taf com ele a partir da página do taf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seguir, adicione as suas pessoas e depois compartilhe um taf com ele a partir da página do taf."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați apoi membrii, iar după aceea partajați un taf cu el din pagina tafului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potom pridajte jej ľudí a zdieľajte s ňou taf zo stránky tafu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nato dodajte njene ljudi in z njo delite taf s strani tafa."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shtoni njerëzit e tij më pas, pastaj ndani një taf me të nga faqja e taf-it."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatim dodajte njene ljude, pa s njom podelite taf sa stranice tafa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มสมาชิกของกลุ่มต่อไป จากนั้นแชร์ taf กับกลุ่มจากหน้าของ taf"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce kişilerini ekleyin, sonra taf'ın sayfasından bir taf'ı onunla paylaşın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm các thành viên của nó tiếp theo, rồi chia sẻ một taf với nhóm từ trang của taf."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接著新增它的成員，然後從 taf 的頁面將 taf 分享給群組。"
          }
        }
      }
    },
