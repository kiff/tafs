    "approval.security_key.tries_left|few": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do zamčení klíče zbývají %1$@ pokusy."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preostala su %1$@ pokušaja prije zaključavanja ključa."
