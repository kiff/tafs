    "voice.tafs_turns_your_voice_into": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل tafs صوتك إلى نص على هذا الجهاز. لا يُرسل صوتك إلى أي مكان."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs səsinizi bu cihazda mətnə çevirir. Səsiniz heç yerə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs превръща гласа ви в текст на това устройство. Гласът ви не се изпраща никъде."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs আপনার কণ্ঠ এই ডিভাইসেই লেখায় রূপান্তরিত করে। আপনার কণ্ঠ কোথাও পাঠানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs converteix la teva veu en text en aquest dispositiu. La teva veu no s'envia enlloc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs mění váš hlas na text přímo v tomto zařízení. Váš hlas se nikam neodesílá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs wandelt deine Stimme auf diesem Gerät in Text um. Deine Stimme wird nirgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs turns your voice into text on this device. Your voice isn't sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs convierte tu voz en texto en este dispositivo. Tu voz no se envía a ningún sitio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs muudab sinu hääle selles seadmes tekstiks. Sinu häält ei saadeta kuhugi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs transforme votre voix en texte sur cet appareil. Votre voix n'est envoyée nulle part."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs הופך את הקול שלך לטקסט בהתקן הזה. הקול שלך לא נשלח לשום מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs आपकी आवाज़ को इस डिवाइस पर टेक्स्ट में बदलता है। आपकी आवाज़ कहीं नहीं भेजी जाती।"
