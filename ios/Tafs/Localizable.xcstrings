    "home.no_longer_runs_tafs_deletes": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد يعمل. يحذف tafs ما تبقّى منه في كل مرة يُحدَّث فيها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "O artıq işləmir. tafs hər yenilənəndə qalanı silir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вече не работи. tafs изтрива останалото при всяко опресняване."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আর চলে না। tafs প্রতিবার রিফ্রেশ হওয়ার সময় যা বাকি আছে তা মুছে দেয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja no s'executa. tafs elimina el que en queda cada cop que s'actualitza."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už neběží. tafs smaže, co zbylo, při každém obnovení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er läuft nicht mehr. tafs löscht bei jeder Aktualisierung, was noch übrig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It no longer runs. tafs deletes what's left each time it refreshes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no se ejecuta. tafs elimina lo que queda cada vez que se actualiza."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ei käivitu enam. tafs kustutab ülejäänu iga värskendusega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne tourne plus. tafs supprime ce qui reste à chaque actualisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא כבר לא רץ. tafs מוחק את מה שנשאר בכל רענון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अब नहीं चलता। tafs हर बार ताज़ा होने पर बचा हुआ हटा देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Više ne radi. tafs briše ostatke svaki put kad se osvježi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már nem fut. A tafs minden frissítéskor törli, ami megmaradt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն այլևս չի աշխատում։ tafs-ը ջնջում է մնացածը ամեն թարմացման ժամանակ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah tidak berjalan. tafs menghapus sisanya setiap kali menyegarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene più eseguito. tafs elimina ciò che resta a ogni aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはもう実行されません。tafsは更新のたびに残りを削除します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ის აღარ მუშაობს. tafs წაშლის დარჩენილს ყოველ განახლებაზე."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាលែងដំណើរការទៀតហើយ។ tafs លុបអ្វីដែលនៅសល់ ពេលវាផ្ទុកឡើងវិញនីមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 실행되지 않습니다. 새로 고칠 때마다 tafs가 남은 것을 삭제합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມັນບໍ່ເຮັດວຽກອີກແລ້ວ. tafs ລຶບສິ່ງທີ່ເຫຼືອທຸກຄັ້ງທີ່ມັນໂຫຼດໃໝ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jis nebeveikia. tafs ištrina tai, kas liko, kaskart atnaujindama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas vairs nedarbojas. tafs izdzēš atlikušo katrā atsvaidzināšanas reizē."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Веќе не работи. tafs го брише остатокот при секое освежување."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ нь цаашид ажиллахгүй. tafs шинэчлэгдэх бүртээ үлдсэнийг нь устгана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो अब चल्दैन। tafs ले हरेक पटक रिफ्रेस गर्दा बाँकी मेट्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het draait niet meer. tafs verwijdert wat er over is bij elke vernieuwing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już nie działa. tafs usuwa to, co zostało, przy każdym odświeżeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já não funciona. O tafs elimina o que resta sempre que atualiza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já não funciona. O tafs exclui o que resta sempre que atualiza."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu mai rulează. tafs șterge ce a rămas la fiecare reîmprospătare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už nebeží. tafs odstráni, čo zostalo, pri každom obnovení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne teče več. tafs izbriše, kar je ostalo, ob vsaki osvežitvi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuk ekzekutohet më. tafs fshin çfarë mbetet sa herë që rifreskohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Više ne radi. tafs briše ostatke svaki put kad se osvježi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันไม่ทำงานอีกแล้ว tafs จะลบสิ่งที่เหลือทุกครั้งที่รีเฟรช"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ol indi işlemeýär. tafs her täzelenende galan zady pozýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık çalışmıyor. tafs, kalanları her yenilendiğinde siler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اب نہیں چلتا۔ tafs ہر بار تازہ ہونے پر جو بچا ہو اسے حذف کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó không còn chạy. tafs xóa phần còn lại mỗi lần làm mới."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它已不再執行。tafs 每次重新整理時會刪除剩餘的內容。"
          }
        }
      }
    },
