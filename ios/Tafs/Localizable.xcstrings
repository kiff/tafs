    "billing.pack_adds_credits_once_never": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket kreditləri bir dəfə əlavə edir və onlar heç vaxt bitmir. Əvvəlcə hər dövrün daxil olan kreditləri, sonra paketlərinki istifadə olunur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакетът добавя кредити веднъж и те никога не изтичат. Първо се използват включените за периода кредити, после тези от пакетите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Balíček přidá kredity jednou a nikdy nevyprší. Nejdřív se čerpají kredity v ceně období, pak kredity z balíčků."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Paket fügt einmalig Credits hinzu, und sie verfallen nie. Zuerst werden die inklusiven Credits jedes Zeitraums verbraucht, dann die der Pakete."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pack adds credits once, and they never expire. Each period's included credits are used first, then the packs'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paquete añade créditos una sola vez, y nunca caducan. Primero se usan los créditos incluidos de cada periodo y luego los de los paquetes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediidipakett lisab krediidid ühe korra ja need ei aegu kunagi. Esmalt kasutatakse iga perioodi hinna sees olevaid krediite, seejärel krediidipakettide omi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pack ajoute des crédits une fois, et ils n'expirent jamais. Les crédits inclus de chaque période sont utilisés d'abord, puis ceux des packs."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket jednokratno dodaje kredite i oni nikad ne istječu. Najprije se troše krediti uključeni u svako razdoblje, a zatim oni iz paketa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy kreditcsomag egyszer ad krediteket, és azok soha nem járnak le. Először az időszak benne foglalt kreditjei fogynak, utána a csomagoké."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փաթեթը կրեդիտներ է ավելացնում մեկ անգամ, և դրանք երբեք չեն սպառվում։ Առաջինը օգտագործվում են յուրաքանչյուր ժամանակահատվածի ներառված կրեդիտները, ապա՝ փաթեթներինը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket menambahkan kredit sekali, dan kredit itu tidak pernah kedaluwarsa. Kredit yang termasuk di setiap periode dipakai lebih dulu, lalu kredit paket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pacchetto aggiunge crediti una volta sola, e non scadono mai. Prima si usano i crediti inclusi di ogni periodo, poi quelli dei pacchetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パックはクレジットを1回追加し、有効期限はありません。各期間に含まれるクレジットを先に使い、その後パックのクレジットを使います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პაკეტი კრედიტებს ერთხელ ამატებს და ისინი არასოდეს იწურება. ჯერ გამოიყენება ყოველი პერიოდის ჩართული კრედიტები, შემდეგ პაკეტებისა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팩은 크레딧을 한 번 추가하며 만료되지 않습니다. 각 기간에 포함된 크레딧을 먼저 사용한 후 팩의 크레딧을 사용합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketas prideda kreditų vieną kartą, ir jie nenustoja galioti. Pirmiausia naudojami laikotarpio įskaičiuoti kreditai, paskui – paketų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakete pievieno kredītus vienreiz, un tiem nav derīguma termiņa. Vispirms tiek izmantoti katrā periodā iekļautie kredīti, pēc tam pakešu kredīti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een pakket voegt eenmalig credits toe, en die verlopen nooit. De inbegrepen credits van elke periode worden eerst gebruikt, daarna die van de pakketten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakiet dodaje kredyty jednorazowo i nigdy nie wygasają. Najpierw zużywane są kredyty z okresu, potem z pakietów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pacote adiciona créditos uma vez, e estes nunca expiram. Os créditos incluídos em cada período são usados primeiro, depois os dos pacotes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pacote adiciona créditos uma vez, e estes nunca expiram. Os créditos incluídos em cada período são usados primeiro, depois os dos pacotes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pachet adaugă credite o singură dată, iar acestea nu expiră niciodată. Mai întâi se folosesc creditele incluse în fiecare perioadă, apoi cele din pachete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Balík pridá kredity raz a nikdy nevypršia. Najprv sa čerpajú kredity v cene obdobia, potom kredity z balíkov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket enkrat doda kredite in ti nikoli ne potečejo. Najprej se porabijo krediti, vključeni v obdobje, nato tisti iz paketov."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një paketë shton kredite një herë, dhe ato nuk skadojnë kurrë. Fillimisht përdoren kreditet e përfshira të çdo periudhe, pastaj ato të paketave."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket dodaje kredite jednom i oni nikad ne ističu. Krediti uključeni u svaki period troše se prvi, zatim oni iz paketa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพ็กเพิ่มเครดิตครั้งเดียวและไม่มีวันหมดอายุ เครดิตที่รวมในแต่ละรอบจะถูกใช้ก่อน แล้วจึงใช้เครดิตของแพ็ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir paket bir kez kredi ekler ve bu krediler asla sona ermez. Önce her dönemin dahil kredileri, sonra paketlerinki kullanılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một gói thêm tín dụng một lần và chúng không bao giờ hết hạn. Tín dụng có sẵn mỗi kỳ được dùng trước, rồi đến tín dụng của các gói."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點數包一次性增加點數，且永不過期。每期包含的點數會先使用，然後才使用點數包的點數。"
          }
        }
      }
    },
    "billing.pending_credits": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alış təsdiq gözləyir. Kreditləriniz bitən kimi əlavə olunur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупката чака одобрение. Кредитите ви се добавят, щом приключи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup čeká na schválení. Kredity se přidají, až bude hotový."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wartet auf Genehmigung. Deine Credits werden hinzugefügt, sobald er abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase is waiting for approval. Your credits are added once it's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra está esperando aprobación. Tus créditos se añaden cuando se complete."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ost ootab kinnitust. Sinu krediidid lisatakse, kui see on tehtud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat attend une approbation. Vos crédits sont ajoutés dès qu'elle est donnée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupnja čeka odobrenje. Vaši krediti bit će dodani čim bude gotova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlás jóváhagyásra vár. A kreditjeid, amint kész, hozzáadódnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գնումը սպասում է հաստատման։ Ձեր կրեդիտները կավելանան, հենց ավարտվի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian menunggu persetujuan. Kredit Anda ditambahkan setelah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto è in attesa di approvazione. I tuoi crediti vengono aggiunti una volta completato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。完了するとクレジットが追加されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეძენა დამტკიცებას ელოდება. თქვენი კრედიტები დაემატება, როგორც კი დასრულდება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 승인을 기다리고 있습니다. 완료되면 크레딧이 추가됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirkinys laukia patvirtinimo. Kreditai bus pridėti, kai jis bus užbaigtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirkums gaida apstiprinājumu. Tavi kredīti tiks pievienoti, kad tas būs pabeigts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoop wacht op goedkeuring. Je credits worden toegevoegd zodra die rond is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup czeka na zatwierdzenie. Twoje kredyty zostaną dodane, gdy się zakończy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra está à espera de aprovação. Os seus créditos são adicionados quando estiver concluída."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra está aguardando aprovação. Os seus créditos são adicionados quando ela for concluída."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția așteaptă aprobarea. Creditele se adaugă când se finalizează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup čaká na schválenie. Kredity sa pridajú, keď bude hotový."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakup čaka na odobritev. Krediti se dodajo, ko bo opravljen."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Blerja pret miratimin. Kreditet tuaja shtohen sapo të përfundojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupovina čeka odobrenje. Vaši krediti se dodaju čim se završi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อรอการอนุมัติ เครดิตของคุณจะถูกเพิ่มเมื่อเสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma onay bekliyor. Tamamlanır tamamlanmaz kredileriniz eklenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch mua đang chờ phê duyệt. Tín dụng của bạn được thêm khi hoàn tất."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買正在等待核准。完成後會加入您的點數。"
          }
        }
      }
    },
