    "version.card_note.issues": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während des Wechsels läuft dein taf nicht. Eine Bestätigung stellt diese Cards in KIFF aus, dann geht diese Version live."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While it switches, your taf doesn't run. Confirming once issues these Cards in KIFF, then this version goes live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras cambia, tu taf no se ejecuta. Al confirmar una vez se emiten estas Cards en KIFF y luego esta versión se activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le changement, votre taf ne s'exécute pas. Une seule confirmation émet ces Cards dans KIFF, puis cette version est mise en service."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante il passaggio, il tuo taf non lavora. Una sola conferma emette queste Card in KIFF, poi questa versione diventa attiva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens het overschakelen draait je taf niet. Eén keer bevestigen geeft deze Cards uit in KIFF, daarna gaat deze versie live."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas przełączania Twój taf nie działa. Jedno potwierdzenie wydaje te Card w KIFF, a potem ta wersja zaczyna działać na żywo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a mudança, o seu taf não é executado. Confirmar uma vez emite estes Cards no KIFF, e depois esta versão entra em produção."
          }
        }
      }
    },
    "version.card_note.issues_biometry": {
      "extractionState": "manual",
      "localizations": {
