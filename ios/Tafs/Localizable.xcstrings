      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ من %1$@ منك ومن المرسلين المقترنين اليوم. نص فقط: لا تُفتح المرفقات، ويذكر الرد ذلك."
