          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Card ของมันนับจากศูนย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Card'ı sıfırdan sayar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Card của nó tính từ số không."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的 Card 從零開始計算。"
          }
        }
      }
    },
    "version.while_you_try.ends": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz onu quraşdıranda, geri qayıdanda və ya 7 istifadəsiz gündən sonra bitir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приключва, когато я инсталирате, върнете се или след 7 дни без използване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skončí, když ji nainstalujete, vrátíte se, nebo po 7 dnech bez použití."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endet, wenn du sie installierst oder zurückkehrst, oder nach 7 ungenutzten Tagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends when you install it, go back, or after 7 unused days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina cuando la instalas, vuelves atrás, o tras 7 días sin usarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõpeb, kui selle paigaldad, tagasi lähed või pärast 7 kasutamata päeva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend fin quand vous l'installez, revenez en arrière, ou après 7 jours sans utilisation."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Završava kad je instalirate, vratite se ili nakon 7 neiskorištenih dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkor ér véget, amikor telepíted, visszatérsz, vagy 7 használat nélküli nap után."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավարտվում է, երբ տեղադրեք այն, վերադառնաք կամ 7 չօգտագործված օրից հետո։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berakhir saat Anda memasangnya, kembali, atau setelah 7 hari tanpa dipakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina quando la installi, torni indietro, o dopo 7 giorni senza uso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールするか、元に戻すか、7日間使わないと終了します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთავრდება, როცა დააყენებთ, დაბრუნდებით ან 7 გამოუყენებელი დღის შემდეგ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치하거나, 되돌아가거나, 7일 동안 사용하지 않으면 끝납니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baigiasi, kai ją įdiegiate, grįžtate arba po 7 nenaudojimo dienų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beidzas, kad tu to instalē, atgriezies vai pēc 7 neizmantotām dienām."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eindigt als je het installeert, teruggaat, of na 7 dagen zonder gebruik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy się, gdy ją zainstalujesz, wrócisz, albo po 7 dniach nieużywania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina quando a instalar, voltar atrás, ou após 7 dias sem uso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina quando a instalar, voltar atrás, ou após 7 dias sem uso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încheie când o instalați, reveniți sau după 7 zile nefolosită."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skončí, keď ju nainštalujete, vrátite sa, alebo po 7 dňoch bez použitia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konča se, ko jo namestite, se vrnete ali po 7 dneh neuporabe."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përfundon kur e instaloni, ktheheni, ose pas 7 ditësh të papërdorura."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Završava kad je instalirate, vratite se ili nakon 7 neiskorištenih dana."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ้นสุดเมื่อคุณติดตั้ง ย้อนกลับ หรือหลังจากไม่ได้ใช้ 7 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurduğunuzda, geri döndüğünüzde veya 7 kullanılmayan günden sonra biter."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết thúc khi bạn cài nó, quay lại, hoặc sau 7 ngày không dùng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您安裝、返回，或 7 天未使用後結束。"
          }
        }
      }
    },
    "version.while_you_try.live_keeps_working": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İşləyən versiya işləməyə davam edir; bir gündə hər iki Card-ın limitləri xərclənə bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Активната версия продължава да работи; за един ден могат да се изразходват лимитите и на двете Cards."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivní verze dál běží; za den se mohou vyčerpat limity obou Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Version läuft weiter; an einem Tag können die Limits beider Cards ausgeschöpft werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live version keeps running; on a day, both Cards' limits can be spent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión activa sigue funcionando; en un día se pueden gastar los límites de ambas Cards."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutusel olev versioon töötab edasi; ühel päeval võib kulutada mõlema Cardi limiidid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version en service continue de tourner ; sur une journée, les limites des deux Cards peuvent être dépensées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzija u radu i dalje radi; u jednom danu mogu se potrošiti ograničenja oba Carda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az élő verzió tovább fut; egy adott napon mindkét Card limitjei elkölthetők."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ակտիվ տարբերակը շարունակում է աշխատել․ օրվա ընթացքում երկու Card-երի սահմանաչափերն էլ կարող են ծախսվել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi yang aktif tetap berjalan; dalam sehari, batas kedua Card dapat terpakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione attiva continua a funzionare; in un giorno si possono spendere i limiti di entrambe le Card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用中のバージョンも動き続けるため、1日で両方のCardの上限を使う場合があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქტიური ვერსია აგრძელებს მუშაობას; ერთ დღეში ორივე Card-ის ლიმიტი შეიძლება დაიხარჯოს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용된 버전은 계속 실행됩니다. 하루에 두 Card의 한도를 모두 쓸 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktyvi versija veikia toliau; per dieną gali būti išnaudoti abiejų Card limitai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Darbā esošā versija turpina darboties; vienā dienā var tikt iztērēti abu Card limiti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De live versie blijft draaien; op een dag kunnen de limieten van beide Cards worden besteed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja działająca na żywo działa dalej; jednego dnia można wydać limity obu Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão em produção continua a funcionar; num dia, podem ser gastos os limites de ambos os Cards."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão em produção continua funcionando; em um dia, podem ser gastos os limites de ambos os Cards."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea activă continuă să ruleze; într-o zi se pot consuma limitele ambelor Carduri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktívna verzia ďalej beží; za deň sa môžu vyčerpať limity oboch Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivna različica še naprej teče; v enem dnevu se lahko porabijo omejitve obeh Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Versioni aktiv vazhdon të ekzekutohet; në një ditë, mund të shpenzohen kufijtë e të dy Card-eve."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzija u radu i dalje radi; u jednom danu mogu se potrošiti ograničenja oba Carda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันที่ใช้งานอยู่ยังทำงานต่อ ในวันหนึ่ง ขีดจำกัดของ Card ทั้งสองใบอาจถูกใช้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayındaki sürüm çalışmaya devam eder; bir günde her iki Card'ın limitleri de harcanabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản đang chạy vẫn tiếp tục; trong một ngày, giới hạn của cả hai Card đều có thể được dùng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前生效的版本會繼續執行；在同一天內，兩張 Card 的上限都可能被用掉。"
          }
        }
      }
    },
