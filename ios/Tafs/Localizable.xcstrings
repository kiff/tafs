    "coach.improve_line": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nəyin dəyişməli olduğunu deyin və ya necə getdiyini soruşun. Coach rejimi %1$@ taf-ının etdiklərindən və Card-ının icazə verdiyindən başlayır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кажете какво да се промени или попитайте как върви. Режимът Coach започва от това, което %1$@ е направил, и от това, което позволява неговата Card."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řekněte, co se má změnit, nebo se zeptejte, jak mu to jde. Režim Coach vychází z toho, co %1$@ udělal a co dovoluje jeho Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag, was sich ändern soll, oder frag, wie es läuft. Der Coach-Modus geht davon aus, was %1$@ getan hat und was seine Card erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say what should change, or ask how it's going. Coach mode starts from what %1$@ did and what its Card allows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di qué debería cambiar, o pregunta cómo va. El modo Coach parte de lo que hizo %1$@ y de lo que permite su Card."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ütle, mis peaks muutuma, või küsi, kuidas läheb. Coachi režiim lähtub sellest, mida %1$@ tegi ja mida selle Card lubab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites ce qui doit changer, ou demandez comment ça se passe. Le mode Coach part de ce que %1$@ a fait et de ce que sa Card autorise."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recite što treba promijeniti ili pitajte kako ide. Način rada Coach kreće od onoga što je napravio %1$@ i što dopušta njegov Card."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mondd el, mi változzon, vagy kérdezd meg, hogy halad. A Coach mód abból indul, amit %1$@ csinált, és amit a Cardja enged."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ասեք, թե ինչ պետք է փոխվի, կամ հարցրեք, թե ինչպես է ընթանում։ Coach-ի ռեժիմը սկսվում է նրանից, ինչ արեց %1$@-ը և ինչ թույլատրում է նրա Card-ը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Katakan apa yang perlu diubah, atau tanyakan perkembangannya. Mode Coach dimulai dari apa yang dilakukan %1$@ dan apa yang diizinkan Card-nya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' cosa dovrebbe cambiare, o chiedi come sta andando. La modalità Coach parte da ciò che %1$@ ha fatto e da ciò che la sua Card consente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変えたいことを伝えるか、調子を尋ねてください。Coachモードは、%1$@が行ったこととCardが許可する範囲から始まります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვით, რა უნდა შეიცვალოს, ან ჰკითხეთ, როგორ მიდის. Coach-ის რეჟიმი იწყება იმით, რაც გააკეთა %1$@-მა და რასაც მისი Card უშვებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꿀 점을 말하거나 진행 상황을 물어보세요. Coach 모드는 %1$@이(가) 한 일과 Card가 허용하는 범위에서 시작합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasakykite, ką pakeisti, arba paklauskite, kaip sekasi. Coach režimas pradeda nuo to, ką padarė %1$@ ir ką leidžia jo Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasaki, kas jāmaina, vai pajautā, kā sokas. Coach režīms sāk no tā, ko %1$@ izdarīja un ko atļauj tā Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg wat er moet veranderen, of vraag hoe het gaat. De Coach-modus begint bij wat %1$@ heeft gedaan en wat zijn Card toestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz, co powinno się zmienić, albo zapytaj, jak idzie. Tryb Coach zaczyna od tego, co zrobił %1$@ i na co pozwala jego Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga o que deve mudar, ou pergunte como está a correr. O modo Coach parte do que %1$@ fez e do que o seu Card permite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga o que deve mudar, ou pergunte como está indo. O modo Coach parte do que %1$@ fez e do que o seu Card permite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spuneți ce ar trebui să se schimbe sau întrebați cum merge. Modul Coach pornește de la ce a făcut %1$@ și ce îi permite Cardul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povedzte, čo sa má zmeniť, alebo sa opýtajte, ako mu to ide. Režim Coach vychádza z toho, čo %1$@ urobil a čo dovoľuje jeho Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povejte, kaj naj se spremeni, ali vprašajte, kako mu gre. Način Coach izhaja iz tega, kar je %1$@ naredil in kar dovoli njegova Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoni çfarë duhet të ndryshojë, ose pyesni si po shkon. Mënyra Coach nis nga ajo që bëri %1$@ dhe ajo që lejon Card-i i tij."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Recite šta treba promeniti ili pitajte kako ide. Način rada Coach kreće od onoga šta je napravio %1$@ i šta dopušta njegov Card."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกว่าควรเปลี่ยนอะไร หรือถามว่าเป็นอย่างไรบ้าง โหมด Coach เริ่มจากสิ่งที่ %1$@ ทำและสิ่งที่ Card ของมันอนุญาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyin değişmesi gerektiğini söyleyin veya nasıl gittiğini sorun. Coach modu, %1$@ taf'ının yaptıklarından ve Card'ının izin verdiklerinden yola çıkar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nói điều gì cần đổi, hoặc hỏi mọi việc thế nào. Chế độ Coach bắt đầu từ những gì %1$@ đã làm và những gì Card của nó cho phép."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說明需要變更什麼，或詢問進行得如何。Coach 模式會從 %1$@ 做過的事以及它的 Card 所允許的範圍開始。"
          }
        }
      }
    },
    "coach.improve_no_files": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayllar növbəti mesajınızla gedir: əvvəlcə bunu göndərin, sonra onları əlavə edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файловете отиват със следващото ви съобщение: първо изпратете това, после ги прикачете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory jdou s vaší další zprávou: nejdřív odešlete tuto, pak je přiložte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien kommen mit deiner nächsten Nachricht: Sende zuerst diese, dann häng sie an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files go with your next message: send this one first, then attach them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos van con tu próximo mensaje: envía primero este y luego adjúntalos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Failid lähevad koos sinu järgmise sõnumiga: saada kõigepealt see, siis lisa need."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers partent avec votre prochain message : envoyez d'abord celui-ci, puis joignez-les."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke idu uz vašu sljedeću poruku: najprije pošaljite ovu, pa ih priložite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlok a következő üzeneteddel mennek: előbb ezt küldd el, aztán csatold őket."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլերը գնում են ձեր հաջորդ հաղորդագրության հետ․ նախ ուղարկեք սա, ապա կցեք դրանք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File ikut pesan Anda berikutnya: kirim yang ini dulu, lalu lampirkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vanno con il prossimo messaggio: invia prima questo, poi allegali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは次のメッセージと一緒に送られます。先にこのメッセージを送ってから添付してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილები მიდის თქვენს შემდეგ შეტყობინებასთან ერთად: ჯერ ეს გააგზავნეთ, შემდეგ მიამაგრეთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 다음 메시지와 함께 보내집니다. 이 메시지를 먼저 보낸 뒤 첨부하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Failai siunčiami su kita jūsų žinute: pirmiausia išsiųskite šią, tada juos pridėkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili tiek sūtīti ar nākamo ziņu: vispirms nosūti šo, tad pievieno tos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden gaan mee met je volgende bericht: stuur eerst dit bericht en voeg ze daarna bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki trafią do następnej wiadomości: najpierw wyślij tę, a potem je załącz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros vão com a próxima mensagem: envie primeiro esta e depois anexe-os."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos vão com a próxima mensagem: envie primeiro esta e depois anexe-os."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele pleacă cu următorul mesaj: trimiteți-l mai întâi pe acesta, apoi atașați-le."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbory idú s vašou ďalšou správou: najprv odošlite túto, potom ich priložte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke gredo z vašim naslednjim sporočilom: najprej pošljite tega, nato jih priložite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Skedarët shkojnë me mesazhin tuaj të radhës: dërgojeni më parë këtë, pastaj bashkëngjitini."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke idu uz vašu sledeću poruku: prvo pošaljite ovu, pa ih priložite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์จะไปพร้อมข้อความถัดไปของคุณ: ส่งข้อความนี้ก่อน แล้วค่อยแนบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar bir sonraki mesajınızla gider: önce bunu gönderin, sonra ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp đi cùng tin nhắn tiếp theo của bạn: hãy gửi tin này trước, rồi đính kèm chúng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會隨您的下一則訊息送出：請先傳送這一則，再附加檔案。"
          }
        }
      }
    },
    "coach.improve_taf": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ taf-ını təkmilləşdirin"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Подобряване на %1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vylepšit %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ verbessern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improve %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejorar %1$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täiusta tafi %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliorer %1$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poboljšajte taf %1$@"
          }
        },
        "hu": {
