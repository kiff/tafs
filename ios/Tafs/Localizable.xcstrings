    "record.not_recorded": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@، لكن لم يُسجَّل ما إذا كان التطبيق قد نفّذه: تحقق من سجلات التطبيق نفسه"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, amma tətbiqin onu edib-etmədiyi qeyd edilmədi: tətbiqin öz qeydlərini yoxlayın"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, но не е записано дали приложението го е направило: проверете собствените записи на приложението"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, কিন্তু অ্যাপ এটি করেছে কি না তা রেকর্ড হয়নি: অ্যাপের নিজস্ব রেকর্ড দেখুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, però no s'ha registrat si l'aplicació ho ha fet: mira els registres de l'aplicació mateixa"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ale jestli to aplikace udělala, se nezaznamenalo: zkontrolujte záznamy samotné aplikace"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, aber ob die App es ausgeführt hat, wurde nicht festgehalten: Prüfe die eigenen Aufzeichnungen der App"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, but whether the app did it wasn't recorded: check the app's own records"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, pero no quedó registrado si la app lo hizo: revisa los registros de la propia app"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, kuid seda, kas rakendus selle tegi, ei salvestatud: kontrolli rakenduse enda kirjeid"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, mais l'exécution par l'app n'a pas été enregistrée : vérifiez les registres de l'app"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, אבל לא נרשם אם האפליקציה עשתה זאת: יש לבדוק ברשומות של האפליקציה עצמה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, पर ऐप ने किया या नहीं यह दर्ज नहीं हुआ: ऐप के अपने रिकॉर्ड जाँचें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ali nije zabilježeno je li to aplikacija učinila: provjerite vlastite zapise aplikacije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, de nem lett rögzítve, hogy az alkalmazás megtette-e: nézd meg az alkalmazás saját nyilvántartását"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, բայց հավելվածը արեց այն, թե ոչ՝ չգրանցվեց․ ստուգեք հենց հավելվածի գրառումները"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, tetapi apakah aplikasi melakukannya tidak tercatat: periksa catatan aplikasi itu sendiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ma non è stato registrato se l'app l'ha fatto: controlla i registri dell'app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、ただしアプリが実行したかは記録されていません：アプリ側の記録を確認してください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, მაგრამ აპმა გააკეთა თუ არა, არ ჩაწერილა: შეამოწმეთ თავად აპის ჩანაწერები"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ប៉ុន្តែមិនបានកត់ត្រាថាកម្មវិធីបានធ្វើវាឬអត់ទេ៖ ពិនិត្យកំណត់ត្រារបស់កម្មវិធីខ្លួនឯង"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 하지만 앱이 처리했는지 기록되지 않았습니다: 앱의 자체 기록을 확인하세요"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ແຕ່ບໍ່ໄດ້ບັນທຶກວ່າແອັບເຮັດຫຼືບໍ່: ກວດບັນທຶກຂອງແອັບເອງ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, bet neįrašyta, ar programėlė tai atliko: patikrinkite pačios programėlės įrašus"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, bet tas, vai lietotne to izdarīja, netika reģistrēts: pārbaudi pašas lietotnes ierakstus"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, но не е запишано дали апликацијата го направила: провери ги сопствените записи на апликацијата"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, гэхдээ апп үүнийг хийсэн эсэх бүртгэгдээгүй: аппын өөрийн бүртгэлийг шалгана уу"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, तर एपले यो गर्‍यो कि गरेन भन्ने अभिलेख भएन: एपका आफ्नै अभिलेख जाँच्नुहोस्"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, maar of de app het heeft gedaan, is niet vastgelegd: controleer de gegevens van de app zelf"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ale nie zapisano, czy aplikacja to wykonała: sprawdź własne rejestry aplikacji"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, mas não ficou registado se a app o fez: verifique os registos da própria app"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, mas não ficou registrado se o app fez isso: verifique os registros do próprio app"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, dar nu s-a înregistrat dacă aplicația a făcut-o: verificați evidența proprie a aplicației"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ale či to aplikácia urobila, sa nezaznamenalo: skontrolujte záznamy samotnej aplikácie"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, a ni bilo zabeleženo, ali je aplikacija to naredila: preverite zapise same aplikacije"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, por nuk u regjistrua nëse aplikacioni e bëri: kontrolloni regjistrat e vetë aplikacionit"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ali nije zabilježeno je li to aplikacija učinila: proverite vlastite zapise aplikacije"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ แต่ไม่ได้บันทึกว่าแอปทำหรือไม่: ตรวจสอบบันทึกของแอปเอง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ýöne programmanyň ony edendigi ýazylmady: programmanyň öz ýazgylaryny barlaň"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ama uygulamanın yapıp yapmadığı kaydedilmedi: uygulamanın kendi kayıtlarını kontrol edin"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@، مگر یہ درج نہیں ہوا کہ ایپ نے کیا یا نہیں: ایپ کے اپنے ریکارڈز دیکھیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, nhưng việc ứng dụng có làm hay không chưa được ghi lại: hãy kiểm tra hồ sơ của chính ứng dụng"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，但 App 是否執行並未記錄：請查看 App 本身的紀錄"
          }
        }
      }
    },
