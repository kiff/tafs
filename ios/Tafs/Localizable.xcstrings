    "coach.answer.wrote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّدت بكلماتك الخاصة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz öz sözlərinizlə cavab verdiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговорихте със свои думи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি নিজের কথায় উত্তর দিয়েছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has respost amb les teves paraules."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpověděli jste vlastními slovy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast mit deinen eigenen Worten geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You answered in your own words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respondiste con tus propias palabras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastasid oma sõnadega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez répondu avec vos propres mots."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ענית במילים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अपने शब्दों में उत्तर दिया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovorili ste vlastitim riječima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A saját szavaiddal válaszoltál."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դուք պատասխանեցիք ձեր սեփական բառերով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda menjawab dengan kata-kata sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai risposto con parole tue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の言葉で回答しました。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენ უპასუხეთ საკუთარი სიტყვებით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកបានឆ្លើយដោយពាក្យរបស់អ្នកផ្ទាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 말로 답했습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທ່ານຕອບດ້ວຍຄຳເວົ້າຂອງທ່ານເອງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsakėte savo žodžiais."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu atbildēji saviem vārdiem."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговори со свои зборови."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та өөрийн үгээр хариулсан."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले आफ्नै शब्दमा जवाफ दिनुभयो।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt in je eigen woorden geantwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedziano własnymi słowami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Respondeu pelas suas próprias palavras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respondeu pelas suas próprias palavras."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ați răspuns cu propriile cuvinte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovedali ste vlastnými slovami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovorili ste s svojimi besedami."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "U përgjigjët me fjalët tuaja."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovorili ste vlastitim rečima."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณตอบด้วยคำของคุณเอง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz öz sözleriňiz bilen jogap berdiňiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi sözlerinizle yanıtladınız."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے اپنے الفاظ میں جواب دیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã trả lời bằng lời của mình."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已用自己的話回覆。"
          }
        }
      }
    },
    "coach.answer_did_not_reach_setup": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصل ردك إلى Setup. اضغط عليه مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cavabınız Quraşdırmaya çatmadı. Yenidən toxunun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговорът ви не стигна до Setup. Докоснете го отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার উত্তর সেটআপে পৌঁছায়নি। আবার ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva resposta no ha arribat a Configuració. Torna a tocar-la."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše odpověď se do Setup nedostala. Klepněte na ni znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Antwort hat Setup nicht erreicht. Tippe noch einmal darauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answer didn't reach Setup. Tap it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu respuesta no llegó a Configuración. Vuelve a tocarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu vastus ei jõudnud Setupini. Puuduta seda uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réponse n'est pas parvenue à la Configuration. Touchez-la à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התשובה שלך לא הגיעה להגדרה. יש ללחוץ שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका उत्तर Setup तक नहीं पहुँचा। उस पर फिर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš odgovor nije stigao do Setupa. Dodirnite ga ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszod nem jutott el a Setupig. Koppints rá újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր պատասխանը Setup-ին չհասավ։ Հպեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban Anda tidak sampai ke Setup. Ketuk lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua risposta non ha raggiunto la configurazione. Toccala di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答がセットアップに届きませんでした。もう一度タップしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი პასუხი Setup-ს არ მიუღწევია. შეეხეთ ხელახლა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចម្លើយរបស់អ្នកមិនបានទៅដល់ការរៀបចំទេ។ ចុចវាម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변이 구성에 전달되지 않았습니다. 다시 누르세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຳຕອບຂອງທ່ານບໍ່ເຖິງການຕັ້ງຄ່າ. ແຕະມັນອີກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų atsakymas nepasiekė Setup. Palieskite jį dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tava atbilde nesasniedza Setup. Pieskaries tai vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твојот одговор не стигна до Конфигурација. Допри го повторно."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны хариу Тохируулгад хүрсэнгүй. Дахин товшино уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको जवाफ सेटअपमा पुगेन। फेरि ट्याप गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je antwoord heeft Setup niet bereikt. Tik er nogmaals op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja odpowiedź nie dotarła do Konfiguracji. Dotknij jej ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua resposta não chegou à Configuração. Toque novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua resposta não chegou à Configuração. Toque novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsul dvs. nu a ajuns la Setup. Atingeți-l din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša odpoveď sa do Setup nedostala. Ťuknite na ňu znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš odgovor ni prišel do Setup. Tapnite ga znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigjja juaj nuk arriti te Setup. Prekeni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš odgovor nije stigao do Setupa. Dodirnite ga ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบของคุณไปไม่ถึงการตั้งค่า แตะอีกครั้ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogabyňyz Setup-a ýetmedi. Ýene bir gezek basyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtınız Setup'a ulaşmadı. Tekrar dokunun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا جواب سیٹ اپ تک نہیں پہنچا۔ اسے دوبارہ ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời của bạn chưa đến được Cài đặt. Hãy chạm lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的回覆未傳達至設定。請再輕點一次。"
          }
        }
      }
    },
