            "state": "translated",
            "value": "Премахване на ключа за достъп %1$@ от акаунта ви"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranit přístupový klíč %1$@ z vašeho účtu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Passkey %1$@ aus deinem Konto entfernen"
          }
        },
        "en": {
