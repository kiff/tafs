          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iestati jaunu taf, pievieno lietotni vai maini, kā kāds strādā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een nieuw taf in, koppel een app of verander hoe er een werkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skonfiguruj nowego tafa, połącz aplikację albo zmień sposób działania tafa."
          }
        },
        "pt": {
