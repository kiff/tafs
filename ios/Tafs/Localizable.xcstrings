    "chrome.expired": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodun vaxtı bitdi, ona görə heç nə cütləşmədi. Yenidən başlayın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодът изтече, така че нищо не беше сдвоено. Започнете отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnost kódu vypršela, takže se nic nespárovalo. Začněte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code ist abgelaufen, also wurde nichts gekoppelt. Fang noch einmal an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code expired, so nothing was paired. Start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código caducó, así que no se vinculó nada. Empieza de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kood aegus, seega midagi ei seotud. Alusta uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code a expiré, rien n'a donc été associé. Recommencez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôd je istekao pa ništa nije upareno. Počnite ispočetka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kód lejárt, így semmi sem lett párosítva. Kezdd újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կոդի ժամկետը լրացավ, ուստի ոչինչ չզուգակցվեց։ Սկսեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode kedaluwarsa, jadi tidak ada yang dipasangkan. Mulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice è scaduto, quindi non è stato associato nulla. Ricomincia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードの有効期限が切れたため、何もペアリングされませんでした。もう一度やり直してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კოდის ვადა ამოიწურა, ამიტომ არაფერი დაწყვილდა. დაიწყეთ თავიდან."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 만료되어 아무것도 페어링되지 않았습니다. 다시 시작하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodas nebegalioja, todėl niekas nesusieta. Pradėkite iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda derīgums beidzās, tāpēc nekas netika savienots pārī. Sāc no jauna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code is verlopen, dus er is niets gekoppeld. Begin opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod wygasł, więc nic nie zostało powiązane. Zacznij od nowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O código expirou, por isso nada foi associado. Comece de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código expirou, por isso nada foi associado. Comece de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codul a expirat, așa că nu s-a asociat nimic. Începeți din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnosť kódu vypršala, takže sa nič nespárovalo. Začnite znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda je potekla, zato ni bilo nič seznanjeno. Začnite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodi skadoi, ndaj asgjë nuk u çiftua. Filloni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôd je istekao, pa ništa nije upareno. Počnite ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสหมดอายุ จึงยังไม่ได้จับคู่อะไร เริ่มใหม่อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodun süresi doldu, bu yüzden hiçbir şey eşleştirilmedi. Baştan başlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã đã hết hạn nên chưa có gì được ghép đôi. Hãy bắt đầu lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼已過期，因此未配對任何項目。請重新開始。"
          }
        }
      }
    },
    "chrome.footer": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin tafs-ınız cütləşmiş Chrome-dan yalnız bağlantının sadaladığı saytlarda istifadə edə bilər, riskli addımları isə burada təsdiq edirsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите tafs могат да използват сдвоен Chrome само на сайтовете, които дадена връзка изброява, а рисковите стъпки одобрявате тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy mohou spárovaný Chrome používat jen na webech, které uvádí připojení, a riskantní kroky schvalujete zde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs können ein gekoppeltes Chrome nur auf den Websites nutzen, die eine Verbindung nennt, und riskante Schritte bestätigst du hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tafs can use a paired Chrome only on the sites a connection lists, and you approve risky steps here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tafs solo pueden usar un Chrome vinculado en los sitios que indica una conexión, y tú apruebas aquí los pasos arriesgados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tafid saavad seotud Chrome'i kasutada ainult ühenduses loetletud saitidel ja riskantsed sammud kinnitad sina siin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tafs ne peuvent utiliser un Chrome associé que sur les sites qu'une connexion indique, et vous approuvez ici les étapes risquées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafovi mogu koristiti upareni Chrome samo na stranicama koje navodi veza, a rizične korake odobravate ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafjaid egy párosított Chrome-ot csak a kapcsolatban felsorolt webhelyeken használhatnak, a kockázatos lépéseket pedig itt hagyod jóvá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր tafs-ը կարող է օգտագործել զուգակցված Chrome-ը միայն այն կայքերում, որոնք նշված են կապի մեջ, իսկ վտանգավոր քայլերը դուք հաստատում եք այստեղ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs Anda hanya dapat memakai Chrome yang dipasangkan di situs yang tercantum pada sebuah koneksi, dan Anda menyetujui langkah berisiko di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tafs possono usare un Chrome associato solo sui siti indicati da un collegamento, e i passaggi rischiosi li approvi qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsがペアリング済みのChromeを使えるのは、接続に指定されたサイトだけです。リスクのある操作はここで承認します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენს tafs-ს დაწყვილებული Chrome შეუძლია გამოიყენოს მხოლოდ იმ საიტებზე, რომლებსაც კავშირი ჩამოთვლის, ხოლო სარისკო ნაბიჯებს აქ ამტკიცებთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs는 페어링된 Chrome을 연결에 지정된 사이트에서만 사용할 수 있으며, 위험한 단계는 여기서 승인합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų taf susietą Chrome gali naudoti tik ryšyje nurodytose svetainėse, o rizikingus veiksmus patvirtinate čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavi taf var izmantot savienoto Chrome tikai savienojumā norādītajās vietnēs, un riskantus soļus tu apstiprini šeit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tafs kunnen een gekoppelde Chrome alleen gebruiken op de sites die een koppeling noemt, en riskante stappen keur je hier goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje tafs mogą używać powiązanego Chrome tylko na stronach, które wskazuje połączenie, a ryzykowne kroki zatwierdzasz tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs só podem usar um Chrome associado nos sites que uma ligação indica, e os passos arriscados são aprovados aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus tafs só podem usar um Chrome associado nos sites que uma conexão indica, e você aprova aqui os passos arriscados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafurile dvs. pot folosi un Chrome asociat doar pe site-urile pe care le listează o conexiune, iar pașii riscanți îi aprobați aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy môžu spárovaný Chrome používať len na weboch, ktoré uvádza pripojenie, a riskantné kroky schvaľujete tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafi lahko seznanjeni Chrome uporabljajo samo na spletnih mestih, ki jih navaja povezava, tvegane korake pa odobrite tukaj."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-i juaj mund ta përdorë një Chrome të çiftuar vetëm në sajtet që rendit një lidhje, dhe hapat e rrezikshëm i miratoni këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš tafs može da koristi upareni Chrome samo na sajtovima koje navodi veza, a rizične korake odobravate ovde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "taf ของคุณใช้ Chrome ที่จับคู่ไว้ได้เฉพาะเว็บไซต์ที่การเชื่อมต่อระบุไว้ และคุณอนุมัติขั้นตอนที่เสี่ยงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs'larınız eşleştirilmiş bir Chrome'u yalnızca bir bağlantının listelediği sitelerde kullanabilir ve riskli adımları burada onaylarsınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tafs của bạn chỉ dùng Chrome đã ghép đôi trên các trang mà một kết nối liệt kê, và bạn phê duyệt các bước rủi ro tại đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 taf 只能在連線所列出的網站上使用已配對的 Chrome，而高風險的步驟由您在這裡核准。"
          }
        }
      }
    },
