            "value": "%1$@ ក្នុងចំណោម %1$@ ពីអ្នក និងអ្នកផ្ញើដែលបានផ្គូផ្គងថ្ងៃនេះ។ ចំនួនលើសត្រូវបានទម្លាក់ រហូតដល់ថ្ងៃស្អែក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 나와 등록된 발신자에게서 %1$@건 중 %1$@건. 내일까지 더 오는 것은 버려집니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ຈາກ %1$@ ຈາກທ່ານ ແລະ ຜູ້ສົ່ງທີ່ຈັບຄູ່ໃນມື້ນີ້. ອັນທີ່ເກີນຖືກຖິ້ມຈົນຮອດມື້ອື່ນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien: %1$@ iš %1$@ – iš jūsų ir susietų siuntėjų. Kitos atmetamos iki rytojaus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "No tevis un pārī savienotajiem sūtītājiem šodien: %1$@ no %1$@. Pārējie līdz rītdienai tiek atmesti."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ од %1$@ од тебе и спарени испраќачи денес. Повеќето се отфрлаат до утре."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өнөөдөр таны болон хослуулсан илгээгчдийн %1$@-аас %1$@. Үлдсэнийг маргааш хүртэл хаяна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आज तपाईं र जोडिएका पठाउनेहरूबाट %1$@ मध्ये %1$@। बाँकी भोलिसम्म छोडिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van %1$@ van jou en gekoppelde afzenders vandaag. Meer worden tot morgen genegeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ z %1$@ od Ciebie i powiązanych nadawców dziś. Kolejne są odrzucane do jutra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %1$@ mensagens suas e de remetentes associados hoje. As seguintes são descartadas até amanhã."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %1$@ mensagens suas e de remetentes associados hoje. As seguintes são descartadas até amanhã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ din %1$@ de la dvs. și de la expeditorii asociați azi. Restul se pierd până mâine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes %1$@ z %1$@ od vás a spárovaných odosielateľov. Ďalšie sa do zajtra zahadzujú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes %1$@ od %1$@ od vas in seznanjenih pošiljateljev. Nadaljnja se do jutri zavržejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nga %1$@ nga ju dhe dërguesit e çiftuar sot. Më shumë hidhen poshtë deri nesër."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ od %1$@ od vas i uparenih pošiljatelja danas. Ostale se odbacuju do sutra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จาก %1$@ จากคุณและผู้ส่งที่จับคู่แล้ววันนี้ ที่เกินจะถูกทิ้งจนถึงพรุ่งนี้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu gün siz we goşalanan iberijiler tarapyndan %1$@-dan %1$@. Has köpüsi ertire çenli taşlanýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün sizden ve eşleştirilmiş gönderenlerden %1$@ / %1$@. Fazlası yarına kadar bırakılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج آپ اور جوڑے گئے بھیجنے والوں کی طرف سے %1$@ میں سے %1$@۔ مزید کل تک چھوڑ دیے جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %1$@ từ bạn và những người gửi đã ghép đôi hôm nay. Phần còn lại bị bỏ cho đến ngày mai."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天來自您和已配對寄件者的有 %1$@ / %1$@。超出的部分會捨棄，直到明天。"
          }
        }
      }
    },
