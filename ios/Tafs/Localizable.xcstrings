      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere eine Version zuerst aus: Du chattest mit ihr unter einer eigenen Card, während die Live-Version weiterarbeitet. Installierst du eine, wird sie zur Live-Version."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a version first: you chat with it under a Card of its own, while the live version keeps working. Installing one makes it the live version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba antes una versión: chateas con ella con una Card propia, mientras la versión activa sigue trabajando. Al instalarla, pasa a ser la versión activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez d'abord une version : vous discutez avec elle sous sa propre Card, pendant que la version en service continue de travailler. L'installer en fait la version en service."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova prima una versione: ci parli in chat con una Card tutta sua, mentre la versione attiva continua a lavorare. Installarla la rende la versione attiva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer eerst een versie uit: je chat ermee onder een eigen Card, terwijl de live versie blijft werken. Installeer je er een, dan wordt dat de live versie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw wypróbuj wersję: rozmawiasz z nią w ramach jej własnej Card, a wersja działająca na żywo pracuje dalej. Instalacja wersji czyni ją wersją działającą na żywo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente primeiro uma versão: conversa com ela ao abrigo de um Card próprio, enquanto a versão em produção continua a trabalhar. Instalar uma torna-a a versão em produção."
          }
        }
      }
    },
