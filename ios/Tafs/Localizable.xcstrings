    "door.key.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, daher kann hier niemand %2$@ Arbeit geben. Alles, was ankommt, klopft an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, so no one here can give %2$@ work. Everything that comes through knocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, así que aquí nadie puede dar trabajo a %2$@. Todo lo que llega es una llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : personne ici ne peut donc donner du travail à %2$@. Tout ce qui arrive est une demande d'accès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, quindi nessuno qui può dare lavoro a %2$@. Tutto ciò che arriva è una bussata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, dus niemand hier kan %2$@ werk geven. Alles wat binnenkomt, klopt aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, więc nikt tutaj nie może zlecać pracy %2$@. Wszystko, co przychodzi, puka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, por isso ninguém aqui pode dar trabalho a %2$@. Tudo o que chega fica como pedido de contacto."
          }
        }
      }
    },
