    "billing.cancel_any_time_least_day": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstənilən vaxt, yenilənmədən ən azı bir gün əvvəl, Apple hesabınızın Abunəliklərində ləğv edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да анулирате по всяко време, поне един ден преди подновяването, в „Абонаменти“ на акаунта си в Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušit můžete kdykoli, nejpozději den před obnovením, v Předplatných svého účtu Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jederzeit kündbar, spätestens einen Tag vor der Verlängerung, unter „Abonnements“ in deinem Apple-Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel any time, at least a day before it renews, in your Apple account's Subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela cuando quieras, al menos un día antes de la renovación, en Suscripciones de tu cuenta de Apple."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühista igal ajal, vähemalt päev enne uuenemist, oma Apple'i konto tellimustes (Subscriptions)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez à tout moment, au moins un jour avant le renouvellement, dans les Abonnements de votre compte Apple."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otkažite bilo kada, najmanje dan prije obnove, u Pretplatama svojeg Apple računa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor lemondhatod, legalább egy nappal a megújulás előtt, az Apple-fiókod Előfizetések részében."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չեղարկեք ցանկացած ժամանակ՝ նորացումից առնվազն մեկ օր առաջ, ձեր Apple հաշվի Բաժանորդագրություններում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan kapan saja, minimal sehari sebelum diperpanjang, di Langganan akun Apple Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla quando vuoi, almeno un giorno prima del rinnovo, negli Abbonamenti del tuo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新の1日前までなら、Apple IDのサブスクリプションでいつでも解約できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გააუქმეთ ნებისმიერ დროს, განახლებამდე მინიმუმ ერთი დღით ადრე, თქვენი Apple ანგარიშის გამოწერებში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갱신 최소 하루 전까지 Apple 계정의 구독에서 언제든지 취소할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atšaukite bet kada, ne vėliau kaip likus dienai iki atnaujinimo, savo Apple paskyros prenumeratose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atcel jebkurā laikā, vismaz dienu pirms atjaunošanas, sava Apple konta sadaļā Abonementi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt altijd opzeggen, minstens een dag voor de verlenging, in Abonnementen van je Apple-account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluj w dowolnym momencie, co najmniej dzień przed odnowieniem, w Subskrypcjach swojego konta Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele quando quiser, pelo menos um dia antes da renovação, nas Subscrições da sua conta Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele quando quiser, pelo menos um dia antes da renovação, em Assinaturas na sua conta Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți anula oricând, cu cel puțin o zi înainte de reînnoire, în Abonamentele contului Apple."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušiť môžete kedykoľvek, najneskôr deň pred obnovením, v Predplatnom svojho účtu Apple."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekličete lahko kadar koli, vsaj dan pred podaljšanjem, v Naročninah svojega računa Apple."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuloni në çdo kohë, të paktën një ditë para se të rinovohet, te Abonimet e llogarisë suaj Apple."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Otkažite bilo kad, najmanje dan pre obnavljanja, u Pretplatama svog Apple naloga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกได้ทุกเมื่ออย่างน้อยหนึ่งวันก่อนต่ออายุ ในการสมัครใช้งานของบัญชี Apple ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenilenmesinden en az bir gün önce, Apple hesabınızın Abonelikler bölümünden istediğiniz zaman iptal edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy bất cứ lúc nào, ít nhất một ngày trước khi gia hạn, trong mục Gói đăng ký của tài khoản Apple của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可隨時取消，請至少在續訂前一天，於您的 Apple 帳號的「訂閱」中取消。"
          }
        }
      }
    },
    "billing.contact_support": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF bu alışı bu hesaba əlavə edə bilmir. Siz onun üçün ödəmisiniz, ona görə support@kiff.dev ünvanında dəstəyə müraciət edin, biz həll edəcəyik."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF не може да добави тази покупка към този акаунт. Платили сте я, затова пишете ни на support@kiff.dev и ще го оправим."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nemůže tento nákup přidat k tomuto účtu. Zaplatili jste za něj, takže napište podpoře na support@kiff.dev a vyřešíme to."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kann diesen Kauf diesem Konto nicht hinzufügen. Du hast dafür bezahlt, also wende dich an support@kiff.dev, und wir klären das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF can't add this purchase to this account. You paid for it, so contact support at support@kiff.dev and we'll sort it out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no puede añadir esta compra a esta cuenta. La pagaste, así que escribe a soporte en support@kiff.dev y lo resolveremos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei saa seda ostu sellele kontole lisada. Sa maksid selle eest, seega kirjuta toele aadressil support@kiff.dev ja me lahendame selle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ne peut pas ajouter cet achat à ce compte. Vous l'avez payé : contactez l'assistance à support@kiff.dev et nous réglerons le problème."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ne može dodati ovu kupnju ovom računu. Platili ste je, pa se obratite podršci na support@kiff.dev i riješit ćemo to."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF nem tudja hozzáadni ezt a vásárlást ehhez a fiókhoz. Kifizetted, ezért írj az ügyfélszolgálatnak: support@kiff.dev, és elrendezzük."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը չի կարող ավելացնել այս գնումը այս հաշվին։ Դուք վճարել եք դրա համար, ուստի դիմեք աջակցությանը՝ support@kiff.dev, և մենք կլուծենք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF tidak dapat menambahkan pembelian ini ke akun ini. Anda sudah membayarnya, jadi hubungi dukungan di support@kiff.dev dan kami akan menyelesaikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non può aggiungere questo acquisto a questo account. L'hai pagato, quindi contatta l'assistenza a support@kiff.dev e lo risolveremo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFはこの購入をこのアカウントに追加できません。お支払い済みですので、support@kiff.devまでお問い合わせください。対応いたします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ს ამ შეძენის ამ ანგარიშზე დამატება არ შეუძლია. თქვენ გადაიხადეთ, ამიტომ მიმართეთ მხარდაჭერას support@kiff.dev-ზე და გადავწყვეტთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 이 구매를 이 계정에 추가할 수 없습니다. 이미 결제하셨으니 support@kiff.dev로 지원팀에 문의해 주시면 해결해 드리겠습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF negali pridėti šio pirkinio prie šios paskyros. Už jį sumokėjote, todėl parašykite pagalbai adresu support@kiff.dev ir mes tai sutvarkysime."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nevar pievienot šo pirkumu šim kontam. Tu par to samaksāji, tāpēc sazinies ar atbalstu: support@kiff.dev, un mēs to atrisināsim."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kan deze aankoop niet aan dit account toevoegen. Je hebt ervoor betaald, dus neem contact op met support via support@kiff.dev en we lossen het op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie może dodać tego zakupu do tego konta. Zapłacono za niego, więc skontaktuj się z pomocą pod adresem support@kiff.dev, a my to rozwiążemy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não consegue adicionar esta compra a esta conta. Pagou por ela, por isso contacte o suporte em support@kiff.dev e resolveremos o assunto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não consegue adicionar esta compra a esta conta. Você pagou por ela, então entre em contato com o suporte em support@kiff.dev e resolveremos isso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nu poate adăuga această achiziție la acest cont. Ați plătit-o, așa că scrieți-ne la support@kiff.dev și rezolvăm."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nemôže tento nákup pridať k tomuto účtu. Zaplatili ste zaň, takže napíšte podpore na support@kiff.dev a vyriešime to."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF tega nakupa ne more dodati temu računu. Plačali ste zanj, zato pišite podpori na support@kiff.dev in uredili bomo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nuk mund ta shtojë këtë blerje në këtë llogari. Ju e keni paguar, ndaj kontaktoni mbështetjen te support@kiff.dev dhe do ta zgjidhim."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ne može da doda ovu kupovinu na ovaj nalog. Platili ste je, pa se obratite podršci na support@kiff.dev i rešićemo to."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF เพิ่มการซื้อนี้ในบัญชีนี้ไม่ได้ คุณชำระเงินแล้ว โปรดติดต่อฝ่ายสนับสนุนที่ support@kiff.dev แล้วเราจะแก้ไขให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF bu satın almayı bu hesaba ekleyemiyor. Ödemeyi yaptınız, bu yüzden support@kiff.dev adresinden destekle iletişime geçin, çözelim."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF không thể thêm giao dịch mua này vào tài khoản này. Bạn đã thanh toán, vì vậy hãy liên hệ bộ phận hỗ trợ tại support@kiff.dev và chúng tôi sẽ giải quyết."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF 無法將此購買加入此帳號。您已完成付款，請聯絡 support@kiff.dev，我們會為您處理。"
          }
        }
      }
    },
    "billing.conversation_goes_plan_tools_being": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söhbət irəlilədikcə plan, qoşulan tətbiqlər və taf-ın Card-ı burada görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "С напредването на разговора тук се показват планът, свързваните приложения и Card на taf."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak rozhovor pokračuje, zobrazuje se tu plán, připojované aplikace a Card tafu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während des Gesprächs erscheinen hier der Plan, die Apps, die verbunden werden, und die Card des tafs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As the conversation goes, the plan, the apps being connected and the taf's Card show here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A medida que avanza la conversación, aquí aparecen el plan, las apps que se conectan y la Card del taf."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vestluse käigus kuvatakse siin plaan, ühendatavad rakendused ja tafi Card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au fil de la conversation, le plan, les apps en cours de connexion et la Card du taf s'affichent ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako razgovor teče, ovdje se prikazuju plan, aplikacije koje se povezuju i Card tafa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszélgetés során itt jelenik meg a terv, a csatlakoztatott alkalmazások és a taf Cardja."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Զրույցի ընթացքում այստեղ երևում են պլանը, միացվող հավելվածները և taf-ի Card-ը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiring percakapan berjalan, paket, aplikasi yang sedang dihubungkan, dan Card taf muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Man mano che la conversazione procede, qui compaiono il piano, le app da collegare e la Card del taf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話が進むにつれて、プラン、接続中のアプリ、tafのCardがここに表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "საუბრის მიმდინარეობისას აქ ჩანს გეგმა, დასაკავშირებელი აპები და taf-ის Card."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화가 진행되면서 계획, 연결 중인 앱, taf의 Card가 여기에 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokalbiui vykstant, čia rodomas planas, jungiamos programėlės ir taf Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarunas gaitā šeit parādās plāns, pievienojamās lietotnes un taf Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naarmate het gesprek vordert, verschijnen hier het plan, de apps die worden gekoppeld en de Card van het taf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W miarę rozmowy pojawią się tu plan, łączone aplikacje i Card tafa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "À medida que a conversa avança, o plano, as apps a ligar e o Card do taf aparecem aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À medida que a conversa avança, o plano, os apps a conectar e o Card do taf aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe măsură ce conversația avansează, aici apar planul, aplicațiile care se conectează și Cardul tafului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako rozhovor pokračuje, zobrazuje sa tu plán, pripájané aplikácie a Card tafu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med pogovorom se tu prikažejo načrt, aplikacije, ki se povezujejo, in Card tafa."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjatë bisedës, plani, aplikacionet që po lidhen dhe Card-i i taf-it shfaqen këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako razgovor teče, ovde se prikazuju plan, aplikacije koje se povezuju i Card tafa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อการสนทนาดำเนินไป แพ็กเกจ แอปที่กำลังเชื่อมต่อ และ Card ของ taf จะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet ilerledikçe plan, bağlanan uygulamalar ve taf'ın Card'ı burada görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi cuộc trò chuyện tiến triển, gói, các ứng dụng đang được kết nối và Card của taf hiện ở đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨著對話進行，方案、正在連接的 App 以及 taf 的 Card 會顯示在這裡。"
          }
        }
      }
    },
