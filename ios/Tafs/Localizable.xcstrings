    "watch.inbox_empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا جديد. تصل هنا ردود Coach وتنبيهات tafs لديك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni heç nə yoxdur. Coach-un cavabları və taf-larınızın bildirişləri burada görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо ново. Отговорите на Coach и известията от вашите tafs идват тук."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন কিছু নেই। Coach-এর উত্তর ও আপনার taf-এর অ্যালার্ট এখানে আসে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha res de nou. Les respostes de Coach i les alertes dels teus taf arriben aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nového. Sem chodí odpovědi Coache a upozornění vašich tafů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Neues. Hier landen die Antworten von Coach und die Hinweise deiner tafs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing new. Coach's replies and your tafs' alerts land here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada nuevo. Aquí llegan las respuestas de Coach y los avisos de tus tafs."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi uut pole. Siia jõuavad Coachi vastused ja sinu tafide teavitused."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau. Les réponses de Coach et les alertes de vos tafs arrivent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חדש. התשובות של Coach וההתראות של ה-taf שלך מגיעות לכאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ नया नहीं। Coach के उत्तर और आपके taf के अलर्ट यहाँ आते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa novo. Ovdje stižu Coachovi odgovori i obavijesti vaših tafova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs semmi új. A Coach válaszai és a tafjaid riasztásai ide érkeznek."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նոր ոչինչ չկա։ Coach-ի պատասխանները և ձեր taf-երի ծանուցումները հայտնվում են այստեղ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang baru. Balasan Coach dan peringatan tafs Anda masuk di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di nuovo. Qui arrivano le risposte di Coach e gli avvisi dei tuoi tafs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新着はありません。Coachの返信とtafの通知がここに届きます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახალი არაფერია. Coach-ის პასუხები და თქვენი taf-ების შეტყობინებები აქ ჩნდება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានអ្វីថ្មីទេ។ ចម្លើយរបស់ Coach និងការជូនដំណឹងពី taf របស់អ្នកមកដល់ទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 항목이 없습니다. Coach의 답장과 taf의 알림이 여기에 표시됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ມີຫຍັງໃໝ່. ຄຳຕອບຂອງ Coach ແລະ ການແຈ້ງເຕືອນຈາກ taf ຂອງທ່ານມາຮອດບ່ອນນີ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieko naujo. Čia patenka Coach atsakymai ir jūsų taf pranešimai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekā jauna. Šeit nonāk Coach atbildes un tavu taf paziņojumi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нема ништо ново. Одговорите на Coach и известувањата од твоите tafови пристигнуваат тука."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэ зүйл алга. Coach-ийн хариу болон таны taf-уудын мэдэгдэл энд ирнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "केही नयाँ छैन। Coach का जवाफ र तपाईंका taf का सूचना यहाँ आइपुग्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets nieuws. Hier komen de antwoorden van Coach en de meldingen van je tafs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nowego. Tu trafiają odpowiedzi Coacha i alerty Twoich tafs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de novo. As respostas do Coach e os alertas dos seus tafs chegam aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de novo. As respostas do Coach e os alertas dos seus tafs chegam aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nou. Răspunsurile lui Coach și alertele tafurilor ajung aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič nové. Sem chodia odpovede Coacha a upozornenia vašich tafov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič novega. Sem pridejo odgovori Coacha in opozorila vaših tafov."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Asgjë e re. Përgjigjet e Coach dhe njoftimet e tafs-eve tuaj vijnë këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa novo. Ovdje stižu Coachovi odgovori i obaveštenja vaših tafova."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรใหม่ คำตอบของ Coach และการแจ้งเตือนจาก taf ของคุณจะมาที่นี่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Täze zat ýok. Coach-yň jogaplary we tafs-laryňyzyň duýduryşlary şu ýere düşýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir şey yok. Coach'un yanıtları ve tafs'larınızın uyarıları buraya düşer."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ نیا نہیں۔ Coach کے جوابات اور آپ کے tafs کے الرٹس یہاں آتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì mới. Phản hồi của Coach và thông báo từ các taf của bạn sẽ đến đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有新內容。Coach 的回覆和您的 taf 的通知會顯示在這裡。"
          }
        }
      }
    },
