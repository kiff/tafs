    "connect.kiff_words_connection_could_not": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-in bu qoşulma üçün sözləri oxuna bilmədi. Heç nə təsdiqlənmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстът на KIFF за тази връзка не можа да бъде прочетен. Нищо не беше одобрено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slova KIFF k tomuto připojení se nepodařilo načíst. Nic se neschválilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFs Worte zu dieser Verbindung konnten nicht gelesen werden. Es wurde nichts genehmigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF's words for this connection couldn't be read. Nothing was approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer las palabras de KIFF para esta conexión. No se aprobó nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFi sõnu selle ühenduse kohta ei õnnestunud lugeda. Midagi ei kinnitatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les textes de KIFF pour cette connexion n'ont pas pu être lus. Rien n'a été approuvé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ove riječi za ovu vezu nije bilo moguće pročitati. Ništa nije odobreno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF szövegét ehhez a kapcsolathoz nem sikerült beolvasni. Semmi sem lett jóváhagyva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ի բառերը այս կապի համար չկարողացան կարդացվել։ Ոչինչ չհաստատվեց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata KIFF untuk koneksi ini tidak dapat dibaca. Tidak ada yang disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere le parole di KIFF per questo collegamento. Non è stato approvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続に関するKIFFの説明を読み込めませんでした。何も承認されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ის სიტყვები ამ კავშირისთვის ვერ წაიკითხა. არაფერი დამტკიცებულა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에 대한 KIFF의 설명을 읽지 못했습니다. 승인된 것은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko nuskaityti KIFF formuluotės šiam ryšiui. Niekas nepatvirtinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formulējumu šim savienojumam nevarēja nolasīt. Nekas netika apstiprināts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woorden van KIFF voor deze koppeling konden niet worden gelezen. Er is niets goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać opisu KIFF dla tego połączenia. Nic nie zostało zatwierdzone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as palavras do KIFF para esta ligação. Nada foi aprovado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as palavras do KIFF para esta conexão. Nada foi aprovado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul KIFF pentru această conexiune nu a putut fi citit. Nu s-a aprobat nimic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slová KIFF k tomuto pripojeniu sa nepodarilo načítať. Nič sa neschválilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besed KIFF za to povezavo ni bilo mogoče prebrati. Nič ni bilo odobreno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjalët e KIFF për këtë lidhje nuk u lexuan dot. Asgjë nuk u miratua."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ove reči za ovu vezu nije bilo moguće pročitati. Ništa nije odobreno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านถ้อยคำของ KIFF สำหรับการเชื่อมต่อนี้ไม่ได้ ยังไม่ได้อนุมัติอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF'in bu bağlantı için sözleri okunamadı. Hiçbir şey onaylanmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc lời của KIFF cho kết nối này. Chưa phê duyệt gì."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 KIFF 針對此連線的文字。未核准任何項目。"
          }
        }
      }
