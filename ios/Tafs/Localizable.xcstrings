    "alert.alerts_almost_tafs_cloud_did": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişlər demək olar ki, aktivdir: tafs cloud cavab vermədi (%1$@). «Bildirişləri aktiv edin» düyməsinə yenidən toxunun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Известията са почти включени: tafs cloud не отговори (%1$@). Докоснете отново „Включване на известията“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění jsou skoro zapnutá: tafs cloud neodpověděl (%1$@). Klepněte znovu na Zapnout upozornění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind fast an: tafs cloud hat nicht geantwortet (%1$@). Tippe erneut auf „Benachrichtigungen einschalten“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts are almost on: tafs cloud didn't answer (%1$@). Tap Turn on alerts again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas están casi activadas: tafs cloud no respondió (%1$@). Toca Activar alertas otra vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teavitused on peaaegu sees: tafs cloud ei vastanud (%1$@). Puuduta uuesti Lülita teavitused sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sont presque activées : tafs cloud n'a pas répondu (%1$@). Touchez à nouveau Activer les alertes."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su skoro uključene: tafs cloud nije odgovorio (%1$@). Ponovno dodirnite Uključite obavijesti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések majdnem be vannak kapcsolva: a tafs cloud nem válaszolt (%1$@). Koppints újra az Értesítések bekapcsolása gombra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծանուցումները գրեթե միացված են․ tafs cloud-ը չպատասխանեց (%1$@). Նորից հպեք «Միացնել ծանուցումները»։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan hampir aktif: tafs cloud tidak menjawab (%1$@). Ketuk Aktifkan peringatan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi sono quasi attivi: tafs cloud non ha risposto (%1$@). Tocca di nuovo Attiva avvisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知はほぼオンです：tafsクラウドが応答しませんでした（%1$@）。もう一度「通知をオンにする」をタップしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეტყობინებები თითქმის ჩართულია: tafs cloud-მა არ უპასუხა (%1$@). კვლავ შეეხეთ „შეტყობინებების ჩართვას“."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 거의 켜졌습니다. tafs 클라우드가 응답하지 않았습니다(%1$@). 알림 켜기를 다시 탭하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pranešimai beveik įjungti: tafs cloud neatsakė (%1$@). Dar kartą palieskite „Įjungti pranešimus“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paziņojumi ir gandrīz ieslēgti: tafs cloud neatbildēja (%1$@). Vēlreiz pieskaries “Ieslēgt paziņojumus”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan bijna aan: tafs cloud antwoordde niet (%1$@). Tik nogmaals op Meldingen aanzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty są prawie włączone: tafs cloud nie odpowiedział (%1$@). Dotknij ponownie Włącz alerty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas estão quase ativos: o tafs cloud não respondeu (%1$@). Toque novamente em Ativar alertas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas estão quase ativos: o tafs cloud não respondeu (%1$@). Toque novamente em Ativar alertas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertele sunt aproape activate: tafs cloud nu a răspuns (%1$@). Atingeți din nou Activați alertele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenia sú takmer zapnuté: tafs cloud neodpovedal (%1$@). Ťuknite znova na Zapnúť upozornenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opozorila so skoraj vklopljena: tafs cloud ni odgovoril (%1$@). Znova tapnite Vklopi opozorila."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Njoftimet janë gati të aktivizohen: tafs cloud nuk u përgjigj (%1$@). Prekni sërish Aktivizoni njoftimet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Obaveštenja su skoro uključena: tafs cloud nije odgovorio (%1$@). Ponovo dodirnite Uključite obaveštenja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนใกล้พร้อมแล้ว: tafs cloud ไม่ตอบ (%1$@) แตะเปิดการแจ้งเตือนอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarılar neredeyse açık: tafs cloud yanıt vermedi (%1$@). Uyarıları aç'a tekrar dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo sắp bật: tafs cloud không trả lời (%1$@). Hãy chạm Bật thông báo lần nữa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
