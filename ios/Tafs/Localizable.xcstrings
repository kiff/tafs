        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծանուցումները գրեթե միացված են․ tafs cloud-ը չպատասխանեց (%1$@). Նորից հպեք «Միացնել ծանուցումները»։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan hampir aktif: tafs cloud tidak menjawab (%1$@). Ketuk Aktifkan peringatan lagi."
