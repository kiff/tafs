    "door.api.shown_once_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخه إلى أسرار %1$@. لا يحتفظ tafs بنسخة يستطيع عرضها مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onu %1$@ tətbiqinin gizli məlumatlarına kopyalayın. tafs yenidən göstərə biləcəyi nüsxə saxlamır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирайте го в тайните на %1$@. tafs не пази копие, което да може да покаже отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি %1$@-এর গোপন তথ্যে কপি করুন। tafs এমন কোনো কপি রাখে না যা আবার দেখাতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia-la als secrets de %1$@. tafs no en guarda cap còpia que pugui tornar a mostrar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírujte ho do tajných údajů aplikace %1$@. tafs si nenechává kopii, kterou by mohl zobrazit znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere ihn in die Secrets von %1$@. tafs behält keine Kopie, die es noch einmal zeigen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy it into %2$@ secrets. tafs keeps no copy it can show again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópiala en los secretos de %1$@. tafs no guarda ninguna copia que pueda volver a mostrar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopeeri see rakenduse %1$@ saladustesse. tafs ei hoia koopiat, mida saaks uuesti näidata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez-la dans les secrets de %1$@. tafs n'en garde aucune copie qu'il puisse afficher à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להעתיק אותו אל הסודות של %1$@. tafs לא שומר עותק שהוא יכול להציג שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे %1$@ के सीक्रेट में कॉपी करें। tafs कोई ऐसी प्रति नहीं रखता जिसे फिर दिखा सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopirajte ga u tajne aplikacije %1$@. tafs ne čuva kopiju koju bi mogao ponovno prikazati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másold be a(z) %1$@ titkai közé. A tafs nem őriz meg olyan másolatot, amelyet újra megjeleníthetne."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատճենեք %1$@-ի գաղտնիքներում։ tafs-ը չի պահում պատճեն, որը կարող էր նորից ցույց տալ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin ke rahasia %1$@. tafs tidak menyimpan salinan yang dapat ditampilkannya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiala nei segreti di %1$@. tafs non ne tiene alcuna copia da mostrare di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のシークレットにコピーしてください。tafsは再表示できるコピーを保持しません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დააკოპირეთ %1$@-ის საიდუმლოებებში. tafs არ ინახავს ასლს, რომელიც ხელახლა შეეძლოს ეჩვენებინა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចម្លងវាទៅក្នុងអាថ៌កំបាំងរបស់ %1$@។ tafs មិនរក្សាច្បាប់ចម្លងដែលវាអាចបង្ហាញម្តងទៀតទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 비밀 정보에 복사하세요. tafs는 다시 보여 줄 사본을 보관하지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສຳເນົາມັນໃສ່ຄວາມລັບຂອງ %1$@. tafs ບໍ່ເກັບສຳເນົາທີ່ສະແດງອີກໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nukopijuokite jį į %1$@ slaptųjų reikšmių saugyklą. tafs nesaugo kopijos, kurią galėtų parodyti dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nokopē to %1$@ slepenajos datos. tafs neglabā kopiju, ko varētu parādīt vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирај го во тајните на %1$@. tafs не чува копија што може повторно да ја прикаже."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үүнийг %1$@-ын нууцууд руу хуулна уу. tafs дахин харуулах хуулбар хадгалдаггүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसलाई %1$@ का गोप्य कुराहरूमा प्रतिलिपि गर्नुहोस्। tafs ले फेरि देखाउन सक्ने प्रतिलिपि राख्दैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer hem naar de secrets van %1$@. tafs bewaart geen kopie die het nog eens kan tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj go do sekretów aplikacji %1$@. tafs nie zachowuje kopii, którą mógłby pokazać ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie-a para os segredos de %1$@. O tafs não guarda nenhuma cópia que possa voltar a mostrar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie-a para os segredos de %1$@. O tafs não guarda nenhuma cópia que possa voltar a mostrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiați-o în secretele %1$@. tafs nu păstrează nicio copie pe care să o poată afișa din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopírujte ho do tajných údajov aplikácie %1$@. tafs si nenecháva kópiu, ktorú by mohol zobraziť znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopirajte ga med skrivnosti aplikacije %1$@. tafs ne hrani kopije, ki bi jo lahko znova prikazal."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopjojeni te të fshehtat e: %1$@. tafs nuk mban kopje që mund ta shfaqë sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopirajte ga u tajne aplikacije %1$@. tafs ne čuva kopiju koju bi mogao ponovo prikazati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกไปไว้ในความลับของ %1$@ tafs ไม่เก็บสำเนาที่แสดงซ้ำได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ony %1$@ gizlinliklerine göçüriň. tafs täzeden görkezip biljek nusga saklamaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ uygulamasının gizli bilgilerine kopyalayın. tafs, tekrar gösterebileceği bir kopya tutmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے %1$@ کے رازوں میں کاپی کریں۔ tafs اس کی کوئی کاپی نہیں رکھتا جو دوبارہ دکھا سکے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy sao chép nó vào các bí mật của %1$@. tafs không giữ bản sao nào để hiện lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將它拷貝到 %1$@ 的機密設定中。tafs 不會保留可再次顯示的副本。"
          }
        }
      }
    },
