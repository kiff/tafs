        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Návrh, kým ho v rozhovore neschválite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osnutek, dokler ga ne odobrite v pogovoru."
