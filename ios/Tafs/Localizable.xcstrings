    "door.knock.rest_keys|few": {
      "extractionState": "manual",
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien šios durys jau gavo visas leidžiamas jūsų ir susietų siuntėjų žinutes. Dar %1$@ atmestos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
