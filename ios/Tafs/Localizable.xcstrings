        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon nonaktif untuk tafs. Aktifkan di Pengaturan › tafs › Mikrofon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è disattivato per tafs. Attivalo in Impostazioni › tafs › Microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsのマイクがオフになっています。設定 › tafs › マイクでオンにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიკროფონი გამორთულია tafs-ისთვის. ჩართეთ პარამეტრები › tafs › მიკროფონი."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs의 마이크가 꺼져 있습니다. 설정 › tafs › 마이크에서 켜세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonas programėlei tafs išjungtas. Įjunkite jį skiltyje Nustatymai › tafs › Mikrofonas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofons lietotnei tafs ir izslēgts. Ieslēdz to sadaļā Iestatījumi › tafs › Mikrofons."
