        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը չի կարող ավելացնել այս գնումը այս հաշվին։ Դուք վճարել եք դրա համար, ուստի դիմեք աջակցությանը՝ support@kiff.dev, և մենք կլուծենք։"
