    "approval.security_key.unplugged": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sicherheitsschlüssel wurde abgezogen, also wurde nichts genehmigt. Die Anfrage bleibt erhalten: Genehmige erneut, wenn du so weit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The security key was unplugged, so nothing was approved. The request is kept: approve again when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llave de seguridad se desconectó, así que no se aprobó nada. La solicitud se conserva: vuelve a aprobar cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Turvavõti eemaldati, seega midagi ei kinnitatud. Päring jääb alles: kinnita uuesti, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de sécurité a été débranchée : rien n'a été approuvé. La demande est conservée : approuvez à nouveau quand vous êtes prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di sicurezza è stata scollegata, quindi non è stato approvato nulla. La richiesta resta: approva di nuovo quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティキーが抜かれたため、何も承認されていません。リクエストは保持されています。準備ができたらもう一度承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 키가 뽑혀 승인된 것은 없습니다. 요청은 남아 있으니 준비되면 다시 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saugos raktas atjungtas, todėl niekas nepatvirtinta. Užklausa išsaugota: patvirtinkite dar kartą, kai būsite pasirengę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drošības atslēga tika atvienota, tāpēc nekas netika apstiprināts. Pieprasījums ir saglabāts: apstiprini vēlreiz, kad esi gatavs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beveiligingssleutel is eruit gehaald, dus er is niets goedgekeurd. Het verzoek blijft bewaard: keur het goed wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz bezpieczeństwa został odłączony, więc nic nie zostało zatwierdzone. Prośba zostaje zachowana: zatwierdź ją ponownie, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança foi desligada, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança foi desconectada, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        }
      }
    },
