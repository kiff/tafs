    "connect.apps.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adda tətbiq yoxdur. Coach siyahıda olmayan tətbiqi qoşa bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма приложение с това име. Coach може да свърже такова, което не е в списъка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná aplikace s tímto názvem. Coach umí připojit i takovou, která tu není."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App mit diesem Namen. Coach kann eine verbinden, die nicht aufgeführt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app by that name. Coach can connect one that isn't listed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna app con ese nombre. Coach puede conectar una que no esté en la lista."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellise nimega rakendust pole. Coach saab ühendada rakenduse, mida loendis pole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app de ce nom. Coach peut en connecter une qui n'est pas listée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema aplikacije s tim nazivom. Coach može povezati onu koje nema na popisu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs ilyen nevű alkalmazás. A Coach csatlakoztathat olyat is, amely nincs a listán."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այդ անունով հավելված չկա։ Coach-ը կարող է միացնել այնպիսին, որը ցանկում չէ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada aplikasi dengan nama itu. Coach dapat menghubungkan yang tidak ada di daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna app con quel nome. Coach può collegarne una che non è in elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前のアプリはありません。一覧にないアプリはCoachが接続できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ სახელით აპი არ არის. Coach-ს შეუძლია დააკავშიროს ისეთი, რომელიც სიაში არ არის."
          }
        },
        "ko": {
