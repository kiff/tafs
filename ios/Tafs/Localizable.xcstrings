        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@への新しい窓口を開く"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გახსენით ახალი კარი %1$@-ისთვის"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើកទ្វារថ្មីទៅ %1$@"
          }
        },
        "ko": {
