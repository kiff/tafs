          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 %1$@을(를) 쓰는 taf가 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabar joks taf nenaudoja %1$@."
          }
        },
        "lv": {
