    "version.out_of_date_card": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر ما يُطلب منك الموافقة عليه منذ عرضه. اقرأه مرة أخرى ثم وافق."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təsdiq etməyiniz istənilən şey göstərildikdən sonra dəyişib. Onu yenidən oxuyun, sonra təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това, което трябва да одобрите, се промени, откакто беше показано. Прочетете го отново и одобрете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে যা অনুমোদন করতে বলা হচ্ছে তা দেখানোর পর বদলেছে। আবার পড়ুন, তারপর অনুমোদন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El que et demanen aprovar ha canviat des que es va mostrar. Torna-ho a llegir i després aprova."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co máte schválit, se změnilo od chvíle, kdy se to zobrazilo. Přečtěte si to znovu a schvalte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du genehmigen sollst, hat sich geändert, seit es angezeigt wurde. Lies es erneut und genehmige dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you're asked to approve changed since it was shown. Read it again, then approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se te pide aprobar cambió desde que se mostró. Vuelve a leerlo y luego aprueba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See, mida sul palutakse kinnitada, on pärast näitamist muutunud. Loe see uuesti läbi ja kinnita siis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l'on vous demande d'approuver a changé depuis son affichage. Relisez-le, puis approuvez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה שמבקשים ממך לאשר השתנה מאז שהוצג. יש לקרוא אותו שוב ואז לאשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसे मंज़ूर करने को कहा गया वह दिखाए जाने के बाद बदल गया। इसे फिर पढ़ें, फिर मंज़ूर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ono što se traži da odobrite promijenilo se otkako je prikazano. Pročitajte ponovno, pa odobrite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az, amit jóvá kell hagynod, megváltozott, amióta megjelent. Olvasd el újra, majd hagyd jóvá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն, ինչ խնդրվում է հաստատել, փոխվել է ցուցադրվելուց հետո։ Կարդացեք նորից, ապա հաստատեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang diminta untuk Anda setujui berubah sejak ditampilkan. Baca lagi, lalu setujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che ti viene chiesto di approvare è cambiato da quando è stato mostrato. Rileggilo, poi approva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認を求められている内容は、表示後に変更されました。もう一度確認してから承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რასაც დასამტკიცებლად გთავაზობენ, ნაჩვენები იყო მას შემდეგ შეიცვალა. წაიკითხეთ ხელახლა, შემდეგ დაამტკიცეთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីដែលអ្នកត្រូវបានស្នើឱ្យអនុម័តបានផ្លាស់ប្តូរតាំងពីវាត្រូវបានបង្ហាញ។ អានវាម្តងទៀត រួចអនុម័ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 요청 내용이 표시된 뒤로 바뀌었습니다. 다시 읽고 승인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສິ່ງທີ່ທ່ານຖືກຂໍໃຫ້ອະນຸມັດປ່ຽນໄປຕັ້ງແຕ່ມັນຖືກສະແດງ. ອ່ານອີກ ແລ້ວອະນຸມັດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai, ką prašoma patvirtinti, pasikeitė nuo tada, kai buvo parodyta. Perskaitykite dar kartą, tada patvirtinkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas, ko tev lūdz apstiprināt, mainījās, kopš tas tika parādīts. Izlasi to vēlreiz, tad apstiprini."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Она што се бара да го одобриш се промени откако беше прикажано. Прочитај го повторно, па одобри."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таныг зөвшөөрөхийг хүссэн зүйл харуулснаас хойш өөрчлөгдсөн. Дахин уншаад зөвшөөрнө үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंलाई स्वीकृत गर्न भनिएको कुरा देखाइएपछि परिवर्तन भयो। फेरि पढ्नुहोस्, अनि स्वीकृत गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je moet goedkeuren, is gewijzigd sinds het werd getoond. Lees het opnieuw en keur het dan goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co masz zatwierdzić, zmieniło się od chwili pokazania. Przeczytaj to ponownie, a potem zatwierdź."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que lhe pedem para aprovar mudou desde que foi mostrado. Leia-o novamente e depois aprove."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que lhe pedem para aprovar mudou desde que foi mostrado. Leia-o novamente e depois aprove."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce vi se cere să aprobați s-a schimbat de când a fost afișat. Citiți din nou, apoi aprobați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "To, čo máte schváliť, sa zmenilo od chvíle, keď sa to zobrazilo. Prečítajte si to znova a schváľte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kar morate odobriti, se je spremenilo, odkar je bilo prikazano. Preberite znova, nato odobrite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajo që kërkohet të miratoni ndryshoi që kur u shfaq. Lexojeni sërish, pastaj miratoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ono šta se traži da odobrite promenilo se otkako je prikazano. Pročitajte ponovo, pa odobrite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คุณถูกขอให้อนุมัติเปลี่ยนไปนับตั้งแต่ที่แสดง อ่านอีกครั้ง แล้วอนุมัติ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tassyklamagyňyz soralýan zat görkezilenden soň üýtgedi. Ony täzeden okaň, soňra tassyklaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamanız istenen şey gösterildiğinden beri değişti. Tekrar okuyun, sonra onaylayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ سے جو منظور کرنے کو کہا گیا وہ دکھائے جانے کے بعد بدل گیا۔ اسے دوبارہ پڑھیں، پھر منظور کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều bạn được yêu cầu phê duyệt đã thay đổi kể từ khi nó được hiện. Hãy đọc lại, rồi phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要請您核准的內容，自顯示以來已變更。請重新閱讀，然後核准。"
          }
        }
      }
    },
