    "taf.works_from_chat": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz söyləyəndə, söhbətində işləyir: onu heç bir cədvəl işlətmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Работи, когато му кажете, в чата си: никакъв график не го стартира."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracuje, když mu to řeknete, v jeho chatu: žádný plán ho nespouští."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er arbeitet, wenn du es ihm in seinem Chat sagst: Kein Zeitplan führt ihn aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It works when you tell it, in its chat: no schedule runs it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja cuando se lo dices, en su chat: ninguna programación lo ejecuta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See töötab siis, kui ütled seda selle vestluses: ükski ajakava seda ei käivita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il travaille quand vous le lui demandez, dans son chat : aucun planning ne le lance."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radi kad mu kažete, u njegovu razgovoru: nijedan ga raspored ne pokreće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkor dolgozik, amikor szólsz neki, a csevegésében: nem ütemezés futtatja."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Աշխատում է, երբ ասում եք նրա զրույցում․ ոչ մի ժամանակացույց այն չի գործարկում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekerja saat Anda memintanya, di obrolannya: tidak ada jadwal yang menjalankannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavora quando glielo dici, nella sua chat: nessuna pianificazione lo avvia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットで指示したときに動きます。スケジュールでは実行されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ის მუშაობს, როცა მის ჩატში ეტყვით: არც ერთი განრიგი არ უშვებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅에서 말할 때 작동합니다. 일정으로 실행되지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jis dirba, kai liepiate jam pokalbyje: jo nepaleidžia joks tvarkaraštis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas strādā, kad tu to pasaki tā sarunā: neviens grafiks to nepalaiž."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het werkt als je het zegt, in de chat: geen planning start het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa, gdy mu powiesz, w swoim czacie: żaden harmonogram go nie uruchamia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalha quando lhe diz, no seu chat: nenhum agendamento o executa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalha quando lhe diz, no seu chat: nenhum agendamento o executa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucrează când îi spuneți, în conversația sa: niciun program nu îl rulează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracuje, keď mu to poviete, v jeho chate: žiadny plán ho nespúšťa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela, ko mu poveste, v njegovem klepetu: noben urnik ga ne zažene."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Punon kur ia thoni, në bisedën e tij: asnjë orar nuk e ekzekuton."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Radi kad mu kažete, u njegovu razgovoru: nijedan ga raspored ne pokreće."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันทำงานเมื่อคุณบอก ในแชตของมัน: ไม่มีกำหนดการใดเรียกมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz söylediğinizde, sohbetinde çalışır: onu çalıştıran bir zamanlama yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó làm việc khi bạn bảo, trong cuộc trò chuyện của nó: không có lịch nào chạy nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它在您於它的對話中告訴它時運作：沒有排程會執行它。"
          }
        }
      }
    },
