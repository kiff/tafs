            "value": "A conexão de apps não está configurada para esta conta a partir deste telefone. Abra o Coach para a iniciar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarea aplicațiilor nu este configurată pentru acest cont de pe acest telefon. Deschideți Coach pentru a o porni."
          }
        },
        "sk": {
          "stringUnit": {
