    "connect.no_confirmation_code": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاد تسجيل الدخول في %1$@ بدون رمز التأكيد. لم يُربط شيء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ saytındakı giriş təsdiq kodu olmadan qayıtdı. Heç nə qoşulmadı."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Входът в %1$@ се върна без код за потвърждение. Нищо не беше свързано."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-এ সাইন-ইন নিশ্চিতকরণ কোড ছাড়াই ফিরে এসেছে। কিছু সংযুক্ত হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inici de sessió a %1$@ ha tornat sense el codi de confirmació. No s'ha connectat res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení u %1$@ se vrátilo bez potvrzovacího kódu. Nic se nepřipojilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung bei %1$@ kam ohne Bestätigungscode zurück. Es wurde nichts verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in at %1$@ came back without its confirmation code. Nothing was connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión en %1$@ volvió sin su código de confirmación. No se conectó nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisselogimine teenuses %1$@ tuli tagasi ilma kinnituskoodita. Midagi ei ühendatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à %1$@ est revenue sans son code de confirmation. Rien n'a été connecté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכניסה ל-%1$@ חזרה בלי קוד האישור שלה. שום דבר לא חובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ का साइन-इन अपने पुष्टि कोड के बिना लौटा। कुछ नहीं जुड़ा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava kod aplikacije %1$@ vratila se bez potvrdnog koda. Ništa nije povezano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejelentkezés itt (%1$@) megerősítő kód nélkül tért vissza. Semmi sem lett csatlakoztatva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքը %1$@-ում վերադարձավ առանց հաստատման կոդի։ Ոչինչ չմիացվեց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses masuk di %1$@ kembali tanpa kode konfirmasinya. Tidak ada yang terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso su %1$@ è tornato senza il codice di conferma. Non è stato collegato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@でのサインインが確認コードなしで戻ってきました。何も接続されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შესვლა %1$@-ში დადასტურების კოდის გარეშე დაბრუნდა. არაფერი დაკავშირებულა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចូលនៅ %1$@ បានត្រឡប់មកដោយគ្មានលេខកូដបញ្ជាក់។ គ្មានអ្វីត្រូវបានភ្ជាប់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 로그인이 확인 코드 없이 돌아왔습니다. 연결된 것은 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການເຂົ້າສູ່ລະບົບທີ່ %1$@ ກັບມາໂດຍບໍ່ມີລະຫັດຢືນຢັນ. ບໍ່ໄດ້ເຊື່ອມຕໍ່ຫຍັງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijungimas prie %1$@ grįžo be patvirtinimo kodo. Niekas neprijungta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
