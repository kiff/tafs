        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Versija %1$@ kļūst par darbā esošo versiju ar savu Card. Šī saruna tiek dzēsta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
