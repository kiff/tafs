    "record.extra_room_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حصلت Card الخاصة به على المساحة لهذا الإجمالي، حتى يُعاد ضبطه. وإن تجاوز أيضًا حد الاستدعاء الواحد، يُعلَّق الاستدعاء مرة أخرى بسبب ذلك"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-ı bu cəm üçün yeri aldı, o sıfırlanana qədər. Bir çağırış limitini də aşırsa, çağırış bunun üçün yenidən saxlanılır"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Неговата Card получи лимита за този общ лимит, докато не се нулира. Ако е и над лимита за една заявка, заявката се задържа отново заради това"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর Card এই মোটের জন্য জায়গা পেয়েছে, রিসেট না হওয়া পর্যন্ত। এক কলের সীমাও ছাড়ালে, কলটি সেজন্য আবার ধরে রাখা হয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El seu Card ha rebut el marge per a aquest total, fins que es reiniciï. Si també supera un límit per a una crida, la crida es reté de nou per això"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho Card dostala prostor pro tento celkový limit, dokud se nevynuluje. Pokud je volání i přes limit na jedno volání, znovu se kvůli tomu zadrží"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Card hat den Spielraum für diese Summe bekommen, bis sie zurückgesetzt wird. Liegt der Aufruf auch über einem Limit für einen Aufruf, wird er dafür erneut zurückgehalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its Card got the room for this total, until it resets. Over a limit for one call as well, the call is held again for that"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su Card obtuvo el margen para este total, hasta que se reinicie. Si también supera un límite por llamada, la llamada vuelve a quedar retenida por eso"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle Card sai selle kogusumma jaoks ruumi, kuni see lähtestub. Kui see ületab ka ühe päringu limiidi, peetakse päring selle tõttu uuesti kinni"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Card a obtenu la marge pour ce total, jusqu'à sa remise à zéro. Si l'appel dépasse aussi une limite pour un appel, il est à nouveau retenu pour celle-ci"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Card שלו קיבל את המקום לסכום הכולל הזה, עד שיתאפס. אם הקריאה חורגת גם ממגבלה לקריאה אחת, היא מוחזקת שוב בגללה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसके Card को इस कुल के लिए, रीसेट होने तक, जगह मिली। एक कॉल की सीमा से भी ऊपर हो, तो कॉल उसके लिए फिर रोकी जाती है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegov je Card dobio prostor za ovaj ukupni iznos, do ponovnog postavljanja. Ako je i iznad ograničenja za jedan poziv, poziv se zbog toga ponovno zadržava"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cardja megkapta a keretet ehhez az összesítőhöz, amíg le nem nullázódik. Ha az egy hívásra szóló limitet is túllépi, a hívás emiatt újra vissza lesz tartva"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրա Card-ը ստացավ տարածք այս ընդհանուրի համար, մինչև վերակայումը։ Եթե գերազանցում է նաև մեկ զանգի սահմանաչափը, զանգը նորից պահվում է դրա համար"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-nya mendapat ruang untuk total ini, sampai diatur ulang. Jika juga melebihi batas satu panggilan, panggilan itu ditahan lagi karenanya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua Card ha ricevuto il margine per questo totale, finché non si azzera. Se supera anche un limite per singola chiamata, la chiamata viene trattenuta di nuovo per quello"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計がリセットされるまで、この合計の枠がCardに追加されました。1回の呼び出しの上限も超える場合は、そのために再び保留されます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისმა Card-მა მიიღო სივრცე ამ ჯამისთვის, განულებამდე. თუ ერთ ზარზე ლიმიტსაც აღემატება, ზარი ხელახლა იკავება ამის გამო"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Card របស់វាបានទទួលកន្លែងសម្រាប់សរុបនេះ រហូតដល់វាកំណត់ឡើងវិញ។ ប្រសិនបើលើសដែនកំណត់សម្រាប់ការហៅមួយផងដែរ ការហៅត្រូវបានផ្អាកទុកម្តងទៀតសម្រាប់នោះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "합계가 초기화될 때까지 이 합계의 여유가 Card에 추가되었습니다. 1회 호출 한도도 넘으면 그 한도 때문에 호출이 다시 보류됩니다"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Card ຂອງມັນໄດ້ພື້ນທີ່ສຳລັບຍອດລວມນີ້ ຈົນກວ່າຈະຕັ້ງໃໝ່. ຖ້າເກີນຂີດຈຳກັດຕໍ່ການໂທໜຶ່ງເທື່ອນຳ ການໂທຖືກພັກໄວ້ອີກສຳລັບອັນນັ້ນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo Card gavo rezervą šiai bendrai sumai, kol ji bus atnaujinta. Jei viršijamas ir vienos užklausos limitas, užklausa dėl to vėl sulaikoma"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā Card saņēma rezervi šai kopsummai, līdz tā tiek atiestatīta. Ja tiek pārsniegts arī viena izsaukuma limits, izsaukums tiek atkal aizturēts tā dēļ"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неговиот Card го доби просторот за овој вкупен износ, додека не се врати. Ако е и над лимитот за едно барање, барањето повторно се задржува за тоа"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түүний Card энэ нийт дүнд зай авсан, шинэчлэгдэх хүртэл. Нэг дуудлагын хязгаараас бас хэтэрсэн бол дуудлагыг түүний төлөө дахин түр барина"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसको Card ले यो जम्माका लागि ठाउँ पायो, रिसेट नभएसम्म। एउटा कलको सीमाभन्दा पनि बढी भए, कल त्यसका लागि फेरि रोकिन्छ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zijn Card kreeg de ruimte voor dit totaal, tot het wordt gereset. Gaat de aanroep ook boven een limiet voor één aanroep, dan wordt hij daarvoor opnieuw vastgehouden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego Card dostała zapas na tę sumę, do jej wyzerowania. Jeśli przekracza też limit na jedno wywołanie, wywołanie znowu jest z tego powodu oczekujące"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu Card recebeu a margem para este total, até ser reposto. Se também exceder um limite por chamada, a chamada fica novamente retida por isso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu Card recebeu a margem para este total, até ser reposto. Se também exceder um limite por chamada, a chamada fica novamente retida por isso"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardul său a primit spațiul pentru acest total, până se resetează. Dacă depășește și limita pentru un apel, apelul este reținut din nou pentru aceasta"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho Card dostala priestor pre tento celkový limit, kým sa nevynuluje. Ak je volanie aj nad limit na jedno volanie, znova sa pre to pozdrží"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegova Card je dobila prostor za to skupno vsoto, dokler se ne ponastavi. Če klic presega tudi omejitev za en klic, je zaradi tega znova zadržan"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-i i tij mori hapësirën për këtë total, deri sa të rivendoset. Mbi një kufi për një thirrje gjithashtu, thirrja mbahet sërish për këtë"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegov je Card dobio prostor za ovaj ukupni iznos, do ponovnog podešavanja. Ako je i iznad ograničenja za jedan poziv, poziv se zbog toga ponovo zadržava"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Card ของมันได้รับพื้นที่สำหรับยอดรวมนี้ จนกว่าจะรีเซ็ต หากยังเกินขีดจำกัดสำหรับหนึ่งการเรียกด้วย การเรียกนั้นจะถูกพักไว้อีกครั้งเพราะเรื่องนั้น"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Onuň Card-y bu jem üçin, täzeden başlanýança, ýer aldy. Bir çagyryş üçin çäkden hem artyk bolsa, çagyryş ol üçin täzeden saklanýar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Card'ı bu toplam için payı sıfırlanana kadar aldı. Tek çağrı limitini de aşıyorsa çağrı bunun için tekrar tutulur"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے Card کو اس کل کی گنجائش ملی، ری سیٹ ہونے تک۔ ایک کال کی حد سے بھی اوپر ہو تو کال اسی کے لیے دوبارہ روکی جاتی ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Card của nó đã có dư địa cho tổng này, cho đến khi được đặt lại. Nếu còn vượt giới hạn cho một lượt gọi, lượt gọi vẫn bị giữ lại vì điều đó"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的 Card 取得了這個總額的額度，直到重設為止。若同時超過單次呼叫的上限，這次呼叫會因此再次被保留"
          }
        }
      }
    },
