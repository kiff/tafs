    "taf.memory.forget_body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nBunu geri qaytarmaq olmaz: taf növbəti işindən və ya söhbətindən etibarən onunla işləməyi dayandırır. Digər qeydlər qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“\n\nТова не може да бъде отменено: taf спира да работи с нея от следващото си изпълнение или чат. Другите бележки остават."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“\n\nNelze to vrátit: taf s ní přestane pracovat od příštího běhu nebo chatu. Ostatní poznámky zůstávají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“\n\nDas lässt sich nicht rückgängig machen: Der taf arbeitet ab seinem nächsten Lauf oder Chat nicht mehr damit. Andere Notizen bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nIt can't be undone: the taf stops working with it from its next run or chat. Other notes stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»\n\nNo se puede deshacer: el taf deja de tenerla en cuenta desde su próxima ejecución o chat. Las demás notas se conservan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@”\n\nSeda ei saa tagasi võtta: taf lõpetab selle kasutamise alates järgmisest käivitusest või vestlusest. Teised märkmed jäävad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ »\n\nC'est irréversible : le taf cesse de l'utiliser dès sa prochaine exécution ou son prochain chat. Les autres notes restent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“\n\nTo se ne može poništiti: taf prestaje raditi s tim od svog sljedećeg izvođenja ili razgovora. Ostale bilješke ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@”\n\nNem vonható vissza: a taf a következő futásától vagy csevegésétől nem dolgozik vele. A többi jegyzet marad."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»\n\nՍա հնարավոր չէ հետ շրջել․ taf-ը դադարում է աշխատել դրա հետ իր հաջորդ գործարկումից կամ զրույցից։ Մյուս նշումները մնում են։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nTidak dapat dibatalkan: taf berhenti bekerja dengannya mulai eksekusi atau obrolan berikutnya. Catatan lain tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»\n\nNon si può annullare: il taf smette di usarla dalla sua prossima esecuzione o chat. Le altre note restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」\n\n元に戻すことはできません。次の実行またはチャットから、tafはこのメモを使わなくなります。他のメモは残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“\n\nამის გაუქმება შეუძლებელია: taf მასთან მუშაობას წყვეტს შემდეგი გაშვებიდან ან ჩატიდან. სხვა ჩანაწერები რჩება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\n되돌릴 수 없습니다. 다음 실행이나 채팅부터 taf가 이 메모를 쓰지 않습니다. 다른 메모는 남습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“\n\nTo negalima atšaukti: taf nustos ja remtis nuo kito paleidimo ar pokalbio. Kitos pastabos lieka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nTo vairs nevarēs atjaunot: taf pārstāj ar to strādāt no nākamās palaišanas vai sarunas. Citas piezīmes paliek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nDit kan niet ongedaan worden gemaakt: het taf werkt er vanaf de volgende run of chat niet meer mee. Andere notities blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@”\n\nNie można tego cofnąć: taf przestanie z nią pracować od następnego uruchomienia lub czatu. Inne notatki zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nNão pode ser desfeito: o taf deixa de trabalhar com ela a partir da próxima execução ou chat. As outras notas mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nNão pode ser desfeito: o taf deixa de trabalhar com ela a partir da próxima execução ou chat. As outras notas mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@”\n\nAcțiunea nu poate fi anulată: taful nu mai lucrează cu ea de la următoarea rulare sau conversație. Celelalte notițe rămân."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“\n\nNedá sa to vrátiť: taf s ňou prestane pracovať od ďalšieho behu alebo chatu. Ostatné poznámky zostávajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%1$@«\n\nTega ni mogoče razveljaviti: taf preneha delati z njim od naslednjega zagona ali klepeta. Drugi zapiski ostanejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nNuk mund të zhbëhet: taf-i pushon së punuari me të nga ekzekutimi ose biseda e tij e radhës. Shënimet e tjera mbeten."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“\n\nTo se ne može poništiti: taf prestaje raditi s tim od svog sledećeg izvršavanja ili razgovora. Ostale beleške ostaju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nย้อนกลับไม่ได้: taf จะเลิกทำงานตามบันทึกนี้ตั้งแต่การทำงานหรือแชตถัดไป บันทึกอื่นยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nGeri alınamaz: taf bir sonraki çalıştırmasından veya sohbetinden itibaren bununla çalışmayı bırakır. Diğer notlar kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”\n\nKhông thể hoàn tác: taf ngừng làm việc với ghi chú này từ lượt chạy hoặc cuộc trò chuyện tiếp theo. Các ghi chú khác vẫn còn."
