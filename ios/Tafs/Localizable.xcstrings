        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um per Stimme zu fragen, erlaube tafs das Mikrofon auf dieser Uhr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To ask by voice, allow the microphone for tafs on this watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pedir con la voz, permite el micrófono a tafs en este reloj."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Häälega küsimiseks luba selles kellas tafsile mikrofon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour demander à la voix, autorisez le micro pour tafs sur cette montre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da pitate glasom, dopustite mikrofon za tafs na ovom satu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangalapú kérdezéshez engedélyezd a mikrofont a tafs számára ezen az órán."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձայնով հարցնելու համար այս ժամացույցում թույլ տվեք tafs-ին օգտագործել խոսափողը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk bertanya dengan suara, izinkan mikrofon untuk tafs di jam tangan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per chiedere a voce, consenti il microfono a tafs su questo orologio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声で質問するには、このウォッチでtafsのマイク使用を許可してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხმით სათხოვნელად ამ საათზე tafs-ს მიეცით მიკროფონის უფლება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성으로 물으려면 이 워치에서 tafs의 마이크 사용을 허용하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad galėtumėte klausti balsu, šiame laikrodyje leiskite tafs naudoti mikrofoną."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai jautātu balsī, atļauj tafs izmantot mikrofonu šajā pulkstenī."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta de microfoon toe voor tafs op dit horloge om met je stem te vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby pytać głosem, zezwól tafs na mikrofon na tym zegarku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pedir por voz, autorize o microfone para o tafs neste relógio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pedir por voz, autorize o microfone para o tafs neste relógio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a întreba cu vocea, permiteți microfonul pentru tafs pe acest ceas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak sa chcete pýtať hlasom, povoľte tafs na týchto hodinkách mikrofón."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za glasovna vprašanja dovolite tafs uporabo mikrofona na tej uri."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Për të pyetur me zë, lejoni mikrofonin për tafs në këtë orë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Da pitate glasom, dozvolite mikrofon za tafs na ovom satu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการถามด้วยเสียง ให้อนุญาตไมโครโฟนสำหรับ tafs บนนาฬิกาเรือนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesle sormak için bu saatte tafs'a mikrofon izni verin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để hỏi bằng giọng nói, hãy cho phép micrô cho tafs trên đồng hồ này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要用語音詢問，請在這支手錶上允許 tafs 使用麥克風。"
          }
        }
      }
    },
