    "coach.chats.archive_body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "O, bütün cihazlarınızda bu siyahıdan çıxır. Onu Arxivdə tapacaqsınız, orada açıb ya da geri qoya bilərsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изчезва от този списък на всичките ви устройства. Ще го намерите в „Архивирани“, където можете да го отворите или върнете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmizí z tohoto seznamu na všech vašich zařízeních. Najdete ho v Archivu, kde ho můžete otevřít nebo vrátit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es verschwindet auf all deinen Geräten aus dieser Liste. Du findest es unter „Archiviert“, wo du es öffnen oder zurückholen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It leaves this list on all your devices. You'll find it under Archived, where you can open it or put it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale de esta lista en todos tus dispositivos. La encontrarás en Archivadas, donde puedes abrirla o restaurarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See kaob sellest loendist kõigis sinu seadmetes. Leiad selle jaotisest Arhiveeritud, kus saad selle avada või tagasi panna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle quitte cette liste sur tous vos appareils. Vous la retrouverez dans Archivées, où vous pourrez l'ouvrir ou la restaurer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nestaje s ovog popisa na svim vašim uređajima. Naći ćete ga u Arhivirano, gdje ga možete otvoriti ili vratiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltűnik erről a listáról az összes eszközödön. Az Archivált részben találod, ahol megnyithatod vagy visszateheted."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն դուրս է գալիս այս ցանկից ձեր բոլոր սարքերում։ Կգտնեք «Արխիվացված»-ում, որտեղ կարող եք բացել կամ վերադարձնել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Percakapan ini hilang dari daftar ini di semua perangkat Anda. Anda dapat menemukannya di Diarsipkan, tempat Anda bisa membukanya atau mengembalikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce da questo elenco su tutti i tuoi dispositivi. La trovi in Archiviate, dove puoi aprirla o ripristinarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスでこのリストから消えます。アーカイブ済みから開いたり元に戻したりできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ის ამ სიიდან გაქრება თქვენს ყველა მოწყობილობაზე. იპოვით „დაარქივებულებში“, სადაც შეგიძლიათ გახსნათ ან დააბრუნოთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 이 목록에서 사라집니다. 보관됨에서 찾아 열거나 되돌릴 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jis dings iš šio sąrašo visuose jūsų įrenginiuose. Rasite jį skiltyje „Archyvuota“, kur galėsite jį atidaryti arba grąžinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā pazudīs no šī saraksta visās tavās ierīcēs. Tu to atradīsi sadaļā “Arhivētās”, kur to var atvērt vai atjaunot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verdwijnt uit deze lijst op al je apparaten. Je vindt het onder Gearchiveerd, waar je het kunt openen of terugzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zniknie z tej listy na wszystkich Twoich urządzeniach. Znajdziesz ją w Zarchiwizowanych, gdzie możesz ją otworzyć lub przywrócić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai desta lista em todos os seus dispositivos. Encontra-a em Arquivadas, onde a pode abrir ou repor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai desta lista em todos os seus dispositivos. Você a encontra em Arquivadas, onde pode abri-la ou restaurá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispare din această listă pe toate dispozitivele dvs. O găsiți la Arhivate, unde o puteți deschide sau repune."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmizne z tohto zoznamu na všetkých vašich zariadeniach. Nájdete ho v Archíve, kde ho môžete otvoriť alebo vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgine s tega seznama na vseh vaših napravah. Najdete ga v Arhivu, kjer ga lahko odprete ali vrnete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Del nga kjo listë në të gjitha pajisjet tuaja. Do ta gjeni te Të arkivuarat, ku mund ta hapni ose ta ktheni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nestaje s ovog popisa na svim vašim uređajima. Naći ćete ga u Arhivirano, gde ga možete otvoriti ili vratiti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันจะออกจากรายการนี้บนอุปกรณ์ทั้งหมดของคุณ คุณจะพบมันในเก็บถาวร ซึ่งเปิดหรือนำกลับมาได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm cihazlarınızda bu listeden kalkar. Açabileceğiniz veya geri koyabileceğiniz Arşivlenenler'de bulursunuz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó rời khỏi danh sách này trên mọi thiết bị của bạn. Bạn sẽ thấy nó trong mục Đã lưu trữ, nơi bạn có thể mở hoặc đặt lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會從您所有裝置上的這份清單中消失。您可以在「已封存」中找到它，並在那裡開啟或放回。"
          }
        }
      }
    },
