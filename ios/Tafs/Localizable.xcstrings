    "coach.improve.why_refused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum wurde etwas abgelehnt oder zurückgehalten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why was something refused or held?"
          }
        },
        "es": {
          "stringUnit": {
