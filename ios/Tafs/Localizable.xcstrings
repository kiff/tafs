    "record.event.paired_detail": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan sonra onun %1$@ ilə mesajları ona iş verir"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съобщенията му през %1$@ му дават работа отсега нататък"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho zprávy přes %1$@ mu odteď dávají práci"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Nachrichten per %1$@ geben ihm ab jetzt Arbeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their messages by %1$@ give it work from now on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de ahora, sus mensajes por %1$@ le dan trabajo"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema sõnumid ukse %1$@ kaudu annavad sellele nüüdsest tööd"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses messages par %1$@ lui donnent désormais du travail"
