    "settings.sign_in_again_why": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonun təsdiq açarını qeydiyyatdan keçirmək üçün yenidən daxil olun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влезте отново, за да регистрирате ключа за одобрение на този телефон."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se znovu, aby se zaregistroval schvalovací klíč tohoto telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut anmelden, um den Genehmigungsschlüssel dieses Telefons zu registrieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again to register this phone's approval key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay que volver a iniciar sesión para registrar la clave de aprobación de este teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle telefoni kinnitusvõtme registreerimiseks logi uuesti sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous pour enregistrer la clé d'approbation de ce téléphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se ponovno da registrirate ključ za odobravanje ovog telefona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezz be újra, hogy regisztráld ennek a telefonnak a jóváhagyási kulcsát."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նորից մուտք գործեք՝ այս հեռախոսի հաստատման բանալին գրանցելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk lagi untuk mendaftarkan kunci persetujuan ponsel ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi di nuovo per registrare la chiave di approvazione di questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンの承認キーを登録するには、もう一度サインインしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კვლავ შედით, რომ ამ ტელეფონის დამტკიცების გასაღები დარეგისტრირდეს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰의 승인 키를 등록하려면 다시 로그인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijunkite dar kartą, kad užregistruotumėte šio telefono patvirtinimo raktą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieraksties vēlreiz, lai reģistrētu šī tālruņa apstiprināšanas atslēgu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw inloggen om de goedkeuringssleutel van deze telefoon te registreren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się ponownie, aby zarejestrować klucz zatwierdzania tego telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão novamente para registar a chave de aprovação deste telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre novamente para registrar a chave de aprovação deste telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectați-vă din nou pentru a înregistra cheia de aprobare a acestui telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihláste sa znova, aby sa zaregistroval schvaľovací kľúč tohto telefónu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova se prijavite, da registrirate ključ za odobritev tega telefona."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyni sërish për të regjistruar çelësin e miratimit të këtij telefoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se ponovo da registrirate ključ za odobravanje ovog telefona."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบอีกครั้งเพื่อลงทะเบียนกุญแจอนุมัติของโทรศัพท์เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonun onay anahtarını kaydetmek için tekrar oturum açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng nhập lại để đăng ký khóa phê duyệt của điện thoại này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新登入以註冊這部手機的核准金鑰。"
          }
        }
      }
    },
