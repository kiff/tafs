    "voice.dictation_not_add_keyboard_dictation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren ist auf diesem %1$@ noch nicht verfügbar. Füge unter Einstellungen › Allgemein › Tastatur › Tastaturen eine Tastatur mit aktiviertem Diktieren hinzu, warte, bis ihre Sprache geladen ist, und versuch es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation isn't on this %1$@ yet. Add a keyboard with dictation on in Settings › General › Keyboard › Keyboards, wait for its language to download, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado aún no está en este %1$@. Añade un teclado con el dictado activado en Ajustes › General › Teclado › Teclados, espera a que se descargue su idioma y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée n'est pas encore disponible sur cet %1$@. Ajoutez un clavier avec la dictée activée dans Réglages › Général › Clavier › Claviers, attendez le téléchargement de sa langue, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura non è ancora attiva su questo %1$@. Aggiungi una tastiera con la dettatura attiva in Impostazioni › Generali › Tastiera › Tastiere, attendi che la sua lingua venga scaricata, poi riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren staat nog niet aan op deze %1$@. Voeg een toetsenbord met dicteren toe in Instellingen › Algemeen › Toetsenbord › Toetsenborden, wacht tot de taal is gedownload en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie nie jest jeszcze dostępne na tym urządzeniu (%1$@). Dodaj klawiaturę z włączonym dyktowaniem w Ustawienia › Ogólne › Klawiatura › Klawiatury, poczekaj na pobranie jej języka, a potem spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado ainda não está disponível neste %1$@. Adicione um teclado com o ditado ativado em Definições › Geral › Teclado › Teclados, aguarde que o idioma seja descarregado e tente novamente."
          }
        }
      }
    },
