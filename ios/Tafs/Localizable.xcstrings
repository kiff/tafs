    "connect.words_another_connection_than_one": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Worte gehören zu einer anderen Verbindung als der angezeigten. Es kann nichts genehmigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These words are for another connection than the one shown. Nothing can be approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas palabras son para otra conexión distinta de la que se muestra. No se puede aprobar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces textes concernent une autre connexion que celle affichée. Rien ne peut être approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste parole sono per un collegamento diverso da quello mostrato. Non si può approvare nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze woorden zijn voor een andere koppeling dan de getoonde. Er kan niets worden goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten opis dotyczy innego połączenia niż pokazane. Nic nie można zatwierdzić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas palavras são para outra ligação que não a mostrada. Nada pode ser aprovado."
          }
        }
      }
    },
    "connect.words_mismatch": {
