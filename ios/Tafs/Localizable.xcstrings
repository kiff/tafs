            "state": "translated",
            "value": "Alguien llamó a su puerta. No se hizo nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un a fait une demande d'accès à sa porte. Rien n'a été fait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno ha bussato alla sua porta. Non è stato fatto nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand klopte aan bij zijn deur. Er is niets gedaan."
          }
        },
        "pl": {
