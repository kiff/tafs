    "error.down": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يعمل الأمر من جانبنا الآن. حاول مرة أخرى لاحقًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bizim tərəfdə hazırda işləmir. Sonra yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В момента не работи от наша страна. Опитайте отново по-късно."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন আমাদের দিকে এটি কাজ করছে না। পরে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara mateix no funciona pel nostre costat. Torna-ho a provar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U nás to teď nefunguje. Zkuste to později."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei uns funktioniert es gerade nicht. Versuch es später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't working on our side right now. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no funciona por nuestra parte. Vuelve a intentarlo más tarde."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Meie poolel see praegu ei tööta. Proovi hiljem uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne fonctionne pas de notre côté pour le moment. Réessayez plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה לא עובד כרגע מצדנו. יש לנסות שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अभी हमारी ओर से काम नहीं कर रहा। बाद में फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod nas trenutačno ne radi. Pokušajte ponovno kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nálunk most nem működik. Próbáld újra később."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեր կողմից հիմա չի աշխատում։ Փորձեք ավելի ուշ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang tidak berfungsi di pihak kami. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo momento non funziona da parte nostra. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、こちら側で問題が発生しています。後でもう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩვენს მხარეს ახლა არ მუშაობს. სცადეთ მოგვიანებით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាមិនដំណើរការនៅខាងយើងនៅពេលនេះទេ។ សូមព្យាយាមម្តងទៀតពេលក្រោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 저희 쪽에서 작동하지 않습니다. 나중에 다시 시도하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມັນບໍ່ເຮັດວຽກຢູ່ຝ່າຍພວກເຮົາດຽວນີ້. ລອງໃໝ່ພາຍຫຼັງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiuo metu mūsų pusėje tai neveikia. Bandykite vėliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pie mums tas pašlaik nedarbojas. Mēģini vēlāk."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не работи на наша страна во моментов. Обиди се подоцна."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Манай талд одоогоор ажиллахгүй байна. Дараа дахин оролдоно уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "हाम्रो तर्फबाट अहिले काम गरिरहेको छैन। पछि फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het werkt nu niet aan onze kant. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po naszej stronie to teraz nie działa. Spróbuj ponownie później."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento não está a funcionar do nosso lado. Tente novamente mais tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento não está funcionando do nosso lado. Tente novamente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu funcționează la noi momentan. Încercați din nou mai târziu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "U nás to teraz nefunguje. Skúste to neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri nas trenutno ne deluje. Poskusite pozneje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tani nuk funksionon nga ana jonë. Provoni sërish më vonë."
