    "door.api.faceid_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتمكن %1$@ من تسليم العمل إلى %2$@. أكّد أنه أنت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ taf-ına iş verə biləcək. Bunun siz olduğunuzu təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ще може да дава работа на %2$@. Потвърдете, че сте вие."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-কে কাজ দিতে পারবে। নিশ্চিত করুন এটি আপনি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ podrà donar feina a %2$@. Confirma que ets tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bude moci předávat %2$@ práci. Potvrďte, že jste to vy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kann %2$@ dann Arbeit geben. Bestätige, dass du es bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will be able to hand %2$@ work. Confirm it's you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ podrá darle trabajo a %2$@. Confirma que eres tú."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ saab tafile %2$@ tööd anda. Kinnita, et see oled sina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pourra confier du travail à %2$@. Confirmez que c'est bien vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ יוכל לתת ל-%2$@ עבודה. יש לאשר שזה אתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ को काम दे सकेगा। पुष्टि करें कि यह आप हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija %1$@ moći će tafu %2$@ predavati posao. Potvrdite da ste to vi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ munkát adhat majd neki (%2$@). Erősítsd meg, hogy te vagy az."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը կկարողանա %2$@-ին աշխատանք տալ։ Հաստատեք, որ դա դուք եք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ akan dapat menyerahkan pekerjaan kepada %2$@. Konfirmasi bahwa ini Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ potrà affidare lavoro a %2$@. Conferma che sei tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が%2$@に仕事を渡せるようになります。本人であることを確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ს შეეძლება %2$@-ისთვის სამუშაოს მიცემა. დაადასტურეთ, რომ ეს თქვენ ხართ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ នឹងអាចផ្តល់ការងារឱ្យ %2$@។ បញ្ជាក់ថាជាអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) %2$@에게 작업을 맡길 수 있게 됩니다. 본인인지 확인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ຈະມອບວຽກໃຫ້ %2$@ ໄດ້. ຢືນຢັນວ່າແມ່ນທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ galės perduoti darbą %2$@. Patvirtinkite, kad tai jūs."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ varēs nodot %2$@ darbu. Apstiprini, ka tas esi tu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ќе може да му дава работа на %2$@. Потврди дека си ти."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-д ажил өгөх боломжтой болно. Таны өөрөө гэдгийг баталгаажуулна уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ले %2$@ लाई काम दिन सक्नेछ। यो तपाईं नै हो भनी पुष्टि गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kan %2$@ dan werk geven. Bevestig dat jij het bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja %1$@ będzie mogła zlecać pracę dla %2$@. Potwierdź, że to Ty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vai poder entregar trabalho a %2$@. Confirme que é você."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vai poder entregar trabalho a %2$@. Confirme que é você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ îi va putea da lui %2$@ de lucru. Confirmați că sunteți dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bude môcť odovzdávať %2$@ prácu. Potvrďte, že ste to vy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bo lahko %2$@ predajal delo. Potrdite, da ste to vi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ do të mund t'i japë %2$@ punë. Konfirmoni që jeni ju."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija %1$@ moći će tafu %2$@ predavati posao. Potvrdite da ste to vi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จะสามารถมอบงานให้ %2$@ ยืนยันว่าเป็นคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-a iş berip bilýän bolar. Siziň özüňizdigiňizi tassyklaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ taf'ına iş verebilecek. Sizin olduğunuzu onaylayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ کو کام سونپ سکے گی۔ تصدیق کریں کہ یہ آپ ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sẽ có thể giao việc cho %2$@. Hãy xác nhận đó là bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 將能夠交付工作給 %2$@。請確認是您本人。"
          }
        }
      }
    },
    "door.api.faceid_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح باب جديد إلى %1$@"
