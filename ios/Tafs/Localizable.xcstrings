    "billing.solo_subscription_one_charged_your": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo اشتراك بسعر %2$@ / %1$@، يُخصم من حساب Apple الخاص بك. يتجدد في نهاية كل فترة (%3$@) حتى تلغيه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo bir dövr (%1$@) üçün %2$@ məbləğində abunəlikdir, Apple hesabınızdan tutulur. Siz ləğv edənə qədər hər dövr (%3$@) yenilənir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo е абонамент за един %1$@ на цена %2$@, таксуван в акаунта ви в Apple. Подновява се всеки %3$@, докато не го анулирате."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo হলো এক %1$@-এর %2$@ দামের সাবস্ক্রিপশন, আপনার Apple অ্যাকাউন্ট থেকে কাটা হয়। আপনি বাতিল না করা পর্যন্ত প্রতি %3$@ নবায়ন হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo és una subscripció d'un %1$@ a %2$@, que es carrega al teu compte d'Apple. Es renova cada %3$@ fins que la cancel·lis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo je předplatné na jeden %1$@ za %2$@, účtované na váš účet Apple. Obnovuje se každý %3$@, dokud ho nezrušíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo ist ein Abonnement für %2$@ pro %1$@, abgerechnet über deinen Apple-Account. Es verlängert sich nach jedem Abrechnungszeitraum (%3$@), bis du kündigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo is a subscription of one %1$@ at %2$@, charged to your Apple account. It renews every %3$@ until you cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo es una suscripción de un %1$@ por %2$@, que se cobra en tu cuenta de Apple. Se renueva cada %3$@ hasta que la canceles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo on tellimus, üks %1$@ hinnaga %2$@, mis võetakse sinu Apple'i kontolt. See uueneb iga %3$@, kuni tühistad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo est un abonnement à %2$@ par %1$@, facturé sur votre compte Apple. Il se renouvelle chaque %3$@ jusqu'à ce que vous l'annuliez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo הוא מנוי של %1$@ אחד ב-%2$@, המחויב בחשבון Apple שלך. הוא מתחדש כל %3$@ עד שתבטל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %2$@ पर एक %1$@ की सदस्यता है, जो आपके Apple खाते से ली जाती है। यह आपके रद्द करने तक हर %3$@ नवीनीकृत होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo je pretplata po cijeni %2$@ / %1$@, naplaćena na vaš Apple račun. Obnavlja se na kraju svakog razdoblja (%3$@) dok je ne otkažete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Solo egy %1$@ időtartamú előfizetés %2$@ áron, az Apple-fiókodra terhelve. Minden új %3$@ elején megújul, amíg le nem mondod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo-ն բաժանորդագրություն է մեկ ժամանակահատվածով (%1$@) %2$@-ով, որը գանձվում է ձեր Apple հաշվից։ Նորացվում է յուրաքանչյուր ժամանակահատվածում (%3$@), մինչև չեղարկեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo adalah langganan seharga %2$@ / %1$@, ditagihkan ke akun Apple Anda. Diperpanjang di akhir setiap periode (%3$@) sampai Anda membatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo è un abbonamento a %2$@ ogni %1$@, addebitato sul tuo account Apple. Si rinnova ogni %3$@ finché non lo annulli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Soloは%2$@の%1$@単位のサブスクリプションで、Apple IDに請求されます。解約するまで%3$@ごとに更新されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo არის გამოწერა ერთი პერიოდისთვის (%1$@) %2$@-ად, რომელიც თქვენს Apple ანგარიშს ჩამოეჭრება. ახლდება ყოველ პერიოდში (%3$@), სანამ არ გააუქმებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo គឺជាការជាវរយៈពេលមួយ%1$@ តម្លៃ %2$@ គិតលើគណនី Apple របស់អ្នក។ វាបន្តរាល់%3$@ រហូតដល់អ្នកបោះបង់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo는 %2$@의 %1$@ 단위 구독이며 Apple 계정에 청구됩니다. 취소할 때까지 매%3$@ 갱신됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo ແມ່ນການສະໝັກໜຶ່ງ%1$@ ລາຄາ %2$@ ເກັບຈາກບັນຊີ Apple ຂອງທ່ານ. ມັນຕໍ່ອາຍຸທຸກ%3$@ ຈົນກວ່າທ່ານຍົກເລີກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo – %2$@ per %1$@ prenumerata, mokama iš jūsų Apple paskyros. Ji atnaujinama kas %3$@, kol jos neatšauksite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo ir abonements par %2$@ reizi %1$@, ko iekasē no tava Apple konta. Tas atjaunojas reizi %3$@, līdz tu to atcel."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo е претплата од еден %1$@ по %2$@, наплатена од твојата Apple сметка. Се обновува секој %3$@ додека не откажеш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo бол %1$@-ийн захиалга, үнэ %2$@, таны Apple бүртгэлээс төлөгдөнө. Та цуцлах хүртэл %3$@ бүр сунгагдана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo एक %1$@ को सदस्यता हो, %2$@ मा, तपाईंको Apple खातामा शुल्क लाग्छ। तपाईंले रद्द नगरेसम्म प्रत्येक %3$@ नवीकरण हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo is een abonnement van één %1$@ voor %2$@, in rekening gebracht bij je Apple-account. Het wordt elke %3$@ verlengd tot je opzegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo to subskrypcja na okres %1$@ za %2$@, pobierana z Twojego konta Apple. Odnawia się co %3$@, dopóki jej nie anulujesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Solo é uma subscrição por %1$@, a %2$@, cobrada na sua conta Apple. Renova-se a cada %3$@ até a cancelar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Solo é uma assinatura por %1$@, a %2$@, cobrada na sua conta Apple. É renovada a cada %3$@ até você cancelar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo este un abonament pe %1$@ la %2$@, debitat din contul Apple. Se reînnoiește în fiecare %3$@ până îl anulați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo je predplatné na jeden %1$@ za %2$@, účtované na váš účet Apple. Obnovuje sa každý %3$@, kým ho nezrušíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo je naročnina za en %1$@ po %2$@, ki se zaračuna vašemu računu Apple. Podaljša se vsak %3$@, dokler je ne prekličete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo është një abonim për një periudhë (%1$@) me %2$@, i ngarkuar në llogarinë tuaj Apple. Rinovohet çdo periudhë (%3$@) derisa ta anuloni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo je pretplata na jedan period (%1$@) po ceni od %2$@, koja se naplaćuje vašem Apple nalogu. Obnavlja se na svaki period (%3$@) dok je ne otkažete."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo เป็นการสมัครใช้งาน %2$@ / %1$@ เรียกเก็บจากบัญชี Apple ของคุณ ต่ออายุอัตโนมัติเมื่อสิ้นสุดแต่ละรอบ (%3$@) จนกว่าคุณจะยกเลิก"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %2$@ bahadan bir %1$@ abunadyr, Apple hasabyňyzdan alynýar. Ol siz ýatyrýançaňyz her %3$@ täzelenýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo, %2$@ / %1$@ tutarında bir aboneliktir ve Apple hesabınızdan tahsil edilir. Siz iptal edene kadar her dönem sonunda (%3$@) yenilenir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %2$@ پر ایک %1$@ کی سبسکرپشن ہے، جو آپ کے Apple اکاؤنٹ سے لی جاتی ہے۔ یہ آپ کے منسوخ کرنے تک ہر %3$@ تجدید ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo là gói đăng ký %2$@ / %1$@, tính vào tài khoản Apple của bạn. Tự gia hạn vào cuối mỗi kỳ (%3$@) cho đến khi bạn hủy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo 為 %2$@ / %1$@ 的訂閱，費用會從您的 Apple 帳號扣款。每期結束時（%3$@）自動續訂，直到您取消為止。"
          }
        }
      }
    },
