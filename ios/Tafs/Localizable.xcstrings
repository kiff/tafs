    "alert.foot.cant_answer_holds": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen gehen an die Personen, die zurückgehaltene Aufrufe beantworten dürfen. Deine Rolle in diesem Konto darf das nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts go to the people who may answer held calls. Your role on this account can't."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas van a las personas que pueden responder a las llamadas retenidas. Tu rol en esta cuenta no puede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes vont aux personnes qui peuvent répondre aux appels retenus. Votre rôle sur ce compte ne le peut pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi vanno alle persone che possono rispondere alle chiamate trattenute. Il tuo ruolo in questo account non può."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen gaan naar de mensen die vastgehouden aanroepen mogen beantwoorden. Jouw rol in dit account mag dat niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty trafiają do osób, które mogą odpowiadać na oczekujące wywołania. Twoja rola na tym koncie nie może."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas vão para as pessoas que podem responder a chamadas retidas. A sua função nesta conta não pode."
          }
        }
      }
    },
    "alert.foot.tells_you_device": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein taf dich braucht, meldet sich dieses %1$@, auch wenn tafs geschlossen ist. Nichts wird gesendet, bevor du genehmigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a taf needs you, this %1$@ tells you even with tafs closed. Nothing is sent until you approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un taf te necesita, este %1$@ te avisa aunque tafs esté cerrado. No se envía nada hasta que apruebes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un taf vous attend, cet %1$@ vous prévient même si tafs est fermé. Rien n'est envoyé tant que vous n'approuvez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un taf ti aspetta, questo %1$@ te lo dice anche con tafs chiusa. Non viene inviato nulla finché non approvi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een taf op jou wacht, laat deze %1$@ het je weten, ook als tafs gesloten is. Er wordt niets verzonden tot je goedkeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy taf czeka na Ciebie, ten %1$@ Cię o tym powiadomi, nawet gdy tafs jest zamknięte. Nic nie zostanie wysłane, dopóki nie zatwierdzisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf precisa de si, este %1$@ avisa-o mesmo com o tafs fechado. Nada é enviado até aprovar."
          }
        }
      }
    },
