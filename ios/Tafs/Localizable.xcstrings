    "usage.taf_runs_not_read": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İşləri oxuna bilmədi. %1$@"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпълненията му не можаха да бъдат прочетени. %1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho běhy se nepodařilo načíst. %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Läufe konnten nicht gelesen werden. %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its runs couldn't be read. %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer sus ejecuciones. %1$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle käivitusi ei õnnestunud lugeda. %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses exécutions n'ont pas pu être lues. %1$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegova izvođenja nije bilo moguće pročitati. %1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A futásait nem sikerült beolvasni. %1$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրա գործարկումները չկարողացան կարդացվել։ %1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksekusinya tidak dapat dibaca. %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere le sue esecuzioni. %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行を読み込めませんでした。%1$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისი გაშვებები ვერ წაიკითხა. %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 기록을 읽지 못했습니다. %1$@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko nuskaityti jo paleidimų. %1$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā palaišanas nevarēja nolasīt. %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De runs konden niet worden gelezen. %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać jego uruchomień. %1$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as suas execuções. %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as suas execuções. %1$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulările sale nu au putut fi citite. %1$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho behy sa nepodarilo načítať. %1$@"
          }
        },
        "sl": {
