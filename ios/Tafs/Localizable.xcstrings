        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երեքն էլ հաստատված են փոխադրողի կողմից որպես ուշացած և ստուգված են %1$@-ի կողմից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketiganya dikonfirmasi terlambat oleh kurir dan diperiksa oleh %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il corriere conferma il ritardo di tutti e tre e %1$@ li ha controllati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3件とも配送業者が遅延を確認しており、%1$@がチェック済みです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სამივე დადასტურებულია გადამზიდავის მიერ როგორც დაგვიანებული და შემოწმებულია %1$@-ის მიერ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទាំងបីត្រូវបានក្រុមហ៊ុនដឹកជញ្ជូនបញ្ជាក់ថាយឺត ហើយ %1$@ បានពិនិត្យ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 건 모두 택배사가 지연을 확인했으며 %1$@이(가) 점검했습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທັງສາມຖືກຂົນສົ່ງຢືນຢັນວ່າຊ້າ ແລະ %1$@ ກວດແລ້ວ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vežėjas patvirtino, kad visi trys vėluoja, ir juos patikrino %1$@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārvadātājs ir apstiprinājis, ka visas trīs kavējas, un %1$@ to pārbaudīja."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сите три се потврдени како задоцнети од превозникот и проверени од %1$@."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Гурвууланг нь тээвэрлэгч хоцорсон гэж баталсан бөгөөд %1$@ шалгасан."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तीनै वटा वाहकले ढिलो भएको पुष्टि गरेका छन् र %1$@ ले जाँचेको छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vervoerder bevestigt de vertraging van alle drie, en %1$@ heeft ze gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przewoźnik potwierdza opóźnienie wszystkich trzech, a %1$@ je sprawdził."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A transportadora confirma o atraso das três e o %1$@ verificou-as."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transportadora confirma o atraso das três e o %1$@ verificou-as."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate trei sunt confirmate ca întârziate de curier și au fost verificate de %1$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky tri prepravca potvrdil ako oneskorené a %1$@ ich overil."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse tri je prevoznik potrdil kot zamujene, %1$@ pa jih je preveril."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Të treja janë konfirmuar me vonesë nga transportuesi dhe u kontrolluan nga %1$@."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sva tri kašnjenja potvrdio je prevoznik, a proverio ih je %1$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งสามชิ้นผู้ขนส่งยืนยันว่าล่าช้าและ %1$@ ตรวจสอบแล้ว"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Üçüsi hem daşaýjy tarapyndan giç galandygy tassyklandy we %1$@ tarapyndan barlandy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üçünün de geciktiği taşıyıcı tarafından onaylandı ve %1$@ tarafından kontrol edildi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تینوں کی کیریئر نے تاخیر کی تصدیق کی ہے اور %1$@ نے انہیں جانچا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả ba đều được hãng vận chuyển xác nhận là trễ và đã được %1$@ kiểm tra."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這三件都已由貨運公司確認延誤，並由 %1$@ 檢查過。"
          }
        }
      }
    },
