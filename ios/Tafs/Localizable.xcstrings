    "settings.time_zone.uses_this": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saxlanılan çağırışların son tarixləri, Fəaliyyət, Qeydlər və taf-larınızın yazdıqları bu saat qurşağından istifadə edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сроковете на задържанията, Дейност, Дневникът и това, което пишат вашите tafs, използват тази часова зона."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lhůty zadržení, Aktivita, Záznam a to, co vaše tafy píšou, používají toto časové pásmo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fristen zurückgehaltener Aufrufe, Aktivität, das Protokoll und was deine tafs schreiben nutzen diese Zeitzone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds' deadlines, Activity, the Record and what your tafs write use this time zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plazos de las retenciones, la Actividad, el Registro y lo que escriben tus tafs usan esta zona horaria."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinnipidamiste tähtajad, Tegevus, Logi ja see, mida sinu tafid kirjutavad, kasutavad seda ajavööndit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les échéances des appels retenus, l'Activité, le Registre et ce qu'écrivent vos tafs utilisent ce fuseau horaire."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rokovi zadržavanja, Aktivnost, Zapisnik i ono što vaši tafovi pišu koriste ovu vremensku zonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A visszatartások határidői, a Tevékenység, a Napló és amit a tafjaid írnak, ezt az időzónát használják."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահվածների ժամկետները, Գործունեությունը, Գրանցամատյանը և այն, ինչ գրում են ձեր taf-երը, օգտագործում են այս ժամային գոտին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas waktu penahanan, Aktivitas, Catatan, dan yang ditulis tafs Anda memakai zona waktu ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scadenze delle trattenute, l'Attività, il Registro e ciò che scrivono i tuoi tafs usano questo fuso orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留の期限、アクティビティ、記録、tafsが書く内容にはこのタイムゾーンが使われます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაკავებულების ვადები, აქტივობა, ჩანაწერი და ის, რასაც თქვენი taf-ები წერენ, ამ დროის სარტყელს იყენებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류 기한, 활동, 기록, tafs가 쓰는 내용은 이 시간대를 사용합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulaikymų terminai, Veikla, Žurnalas ir tai, ką rašo jūsų taf, naudoja šią laiko juostą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aizturējumu termiņi, Aktivitāte, Žurnāls un tas, ko raksta tavi taf, izmanto šo laika joslu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines van vastgehouden aanroepen, Activiteit, het Logboek en wat je tafs schrijven gebruiken deze tijdzone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminy oczekujących wywołań, Aktywność, Rejestr i to, co piszą Twoje tafs, używają tej strefy czasowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os prazos das retenções, a Atividade, o Registo e o que os seus tafs escrevem usam este fuso horário."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os prazos das retenções, a Atividade, o Registro e o que os seus tafs escrevem usam este fuso horário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Termenele reținerilor, Activitatea, Jurnalul și ce scriu tafurile dvs. folosesc acest fus orar."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehoty pozdržaní, Aktivita, Záznam a to, čo vaše tafy píšu, používajú toto časové pásmo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Roki zadržanj, Dejavnost, Dnevnik in kar pišejo vaši tafi uporabljajo ta časovni pas."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Afatet e mbajtjeve, Aktiviteti, Regjistri dhe ajo që shkruajnë tafs-et tuaj përdorin këtë zonë kohore."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rokovi zadržavanja, Aktivnost, Zapisnik i ono šta vaši tafovi pišu koriste ovu vremensku zonu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นตายของรายการที่พักไว้ กิจกรรม บันทึก และสิ่งที่ taf ของคุณเขียนใช้เขตเวลานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutulanların son tarihleri, Etkinlik, Kayıt ve tafs'larınızın yazdıkları bu saat dilimini kullanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hạn chót của các yêu cầu bị giữ, Hoạt động, Sổ ghi và những gì các taf của bạn viết đều dùng múi giờ này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留項目的期限、活動、紀錄以及您的 taf 所撰寫的內容，都使用此時區。"
          }
        }
      }
    },
    "settings.time_zone_offer.text_device": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saxlanılan çağırışların son tarixləri, Fəaliyyət, Qeydlər və taf-larınızın yazdıqları bu %1$@ saat qurşağından istifadə edərdi. Hesabınız indi %2$@ istifadə edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сроковете на задържанията, Дейност, Дневникът и това, което пишат вашите tafs, биха използвали часовата зона на този %1$@. Акаунтът ви сега използва %2$@."
          }
