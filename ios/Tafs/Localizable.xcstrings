    "needs_you.allow_switch_off": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu söndürülübsə, Card dəyişir və bu sorğu hələ də cavabınızı gözləyir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако това е изключено, Card се променя, а това все още чака вашия отговор."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je tohle vypnuté, Card se změní a tohle pořád čeká na vaši odpověď."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das aus, ändert sich die Card, und diese wartet weiter auf deine Antwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With this off, the Card changes and this one still waits for your answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, la Card cambia y esta sigue esperando tu respuesta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui see on väljas, Card muutub ja see päring ootab ikka sinu vastust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, la Card change et celle-ci attend toujours votre réponse."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je ovo isključeno, Card se mijenja, a ovaj i dalje čeka vaš odgovor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ez ki van kapcsolva, a Card módosul, de ez továbbra is a válaszodra vár."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա անջատելով՝ Card-ը փոխվում է, և սա դեռ սպասում է ձեր պատասխանին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ini dimatikan, Card berubah dan yang ini tetap menunggu jawaban Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se è disattivato, la Card cambia e questa aspetta ancora la tua risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、Cardは変更されますが、このリクエストは引き続きあなたの回答を待ちます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამის გამორთვით Card იცვლება და ეს მაინც თქვენს პასუხს ელოდება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 끄면 Card는 바뀌고, 이번 요청은 여전히 내 답변을 기다립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai išjungus, Card pakeičiama, o ši užklausa vis tiek laukia jūsų atsakymo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja tas ir izslēgts, Card mainās, bet šis joprojām gaida tavu atbildi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat dit uit, dan verandert de Card en wacht dit verzoek nog op je antwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy to wyłączone, Card się zmienia, a ta nadal czeka na Twoją odpowiedź."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, o Card muda e este continua à espera da sua resposta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, o Card muda e este continua aguardando a sua resposta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu această opțiune dezactivată, Cardul se schimbă, iar acesta încă așteaptă răspunsul dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď je toto vypnuté, Card sa zmení a toto stále čaká na vašu odpoveď."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če je to izklopljeno, se Card spremeni, to pa še vedno čaka na vaš odgovor."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Me këtë joaktiv, Card-i ndryshon dhe kjo vazhdon të presë përgjigjen tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je ovo isključeno, Card se menja, a ovaj i dalje čeka vaš odgovor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิดสิ่งนี้ Card จะเปลี่ยน และรายการนี้ยังรอคำตอบของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kapalıyken Card değişir ve bu, yanıtınızı beklemeye devam eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, Card thay đổi và cái này vẫn chờ câu trả lời của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，Card 會變更，而這一項仍會等候您的回覆。"
          }
        }
      }
    },
    "needs_you.allow_title": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-ı dəyişin ki, bu kimi sorğular özləri getsin"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промяна на Card, така че подобни заявки да минават сами"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změnit Card, aby takové žádosti prošly samy"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Card ändern, damit solche Anfragen von selbst durchgehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the Card so requests like this go on their own"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la Card para que solicitudes así pasen solas"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuda Cardi, et sellised päringud läheksid ise läbi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier la Card pour que ce type de demande passe tout seul"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promijenite Card tako da ovakvi zahtjevi idu sami"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Card módosítása, hogy az ilyen kérések maguktól menjenek"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխեք Card-ը, որ նման հարցումները գնան ինքնուրույն"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah Card agar permintaan seperti ini berjalan sendiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica la Card perché richieste così passino da sole"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このようなリクエストが自動で進むようにCardを変更"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეცვალეთ Card, რომ ამდაგვარი მოთხოვნები თავისით წავიდეს"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이런 요청이 알아서 진행되도록 Card 변경"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakeisti Card, kad tokios užklausos būtų vykdomos savaime"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainīt Card, lai šādi pieprasījumi tiktu izpildīti bez jautāšanas"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Card aanpassen zodat zulke verzoeken vanzelf doorgaan"
