    "door.start_connected_tools_first_slack": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ من «التطبيقات المرتبطة» على هذا الجهاز (%1$@) أولًا. يجب إيقاف اشتراك Slack قبل إزالة بابه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlcə bu %1$@ üzərində Qoşulmuş tətbiqlərdən başlayın. Qapını silməzdən əvvəl Slack abunəliyi dayandırılmalıdır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Първо започнете от „Свързани приложения“ на този %1$@. Абонаментът в Slack трябва да бъде спрян, преди да премахнете вратата му."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে এই %1$@-এ «সংযুক্ত অ্যাপ» থেকে শুরু করুন। দরজা সরানোর আগে Slack-এর সাবস্ক্রিপশন বন্ধ করতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comença primer des d'Aplicacions connectades en aquest %1$@. Cal aturar la subscripció de Slack abans d'eliminar-ne la porta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív začněte z Připojených aplikací na tomto zařízení (%1$@). Odběr Slacku se musí zastavit, než se jeho dveře odstraní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne zuerst unter „Verbundene Apps“ auf diesem %1$@. Das Slack-Abonnement muss beendet werden, bevor seine Tür entfernt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start from Connected apps on this %1$@ first. Slack's subscription must be stopped before removing its door."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza primero desde Apps conectadas en este %1$@. La suscripción de Slack debe detenerse antes de eliminar su puerta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alusta kõigepealt selle seadme (%1$@) vaatest Ühendatud rakendused. Enne ukse eemaldamist tuleb Slacki tellimus lõpetada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez d'abord depuis Apps connectées sur %2$@. L'abonnement Slack doit être arrêté avant de supprimer sa porte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קודם יש להתחיל מ«אפליקציות מחוברות» בהתקן הזה (%1$@). את המנוי של Slack צריך לעצור לפני הסרת הדלת שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले इस %1$@ पर जुड़े हुए ऐप से शुरू करें। उसका द्वार हटाने से पहले Slack की सदस्यता रोकी जानी चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije počnite iz Povezanih aplikacija na ovom uređaju (%1$@). Slackova se pretplata mora zaustaviti prije uklanjanja njegovih vrata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb a Csatlakoztatott alkalmazások részből indulj ezen az eszközön (%1$@). A Slack-feliratkozást le kell állítani, mielőtt eltávolítod az ajtaját."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախ սկսեք «Միացված հավելվածներ»-ից այս սարքում (%1$@)։ Slack-ի բաժանորդագրությունը պետք է դադարեցվի նրա դուռը հեռացնելուց առաջ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dari Aplikasi terhubung di %1$@ ini terlebih dahulu. Langganan Slack harus dihentikan sebelum pintunya dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia prima da App collegate su questo %1$@. L'ascolto di Slack va interrotto prima di rimuovere la sua porta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずこの%1$@の「接続済みのアプリ」から始めてください。窓口を削除する前に、Slackの購読を停止する必要があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ დაიწყეთ „დაკავშირებული აპებიდან“ ამ მოწყობილობაზე (%1$@). Slack-ის გამოწერა უნდა შეწყდეს მისი კარის ამოღებამდე."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចាប់ផ្តើមពី «កម្មវិធីដែលបានភ្ជាប់» នៅលើ %1$@ នេះជាមុនសិន។ ការជាវរបស់ Slack ត្រូវតែបញ្ឈប់មុនពេលដកទ្វាររបស់វាចេញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 이 %1$@의 연결된 앱에서 시작하세요. 창구를 삭제하기 전에 Slack 구독을 멈춰야 합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເລີ່ມຈາກ ແອັບທີ່ເຊື່ອມຕໍ່ ໃນ %1$@ ນີ້ກ່ອນ. ການສະໝັກຂອງ Slack ຕ້ອງຖືກຢຸດກ່ອນເອົາປະຕູຂອງມັນອອກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmiausia pradėkite nuo „Prijungtos programėlės“ šiame įrenginyje (%1$@). Prieš šalinant Slack duris, reikia nutraukti Slack prenumeratą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vispirms sāc sadaļā “Pievienotās lietotnes” šajā ierīcē (%1$@). Pirms durvju noņemšanas jāatceļ Slack abonements."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прво започни од Поврзани апликации на овој %1$@. Претплатата на Slack мора да се запре пред да се отстранат неговите врата."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Эхлээд энэ %1$@ дээрх Холбосон аппуудаас эхлүүлнэ үү. Хаалгыг нь хасахаас өмнө Slack-ийн бүртгэлийг зогсоох ёстой."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिले यो %1$@ मा जडान गरिएका एपहरूबाट सुरु गर्नुहोस्। यसको ढोका हटाउनुअघि Slack को सदस्यता रोक्नुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin eerst bij Gekoppelde apps op deze %1$@. Het abonnement van Slack moet worden gestopt voordat je de deur verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zacznij od Połączonych aplikacji na tym urządzeniu (%1$@). Subskrypcja Slacka musi zostać zatrzymana przed usunięciem jego drzwi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece primeiro em Apps ligadas neste %1$@. A subscrição do Slack tem de ser parada antes de remover a sua porta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece primeiro em Apps conectados neste %1$@. A assinatura do Slack precisa ser interrompida antes de remover a sua porta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începeți mai întâi din Aplicații conectate pe acest dispozitiv (%1$@). Abonamentul Slack trebuie oprit înainte de a-i elimina ușa."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv začnite z Pripojených aplikácií na tomto zariadení (%1$@). Odber Slacku sa musí zastaviť, kým sa jeho dvere odstránia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej začnite iz Povezanih aplikacij na tej napravi (%1$@). Naročnino Slacka je treba ustaviti, preden odstranite njegova vrata."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fillimisht filloni nga Aplikacionet e lidhura në këtë pajisje (%1$@). Abonimi i Slack duhet të ndalet para se të hiqet porta e tij."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo počnite iz Povezanih aplikacija na ovom uređaju (%1$@). Slackova se pretplata mora zaustaviti pre uklanjanja njegovih vrata."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มจากแอปที่เชื่อมต่อบน%1$@เครื่องนี้ก่อน ต้องหยุดการสมัครรับของ Slack ก่อนนำประตูออก"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilki bu %1$@-däki Birikdirilen programmalardan başlaň. Slack-yň abunasy gapyny aýyrmazdan öň togtadylmaly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bu %1$@ üzerinde Bağlı uygulamalar'dan başlayın. Slack'in aboneliği, kapısı kaldırılmadan önce durdurulmalıdır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے اس %1$@ پر جڑی ہوئی ایپس سے شروع کریں۔ دروازہ ہٹانے سے پہلے Slack کی سبسکرپشن بند ہونی چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bắt đầu từ Ứng dụng đã kết nối trên %1$@ này trước. Phải dừng đăng ký của Slack trước khi gỡ cửa của nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先從這部%1$@上的「已連接的 App」開始。移除 Slack 的門之前，必須先停止它的訂閱。"
          }
        }
      }
    },
