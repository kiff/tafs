    "connect.key_clipboard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage wird nach dem Einfügen geleert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard is cleared after you paste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles se vacía después de pegar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõikelaud tühjendatakse pärast kleepimist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers est vidé après le collage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli appunti vengono svuotati dopo che incolli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けた後、クリップボードは消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여 넣은 뒤 클립보드가 지워집니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įklijavus iškarpinė išvaloma."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pēc ielīmēšanas starpliktuve tiek notīrīta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het klembord wordt gewist nadat je plakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schowek jest czyszczony po wklejeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência é limpa depois de colar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência é limpa depois de colar."
          }
        }
      }
    },
    "connect.key_goes_to": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel geht von diesem Telefon an den Verbindungsserver, der ihn nur an %1$@ sendet. An Coach geht er nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key goes from this phone to the connection server, which sends it only to %1$@. It never goes to Coach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave va de este teléfono al servidor de conexiones, que solo la envía a %1$@. Nunca va a Coach."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võti läheb sellest telefonist ühendusserverisse, mis saadab selle ainult hostile %1$@. See ei lähe kunagi Coachile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé va de ce téléphone au serveur de connexion, qui ne l'envoie qu'à %1$@. Elle ne va jamais à Coach."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave va da questo telefono al server dei collegamenti, che la invia solo a %1$@. Non va mai a Coach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはこのスマートフォンから接続サーバーに送られ、サーバーは%1$@にだけ送信します。Coachに送られることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 이 휴대폰에서 연결 서버로 가고, 연결 서버는 %1$@에만 보냅니다. Coach에게는 절대 가지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raktas iš šio telefono siunčiamas į ryšių serverį, kuris jį siunčia tik %1$@. Jis niekada nepatenka pas Coach."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atslēga no šī tālruņa nonāk savienojumu serverī, kas to sūta tikai uz %1$@. Tā nekad nenonāk pie Coach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel gaat van deze telefoon naar de koppelingsserver, die hem alleen naar %1$@ stuurt. Hij gaat nooit naar Coach."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz trafia z tego telefonu na serwer połączeń, który wysyła go tylko do %1$@. Nigdy nie trafia do Coacha."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave vai deste telefone para o servidor de ligações, que só a envia para %1$@. Nunca vai para o Coach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave vai deste telefone para o servidor de conexões, que só a envia para %1$@. Nunca vai para o Coach."
          }
        }
      }
    },
