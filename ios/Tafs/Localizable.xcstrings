    "taf.revoke_needs_approver": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإلغاء هذه الـ Card، استخدم جهازًا يستطيع الموافقة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Card-ı ləğv etmək üçün təsdiq edə bilən cihazdan istifadə edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да оттеглите тази Card, използвайте устройство, което може да одобрява."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Card প্রত্যাহার করতে এমন একটি ডিভাইস ব্যবহার করুন যা অনুমোদন করতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per revocar aquest Card, utilitza un dispositiu que pugui aprovar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li tuto Card odvolat, použijte zařízení, které může schvalovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um diese Card zu widerrufen, nutze ein Gerät, das genehmigen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To revoke this Card, use a device that can approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para revocar esta Card, usa un dispositivo que pueda aprobar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle Cardi tühistamiseks kasuta seadet, mis saab kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour révoquer cette Card, utilisez un appareil qui peut approuver."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להפקיע את ה-Card הזה, יש להשתמש בהתקן שיכול לאשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Card को रद्द करने के लिए ऐसा डिवाइस उपयोग करें जो मंज़ूर कर सकता हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da opozovete ovaj Card, upotrijebite uređaj koji može odobravati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Card visszavonásához használj jóváhagyásra képes eszközt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս Card-ը չեղարկելու համար օգտագործեք սարք, որը կարող է հաստատել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mencabut Card ini, gunakan perangkat yang dapat menyetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per revocare questa Card, usa un dispositivo che può approvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このCardを取り消すには、承認できるデバイスを使ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ Card-ის გასაუქმებლად გამოიყენეთ მოწყობილობა, რომელსაც დამტკიცება შეუძლია."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដើម្បីដកហូត Card នេះ សូមប្រើឧបករណ៍ដែលអាចអនុម័តបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Card를 취소하려면 승인할 수 있는 기기를 사용하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພື່ອຖອນ Card ນີ້ ໃຫ້ໃຊ້ອຸປະກອນທີ່ອະນຸມັດໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdami atšaukti šią Card, naudokite įrenginį, kuris gali tvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai atsauktu šo Card, izmanto ierīci, kas var apstiprināt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "За да го отповикаш овој Card, користи уред што може да одобрува."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ Card-ыг хүчингүй болгохын тулд зөвшөөрч чадах төхөөрөмж ашиглана уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो Card रद्द गर्न स्वीकृत गर्न सक्ने उपकरण प्रयोग गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een apparaat dat kan goedkeuren om deze Card in te trekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby unieważnić tę Card, użyj urządzenia, które może zatwierdzać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para revogar este Card, use um dispositivo que possa aprovar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para revogar este Card, use um dispositivo que possa aprovar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a revoca acest Card, folosiți un dispozitiv care poate aproba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete túto Card odvolať, použite zariadenie, ktoré môže schvaľovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za odvzem te Card uporabite napravo, ki lahko odobrava."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Për ta revokuar këtë Card, përdorni një pajisje që mund të miratojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Da opozovete ovaj Card, upotrebite uređaj koji može odobravati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเพิกถอน Card นี้ ให้ใช้อุปกรณ์ที่อนุมัติได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Card-y ýatyrmak üçin tassyklap biljek enjamy ulanyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Card'ı iptal etmek için onay verebilen bir cihaz kullanın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Card کو منسوخ کرنے کے لیے ایسی ڈیوائس استعمال کریں جو منظور کر سکتی ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để thu hồi Card này, hãy dùng một thiết bị có thể phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要撤銷此 Card，請使用可以核准的裝置。"
          }
        }
      }
