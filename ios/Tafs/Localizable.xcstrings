    "approval.security_key.add_enter_pin": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمز PIN الخاص بمفتاح الأمان لإضافته. يطلبه tafs في كل مرة ولا يخزنه أبدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əlavə etmək üçün təhlükəsizlik açarınızın PIN-ini daxil edin. tafs bunu hər dəfə istəyir və heç vaxt saxlamır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете ПИН кода на ключа за сигурност, за да го добавите. tafs го иска всеки път и никога не го съхранява."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ করতে আপনার সিকিউরিটি কী-র PIN দিন। tafs প্রতিবার এটি চায় এবং কখনও সংরক্ষণ করে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el PIN de la teva clau de seguretat per afegir-la. tafs el demana cada cop i mai no el desa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro přidání zadejte PIN bezpečnostního klíče. tafs se na něj zeptá pokaždé a nikdy ho neukládá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die PIN deines Sicherheitsschlüssels ein, um ihn hinzuzufügen. tafs fragt jedes Mal danach und speichert sie nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your security key's PIN to add it. tafs asks for it each time and never stores it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el PIN de tu llave de seguridad para añadirla. tafs lo pide cada vez y nunca lo guarda."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Turvavõtme lisamiseks sisesta selle PIN-kood. tafs küsib seda iga kord ega salvesta seda kunagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code PIN de votre clé de sécurité pour l'ajouter. tafs le demande à chaque fois et ne l'enregistre jamais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להזין את ה-PIN של מפתח האבטחה כדי להוסיף אותו. tafs מבקש אותו בכל פעם ולעולם לא שומר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे जोड़ने के लिए अपनी सुरक्षा कुंजी का PIN दर्ज करें। tafs हर बार उसे माँगता है और कभी सहेजता नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite PIN svojeg sigurnosnog ključa da ga dodate. tafs ga traži svaki put i nikad ga ne sprema."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hozzáadáshoz add meg a biztonsági kulcsod PIN-kódját. A tafs minden alkalommal kéri, és soha nem tárolja."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրեք ձեր անվտանգության բանալու PIN-ը՝ այն ավելացնելու համար։ tafs-ը այն խնդրում է ամեն անգամ և երբեք չի պահում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan PIN kunci keamanan Anda untuk menambahkannya. tafs memintanya setiap kali dan tidak pernah menyimpannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il PIN della tua chiave di sicurezza per aggiungerla. tafs lo chiede ogni volta e non lo salva mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加するにはセキュリティキーのPINを入力してください。tafsは毎回PINを求め、保存することはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეიყვანეთ თქვენი უსაფრთხოების გასაღების PIN, რომ დაამატოთ. tafs მას ყოველ ჯერზე ითხოვს და არასოდეს ინახავს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ចូល PIN នៃសោសុវត្ថិភាពរបស់អ្នកដើម្បីបន្ថែមវា។ tafs សុំវារាល់ពេល ហើយមិនដែលរក្សាទុកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가하려면 보안 키의 PIN을 입력하세요. tafs는 매번 PIN을 묻고 저장하지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃສ່ PIN ຂອງກຸນແຈຄວາມປອດໄພຂອງທ່ານເພື່ອເພີ່ມມັນ. tafs ຖາມທຸກຄັ້ງ ແລະ ບໍ່ເກັບມັນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite saugos rakto PIN, kad jį pridėtumėte. tafs jo prašo kaskart ir niekada jo nesaugo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadi savas drošības atslēgas PIN, lai to pievienotu. tafs to prasa katru reizi un nekad neglabā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Внеси го PIN на твојот безбедносен клуч за да го додадеш. tafs го бара секој пат и никогаш не го чува."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэмэхийн тулд аюулгүй байдлын түлхүүрийнхээ PIN-г оруулна уу. tafs үүнийг тухай бүрт асууж, хэзээ ч хадгалдаггүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "थप्न आफ्नो सुरक्षा कुञ्जीको PIN हाल्नुहोस्। tafs ले यो हरेक पटक सोध्छ र कहिल्यै भण्डारण गर्दैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de pincode van je beveiligingssleutel in om hem toe te voegen. tafs vraagt er elke keer om en bewaart hem nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz PIN swojego klucza bezpieczeństwa, aby go dodać. tafs pyta o niego za każdym razem i nigdy go nie zapisuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza o PIN da sua chave de segurança para a adicionar. O tafs pede-o sempre e nunca o guarda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o PIN da sua chave de segurança para adicioná-la. O tafs pede o PIN sempre e nunca o guarda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți PIN-ul cheii de securitate pentru a o adăuga. tafs îl cere de fiecare dată și nu îl stochează niciodată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na pridanie zadajte PIN bezpečnostného kľúča. tafs sa naň opýta zakaždým a nikdy ho neukladá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dodajanje vnesite PIN varnostnega ključa. tafs ga zahteva vsakič in ga nikoli ne shrani."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Futni PIN-in e çelësit tuaj të sigurisë për ta shtuar. tafs e kërkon çdo herë dhe nuk e ruan kurrë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite PIN svog sigurnosnog ključa da biste ga dodali. tafs ga traži svaki put i nikad ga ne čuva."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ PIN ของกุญแจความปลอดภัยเพื่อเพิ่ม tafs จะถามทุกครั้งและไม่เก็บไว้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Howpsuzlyk açaryňyzyň PIN-ini girizip, ony goşuň. tafs ony her gezek soraýar we hiç haçan saklamaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklemek için güvenlik anahtarınızın PIN'ini girin. tafs her seferinde ister ve asla saklamaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے شامل کرنے کے لیے اپنی سیکیورٹی کلید کا PIN درج کریں۔ tafs ہر بار اسے مانگتا ہے اور کبھی محفوظ نہیں کرتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nhập PIN của khóa bảo mật để thêm nó. tafs hỏi mỗi lần và không bao giờ lưu nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入安全金鑰的 PIN 以新增。tafs 每次都會詢問，且不會儲存。"
          }
        }
      }
    },
    "approval.security_key.add_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاح الأمان إلى هذا الكمبيوتر"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təhlükəsizlik açarınızı bu kompüterə əlavə edin"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавяне на ключа за сигурност към този компютър"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কম্পিউটারে আপনার সিকিউরিটি কী যোগ করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix la teva clau de seguretat a aquest ordinador"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte svůj bezpečnostní klíč k tomuto počítači"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deinen Sicherheitsschlüssel zu diesem Computer hinzufügen"
          }
        },
