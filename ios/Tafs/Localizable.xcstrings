    "connect.other_connections_stay_connected_no": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " تحتفظ بقية tafs التي تستخدم %1$@ بوصولها. وإن لم يستخدم أي taf آخر الحساب نفسه هناك، يُلغى تسجيل الدخول لدى %2$@؛ وإلا فعند إزالة آخرها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$@ istifadə edən digər taf-lar girişlərini saxlayır. Orada eyni hesabdan başqa taf istifadə etmirsə, %2$@ saytında giriş ləğv edilir; əks halda sonuncu silinəndə."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": " Другите tafs, които използват %1$@, запазват достъпа си. Ако никой друг taf не използва същия акаунт там, входът се оттегля в %2$@; иначе — когато бъде премахнат последният."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$@ ব্যবহার করে এমন অন্য taf তাদের প্রবেশাধিকার রাখে। সেখানে একই অ্যাকাউন্ট অন্য কোনো taf ব্যবহার না করলে %2$@-এ সাইন-ইন প্রত্যাহার করা হয়; নইলে শেষটি সরানোর সময়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": " Els altres taf que fan servir %1$@ conserven l'accés. Si cap altre taf hi fa servir el mateix compte, l'inici de sessió es revoca a %2$@; si no, quan s'elimini l'últim."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": " Ostatní tafy, které používají %1$@, si přístup nechají. Pokud tam stejný účet nepoužívá žádný jiný taf, přihlášení se u %2$@ odvolá; jinak až po odstranění posledního."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Andere tafs, die %1$@ nutzen, behalten ihren Zugriff. Nutzt kein anderer taf dasselbe Konto dort, wird die Anmeldung bei %2$@ widerrufen; sonst, wenn der letzte entfernt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Other tafs that use %1$@ keep their access. If no other taf uses the same account there, the sign-in is revoked at %2$@; otherwise, when the last one is removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Los demás tafs que usan %1$@ conservan su acceso. Si ningún otro taf usa la misma cuenta, el inicio de sesión se revoca en %2$@; si no, cuando se quita el último."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": " Teised tafid, mis kasutavad teenust %1$@, säilitavad oma juurdepääsu. Kui ükski teine taf ei kasuta seal sama kontot, tühistatakse sisselogimine teenuses %2$@; vastasel juhul siis, kui viimane neist eemaldatakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les autres tafs qui utilisent %1$@ gardent leur accès. Si aucun autre taf n'utilise le même compte, l'identifiant est révoqué chez %2$@ ; sinon, quand le dernier est retiré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " taf אחרים שמשתמשים ב-%1$@ שומרים על הגישה שלהם. אם אף taf אחר לא משתמש שם באותו חשבון, הכניסה מבוטלת אצל %2$@; אחרת, כשהאחרון יוסר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$@ का उपयोग करने वाले बाकी taf अपनी पहुँच रखते हैं। यदि कोई और taf वहाँ वही खाता उपयोग नहीं करता, तो साइन-इन %2$@ पर रद्द हो जाता है; नहीं तो आखिरी के हटने पर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": " Ostali tafovi koji koriste aplikaciju %1$@ zadržavaju svoj pristup. Ako nijedan drugi taf tamo ne koristi isti račun, prijava se opoziva kod pružatelja %2$@; inače, kad se ukloni zadnji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": " A többi taf, amely ezt használja (%1$@), megtartja a hozzáférését. Ha ott egyetlen másik taf sem használja ugyanazt a fiókot, a bejelentkezés visszavonásra kerül itt: %2$@; egyébként akkor, amikor az utolsót is eltávolítod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": " Մյուս taf-երը, որ օգտագործում են %1$@-ը, պահում են իրենց հասանելիությունը։ Եթե ուրիշ taf չի օգտագործում նույն հաշիվը այնտեղ, մուտքը չեղարկվում է %2$@-ի մոտ․ հակառակ դեպքում՝ երբ վերջինը հեռացվի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " Taf lain yang memakai %1$@ tetap memiliki aksesnya. Jika tidak ada taf lain yang memakai akun yang sama di sana, proses masuk dicabut di %2$@; jika tidak, saat yang terakhir dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Gli altri taf che usano %1$@ mantengono il loro accesso. Se nessun altro taf usa lo stesso account, il login viene revocato presso %2$@; altrimenti, quando viene rimosso l'ultimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を使う他のtafはアクセスを保持します。同じアカウントを使う他のtafがなければ、%2$@でサインインが取り消されます。あれば、最後のtafを外したときに取り消されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": " სხვა taf-ები, რომლებიც %1$@-ს იყენებენ, წვდომას ინარჩუნებენ. თუ სხვა taf იმავე ანგარიშს იქ არ იყენებს, შესვლა უქმდება %2$@-თან; სხვაგვარად, როცა ბოლო ამოიღება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": " taf ផ្សេងទៀតដែលប្រើ %1$@ រក្សាការចូលប្រើរបស់ខ្លួន។ ប្រសិនបើគ្មាន taf ផ្សេងទៀតប្រើគណនីដូចគ្នានៅទីនោះទេ ការចូលត្រូវបានដកហូតនៅ %2$@; បើមិនដូច្នោះទេ នៅពេលចុងក្រោយត្រូវបានដកចេញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$@을(를) 쓰는 다른 tafs는 접근 권한을 유지합니다. 같은 계정을 쓰는 다른 taf가 없으면 %2$@에서 로그인이 취소되고, 있으면 마지막 taf를 제거할 때 취소됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": " taf ອື່ນທີ່ໃຊ້ %1$@ ຍັງມີສິດເຂົ້າເຖິງ. ຖ້າບໍ່ມີ taf ອື່ນໃຊ້ບັນຊີດຽວກັນຢູ່ບ່ອນນັ້ນ ການເຂົ້າສູ່ລະບົບຖືກຖອນທີ່ %2$@; ບໍ່ດັ່ງນັ້ນ, ເມື່ອອັນສຸດທ້າຍຖືກເອົາອອກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": " Kiti %1$@ naudojantys taf išlaiko savo prieigą. Jei joks kitas taf nenaudoja tos pačios paskyros ten, prisijungimas atšaukiamas %2$@ pusėje; kitu atveju – kai pašalinamas paskutinis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": " Citi taf, kas izmanto %1$@, patur savu piekļuvi. Ja neviens cits taf tur neizmanto to pašu kontu, pierakstīšanās %2$@ tiek atsaukta; citādi – kad tiek noņemts pēdējais."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": " Другите tafови што го користат %1$@ го задржуваат пристапот. Ако ниеден друг taf не ја користи истата сметка таму, најавата се отповикува кај %2$@; инаку, кога ќе се отстрани последниот."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$@-ийг ашигладаг бусад taf-ууд хандах эрхээ хадгална. Хэрэв тэнд ижил бүртгэлийг өөр taf ашиглахгүй бол нэвтрэлт %2$@ дээр хүчингүй болно; үгүй бол сүүлчийнх нь хасагдахад."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$@ प्रयोग गर्ने अन्य taf ले आफ्नो पहुँच राख्छन्। त्यहाँ उही खाता अर्को कुनै taf ले प्रयोग गर्दैन भने साइन इन %2$@ मा रद्द हुन्छ; अन्यथा, अन्तिम हटाइँदा।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " Andere tafs die %1$@ gebruiken, houden hun toegang. Als geen andere taf hetzelfde account gebruikt, wordt de aanmelding bij %2$@ ingetrokken; anders pas als de laatste wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Inne tafy, które używają %1$@, zachowują dostęp. Jeśli żaden inny taf nie używa tego samego konta, logowanie zostanie cofnięte w %2$@; w przeciwnym razie, gdy usuniesz ostatni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " Os outros tafs que usam %1$@ mantêm o seu acesso. Se nenhum outro taf usar a mesma conta, o início de sessão é revogado em %2$@; caso contrário, quando o último for removido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Os outros tafs que usam %1$@ mantêm o seu acesso. Se nenhum outro taf usar a mesma conta, o login é revogado em %2$@; caso contrário, quando o último for removido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": " Celelalte tafuri care folosesc %1$@ își păstrează accesul. Dacă niciun alt taf nu folosește același cont acolo, conectarea este revocată la %2$@; altfel, când este eliminat ultimul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": " Ostatné tafy, ktoré používajú %1$@, si prístup nechajú. Ak tam rovnaký účet nepoužíva žiadny iný taf, prihlásenie sa u %2$@ odvolá; inak až po odstránení posledného."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": " Drugi tafi, ki uporabljajo %1$@, obdržijo dostop. Če istega računa tam ne uporablja noben drug taf, se prijava pri %2$@ odvzame; sicer ko je odstranjen zadnji."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": " Tafs-et e tjerë që përdorin %1$@ e mbajnë qasjen e tyre. Nëse asnjë taf tjetër nuk përdor të njëjtën llogari aty, hyrja revokohet te %2$@; përndryshe, kur të hiqet i fundit."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": " Ostali tafovi koji koriste aplikaciju %1$@ zadržavaju svoj pristup. Ako nijedan drugi taf tamo ne koristi isti nalog, prijava se opoziva kod pružatelja %2$@; inače, kad se ukloni poslednji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " taf อื่นที่ใช้ %1$@ ยังคงมีสิทธิ์เข้าถึง หากไม่มี taf อื่นใช้บัญชีเดียวกันที่นั่น การเข้าสู่ระบบจะถูกเพิกถอนที่ %2$@ มิฉะนั้นจะถูกเพิกถอนเมื่อ taf สุดท้ายถูกนำออก"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$@-y ulanýan beýleki taf-lar elýeterligini saklaýar. Eger başga hiç bir taf şol ýerdäki şol bir hasaby ulanmasa, giriş %2$@-da ýatyrylýar; ýogsa soňky aýrylanda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$@ kullanan diğer tafs erişimini korur. Orada aynı hesabı kullanan başka taf yoksa oturum açma %2$@ tarafında iptal edilir; aksi halde sonuncusu kaldırıldığında."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$@ استعمال کرنے والے باقی taf اپنی رسائی رکھتے ہیں۔ اگر کوئی اور taf وہاں وہی اکاؤنٹ استعمال نہ کرے، تو سائن اِن %2$@ پر منسوخ ہو جاتا ہے؛ ورنہ آخری کے ہٹنے پر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": " Các taf khác dùng %1$@ vẫn giữ quyền truy cập. Nếu không taf nào khác dùng cùng tài khoản đó, việc đăng nhập sẽ bị thu hồi tại %2$@; nếu không, nó bị thu hồi khi taf cuối cùng bị gỡ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 其他使用 %1$@ 的 taf 仍保有存取權限。若沒有其他 taf 在該處使用同一個帳號，登入會在 %2$@ 撤銷；否則會在最後一個被移除時撤銷。"
          }
        }
      }
    },
