    "coach.digest_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage stimmt nicht mit dem überein, worum sie bittet, daher kann sie nicht genehmigt werden. Frag Coach nach einem neuen Vorschlag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request doesn't match what it asks for, so it can't be approved. Ask Coach to propose it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud no coincide con lo que pide, así que no se puede aprobar. Pídele a Coach que la vuelva a proponer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande ne correspond pas à ce qu'elle demande : elle ne peut pas être approuvée. Demandez à Coach de la proposer à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa richiesta non corrisponde a ciò che chiede, quindi non può essere approvata. Chiedi a Coach di proporla di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verzoek komt niet overeen met wat het vraagt, dus het kan niet worden goedgekeurd. Je kunt Coach vragen het opnieuw voor te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prośba nie zgadza się z tym, o co prosi, więc nie można jej zatwierdzić. Poproś Coacha, aby zaproponował ją ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido não corresponde ao que pede, por isso não pode ser aprovado. Peça ao Coach para o propor novamente."
          }
        }
      }
    },
