      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach kann seine Tools noch nicht bekommen: Ein anderes Tool in KIFF trägt den Namen eines davon. Benenne es in KIFF um oder entferne es."
