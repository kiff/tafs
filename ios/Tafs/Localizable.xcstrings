        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis prašymas pasikeitė. Prieš atsisakydami perskaitykite jį dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis pieprasījums mainījās. Pirms to noraidi, izlasi to vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verzoek is gewijzigd. Lees het opnieuw voordat je het negeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prośba się zmieniła. Odczytaj ją ponownie, zanim ją odrzucisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido mudou. Leia-o novamente antes de o ignorar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido mudou. Leia-o novamente antes de o ignorar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această solicitare s-a schimbat. Citiți-o din nou înainte de a o respinge."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto žiadosť sa zmenila. Pred zamietnutím si ju prečítajte znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta zahteva se je spremenila. Preden jo opustite, jo znova preberite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo kërkesë ndryshoi. Lexojeni sërish para se ta hidhni poshtë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj se zahtev promenio. Pročitajte ga ponovo pre odbacivanja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอนี้เปลี่ยนไป อ่านอีกครั้งก่อนปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istek değişti. Kapatmadan önce tekrar okuyun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu này đã thay đổi. Hãy đọc lại trước khi bỏ qua."
