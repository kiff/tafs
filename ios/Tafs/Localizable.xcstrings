    "setup.knob.no_subscription": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoşulma hansı abunəliyi yaratdığını demədi. Yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връзката не каза кой абонамент създаде. Опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení neřeklo, jaký odběr vytvořilo. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung hat nicht gesagt, welches Abonnement sie angelegt hat. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection didn't say which subscription it made. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión no indicó qué suscripción hizo. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendus ei öelnud, millise tellimuse see lõi. Proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion n'a pas indiqué quel abonnement elle a créé. Réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza nije rekla koju je pretplatu napravila. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolat nem jelezte, melyik előfizetést hozta létre. Próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կապը չասաց, թե որ բաժանորդագրությունը ստեղծեց։ Փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi tidak menyebutkan langganan mana yang dibuatnya. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento non ha indicato quale iscrizione ha creato. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続先がどの購読を作成したかを示しませんでした。もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კავშირმა არ თქვა, რომელი გამოწერა შექმნა. სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결에서 어떤 구독을 만들었는지 알려 주지 않았습니다. 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryšys nenurodė, kokią prenumeratą sukūrė. Bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Savienojums nepateica, kādu abonementu tas izveidoja. Mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De koppeling zei niet welk abonnement ze heeft gemaakt. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie nie podało, jaką subskrypcję utworzyło. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação não indicou que subscrição fez. Tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão não indicou qual assinatura fez. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea nu a spus ce abonament a creat. Încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojenie nepovedalo, aký odber vytvorilo. Skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezava ni povedala, katero naročnino je ustvarila. Poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidhja nuk tha cilin abonim bëri. Provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza nije rekla koju je pretplatu napravila. Pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อไม่ได้บอกว่าสร้างการสมัครรับข้อมูลใด ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı hangi aboneliği yaptığını söylemedi. Tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối không cho biết nó đã tạo đăng ký nào. Hãy thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線未說明它建立了哪個訂閱。請再試一次。"
          }
        }
      }
    },
