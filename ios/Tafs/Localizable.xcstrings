    "connect.clear_removed.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede wird bei ihrem Anbieter abgemeldet. Eine, die die Card eines anderen tafs nutzt, bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each is signed out at its vendor. One another taf's Card uses is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cierra la sesión de cada una con su proveedor. Se conserva la que use la Card de otro taf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacune est déconnectée chez son fournisseur. Celle qu'utilise la Card d'un autre taf est conservée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ognuno viene effettuata la disconnessione presso il fornitore. Uno usato dalla Card di un altro taf viene mantenuto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke koppeling wordt bij de leverancier uitgelogd. Een koppeling die de Card van een ander taf gebruikt, blijft behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde zostanie wylogowane u swojego dostawcy. To, którego używa Card innego tafa, zostanie zachowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada uma termina a sessão no seu fornecedor. Uma que o Card de outro taf use é mantida."
          }
        }
      }
    },
