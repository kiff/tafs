        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj se događaj promijenio. Pročitajte brojčanik ponovno prije odobravanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az esemény megváltozott. Jóváhagyás előtt olvasd el újra a tárcsát."
