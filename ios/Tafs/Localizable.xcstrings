            "value": "Noraidīt pieprasījumu palielināt tēriņu limitu?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verzoek om de uitgavenlimiet te verhogen afwijzen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucić prośbę o podniesienie limitu wydatków?"
