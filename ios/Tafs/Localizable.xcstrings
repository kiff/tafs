            "value": "Դուք պետք է առնվազն %1$@ տարեկան լինեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Usia Anda minimal %1$@ tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi avere almeno %1$@ anni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@歳以上である必要があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უნდა იყოთ მინიმუმ %1$@ წლის."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만 %1$@세 이상이어야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jums turi būti ne mažiau kaip %1$@ metų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tev jābūt vismaz %1$@ gadus vecam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet minstens %1$@ zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Musisz mieć co najmniej %1$@ lat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem de ter pelo menos %1$@ anos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você precisa ter pelo menos %1$@ anos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trebuie să aveți cel puțin %1$@ ani."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Musí vám byť aspoň %1$@ rokov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stari morate biti vsaj %1$@ let."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Duhet të jeni të paktën %1$@ vjeç."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Morate imati najmanje %1$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณต้องมีอายุอย่างน้อย %1$@ ปี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az %1$@ yaşında olmalısınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn phải từ %1$@ tuổi trở lên."
          }
