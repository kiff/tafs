        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ უსაფრთხოების გასაღებს PIN-ის შემოწმება არ შეუძლია, ამიტომ დამტკიცება არ შეუძლია. ჩართეთ ის, რომელიც ამ კომპიუტერს შეესაბამება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សោសុវត្ថិភាពនេះមិនអាចពិនិត្យ PIN បានទេ ដូច្នេះវាមិនអាចអនុម័តបានទេ។ ដោតសោដែលមកជាមួយកុំព្យូទ័រនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보안 키는 PIN을 확인할 수 없어 승인할 수 없습니다. 이 컴퓨터와 짝을 이룬 키를 꽂으세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກຸນແຈຄວາມປອດໄພນີ້ກວດ PIN ບໍ່ໄດ້ ສະນັ້ນມັນອະນຸມັດບໍ່ໄດ້. ສຽບອັນທີ່ໃຊ້ກັບຄອມພິວເຕີນີ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis saugos raktas negali patikrinti PIN, todėl negali tvirtinti. Prijunkite raktą, susietą su šiuo kompiuteriu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī drošības atslēga nevar pārbaudīt PIN, tāpēc tā nevar apstiprināt. Pievieno to, kas pieder šim datoram."
