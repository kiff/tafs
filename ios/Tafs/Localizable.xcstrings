            "value": "Most egyetlen taf sem használja ezt: %1$@."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոչ մի taf հիմա չի օգտագործում %1$@-ը։"
          }
        },
        "id": {
