    "people.stops_using": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف %1$@ عن استخدام %2$@. تبقى محادثاتهم لهم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ istifadəsini dayandırır. Onun söhbətləri ona məxsus qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ спира да използва %2$@. Чатовете му остават негови."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ ব্যবহার বন্ধ করেন। তাঁর চ্যাট তাঁরই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ deixa de fer servir %2$@. Els seus xats continuen sent seus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ přestane používat %2$@. Jeho chaty zůstávají jeho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nutzt %2$@ nicht mehr. Die Chats bleiben bei ihnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stops using %2$@. Their chats stay theirs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ deja de usar %2$@. Sus chats siguen siendo suyos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ei kasuta enam tafi %2$@. Tema vestlused jäävad talle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cesse d'utiliser %2$@. Ses chats restent les siens."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ מפסיק להשתמש ב-%2$@. השיחות שלו נשארות שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ का उपयोग बंद कर देता है। उनकी चैट उनकी ही रहती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ prestaje koristiti taf %2$@. Njihovi razgovori ostaju njihovi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ többé nem használja ezt: %2$@. A csevegései az övéi maradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը դադարում է օգտագործել %2$@-ը։ Նրա զրույցները մնում են նրանը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ berhenti memakai %2$@. Obrolan mereka tetap milik mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ smette di usare %2$@. Le sue chat restano sue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@を使わなくなります。チャットはその人のものとして残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ წყვეტს %2$@-ის გამოყენებას. მისი ჩატები მასთანვე რჩება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ឈប់ប្រើ %2$@។ ការសន្ទនារបស់ពួកគេនៅជារបស់ពួកគេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 더 이상 %2$@을(를) 사용하지 않습니다. 채팅은 그대로 그 사람의 것으로 남습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ເຊົາໃຊ້ %2$@. ການສົນທະນາຂອງເຂົາເຈົ້າຍັງເປັນຂອງເຂົາເຈົ້າ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nebenaudoja %2$@. Jų pokalbiai lieka jiems."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vairs nelieto %2$@. Savas sarunas %1$@ patur."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ престанува да го користи %2$@. Нивните разговори остануваат нивни."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-ыг ашиглахаа болино. Тэдний чат тэдэнд л үлдэнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ले %2$@ प्रयोग गर्न छाड्छन्। उनीहरूका च्याट उनीहरूकै रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gebruikt %2$@ niet meer. Hun chats blijven van hen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ przestaje używać %2$@. Czaty tej osoby pozostaną jej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ deixa de usar %2$@. Os seus chats continuam a ser seus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ deixa de usar %2$@. Os seus chats continuam sendo seus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nu mai folosește %2$@. Conversațiile sale rămân ale sale."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ prestane používať %2$@. Jeho chaty zostávajú jeho."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ preneha uporabljati %2$@. Njegovi klepeti ostanejo njegovi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pushon së përdoruri %2$@. Bisedat e tyre mbeten të tyret."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ prestaje koristiti taf %2$@. Njihovi razgovori ostaju njihovi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ เลิกใช้ %2$@ แชตของพวกเขายังเป็นของพวกเขา"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-y ulanmagy bes edýär. Olaryň söhbetdeşlikleri özlerinde galýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ taf'ını kullanmayı bırakıyor. Sohbetleri kendilerinin kalır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ استعمال کرنا بند کر دیتا ہے۔ ان کی چیٹس انہی کی رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ngừng dùng %2$@. Các cuộc trò chuyện của họ vẫn là của họ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@停止使用 %2$@。他們的對話仍屬於他們。"
          }
        }
      }
    },
