    "needs_you.sign_in_again_to_answer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الخروج ثم الدخول مرة أخرى لتردّ من هذا الهاتف، ليعرف KIFF مفتاحه. أو ردّ على هذا في KIFF."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefondan cavab vermək üçün çıxıb yenidən daxil olun, ki, KIFF onun açarını tanısın. Və ya buna KIFF-də cavab verin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Излезте и влезте отново, за да отговаряте от този телефон, така че KIFF да познава ключа му. Или отговорете на това в KIFF."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোন থেকে উত্তর দিতে সাইন আউট করে আবার সাইন ইন করুন, যাতে KIFF এর কী চিনতে পারে। অথবা এটির উত্তর KIFF-এ দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanca la sessió i torna-la a iniciar per respondre des d'aquest telèfon, perquè KIFF en conegui la clau. O respon aquesta a KIFF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlaste se a znovu přihlaste, abyste mohli odpovídat z tohoto telefonu a KIFF znal jeho klíč. Nebo na tohle odpovězte v KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich ab und erneut an, um von diesem Telefon zu antworten, damit KIFF seinen Schlüssel kennt. Oder beantworte diese hier in KIFF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out and in again to answer from this phone, so KIFF knows its key. Or answer this one in KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra sesión y vuelve a iniciarla para responder desde este teléfono, así KIFF conoce su clave. O responde a esta en KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellest telefonist vastamiseks logi välja ja uuesti sisse, et KIFF teaks selle võtit. Või vasta sellele KIFFis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous puis reconnectez-vous pour répondre depuis ce téléphone, afin que KIFF connaisse sa clé. Ou répondez à celle-ci dans KIFF."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לצאת ולהיכנס שוב כדי להשיב מהטלפון הזה, כך ש-KIFF יכיר את המפתח שלו. או להשיב על זה ב-KIFF."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन से उत्तर देने के लिए साइन आउट करके फिर साइन इन करें, ताकि KIFF इसकी कुंजी जाने। या इसका उत्तर KIFF में दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavite se i ponovno prijavite da biste odgovarali s ovog telefona, kako bi KIFF znao njegov ključ. Ili odgovorite na ovaj u KIFF-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezz ki és be újra, hogy erről a telefonról válaszolhass, és a KIFF ismerje a kulcsát. Vagy erre a KIFF-ben válaszolj."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դուրս եկեք և նորից մուտք գործեք՝ այս հեռախոսից պատասխանելու համար, որպեսզի KIFF-ը ճանաչի նրա բանալին։ Կամ պատասխանեք սրան KIFF-ում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar lalu masuk lagi untuk menjawab dari ponsel ini, agar KIFF mengenal kuncinya. Atau jawab yang ini di KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci e accedi di nuovo per rispondere da questo telefono, così KIFF conosce la sua chiave. Oppure rispondi a questa in KIFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンから回答するには、サインアウトしてもう一度サインインし、KIFFにキーを認識させてください。または、これはKIFFで回答してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოდით და ხელახლა შედით, რომ ამ ტელეფონიდან უპასუხოთ და KIFF-მა მისი გასაღები იცნოს. ან ამას უპასუხეთ KIFF-ში."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចាកចេញ ហើយចូលម្តងទៀត ដើម្បីឆ្លើយពីទូរសព្ទនេះ ដើម្បីឱ្យ KIFF ស្គាល់កូនសោរបស់វា។ ឬឆ្លើយមួយនេះក្នុង KIFF។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에서 답변하려면 로그아웃한 뒤 다시 로그인해 KIFF가 키를 알게 하세요. 또는 이 요청은 KIFF에서 답변하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອອກຈາກລະບົບ ແລ້ວເຂົ້າສູ່ລະບົບອີກເພື່ອຕອບຈາກໂທລະສັບນີ້ ເພື່ອໃຫ້ KIFF ຮູ້ຈັກກຸນແຈຂອງມັນ. ຫຼື ຕອບອັນນີ້ໃນ KIFF."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsijunkite ir vėl prisijunkite, kad galėtumėte atsakyti iš šio telefono ir KIFF žinotų jo raktą. Arba į šią atsakykite KIFF."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izraksties un pieraksties vēlreiz, lai atbildētu no šī tālruņa un KIFF zinātu tā atslēgu. Vai atbildi uz šo KIFF."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одјави се и најави се повторно за да одговараш од овој телефон, за KIFF да го знае неговиот клуч. Или одговори на овој во KIFF."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ утаснаас хариулахын тулд гараад дахин нэвтэрнэ үү, ингэснээр KIFF түүний түлхүүрийг мэднэ. Эсвэл үүнд KIFF дээр хариулна уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो फोनबाट जवाफ दिन साइन आउट गरेर फेरि साइन इन गर्नुहोस्, ताकि KIFF ले यसको कुञ्जी चिन्छ। वा यसको जवाफ KIFF मा दिनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log uit en opnieuw in om vanaf deze telefoon te antwoorden, zodat KIFF de sleutel kent. Of beantwoord deze in KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyloguj się i zaloguj ponownie, aby odpowiadać z tego telefonu, żeby KIFF znał jego klucz. Albo odpowiedz na to w KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine a sessão e inicie sessão novamente para responder a partir deste telefone, para que o KIFF conheça a sua chave. Ou responda a este no KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre a sessão e entre novamente para responder a partir deste telefone, para que o KIFF conheça a sua chave. Ou responda a este no KIFF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectați-vă și conectați-vă din nou pentru a răspunde de pe acest telefon, ca KIFF să-i cunoască cheia. Sau răspundeți la aceasta în KIFF."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhláste sa a znova prihláste, aby ste mohli odpovedať z tohto telefónu a KIFF poznal jeho kľúč. Alebo na toto odpovedzte v KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavite se in znova prijavite, da boste lahko odgovarjali s tega telefona in bo KIFF poznal njegov ključ. Ali pa na to odgovorite v KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilni dhe hyni sërish për t'u përgjigjur nga ky telefon, që KIFF ta njohë çelësin e tij. Ose përgjigjuni kësaj në KIFF."
