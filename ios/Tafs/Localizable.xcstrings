        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene eseguito nulla finché non lo riprendi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開するまで何も実行されません"
