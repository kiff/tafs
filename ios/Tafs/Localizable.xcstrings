          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთავრდება %1$@, თუ არ გამოიყენება"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하지 않으면 %1$@에 끝남"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "baigsis %1$@, jei nebus naudojama"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "beigsies %1$@, ja netiks izmantots"
          }
        },
        "nl": {
