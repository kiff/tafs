        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خریداری منظوری کا انتظار کر رہی ہے۔ مکمل ہونے پر آپ کے کریڈٹس شامل ہو جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch mua đang chờ phê duyệt. Tín dụng của bạn được thêm khi hoàn tất."
