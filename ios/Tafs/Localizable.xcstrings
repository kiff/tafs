        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je zaključan posle previše pokušaja. Zaključajte ovaj uređaj (%2$@), otključajte ga šifrom, pa proverite ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ถูกล็อกเพราะลองหลายครั้งเกินไป ล็อก%2$@เครื่องนี้ ปลดล็อกด้วยรหัสผ่าน แล้วตรวจสอบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla denemeden sonra kilitlendi: %1$@. Bu %2$@ cihazını kilitleyin, parolasıyla açın, sonra tekrar kontrol edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bị khóa sau quá nhiều lần thử. Hãy khóa %2$@ này, mở bằng mật mã của nó, rồi kiểm tra lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@因嘗試次數過多而鎖定。請鎖定這部%2$@，用其密碼解鎖，然後再次檢查。"
          }
        }
      }
    },
