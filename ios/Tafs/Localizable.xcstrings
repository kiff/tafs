        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF не може да го додаде ова купување на оваа сметка. Го плати, па јави се на поддршката на support@kiff.dev и ќе го средиме."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF энэ худалдан авалтыг энэ бүртгэлд нэмж чадахгүй. Та үүний төлбөрийг төлсөн тул support@kiff.dev хаягаар дэмжлэгтэй холбогдоно уу, бид шийднэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ले यो खरिद यस खातामा थप्न सक्दैन। तपाईंले यसको भुक्तानी गर्नुभएको छ, त्यसैले support@kiff.dev मा सहायतासँग सम्पर्क गर्नुहोस् र हामी मिलाउँछौँ।"
          }
        },
        "nl": {
          "stringUnit": {
