    "settings.delete_account.connections_left": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-larınız silindi, amma qoşulmalarınız hələ silinməyib. %1$@"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите tafs са изтрити, но връзките ви още не. %1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy jsou vymazané, ale vaše připojení zatím ne. %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs sind gelöscht, deine Verbindungen aber noch nicht. %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tafs are erased, but your connections aren't yet. %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tafs se borraron, pero tus conexiones aún no. %1$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tafid on kustutatud, kuid sinu ühendused veel mitte. %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tafs sont effacés, mais pas encore vos connexions. %1$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši su tafovi izbrisani, ali vaše veze još nisu. %1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafjaid törölve, de a kapcsolataid még nem. %1$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր taf-երը ջնջվեցին, բայց ձեր կապերը դեռ ոչ։ %1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs Anda dihapus, tetapi koneksi Anda belum. %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tafs sono cancellati, ma i tuoi collegamenti non ancora. %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsは消去されましたが、接続はまだ消去されていません。%1$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი taf-ები წაიშალა, მაგრამ თქვენი კავშირები ჯერ არა. %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs는 삭제되었지만 연결은 아직 삭제되지 않았습니다. %1$@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų taf ištrinti, bet ryšiai dar ne. %1$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavi taf ir izdzēsti, bet tavi savienojumi vēl ne. %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tafs zijn gewist, maar je koppelingen nog niet. %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje tafs zostały usunięte, ale Twoje połączenia jeszcze nie. %1$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs foram apagados, mas as suas ligações ainda não. %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs foram apagados, mas as suas conexões ainda não. %1$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafurile dvs. sunt șterse, dar conexiunile încă nu. %1$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy sú vymazané, ale vaše pripojenia zatiaľ nie. %1$@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafi so izbrisani, vaše povezave pa še ne. %1$@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs-et tuaj u fshinë, por lidhjet tuaja ende jo. %1$@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši su tafovi izbrisani, ali vaše veze još nisu. %1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ taf ของคุณแล้ว แต่ยังไม่ได้ลบการเชื่อมต่อ %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs'larınız silindi ama bağlantılarınız henüz silinmedi. %1$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các taf của bạn đã bị xóa, nhưng các kết nối của bạn thì chưa. %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 taf 已清除，但您的連線尚未清除。%1$@"
          }
        }
      }
    },
