    "door.api.two_keys": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ən çoxu iki açar, ki, birini digərini dayandırmadan dəyişə biləsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Най-много два ключа, за да можете да смените единия, без да спирате другия."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejvýš dva klíče, takže jeden můžete nahradit, aniž zastavíte druhý."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens zwei Schlüssel, damit du einen ersetzen kannst, ohne den anderen zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most two keys, so you can replace one without stopping the other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como máximo dos claves, para que puedas sustituir una sin detener la otra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõige rohkem kaks võtit, et saaksid ühe asendada nii, et teine töötab edasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux clés au plus, pour pouvoir en remplacer une sans arrêter l'autre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviše dva ključa, tako da jedan možete zamijeniti bez zaustavljanja drugog."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb két kulcs, hogy az egyiket a másik leállítása nélkül cserélhesd."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առավելագույնը երկու բանալի, որպեսզի մեկը փոխարինեք՝ մյուսը չկանգնեցնելով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paling banyak dua kunci, agar Anda dapat mengganti satu tanpa menghentikan yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo due chiavi, così puoi sostituirne una senza fermare l'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは最大2つなので、一方を止めずにもう一方を置き換えられます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მაქსიმუმ ორი გასაღები, რომ ერთი შეცვალოთ მეორის გაჩერების გარეშე."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 최대 두 개라서, 하나를 교체하는 동안 다른 하나를 멈추지 않아도 됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Daugiausia du raktai, kad galėtumėte pakeisti vieną, o kitas veiktų toliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vairāk kā divas atslēgas, lai vienu varētu nomainīt, kamēr otra darbojas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogstens twee sleutels, zodat je er een kunt vervangen zonder de andere te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwyżej dwa klucze, aby można było wymienić jeden bez zatrzymywania drugiego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo duas chaves, para poder substituir uma sem parar a outra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo duas chaves, para poder substituir uma sem parar a outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mult două chei, ca să puteți înlocui una fără să o opriți pe cealaltă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviac dva kľúče, takže jeden môžete nahradiť bez zastavenia druhého."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Največ dva ključa, da lahko enega zamenjate, ne da bi ustavili drugega."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Më së shumti dy çelësa, që të mund të zëvendësoni njërin pa ndalur tjetrin."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviše dva ključa, tako da jedan možete zameniti bez zaustavljanja drugog."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีได้สูงสุดสองกุญแจ เพื่อให้คุณเปลี่ยนอันหนึ่งได้โดยไม่ต้องหยุดอีกอัน"
          }
        },
