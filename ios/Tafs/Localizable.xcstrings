    "push.channel.briefs_description": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xülasəniz təyin olunmuş vaxtlarda."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашето резюме в зададените часове."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš přehled v nastavených časech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Briefing zu den festen Zeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your brief at its set times."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu resumen a sus horas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu kokkuvõte määratud aegadel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre briefing aux heures prévues."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš sažetak u zadano vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összefoglalód a beállított időpontokban."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր ամփոփումը սահմանված ժամերին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringkasan Anda pada waktu yang ditentukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo riepilogo ai suoi orari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した時刻に届くブリーフィング。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი მიმოხილვა დადგენილ დროს."
          }
        },
        "ko": {
