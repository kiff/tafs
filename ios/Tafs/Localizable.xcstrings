    "sample.brief.pay.question": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 Verspätungsnachrichten für Pakete senden, die Freitag fällig sind?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send 3 delay messages for parcels due Friday?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Enviar 3 avisos de retraso para paquetes que vencen el viernes?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas saata 3 hilinemise sõnumit pakkide kohta, mis peaksid jõudma reedel?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer 3 messages de retard pour des colis attendus vendredi ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviare 3 avvisi di ritardo per pacchi attesi venerdì?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金曜日到着予定の荷物について、遅延のお知らせを3件送りますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금요일 도착 예정인 소포에 대한 지연 안내 메시지 3개를 보낼까요?"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išsiųsti 3 pranešimus apie vėlavimą dėl siuntinių, kurie turi atvykti penktadienį?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosūtīt 3 ziņas par kavēšanos pakām, kurām jāpienāk piektdien?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3 vertragingsberichten sturen voor pakketten die vrijdag verwacht worden?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłać 3 wiadomości o opóźnieniu dla paczek na piątek?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar 3 avisos de atraso para encomendas previstas para sexta?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar 3 avisos de atraso para encomendas previstas para sexta?"
          }
        }
      }
    },
    "sample.brief.pay.why": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei allen dreien bestätigt der Versanddienst die Verspätung, und %1$@ hat sie geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All three are confirmed late by the carrier and were checked by %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El transportista confirma el retraso de los tres y %1$@ los revisó."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedaja on kinnitanud, et kõik kolm hilinevad, ja %1$@ on need üle kontrollinud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transporteur confirme le retard des trois, et %1$@ les a vérifiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il corriere conferma il ritardo di tutti e tre e %1$@ li ha controllati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3件とも配送業者が遅延を確認しており、%1$@がチェック済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 건 모두 택배사가 지연을 확인했으며 %1$@이(가) 점검했습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vežėjas patvirtino, kad visi trys vėluoja, ir juos patikrino %1$@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārvadātājs ir apstiprinājis, ka visas trīs kavējas, un %1$@ to pārbaudīja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vervoerder bevestigt de vertraging van alle drie, en %1$@ heeft ze gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przewoźnik potwierdza opóźnienie wszystkich trzech, a %1$@ je sprawdził."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A transportadora confirma o atraso das três e o %1$@ verificou-as."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transportadora confirma o atraso das três e o %1$@ verificou-as."
          }
        }
      }
    },
