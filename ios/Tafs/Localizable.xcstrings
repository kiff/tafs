    "coach.taken.named": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach hələ alətlərini ala bilmir: KIFF-də başqa alətin adı %1$@-dir. Onu KIFF-də adını dəyişin və ya silin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach още не може да получи инструментите си: друг инструмент в KIFF се казва %1$@. Преименувайте го или го премахнете в KIFF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach zatím nemůže dostat své nástroje: jiný nástroj v KIFF se jmenuje %1$@. Přejmenujte ho nebo odstraňte v KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach kann seine Tools noch nicht bekommen: Ein anderes Tool in KIFF heißt %1$@. Benenne es in KIFF um oder entferne es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach can't have its tools yet: another tool in KIFF is named %1$@. Rename or remove it in KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach aún no puede tener sus herramientas: otra herramienta en KIFF se llama %1$@. Cámbiale el nombre o elimínala en KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ei saa veel oma tööriistu: KIFFis on teine tööriist nimega %1$@. Nimeta see KIFFis ümber või eemalda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ne peut pas encore avoir ses outils : un autre outil dans KIFF s'appelle %1$@. Renommez-le ou supprimez-le dans KIFF."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach još ne može imati svoje alate: drugi alat u KIFF-u zove se %1$@. Preimenujte ga ili uklonite u KIFF-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Coach még nem kaphatja meg az eszközeit: a KIFF-ben egy másik eszköz neve %1$@. Nevezd át vagy távolítsd el a KIFF-ben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-ը դեռ չի կարող ունենալ իր գործիքները․ KIFF-ում մեկ այլ գործիք կոչվում է %1$@։ Վերանվանեք կամ հեռացրեք KIFF-ում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach belum dapat memiliki alatnya: alat lain di KIFF bernama %1$@. Ganti namanya atau hapus di KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach non può ancora avere i suoi strumenti: un altro strumento in KIFF si chiama %1$@. Rinominalo o rimuovilo in KIFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coachはまだツールを持てません：KIFFに%1$@という名前の別のツールがあります。KIFFで名前を変更するか削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-ს ჯერ ვერ ექნება თავისი ინსტრუმენტები: KIFF-ში სხვა ინსტრუმენტს ჰქვია %1$@. გადაარქვით ან ამოიღეთ KIFF-ში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 Coach에게 도구를 줄 수 없습니다: KIFF에 이름이 %1$@인 다른 도구가 있습니다. KIFF에서 이름을 바꾸거나 삭제하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dar negali gauti savo įrankių: kitas KIFF įrankis vadinasi %1$@. Pervadinkite arba pašalinkite jį KIFF."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach vēl nevar saņemt savus rīkus: citam rīkam KIFF ir nosaukums %1$@. Pārdēvē vai noņem to KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach kan zijn tools nog niet krijgen: een andere tool in KIFF heet %1$@. Hernoem of verwijder die in KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach nie może jeszcze dostać swoich narzędzi: inne narzędzie w KIFF nazywa się %1$@. Zmień jego nazwę lub usuń je w KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach ainda não pode ter as suas ferramentas: outra ferramenta no KIFF chama-se %1$@. Mude-lhe o nome ou remova-a no KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach ainda não pode ter as ferramentas dele: outra ferramenta no KIFF se chama %1$@. Renomeie ou remova essa ferramenta no KIFF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach nu își poate primi încă instrumentele: alt instrument din KIFF se numește %1$@. Redenumiți-l sau eliminați-l în KIFF."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach zatiaľ nemôže dostať svoje nástroje: iný nástroj v KIFF sa volá %1$@. Premenujte ho alebo odstráňte v KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach še ne more dobiti svojih orodij: drugo orodje v KIFF se imenuje %1$@. Preimenujte ga ali odstranite v KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach nuk mund t'i ketë ende mjetet e tij: një mjet tjetër në KIFF quhet %1$@. Riemërtojeni ose hiqeni në KIFF."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach još ne može imati svoje alate: drugi alat u KIFF-u zove se %1$@. Preimenujte ga ili uklonite u KIFF-u."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ยังมีเครื่องมือของมันไม่ได้: เครื่องมืออื่นใน KIFF ใช้ชื่อ %1$@ แล้ว เปลี่ยนชื่อหรือนำออกใน KIFF"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach henüz araçlarına sahip olamaz: KIFF'te başka bir aracın adı %1$@. KIFF'te adını değiştirin veya kaldırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach chưa thể có công cụ của nó: một công cụ khác trong KIFF đã mang tên %1$@. Hãy đổi tên hoặc gỡ nó trong KIFF."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach 目前還不能擁有它的工具：KIFF 中已有另一個工具名為 %1$@。請在 KIFF 中重新命名或移除它。"
          }
        }
      }
    },
    "coach.taken.unnamed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach hələ alətlərini ala bilmir: KIFF-də başqa alətin adı onlardan biri ilə eynidir. Onu KIFF-də adını dəyişin və ya silin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach още не може да получи инструментите си: друг инструмент в KIFF носи името на един от тях. Преименувайте го или го премахнете в KIFF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach zatím nemůže dostat své nástroje: jiný nástroj v KIFF se jmenuje stejně jako jeden z nich. Přejmenujte ho nebo odstraňte v KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach kann seine Tools noch nicht bekommen: Ein anderes Tool in KIFF trägt den Namen eines davon. Benenne es in KIFF um oder entferne es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach can't have its tools yet: another tool in KIFF is named as one of them. Rename or remove it in KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach aún no puede tener sus herramientas: otra herramienta en KIFF tiene el nombre de una de ellas. Cámbiale el nombre o elimínala en KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ei saa veel oma tööriistu: KIFFis on teine tööriist, millel on sama nimi kui ühel neist. Nimeta see KIFFis ümber või eemalda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ne peut pas encore avoir ses outils : un autre outil dans KIFF porte le nom de l'un d'eux. Renommez-le ou supprimez-le dans KIFF."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach još ne može imati svoje alate: drugi alat u KIFF-u zove se kao jedan od njih. Preimenujte ga ili uklonite u KIFF-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Coach még nem kaphatja meg az eszközeit: a KIFF-ben egy másik eszköz ugyanazt a nevet viseli, mint az egyikük. Nevezd át vagy távolítsd el a KIFF-ben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-ը դեռ չի կարող ունենալ իր գործիքները․ KIFF-ում մեկ այլ գործիք կոչվում է դրանցից մեկի անունով։ Վերանվանեք կամ հեռացրեք KIFF-ում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach belum dapat memiliki alatnya: alat lain di KIFF bernama sama dengan salah satunya. Ganti namanya atau hapus di KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach non può ancora avere i suoi strumenti: un altro strumento in KIFF ha il nome di uno di essi. Rinominalo o rimuovilo in KIFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coachはまだツールを持てません：KIFFに同じ名前の別のツールがあります。KIFFで名前を変更するか削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-ს ჯერ ვერ ექნება თავისი ინსტრუმენტები: KIFF-ში სხვა ინსტრუმენტს ჰქვია ერთ-ერთის სახელი. გადაარქვით ან ამოიღეთ KIFF-ში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 Coach에게 도구를 줄 수 없습니다: KIFF에 같은 이름의 다른 도구가 있습니다. KIFF에서 이름을 바꾸거나 삭제하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dar negali gauti savo įrankių: kitas KIFF įrankis vadinasi taip pat kaip vienas iš jų. Pervadinkite arba pašalinkite jį KIFF."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach vēl nevar saņemt savus rīkus: citam rīkam KIFF ir tāds pats nosaukums kā vienam no tiem. Pārdēvē vai noņem to KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach kan zijn tools nog niet krijgen: een andere tool in KIFF heeft de naam van een ervan. Hernoem of verwijder die in KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach nie może jeszcze dostać swoich narzędzi: inne narzędzie w KIFF nazywa się tak jak jedno z nich. Zmień jego nazwę lub usuń je w KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach ainda não pode ter as suas ferramentas: outra ferramenta no KIFF tem o nome de uma delas. Mude-lhe o nome ou remova-a no KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach ainda não pode ter as ferramentas dele: outra ferramenta no KIFF tem o nome de uma delas. Renomeie ou remova essa ferramenta no KIFF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach nu își poate primi încă instrumentele: alt instrument din KIFF are același nume ca unul dintre ele. Redenumiți-l sau eliminați-l în KIFF."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach zatiaľ nemôže dostať svoje nástroje: iný nástroj v KIFF sa volá rovnako ako jeden z nich. Premenujte ho alebo odstráňte v KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach še ne more dobiti svojih orodij: drugo orodje v KIFF se imenuje kot eno od njih. Preimenujte ga ali odstranite v KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach nuk mund t'i ketë ende mjetet e tij: një mjet tjetër në KIFF quhet si një prej tyre. Riemërtojeni ose hiqeni në KIFF."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach još ne može imati svoje alate: drugi alat u KIFF-u zove se kao jedan od njih. Preimenujte ga ili uklonite u KIFF-u."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ยังมีเครื่องมือของมันไม่ได้: เครื่องมืออื่นใน KIFF ใช้ชื่อซ้ำกับหนึ่งในนั้น เปลี่ยนชื่อหรือนำออกใน KIFF"
          }
        },
        "tr": {
