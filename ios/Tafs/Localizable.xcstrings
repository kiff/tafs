    "version.go_back_body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ versiyasının sınaq Card-ı dərhal dayanır və bu söhbət silinir. %2$@ olduğu kimi işləməyə davam edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробната Card на версия %1$@ спира веднага и този чат се изтрива. %2$@ продължава да работи както досега."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební Card verze %1$@ hned skončí a tento chat se smaže. %2$@ dál pracuje jako dosud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Test-Card von Version %1$@ stoppt sofort, und dieser Chat wird gelöscht. %2$@ arbeitet weiter wie bisher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %3$@ trial Card stops at once, and this chat is deleted. %2$@ keeps working as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Card de prueba de la versión %1$@ se detiene al instante, y este chat se elimina. %2$@ sigue funcionando como está."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiooni %1$@ proovi Card lõpeb kohe ja see vestlus kustutatakse. %2$@ töötab edasi nagu praegu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Card d'essai de la version %1$@ s'arrête immédiatement, et ce chat est supprimé. %2$@ continue de fonctionner tel quel."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Probni Card verzije %1$@ odmah prestaje, a ovaj razgovor se briše. Taf %2$@ nastavlja raditi kakav jest."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@. verzió próba-Cardja azonnal leáll, és ez a csevegés törlődik. %2$@ úgy dolgozik tovább, ahogy eddig."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տարբերակ %1$@-ի փորձնական Card-ը անմիջապես դադարում է, և այս զրույցը ջնջվում է։ %2$@-ը շարունակում է աշխատել ինչպես կա։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Card uji coba versi %1$@ langsung berhenti, dan obrolan ini dihapus. %2$@ tetap bekerja seperti sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Card di prova della versione %1$@ si ferma subito, e questa chat viene eliminata. %2$@ continua a lavorare com'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン%1$@の試用Cardはすぐに停止し、このチャットは削除されます。%2$@はそのまま動き続けます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერსია %1$@-ის საცდელი Card მაშინვე ჩერდება და ეს ჩატი იშლება. %2$@ აგრძელებს მუშაობას ისე, როგორც არის."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 %1$@의 시험 Card는 즉시 멈추고 이 채팅은 삭제됩니다. %2$@은(는) 지금처럼 계속 작동합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ versijos bandomoji Card iškart nustoja galioti, o šis pokalbis ištrinamas. %2$@ dirba toliau kaip anksčiau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Versijas %1$@ izmēģinājuma Card tūlīt apstājas, un šī saruna tiek dzēsta. %2$@ turpina strādāt tāpat kā līdz šim."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De proef-Card van versie %1$@ stopt meteen, en deze chat wordt verwijderd. %2$@ blijft werken zoals het is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Card próbna wersji %1$@ natychmiast przestaje działać, a ten czat zostanie usunięty. %2$@ działa dalej bez zmian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Card de experiência da versão %1$@ para de imediato, e este chat é eliminado. %2$@ continua a funcionar como está."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Card de experiência da versão %1$@ deixa de valer imediatamente, e este chat é excluído. %2$@ continua funcionando como está."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardul de probă al versiunii %1$@ se oprește imediat, iar această conversație se șterge. %2$@ continuă să lucreze ca acum."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúšobná Card verzie %1$@ hneď skončí a tento chat sa odstráni. %2$@ ďalej pracuje ako doteraz."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskusna Card različice %1$@ se takoj ustavi in ta klepet se izbriše. %2$@ še naprej dela, kot dela."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-i provë i versionit %1$@ ndalon menjëherë, dhe kjo bisedë fshihet. %2$@ vazhdon të punojë siç është."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Probni Card verzije %1$@ odmah prestaje, a ovaj razgovor se briše. Taf %2$@ nastavlja raditi kakav jeste."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Card ทดลองของเวอร์ชัน %1$@ จะหยุดทันที และแชตนี้จะถูกลบ %2$@ ทำงานต่อตามที่เป็นอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. sürümün deneme Card'ı hemen durur ve bu sohbet silinir. %2$@ olduğu gibi çalışmaya devam eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Card thử nghiệm của phiên bản %1$@ dừng ngay, và cuộc trò chuyện này bị xóa. %2$@ tiếp tục làm việc như hiện tại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %1$@ 的試用 Card 會立即停止，且這個對話會被刪除。%2$@ 會維持現狀繼續運作。"
          }
        }
      }
    },
    "version.go_back_title": {
