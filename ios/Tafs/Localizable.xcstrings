    "chat.cap.cost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat gestoppt: Diese Aufgabe würde mehr kosten als sein Limit für eine Aufgabe. Bitte um etwas Engeres, oder jemand, der %1$@ verwaltet, kann das Limit erhöhen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stopped: this task would cost more than its limit for one task. Ask for something narrower, or someone who manages %1$@ can raise the limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detuvo: esta tarea costaría más que su límite por tarea. Pide algo más concreto, o alguien que gestione %1$@ puede subir el límite."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lõpetas: see ülesanne läheks maksma rohkem kui selle ühe ülesande limiit. Küsi midagi kitsamat või tafi %1$@ haldaja saab limiiti suurendada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s'est arrêté : cette tâche coûterait plus que sa limite pour une tâche. Demandez quelque chose de plus ciblé, ou une personne qui gère %1$@ peut relever la limite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si è fermato: questa attività costerebbe più del suo limite per un'attività. Chiedi qualcosa di più circoscritto, oppure chi gestisce %1$@ può aumentare il limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が停止しました：このタスクは1タスクあたりの費用の上限を超えます。範囲を絞って依頼するか、%1$@を管理する人に上限を引き上げてもらってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 멈췄습니다: 이 작업은 작업 1건 한도보다 비용이 많이 듭니다. 범위를 좁혀 요청하거나, %1$@을(를) 관리하는 사람이 한도를 올릴 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sustojo: ši užduotis kainuotų daugiau nei jos limitas vienai užduočiai. Paprašykite ko nors siauresnio arba limitą gali padidinti tas, kas valdo %1$@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ apstājās: šis uzdevums maksātu vairāk par tā limitu vienam uzdevumam. Palūdz kaut ko šaurāku, vai arī kāds, kas pārvalda %1$@, var palielināt limitu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gestopt: deze taak zou meer kosten dan de limiet voor één taak. Vraag om iets kleiners, of iemand die %1$@ beheert kan de limiet verhogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatrzymał się: to zadanie kosztowałoby więcej niż jego limit na jedno zadanie. Poproś o coś węższego albo osoba zarządzająca %1$@ może podnieść limit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: esta tarefa custaria mais do que o seu limite por tarefa. Peça algo mais restrito, ou alguém que gere %1$@ pode aumentar o limite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: esta tarefa custaria mais do que o seu limite por tarefa. Peça algo mais restrito, ou alguém que gerencia %1$@ pode aumentar o limite."
          }
        }
      }
    },
    "chat.cap.turns": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat gestoppt: Diese Aufgabe brauchte mehr Schritte als sein Limit für eine Aufgabe. Bitte um etwas Engeres."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stopped: this task took more steps than its limit for one task. Ask for something narrower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detuvo: esta tarea necesitó más pasos que su límite por tarea. Pide algo más concreto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lõpetas: see ülesanne võttis rohkem samme kui selle ühe ülesande limiit. Küsi midagi kitsamat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s'est arrêté : cette tâche a pris plus d'étapes que sa limite pour une tâche. Demandez quelque chose de plus ciblé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si è fermato: questa attività ha richiesto più passi del suo limite per un'attività. Chiedi qualcosa di più circoscritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が停止しました：このタスクは1タスクあたりの手順の上限を超えました。範囲を絞って依頼してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 멈췄습니다: 이 작업은 작업 1건 한도보다 단계가 많았습니다. 범위를 좁혀 요청하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sustojo: šiai užduočiai prireikė daugiau žingsnių nei leidžia limitas vienai užduočiai. Paprašykite ko nors siauresnio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ apstājās: šim uzdevumam vajadzēja vairāk soļu, nekā atļauj tā limits vienam uzdevumam. Palūdz kaut ko šaurāku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gestopt: deze taak had meer stappen nodig dan de limiet voor één taak. Vraag om iets kleiners."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatrzymał się: to zadanie wymagało więcej kroków niż jego limit na jedno zadanie. Poproś o coś węższego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: esta tarefa precisou de mais passos do que o seu limite por tarefa. Peça algo mais restrito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: esta tarefa precisou de mais passos do que o seu limite por tarefa. Peça algo mais restrito."
          }
        }
      }
    },
