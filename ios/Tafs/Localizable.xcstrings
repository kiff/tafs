    "sign_in.relink.code_expired": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodun vaxtı brauzerinizdə təsdiq olunmamışdan əvvəl bitdi. Yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
