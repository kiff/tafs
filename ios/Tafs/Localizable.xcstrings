    "receipt.signed_on_device_why": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Antwort wurde nach %1$@ mit einem Schlüssel signiert, der dieses Gerät nie verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answer was signed with a key that never leaves this device, after %1$@."
