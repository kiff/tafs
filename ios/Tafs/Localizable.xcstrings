          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je chats zijn niet geëxporteerd: deze %1$@ kon de bestanden niet opslaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje czaty nie zostały wyeksportowane: ten %1$@ nie mógł zapisać plików."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
