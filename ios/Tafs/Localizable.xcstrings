    "door.swipe_up_down_pick_door": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qapı seçmək üçün yuxarı və ya aşağı çəkin. Açmaq və ya bağlamaq üçün iki dəfə toxunun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плъзнете нагоре или надолу, за да изберете врата. Докоснете два пъти, за да я отворите или затворите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetím nahoru nebo dolů vyberte dveře. Dvojitým klepnutím je otevřete nebo zavřete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach oben oder unten, um eine Tür zu wählen. Doppeltippe, um sie zu öffnen oder zu schließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up or down to pick a door. Double-tap to open or close it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba o abajo para elegir una puerta. Toca dos veces para abrirla o cerrarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukse valimiseks pühi üles või alla. Avamiseks või sulgemiseks topeltpuuduta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers le haut ou le bas pour choisir une porte. Touchez deux fois pour l'ouvrir ou la fermer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevucite gore ili dolje da odaberete vrata. Dvaput dodirnite za otvaranje ili zatvaranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd fel vagy le az ajtó kiválasztásához. Koppints duplán a megnyitáshoz vagy bezáráshoz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահեցրեք վերև կամ ներքև՝ դուռ ընտրելու համար։ Կրկնակի հպեք՝ բացելու կամ փակելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser ke atas atau bawah untuk memilih pintu. Ketuk dua kali untuk membuka atau menutupnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri su o giù per scegliere una porta. Tocca due volte per aprirla o chiuderla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にスワイプして窓口を選び、ダブルタップで開閉します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადაისვით ზევით ან ქვევით კარის ასარჩევად. ორჯერ შეეხეთ გასახსნელად ან დასახურად."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래로 쓸어 창구를 고르세요. 두 번 탭하면 열거나 닫습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Braukite aukštyn arba žemyn, kad pasirinktumėte duris. Dukart palieskite, kad atidarytumėte ar uždarytumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Velc uz augšu vai uz leju, lai izvēlētos durvis. Pieskaries divreiz, lai tās atvērtu vai aizvērtu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg omhoog of omlaag om een deur te kiezen. Tik twee keer om hem te openen of te sluiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w górę lub w dół, aby wybrać drzwi. Stuknij dwukrotnie, aby je otworzyć lub zamknąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para cima ou para baixo para escolher uma porta. Toque duas vezes para a abrir ou fechar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para cima ou para baixo para escolher uma porta. Toque duas vezes para a abrir ou fechar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați în sus sau în jos pentru a alege o ușă. Atingeți de două ori pentru a o deschide sau a o închide."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutím nahor alebo nadol vyberte dvere. Dvojitým ťuknutím ich otvoríte alebo zatvoríte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsajte gor ali dol za izbiro vrat. Dvakrat tapnite, da jih odprete ali zaprete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Rrëshqitni lart ose poshtë për të zgjedhur një portë. Prekni dy herë për ta hapur ose mbyllur."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevucite gore ili dole da odaberete vrata. Dvaput dodirnite za otvaranje ili zatvaranje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดขึ้นหรือลงเพื่อเลือกประตู แตะสองครั้งเพื่อเปิดหรือปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kapı seçmek için yukarı veya aşağı kaydırın. Açmak veya kapatmak için çift dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt lên hoặc xuống để chọn một cửa. Chạm đúp để mở hoặc đóng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向下滑動以選擇門。輕點兩下即可開啟或關閉。"
          }
        }
      }
    },
