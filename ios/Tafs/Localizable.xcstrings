        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nu a revocat %1$@ dintre Cardurile sale: revocați-le în KIFF."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF neodvolal %1$@ jeho Card: odvolajte ich v KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ni odvzel %1$@ njegovih Card: odvzemite jih v KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nuk revokoi %1$@ nga Card-et e tij: revokojini në KIFF."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nije opozvao %1$@ njegovih Cardova: opozovite ih u KIFF-u."
          }
        },
        "th": {
