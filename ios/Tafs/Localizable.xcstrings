    "sample.leads.job": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ على العملاء المحتملين الجدد خلال ساعة واحدة واحجز مكالمة. الخصومات تنتظر موافقتك. لا تعد بسعر ليس في قائمة الأسعار أبدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni potensial müştərilərə bir saat ərzində cavab verin və zəng təyin edin. Endirimlər sizi gözləyir. Qiymət siyahısında olmayan qiyməti heç vaxt vəd etməyin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговаряйте на новите потенциални клиенти до час и насрочвайте разговор. Отстъпките ви чакат. Никога не обещавайте цена, която не е в ценовата листа."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন লিডদের এক ঘণ্টার মধ্যে উত্তর দিন এবং একটি কল নির্ধারণ করুন। ছাড় আপনার অপেক্ষায় থাকে। দামের তালিকায় নেই এমন দামের প্রতিশ্রুতি কখনও দেবেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Respon els nous potencials clients en menys d'una hora i reserva una trucada. Els descomptes t'esperen a tu. Mai no prometis un preu que no sigui a la llista de preus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídat na nové poptávky do hodiny a domlouvat schůzky. Slevy čekají na vás. Nikdy neslibovat cenu, která není v ceníku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworte neuen Leads innerhalb einer Stunde und vereinbare ein Gespräch. Rabatte warten auf dich. Versprich nie einen Preis, der nicht in der Preisliste steht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply to new leads within the hour and book a call. Discounts wait for you. Never promise a price that isn't on the price list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder a los nuevos contactos en menos de una hora y reservar una llamada. Los descuentos esperan tu aprobación. Nunca prometer un precio que no esté en la lista de precios."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasta uutele müügivihjetele tunni jooksul ja broneeri kõne. Allahindlused ootavad sind. Ära kunagi luba hinda, mida hinnakirjas pole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondre aux nouveaux prospects dans l'heure et fixer un appel. Les remises vous attendent. Ne jamais promettre un prix absent de la grille tarifaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לענות ללידים חדשים בתוך שעה ולקבוע שיחה. הנחות ממתינות לך. לעולם לא להבטיח מחיר שאינו במחירון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए संभावित ग्राहकों को घंटे भर में उत्तर दें और कॉल तय करें। छूट आपके इंतज़ार में रहती है। जो दाम मूल्य सूची में नहीं है उसका वादा कभी न करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovarajte novim potencijalnim kupcima unutar sat vremena i zakažite poziv. Popusti čekaju vas. Nikad ne obećavajte cijenu koje nema u cjeniku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszolj az új érdeklődőknek egy órán belül, és foglalj hívást. A kedvezmények rád várnak. Soha ne ígérj olyan árat, amely nincs az árlistán."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատասխանեք նոր պոտենցիալ հաճախորդներին մեկ ժամվա ընթացքում և ամրագրեք զանգ։ Զեղչերը սպասում են ձեզ։ Երբեք մի խոստացեք գին, որ գնացուցակում չկա։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balas calon pelanggan baru dalam satu jam dan jadwalkan panggilan. Diskon menunggu Anda. Jangan pernah menjanjikan harga yang tidak ada di daftar harga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondere ai nuovi contatti entro un'ora e fissare una chiamata. Gli sconti aspettano te. Non promettere mai un prezzo che non è nel listino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい見込み客に1時間以内に返信し、通話を予約します。値引きはあなたの承認を待ちます。価格表にない価格は約束しません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უპასუხეთ ახალ პოტენციურ კლიენტებს ერთ საათში და დაჯავშნეთ ზარი. ფასდაკლებები გელოდებათ. არასოდეს დაჰპირდეთ ფასს, რომელიც ფასების სიაში არ არის."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឆ្លើយអតិថិជនដែលមានសក្តានុពលថ្មីក្នុងរយៈពេលមួយម៉ោង ហើយកក់ការហៅ។ ការបញ្ចុះតម្លៃរង់ចាំអ្នក។ កុំសន្យាតម្លៃដែលមិនមានក្នុងបញ្ជីតម្លៃ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 리드에게 1시간 이내에 답장하고 통화를 예약합니다. 할인은 내 승인을 기다립니다. 가격표에 없는 가격은 약속하지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕອບລູກຄ້າເປົ້າໝາຍໃໝ່ພາຍໃນຊົ່ວໂມງ ແລະ ນັດໂທ. ສ່ວນຫຼຸດລໍຖ້າທ່ານ. ບໍ່ເຄີຍສັນຍາລາຄາທີ່ບໍ່ຢູ່ໃນລາຍການລາຄາ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsakyti naujiems potencialiems klientams per valandą ir suplanuoti skambutį. Nuolaidos laukia jūsų. Niekada nežadėti kainos, kurios nėra kainoraštyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbildēt jauniem interesentiem stundas laikā un ieplānot zvanu. Atlaides gaida tevi. Nekad neapsolīt cenu, kuras nav cenrādī."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговарај на нови потенцијални клиенти во рок од еден час и закажи повик. Попустите чекаат на тебе. Никогаш не ветувај цена што не е на ценовникот."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэ боломжит үйлчлүүлэгчид нэг цагийн дотор хариулж, дуудлага товло. Хөнгөлөлт таныг хүлээнэ. Үнийн жагсаалтад байхгүй үнийг хэзээ ч бүү амла."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "नयाँ सम्भावित ग्राहकलाई एक घण्टाभित्र जवाफ दिनुहोस् र कल तय गर्नुहोस्। छुट तपाईंको प्रतीक्षामा रहन्छ। मूल्यसूचीमा नभएको मूल्यको कहिल्यै वाचा नगर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord nieuwe leads binnen een uur en plan een gesprek. Kortingen wachten op jou. Beloof nooit een prijs die niet in de prijslijst staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadaj nowym leadom w ciągu godziny i umawiaj rozmowę. Rabaty czekają na Ciebie. Nigdy nie obiecuj ceny spoza cennika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder a novos contactos em menos de uma hora e marcar uma chamada. Os descontos esperam por si. Nunca prometer um preço que não esteja na tabela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder a novos contatos em menos de uma hora e marcar uma chamada. Os descontos esperam por você. Nunca prometer um preço que não esteja na tabela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspundeți clienților potențiali noi în cel mult o oră și programați un apel. Reducerile vă așteaptă. Nu promiteți niciodată un preț care nu e în lista de prețuri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovedať na nové dopyty do hodiny a dohadovať stretnutia. Zľavy čakajú na vás. Nikdy nesľubovať cenu, ktorá nie je v cenníku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na nova povpraševanja odgovori v eni uri in dogovori klic. Popusti čakajo na vas. Nikoli ne obljubi cene, ki je ni v ceniku."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigjuni klientëve të rinj të mundshëm brenda orës dhe rezervoni një thirrje. Zbritjet presin ju. Mos premtoni kurrë një çmim që nuk është në listën e çmimeve."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovarajte novim potencijalnim kupcima unutar sat vremena i zakažite poziv. Popusti čekaju vas. Nikad ne obećavajte cenu koje nema u ceniku."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอบลูกค้าเป้าหมายใหม่ภายในหนึ่งชั่วโมงและนัดโทร ส่วนลดรอคุณ ห้ามให้คำมั่นเรื่องราคาที่ไม่อยู่ในตารางราคา"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Täze potensial müşderilere sagadyň içinde jogap beriň we jaň belläň. Arzanladyşlar size garaşýar. Baha sanawynda ýok bahany hiç haçan wada bermäň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni potansiyel müşterilere bir saat içinde yanıt ver ve bir görüşme ayarla. İndirimler sizi bekler. Asla fiyat listesinde olmayan bir fiyat vaat etme."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئی لیڈز کو ایک گھنٹے کے اندر جواب دیں اور کال بک کریں۔ رعایتیں آپ کا انتظار کرتی ہیں۔ ایسی قیمت کا وعدہ کبھی نہ کریں جو قیمتوں کی فہرست میں نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời khách tiềm năng mới trong vòng một giờ và đặt một cuộc gọi. Giảm giá chờ bạn. Không bao giờ hứa mức giá không có trong bảng giá."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在一小時內回覆新的潛在客戶並預約通話。折扣要等您決定。絕不承諾價目表上沒有的價格。"
          }
        }
      }
    },
