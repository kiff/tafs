        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং আপনার ফোনে পৌঁছায়নি। আবার চেষ্টা করুন, অথবা এর বদলে টাইপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
