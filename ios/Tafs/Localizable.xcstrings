          "stringUnit": {
            "state": "translated",
            "value": "הדוח שלו יוצג כאן כשהריצה תסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रन खत्म होने पर इसकी रिपोर्ट यहाँ दिखती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegovo se izvješće prikazuje ovdje kad izvođenje završi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelentése a futás végén jelenik meg itt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրա հաշվետվությունը այստեղ կերևա, երբ գործարկումը ավարտվի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporannya muncul di sini saat eksekusi berakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo resoconto compare qui quando l'esecuzione termina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行が終わるとレポートがここに表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისი ანგარიში აქ გამოჩნდება, როცა გაშვება დასრულდება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "របាយការណ៍របស់វាបង្ហាញនៅទីនេះនៅពេលការដំណើរការបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행이 끝나면 여기에 보고서가 표시됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍງານຂອງມັນສະແດງຢູ່ນີ້ເມື່ອການເຮັດວຽກຈົບ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo ataskaita bus rodoma čia, kai paleidimas baigsis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā ziņojums parādīsies šeit, kad palaišana beigsies."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неговиот извештај се прикажува тука кога ќе заврши извршувањето."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ажиллалт дуусахад түүний тайлан энд харагдана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "चलाइ सकिएपछि यसको रिपोर्ट यहाँ देखिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het rapport verschijnt hier als de run eindigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego raport pojawi się tutaj po zakończeniu uruchomienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu relatório aparece aqui quando a execução terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu relatório aparece aqui quando a execução terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportul apare aici când se încheie rularea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho správa sa tu zobrazí, keď beh skončí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegovo poročilo se prikaže tukaj, ko se zagon konča."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Raporti i tij shfaqet këtu kur ekzekutimi të mbarojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegovo se izveštaj prikazuje ovdje kad izvršavanje završi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงานของมันจะแสดงที่นี่เมื่อการทำงานสิ้นสุด"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Onuň hasabaty işleme gutaranda şu ýerde görünýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raporu, çalıştırma bitince burada görünür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رن ختم ہونے پر اس کی رپورٹ یہاں دکھائی دیتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo của nó hiện ở đây khi lượt chạy kết thúc."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行結束後，它的報告會顯示在這裡。"
          }
        }
      }
    },
