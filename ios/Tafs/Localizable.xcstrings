        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არ უპასუხეს: არ დადასტურდა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변하지 못했습니다: 확인되지 않았습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neatsakyta: nepatvirtinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav atbildēts: tas netika apstiprināts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet beantwoord: het is niet bevestigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez odpowiedzi: nie zostało potwierdzone."
          }
        },
        "pt": {
