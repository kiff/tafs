        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une légère vibration quand vous envoyez ou répondez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רטט קל בעת שליחה או מענה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
