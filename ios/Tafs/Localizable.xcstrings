    "door.slack.connect_first": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط روبوت Slack لهذا الـ taf أولًا، من الإعدادات › ربط التطبيقات. ثم أضف قناته هنا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlcə bu taf üçün Slack botunu Parametrlər › Tətbiqləri qoşun bölməsində qoşun. Sonra onun kanalını burada əlavə edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Първо свържете бота на Slack за този taf в Настройки › Свързване на приложения. После добавете канала му тук."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে সেটিংস › অ্যাপ সংযুক্ত করুনে এই taf-এর জন্য Slack বট সংযুক্ত করুন। তারপর এখানে এর চ্যানেল যোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecta primer el bot de Slack d'aquest taf, a Configuració › Connecta aplicacions. Després afegeix-hi aquí el canal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív pro tento taf připojte bota Slacku v Nastavení › Připojit aplikace. Pak sem přidejte jeho kanál."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde zuerst den Slack-Bot für diesen taf unter Einstellungen › Apps verbinden. Füge dann hier seinen Kanal hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the Slack bot for this taf first, in Settings › Connect apps. Then add its channel here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta primero el bot de Slack para este taf, en Ajustes › Conectar apps. Después añade aquí su canal."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühenda kõigepealt selle tafi Slacki bot menüüs Seaded › Ühenda rakendused. Siis lisa siia selle kanal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez d'abord le bot Slack de ce taf, dans Réglages › Connecter des apps. Ajoutez ensuite son canal ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קודם יש לחבר את בוט ה-Slack עבור ה-taf הזה, בהגדרות › חיבור אפליקציות. אחר כך להוסיף כאן את הערוץ שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले इस taf के लिए Slack बॉट सेटिंग › ऐप जोड़ें में जोड़ें। फिर उसका चैनल यहाँ जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije povežite Slack bota za ovaj taf, u Postavke › Poveži aplikacije. Zatim ovdje dodajte njegov kanal."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb csatlakoztasd a Slack-botot ehhez a tafhoz a Beállítások › Alkalmazások csatlakoztatása részben. Aztán itt add hozzá a csatornáját."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախ միացրեք այս taf-ի համար Slack բոտը, Կարգավորումներ › Հավելվածների միացում։ Ապա ավելացրեք նրա ալիքը այստեղ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan bot Slack untuk taf ini terlebih dahulu, di Pengaturan › Hubungkan aplikasi. Lalu tambahkan salurannya di sini."
          }
        },
        "it": {
          "stringUnit": {
