        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programėlių prijungimas šiai paskyrai iš šio telefono nenustatytas. Atidarykite Coach, kad jį pradėtumėte."
          }
        },
        "lv": {
