    "sample.support.job": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ على تذاكر الدعم في اليوم نفسه. وعود الاسترداد أو الخصم أو الاستبدال تنتظر موافقتك. لا ترسل بيانات عميل إلى أي شخص آخر أبدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəstək biletlərini həmin gün cavablandırın. Geri ödəniş, endirim və ya dəyişdirmə vədləri sizi gözləyir. Müştərinin məlumatlarını heç vaxt başqasına göndərməyin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговаряйте на запитванията към поддръжката в същия ден. Обещанията за възстановяване, отстъпка или замяна ви чакат. Никога не изпращайте данните на клиент на някой друг."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাপোর্ট টিকিটের উত্তর সেদিনই দিন। ফেরত, ছাড় বা প্রতিস্থাপনের প্রতিশ্রুতি আপনার অপেক্ষায় থাকে। কোনো গ্রাহকের তথ্য কখনও অন্য কাউকে পাঠাবেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Respon els tiquets de suport el mateix dia. Les promeses de reemborsament, descompte o reemplaçament t'esperen a tu. Mai no enviïs les dades d'un client a ningú més."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídat na tikety podpory ještě ten den. Přísliby vrácení peněz, slevy nebo výměny čekají na vás. Nikdy neposílat údaje zákazníka nikomu jinému."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworte Support-Tickets am selben Tag. Versprechen einer Erstattung, eines Rabatts oder eines Ersatzes warten auf dich. Gib die Daten eines Kunden nie an andere weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer support tickets the same day. Promises of a refund, a discount or a replacement wait for you. Never send a customer's details to anyone else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder los tickets de soporte el mismo día. Las promesas de reembolso, descuento o cambio esperan tu aprobación. Nunca enviar los datos de un cliente a otra persona."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasta klienditoe pöördumistele samal päeval. Tagasimakse, allahindluse või asenduse lubadused ootavad sind. Ära kunagi saada kliendi andmeid kellelegi teisele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondre aux tickets du support dans la journée. Les promesses de remboursement, de remise ou de remplacement vous attendent. Ne jamais transmettre les données d'un client à quelqu'un d'autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לענות על פניות תמיכה באותו יום. הבטחות להחזר, הנחה או החלפה ממתינות לך. לעולם לא לשלוח פרטי לקוח לאף אחד אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सपोर्ट टिकट का उत्तर उसी दिन दें। रिफंड, छूट या बदलने के वादे आपके इंतज़ार में रहते हैं। ग्राहक का विवरण किसी और को कभी न भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovarajte na zahtjeve podrške isti dan. Obećanja povrata novca, popusta ili zamjene čekaju vas. Nikad ne šaljite podatke kupca nikome drugome."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszolj az ügyfélszolgálati jegyekre még aznap. A visszatérítési, kedvezmény- vagy csereígéretek rád várnak. Soha ne küldd el egy vásárló adatait senki másnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատասխանեք աջակցության տոմսերին նույն օրը։ Գումարի վերադարձի, զեղչի կամ փոխարինման խոստումները սպասում են ձեզ։ Երբեք հաճախորդի տվյալները ուրիշին մի ուղարկեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawab tiket dukungan di hari yang sama. Janji pengembalian dana, diskon, atau penggantian menunggu Anda. Jangan pernah mengirim data pelanggan ke orang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondere ai ticket di supporto in giornata. Le promesse di rimborso, sconto o sostituzione aspettano te. Non inviare mai i dati di un cliente a qualcun altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートチケットに当日中に回答します。返金、値引き、交換の約束はあなたの承認を待ちます。顧客の情報を他の人に送ることはしません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უპასუხეთ მხარდაჭერის ბილეთებს იმავე დღეს. დაპირებები თანხის დაბრუნების, ფასდაკლების ან ჩანაცვლების შესახებ გელოდებათ. არასოდეს გაუგზავნოთ კლიენტის მონაცემები სხვას."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឆ្លើយសំបុត្រជំនួយក្នុងថ្ងៃតែមួយ។ ការសន្យាអំពីការសងប្រាក់ ការបញ្ចុះតម្លៃ ឬការជំនួសរង់ចាំអ្នក។ កុំផ្ញើព័ត៌មានលម្អិតរបស់អតិថិជនទៅអ្នកផ្សេងឱ្យសោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고객 지원 티켓에 당일 답합니다. 환불, 할인 또는 교환 약속은 내 승인을 기다립니다. 고객 정보를 다른 사람에게 보내지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕອບທິກເກັດຊ່ວຍເຫຼືອໃນມື້ດຽວກັນ. ຄຳສັນຍາຂອງການຄືນເງິນ, ສ່ວນຫຼຸດ ຫຼື ການປ່ຽນສິນຄ້າລໍຖ້າທ່ານ. ບໍ່ເຄີຍສົ່ງລາຍລະອຽດຂອງລູກຄ້າໃຫ້ຄົນອື່ນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsakyti į pagalbos užklausas tą pačią dieną. Pažadai grąžinti pinigus, suteikti nuolaidą ar pakeisti prekę laukia jūsų. Niekada nesiųsti kliento duomenų niekam kitam."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbildēt uz atbalsta pieteikumiem tajā pašā dienā. Atmaksas, atlaides vai aizstājēja apsolījumi gaida tevi. Nekad nesūtīt klienta datus nevienam citam."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговарај на тикети за поддршка истиот ден. Ветувањата за поврат, попуст или замена чекаат на тебе. Никогаш не испраќај податоци на клиент на никој друг."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дэмжлэгийн тикетэд тэр өдөртөө хариул. Буцаан олголт, хөнгөлөлт эсвэл солих амлалт таныг хүлээнэ. Үйлчлүүлэгчийн мэдээллийг өөр хэнд ч хэзээ ч бүү илгээ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सहायता टिकेटमा सोही दिन जवाफ दिनुहोस्। फिर्ता, छुट वा बदलीका वाचा तपाईंको प्रतीक्षामा रहन्छन्। ग्राहकको विवरण अरू कसैलाई कहिल्यै नपठाउनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord supporttickets op dezelfde dag. Beloftes van een terugbetaling, korting of vervanging wachten op jou. Stuur de gegevens van een klant nooit naar iemand anders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadaj na zgłoszenia tego samego dnia. Obietnice zwrotu, rabatu lub wymiany czekają na Ciebie. Nigdy nie przekazuj danych klienta nikomu innemu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder aos pedidos de suporte no próprio dia. Promessas de reembolso, desconto ou substituição esperam por si. Nunca enviar os dados de um cliente a outra pessoa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder aos pedidos de suporte no próprio dia. Promessas de reembolso, desconto ou substituição esperam por você. Nunca enviar os dados de um cliente a outra pessoa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspundeți la tichetele de suport în aceeași zi. Promisiunile de rambursare, reducere sau înlocuire vă așteaptă. Nu trimiteți niciodată datele unui client altcuiva."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovedať na tikety podpory ešte v ten deň. Prísľuby vrátenia peňazí, zľavy alebo výmeny čakajú na vás. Nikdy neposielať údaje zákazníka nikomu inému."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zahtevke podpore odgovori še isti dan. Obljube vračila, popusta ali zamenjave čakajo na vas. Nikoli ne pošlji podatkov stranke nikomur drugemu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigjuni biletave të mbështetjes po atë ditë. Premtimet për kthim parash, zbritje ose zëvendësim presin ju. Mos ia dërgoni kurrë të dhënat e një klienti dikujt tjetër."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovarajte na zahteve podrške isti dan. Obećanja povrata novca, popusta ili zamene čekaju vas. Nikad ne šaljite podatke kupca nikome drugome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอบตั๋วฝ่ายสนับสนุนภายในวันเดียวกัน คำมั่นเรื่องการคืนเงิน ส่วนลด หรือการเปลี่ยนสินค้ารอคุณ ห้ามส่งรายละเอียดของลูกค้าให้ผู้อื่น"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldaw biletlerine şol bir gün jogap beriň. Yzyna gaýtarma, arzanladyş ýa-da çalyşma wadalary size garaşýar. Hiç haçan müşderiniň maglumatlaryny başga birine ibermäň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destek taleplerini aynı gün yanıtla. İade, indirim veya değişim sözleri sizi bekler. Asla bir müşterinin bilgilerini başkasına gönderme."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سپورٹ ٹکٹوں کا اسی دن جواب دیں۔ رقم واپسی، رعایت یا متبادل کے وعدے آپ کا انتظار کرتے ہیں۔ گاہک کی تفصیلات کبھی کسی اور کو نہ بھیجیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời các phiếu hỗ trợ ngay trong ngày. Lời hứa hoàn tiền, giảm giá hoặc thay thế chờ bạn. Không bao giờ gửi thông tin của khách hàng cho người khác."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當天回覆客服工單。退款、折扣或更換的承諾要等您決定。絕不將客戶的資料傳給其他人。"
          }
        }
      }
    },
