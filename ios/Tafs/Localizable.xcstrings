    "taf.remove.cloud_did_not_answer": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud cavab vermədi (%2$@). Başlayıbsa, tafs növbəti yenilənəndə onu tamamlayır; başlamayıbsa, yenidən «Silin» düyməsinə basın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud не отговори (%2$@). Ако е започнало, tafs го завършва при следващото опресняване; ако не, докоснете отново „Премахване“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud neodpověděl (%2$@). Pokud odstranění začalo, tafs ho dokončí při příštím obnovení; pokud ne, klepněte znovu na Odstranit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud hat nicht geantwortet (%2$@). Falls das Entfernen begonnen hat, schließt tafs es bei der nächsten Aktualisierung ab; falls nicht, tippe erneut auf „Entfernen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud didn't answer (%2$@). If it began, tafs finishes it the next time it refreshes; if not, tap Remove again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud no respondió (%2$@). Si empezó, tafs lo termina la próxima vez que se actualice; si no, vuelve a tocar Eliminar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud ei vastanud (%2$@). Kui eemaldamine algas, lõpetab tafs selle järgmisel värskendusel; kui mitte, puuduta uuesti Eemalda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud n'a pas répondu (%2$@). Si la suppression a commencé, tafs la termine à la prochaine actualisation ; sinon, touchez à nouveau Supprimer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud nije odgovorio (%2$@). Ako je počelo, tafs to dovršava sljedeći put kad se osvježi; ako nije, ponovno dodirnite Uklonite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ A tafs cloud nem válaszolt (%2$@). Ha elkezdődött, a tafs a következő frissítéskor befejezi; ha nem, koppints újra az Eltávolításra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud-ը չպատասխանեց (%2$@)։ Եթե սկսվեց, tafs-ը կավարտի հաջորդ թարմացմանը․ եթե ոչ, նորից հպեք «Հեռացնել»։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud tidak menjawab (%2$@). Jika sudah dimulai, tafs menyelesaikannya saat menyegarkan berikutnya; jika belum, ketuk Hapus lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud non ha risposto (%2$@). Se la rimozione è iniziata, tafs la completa al prossimo aggiornamento; altrimenti tocca di nuovo Rimuovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafsクラウドが応答しませんでした（%2$@）。削除が始まっていれば、次の更新時にtafsが完了させます。始まっていなければ、もう一度「削除」をタップしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud-მა არ უპასუხა (%2$@). თუ დაიწყო, tafs დაასრულებს შემდეგ განახლებაზე; თუ არა, შეეხეთ „ამოღებას“ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud가 응답하지 않았습니다(%2$@). 삭제가 시작되었다면 다음에 새로 고칠 때 tafs가 마무리합니다. 아니라면 삭제를 다시 누르세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud neatsakė (%2$@). Jei šalinimas prasidėjo, tafs jį užbaigs kitą kartą atsinaujindama; jei ne, dar kartą palieskite „Pašalinti“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud neatbildēja (%2$@). Ja noņemšana sākās, tafs to pabeigs nākamajā atsvaidzināšanas reizē; ja ne, vēlreiz pieskaries “Noņemt”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud antwoordde niet (%2$@). Als het verwijderen is begonnen, rondt tafs het af bij de volgende vernieuwing; zo niet, tik dan nogmaals op Verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud nie odpowiedział (%2$@). Jeśli usuwanie się zaczęło, tafs dokończy je przy następnym odświeżeniu; jeśli nie, dotknij ponownie Usuń."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ O tafs cloud não respondeu (%2$@). Se a remoção começou, o tafs conclui-a na próxima atualização; se não, toque novamente em Remover."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ O tafs cloud não respondeu (%2$@). Se a remoção começou, o tafs conclui-a na próxima atualização; se não, toque novamente em Remover."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud nu a răspuns (%2$@). Dacă a început, tafs termină la următoarea reîmprospătare; dacă nu, atingeți din nou Eliminați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud neodpovedal (%2$@). Ak odstránenie začalo, tafs ho dokončí pri ďalšom obnovení; ak nie, ťuknite znova na Odstrániť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud ni odgovoril (%2$@). Če se je odstranitev začela, jo tafs dokonča ob naslednji osvežitvi; če ne, znova tapnite Odstrani."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud nuk u përgjigj (%2$@). Nëse filloi, tafs e përfundon herën tjetër që rifreskohet; nëse jo, prekni sërish Hiqeni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud nije odgovorio (%2$@). Ako je počelo, tafs to dovršava sledeći put kad se osvježi; ako nije, ponovo dodirnite Uklonite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud ไม่ตอบ (%2$@) หากเริ่มไปแล้ว tafs จะทำให้เสร็จในการรีเฟรชครั้งถัดไป หากยังไม่ได้เริ่ม แตะนำออกอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud yanıt vermedi (%2$@). Başladıysa tafs bir sonraki yenilenişinde bitirir; başlamadıysa Kaldır'a tekrar dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud không trả lời (%2$@). Nếu việc gỡ đã bắt đầu, tafs sẽ hoàn tất ở lần làm mới tiếp theo; nếu chưa, hãy chạm Gỡ lần nữa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud 沒有回應（%2$@）。如果已經開始，tafs 會在下次重新整理時完成；如果沒有，請再次輕點「移除」。"
          }
        }
      }
    },
