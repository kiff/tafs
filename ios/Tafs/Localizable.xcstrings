    "record.event.resumed_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل مرة أخرى كما كان قبل التجميد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "O, dondurulmadan əvvəlki kimi yenidən işləyir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отново работи както преди спирането."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "থামানোর আগের মতো এটি আবার কাজ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a funcionar com abans del bloqueig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu pracuje jako před zastavením."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er arbeitet wieder wie vor dem Anhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It works again as it did before the halt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a funcionar como antes del bloqueo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See töötab jälle nagu enne peatamist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fonctionne à nouveau comme avant le blocage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא עובד שוב כמו לפני העצירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फिर वैसे काम करता है जैसे रोक से पहले करता था।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno radi kao prije blokiranja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra úgy dolgozik, mint a leállítás előtt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն նորից աշխատում է այնպես, ինչպես կանգնեցումից առաջ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekerja lagi seperti sebelum pembekuan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona di nuovo come prima del blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮断前と同じように再び動作します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ის ისევ მუშაობს ისე, როგორც გაჩერებამდე."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាធ្វើការម្តងទៀតដូចមុនការបញ្ឈប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 전처럼 다시 작동합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມັນເຮັດວຽກອີກຄືກັບກ່ອນຢຸດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jis vėl dirba taip, kaip prieš sustabdymą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas atkal strādā tāpat kā pirms apturēšanas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Работи повторно како пред запирањето."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зогсохоосоо өмнөх шигээ дахин ажиллана."
