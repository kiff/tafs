    "setup.place.reply_words": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في السلسلة نفسها، عبر الباب الذي وردت منه"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyni mövzuda, gəldiyi qapı ilə"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В същата нишка, през вратата, през която е дошло"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একই থ্রেডে, যে দরজা দিয়ে এসেছিল সেই দরজা দিয়ে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Al mateix fil, per la porta per la qual ha arribat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve stejném vlákně, přes dveře, kterými to přišlo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im selben Thread, über die Tür, über die es kam"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the same thread, through the door it came in on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el mismo hilo, por la puerta por la que llegó"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Samas lõimes, selle ukse kaudu, kust see tuli"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le même fil, par la porte par laquelle il est arrivé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באותה שרשור, דרך הדלת שבה זה הגיע"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसी थ्रेड में, उस द्वार से जिससे वह आया"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U istoj niti, kroz vrata na koja je stigla"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyanabban a szálban, azon az ajtón, ahol érkezett"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նույն թելի մեջ, այն դռնով, որով եկավ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di utas yang sama, lewat pintu tempat pesan masuk"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella stessa conversazione, tramite la porta da cui è arrivato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じスレッドで、届いた窓口から"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იმავე საუბარში, იმ კარით, რომლითაც მოვიდა"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លើខ្សែសន្ទនាដដែល តាមទ្វារដែលវាចូលមក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 스레드에서, 메시지가 들어온 창구로"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃນກະທູ້ດຽວກັນ, ຜ່ານປະຕູທີ່ມັນເຂົ້າມາ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toje pačioje gijoje, per duris, pro kurias atėjo"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajā pašā pavedienā, caur durvīm, pa kurām tā ienāca"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Во истата нишка, преку вратата низ која дошла"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэг ярианд, ирсэн хаалгаараа"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "उही थ्रेडमा, यो आएको ढोकाबाटै"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In hetzelfde gesprek, via de deur waardoor het binnenkwam"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym samym wątku, przez drzwi, którymi przyszło"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na mesma conversa, pela porta por onde chegou"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na mesma conversa, pela porta por onde chegou"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În același fir, prin ușa prin care a venit"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V tom istom vlákne, cez dvere, ktorými to prišlo"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V isti niti, skozi vrata, skozi katera je prišlo"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Në të njëjtën bisedë, përmes portës ku erdhi"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "U istoj niti, kroz vrata na koja je stigla"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในเธรดเดียวกัน ผ่านประตูที่ข้อความเข้ามา"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Şol bir gürrüňde, ol gelen gapy arkaly"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı konuşmada, geldiği kapıdan"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسی تھریڈ میں، اسی دروازے سے جس سے وہ آیا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong cùng cuộc trao đổi, qua cửa mà tin đến"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一個討論串中，透過來信的那扇門"
          }
        }
      }
    },
    "setup.reading_results": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ قراءة وجهة نتائجه…"
