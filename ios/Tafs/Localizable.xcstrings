    "kiff.kiff_words_do_not_match": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFs Worte stimmen nicht mit ihrer Prüfung überein. Es kann nichts genehmigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF's words don't match their check. Nothing can be approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras de KIFF no coinciden con su comprobación. No se puede aprobar nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFi sõnad ei vasta nende kontrollile. Midagi ei saa kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les textes de KIFF ne correspondent pas à leur vérification. Rien ne peut être approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole di KIFF non corrispondono al loro controllo. Non si può approvare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFの説明が確認値と一致しません。何も承認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF의 문구가 확인 값과 일치하지 않습니다. 아무것도 승인할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formuluotė neatitinka jos patikros. Nieko negalima patvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formulējums neatbilst tā pārbaudei. Neko nevar apstiprināt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woorden van KIFF komen niet overeen met hun controle. Er kan niets worden goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opis KIFF nie zgadza się ze swoją sumą kontrolną. Nic nie można zatwierdzić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras do KIFF não correspondem à sua verificação. Nada pode ser aprovado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras do KIFF não correspondem à sua verificação. Nada pode ser aprovado."
          }
        }
      }
