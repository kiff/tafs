    "pair.added_passkey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع هذا الجهاز (%1$@) توقيع الموافقات بنفسه. وافق من هاتفك أو بمفتاح مرور."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ təsdiqləri özü imzalaya bilmir. Telefonunuzda və ya giriş açarı ilə təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този %1$@ не може сам да подписва одобрения. Одобрявайте от телефона си или с ключ за достъп."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই %1$@ নিজে অনুমোদন সই করতে পারে না। আপনার ফোনে অথবা পাসকি দিয়ে অনুমোদন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest dispositiu (%1$@) no pot signar aprovacions ell sol. Aprova al telèfon o amb una clau d'accés."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento %1$@ nemůže sám podepisovat schválení. Schvalujte v telefonu nebo přístupovým klíčem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser %1$@ kann Genehmigungen nicht selbst signieren. Genehmige auf deinem Handy oder mit einem Passkey."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ can't sign approvals itself. Approve on your phone, or with a passkey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ no puede firmar aprobaciones por sí mismo. Aprueba en tu teléfono o con una llave de acceso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See %1$@ ei saa kinnitusi ise allkirjastada. Kinnita telefonis või pääsuvõtmega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ne peut pas signer les approbations lui-même. Approuvez sur votre téléphone, ou avec une clé d'identification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתקן הזה (%1$@) לא יכול לחתום על אישורים בעצמו. יש לאשר בטלפון, או עם מפתח גישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह %1$@ खुद मंज़ूरियों पर हस्ताक्षर नहीं कर सकता। अपने फ़ोन पर, या passkey से मंज़ूर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj %1$@ ne može sam potpisivati odobrenja. Odobravajte na telefonu ili pristupnim ključem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz (%1$@) maga nem tud jóváhagyásokat aláírni. Hagyd jóvá a telefonodon vagy jelkulccsal."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքը (%1$@) ինքնուրույն չի կարող ստորագրել հաստատումները։ Հաստատեք ձեր հեռախոսով կամ մուտքի բանալիով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ini tidak dapat menandatangani persetujuan sendiri. Setujui di ponsel Anda, atau dengan kunci sandi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo %1$@ non può firmare le approvazioni da solo. Approva sul telefono o con una passkey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%1$@は自分で承認に署名できません。スマートフォンかパスキーで承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოწყობილობა (%1$@) დამტკიცებებს თვითონ ვერ აწერს ხელს. დაამტკიცეთ ტელეფონზე ან პასკით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ នេះមិនអាចចុះហត្ថលេខាលើការអនុម័តដោយខ្លួនឯងបានទេ។ សូមអនុម័តនៅលើទូរសព្ទរបស់អ្នក ឬដោយ passkey។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %1$@은(는) 직접 승인에 서명할 수 없습니다. 휴대폰이나 패스키로 승인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ນີ້ລົງລາຍເຊັນການອະນຸມັດເອງບໍ່ໄດ້. ອະນຸມັດໃນໂທລະສັບຂອງທ່ານ ຫຼື ດ້ວຍ passkey."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis įrenginys (%1$@) pats negali pasirašyti patvirtinimų. Tvirtinkite telefone arba prieigos raktu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis %1$@ pats nevar parakstīt apstiprinājumus. Apstiprini savā tālrunī vai ar piekļuves atslēgu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој %1$@ не може сам да потпишува одобренија. Одобри на телефонот или со клуч за пристап."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ %1$@ зөвшөөрлийг өөрөө гарын үсэг зурж чадахгүй. Утсан дээрээ эсвэл нэвтрэх түлхүүрээр зөвшөөрнө үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो %1$@ ले आफैँ स्वीकृतिमा हस्ताक्षर गर्न सक्दैन। आफ्नो फोनमा वा पासकीले स्वीकृत गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %1$@ kan goedkeuringen niet zelf ondertekenen. Keur goed op je telefoon, of met een toegangssleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten %1$@ nie może sam podpisywać zatwierdzeń. Zatwierdzaj na telefonie albo kluczem dostępu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ não pode assinar aprovações sozinho. Aprove no telemóvel ou com uma chave de acesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ não pode assinar aprovações sozinho. Aprove no celular ou com uma chave de acesso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv (%1$@) nu poate semna singur aprobările. Aprobați pe telefon sau cu o cheie de acces."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento %1$@ nemôže sám podpisovať schválenia. Schvaľujte v telefóne alebo prístupovým kľúčom."
          }
        },
        "sl": {
