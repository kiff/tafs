    "sign_in.relink.fingerprints_changed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Barmaq izləriniz indicə dəyişdi. Yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пръстовите ви отпечатъци току-що се промениха. Опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše otisky prstů se právě změnily. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fingerabdrücke haben sich gerade geändert. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your fingerprints changed just now. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus huellas acaban de cambiar. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu sõrmejäljed just muutusid. Proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos empreintes viennent de changer. Réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši su se otisci prstiju upravo promijenili. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ujjlenyomataid épp megváltoztak. Próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր մատնահետքերը հենց նոր փոխվեցին։ Փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidik jari Anda baru saja berubah. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue impronte sono appena cambiate. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指紋の登録が変更されたところです。もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი თითის ანაბეჭდები ახლახან შეიცვალა. სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 지문이 바뀌었습니다. 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ką tik pasikeitė jūsų piršto atspaudai. Bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavi pirkstu nospiedumi tikko mainījās. Mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vingerafdrukken zijn net gewijzigd. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odciski palców właśnie się zmieniły. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas impressões digitais acabaram de mudar. Tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas impressões digitais acabaram de mudar. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Amprentele dvs. tocmai s-au schimbat. Încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše odtlačky prstov sa práve zmenili. Skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši prstni odtisi so se pravkar spremenili. Poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjurmët tuaja të gishtave ndryshuan pikërisht tani. Provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši su se otisci prstiju upravo promenili. Pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลายนิ้วมือของคุณเพิ่งเปลี่ยน ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak izleriniz az önce değişti. Tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vân tay của bạn vừa thay đổi. Hãy thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的指紋剛剛變更了。請再試一次。"
          }
        }
      }
