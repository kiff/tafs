    "kiff.kiff_can_not_do_sign": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kann das noch nicht: Melde dich in den Einstellungen erneut an, um auf diesem %1$@ zu genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF can't do this yet: sign in again from Settings to approve from this %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF aún no puede hacer esto: vuelve a iniciar sesión desde Ajustes para aprobar desde este %1$@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei saa seda veel teha: logi seadetes uuesti sisse, et see %1$@ saaks kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ne peut pas encore le faire : reconnectez-vous depuis Réglages pour approuver depuis %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non può ancora farlo: accedi di nuovo da Impostazioni per approvare da questo %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFはまだこれを実行できません。この%1$@から承認するには、設定からもう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 아직 이 작업을 할 수 없습니다. 이 %1$@에서 승인하려면 설정에서 다시 로그인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF to dar negali: dar kartą prisijunkite skiltyje „Nustatymai“, kad galėtumėte tvirtinti šiame įrenginyje (%1$@)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF to vēl nevar izdarīt: vēlreiz pieraksties no iestatījumiem, lai apstiprinātu no šīs ierīces (%1$@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kan dit nog niet: log opnieuw in via Instellingen om vanaf deze %1$@ goed te keuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF jeszcze tego nie umie: zaloguj się ponownie w Ustawieniach, aby zatwierdzać z tego urządzenia (%1$@)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF ainda não pode fazer isto: inicie sessão novamente nas Definições para aprovar a partir deste %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF ainda não pode fazer isto: entre novamente em Conta para aprovar a partir deste %1$@."
          }
        }
      }
    },
    "kiff.kiff_did_not_answer_expected": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
