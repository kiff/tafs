    "sign_in.deletes_every_taf_runs_chats": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht jeden taf, seine Läufe, Chats und Notizen, deine Cards und deine Verbindungen. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes every taf, its runs, chats and notes, your Cards and your connections. It can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina cada taf, sus ejecuciones, chats y notas, tus Cards y tus conexiones. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime chaque taf, ses exécutions, chats et notes, vos Cards et vos connexions. C'est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina ogni taf, le sue esecuzioni, chat e note, le tue Card e i tuoi collegamenti. Non si può annullare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert elk taf, met zijn runs, chats en notities, je Cards en je koppelingen. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa każdego tafa, jego uruchomienia, czaty i notatki, Twoje Card i Twoje połączenia. Nie można tego cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todos os tafs, as suas execuções, chats e notas, os seus Cards e as suas ligações. Não pode ser desfeito."
          }
        }
      }
    },
