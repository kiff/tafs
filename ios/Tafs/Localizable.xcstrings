    "setup.place.email_words": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Antwort an %1$@; nicht, wenn du die Nachricht geschrieben hast"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its answer to %1$@; not when you wrote the message"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su respuesta a %1$@; no cuando escribiste tú el mensaje"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle vastus aadressile %1$@; mitte siis, kui sõnumi kirjutasid sina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa réponse à %1$@ ; pas quand c'est vous qui avez écrit le message"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua risposta a %1$@; non quando il messaggio l'hai scritto tu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答を%1$@に送ります。メッセージを書いたのがあなたの場合は送りません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(으)로 답변을 보냅니다. 내가 메시지를 썼을 때는 보내지 않습니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo atsakymas adresu %1$@; ne tada, kai žinutę parašėte jūs"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā atbilde uz %1$@; ne tad, kad ziņu rakstīji tu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het antwoord naar %1$@; niet als jij het bericht schreef"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego odpowiedź na %1$@; nie wtedy, gdy autorem wiadomości jesteś Ty"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua resposta para %1$@; não quando foi você a escrever a mensagem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua resposta para %1$@; não quando foi você a escrever a mensagem"
          }
        }
      }
    },
