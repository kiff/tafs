        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tev paziņo, kad lieta gaida ilgāk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hoort het als een zaak langer wacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostaniesz powiadomienie, gdy sprawa czeka dłużej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisamos quando um caso espera mais."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisamos quando um caso espera mais."
          }
        }
