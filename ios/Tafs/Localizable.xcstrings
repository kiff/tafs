        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini tidak dapat mengenali %1$@ di ponsel itu sendiri, sehingga mikrofon tidak berfungsi di sini. Anda dapat mengetik sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
