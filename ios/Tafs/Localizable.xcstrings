    "people.delete_group_body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onun adamları, başqa qrup və ya öz paylaşımları onlara bu taf-ları verməyibsə, qrup vasitəsilə istifadə etdikləri taf-ları itirir. Onların söhbətləri onlara məxsus qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хората в нея губят tafs, които са използвали чрез нея, освен ако друга група или собствено споделяне не им дава тези tafs. Чатовете им остават техни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Její lidé přijdou o tafy, které přes ni používali, pokud jim je nedává jiná skupina nebo jejich vlastní sdílení. Jejich chaty zůstávají jejich."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Personen verlieren die tafs, die sie über sie genutzt haben, außer eine andere Gruppe oder eine eigene Freigabe gibt ihnen diese tafs. Ihre Chats bleiben ihre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its people lose the tafs they used through it, unless another group or a share of their own gives them those tafs. Their chats stay theirs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus personas pierden los tafs que usaban a través de él, salvo que otro grupo o un uso compartido propio les dé esos tafs. Sus chats siguen siendo suyos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle inimesed kaotavad tafid, mida nad selle kaudu kasutasid, kui mõni teine grupp või nende enda jagamine neid tafisid neile ei anna. Nende vestlused jäävad neile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses membres perdent les tafs qu'ils utilisaient par son biais, sauf si un autre groupe ou un partage personnel leur donne ces tafs. Leurs chats restent les leurs."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njezini ljudi gube tafove koje su koristili preko nje, osim ako im te tafove ne daje druga grupa ili vlastito dijeljenje. Njihovi razgovori ostaju njihovi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tagjai elveszítik a rajta keresztül használt tafokat, hacsak egy másik csoport vagy egy saját megosztás nem adja meg nekik ezeket a tafokat. A csevegéseik az övék maradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրա մարդիկ կորցնում են taf-երը, որ օգտագործում էին դրա միջոցով, եթե մեկ այլ խումբ կամ սեփական կիսում չի տալիս նրանց այդ taf-երը։ Նրանց զրույցները մնում են նրանցը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggotanya kehilangan tafs yang mereka gunakan melalui grup ini, kecuali grup lain atau pembagian pribadi mereka memberikan tafs tersebut. Obrolan mereka tetap milik mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue persone perdono i tafs che usavano tramite il gruppo, a meno che un altro gruppo o una loro condivisione non glieli dia. Le loro chat restano loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のグループや個人への共有で使えるようになっていない限り、メンバーはこのグループを通じて使っていたtafsを使えなくなります。チャットはそれぞれのものとして残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისი ადამიანები კარგავენ taf-ებს, რომლებსაც მისით იყენებდნენ, თუ სხვა ჯგუფი ან საკუთარი გაზიარება ამ taf-ებს არ აძლევს. მათი ჩატები მათთანვე რჩება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 그룹이나 개인 공유로 받은 경우가 아니면, 이 그룹의 사람들은 그룹을 통해 사용하던 taf를 더 이상 사용할 수 없습니다. 채팅은 그대로 각자의 것으로 남습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos nariai praranda per ją naudotus taf, nebent tuos taf jiems suteikia kita grupė ar jų pačių bendrinimas. Jų pokalbiai lieka jiems."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tās cilvēki zaudē taf, ko lietoja caur to, ja vien tos viņiem nedod cita grupa vai viņu pašu kopīgojums. Viņu sarunas paliek viņiem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mensen erin verliezen de tafs die ze via de groep gebruikten, tenzij een andere groep of een eigen deling ze die tafs geeft. Hun chats blijven van hen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jej członkowie stracą tafs, których używali przez nią, chyba że daje im je inna grupa lub ich własne udostępnienie. Ich czaty pozostaną ich."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas pessoas perdem os tafs que usavam através dele, a menos que outro grupo ou uma partilha própria lhes dê esses tafs. Os seus chats continuam a ser seus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas pessoas perdem os tafs que usavam através dele, a menos que outro grupo ou um compartilhamento próprio lhes dê esses tafs. Os seus chats continuam sendo seus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Membrii săi pierd tafurile pe care le foloseau prin el, dacă nu le primesc prin alt grup sau printr-o partajare proprie. Conversațiile lor rămân ale lor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jej ľudia prídu o tafy, ktoré cez ňu používali, ak im ich nedáva iná skupina alebo ich vlastné zdieľanie. Ich chaty zostávajú ich."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Njeni ljudje izgubijo tafe, ki so jih uporabljali prek nje, razen če jim jih da druga skupina ali njihovo lastno deljenje. Njihovi klepeti ostanejo njihovi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Njerëzit e tij humbasin tafs-et që përdornin përmes tij, përveç nëse një grup tjetër ose një ndarje e tyre ua jep ata tafs. Bisedat e tyre mbeten të tyret."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Njeni ljudi gube tafove koje su koristili preko nje, osim ako im te tafove ne daje druga grupa ili vlastito deljenje. Njihovi razgovori ostaju njihovi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมาชิกจะสูญเสีย taf ที่ใช้ผ่านกลุ่มนี้ เว้นแต่กลุ่มอื่นหรือการแชร์ส่วนตัวของพวกเขาจะให้ taf เหล่านั้นอีกครั้ง แชตของพวกเขายังเป็นของพวกเขา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişileri, başka bir grup veya kendi paylaşımları o tafs'ları vermedikçe, grup aracılığıyla kullandıkları tafs'ları kaybeder. Sohbetleri kendilerinin kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thành viên mất những tafs họ dùng qua nhóm này, trừ khi một nhóm khác hoặc một lượt chia sẻ riêng của họ cấp lại các tafs đó. Các cuộc trò chuyện của họ vẫn là của họ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "成員會失去透過此群組使用的 taf，除非其他群組或他們自己的個別分享再次授予這些 taf。他們的對話仍屬於他們。"
          }
        }
      }
    },
