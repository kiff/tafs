        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv etmək KIFF-in giriş səhifəsini açır, orada sizin olduğunuzu təsdiqləyirsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включването отваря страницата за вход на KIFF, където потвърждавате, че сте вие."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালু করলে KIFF-এর সাইন-ইন পেজ খোলে, যেখানে আপনি নিশ্চিত করেন যে এটি আপনি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar-lo obre la pàgina d'inici de sessió de KIFF, on confirmes que ets tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnutím se otevře přihlašovací stránka KIFF, kde potvrdíte, že jste to vy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Einschalten öffnet sich die Anmeldeseite von KIFF, auf der du bestätigst, dass du es bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning it on opens KIFF's sign-in page, where you confirm it's you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarlo se abre la página de inicio de sesión de KIFF, donde confirmas que eres tú."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisselülitamisel avaneb KIFFi sisselogimisleht, kus kinnitad, et see oled sina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'activer ouvre la page de connexion de KIFF, où vous confirmez que c'est bien vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההפעלה פותחת את דף הכניסה של KIFF, שבו תאשר שזה אתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू करने से KIFF का साइन-इन पृष्ठ खुलता है, जहाँ आप पुष्टि करते हैं कि यह आप हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključivanje otvara stranicu za prijavu u KIFF-u, na kojoj potvrđujete da ste to vi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bekapcsolás megnyitja a KIFF bejelentkezési oldalát, ahol megerősíted, hogy te vagy az."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միացնելիս բացվում է KIFF-ի մուտքի էջը, որտեղ հաստատում եք, որ դա դուք եք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengaktifkannya membuka halaman masuk KIFF, tempat Anda mengonfirmasi bahwa ini memang Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivarlo apre la pagina di accesso di KIFF, dove confermi che sei tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにするとKIFFのサインインページが開き、ご本人であることを確認します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართვისას იხსნება KIFF-ის შესვლის გვერდი, სადაც ადასტურებთ, რომ ეს თქვენ ხართ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការបើកនឹងបើកទំព័រចូលរបស់ KIFF ដែលអ្នកបញ្ជាក់ថាជាអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 KIFF 로그인 페이지가 열리고, 거기서 본인임을 확인합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການເປີດຈະເປີດໜ້າເຂົ້າສູ່ລະບົບຂອງ KIFF ບ່ອນທີ່ທ່ານຢືນຢັນວ່າແມ່ນທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjungus atidaromas KIFF prisijungimo puslapis, kuriame patvirtinate, kad tai jūs."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieslēdzot tiek atvērta KIFF pierakstīšanās lapa, kurā apstiprini, ka tas esi tu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вклучувањето ја отвора страницата за најава на KIFF, каде потврдуваш дека си ти."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Асаахад KIFF-ийн нэвтрэх хуудас нээгдэж, та тэнд өөрөө мөн гэдгээ баталгаажуулна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "खोल्दा KIFF को साइन इन पृष्ठ खुल्छ, जहाँ तपाईं आफू नै हो भनी पुष्टि गर्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanzetten opent de inlogpagina van KIFF, waar je bevestigt dat jij het bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączenie otwiera stronę logowania KIFF, na której potwierdzasz, że to Ty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativá-lo abre a página de início de sessão do KIFF, onde confirma que é você."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar abre a página de login do KIFF, onde você confirma que é você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activarea deschide pagina de conectare KIFF, unde confirmați că sunteți dumneavoastră."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnutím sa otvorí prihlasovacia stránka KIFF, kde potvrdíte, že ste to vy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z vklopom se odpre prijavna stran KIFF, kjer potrdite, da ste to vi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivizimi hap faqen e hyrjes së KIFF-it, ku konfirmoni se jeni ju."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključivanje otvara KIFF-ovu stranicu za prijavu, na kojoj potvrđujete da ste to vi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปิดจะเปิดหน้าเข้าสู่ระบบของ KIFF ซึ่งคุณยืนยันว่าเป็นคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Açmak KIFF-iň giriş sahypasyny açýar, şol ýerde özüňizdigiňizi tassyklaýarsyňyz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açmak, KIFF'in oturum açma sayfasını açar; orada sizin olduğunuzu onaylarsınız."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چالو کرنے سے KIFF کا سائن اِن صفحہ کھلتا ہے، جہاں آپ تصدیق کرتے ہیں کہ یہ آپ ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật sẽ mở trang đăng nhập của KIFF, nơi bạn xác nhận đó là bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟時會打開 KIFF 的登入頁面，您在那裡確認是您本人。"
          }
        }
      }
    },
