            "value": "Il telefono non è raggiungibile. Avvicinalo, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンが範囲外です。近づけてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰이 범위 밖에 있습니다. 더 가까이 가져온 후 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonas nepasiekiamas. Priartinkite jį ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tālrunis nav tuvumā. Pienes to tuvāk, tad mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon is buiten bereik. Breng hem dichterbij en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon jest poza zasięgiem. Przybliż go i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O telemóvel não está ao alcance. Aproxime-o e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
