    "card.rule.total_then_asks": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ إجمالًا %2$@، ثم يسألك"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ cəmi %1$@, sonra sizdən soruşur"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "общо %1$@ %2$@, след това ви пита"
