        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말한 내용은 보내지 않은 채 메시지 입력란에 남아 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai, ką pasakėte, lieka žinutės laukelyje, neišsiųsta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas, ko teici, paliek ziņas laukā, nenosūtīts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je zei, blijft onverzonden in het berichtvak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podyktowany tekst zostaje w polu wiadomości, niewysłany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que disse fica na caixa de mensagem, por enviar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que disse fica na caixa de mensagem, por enviar."
          }
        }
      }
