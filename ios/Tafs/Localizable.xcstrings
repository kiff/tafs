    "attachment.not_taken": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs kann diese Datei nicht anhängen: Art oder Größe werden nicht unterstützt. Wähle eine andere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs can't attach this file: it isn't a kind or size it takes. Pick another one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs no puede adjuntar este archivo: no es de un tipo o tamaño que acepte. Elige otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ne peut pas joindre ce fichier : son type ou sa taille n'est pas accepté. Choisissez-en un autre."
          }
        },
        "it": {
