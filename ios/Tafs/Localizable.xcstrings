    "sample.credits.note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər iş bir dəfə, bitəndə, tam kreditlərlə hesablanır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко изпълнение се отчита веднъж, когато приключи, в цели кредити."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý běh se počítá jednou, když skončí, v celých kreditech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Lauf zählt einmal, wenn er endet, in ganzen Credits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each run counts once, when it ends, in whole credits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ejecución cuenta una vez, al terminar, en créditos enteros."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga käivitus arvestatakse üks kord, kui see lõpeb, täiskrediitides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque exécution compte une fois, à sa fin, en crédits entiers."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako se izvođenje računa jednom, kad završi, u cijelim kreditima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden futás egyszer számít, amikor véget ér, egész kreditekben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր գործարկում հաշվվում է մեկ անգամ, երբ ավարտվում է, ամբողջ կրեդիտներով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap eksekusi dihitung sekali, saat berakhir, dalam kredit utuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni esecuzione conta una volta, quando termina, in crediti interi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各実行は終了時に1回、クレジット単位でカウントされます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყოველი გაშვება ითვლება ერთხელ, როცა მთავრდება, მთელ კრედიტებში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 실행은 끝날 때 한 번, 크레딧 단위로 계산됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas paleidimas skaičiuojamas vieną kartą, jam pasibaigus, sveikais kreditais."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katra palaišana tiek skaitīta vienreiz, kad tā beidzas, veselos kredītos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke run telt één keer, wanneer die eindigt, in hele credits."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde uruchomienie liczy się raz, gdy się kończy, w pełnych kredytach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada execução conta uma vez, quando termina, em créditos inteiros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada execução conta uma vez, quando termina, em créditos inteiros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare rulare se numără o dată, când se încheie, în credite întregi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý beh sa počíta raz, keď skončí, v celých kreditoch."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak zagon se šteje enkrat, ko se konča, v celih kreditih."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo ekzekutim numërohet një herë, kur mbaron, në kredite të plota."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako se izvršavanje naloga jednom, kad završi, u celim kreditima."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละการทำงานนับครั้งเดียวเมื่อสิ้นสุด เป็นเครดิตเต็มหน่วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her çalıştırma, bittiğinde, tam kredi olarak bir kez sayılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lượt chạy được tính một lần, khi nó kết thúc, theo số tín dụng nguyên."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次執行在結束時計算一次，以整數點數計。"
          }
        }
      }
    },
