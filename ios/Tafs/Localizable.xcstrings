        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ სულ %2$@, შემდეგ გეკითხებათ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សរុប %1$@ %2$@ បន្ទាប់មកវាសួរអ្នក"
