    "settings.sign_in_again_why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول مرة أخرى لتسجيل مفتاح الموافقة لهذا الهاتف."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonun təsdiq açarını qeydiyyatdan keçirmək üçün yenidən daxil olun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влезте отново, за да регистрирате ключа за одобрение на този телефон."
          }
