    "billing.ask.line_pack": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Admins deines Kontos erhalten deine Anfrage. Sobald einer das Paket hinzufügt, arbeiten deine tafs weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account's admins get your request. When one adds the pack, your tafs go on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los administradores de tu cuenta reciben tu solicitud. Cuando uno añada el paquete, tus tafs seguirán."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu konto administraatorid saavad sinu taotluse. Kui keegi neist krediidipaketi lisab, saavad sinu tafid jätkata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les administrateurs de votre compte reçoivent votre demande. Dès que l'un d'eux ajoute le pack, vos tafs continuent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli amministratori del tuo account ricevono la tua richiesta. Quando uno aggiunge il pacchetto, i tuoi tafs continuano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼はアカウントの管理者に届きます。管理者がパックを追加すると、tafsは動作を続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정의 관리자에게 요청이 전달됩니다. 관리자가 팩을 추가하면 taf가 계속 작동합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų prašymą gauna paskyros administratoriai. Kai vienas jų prideda paketą, jūsų taf dirba toliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavs pieprasījums tiek nosūtīts konta administratoriem. Kad kāds no viņiem pievieno paketi, tavi taf turpina darbu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beheerders van je account krijgen je verzoek. Zodra er een het pakket toevoegt, gaan je tafs verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratorzy Twojego konta otrzymają Twoją prośbę. Gdy któryś doda pakiet, Twoje tafs będą działać dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os administradores da sua conta recebem o seu pedido. Quando um deles adicionar o pacote, os seus tafs continuam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os administradores da sua conta recebem o seu pedido. Quando um deles adicionar o pacote, os seus tafs continuam."
          }
        }
      }
    },
    "billing.ask.line_raise": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Admins deines Kontos erhalten deine Anfrage. Sobald einer das Ausgabenlimit erhöht, arbeiten deine tafs weiter."
          }
