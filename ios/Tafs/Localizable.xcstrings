        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@। %3$@ सम्म जवाफ दिनुहोस्। तपाईंले स्वीकृत नगरेसम्म केही पठाइँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Antwoord vóór %3$@. Er wordt niets verzonden tot je goedkeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@. Odpowiedz do %3$@. Nic nie zostanie wysłane, dopóki nie zatwierdzisz."
