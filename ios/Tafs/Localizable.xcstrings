        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი taf არ მუშაობს, სანამ არ დაყენდება ან არ გააუქმებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "taf របស់អ្នកមិនដំណើរការទេ រហូតដល់វាត្រូវបានដំឡើង ឬអ្នកបោះបង់។"
