        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შედით KIFF-ით, რომ თქვენი ჩატები ექსპორტირდეს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចូលដោយ KIFF ដើម្បីនាំចេញការសន្ទនារបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅을 내보내려면 KIFF로 로그인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຂົ້າສູ່ລະບົບດ້ວຍ KIFF ເພື່ອສົ່ງອອກການສົນທະນາຂອງທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijunkite su KIFF, kad galėtumėte eksportuoti savo pokalbius."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieraksties ar KIFF, lai eksportētu savas sarunas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Најави се со KIFF за да ги извезеш твоите разговори."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
