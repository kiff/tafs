    "connect.through_provider": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ meldet sich über seinen Verbindungsanbieter an. Um dich erneut anzumelden, trenne es und verbinde es neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signs in through its connection provider. To sign in again, disconnect it and connect it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ inicia sesión a través de su proveedor de conexión. Para volver a iniciar sesión, desconéctalo y conéctalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se connecte via son fournisseur de connexion. Pour vous reconnecter, déconnectez-le puis connectez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ accede tramite il suo fornitore di collegamenti. Per accedere di nuovo, scollegalo e collegalo di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ logt in via zijn koppelingsprovider. Om opnieuw in te loggen, ontkoppel je hem en koppel je hem opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ loguje się przez swojego dostawcę połączeń. Aby zalogować się ponownie, rozłącz go i połącz jeszcze raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ inicia sessão através do seu fornecedor de ligação. Para iniciar sessão novamente, desligue-o e ligue-o outra vez."
          }
        }
      }
    },
