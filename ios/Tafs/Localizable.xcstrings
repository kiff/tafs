    "billing.cancel_any_time_least_day": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الإلغاء في أي وقت، قبل التجديد بيوم على الأقل، من «الاشتراكات» في حساب Apple الخاص بك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstənilən vaxt, yenilənmədən ən azı bir gün əvvəl, Apple hesabınızın Abunəliklərində ləğv edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да анулирате по всяко време, поне един ден преди подновяването, в „Абонаменти“ на акаунта си в Apple."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো সময়, নবায়নের অন্তত একদিন আগে, আপনার Apple অ্যাকাউন্টের সাবস্ক্রিপশনে বাতিল করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel·la quan vulguis, almenys un dia abans de la renovació, a les Subscripcions del teu compte d'Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušit můžete kdykoli, nejpozději den před obnovením, v Předplatných svého účtu Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jederzeit kündbar, spätestens einen Tag vor der Verlängerung, unter „Abonnements“ in deinem Apple-Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel any time, at least a day before it renews, in your Apple account's Subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela cuando quieras, al menos un día antes de la renovación, en Suscripciones de tu cuenta de Apple."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühista igal ajal, vähemalt päev enne uuenemist, oma Apple'i konto tellimustes (Subscriptions)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez à tout moment, au moins un jour avant le renouvellement, dans les Abonnements de votre compte Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לבטל בכל עת, לפחות יום לפני החידוש, במנויים של חשבון Apple שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी समय, नवीनीकरण से कम से कम एक दिन पहले, अपने Apple खाते की सदस्यताओं में रद्द करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otkažite bilo kada, najmanje dan prije obnove, u Pretplatama svojeg Apple računa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor lemondhatod, legalább egy nappal a megújulás előtt, az Apple-fiókod Előfizetések részében."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չեղարկեք ցանկացած ժամանակ՝ նորացումից առնվազն մեկ օր առաջ, ձեր Apple հաշվի Բաժանորդագրություններում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan kapan saja, minimal sehari sebelum diperpanjang, di Langganan akun Apple Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla quando vuoi, almeno un giorno prima del rinnovo, negli Abbonamenti del tuo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新の1日前までなら、Apple IDのサブスクリプションでいつでも解約できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გააუქმეთ ნებისმიერ დროს, განახლებამდე მინიმუმ ერთი დღით ადრე, თქვენი Apple ანგარიშის გამოწერებში."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បោះបង់គ្រប់ពេល យ៉ាងតិចមួយថ្ងៃមុនពេលវាបន្ត ក្នុងការជាវរបស់គណនី Apple របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갱신 최소 하루 전까지 Apple 계정의 구독에서 언제든지 취소할 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍົກເລີກໄດ້ທຸກເວລາ ຢ່າງໜ້ອຍໜຶ່ງມື້ກ່ອນມັນຕໍ່ອາຍຸ ໃນການສະໝັກຂອງບັນຊີ Apple ຂອງທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atšaukite bet kada, ne vėliau kaip likus dienai iki atnaujinimo, savo Apple paskyros prenumeratose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atcel jebkurā laikā, vismaz dienu pirms atjaunošanas, sava Apple konta sadaļā Abonementi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Откажи во кое било време, најмалку еден ден пред да се обнови, во Претплатите на твојата Apple сметка."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сунгагдахаас дор хаяж нэг өдрийн өмнө Apple бүртгэлийнхээ Захиалгууд хэсгээс хэдийд ч цуцлаж болно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीकरणभन्दा कम्तीमा एक दिन अघि, आफ्नो Apple खाताका सदस्यताहरूमा जुनसुकै बेला रद्द गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt altijd opzeggen, minstens een dag voor de verlenging, in Abonnementen van je Apple-account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluj w dowolnym momencie, co najmniej dzień przed odnowieniem, w Subskrypcjach swojego konta Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele quando quiser, pelo menos um dia antes da renovação, nas Subscrições da sua conta Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele quando quiser, pelo menos um dia antes da renovação, em Assinaturas na sua conta Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți anula oricând, cu cel puțin o zi înainte de reînnoire, în Abonamentele contului Apple."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušiť môžete kedykoľvek, najneskôr deň pred obnovením, v Predplatnom svojho účtu Apple."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekličete lahko kadar koli, vsaj dan pred podaljšanjem, v Naročninah svojega računa Apple."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuloni në çdo kohë, të paktën një ditë para se të rinovohet, te Abonimet e llogarisë suaj Apple."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Otkažite bilo kad, najmanje dan pre obnavljanja, u Pretplatama svog Apple naloga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกได้ทุกเมื่ออย่างน้อยหนึ่งวันก่อนต่ออายุ ในการสมัครใช้งานของบัญชี Apple ของคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Islendik wagt, täzelenmeden azyndan bir gün öň, Apple hasabyňyzyň Abunalarynda ýatyryň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenilenmesinden en az bir gün önce, Apple hesabınızın Abonelikler bölümünden istediğiniz zaman iptal edin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی بھی وقت، تجدید سے کم از کم ایک دن پہلے، اپنے Apple اکاؤنٹ کی سبسکرپشنز میں منسوخ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy bất cứ lúc nào, ít nhất một ngày trước khi gia hạn, trong mục Gói đăng ký của tài khoản Apple của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可隨時取消，請至少在續訂前一天，於您的 Apple 帳號的「訂閱」中取消。"
          }
        }
      }
    },
    "billing.contact_support": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع KIFF إضافة هذه العملية إلى هذا الحساب. لقد دفعت ثمنها، فتواصل مع الدعم على support@kiff.dev وسنحل الأمر."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF bu alışı bu hesaba əlavə edə bilmir. Siz onun üçün ödəmisiniz, ona görə support@kiff.dev ünvanında dəstəyə müraciət edin, biz həll edəcəyik."
