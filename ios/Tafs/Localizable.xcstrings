            "value": "«না» বললে এর Card জায়গা ফিরে পায়। উত্তর দিতে %1$@ লাগে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«No» retorna el marge al seu Card. Respondre demana %1$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vrátí jeho Card prostor. Odpověď vyžaduje %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nein“ gibt seiner Card den Spielraum zurück. Zum Antworten wird %1$@ abgefragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No gives its Card the room back. Answering asks for %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«No» devuelve el margen a su Card. Para responder se pide %1$@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ei” annab selle Cardile ruumi tagasi. Vastad %1$@ abil."
