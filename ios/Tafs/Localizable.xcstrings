    "record.tool_refused_amount": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ onu rədd etdi. Heç nə edilmədi, amma o, yenə də bugünkü cəmə daxildir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ го отказа. Нищо не беше направено, но все пак се отчита в днешния общ лимит."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to odmítl(a). Nic se neudělalo, ale pořád se to počítá do dnešního celkového limitu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat es abgelehnt. Es wurde nichts ausgeführt, aber es zählt trotzdem zur heutigen Summe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ refused it. Nothing was done, but it still counts against today's total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lo rechazó. No se hizo nada, pero sigue contando para el total de hoy."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ keeldus. Midagi ei tehtud, kuid see läheb ikka tänase kogusumma arvesse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ l'a refusé. Rien n'a été fait, mais cela compte quand même dans le total du jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je to odbila. Ništa nije učinjeno, ali se i dalje računa u današnji ukupni iznos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ elutasította. Semmi sem történt, de a mai összesítőbe így is beleszámít."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը մերժեց այն։ Ոչինչ չարվեց, բայց այն դեռ հաշվարկվում է այսօրվա ընդհանուրի դեմ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ menolaknya. Tidak ada yang dilakukan, tetapi tetap dihitung terhadap total hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ l'ha rifiutata. Non è stato fatto nulla, ma conta comunque nel totale di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が拒否しました。何も実行されていませんが、今日の合計にはカウントされます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-მ უარყო. არაფერი გაკეთებულა, მაგრამ ის მაინც ითვლება დღევანდელი ჯამის წინააღმდეგ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 거절했습니다. 아무것도 하지 않았지만 오늘 합계에는 여전히 포함됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tai atmetė. Nieko nepadaryta, bet tai vis tiek įskaičiuojama į šiandienos bendrą sumą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to atteica. Nekas netika izdarīts, bet tas joprojām tiek ieskaitīts šodienas kopsummā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft het geweigerd. Er is niets gedaan, maar het telt nog wel mee voor het totaal van vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to odrzucił. Nic nie zostało zrobione, ale nadal liczy się do dzisiejszej sumy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recusou. Nada foi feito, mas continua a contar para o total de hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recusou. Nada foi feito, mas continua contando para o total de hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ l-a refuzat. Nu s-a făcut nimic, dar se numără totuși în totalul de azi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to odmietol (odmietla). Nič sa neurobilo, ale stále sa to počíta do dnešného celkového limitu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je to zavrnil(a). Nič ni bilo storjeno, a se še vedno šteje v današnjo skupno vsoto."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ e refuzoi. Asgjë nuk u bë, por prapë numërohet kundrejt totalit të sotëm."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je to odbila. Ništa nije učinjeno, ali se i dalje naloga u današnji ukupni iznos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ปฏิเสธ ยังไม่ได้ทำอะไร แต่ยังนับรวมในยอดของวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reddetti. Hiçbir şey yapılmadı ama yine de bugünkü toplama sayılıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã từ chối. Chưa làm gì cả, nhưng nó vẫn được tính vào tổng hôm nay."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@拒絕了。未做任何事，但仍計入今天的總額。"
          }
        }
      }
    },
