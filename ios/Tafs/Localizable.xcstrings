    "version.not_a_trial.confirmed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF sınaq başlatmadı: bu Card-ları taf-ın öz Card-ları kimi verdi. Onun Card sekməsinə baxın və ya əvvəlki versiyanı quraşdırın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF не стартира проба: издаде тези Cards като собствени на taf. Проверете раздела Card или инсталирайте версията, която имахте."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nespustil zkoušku: vydal tyto Card jako vlastní Card tafu. Zkontrolujte jeho kartu Card, nebo nainstalujte verzi, kterou jste měli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hat keinen Test gestartet: Es hat diese Cards als die eigenen des tafs ausgestellt. Prüfe seinen Card-Tab oder installiere die Version, die du hattest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF didn't start a trial: it issued these Cards as the taf's own. Check its Card tab, or install the version you had."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no inició una prueba: emitió estas Cards como propias del taf. Revisa su pestaña Card, o instala la versión que tenías."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei alustanud proovi: see väljastas need Cardid tafi enda omadena. Kontrolli selle Cardi vahekaarti või paigalda varasem versioon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas lancé d'essai : il a émis ces Cards comme celles du taf. Vérifiez son onglet Card, ou installez la version que vous aviez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nije pokrenuo probu: izdao je ove Cardove kao vlastite Cardove tafa. Provjerite njegovu karticu Card ili instalirajte verziju koju ste imali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF nem indított próbát: ezeket a Cardokat a taf sajátjaként adta ki. Nézd meg a Card lapját, vagy telepítsd a korábbi verziót."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը փորձարկում չսկսեց․ այն այս Card-երը թողարկեց որպես taf-ի սեփական։ Ստուգեք նրա Card-ի ներդիրը կամ տեղադրեք այն տարբերակը, որ ունեիք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF tidak memulai uji coba: ia menerbitkan Card ini sebagai Card milik taf sendiri. Periksa tab Card-nya, atau pasang versi yang Anda miliki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non ha avviato una prova: ha emesso queste Card come Card proprie del taf. Controlla la sua scheda Card, o installa la versione che avevi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFは試用を開始せず、これらのCardをtaf自身のものとして発行しました。Cardタブを確認するか、元のバージョンをインストールしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-მა ცდა არ დაიწყო: მან ეს Card-ები taf-ის საკუთრად გასცა. შეამოწმეთ მისი Card-ის ჩანართი ან დააყენეთ ვერსია, რომელიც გქონდათ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 시험을 시작하지 않고 이 Card들을 taf의 자체 Card로 발급했습니다. Card 탭을 확인하거나, 쓰던 버전을 설치하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nepradėjo bandymo: išdavė šias Card kaip paties taf. Patikrinkite jo Card skirtuką arba įdiekite turėtą versiją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nesāka izmēģinājumu: tas izsniedza šīs Card kā paša taf Card. Pārbaudi tā cilni Card vai instalē versiju, kas tev bija."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF heeft geen proef gestart: het heeft deze Cards uitgegeven als die van het taf zelf. Controleer het tabblad Card, of installeer de versie die je had."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie rozpoczął próby: wydał te Card jako własne Card tafa. Sprawdź jego kartę Card albo zainstaluj wcześniejszą wersję."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não iniciou uma experiência: emitiu estes Cards como sendo do próprio taf. Verifique o separador Card, ou instale a versão que tinha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não iniciou uma experiência: emitiu estes Cards como sendo do próprio taf. Verifique o separador Card, ou instale a versão que tinha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nu a pornit o probă: a emis aceste Carduri ca proprii ale tafului. Verificați fila Card sau instalați versiunea pe care o aveați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nespustil skúšku: vydal tieto Card ako vlastné Card tafu. Skontrolujte jeho kartu Card, alebo nainštalujte verziu, ktorú ste mali."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ni začel preizkusa: te Card je izdal kot lastne Card tafa. Preverite njegov zavihek Card ali namestite različico, ki ste jo imeli."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nuk nisi një provë: i lëshoi këta Card si të vetë taf-it. Kontrolloni skedën e tij Card, ose instaloni versionin që keni pasur."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nije pokrenuo probu: izdao je ove Cardove kao vlastite Cardove tafa. Proverite njegovu karticu Card ili instalirajte verziju koju ste imali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ไม่ได้เริ่มการทดลอง: มันออก Card เหล่านี้เป็น Card ของ taf เอง ตรวจสอบแท็บ Card ของมัน หรือติดตั้งเวอร์ชันที่คุณมี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF bir deneme başlatmadı: bu Card'ları taf'ın kendi Card'ları olarak verdi. Card sekmesine bakın veya elinizdeki sürümü kurun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF chưa bắt đầu lần thử: nó đã cấp các Card này như Card của chính taf. Hãy xem thẻ Card của nó, hoặc cài phiên bản bạn đã có."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF 未開始試用：它把這些 Card 發給了 taf 本身。請查看它的 Card 分頁，或安裝您原本的版本。"
          }
        }
      }
    },
    "version.not_a_trial.other": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF bu versiya üçün sınaq başlatmadı (cavab: %1$@). Onun altında heç nə işləmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF не стартира проба за тази версия (отговори %1$@). Нищо не работи под нея."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF pro tuto verzi nespustil zkoušku (odpověděl %1$@). Pod ní nic neběží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hat für diese Version keinen Test gestartet (Antwort: %1$@). Unter ihr läuft nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF didn't start a trial for this version (it answered %1$@). Nothing runs under it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no inició una prueba para esta versión (respondió %1$@). No se ejecuta nada con ella."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei alustanud selle versiooni proovi (vastas %1$@). Selle all ei tööta midagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas lancé d'essai pour cette version (il a répondu %1$@). Rien ne s'exécute sous celle-ci."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nije pokrenuo probu za ovu verziju (odgovorio je: %1$@). Ništa ne radi pod njom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF nem indított próbát ehhez a verzióhoz (válasza: %1$@). Semmi sem fut alatta."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը այս տարբերակի համար փորձարկում չսկսեց (պատասխանեց %1$@)։ Դրա տակ ոչինչ չի աշխատում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF tidak memulai uji coba untuk versi ini (menjawab %1$@). Tidak ada yang berjalan di bawahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non ha avviato una prova per questa versione (ha risposto %1$@). Non viene eseguito nulla con essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFはこのバージョンの試用を開始しませんでした（応答：%1$@）。このバージョンでは何も実行されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-მა ამ ვერსიისთვის ცდა არ დაიწყო (უპასუხა %1$@). მის ქვეშ არაფერი მუშაობს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 이 버전의 시험을 시작하지 않았습니다(응답: %1$@). 이 버전으로는 아무것도 실행되지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
