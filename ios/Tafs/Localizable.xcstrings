    "coach.waiting_for_vendor": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təchizatçının giriş səhifəsi açılıbsa, onu orada tamamlayın və qayıdın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако страницата за вход на доставчика се отвори, завършете там и се върнете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se otevřela přihlašovací stránka dodavatele, dokončete to tam a vraťte se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich die Anmeldeseite des Anbieters geöffnet hat, schließ die Anmeldung dort ab und komm zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the vendor's sign-in page opened, finish it there and come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se abrió la página de inicio de sesión del proveedor, termina allí y vuelve."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui pakkuja sisselogimisleht avanes, lõpeta seal ja tule tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la page de connexion du fournisseur s'est ouverte, terminez-la là-bas et revenez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako se otvorila pružateljeva stranica za prijavu, dovršite je tamo i vratite se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha megnyílt a szolgáltató bejelentkezési oldala, fejezd be ott, és gyere vissza."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե մատակարարի մուտքի էջը բացվեց, ավարտեք այնտեղ և վերադարձեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika halaman masuk vendor terbuka, selesaikan di sana lalu kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se si è aperta la pagina di accesso del fornitore, completala lì e torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供元のサインインページが開いた場合は、そこで完了してから戻ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ მომწოდებლის შესვლის გვერდი გაიხსნა, დაასრულეთ იქ და დაბრუნდით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스의 로그인 페이지가 열렸다면 거기서 마친 뒤 돌아오세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei atsidarė teikėjo prisijungimo puslapis, užbaikite ten ir grįžkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja atvērās nodrošinātāja pierakstīšanās lapa, pabeidz to tur un atgriezies."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de inlogpagina van de leverancier is geopend, rond het daar af en kom terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli otworzyła się strona logowania dostawcy, dokończ tam i wróć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a página de início de sessão do fornecedor abriu, conclua-o lá e volte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a página de login do fornecedor abriu, conclua-o lá e volte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă s-a deschis pagina de conectare a furnizorului, terminați acolo și reveniți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak sa otvorila prihlasovacia stránka dodávateľa, dokončite to tam a vráťte sa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če se je odprla stran za prijavo ponudnika, jo dokončajte tam in se vrnite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse u hap faqja e hyrjes së furnizuesit, përfundojeni atje dhe ktheheni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
