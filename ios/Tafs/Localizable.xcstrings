        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach에게 개발자에게 이메일로 보내 달라고 하기"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃຫ້ Coach ສົ່ງອີເມວອັນນີ້ຫານັກພັດທະນາ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paprašyti Coach išsiųsti tai el. paštu programuotojui"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Palūdz Coach nosūtīt tos izstrādātājam pa e-pastu"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Побарај од Coach да им ги испрати по е-пошта на програмер"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-аас эдгээрийг хөгжүүлэгчид имэйлээр илгээхийг хүсэх"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach लाई यी डेभलपरलाई इमेल गर्न भन्नुहोस्"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag Coach dit naar een ontwikkelaar te mailen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś Coacha, by wysłał to e-mailem do programisty"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir ao Coach que envie isto por email a um programador"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir ao Coach que envie isto por email a um programador"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cereți-i lui Coach să le trimită prin e-mail unui dezvoltator"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Požiadať Coacha, nech ich pošle e-mailom vývojárovi"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosi Coacha, naj jih pošlje razvijalcu po e-pošti"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kërkojini Coach t'ia dërgojë këto me email një zhvilluesi"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamolite Coacha da ih e-poštom pošalje razvojnom programeru"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้ Coach ส่งอีเมลสิ่งเหล่านี้ถึงนักพัฒนา"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-dan muny ösdürijä email etmegi soraň"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach'tan bunları bir geliştiriciye e-postalamasını iste"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach سے کہیں کہ یہ کسی ڈیولپر کو ای میل کر دے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhờ Coach gửi email những điều này cho một lập trình viên"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
