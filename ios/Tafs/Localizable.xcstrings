    "record.report.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبلغ عن دفعة لم تكن تتوقعها: دفع %1$@ مبلغ %2$@ في %3$@. سنجمّد %1$@ إلى أن تراجع الأمر."
