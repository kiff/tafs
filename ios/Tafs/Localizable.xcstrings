    "coach.not_connectable": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqlərin qoşulması bu hesab üçün bu telefondan qurulmayıb. Başlatmaq üçün Coach-u açın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свързването на приложения не е настроено за този акаунт от този телефон. Отворете Coach, за да го стартирате."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojování aplikací není pro tento účet z tohoto telefonu nastavené. Spusťte ho otevřením Coache."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verbinden von Apps ist für dieses Konto auf diesem Telefon nicht eingerichtet. Öffne Coach, um es zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting apps isn't set up for this account from this phone. Open Coach to start it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión de apps no está configurada para esta cuenta desde este teléfono. Abre Coach para empezar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakenduste ühendamine pole selle konto jaoks selles telefonis seadistatud. Alustamiseks ava Coach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion d'apps n'est pas configurée pour ce compte depuis ce téléphone. Ouvrez Coach pour la lancer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezivanje aplikacija nije postavljeno za ovaj račun s ovog telefona. Otvorite Coacha da ga pokrenete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazások csatlakoztatása nincs beállítva ehhez a fiókhoz erről a telefonról. Indítsd el a Coach megnyitásával."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածների միացումը այս հեռախոսից այս հաշվի համար կարգավորված չէ։ Բացեք Coach-ը՝ սկսելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghubungkan aplikasi belum disiapkan untuk akun ini dari ponsel ini. Buka Coach untuk memulainya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento delle app non è configurato per questo account da questo telefono. Apri Coach per avviarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンからは、このアカウントのアプリ接続が設定されていません。Coachを開いて始めてください。"
          }
        },
        "ka": {
          "stringUnit": {
