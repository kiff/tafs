        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্টের জন্য এই ফোন থেকে ঘটনা অনুমোদন সেট আপ করা নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar esdeveniments no està configurat per a aquest compte des d'aquest telèfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
