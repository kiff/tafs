    "chat.export_not_what_tafs_cloud": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İxrac tafs cloud-un göndərdiyi şey deyil."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортът не е това, което изпраща tafs cloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Export není to, co tafs cloud posílá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Export entspricht nicht dem, was tafs cloud sendet."
