    "connect.apps.disconnect_why": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Girişi silmək alətləri yalnız həmin taf-dan və Card-ı onlardan istifadə edən hər taf-dan götürür. Digər taf-lar öz alətlərini saxlayır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Премахването на достъпа отнема инструментите му само от този taf и от всеки taf, чиято Card ги използва. Другите tafs запазват своите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrání přístupu vezme jeho nástroje jen tomu tafu a každému tafu, jehož Card je používá. Ostatní tafy si své nechají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du einen Zugriff entfernst, werden seine Tools nur von diesem taf entfernt und von jedem taf, dessen Card sie nutzt. Andere tafs behalten ihre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing access takes its tools from that taf only, and from any taf whose Card uses them. Other tafs keep theirs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar un acceso retira sus herramientas solo de ese taf, y de cualquier taf cuya Card las use. Los demás tafs conservan las suyas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Juurdepääsu eemaldamine võtab selle tööriistad ainult sellelt tafilt ja igalt tafilt, mille Card neid kasutab. Teised tafid jäävad oma tööriistadega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer un accès retire ses outils de ce taf uniquement, et de tout taf dont la Card les utilise. Les autres tafs gardent les leurs."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanjanje pristupa oduzima alate samo tom tafu i svakom tafu čiji Card ih koristi. Ostali tafovi zadržavaju svoje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hozzáférés megszüntetése csak attól a taftól veszi el az eszközeit, és minden olyan taftól, amelynek a Cardja használja őket. A többi taf megtartja a sajátját."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հասանելիության հեռացումը գործիքները վերցնում է միայն այդ taf-ից և ցանկացած taf-ից, որի Card-ը դրանք օգտագործում է։ Մյուս taf-երը պահում են իրենցը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus akses mencabut alatnya hanya dari taf itu, dan dari taf mana pun yang Card-nya memakainya. Taf lain tetap memiliki alatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere un accesso toglie i suoi strumenti solo da quel taf, e da ogni taf la cui Card li usa. Gli altri taf mantengono i loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを削除すると、そのtafと、そのツールをCardで使うtafからだけツールが外れます。他のtafはそのまま使えます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წვდომის ამოღება ინსტრუმენტებს ართმევს მხოლოდ იმ taf-ს და ნებისმიერ taf-ს, რომლის Card მათ იყენებს. სხვა taf-ებს თავისი რჩება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 권한을 삭제하면 그 taf와, 그 도구를 Card에 쓰는 taf에서만 도구가 빠집니다. 다른 tafs는 그대로 유지합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pašalinus prieigą, jos įrankiai atimami tik iš to taf ir iš kiekvieno taf, kurio Card juos naudoja. Kiti taf savuosius išlaiko."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noņemot piekļuvi, tās rīki tiek atņemti tikai šim taf un jebkuram taf, kura Card tos izmanto. Citi taf savējos patur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang intrekken haalt de tools alleen weg bij die taf, en bij elke taf waarvan de Card ze gebruikt. Andere tafs houden de hunne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie dostępu zabiera jego narzędzia tylko z tego tafa i z każdego tafa, którego Card ich używa. Inne tafy zachowują swoje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover um acesso retira as suas ferramentas apenas desse taf, e de qualquer taf cujo Card as use. Os outros tafs mantêm as suas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover um acesso retira as suas ferramentas apenas desse taf, e de qualquer taf cujo Card as use. Os outros tafs mantêm as suas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminarea accesului îi ia instrumentele doar acelui taf și oricărui taf al cărui Card le folosește. Celelalte tafuri le păstrează pe ale lor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobratie prístupu zoberie jeho nástroje len tomu tafu a každému tafu, ktorého Card ich používa. Ostatné tafy si svoje nechajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranitev dostopa vzame njena orodja samo temu tafu in vsakemu tafu, katerega Card jih uporablja. Drugi tafi obdržijo svoja."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Heqja e qasjes ia heq mjetet vetëm atij taf, dhe çdo taf Card-i i të cilit i përdor. Tafs-et e tjerë i mbajnë të tyret."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanjanje pristupa oduzima alate samo tom tafu i svakom tafu čiji Card ih koristi. Ostali tafovi zadržavaju svoje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถอนสิทธิ์เข้าถึงจะนำเครื่องมือของมันออกจาก taf นั้นเท่านั้น และจาก taf ใดก็ตามที่ Card ใช้เครื่องมือเหล่านั้น taf อื่นยังคงมีของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişimi kaldırmak araçlarını yalnızca o taf'tan ve Card'ı onları kullanan her taf'tan alır. Diğer tafs kendininkileri korur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ quyền truy cập sẽ lấy các công cụ của nó khỏi riêng taf đó, và khỏi mọi taf có Card dùng chúng. Các taf khác vẫn giữ công cụ của mình."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除存取權限只會讓該 taf 失去它的工具，以及任何 Card 使用這些工具的 taf。其他 taf 仍保有自己的工具。"
          }
        }
      }
    },
