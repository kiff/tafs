        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Botas vis dar klausosi, todėl durys lieka. %1$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bots joprojām klausās, tāpēc durvis paliek. %1$@"
