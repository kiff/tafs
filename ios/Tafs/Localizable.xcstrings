        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ taf'ının henüz kapısı yok. Onu yöneten biri ekleyebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chưa có cửa nào. Người quản lý nó có thể thêm một cửa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 還沒有門。管理它的人可以新增。"
          }
        }
      }
