        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre KIFF pour nommer cet appareil. Vérifiez la connexion et réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije bilo moguće doći do KIFF-a da imenuje ovaj uređaj. Provjerite vezu i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült elérni a KIFF-et az eszköz elnevezéséhez. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց կապվել KIFF-ի հետ՝ այս սարքին անուն տալու համար։ Ստուգեք կապը և փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghubungi KIFF untuk menamai perangkat ini. Periksa koneksi lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere KIFF per dare un nome a questo dispositivo. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに名前を付けるためにKIFFに接続できませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-თან დაკავშირება ვერ მოხერხდა ამ მოწყობილობისთვის სახელის დასარქმევად. შეამოწმეთ კავშირი და სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 이름을 정하려고 KIFF에 연결하지 못했습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko pasiekti KIFF, kad būtų pavadintas šis įrenginys. Patikrinkite interneto ryšį ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās sazināties ar KIFF, lai nosauktu šo ierīci. Pārbaudi interneta savienojumu un mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon KIFF niet bereiken om dit apparaat een naam te geven. Controleer de verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z KIFF, aby nazwać to urządzenie. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível contactar o KIFF para dar nome a este dispositivo. Verifique a ligação e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível contatar o KIFF para dar nome a este dispositivo. Verifique a conexão e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nu a putut fi contactat pentru a denumi acest dispozitiv. Verificați conexiunea și încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa spojiť s KIFF a pomenovať toto zariadenie. Skontrolujte pripojenie a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ni bil dosegljiv, da bi poimenoval to napravo. Preverite povezavo in poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuk u arrit te KIFF për ta emërtuar këtë pajisje. Kontrolloni lidhjen dhe provoni sërish."
