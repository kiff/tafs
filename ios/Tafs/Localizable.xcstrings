    "door.api.two_keys": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاحان على الأكثر، لتستبدل أحدهما دون إيقاف الآخر."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ən çoxu iki açar, ki, birini digərini dayandırmadan dəyişə biləsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Най-много два ключа, за да можете да смените единия, без да спирате другия."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোচ্চ দুটি কী, যাতে আপনি একটি বদলে অন্যটি বন্ধ না করেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a màxim dues claus, perquè puguis substituir-ne una sense aturar l'altra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejvýš dva klíče, takže jeden můžete nahradit, aniž zastavíte druhý."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens zwei Schlüssel, damit du einen ersetzen kannst, ohne den anderen zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most two keys, so you can replace one without stopping the other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como máximo dos claves, para que puedas sustituir una sin detener la otra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõige rohkem kaks võtit, et saaksid ühe asendada nii, et teine töötab edasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux clés au plus, pour pouvoir en remplacer une sans arrêter l'autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכל היותר שני מפתחות, כדי שאפשר יהיה להחליף אחד בלי לעצור את השני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम दो कुंजियाँ, ताकि आप एक को दूसरी को रोके बिना बदल सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviše dva ključa, tako da jedan možete zamijeniti bez zaustavljanja drugog."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb két kulcs, hogy az egyiket a másik leállítása nélkül cserélhesd."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առավելագույնը երկու բանալի, որպեսզի մեկը փոխարինեք՝ մյուսը չկանգնեցնելով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paling banyak dua kunci, agar Anda dapat mengganti satu tanpa menghentikan yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo due chiavi, così puoi sostituirne una senza fermare l'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは最大2つなので、一方を止めずにもう一方を置き換えられます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მაქსიმუმ ორი გასაღები, რომ ერთი შეცვალოთ მეორის გაჩერების გარეშე."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កូនសោអតិបរមាពីរ ដើម្បីឱ្យអ្នកអាចជំនួសមួយដោយមិនបញ្ឈប់មួយទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 최대 두 개라서, 하나를 교체하는 동안 다른 하나를 멈추지 않아도 됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສູງສຸດສອງກຸນແຈ ເພື່ອໃຫ້ທ່ານປ່ຽນອັນໜຶ່ງໂດຍບໍ່ຢຸດອີກອັນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Daugiausia du raktai, kad galėtumėte pakeisti vieną, o kitas veiktų toliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vairāk kā divas atslēgas, lai vienu varētu nomainīt, kamēr otra darbojas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Најмногу два клуча, за да можеш да замениш еден без да го запреш другиот."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хамгийн ихдээ хоёр түлхүүр, ингэснээр нэгийг нь нөгөөг зогсоохгүйгээр сольж болно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "बढीमा दुई कुञ्जी, ताकि एउटा अर्कोलाई नरोकी बदल्न सकियोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogstens twee sleutels, zodat je er een kunt vervangen zonder de andere te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwyżej dwa klucze, aby można było wymienić jeden bez zatrzymywania drugiego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo duas chaves, para poder substituir uma sem parar a outra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo duas chaves, para poder substituir uma sem parar a outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mult două chei, ca să puteți înlocui una fără să o opriți pe cealaltă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviac dva kľúče, takže jeden môžete nahradiť bez zastavenia druhého."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Največ dva ključa, da lahko enega zamenjate, ne da bi ustavili drugega."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Më së shumti dy çelësa, që të mund të zëvendësoni njërin pa ndalur tjetrin."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviše dva ključa, tako da jedan možete zameniti bez zaustavljanja drugog."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีได้สูงสุดสองกุญแจ เพื่อให้คุณเปลี่ยนอันหนึ่งได้โดยไม่ต้องหยุดอีกอัน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Iň köp iki açar, şonuň üçin birini beýlekisini togtatman çalşyp bilersiňiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla iki anahtar; böylece birini, diğerini durdurmadan değiştirebilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ سے زیادہ دو کلیدیں، تاکہ آپ دوسری کو روکے بغیر ایک بدل سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa hai khóa, để bạn thay một khóa mà không phải dừng khóa kia."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多兩把金鑰，讓您可以更換其中一把而不必停止另一把。"
          }
        }
      }
    },
