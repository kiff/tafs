          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue chat con ogni taf, comprese quelle con Coach, i nomi dei file che hai allegato e le tue note, come file leggibile e come JSON. Solo tu puoi esportarle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen chats met elk taf, die met Coach inbegrepen, de namen van de bestanden die je hebt bijgevoegd en je notities, als leesbaar bestand en als JSON. Alleen jij kunt ze exporteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje własne czaty z każdym tafem, w tym z Coachem, nazwy załączonych plików i Twoje notatki, jako czytelny plik i jako JSON. Tylko Ty możesz je wyeksportować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus chats com cada taf, incluindo os do Coach, os nomes dos ficheiros que anexou e as suas notas, num ficheiro legível e em JSON. Só você os pode exportar."
          }
        }
      }
    },
