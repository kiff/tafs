    "sample.memory.ask_first": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل قبل أي أمر غير معتاد، حتى عندما يناسب الـ Card."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeyri-adi hər şeydən əvvəl, Card-a uyğun olsa belə, soruşun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Питай, преди да направиш нещо необичайно, дори ако се вписва в Card."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অস্বাভাবিক কিছুর আগে জিজ্ঞেস করুন, Card-এর সঙ্গে মিললেও।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta abans de qualsevol cosa inusual, fins i tot quan encaixi amb el Card."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptat se před čímkoli neobvyklým, i když to odpovídá Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor allem Ungewöhnlichen fragen, auch wenn es zur Card passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask before anything unusual, even when it fits the Card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta antes de cualquier cosa inusual, aunque encaje en la Card."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Küsi enne kõike ebatavalist, isegi kui see mahub Cardi piiresse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander avant toute chose inhabituelle, même si cela entre dans la Card."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשאול לפני כל דבר חריג, גם כשהוא מתאים ל-Card."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी असामान्य होने से पहले पूछें, भले वह Card में फिट हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitajte prije svega neobičnog, čak i kad odgovara Cardu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérdezz, mielőtt bármi szokatlant tennél, akkor is, ha belefér a Cardba."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարցրեք ցանկացած անսովոր բանից առաջ, նույնիսկ երբ այն համապատասխանում է Card-ին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bertanya sebelum hal yang tidak biasa, bahkan saat sesuai Card."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi prima di qualsiasi cosa insolita, anche quando rientra nella Card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardに合っていても、いつもと違うことは先に確認します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იკითხე ნებისმიერ უჩვეულოზე ადრე, Card-ს რომ შეესაბამებოდეს, მაშინაც."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សួរមុនពេលធ្វើអ្វីដែលមិនធម្មតា ទោះបីវាសមនឹង Card ក៏ដោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Card에 맞더라도 평소와 다른 일은 먼저 물어봅니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຖາມກ່ອນສິ່ງທີ່ຜິດປົກກະຕິ, ເຖິງແມ່ນເຫມາະກັບ Card."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Klausti prieš bet ką neįprasta, net jei tai atitinka Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jautāt pirms jebkā neparasta, pat ja tas atbilst Card."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прашај пред нешто невообичаено, дури и кога се вклопува во Card."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
