    "usage.last_period_credits_could_not": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة أرصدة الفترة الماضية. اخترها مرة أخرى لتحاول من جديد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Keçən dövrün kreditləri oxuna bilmədi. Yenidən cəhd etmək üçün onu bir daha seçin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитите за предишния период не можаха да бъдат прочетени. Изберете го отново, за да опитате пак."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গত মেয়াদের ক্রেডিট পড়া যায়নি। আবার চেষ্টা করতে এটি আবার বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'han pogut llegir els crèdits del període anterior. Tria'l de nou per tornar-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredity za minulé období se nepodařilo načíst. Vyberte ho znovu a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Credits des letzten Zeitraums konnten nicht gelesen werden. Wähle ihn erneut, um es noch einmal zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last period's credits couldn't be read. Choose it again to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los créditos del periodo anterior. Vuelve a elegirlo para reintentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eelmise perioodi krediite ei õnnestunud lugeda. Uuesti proovimiseks vali see uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les crédits de la période précédente n'ont pas pu être lus. Choisissez-la à nouveau pour réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא את הקרדיטים של התקופה הקודמת. יש לבחור אותה שוב כדי לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली अवधि के क्रेडिट पढ़े नहीं जा सके। फिर कोशिश करने के लिए इसे फिर चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredite prošlog razdoblja nije bilo moguće pročitati. Odaberite ga ponovno da pokušate opet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előző időszak kreditjeit nem sikerült beolvasni. Az újrapróbáláshoz válaszd ki újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերջին ժամանակահատվածի կրեդիտները չկարողացան կարդացվել։ Ընտրեք այն նորից՝ կրկին փորձելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit periode lalu tidak dapat dibaca. Pilih lagi untuk mencoba kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere i crediti del periodo precedente. Sceglilo di nuovo per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の期間のクレジットを読み込めませんでした。再試行するにはもう一度選択してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოლო პერიოდის კრედიტები ვერ წაიკითხა. აირჩიეთ ხელახლა, რომ კვლავ სცადოთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចអានក្រេឌីតនៃរយៈពេលមុនបានទេ។ ជ្រើសរើសវាម្តងទៀតដើម្បីព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 기간의 크레딧을 읽지 못했습니다. 다시 시도하려면 다시 선택하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອ່ານເຄຣດິດຂອງໄລຍະກ່ອນບໍ່ໄດ້. ເລືອກມັນອີກເພື່ອລອງໃໝ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko nuskaityti ankstesnio laikotarpio kreditų. Pasirinkite jį dar kartą, kad bandytumėte iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iepriekšējā perioda kredītus nevarēja nolasīt. Izvēlies to vēlreiz, lai mēģinātu vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитите од минатиот период не можеа да се прочитаат. Избери го повторно за да се обидеш пак."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өмнөх үеийн кредитийг уншиж чадсангүй. Дахин оролдохын тулд түүнийг дахин сонгоно уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अघिल्लो अवधिको क्रेडिट पढ्न सकिएन। फेरि प्रयास गर्न यसलाई फेरि छान्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De credits van de vorige periode konden niet worden gelezen. Kies die periode opnieuw om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać kredytów z poprzedniego okresu. Wybierz go ponownie, aby spróbować jeszcze raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os créditos do período anterior. Escolha-o novamente para tentar outra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os créditos do período anterior. Escolha-o novamente para tentar outra vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creditele perioadei trecute nu au putut fi citite. Alegeți-o din nou pentru a reîncerca."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredity za minulé obdobie sa nepodarilo načítať. Vyberte ho znova a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditov prejšnjega obdobja ni bilo mogoče prebrati. Izberite ga znova za nov poskus."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditet e periudhës së fundit nuk u lexuan dot. Zgjidheni sërish për të provuar përsëri."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredite prošlog razdoblja nije bilo moguće pročitati. Odaberite ga ponovo da pokušate opet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเครดิตของรอบที่แล้วไม่ได้ เลือกใหม่เพื่อลองอีกครั้ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Soňky döwrüň kreditleri okalyp bilinmedi. Täzeden synanyşmak üçin ony ýene saýlaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen dönemin kredileri okunamadı. Tekrar denemek için yeniden seçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پچھلی مدت کے کریڈٹس پڑھے نہیں جا سکے۔ دوبارہ کوشش کرنے کے لیے اسے دوبارہ چنیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc tín dụng của kỳ trước. Hãy chọn lại để thử lần nữa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取上一期的點數。再次選擇即可重試。"
          }
        }
      }
    },
    "usage.limit_ceiling": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد في أعلى مستوى يمكن رفعه إليه من التطبيق. تواصل مع KIFF لرفعه أكثر."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit tətbiqdən artırıla biləcəyi qədər yüksəkdir. Daha da artırmaq üçün KIFF ilə əlaqə saxlayın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимитът е толкова висок, колкото може да бъде увеличен от приложението. Свържете се с KIFF, за да го увеличите още."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ থেকে যতটা বাড়ানো যায় সীমা ততটাই উঁচু। আরও বাড়াতে KIFF-এর সঙ্গে যোগাযোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El límit és tan alt com es pot pujar des de l'aplicació. Contacta amb KIFF per pujar-lo més."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit je tak vysoko, jak to z aplikace jde. Pro další zvýšení kontaktujte KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit ist so hoch, wie es sich in der App erhöhen lässt. Wende dich an KIFF, um es weiter zu erhöhen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limit is as high as it can be raised from the app. Contact KIFF to raise it further."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite está tan alto como se puede subir desde la app. Contacta con KIFF para subirlo más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiit on nii suur, kui rakendusest saab seda suurendada. Veel suurendamiseks võta ühendust KIFFiga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite est au plus haut possible depuis l'app. Contactez KIFF pour aller au-delà."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המגבלה גבוהה ככל שאפשר להעלות מהאפליקציה. כדי להעלות אותה עוד יש לפנות ל-KIFF."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमा उतनी ऊँची है जितनी ऐप से बढ़ाई जा सकती है। इसे और बढ़ाने के लिए KIFF से संपर्क करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograničenje je podignuto koliko se iz aplikacije može. Obratite se KIFF-u da ga podigne dalje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A limit már olyan magas, amennyire az alkalmazásból emelhető. A további emeléshez fordulj a KIFF-hez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահմանաչափը այնքան բարձր է, որքան կարելի է բարձրացնել հավելվածից։ Կապվեք KIFF-ի հետ՝ այն ավելի բարձրացնելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batasnya sudah setinggi yang dapat dinaikkan dari aplikasi. Hubungi KIFF untuk menaikkannya lebih lanjut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite è già al massimo aumentabile dall'app. Contatta KIFF per aumentarlo ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリから引き上げられる最大の上限です。さらに引き上げるにはKIFFにお問い合わせください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლიმიტი იმდენად მაღალია, რამდენადაც აპიდან შეიძლება გაიზარდოს. დაუკავშირდით KIFF-ს მისი კიდევ გასაზრდელად."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដែនកំណត់ខ្ពស់បំផុតតាមដែលអាចបង្កើនបានពីកម្មវិធី។ ទាក់ទង KIFF ដើម្បីបង្កើនបន្ថែម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 올릴 수 있는 최대 한도입니다. 더 올리려면 KIFF에 문의하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຂີດຈຳກັດສູງເທົ່າທີ່ເພີ່ມໄດ້ຈາກແອັບ. ຕິດຕໍ່ KIFF ເພື່ອເພີ່ມຕື່ມ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitas jau toks didelis, kiek jį galima padidinti programėlėje. Norėdami didinti toliau, susisiekite su KIFF."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits ir tik augsts, cik to var palielināt lietotnē. Lai to palielinātu vēl, sazinies ar KIFF."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимитот е колку што може да се зголеми од апликацијата. Јави се на KIFF за да го зголемиш повеќе."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хязгаар аппаас нэмэгдүүлж болох дээд хэмжээндээ хүрсэн. Цаашид нэмэгдүүлэхийг KIFF-тэй холбогдож хүсэх."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमा एपबाट बढाउन सकिने अधिकतम स्तरमा छ। थप बढाउन KIFF सँग सम्पर्क गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De limiet is zo hoog als hij vanuit de app kan worden verhoogd. Neem contact op met KIFF om hem verder te verhogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit jest już tak wysoki, jak można go podnieść w aplikacji. Skontaktuj się z KIFF, aby go podnieść."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite está no máximo que pode ser aumentado a partir da app. Contacte o KIFF para o aumentar mais."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite está no máximo que pode ser aumentado a partir do app. Entre em contato com o KIFF para aumentá-lo mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita este deja cât de mare poate fi mărită din aplicație. Contactați KIFF pentru a o mări mai mult."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit je taký vysoký, ako sa z aplikácie dá. Na ďalšie zvýšenie kontaktujte KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omejitev je tako visoka, kot jo je mogoče zvišati v aplikaciji. Za nadaljnje zvišanje se obrnite na KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kufiri është aq i lartë sa mund të ngrihet nga aplikacioni. Kontaktoni KIFF për ta rritur më tej."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograničenje je podignuto koliko se iz aplikacije može. Obratite se KIFF-u da ga podigne dalje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขีดจำกัดถึงระดับสูงสุดที่เพิ่มได้จากแอปแล้ว ติดต่อ KIFF เพื่อเพิ่มอีก"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Çäk programmadan ýokary galdyrylyp bilinjek iň ýokary derejede. Has ýokary galdyrmak üçin KIFF bilen habarlaşyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit, uygulamadan yükseltilebilecek en yüksek düzeyde. Daha fazla yükseltmek için KIFF ile iletişime geçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حد اتنی بلند ہے جتنی ایپ سے بڑھائی جا سکتی ہے۔ مزید بڑھانے کے لیے KIFF سے رابطہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hạn mức đã ở mức cao nhất có thể nâng từ ứng dụng. Hãy liên hệ KIFF để nâng thêm."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上限已達可從 App 提高的最高值。請聯絡 KIFF 以進一步提高。"
          }
        }
      }
    },
    "usage.limit_changed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر الحد في الأثناء. هذا هو الآن: ارفعه مرة أخرى إن كان لا يزال لازمًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit bu arada dəyişdi. İndiki halı budur: hələ də lazımdırsa, yenidən artırın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимитът междувременно се промени. Ето го сега: увеличете го отново, ако още е нужно."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইতিমধ্যে সীমা বদলেছে। এখন এটি এমন: তবু দরকার হলে আবার বাড়ান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El límit ha canviat mentrestant. Aquí el tens ara: torna a pujar-lo si encara cal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit se mezitím změnil. Tady je teď: zvyšte ho znovu, pokud je to pořád potřeba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit hat sich inzwischen geändert. So ist es jetzt: Erhöhe es erneut, wenn es noch nötig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limit changed meanwhile. Here it is now: raise it again if it's still needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite cambió mientras tanto. Así está ahora: vuelve a subirlo si aún hace falta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiit muutus vahepeal. Siin on see praegu: suurenda seda uuesti, kui seda on veel vaja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite a changé entre-temps. La voici maintenant : relevez-la à nouveau si c'est encore nécessaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המגבלה השתנתה בינתיים. הנה היא עכשיו: יש להעלות אותה שוב אם עדיין צריך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमा इस बीच बदल गई। यह अभी जैसी है: यदि अब भी ज़रूरी हो तो फिर बढ़ाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograničenje se u međuvremenu promijenilo. Evo kakvo je sada: podignite ga ponovno ako je još potrebno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A limit közben megváltozott. Ez a mostani: emeld újra, ha még szükséges."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահմանաչափը այդ ընթացքում փոխվել է։ Ահա ինչպես է հիմա․ բարձրացրեք նորից, եթե դեռ պետք է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas berubah sementara itu. Ini keadaan sekarang: naikkan lagi jika masih diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel frattempo il limite è cambiato. Eccolo ora: aumentalo di nuovo se serve ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その間に上限が変更されました。現在の上限は次のとおりです。まだ必要なら、もう一度引き上げてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლიმიტი ამასობაში შეიცვალა. აი ახლა როგორია: გაზარდეთ ხელახლა, თუ ჯერ კიდევ საჭიროა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដែនកំណត់បានផ្លាស់ប្តូរក្នុងពេលនេះ។ នេះជាបច្ចុប្បន្ន៖ បង្កើនវាម្តងទៀត ប្រសិនបើនៅតែត្រូវការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그사이 한도가 바뀌었습니다. 현재 한도는 다음과 같습니다. 아직 필요하면 다시 올리세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຂີດຈຳກັດປ່ຽນແປງໃນລະຫວ່າງນີ້. ນີ້ແມ່ນດຽວນີ້: ເພີ່ມມັນອີກຖ້າຍັງຈຳເປັນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitas tuo metu pasikeitė. Štai koks jis dabar: padidinkite dar kartą, jei vis dar reikia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits pa to laiku mainījās. Šeit ir pašreizējais: palielini to vēlreiz, ja tas joprojām vajadzīgs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимитот се промени во меѓувреме. Еве го сега: зголеми го повторно ако сè уште е потребно."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ хооронд хязгаар өөрчлөгдсөн. Одоогийнх энд байна: хэрэгтэй хэвээр бол дахин нэмэгдүүлнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसबीच सीमा परिवर्तन भयो। अहिलेको यहाँ छ: अझै चाहिन्छ भने फेरि बढाउनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De limiet is intussen gewijzigd. Zo staat hij nu: verhoog hem opnieuw als dat nog nodig is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W międzyczasie limit się zmienił. Oto jego obecna wartość: podnieś go ponownie, jeśli nadal jest to potrzebne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite mudou entretanto. Aqui está agora: aumente-o novamente se ainda for preciso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite mudou nesse meio-tempo. Aqui está ele agora: aumente-o novamente se ainda for preciso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita s-a schimbat între timp. Iat-o acum: măriți-o din nou dacă mai e nevoie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit sa medzitým zmenil. Tu je teraz: zvýšte ho znova, ak je to stále potrebné."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omejitev se je medtem spremenila. Tukaj je zdaj: znova jo zvišajte, če je še potrebno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kufiri ndryshoi ndërkohë. Ja si është tani: rriteni sërish nëse ende nevojitet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograničenje se u međuvremenu promenilo. Evo kakvo je sada: podignite ga ponovo ako je još potrebno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขีดจำกัดเปลี่ยนไปในระหว่างนั้น นี่คือสถานะปัจจุบัน: เพิ่มอีกครั้งหากยังจำเป็น"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Çäk şol aralykda üýtgedi. Ine ol häzir: ýene gerek bolsa, täzeden ýokary galdyryň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit bu arada değişti. Şu an böyle: hâlâ gerekiyorsa tekrar yükseltin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس دوران حد بدل گئی۔ اب یہ ہے: اگر اب بھی ضرورت ہو تو دوبارہ بڑھائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hạn mức đã thay đổi trong lúc đó. Đây là hiện trạng: hãy nâng lại nếu vẫn cần."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "期間上限已有變動。這是目前的狀況：若仍需要，請再次提高。"
          }
        }
