    "needs_you.refused.role": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورك في هذا الحساب لا يردّ على طلبات الاستدعاء المعلّقة. يردّ عليها من يوافق فيه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabdakı rolunuz saxlanılan çağırışlara cavab vermir. Orada təsdiq edən biri cavab verir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ролята ви в този акаунт не отговаря на задържани заявки. Отговаря този, който одобрява в него."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্টে আপনার ভূমিকা ধরে রাখা কলের উত্তর দেয় না। যিনি এতে অনুমোদন করেন তিনি দেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu rol en aquest compte no respon les crides retingudes. Ho fa qui hi aprova."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše role v tomto účtu na zadržená volání neodpovídá. Odpovídá ten, kdo v něm schvaluje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rolle in diesem Konto beantwortet keine zurückgehaltenen Aufrufe. Jemand, der darin genehmigt, schon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your role on this account doesn't answer held calls. Someone who approves on it does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rol en esta cuenta no responde a llamadas retenidas. Lo hace quien aprueba en ella."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu roll sellel kontol ei vasta kinni peetud päringutele. Seda teeb keegi, kes sellel kinnitab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rôle sur ce compte ne répond pas aux appels retenus. Une personne qui y approuve le fait."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התפקיד שלך בחשבון הזה לא משיב על קריאות מוחזקות. מי שמאשר בו משיב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खाते में आपकी भूमिका रोकी गई कॉल का उत्तर नहीं देती। इस पर मंज़ूर करने वाला कोई देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša uloga na ovom računu ne odgovara na zadržane pozive. Odgovara netko tko na njemu odobrava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerepköröd ebben a fiókban nem válaszol visszatartott hívásokra. Az válaszol, aki itt jóváhagy."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հաշվում ձեր դերը չի պատասխանում պահված զանգերին։ Պատասխանում է նա, ով դրա վրա հաստատում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peran Anda di akun ini tidak menjawab panggilan yang ditahan. Yang menyetujui di akun ini yang menjawabnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ruolo in questo account non risponde alle chiamate trattenute. Lo fa chi approva nell'account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントでのあなたの役割では、保留中の呼び出しに回答できません。承認権限のある人が回答します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ანგარიშზე თქვენი როლი დაკავებულ ზარებს არ პასუხობს. პასუხობს ის, ვინც მასზე ამტკიცებს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តួនាទីរបស់អ្នកលើគណនីនេះមិនឆ្លើយការហៅដែលផ្អាកទុកទេ។ អ្នកដែលអនុម័តលើវាឆ្លើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에서 내 역할로는 보류된 호출에 답변하지 않습니다. 이 계정의 승인자가 답변합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບົດບາດຂອງທ່ານໃນບັນຊີນີ້ບໍ່ຕອບການໂທທີ່ພັກໄວ້. ຜູ້ທີ່ອະນຸມັດໃນບັນຊີຕອບ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų vaidmuo šioje paskyroje neatsako į sulaikytas užklausas. Atsako tas, kas joje tvirtina."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tava loma šajā kontā neatbild uz aizturētiem izsaukumiem. To dara tas, kurš tajā apstiprina."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твојата улога на оваа сметка не одговара на задржани барања. Одговара некој што одобрува на неа."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ бүртгэл дэх таны үүрэг түр барьсан дуудлагад хариулдаггүй. Түүн дээр зөвшөөрдөг хүн хариулна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यस खातामा तपाईंको भूमिकाले रोकिएका कलको जवाफ दिँदैन। यसमा स्वीकृत गर्ने कसैले दिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je rol in dit account beantwoordt geen vastgehouden aanroepen. Iemand die erin goedkeurt wel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja rola na tym koncie nie odpowiada na oczekujące wywołania. Robi to osoba zatwierdzająca na tym koncie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua função nesta conta não responde a chamadas retidas. Quem aprova nela responde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua função nesta conta não responde a chamadas retidas. Quem aprova nela responde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolul dvs. în acest cont nu răspunde la apelurile reținute. Răspunde cine aprobă în el."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša rola v tomto účte na pozdržané volania neodpovedá. Odpovedá ten, kto v ňom schvaľuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša vloga v tem računu ne odgovarja na zadržane klice. Odgovarja tisti, ki v njem odobrava."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Roli juaj në këtë llogari nuk u përgjigjet thirrjeve të mbajtura. Një miratues në të po."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša uloga na ovom nalogu ne odgovara na zadržane pozive. Odgovara netko ko na njemu odobrava."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บทบาทของคุณในบัญชีนี้ตอบการเรียกที่ถูกพักไว้ไม่ได้ ผู้ที่อนุมัติได้ในบัญชีนี้จึงตอบ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hasapdaky roluňyz saklanan çagyryşlara jogap bermeýär. Onda tassyklaýan biri jogap berýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesaptaki rolünüz tutulan çağrıları yanıtlamaz. Hesapta onaylayan biri yanıtlar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اکاؤنٹ پر آپ کا کردار روکی گئی کالوں کا جواب نہیں دیتا۔ اس پر منظور کرنے والا کوئی فرد دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai trò của bạn trên tài khoản này không trả lời các lệnh gọi bị giữ. Người phê duyệt trên đó sẽ trả lời."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您在此帳號中的角色無法回覆已保留的呼叫。請由可核准的人回覆。"
          }
        }
      }
    },
    "needs_you.refused.self_review": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت من طلب هذا، لذا يوافق عليه شخص آخر في الحساب. ما زال بإمكانك رفضه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu siz istədiniz, ona görə hesabdakı başqa biri təsdiq edir. Siz yenə də rədd edə bilərsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вие поискахте това, затова друг в акаунта го одобрява. Все пак можете да го откажете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এটি চেয়েছিলেন, তাই অ্যাকাউন্টের অন্য কেউ এটি অনুমোদন করেন। আপনি তবু এটি প্রত্যাখ্যান করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho has demanat tu, així que algú altre del compte ho aprova. Encara ho pots rebutjar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádali jste o to vy, takže to schválí někdo jiný v účtu. Odmítnout to ale můžete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast darum gebeten, daher genehmigt es jemand anderes im Konto. Ablehnen kannst du es trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You asked for this, so someone else on the account approves it. You can still refuse it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú lo pediste, así que lo aprueba otra persona de la cuenta. Aún puedes rechazarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sina palusid seda, seega kinnitab selle keegi teine kontol. Keelduda võid ikkagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous l'avez demandé : quelqu'un d'autre sur le compte l'approuve donc. Vous pouvez toujours le refuser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה ביקשת את זה, ולכן מישהו אחר בחשבון מאשר. אפשר עדיין לדחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपने माँगा था, इसलिए खाते का कोई और इसे मंज़ूर करता है। आप इसे फिर भी अस्वीकार कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ste to tražili pa to odobrava netko drugi na računu. I dalje to možete odbiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt te kérted, ezért a fiókban valaki más hagyja jóvá. Elutasítani továbbra is tudod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դուք խնդրել եք սա, ուստի հաշվում մեկ ուրիշն է հաստատում։ Դուք դեռ կարող եք մերժել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda yang memintanya, jadi orang lain di akun yang menyetujuinya. Anda tetap dapat menolaknya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hai chiesto tu, quindi la approva qualcun altro nell'account. Puoi comunque rifiutarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはあなたが依頼したものなので、アカウントの別の人が承認します。拒否することはできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენ ითხოვეთ ეს, ამიტომ ანგარიშზე სხვა ამტკიცებს. უარის თქმა მაინც შეგიძლიათ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកបានសុំរឿងនេះ ដូច្នេះអ្នកផ្សេងលើគណនីអនុម័តវា។ អ្នកនៅតែអាចបដិសេធវាបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 요청한 것이므로 계정의 다른 사람이 승인합니다. 거절은 할 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທ່ານເປັນຜູ້ຂໍສິ່ງນີ້ ສະນັ້ນຄົນອື່ນໃນບັນຊີອະນຸມັດມັນ. ທ່ານຍັງປະຕິເສດມັນໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "To prašėte jūs, todėl tvirtina kitas paskyros narys. Atmesti vis tiek galite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu to lūdzi, tāpēc to apstiprina kāds cits šajā kontā. Tu joprojām vari to atteikt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти го побара ова, па друг на сметката го одобрува. Сепак можеш да го одбиеш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та үүнийг хүссэн тул бүртгэлийн өөр хүн зөвшөөрнө. Та одоо ч татгалзаж болно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले यो माग्नुभएको हो, त्यसैले खाताका अर्को कसैले यसलाई स्वीकृत गर्छन्। तपाईंले अझै अस्वीकार गर्न सक्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt hier zelf om gevraagd, dus iemand anders in het account keurt het goed. Je kunt het nog wel weigeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prośba pochodzi od Ciebie, więc zatwierdza to ktoś inny na koncie. Nadal możesz to odrzucić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi você que pediu isto, por isso é outra pessoa da conta que o aprova. Pode ainda assim recusá-lo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi você que pediu isto, por isso é outra pessoa da conta que o aprova. Pode ainda assim recusá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ați cerut asta, așa că altcineva din cont o aprobă. Totuși o puteți refuza."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadali ste o to vy, takže to schváli niekto iný v účte. Odmietnuť to však môžete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ste zahtevali vi, zato odobri nekdo drug v računu. Zavrnete pa to še vedno lahko."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ju e kërkuat këtë, ndaj e miraton dikush tjetër në llogari. Mund ta refuzoni prapë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ste to tražili pa to odobrava netko drugi na nalogu. I dalje to možete odbiti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเป็นผู้ขอรายการนี้ ผู้อื่นในบัญชีจึงอนุมัติ คุณยังปฏิเสธได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Muny siz soradyňyz, şonuň üçin hasapdaky başga biri tassyklaýar. Siz ony henizem ret edip bilersiňiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu siz istediniz, bu yüzden hesaptaki başka biri onaylar. Yine de reddedebilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آپ نے مانگا تھا، اس لیے اکاؤنٹ پر کوئی اور اسے منظور کرتا ہے۔ آپ اسے پھر بھی مسترد کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính bạn yêu cầu việc này nên người khác trên tài khoản sẽ phê duyệt. Bạn vẫn có thể từ chối."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是您提出的請求，因此由帳號中的其他人核准。您仍然可以拒絕。"
