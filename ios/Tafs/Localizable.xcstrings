            "state": "translated",
            "value": "Demander à Coach d'envoyer ceci par e-mail à un développeur"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבקש מ-Coach לשלוח את אלה בדוא״ל למפתח"
          }
        },
        "hi": {
          "stringUnit": {
