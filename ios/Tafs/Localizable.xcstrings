    "watch.paused_still_answers": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف مؤقتًا: جدوله متوقف. ما زال يردّ على ما ترسله."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasilədədir: cədvəli söndürülüb. O, hələ də göndərdiklərinizə cavab verir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На пауза: графикът му е изключен. Все пак отговаря на това, което изпращате."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিরতিতে আছে: এর সূচি বন্ধ। আপনি যা পাঠান তার উত্তর এটি এখনও দেয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa: la seva programació està desactivada. Encara respon el que li envies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastaveno: jeho plán je vypnutý. Na to, co pošlete, pořád odpovídá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert: Sein Zeitplan ist aus. Was du sendest, beantwortet er trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused: its schedule is off. It still answers what you send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa: su programación está detenida. Aun así responde a lo que envías."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausil: selle ajakava on väljas. See vastab ikka sellele, mida saadad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause : son planning est arrêté. Il répond quand même à ce que vous envoyez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושהה: התזמון שלו כבוי. הוא עדיין עונה למה שאתה שולח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थमा हुआ: इसका निर्धारित समय बंद है। यह अब भी आपके भेजे का उत्तर देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzirano: njegov je raspored isključen. I dalje odgovara na ono što pošaljete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szüneteltetve: az ütemezése ki van kapcsolva. Arra, amit küldesz, továbbra is válaszol."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դադարեցված է․ նրա ժամանակացույցը անջատված է։ Այն դեռ պատասխանում է նրան, ինչ ուղարկում եք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda: jadwalnya mati. Ia tetap menjawab apa yang Anda kirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa: la sua pianificazione è ferma. Risponde comunque a ciò che invii."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中：スケジュールはオフです。送ったメッセージには引き続き答えます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაპაუზებულია: მისი განრიგი გამორთულია. ის მაინც პასუხობს, რასაც გაუგზავნით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានផ្អាក៖ កាលវិភាគរបស់វាបិទ។ វានៅតែឆ្លើយអ្វីដែលអ្នកផ្ញើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 중지됨: 일정이 꺼져 있습니다. 보내는 메시지에는 계속 답합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຢຸດຊົ່ວຄາວ: ຕາຕະລາງຂອງມັນປິດ. ມັນຍັງຕອບສິ່ງທີ່ທ່ານສົ່ງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristabdyta: tvarkaraštis išjungtas. Jis vis tiek atsako į tai, ką siunčiate."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iepauzēts: tā grafiks ir izslēgts. Tas joprojām atbild uz to, ko tu sūti."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Паузиран: неговиот распоред е исклучен. Сè уште одговара на она што ќе му испратиш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түр зогссон: хуваарь нь унтраастай. Таны илгээснийг одоо ч хариулна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पज गरिएको: यसको तालिका बन्द छ। तपाईंले पठाएकालाई यसले अझै जवाफ दिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd: de planning staat stil. Het antwoordt nog steeds op wat je stuurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane: harmonogram jest wyłączony. Taf nadal odpowiada na to, co wysyłasz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa: o agendamento está parado. Ainda assim responde ao que envia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa: o agendamento está parado. Ainda assim responde ao que envia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întrerupt: programul său este dezactivat. Totuși răspunde la ce îi trimiteți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastavené: jeho plán je vypnutý. Na to, čo pošlete, stále odpovedá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začasno ustavljeno: njegov urnik je izklopljen. Še vedno odgovarja na to, kar pošljete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pezulluar: orari i tij është joaktiv. Ende u përgjigjet atyre që dërgoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzirano: njegov je raspored isključen. I dalje odgovara na ono šta pošaljete."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดชั่วคราว: กำหนดการของมันปิดอยู่ มันยังตอบสิ่งที่คุณส่ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bes edildi: onuň tertibi öçük. Ol henizem iberýän zadyňyza jogap berýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatıldı: zamanlaması kapalı. Gönderdiklerinize yine yanıt verir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رکا ہوا: اس کا شیڈول بند ہے۔ آپ جو بھیجیں اس کا جواب پھر بھی دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạm dừng: lịch của nó đã tắt. Nó vẫn trả lời những gì bạn gửi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停：它的排程已關閉。它仍會回覆您傳送的內容。"
          }
        }
      }
    },
    "watch.phone_could_not_reach_cloud": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على هاتفك الوصول إلى tafs cloud. حاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz tafs cloud ilə əlaqə qura bilmədi. Yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонът ви не успя да се свърже с tafs cloud. Опитайте отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফোন tafs cloud-এ পৌঁছাতে পারেনি। আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu telèfon no ha pogut connectar amb tafs cloud. Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon se nemohl spojit s tafs cloud. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Handy hat tafs cloud nicht erreicht. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone couldn't reach tafs cloud. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono no pudo conectar con tafs cloud. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon ei saanud tafs cloudiga ühendust. Proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléphone n'a pas pu joindre tafs cloud. Réessayez."
          }
        },
        "he": {
          "stringUnit": {
