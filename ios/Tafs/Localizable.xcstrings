    "settings.no_taf_alerts_phones_when": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ينبّه أي taf الهواتف عندما يردّ."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Heç bir taf cavab verəndə telefonlara bildiriş göndərmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Никой taf не известява телефоните, когато отговаря."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো taf উত্তর দিলে ফোনে অ্যালার্ট দেয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap taf avisa els telèfons quan respon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný taf neupozorňuje telefony, když odpoví."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein taf benachrichtigt die Telefone, wenn er antwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No taf alerts the phones when it answers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún taf avisa a los teléfonos cuando responde."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ükski taf ei teavita vastamisel telefone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun taf ne prévient les téléphones quand il répond."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף taf לא מתריע לטלפונים כשהוא משיב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई taf उत्तर देने पर फ़ोन को अलर्ट नहीं करता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedan taf ne obavještava telefone kad odgovori."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen taf sem küld riasztást a telefonokra, amikor válaszol."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոչ մի taf չի ծանուցում հեռախոսներին, երբ պատասխանում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada taf yang memperingatkan ponsel saat menjawab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun taf avvisa i telefoni quando risponde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答時にスマートフォンに通知するtafはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არც ერთი taf არ ატყობინებს ტელეფონებს პასუხისას."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មាន taf ណាជូនដំណឹងទូរសព្ទ នៅពេលវាឆ្លើយទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf가 답할 때 휴대폰에 알리지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ມີ taf ແຈ້ງເຕືອນໂທລະສັບເມື່ອມັນຕອບ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Joks taf nepraneša telefonams, kai atsako."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neviens taf nepaziņo tālruņiem, kad atbild."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниеден taf не ги известува телефоните кога одговара."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хариулахад утаснуудад мэдэгдэх taf алга."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कुनै taf ले जवाफ दिँदा फोनहरूमा सूचना दिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkel taf stuurt de telefoons een melding als het antwoordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden taf nie powiadamia telefonów, gdy odpowiada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum taf alerta os telefones quando responde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum taf alerta os telefones quando responde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun taf nu alertează telefoanele când răspunde."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadny taf neupozorňuje telefóny, keď odpovie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noben taf ne opozori telefonov, ko odgovori."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Asnjë taf nuk njofton telefonat kur përgjigjet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedan taf ne obaveštava telefone kad odgovori."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มี taf ใดแจ้งเตือนโทรศัพท์เมื่อมันตอบ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiç bir taf jogap berende telefonlary duýdurmaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir taf yanıt verdiğinde telefonları uyarmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی taf جواب دیتے وقت فونز کو الرٹ نہیں کرتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không taf nào báo cho điện thoại khi nó trả lời."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有任何 taf 在回覆時通知手機。"
          }
        }
      }
