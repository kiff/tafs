          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bude môcť schvaľovať akcie vašich tafov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bo lahko odobraval dejanja vaših tafov."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ do të mund të miratojë veprimet e tafs-eve tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređaj %1$@ moći će odobravati radnje vaših tafova."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จะสามารถอนุมัติการกระทำของ taf ของคุณ"
