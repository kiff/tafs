    "taf.remove.connections_left|zero": {
      "extractionState": "manual",
      "localizations": {
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piekļuvi %1$@ no tā lietotnēm nevarēja noņemt: noņem to sadaļā “Pievienot lietotnes”."
          }
        }
      }
    },
    "taf.remove.done": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cədvəli, söhbətləri, iş hesabatları, yaddaşı və açarı silindi, %1$@ adı isə azaddır. KIFF qəbzləri qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Графикът, чатовете, отчетите за изпълнения, паметта и ключът му са изтрити, а името %1$@ е свободно. Разписките на KIFF остават."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho plán, chaty, zprávy z běhů, paměť a klíč jsou smazané a název %1$@ je volný. Potvrzení od KIFF zůstávají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Zeitplan, seine Chats, Laufberichte, sein Gedächtnis und sein Schlüssel sind gelöscht, und der Name %1$@ ist frei. KIFFs Belege bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its schedule, chats, run reports, memory and key are deleted, and the name %1$@ is free. KIFF's receipts stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminaron su programación, sus chats, sus informes de ejecución, su memoria y su clave, y el nombre %1$@ queda libre. Los recibos de KIFF se conservan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle ajakava, vestlused, käivituste aruanded, mälu ja võti on kustutatud ning nimi %1$@ on vaba. KIFFi kviitungid jäävad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son planning, ses chats, ses rapports d'exécution, sa mémoire et sa clé sont supprimés, et le nom %1$@ redevient libre. Les reçus de KIFF restent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brišu se njegov raspored, razgovori, izvješća izvođenja, memorija i ključ, a naziv %1$@ postaje slobodan. KIFF-ove potvrde ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ütemezése, csevegései, futási jelentései, memóriája és kulcsa törölve, és a(z) %1$@ név szabad. A KIFF nyugtái megmaradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրա ժամանակացույցը, զրույցները, գործարկումների հաշվետվությունները, հիշողությունը և բանալին ջնջվեցին, և %1$@ անունը ազատ է։ KIFF-ի անդորրագրերը մնում են։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal, obrolan, laporan eksekusi, memori, dan kuncinya dihapus, dan nama %1$@ bebas. Tanda terima KIFF tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua pianificazione, le chat, i resoconti delle esecuzioni, la memoria e la chiave vengono eliminati, e il nome %1$@ torna libero. Le ricevute di KIFF restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュール、チャット、実行レポート、メモ、キーが削除され、%1$@という名前は使えるようになりました。KIFFの領収書は残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისი განრიგი, ჩატები, გაშვების ანგარიშები, მეხსიერება და გასაღები წაიშალა, და სახელი %1$@ თავისუფალია. KIFF-ის ქვითრები რჩება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정, 채팅, 실행 보고서, 기억, 키가 삭제되었고 %1$@ 이름을 다시 쓸 수 있습니다. KIFF의 영수증은 남습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo tvarkaraštis, pokalbiai, paleidimų ataskaitos, atmintis ir raktas ištrinti, o pavadinimas %1$@ tapo laisvas. KIFF kvitai lieka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā grafiks, sarunas, palaišanu ziņojumi, atmiņa un atslēga ir dzēsti, un nosaukums %1$@ ir brīvs. KIFF kvītis paliek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De planning, chats, runrapporten, het geheugen en de sleutel zijn verwijderd, en de naam %1$@ is vrij. De ontvangstbewijzen van KIFF blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego harmonogram, czaty, raporty z uruchomień, pamięć i klucz zostały usunięte, a nazwa %1$@ jest wolna. Potwierdzenia KIFF zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu agendamento, chats, relatórios de execução, memória e chave foram eliminados, e o nome %1$@ está livre. Os recibos do KIFF mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu agendamento, chats, relatórios de execução, memória e chave foram excluídos, e o nome %1$@ está livre. Os recibos do KIFF são mantidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Programul, conversațiile, rapoartele de rulare, memoria și cheia sa sunt șterse, iar numele %1$@ este liber. Chitanțele KIFF rămân."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho plán, chaty, správy z behov, pamäť a kľúč sú odstránené a názov %1$@ je voľný. Potvrdenia od KIFF zostávajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegov urnik, klepeti, poročila o zagonih, spomin in ključ so izbrisani, ime %1$@ pa je prosto. Potrdila KIFF ostanejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Orari, bisedat, raportet e ekzekutimeve, kujtesa dhe çelësi i tij janë fshirë, dhe emri %1$@ është i lirë. Dëftesat e KIFF mbeten."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Brišu se njegov raspored, razgovori, izveštaja izvršavanja, memorija i ključ, a naziv %1$@ postaje slobodan. KIFF-ove potvrde ostaju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดการ แชต รายงานการทำงาน ความจำ และกุญแจของมันถูกลบ และชื่อ %1$@ ว่างแล้ว ใบเสร็จของ KIFF ยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlaması, sohbetleri, çalıştırma raporları, belleği ve anahtarı silinir ve %1$@ adı serbest kalır. KIFF'in makbuzları kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch, các cuộc trò chuyện, báo cáo lượt chạy, bộ nhớ và khóa của nó đã bị xóa, và tên %1$@ được giải phóng. Biên nhận của KIFF vẫn còn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的排程、對話、執行報告、記憶和金鑰已刪除，名稱 %1$@ 已釋出。KIFF 的收據會保留。"
          }
        }
      }
    },
    "taf.remove.finishes_on_refresh": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinmə başlayıbsa, tafs növbəti yenilənəndə onu tamamlayır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако премахването е започнало, tafs го завършва при следващото опресняване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud odstranění začalo, tafs ho dokončí při příštím obnovení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls das Entfernen begonnen hat, schließt tafs es bei der nächsten Aktualisierung ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the removal began, tafs finishes it the next time it refreshes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la eliminación empezó, tafs la termina la próxima vez que se actualice."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui eemaldamine algas, lõpetab tafs selle järgmisel värskendusel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la suppression a commencé, tafs la termine à la prochaine actualisation."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako je uklanjanje počelo, tafs ga dovršava sljedeći put kad se osvježi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha az eltávolítás elkezdődött, a tafs a következő frissítéskor befejezi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե հեռացումը սկսվել է, tafs-ը կավարտի այն հաջորդ թարմացման ժամանակ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika penghapusan sudah dimulai, tafs menyelesaikannya saat menyegarkan berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la rimozione è iniziata, tafs la completa al prossimo aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除が始まっていれば、次の更新時にtafsが完了させます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ ამოღება დაიწყო, tafs დაასრულებს შემდეგ განახლებაზე."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제가 시작되었다면 다음에 새로 고칠 때 tafs가 마무리합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei šalinimas prasidėjo, tafs jį užbaigs kitą kartą atsinaujindama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja noņemšana sākās, tafs to pabeigs nākamajā atsvaidzināšanas reizē."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het verwijderen is begonnen, rondt tafs het af bij de volgende vernieuwing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli usuwanie się zaczęło, tafs dokończy je przy następnym odświeżeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a remoção começou, o tafs conclui-a na próxima atualização."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a remoção começou, o tafs conclui-a na próxima atualização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă eliminarea a început, tafs o termină la următoarea reîmprospătare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak odstránenie začalo, tafs ho dokončí pri ďalšom obnovení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če se je odstranitev začela, jo tafs dokonča ob naslednji osvežitvi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse heqja filloi, tafs e përfundon herën tjetër që rifreskohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako je uklanjanje počelo, tafs ga dovršava sledeći put kad se osvježi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากการนำออกเริ่มไปแล้ว tafs จะทำให้เสร็จในการรีเฟรชครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırma başladıysa tafs bir sonraki yenilenişinde bitirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu việc gỡ đã bắt đầu, tafs sẽ hoàn tất ở lần làm mới tiếp theo."
          }
        },
        "zh-Hant": {
