    "approval.approving_asks_none_set_up": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب الموافقة %1$@، ولم يُعدّ أي منهما على هذا الجهاز (%2$@) بعد. أعدّه من %3$@ ثم عُد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təsdiq tələb edir: %1$@, bu cihazda (%2$@) isə hələ heç biri qurulmayıb. Burada qurun: %3$@, sonra qayıdın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрението изисква %1$@, а на този %2$@ още няма настроено. Настройте го в %3$@ и се върнете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমোদনের জন্য %1$@ লাগে, আর এই %2$@-এ এখনও কোনোটিই সেট আপ করা নেই। %3$@-এ সেট আপ করুন, তারপর ফিরে আসুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar demana %1$@, i en aquest dispositiu (%2$@) encara no n'hi ha cap de configurat. Configura-ho a %3$@ i torna."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Schválení vyžaduje %1$@ a na tomto zařízení (%2$@) zatím nic z toho není nastavené. Nastavte to v %3$@ a vraťte se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Genehmigen wird %1$@ abgefragt, und auf diesem %2$@ ist noch nichts davon eingerichtet. Richte es unter %3$@ ein und komm dann zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving asks for %1$@, and none is set up on this %2$@ yet. Set it up in %3$@, then come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para aprobar se pide %1$@, y aún no hay nada configurado en este %2$@. Configúralo en %3$@ y vuelve."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinnitamiseks on vaja: %1$@, kuid selles seadmes (%2$@) pole seda veel seadistatud. Seadista see menüüs %3$@ ja tule siis tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver demande %1$@, et rien n'est encore configuré sur %4$@. Configurez-le dans %3$@, puis revenez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האישור מבקש %1$@, ובהתקן הזה (%2$@) עדיין לא הוגדר אף אחד מהם. יש להגדיר ב%3$@ ולחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मंज़ूर करने के लिए %1$@ चाहिए, और इस %2$@ पर अभी कोई सेट नहीं है। उसे %3$@ में सेट करें, फिर लौट आएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobravanje traži sljedeće: %1$@, a na ovom uređaju (%2$@) ništa od toga još nije postavljeno. Postavite to u: %3$@, pa se vratite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jóváhagyáshoz ez kell: %1$@, de ezen az eszközön (%2$@) még egyik sincs beállítva. Állítsd be itt: %3$@, majd gyere vissza."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաստատումը պահանջում է՝ %1$@, իսկ այս սարքում (%2$@) դեռ ոչինչ կարգավորված չէ։ Կարգավորեք՝ %3$@, ապա վերադարձեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persetujuan memerlukan %1$@, dan belum ada yang disiapkan di %2$@ ini. Siapkan di %3$@, lalu kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per approvare serve %1$@, e nessuno è ancora configurato su questo %2$@. Configuralo in %3$@, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認には%1$@が必要ですが、この%2$@にはまだ設定されていません。%3$@で設定してから戻ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დამტკიცება მოითხოვს: %1$@, ხოლო ამ მოწყობილობაზე (%2$@) ჯერ არც ერთი არ არის დაყენებული. დააყენეთ აქ: %3$@, შემდეგ დაბრუნდით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការអនុម័តត្រូវការ %1$@ ហើយគ្មានអ្វីត្រូវបានរៀបចំនៅលើ %2$@ នេះនៅឡើយទេ។ រៀបចំវាក្នុង %3$@ រួចត្រឡប់មកវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하려면 %1$@이(가) 필요한데, 이 %2$@에는 아직 설정되어 있지 않습니다. %3$@에서 설정한 뒤 돌아오세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການອະນຸມັດຕ້ອງການ %1$@ ແລະ %2$@ ນີ້ຍັງບໍ່ໄດ້ຕັ້ງ. ຕັ້ງມັນໃນ %3$@ ແລ້ວກັບມາ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvirtinant reikia šio būdo: %1$@, bet šiame įrenginyje (%2$@) jis dar nenustatytas. Nustatykite jį (%3$@), tada grįžkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apstiprināšanai vajag %1$@, bet šajā ierīcē (%2$@) vēl nav iestatīts neviens no tiem. Iestati to: %3$@, tad atgriezies."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрувањето бара %1$@, а ниту едно не е поставено на овој %2$@. Постави го во %3$@, па врати се."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөвшөөрөхөд %1$@ шаардлагатай бөгөөд энэ %2$@ дээр одоохондоо аль нь ч тохируулагдаагүй байна. %3$@ хэсэгт тохируулаад буцаж ирнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वीकृत गर्न %1$@ चाहिन्छ, र यो %2$@ मा अहिलेसम्म कुनै सेट गरिएको छैन। %3$@ मा सेट गरेर फर्कनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goedkeuren vraagt om %1$@, en dat is nog niet ingesteld op deze %2$@. Stel het in via %3$@ en kom dan terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdzenie wymaga %1$@, a na tym urządzeniu (%2$@) nic takiego nie jest jeszcze skonfigurowane. Skonfiguruj to w %3$@, a potem wróć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar pede %1$@, e nenhum está configurado neste %2$@. Configure-o em %3$@ e depois volte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar pede %1$@, e nenhum está configurado neste %2$@. Configure-o em %3$@ e depois volte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobarea cere %1$@ și niciuna nu este configurată încă pe acest dispozitiv (%2$@). Configurați-o în %3$@, apoi reveniți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Schválenie vyžaduje %1$@ a na tomto zariadení (%2$@) zatiaľ nič z toho nie je nastavené. Nastavte to v %3$@ a vráťte sa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobritev zahteva %1$@, na tej napravi (%2$@) pa še nič od tega ni nastavljeno. Nastavite to v %3$@ in se vrnite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Miratimi kërkon: %1$@, dhe në këtë pajisje (%2$@) ende nuk është konfiguruar asnjëra. Konfigurojeni te: %3$@, pastaj ktheheni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobravanje traži: %1$@, a na ovom uređaju (%2$@) još nije podešeno ništa od toga. Podesite u: %3$@, pa se vratite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอนุมัติต้องใช้ %1$@ และ%2$@เครื่องนี้ยังไม่ได้ตั้งค่าไว้ ตั้งค่าใน %3$@ แล้วกลับมา"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tassyklamak %1$@ soraýar, we bu %2$@-de heniz hiç biri gurnalmandyr. Ony %3$@ bölüminde guruň, soňra gaýdyp geliň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamak için şu gerekir: %1$@. Bu %2$@ üzerinde henüz hiçbiri kurulu değil. Şuradan kurun: %3$@, sonra geri dönün."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منظور کرنے کے لیے %1$@ چاہیے، اور اس %2$@ پر ابھی کوئی سیٹ نہیں ہے۔ اسے %3$@ میں سیٹ کریں، پھر لوٹ آئیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phê duyệt cần %1$@, và chưa có cái nào được thiết lập trên %2$@ này. Hãy thiết lập trong %3$@, rồi quay lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准需要%1$@，而這部%2$@尚未設定。請在%3$@中設定，然後再回來。"
          }
        }
      }
    },
