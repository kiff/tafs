    "needs_you.refused.signed_in_approver": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يردّ على طلبات الاستدعاء المعلّقة معتمِد مسجّل الدخول، لا مفتاح."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saxlanılan çağırışlara açar yox, daxil olmuş təsdiqləyici cavab verir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На задържани заявки отговаря влязъл одобряващ, не ключ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধরে রাখা কলের উত্তর দেন সাইন ইন করা একজন অনুমোদনকারী, কোনো কী নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les crides retingudes les respon un aprovador amb la sessió iniciada, no una clau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zadržená volání odpovídá přihlášený schvalovatel, ne klíč."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgehaltene Aufrufe beantwortet ein angemeldeter Genehmiger, nicht ein Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held calls are answered by an approver signed in, not by a key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas retenidas las responde un aprobador con la sesión iniciada, no una clave."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinni peetud päringutele vastab sisse logitud kinnitaja, mitte võti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels retenus sont traités par un approbateur connecté, pas par une clé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "על קריאות מוחזקות משיב מאשר מחובר, לא מפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोकी गई कॉल का उत्तर साइन इन मंज़ूरीकर्ता देता है, कुंजी नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zadržane pozive odgovara prijavljeni odobravatelj, a ne ključ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A visszatartott hívásokra bejelentkezett jóváhagyó válaszol, nem kulcs."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահված զանգերին պատասխանում է մուտք գործած հաստատողը, ոչ թե բանալին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panggilan yang ditahan dijawab oleh penyetuju yang sedang masuk, bukan oleh kunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle chiamate trattenute risponde un approvatore che ha effettuato l'accesso, non una chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中の呼び出しには、キーではなく、サインインした承認者が回答します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაკავებულ ზარებს პასუხობს შესული დამმტკიცებელი და არა გასაღები."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការហៅដែលផ្អាកទុកត្រូវបានឆ្លើយដោយអ្នកអនុម័តដែលបានចូល មិនមែនដោយកូនសោទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류된 호출은 키가 아니라 로그인한 승인자가 답변합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການໂທທີ່ພັກໄວ້ຖືກຕອບໂດຍຜູ້ອະນຸມັດທີ່ເຂົ້າສູ່ລະບົບ, ບໍ່ແມ່ນໂດຍກຸນແຈ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Į sulaikytas užklausas atsako prisijungęs tvirtintojas, o ne raktas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz aizturētiem izsaukumiem atbild pierakstījies apstiprinātājs, nevis atslēga."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "На задржани барања одговара најавен одобрувач, не клуч."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түр барьсан дуудлагад түлхүүр биш, нэвтэрсэн зөвшөөрөгч хариулна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रोकिएका कलको जवाफ कुञ्जीले होइन, साइन इन भएका स्वीकृतिकर्ताले दिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastgehouden aanroepen worden beantwoord door een ingelogde goedkeurder, niet door een sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na oczekujące wywołania odpowiada zalogowany zatwierdzający, a nie klucz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas retidas são respondidas por um aprovador com sessão iniciada, não por uma chave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas retidas são respondidas por um aprovador conectado à conta, não por uma chave."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La apelurile reținute răspunde un aprobator conectat, nu o cheie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na pozdržané volania odpovedá prihlásený schvaľovateľ, nie kľúč."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zadržane klice odgovarja prijavljen odobritelj, ne ključ."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Thirrjeve të mbajtura u përgjigjet një miratues i hyrë, jo një çelës."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zadržane pozive odgovara prijavljeni odobravatelj, a ne ključ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเรียกที่ถูกพักไว้ตอบโดยผู้อนุมัติที่เข้าสู่ระบบ ไม่ใช่ด้วยกุญแจ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklanan çagyryşlara girilen tassyklaýjy jogap berýär, açar däl."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutulan çağrıları bir anahtar değil, oturum açmış bir onaylayıcı yanıtlar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روکی گئی کالوں کا جواب سائن اِن شدہ منظور کنندہ دیتا ہے، کلید نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lệnh gọi bị giữ do một người phê duyệt đã đăng nhập trả lời, không phải một khóa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留的呼叫由已登入的核准者回覆，而不是由金鑰回覆。"
          }
        }
      }
    },
