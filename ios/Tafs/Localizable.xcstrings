    "door.checks_sender_server_signed_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق من أن خادم المرسل وقّع الرسالة"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "O, göndərənin serverinin mesajı imzaladığını yoxlayır"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверява дали сървърът на подателя е подписал съобщението"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি যাচাই করে প্রেরকের সার্ভার বার্তায় সই করেছে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprova que el servidor del remitent ha signat el missatge"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověří, že zprávu podepsal server odesílatele"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie prüft, ob der Server des Absenders die Nachricht signiert hat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It checks the sender's server signed the message"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que el servidor del remitente firmó el mensaje"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See kontrollib, et saatja server allkirjastas sõnumi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vérifie que le serveur de l'expéditeur a signé le message"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא בודק ששרת השולח חתם על ההודעה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह जाँचता है कि भेजने वाले के सर्वर ने संदेश पर हस्ताक्षर किए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerava je li poslužitelj pošiljatelja potpisao poruku"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrzi, hogy a küldő szervere aláírta-e az üzenetet"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ստուգում է, որ ուղարկողի սերվերը ստորագրել է հաղորդագրությունը"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memeriksa bahwa server pengirim menandatangani pesan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla che il server del mittente abbia firmato il messaggio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信者のサーバーがメッセージに署名したかを確認します"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამოწმებს, რომ გამგზავნის სერვერმა შეტყობინებას ხელი მოაწერა"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាពិនិត្យថាម៉ាស៊ីនមេរបស់អ្នកផ្ញើបានចុះហត្ថលេខាលើសារ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발신자의 서버가 메시지에 서명했는지 확인합니다"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມັນກວດວ່າເຊີບເວີຂອງຜູ້ສົ່ງລົງລາຍເຊັນຂໍ້ຄວາມ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikrina, ar žinutę pasirašė siuntėjo serveris"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tās pārbauda, vai sūtītāja serveris parakstīja ziņu"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверува дали серверот на испраќачот ја потпишал пораката"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Илгээгчийн сервер мессежид гарын үсэг зурсныг шалгана"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पठाउनेको सर्भरले सन्देशमा हस्ताक्षर गरेको जाँच्छ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het controleert of de server van de afzender het bericht heeft ondertekend"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdza, czy serwer nadawcy podpisał wiadomość"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se o servidor do remetente assinou a mensagem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se o servidor do remetente assinou a mensagem"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică dacă serverul expeditorului a semnat mesajul"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Overí, že správu podpísal server odosielateľa"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preveri, ali je sporočilo podpisal strežnik pošiljatelja"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollon që serveri i dërguesit e ka nënshkruar mesazhin"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Proverava je li server pošiljatelja potpisao poruku"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจว่าเซิร์ฟเวอร์ของผู้ส่งลงนามข้อความ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ol iberijiniň serweriniň habara gol çekendigini barlaýar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göndericinin sunucusunun mesajı imzaladığını denetler"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ جانچتا ہے کہ بھیجنے والے کے سرور نے پیغام پر دستخط کیے ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó kiểm tra máy chủ của người gửi đã ký tin nhắn"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會檢查寄件者的伺服器是否簽署了這封訊息"
          }
        }
      }
    },
