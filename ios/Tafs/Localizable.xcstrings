        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ goşalandy. Ol %2$@ görkezdi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ eşleştirildi. %2$@ gösterdi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ جڑ گیا۔ اس نے %2$@ دکھایا تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã được ghép đôi. Nó đã hiển thị %2$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@已配對。它顯示了 %2$@。"
          }
        }
      }
    },
    "settings.devices.pair_expired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الرمز على كمبيوترك. اعرض رمزًا جديدًا وامسحه مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompüterinizdəki kodun vaxtı bitdi. Yenisini göstərin və yenidən skan edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодът на компютъра ви изтече. Покажете нов и го сканирайте отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কম্পিউটারের কোডের মেয়াদ শেষ হয়েছে। নতুন একটি দেখান এবং আবার স্ক্যান করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El codi del teu ordinador ha caducat. Mostra'n un de nou i torna a escanejar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnost kódu na vašem počítači vypršela. Zobrazte nový a naskenujte ho znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code auf deinem Computer ist abgelaufen. Lass einen neuen anzeigen und scanne ihn erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code on your computer expired. Show a new one and scan it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de tu ordenador ha caducado. Muestra uno nuevo y escanéalo otra vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu arvuti kood aegus. Näita uut ja skanni see uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code sur votre ordinateur a expiré. Affichez-en un nouveau et scannez-le à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף הקוד במחשב שלך פג. יש להציג חדש ולסרוק שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कंप्यूटर पर कोड की अवधि खत्म हो गई। नया दिखाएँ और फिर स्कैन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôd na vašem računalu je istekao. Prikažite novi i skenirajte ga ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A számítógépeden lévő kód lejárt. Jeleníts meg egy újat, és olvasd be újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր համակարգչի կոդի ժամկետը լրացավ։ Ցույց տվեք նորը և նորից սկանավորեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode di komputer Anda kedaluwarsa. Tampilkan yang baru lalu pindai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice sul tuo computer è scaduto. Mostrane uno nuovo e scansionalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータのコードの有効期限が切れました。新しいコードを表示して、もう一度スキャンしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენს კომპიუტერზე კოდის ვადა ამოიწურა. აჩვენეთ ახალი და ხელახლა დაასკანერეთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លេខកូដនៅលើកុំព្យូទ័ររបស់អ្នកបានផុតកំណត់។ បង្ហាញលេខកូដថ្មី រួចស្កែនម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터의 코드가 만료되었습니다. 새 코드를 표시하고 다시 스캔하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລະຫັດໃນຄອມພິວເຕີຂອງທ່ານໝົດອາຍຸ. ສະແດງອັນໃໝ່ ແລ້ວສະແກນອີກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodas jūsų kompiuteryje nebegalioja. Parodykite naują ir nuskaitykite jį dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda derīgums tavā datorā beidzās. Parādi jaunu un skenē to vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодот на твојот компјутер истече. Прикажи нов и скенирај го повторно."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны компьютер дээрх кодын хугацаа дууссан. Шинийг харуулаад дахин скан хийнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको कम्प्युटरको कोडको समय सकियो। नयाँ देखाएर फेरि स्क्यान गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code op je computer is verlopen. Toon een nieuwe en scan die opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod na Twoim komputerze wygasł. Wyświetl nowy i zeskanuj go ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O código no seu computador expirou. Mostre um novo e leia-o outra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código no seu computador expirou. Mostre um novo e leia-o outra vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
