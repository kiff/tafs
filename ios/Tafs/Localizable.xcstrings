    "connect.through_provider": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل %1$@ الدخول عبر مزوّد الاتصال الخاص به. لتسجيل الدخول مرة أخرى، أزل الوصول ثم اربطه من جديد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ qoşulma provayderi vasitəsilə daxil olur. Yenidən daxil olmaq üçün girişi silin və yenidən qoşun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ влиза чрез своя доставчик на връзки. За да влезете отново, премахнете достъпа и го свържете отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ তার সংযোগ প্রদানকারীর মাধ্যমে সাইন ইন করে। আবার সাইন ইন করতে প্রবেশাধিকার সরান এবং আবার সংযুক্ত করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ inicia la sessió mitjançant el seu proveïdor de connexions. Per tornar a iniciar-la, treu l'accés i torna a connectar-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se přihlašuje přes svého poskytovatele připojení. Chcete-li se přihlásit znovu, odeberte přístup a připojte ho znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ meldet sich über seinen Verbindungsanbieter an. Um dich erneut anzumelden, entferne den Zugriff und verbinde es neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signs in through its connection provider. To sign in again, remove access and connect it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ inicia sesión a través de su proveedor de conexión. Para volver a iniciar sesión, quita el acceso y vuelve a conectarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ logib sisse oma ühendusteenuse kaudu. Uuesti sisselogimiseks eemalda juurdepääs ja ühenda see uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se connecte via son fournisseur de connexion. Pour vous reconnecter, retirez l'accès puis connectez-le à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ נכנס דרך ספק החיבורים שלו. כדי להיכנס שוב, יש להסיר את הגישה ולחבר אותו מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ अपने कनेक्शन प्रदाता के ज़रिए साइन इन करता है। फिर साइन इन करने के लिए पहुँच हटाएँ और उसे फिर जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija %1$@ prijavljuje se preko svog pružatelja veze. Da se prijavite ponovno, uklonite pristup i povežite je ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a kapcsolatszolgáltatóján keresztül jelentkezik be. Az újbóli bejelentkezéshez szüntesd meg a hozzáférést, és csatlakoztasd újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը մուտք է գործում իր կապի մատակարարի միջոցով։ Նորից մուտք գործելու համար հեռացրեք հասանելիությունը և նորից միացրեք այն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ masuk melalui penyedia koneksinya. Untuk masuk lagi, hapus akses lalu hubungkan kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ accede tramite il suo fornitore di connessione. Per accedere di nuovo, rimuovi l'accesso e collegalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は接続プロバイダーを通じてサインインします。もう一度サインインするには、アクセスを削除して再接続してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ შედის თავისი კავშირის პროვაიდერის მეშვეობით. ხელახლა შესასვლელად ამოიღეთ წვდომა და დააკავშირეთ ხელახლა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ចូលតាមរយៈអ្នកផ្តល់ការតភ្ជាប់របស់វា។ ដើម្បីចូលម្តងទៀត សូមដកការចូលប្រើ ហើយភ្ជាប់វាម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 연결 제공업체를 통해 로그인합니다. 다시 로그인하려면 접근 권한을 삭제하고 다시 연결하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ເຂົ້າສູ່ລະບົບຜ່ານຜູ້ໃຫ້ບໍລິການການເຊື່ອມຕໍ່ຂອງມັນ. ເພື່ອເຂົ້າສູ່ລະບົບອີກ ໃຫ້ເອົາສິດເຂົ້າເຖິງອອກ ແລ້ວເຊື່ອມຕໍ່ມັນອີກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ prisijungia per savo ryšių teikėją. Norėdami prisijungti dar kartą, pašalinkite prieigą ir prijunkite iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pierakstās caur savu savienojumu nodrošinātāju. Lai pierakstītos vēlreiz, noņem piekļuvi un pievieno to vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ се најавува преку својот давател на врски. За да се најавиш повторно, отстрани го пристапот и поврзи го одново."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ холболтын үйлчилгээ үзүүлэгчээрээ дамжуулан нэвтэрдэг. Дахин нэвтрэхийн тулд хандах эрхийг хасаад дахин холбоно уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ आफ्नो जडान प्रदायकमार्फत साइन इन गर्छ। फेरि साइन इन गर्न पहुँच हटाएर फेरि जडान गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ meldt zich aan via zijn verbindingsprovider. Om je opnieuw aan te melden, trek je de toegang in en verbind je het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ loguje się przez swojego dostawcę połączeń. Aby zalogować się ponownie, usuń dostęp i połącz go jeszcze raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ inicia sessão através do seu fornecedor de ligação. Para iniciar sessão de novo, remova o acesso e ligue-o novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ faz login através do seu fornecedor de conexão. Para fazer login de novo, remova o acesso e conecte-o novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se conectează prin furnizorul său de conexiune. Pentru a vă conecta din nou, eliminați accesul și conectați-l din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sa prihlasuje cez svojho poskytovateľa pripojenia. Ak sa chcete prihlásiť znova, odoberte prístup a pripojte ho znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se prijavi prek svojega ponudnika povezave. Za ponovno prijavo odstranite dostop in ga znova povežite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hyn përmes ofruesit të vet të lidhjes. Për të hyrë sërish, hiqni qasjen dhe lidheni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija %1$@ prijavljuje se preko svog pružatelja veze. Da se prijavite ponovo, uklonite pristup i povežite je ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ เข้าสู่ระบบผ่านผู้ให้บริการการเชื่อมต่อของมัน หากต้องการเข้าสู่ระบบอีกครั้ง ให้ถอนสิทธิ์เข้าถึงแล้วเชื่อมต่อใหม่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ öz birikme üpjün edijisi arkaly girýär. Täzeden girmek üçin elýeterligi aýyryň we ony täzeden birikdiriň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, bağlantı sağlayıcısı üzerinden oturum açar. Tekrar oturum açmak için erişimi kaldırıp yeniden bağlayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ اپنے کنکشن فراہم کنندہ کے ذریعے سائن اِن کرتا ہے۔ دوبارہ سائن اِن کرنے کے لیے رسائی ہٹائیں اور اسے دوبارہ جوڑیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đăng nhập qua nhà cung cấp kết nối của nó. Để đăng nhập lại, hãy gỡ quyền truy cập và kết nối lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 透過它的連線供應商登入。若要重新登入，請移除存取權限後再重新連接。"
          }
        }
      }
    },
