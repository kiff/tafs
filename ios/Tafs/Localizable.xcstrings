    "sample.reply.more_room": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أستطيع منح نفسي مساحة أكبر: وحدك تستطيع، بتغيير الـ Card الخاصة بي. وكل ما يتجاوزها ينتظرك في «بانتظارك»."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Özümə daha çox yer verə bilmərəm: bunu yalnız siz, Card-ımı dəyişərək edə bilərsiniz. Ondan artıq hər şey «Sizi gözləyir» bölməsində sizi gözləyir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не мога сам да си дам повече лимит: само вие можете, като промените моята Card. Всичко над нея ви чака в „Чака ви“."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি নিজেকে আরও জায়গা দিতে পারি না: শুধু আপনিই পারেন, আমার Card বদলে। এর বাইরের সবকিছু «আপনার অপেক্ষায়» আপনার জন্য অপেক্ষা করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No em puc donar més marge: només tu pots, canviant el meu Card. Tot el que el superi t'espera a «Et necessita»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Víc prostoru si dát nemůžu: to můžete jen vy, změnou mé Card. Cokoli nad ni na vás čeká v Čeká na vás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann mir selbst keinen weiteren Spielraum geben: Nur du kannst das, indem du meine Card änderst. Alles darüber wartet unter „Braucht dich“ auf dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't give myself more room: only you can, by changing my Card. Anything over it waits for you in Needs you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedo darme más margen: solo tú puedes, cambiando mi Card. Todo lo que lo supere te espera en Te necesita."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma ei saa endale rohkem ruumi anda: seda saad teha ainult sina, muutes minu Cardi. Kõik, mis seda ületab, ootab sind vaates Vajab sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne peux pas me donner plus de marge : vous seul le pouvez, en modifiant ma Card. Tout ce qui la dépasse vous attend dans Vous attend."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני לא יכול לתת לעצמי עוד מקום: רק אתה יכול, בשינוי ה-Card שלי. כל מה שמעבר לו ממתין לך ב«זקוק לך»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं खुद को और जगह नहीं दे सकता: केवल आप, मेरा Card बदलकर, दे सकते हैं। उससे ऊपर का सब कुछ आपका इंतज़ार में आपकी प्रतीक्षा करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne mogu si sam dati više prostora: samo vi možete, promjenom mog Carda. Sve iznad toga čeka vas u Čeka vas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem adhatok magamnak nagyobb keretet: csak te, a Cardom módosításával. Ami túllépi, az a Rád vár részben vár rád."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ես չեմ կարող ինձ ավելի շատ տարածք տալ․ միայն դուք կարող եք՝ փոխելով իմ Card-ը։ Դրանից ավելին սպասում է ձեզ «Սպասում է ձեզ» բաժնում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya tidak dapat memberi diri saya ruang lebih: hanya Anda yang bisa, dengan mengubah Card saya. Apa pun di atasnya menunggu Anda di Menunggu Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non posso darmi più margine: puoi farlo solo tu, modificando la mia Card. Tutto ciò che la supera ti aspetta in Ti aspetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で範囲を広げることはできません。広げられるのは、Cardを変更するあなただけです。範囲を超えることは要確認で待ちます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თავს მეტ სივრცეს ვერ მივცემ: მხოლოდ თქვენ შეგიძლიათ, ჩემი Card-ის შეცვლით. მის გადამეტებულს თქვენ გელოდებათ განყოფილებაში „გელოდებათ“."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ខ្ញុំមិនអាចផ្តល់កន្លែងបន្ថែមឱ្យខ្លួនឯងបានទេ៖ មានតែអ្នកប៉ុណ្ណោះដែលអាច ដោយផ្លាស់ប្តូរ Card របស់ខ្ញុំ។ អ្វីៗដែលលើសពីវារង់ចាំអ្នកក្នុង «ត្រូវការអ្នក»។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저 스스로 범위를 넓힐 수는 없습니다. 직접 Card를 바꾸셔야만 넓힐 수 있습니다. 범위를 넘는 일은 확인 필요에서 기다립니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຂ້ອຍໃຫ້ພື້ນທີ່ເພີ່ມຕົວເອງບໍ່ໄດ້: ມີແຕ່ທ່ານ, ໂດຍການປ່ຽນ Card ຂອງຂ້ອຍ. ສິ່ງໃດທີ່ເກີນມັນລໍຖ້າທ່ານໃນ ຕ້ອງການທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Negaliu sau suteikti daugiau rezervo: tai galite tik jūs, pakeisdami mano Card. Viskas, kas viršija jos ribas, laukia jūsų skiltyje „Laukia jūsų“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Es nevaru sev dot vairāk rezerves: to vari tikai tu, mainot manu Card. Viss, kas to pārsniedz, gaida tevi sadaļā “Gaida tevi”."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можам сам да си дадам повеќе простор: само ти можеш, со менување на мојот Card. Сè над него чека на тебе во Те чека."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Би өөртөө илүү зай өгч чадахгүй: зөвхөн та миний Card-ыг өөрчлөх замаар өгч чадна. Түүнээс хэтэрсэн бүхэн Таныг хүлээж байна хэсэгт таныг хүлээнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "म आफैँलाई थप ठाउँ दिन सक्दिनँ: केवल तपाईंले मात्र, मेरो Card परिवर्तन गरेर। त्यसभन्दा बढी जे पनि तपाईंको प्रतीक्षामा पर्खन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kan mezelf geen extra ruimte geven: alleen jij kunt dat, door mijn Card te wijzigen. Alles daarboven wacht op je in Wacht op jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogę dać sobie więcej zapasu: możesz to zrobić tylko Ty, zmieniając moją Card. Wszystko ponad nią czeka na Ciebie w sekcji Czeka na Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não posso dar-me mais margem: só você pode, alterando o meu Card. Tudo o que o exceda aguarda por si em Precisa de si."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não posso me dar mais margem: só você pode, alterando o meu Card. Tudo o que passar dele aguarda por você em Precisa de você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu îmi pot da singur mai mult spațiu: doar dvs. puteți, schimbându-mi Cardul. Orice îl depășește vă așteaptă în Vă așteaptă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Viac priestoru si dať nemôžem: to môžete len vy, zmenou mojej Card. Čokoľvek nad ňu na vás čaká v Čaká na vás."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Več prostora si ne morem dati: to lahko storite samo vi, s spremembo moje Card. Vse, kar jo presega, čaka na vas v Čaka na vas."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuk mund t'i jap vetes më shumë hapësirë: vetëm ju mundeni, duke ndryshuar Card-in tim. Çdo gjë përtej tij pret ju te Ju pret."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne mogu si sam dati više prostora: samo vi možete, promenom mog Carda. Sve iznad toga čeka vas u Čeka vas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันให้พื้นที่เพิ่มกับตัวเองไม่ได้ มีเพียงคุณที่ทำได้ โดยเปลี่ยน Card ของฉัน สิ่งที่เกินกว่านั้นจะรอคุณในรอคุณอยู่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Özüme has köp ýer berip bilemok: diňe siz, Card-ymy üýtgedip, berip bilersiňiz. Ondan artygy Size garaşýar bölüminde size garaşýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendime daha fazla pay veremem: yalnızca siz verebilirsiniz, Card'ımı değiştirerek. Bunun ötesindeki her şey Sizi bekliyor'da sizi bekler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں خود کو مزید گنجائش نہیں دے سکتا: صرف آپ دے سکتے ہیں، میرا Card بدل کر۔ اس سے زیادہ کچھ بھی آپ کی ضرورت میں آپ کا انتظار کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi không thể tự cho mình thêm phạm vi: chỉ bạn mới làm được, bằng cách đổi Card của tôi. Mọi việc vượt quá nó sẽ chờ bạn trong Đang chờ bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我無法替自己爭取更多空間：只有您能做到，方法是變更我的 Card。任何超出範圍的事項，都會在「等您處理」中等您。"
          }
        }
      }
    },
