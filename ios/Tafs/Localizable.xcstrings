    "sign_in.agree": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Anmeldung stimmst du KIFFs %1$@, die tafs abdecken, und seiner %2$@ zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By signing in, you agree to KIFF's %1$@, which cover tafs, and its %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al iniciar sesión, aceptas las %1$@ de KIFF, que cubren tafs, y su %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En vous connectant, vous acceptez les %1$@ de KIFF, qui couvrent tafs, et sa %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedendo, accetti le %1$@ di KIFF, che valgono anche per tafs, e la sua %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door in te loggen ga je akkoord met de %1$@ van KIFF, die ook voor tafs gelden, en het %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logując się, akceptujesz %1$@ KIFF, które obejmują tafs. Obowiązuje też %2$@ KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao iniciar sessão, aceita os %1$@ do KIFF, que abrangem o tafs, e a sua %2$@."
          }
        }
      }
    },
    "sign_in.check_code": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
