    "settings.sign_in_code.saved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ. أرسلنا إليك بريدًا إلكترونيًا عن التغيير."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yadda saxlanıldı. Dəyişiklik barədə sizə e-poçt göndərdik."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазено. Изпратихме ви имейл за промяната."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত হয়েছে। পরিবর্তনটি নিয়ে আমরা আপনাকে ইমেইল করেছি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desat. T'hem enviat un correu sobre el canvi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo. O změně jsme vám poslali e-mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Wir haben dir wegen der Änderung eine E-Mail geschickt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. We emailed you about the change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. Te escribimos por correo sobre el cambio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestatud. Saatsime sulle muudatuse kohta e-kirja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré. Nous vous avons écrit au sujet du changement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר. שלחנו לך אימייל על השינוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया। हमने आपको इस बदलाव के बारे में ईमेल किया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljeno. Poslali smo vam e-poštu o promjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentve. A változásról e-mailt küldtünk neked."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահպանվեց։ Փոփոխության մասին էլ. նամակ ենք ուղարկել ձեզ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersimpan. Kami mengirim email kepada Anda tentang perubahan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato. Ti abbiamo scritto un'email sulla modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました。変更についてメールをお送りしました。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენახულია. ცვლილების შესახებ ელფოსტაზე გაგიგზავნეთ წერილი."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានរក្សាទុក។ យើងបានផ្ញើអ៊ីមែលអំពីការផ្លាស់ប្តូរនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장했습니다. 변경 내용을 이메일로 알려 드렸습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບັນທຶກແລ້ວ. ພວກເຮົາສົ່ງອີເມວກ່ຽວກັບການປ່ຽນແປງຫາທ່ານແລ້ວ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išsaugota. Išsiuntėme jums el. laišką apie pakeitimą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saglabāts. Mēs tev nosūtījām e-pastu par izmaiņu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачувано. Ти испративме е-порака за промената."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадгалагдлаа. Өөрчлөлтийн талаар имэйл илгээсэн."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित गरियो। परिवर्तनबारे हामीले तपाईंलाई इमेल पठायौं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen. We hebben je over de wijziging gemaild."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano. Wysłaliśmy Ci e-mail o zmianie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. Enviámos-lhe um email sobre a alteração."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo. Enviamos um e-mail para você sobre a alteração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvat. V-am trimis un e-mail despre schimbare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené. O zmene sme vám poslali e-mail."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranjeno. O spremembi smo vam poslali e-pošto."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "U ruajt. Ju dërguam një email për ndryshimin."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sačuvano. Poslali smo vam e-poštu o promeni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกแล้ว เราส่งอีเมลถึงคุณเกี่ยวกับการเปลี่ยนแปลงนี้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklandy. Biz size üýtgetme barada email iberdik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedildi. Değişiklik hakkında size e-posta gönderdik."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ ہو گیا۔ ہم نے آپ کو اس تبدیلی کے بارے میں ای میل کیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu. Chúng tôi đã gửi email cho bạn về thay đổi này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存。我們已就這項變更寄信給您。"
          }
        }
      }
    },
