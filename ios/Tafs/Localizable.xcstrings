    "door.knock.proof_failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie gibt an, von %1$@ zu sein, hat aber die Absenderprüfung nicht bestanden und wird daher wie die eines Fremden behandelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It says it's from %1$@, but it didn't pass the sender check, so it's treated as a stranger's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice ser de %1$@, pero no pasó la comprobación del remitente, así que se trata como el de un desconocido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See väidab, et on saatjalt %1$@, kuid ei läbinud saatja kontrolli, seega koheldakse seda võõra omana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prétend venir de %1$@, mais n'a pas passé la vérification de l'expéditeur : il est traité comme celui d'un inconnu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice di essere da %1$@, ma non ha superato il controllo del mittente, quindi è trattato come quello di uno sconosciuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@からと名乗っていますが、送信者の確認に通らなかったため、知らない人からのものとして扱います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 왔다고 하지만 발신자 확인을 통과하지 못해 모르는 사람의 메시지로 처리합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nurodyta, kad ji nuo %1$@, bet ji nepraėjo siuntėjo patikros, todėl laikoma nepažįstamojo žinute."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajā teikts, ka tā ir no %1$@, bet tā neizturēja sūtītāja pārbaudi, tāpēc tiek uzskatīta par sveša cilvēka ziņu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zegt van %1$@ te komen, maar het is niet door de afzendercontrole gekomen, dus het wordt behandeld als dat van een onbekende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaje, że jest od %1$@, ale nie przeszła weryfikacji nadawcy, więc jest traktowana jak wiadomość od nieznajomego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz ser de %1$@, mas não passou a verificação do remetente, por isso é tratado como de um desconhecido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz ser de %1$@, mas não passou a verificação do remetente, por isso é tratado como de um desconhecido."
          }
        }
      }
    },
    "door.knock.proof_none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Tür kann nicht nachweisen, wer das geschrieben hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This door can't prove who wrote it."
          }
        },
        "es": {
