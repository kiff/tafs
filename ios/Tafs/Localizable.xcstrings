        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuova approvazione non ha funzionato. Riprova, o accedi di nuovo in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再承認できませんでした。もう一度試すか、設定からもう一度サインインしてください。"
