          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení to odmítlo před odesláním. Nic se neodeslalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung hat es vor dem Senden abgelehnt. Es wurde nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection refused it before sending. Nothing was sent."
          }
        },
        "es": {
