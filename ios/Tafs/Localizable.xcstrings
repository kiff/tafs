    "connect.cancel_sign_in.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch ist nichts verbunden. Verbinde %1$@ erneut über Coach oder „Apps verbinden“, wenn du so weit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is connected yet. Connect %1$@ again from Coach or Connect apps when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada conectado. Vuelve a conectar %1$@ desde Coach o Conectar apps cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi pole veel ühendatud. Ühenda %1$@ uuesti Coachis või vaates Ühenda rakendused, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est encore connecté. Connectez à nouveau %1$@ depuis Coach ou Connecter des apps quand vous êtes prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora collegato nulla. Collega di nuovo %1$@ da Coach o da Collega app quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も接続されていません。準備ができたら、Coachまたはアプリを接続から、もう一度%1$@を接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 연결된 것은 없습니다. 준비되면 Coach나 앱 연결에서 %1$@을(를) 다시 연결하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas dar neprijungta. Kai būsite pasirengę, vėl prijunkite %1$@ per Coach arba skiltyje „Prijungti programėles“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēl nekas nav pievienots. Kad būsi gatavs, vēlreiz pievieno %1$@ no Coach vai sadaļā “Pievienot lietotnes”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog niets gekoppeld. Koppel %1$@ opnieuw vanuit Coach of Apps koppelen wanneer je zover bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest jeszcze połączone. Połącz %1$@ ponownie z Coacha lub z Połącz aplikacje, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada está ligado. Ligue %1$@ novamente a partir do Coach ou de Ligar apps quando estiver pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada está conectado. Conecte %1$@ novamente a partir do Coach ou de Conectar apps quando estiver pronto."
          }
        }
      }
    },
