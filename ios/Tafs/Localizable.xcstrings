    "push.channel.other_description": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapşırıq sorğuları və onların cavabları, səssiz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявки за задачи и отговорите им, без звук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádosti o úkoly a jejich odpovědi, bez zvuku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen nach Aufgaben und ihre Antworten, ohne Ton."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests for tasks and their answers, with no sound."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitudes de tareas y sus respuestas, sin sonido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülesannete päringud ja vastused neile, ilma helita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes de tâches et leurs réponses, sans son."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtjevi za zadatke i odgovori na njih, bez zvuka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Feladatkérések és a rájuk adott válaszok, hang nélkül."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առաջադրանքների հարցումներ և դրանց պատասխանները՝ առանց ձայնի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan tugas dan jawabannya, tanpa suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richieste di attività e le relative risposte, senza suono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクの依頼とその回答（音なし）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამოცანების მოთხოვნები და მათი პასუხები, ხმის გარეშე."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 요청과 그 답변, 소리 없음."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užduočių prašymai ir atsakymai į juos, be garso."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzdevumu pieprasījumi un atbildes uz tiem, bez skaņas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzoeken om taken en de antwoorden erop, zonder geluid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prośby o zadania i odpowiedzi na nie, bez dźwięku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedidos de tarefas e as respetivas respostas, sem som."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedidos de tarefas e as respetivas respostas, sem som."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitări de sarcini și răspunsurile lor, fără sunet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadosti o úlohy a ich odpovede, bez zvuku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahteve za opravila in njihovi odgovori, brez zvoka."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kërkesa për detyra dhe përgjigjet e tyre, pa zë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtevi za zadatke i odgovori na njih, bez zvuka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอให้ทำงานและคำตอบของคำขอ โดยไม่มีเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev istekleri ve yanıtları, sessiz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các yêu cầu giao việc và câu trả lời, không phát âm thanh."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務請求及其回覆，不發出聲音。"
          }
        }
      }
    },
    "push.channel.urgent_description": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Növbəti xülasənizi gözləyə bilməyən şeylər, səslə."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това, което не може да чака следващото резюме, със звук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co nepočká do dalšího přehledu, se zvukem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was nicht bis zu deinem nächsten Briefing warten kann, mit Ton."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can't wait for your next brief, with sound."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que no puede esperar a tu próximo resumen, con sonido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See, mis ei saa sinu järgmist kokkuvõtet oodata, koos heliga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui ne peut pas attendre votre prochain briefing, avec son."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ono što ne može čekati vaš sljedeći sažetak, sa zvukom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ami nem várhat a következő összefoglalóig, hanggal."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն, ինչ չի կարող սպասել ձեր հաջորդ ամփոփմանը՝ ձայնով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang tidak bisa menunggu ringkasan berikutnya, dengan suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che non può aspettare il tuo prossimo riepilogo, con suono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のブリーフィングまで待てないもの（音あり）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რაც თქვენს შემდეგ მიმოხილვას ვერ დაელოდება, ხმით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 브리핑까지 기다릴 수 없는 것, 소리 있음."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai, kas negali laukti kitos suvestinės, su garsu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas, kas nevar gaidīt līdz nākamajam kopsavilkumam, ar skaņu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat niet kan wachten op je volgende briefing, met geluid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co nie może czekać do Twojego następnego przeglądu, z dźwiękiem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que não pode esperar pelo seu próximo resumo, com som."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que não pode esperar pelo seu próximo resumo, com som."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nu poate aștepta următorul rezumat, cu sunet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo nepočká do ďalšieho prehľadu, so zvukom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kar ne more počakati do naslednjega pregleda, z zvokom."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajo që nuk pret përmbledhjen tuaj të radhës, me zë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ono šta ne može čekati vaš sledeći sažetak, sa zvukom."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่รอสรุปครั้งถัดไปของคุณไม่ได้ พร้อมเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki özetinizi bekleyemeyenler, sesli."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì không thể đợi bản tóm tắt tiếp theo, có âm thanh."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
