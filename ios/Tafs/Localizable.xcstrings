    "onboarding.home_lead": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-a nə etmək istədiyinizi öz sözlərinizlə deyin. O, taf-ı sizinlə birlikdə qurur və heç nə işləməzdən əvvəl Card-ını sizə göstərir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кажете на Coach какво искате да се свърши, със свои думи. Той настройва taf заедно с вас и ви показва неговата Card, преди нещо да се изпълни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řekněte Coachovi vlastními slovy, co chcete udělat. Nastaví s vámi taf a ukáže vám jeho Card dřív, než se cokoli spustí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag Coach in deinen eigenen Worten, was erledigt werden soll. Er richtet den taf mit dir ein und zeigt dir seine Card, bevor etwas läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell Coach what you'd like done, in your own words. It sets the taf up with you and shows you its Card before anything runs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a Coach con tus palabras qué quieres que se haga. Prepara el taf contigo y te enseña su Card antes de que nada se ejecute."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ütle Coachile oma sõnadega, mida soovid teha lasta. See seadistab tafi koos sinuga ja näitab sulle selle Cardi enne, kui midagi käivitub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites à Coach, avec vos mots, ce que vous voulez faire faire. Il met le taf en place avec vous et vous montre sa Card avant que rien ne tourne."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recite Coachu što želite da se napravi, svojim riječima. On s vama postavlja taf i prikazuje mu Card prije nego išta krene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mondd el a Coachnak a saját szavaiddal, mit szeretnél. Veled együtt beállítja a tafot, és megmutatja a Cardját, mielőtt bármi elindulna."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ասեք Coach-ին ձեր բառերով, թե ինչ եք ուզում, որ արվի։ Նա taf-ը կարգավորում է ձեզ հետ և ցույց է տալիս նրա Card-ը, նախքան որևէ բան գործարկելը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Katakan kepada Coach apa yang ingin Anda selesaikan, dengan kata-kata Anda sendiri. Coach menyiapkan taf bersama Anda dan menunjukkan Card-nya sebelum apa pun berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' a Coach con parole tue cosa vuoi che venga fatto. Prepara il taf con te e ti mostra la sua Card prima che parta qualsiasi cosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やってほしいことを、あなたの言葉でCoachに伝えてください。Coachが一緒にtafを設定し、何かを実行する前にCardを見せます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უთხარით Coach-ს თქვენი სიტყვებით, რისი გაკეთება გსურთ. ის თქვენთან ერთად დააყენებს taf-ს და გაჩვენებთ მის Card-ს, სანამ რამე გაეშვება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 일을 평소 말투로 Coach에게 말하세요. Coach가 함께 taf를 설정하고, 실행하기 전에 Card를 보여 줍니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Savo žodžiais pasakykite Coach, ką norite atlikti. Jis kartu su jumis nustato taf ir parodo jo Card, kol dar niekas nepaleista."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasaki Coach saviem vārdiem, ko vēlies paveikt. Tas kopā ar tevi iestata taf un parāda tev tā Card, pirms kaut kas tiek palaists."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertel Coach in je eigen woorden wat je gedaan wilt hebben. Die zet de taf met je op en laat je de Card zien voordat er iets draait."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz Coachowi własnymi słowami, co ma zostać zrobione. Skonfiguruje z Tobą tafa i pokaże Ci jego Card, zanim cokolwiek się uruchomi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga ao Coach, por palavras suas, o que quer que seja feito. Ele configura o taf consigo e mostra-lhe a Card antes de qualquer coisa correr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga ao Coach, com as suas palavras, o que quer que seja feito. Ele configura o taf com você e mostra o Card antes de qualquer coisa rodar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spuneți-i lui Coach ce ați vrea să se facă, cu propriile cuvinte. Configurează taful împreună cu dvs. și vă arată Cardul înainte să ruleze ceva."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povedzte Coachovi vlastnými slovami, čo chcete urobiť. Nastaví s vami taf a ukáže vám jeho Card skôr, než sa čokoľvek spustí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coachu s svojimi besedami povejte, kaj želite. Z vami bo nastavil taf in vam pokazal njegovo Card, preden se karkoli zažene."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tregojini Coach çfarë doni të bëhet, me fjalët tuaja. E konfiguron taf-in me ju dhe ju tregon Card-in e tij para se të ekzekutohet çdo gjë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Recite Coachu šta želite da se napravi, svojim rečima. On s vama podešava taf i prikazuje mu Card pre nego išta krene."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอก Coach ว่าคุณอยากให้ทำอะไรด้วยคำพูดของคุณเอง มันจะตั้งค่า taf ร่วมกับคุณและแสดง Card ของมันให้คุณดูก่อนที่จะรันอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach'a yapılmasını istediğiniz işi kendi sözlerinizle anlatın. Taf'ı sizinle kurar ve bir şey çalışmadan önce Card'ını gösterir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói với Coach điều bạn muốn làm, bằng lời của bạn. Nó cùng bạn thiết lập taf và cho bạn xem Card của taf trước khi có gì chạy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用您自己的話告訴 Coach 您想完成什麼。它會與您一起設定 taf，並在任何執行之前讓您檢視它的 Card。"
          }
        }
      }
    },
