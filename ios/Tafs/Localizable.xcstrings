    "settings.devices.pair_code_differs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hat %1$@ mit dem Code %2$@ gekoppelt, nicht mit %3$@ wie geprüft. Ist das nicht dein Computer, melde ihn hier ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF paired %1$@ with the code %2$@, not %3$@ as checked. If that isn't your computer, sign it out here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF vinculó %1$@ con el código %2$@, no con %3$@ como comprobaste. Si no es tu ordenador, cierra su sesión aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF sidus seadme %1$@ koodiga %2$@, mitte kontrollitud koodiga %3$@. Kui see pole sinu arvuti, logi see siin välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF a associé %1$@ avec le code %2$@, et non %3$@ comme vérifié. Si ce n'est pas votre ordinateur, déconnectez-le ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ha associato %1$@ con il codice %2$@, non %3$@ come verificato. Se non è il tuo computer, disconnettilo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFは、確認した%3$@ではなく、コード%2$@で%1$@をペアリングしました。それがあなたのコンピュータでない場合は、ここでサインアウトしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 확인된 %3$@ 코드가 아니라 %2$@ 코드로 %1$@을(를) 페어링했습니다. 내 컴퓨터가 아니라면 여기서 로그아웃하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF susiejo %1$@ su kodu %2$@, o ne %3$@, kaip buvo patikrinta. Jei tai ne jūsų kompiuteris, atjunkite jį čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF savienoja pārī %1$@ ar kodu %2$@, nevis %3$@, kā tika pārbaudīts. Ja tas nav tavs dators, izraksti to šeit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF heeft %1$@ gekoppeld met de code %2$@, niet %3$@ zoals gecontroleerd. Is dat niet jouw computer, log hem hier dan uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF sparował %1$@ z kodem %2$@, a nie %3$@, jak sprawdzono. Jeśli to nie Twój komputer, wyloguj go tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF associou %1$@ com o código %2$@, não %3$@ como verificou. Se não for o seu computador, termine a sessão dele aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF associou %1$@ com o código %2$@, não %3$@ como verificou. Se não for o seu computador, encerre a sessão dele aqui."
          }
        }
      }
    },
