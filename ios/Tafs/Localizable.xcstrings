    "sign_in.every_action_taf_takes_goes": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-ın gördüyü hər əməliyyat KIFF-dən keçir, o isə heç nə tətbiqə çatmamış Card-ı yoxlayır. Cavablarınız bu %1$@ üzərində imzalanır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко действие на taf минава през KIFF, който проверява неговата Card, преди нещо да стигне до приложение. Отговорите ви се подписват на този %1$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá akce tafu jde přes KIFF, který zkontroluje jeho Card dřív, než se cokoli dostane do aplikace. Vaše odpovědi se podepisují na tomto zařízení (%1$@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Aktion eines tafs läuft über KIFF, das seine Card prüft, bevor etwas eine App erreicht. Deine Antworten werden auf diesem %1$@ signiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every action a taf takes goes through KIFF, which checks its Card before anything reaches an app. Your answers are signed on this %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada acción de un taf pasa por KIFF, que comprueba su Card antes de que nada llegue a una app. Tus respuestas se firman en este %1$@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga tafi toiming läheb läbi KIFFi, mis kontrollib selle Cardi enne, kui midagi rakenduseni jõuab. Sinu vastused allkirjastatakse selles seadmes (%1$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque action d'un taf passe par KIFF, qui vérifie sa Card avant que quoi que ce soit n'atteigne une app. Vos réponses sont signées sur %2$@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka radnja koju taf poduzme ide preko KIFF-a, koji provjerava njegov Card prije nego išta stigne do aplikacije. Vaši se odgovori potpisuju na ovom uređaju (%1$@)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy taf minden művelete a KIFF-en megy át, amely ellenőrzi a Cardját, mielőtt bármi elérne egy alkalmazást. A válaszaidat ezen az eszközön (%1$@) írod alá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր գործողություն, որ taf-ը կատարում է, անցնում է KIFF-ով, որը ստուգում է նրա Card-ը, նախքան որևէ բան հավելված հասնելը։ Ձեր պատասխանները ստորագրվում են այս սարքում (%1$@)։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap tindakan yang dilakukan taf melewati KIFF, yang memeriksa Card-nya sebelum apa pun sampai ke aplikasi. Jawaban Anda ditandatangani di %1$@ ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni azione di un taf passa da KIFF, che controlla la sua Card prima che qualcosa raggiunga un'app. Le tue risposte vengono firmate su questo %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafのすべての操作はKIFFを通り、アプリに届く前にKIFFがCardを確認します。あなたの回答はこの%1$@で署名されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყოველი მოქმედება, რომელსაც taf აკეთებს, გადის KIFF-ში, რომელიც მის Card-ს ამოწმებს, სანამ რამე აპამდე მივა. თქვენი პასუხები ამ მოწყობილობაზე (%1$@) იწერება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf의 모든 행동은 KIFF를 거치며, KIFF는 앱에 무엇이든 전달하기 전에 Card를 확인합니다. 답변은 이 %1$@에서 서명됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas taf veiksmas eina per KIFF, kuri patikrina jo Card, kol niekas dar nepasiekė programėlės. Jūsų atsakymai pasirašomi šiame įrenginyje (%1$@)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katra taf darbība iet caur KIFF, kas pārbauda tā Card, pirms kaut kas sasniedz lietotni. Tavas atbildes tiek parakstītas šajā ierīcē (%1$@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke actie van een taf gaat via KIFF, dat zijn Card controleert voordat er iets een app bereikt. Je antwoorden worden ondertekend op deze %1$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda akcja tafa przechodzi przez KIFF, który sprawdza jego Card, zanim cokolwiek dotrze do aplikacji. Twoje odpowiedzi są podpisywane na tym urządzeniu (%1$@)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ação de um taf passa pelo KIFF, que verifica o seu Card antes de algo chegar a uma app. As suas respostas são assinadas neste %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ação de um taf passa pelo KIFF, que verifica o seu Card antes de algo chegar a um app. As suas respostas são assinadas neste %1$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare acțiune a unui taf trece prin KIFF, care îi verifică Cardul înainte ca ceva să ajungă la o aplicație. Răspunsurile dvs. se semnează pe acest dispozitiv (%1$@)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá akcia tafu ide cez KIFF, ktorý skontroluje jeho Card skôr, než sa čokoľvek dostane do aplikácie. Vaše odpovede sa podpisujú na tomto zariadení (%1$@)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsako dejanje tafa gre skozi KIFF, ki preveri njegovo Card, preden karkoli doseže aplikacijo. Vaši odgovori so podpisani na tej napravi (%1$@)."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo veprim që ndërmerr një taf kalon përmes KIFF, që kontrollon Card-in e tij para se të arrijë çdo gjë te një aplikacion. Përgjigjet tuaja nënshkruhen në këtë pajisje (%1$@)."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka radnja koju taf poduzme ide preko KIFF-a, koji proverava njegov Card pre nego išta stigne do aplikacije. Vaši se odgovori potpisuju na ovom uređaju (%1$@)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกการกระทำของ taf ผ่าน KIFF ซึ่งตรวจ Card ของมันก่อนที่สิ่งใดจะไปถึงแอป คำตอบของคุณลงนามบน%1$@เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir taf'ın yaptığı her eylem KIFF'ten geçer; KIFF, hiçbir şey bir uygulamaya ulaşmadan önce taf'ın Card'ını denetler. Yanıtlarınız bu %1$@ üzerinde imzalanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi hành động của taf đều đi qua KIFF, nơi kiểm tra Card của nó trước khi bất cứ điều gì đến một ứng dụng. Câu trả lời của bạn được ký trên %1$@ này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "taf 的每個動作都會經過 KIFF，在任何內容送達 App 之前，KIFF 會先檢查它的 Card。您的回覆在這部%1$@上簽署。"
          }
        }
      }
    },
