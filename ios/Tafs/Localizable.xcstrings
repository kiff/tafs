          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs មិនអាចភ្ជាប់ឯកសារនេះបានទេ៖ វាមិនមែនជាប្រភេទ ឬទំហំដែលវាទទួលទេ។ សូមជ្រើសរើសឯកសារផ្សេង។"
          }
        },
        "ko": {
          "stringUnit": {
