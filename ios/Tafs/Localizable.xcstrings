    "version.try_first": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlcə versiyanı öz Card-ı altında sınayın. İşləyən versiya işləməyə davam edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Първо пробвайте версия, под собствена Card. Активната версия продължава да работи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív vyzkoušejte verzi pod vlastní Card. Aktivní verze dál pracuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere eine Version zuerst aus, unter einer eigenen Card. Die Live-Version arbeitet weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a version first, under a Card of its own. The live version keeps working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba antes una versión, con una Card propia. La versión activa sigue trabajando."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi versiooni kõigepealt, selle oma Cardi all. Kasutusel olev versioon töötab edasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez d'abord une version, sous sa propre Card. La version en service continue de travailler."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije isprobajte verziju, pod njezinim vlastitim Cardom. Verzija u radu i dalje radi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb próbálj ki egy verziót, saját Carddal. Az élő verzió közben tovább dolgozik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախ փորձեք տարբերակ՝ իր սեփական Card-ի ներքո։ Ակտիվ տարբերակը շարունակում է աշխատել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba sebuah versi terlebih dahulu, di bawah Card miliknya sendiri. Versi yang aktif tetap bekerja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova prima una versione, con una Card tutta sua. La versione attiva continua a lavorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず専用のCardのもとでバージョンを試せます。適用中のバージョンは動き続けます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ სცადეთ ვერსია საკუთარი Card-ით. აქტიური ვერსია აგრძელებს მუშაობას."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 자체 Card로 버전을 시험해 보세요. 적용된 버전은 계속 작동합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmiausia išbandykite versiją su atskira Card. Aktyvi versija dirba toliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vispirms izmēģini versiju ar savu Card. Darbā esošā versija turpina strādāt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer eerst een versie uit, onder een eigen Card. De live versie blijft werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw wypróbuj wersję, w ramach jej własnej Card. Wersja działająca na żywo pracuje dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente primeiro uma versão, ao abrigo de um Card próprio. A versão em produção continua a trabalhar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente primeiro uma versão, ao abrigo de um Card próprio. A versão em produção continua trabalhando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încercați mai întâi o versiune, sub un Card propriu. Versiunea activă continuă să lucreze."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv vyskúšajte verziu pod vlastnou Card. Aktívna verzia ďalej pracuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej preizkusite različico pod njeno lastno Card. Aktivna različica še naprej dela."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Provoni më parë një version, nën një Card të vetin. Versioni aktiv vazhdon të punojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo isprobajte verziju, pod njenim vlastitim Cardom. Verzija u radu i dalje radi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองเวอร์ชันหนึ่งก่อน ภายใต้ Card ของมันเอง เวอร์ชันที่ใช้งานอยู่ยังทำงานต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir sürümü kendi Card'ı altında deneyin. Yayındaki sürüm çalışmaya devam eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thử một phiên bản trước, dưới một Card riêng. Phiên bản đang chạy vẫn tiếp tục hoạt động."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先試用一個版本，使用它自己的 Card。目前生效的版本會繼續運作。"
          }
        }
      }
    },
