    "needs_you.refused.role": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rolle in diesem Konto beantwortet keine zurückgehaltenen Aufrufe. Jemand, der darin genehmigt, schon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your role on this account doesn't answer held calls. Someone who approves on it does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rol en esta cuenta no responde a llamadas retenidas. Lo hace quien aprueba en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rôle sur ce compte ne répond pas aux appels retenus. Une personne qui y approuve le fait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ruolo in questo account non risponde alle chiamate trattenute. Lo fa chi approva nell'account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je rol in dit account beantwoordt geen vastgehouden aanroepen. Iemand die erin goedkeurt wel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja rola na tym koncie nie odpowiada na oczekujące wywołania. Robi to osoba zatwierdzająca na tym koncie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua função nesta conta não responde a chamadas retidas. Quem aprova nela responde."
          }
        }
      }
    },
    "needs_you.refused.self_review": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast darum gebeten, daher genehmigt es jemand anderes im Konto. Ablehnen kannst du es trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You asked for this, so someone else on the account approves it. You can still refuse it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú lo pediste, así que lo aprueba otra persona de la cuenta. Aún puedes rechazarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous l'avez demandé : quelqu'un d'autre sur le compte l'approuve donc. Vous pouvez toujours le refuser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hai chiesto tu, quindi la approva qualcun altro nell'account. Puoi comunque rifiutarla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt hier zelf om gevraagd, dus iemand anders in het account keurt het goed. Je kunt het nog wel weigeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prośba pochodzi od Ciebie, więc zatwierdza to ktoś inny na koncie. Nadal możesz to odrzucić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi você que pediu isto, por isso é outra pessoa da conta que o aprova. Pode ainda assim recusá-lo."
          }
        }
      }
    },
    "needs_you.refused.signed_in_approver": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgehaltene Aufrufe beantwortet ein angemeldeter Genehmiger, nicht ein Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held calls are answered by an approver signed in, not by a key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas retenidas las responde un aprobador con la sesión iniciada, no una clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels retenus sont traités par un approbateur connecté, pas par une clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle chiamate trattenute risponde un approvatore che ha effettuato l'accesso, non una chiave."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastgehouden aanroepen worden beantwoord door een ingelogde goedkeurder, niet door een sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na oczekujące wywołania odpowiada zalogowany zatwierdzający, a nie klucz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas retidas são respondidas por um aprovador com sessão iniciada, não por uma chave."
          }
        }
      }
    },
    "needs_you.request_not_read": {
      "extractionState": "manual",
      "localizations": {
