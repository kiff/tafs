    "record.lead": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما فعلته tafs لديك، وما رُفض لها، وما سألتك عنه. الأحدث أولًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-larınızın etdiyi, rədd edildiyi və ya sizdən soruşduğu hər şey. Ən yenisi birinci."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всичко, което вашите tafs направиха, което им беше отказано или за което ви попитаха. Най-новите първи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার taf যা করেছে, যা প্রত্যাখ্যাত হয়েছে, বা আপনাকে যা জিজ্ঞেস করেছে, সব। নতুনটি আগে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot el que els teus taf han fet, se'ls ha rebutjat o t'han preguntat. El més recent primer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechno, co vaše tafy udělaly, co jim bylo odmítnuto nebo na co se vás ptaly. Nejnovější nahoře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was deine tafs getan haben, was abgelehnt wurde und wonach sie dich gefragt haben. Neueste zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything your tafs did, were refused, or asked you. Newest first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que tus tafs hicieron, lo que se les rechazó o lo que te preguntaron. Lo más reciente primero."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik, mida sinu tafid tegid, millest neile keelduti või mida nad sinult küsisid. Uusimad eespool."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vos tafs ont fait, ce qui leur a été refusé ou ce qu'ils vous ont demandé. Les plus récents d'abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שה-taf שלך עשו, נדחו עליו, או שאלו אותך. החדש ראשון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह सब जो आपके taf ने किया, जो अस्वीकार हुआ, या जो उन्होंने आपसे पूछा। नया पहले।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve što su vaši tafovi učinili, što im je odbijeno ili što su pitali vas. Najnovije prvo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden, amit a tafjaid tettek, amit elutasítottak tőlük, vagy amit kérdeztek tőled. A legújabb elöl."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամեն ինչ, ինչ ձեր taf-երն արեցին, ինչ մերժվեց, կամ ինչ նրանք հարցրին ձեզ։ Նորերը՝ առաջինը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang dilakukan, ditolak, atau ditanyakan tafs Anda. Terbaru dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che i tuoi tafs hanno fatto, che è stato loro rifiutato o che ti hanno chiesto. Prima i più recenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsが行ったこと、拒否されたこと、あなたに確認したことのすべて。新しい順。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველაფერი, რაც თქვენმა taf-ებმა გააკეთეს, რაც უარყვეს, ან რაც გკითხეს. ახალი პირველი."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីៗទាំងអស់ដែល taf របស់អ្នកបានធ្វើ ត្រូវបានបដិសេធ ឬបានសួរអ្នក។ ថ្មីបំផុតមុន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs가 한 일, 거절된 일, 나에게 물은 일 전부. 최신순."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທຸກສິ່ງທີ່ taf ຂອງທ່ານເຮັດ, ຖືກປະຕິເສດ ຫຼື ຖາມທ່ານ. ໃໝ່ສຸດກ່ອນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Viskas, ką jūsų taf padarė, kas jiems atmesta ar ko jie jūsų klausė. Naujausi viršuje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viss, ko tavi taf izdarīja, kas tiem tika atteikts vai ko tie tev jautāja. Jaunākie vispirms."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè што направиле твоите tafови, што им е одбиено или што те прашале. Најновото прво."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны taf-уудын хийсэн, татгалзуулсан эсвэл танаас асуусан бүх зүйл. Хамгийн шинэ нь эхэнд."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंका taf ले गरेका, अस्वीकार गरिएका, वा तपाईंलाई सोधेका सबै कुरा। नयाँ पहिले।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je tafs deden, wat werd geweigerd of wat ze je vroegen. Nieuwste eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co Twoje tafs zrobiły, co im odrzucono lub o co Cię pytały. Od najnowszych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que os seus tafs fizeram, o que lhes foi recusado ou o que lhe perguntaram. Mais recente primeiro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que os seus tafs fizeram, o que lhes foi recusado ou o que lhe perguntaram. Mais recente primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce au făcut tafurile dvs., ce li s-a refuzat sau ce v-au întrebat. Cele mai noi primele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko, čo vaše tafy urobili, čo im bolo odmietnuté alebo na čo sa vás pýtali. Najnovšie navrchu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse, kar so vaši tafi naredili, kar jim je bilo zavrnjeno ali za kar so vas vprašali. Najnovejše na vrhu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjithçka që bënë tafs-et tuaj, që iu refuzua, ose që ju pyetën. Më të rejat së pari."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve šta su vaši tafovi učinili, šta im je odbijeno ili šta su pitali vas. Najnovije prvo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่ taf ของคุณทำ ถูกปฏิเสธ หรือถามคุณ ใหม่สุดก่อน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs-laryňyzyň eden, ret edilen ýa-da sizden soran hemme zady. Täzesi ilki."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs'larınızın yaptığı, reddedilen veya size sorduğu her şey. En yeni önce."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ سب جو آپ کے tafs نے کیا، جو مسترد ہوا، یا جو انہوں نے آپ سے پوچھا۔ نیا سب سے اوپر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi việc các taf của bạn đã làm, bị từ chối, hoặc đã hỏi bạn. Mới nhất trước."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 taf 做過、被拒絕或問過您的一切事項。最新的在前。"
          }
        }
      }
    },
