          "stringUnit": {
            "state": "translated",
            "value": "Primero este %1$@ cierra la sesión de KIFF y luego vuelves a iniciar sesión en tu navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet %1$@ se déconnecte d'abord de KIFF, puis vous vous reconnectez dans votre navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo %1$@ esce prima da KIFF, poi accedi di nuovo nel browser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %1$@ logt eerst uit bij KIFF, daarna log je opnieuw in via je browser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten %1$@ najpierw wyloguje się z KIFF, a potem zalogujesz się ponownie w przeglądarce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ termina primeiro a sessão no KIFF, e depois inicia sessão novamente no seu navegador."
          }
        }
      }
