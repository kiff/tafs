            "value": "Si la eliminación empezó, tafs la termina la próxima vez que se actualice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la suppression a commencé, tafs la termine à la prochaine actualisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la rimozione è iniziata, tafs la completa al prossimo aggiornamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het verwijderen is begonnen, rondt tafs het af bij de volgende vernieuwing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli usuwanie się zaczęło, tafs dokończy je przy następnym odświeżeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a remoção começou, o tafs conclui-a na próxima atualização."
