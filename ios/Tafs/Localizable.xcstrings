    "voice.microphone_off_tafs_turn_settings": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist für tafs ausgeschaltet. Schalte es unter Einstellungen › tafs › Mikrofon ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is off for tafs. Turn it on in Settings › tafs › Microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono está desactivado para tafs. Actívalo en Ajustes › tafs › Micrófono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon on tafsi jaoks välja lülitatud. Lülita see sisse menüüs Settings › tafs › Microphone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro est désactivé pour tafs. Activez-le dans Réglages › tafs › Micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è disattivato per tafs. Attivalo in Impostazioni › tafs › Microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsのマイクがオフになっています。設定 › tafs › マイクでオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs의 마이크가 꺼져 있습니다. 설정 › tafs › 마이크에서 켜세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonas programėlei tafs išjungtas. Įjunkite jį skiltyje Nustatymai › tafs › Mikrofonas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofons lietotnei tafs ir izslēgts. Ieslēdz to sadaļā Iestatījumi › tafs › Mikrofons."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon staat uit voor tafs. Zet hem aan in Instellingen › tafs › Microfoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon jest wyłączony dla tafs. Włącz go w Ustawienia › tafs › Mikrofon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está desativado para o tafs. Ative-o em Definições › tafs › Microfone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está desativado para o tafs. Ative-o em Ajustes › tafs › Microfone."
          }
        }
      }
    },
    "voice.microphone_off_tafs_turn_settings_mac": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist für tafs ausgeschaltet. Schalte es unter Systemeinstellungen › Datenschutz & Sicherheit › Mikrofon ein (unter macOS 12: Systemeinstellungen › Sicherheit › Datenschutz › Mikrofon)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is off for tafs. Turn it on in System Settings › Privacy & Security › Microphone (on macOS 12: System Preferences › Security & Privacy › Privacy › Microphone)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono está desactivado para tafs. Actívalo en Ajustes del Sistema › Privacidad y seguridad › Micrófono (en macOS 12: Preferencias del Sistema › Seguridad y privacidad › Privacidad › Micrófono)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon on tafsi jaoks välja lülitatud. Lülita see sisse menüüs System Settings › Privacy & Security › Microphone (macOS 12-s: System Preferences › Security & Privacy › Privacy › Microphone)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro est désactivé pour tafs. Activez-le dans Réglages Système › Confidentialité et sécurité › Micro (sous macOS 12 : Préférences Système › Sécurité et confidentialité › Confidentialité › Micro)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è disattivato per tafs. Attivalo in Impostazioni di Sistema › Privacy e sicurezza › Microfono (su macOS 12: Preferenze di Sistema › Sicurezza e privacy › Privacy › Microfono)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macでtafsのマイクがオフになっています。システム設定 › プライバシーとセキュリティ › マイクでオンにしてください（macOS 12：システム環境設定 › セキュリティとプライバシー › プライバシー › マイク）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 tafs의 마이크가 꺼져 있습니다. 시스템 설정 › 개인정보 보호 및 보안 › 마이크에서 켜세요(macOS 12: 시스템 환경설정 › 보안 및 개인 정보 보호 › 개인 정보 보호 › 마이크)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonas programėlei tafs išjungtas. Įjunkite jį skiltyje Sistemos nustatymai › Privatumas ir sauga › Mikrofonas (macOS 12: Sistemos nuostatos › Sauga ir privatumas › Privatumas › Mikrofonas)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofons lietotnei tafs ir izslēgts. Ieslēdz to sadaļā Sistēmas iestatījumi › Privātums un drošība › Mikrofons (macOS 12: Sistēmas preferences › Drošība un privātums › Privātums › Mikrofons)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon staat uit voor tafs. Zet hem aan in Systeeminstellingen › Privacy en beveiliging › Microfoon (op macOS 12: Systeemvoorkeuren › Beveiliging en privacy › Privacy › Microfoon)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon jest wyłączony dla tafs. Włącz go w Ustawienia systemowe › Prywatność i ochrona › Mikrofon (w macOS 12: Preferencje systemowe › Ochrona i prywatność › Prywatność › Mikrofon)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está desativado para o tafs. Ative-o em Definições do Sistema › Privacidade e segurança › Microfone (no macOS 12: Preferências do Sistema › Segurança e privacidade › Privacidade › Microfone)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está desativado para o tafs. Ative-o em Ajustes do Sistema › Privacidade e Segurança › Microfone (no macOS 12: Preferências do Sistema › Segurança e Privacidade › Privacidade › Microfone)."
          }
        }
      }
    },
    "voice.no_microphone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube tafs, das Mikrofon zum Diktieren zu nutzen. Deine Stimme wird auf diesem Telefon zu Text und nirgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow tafs to use the microphone to dictate. Your voice becomes text on this phone and isn't sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que tafs use el micrófono para dictar. Tu voz se convierte en texto en este teléfono y no se envía a ningún sitio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimiseks luba tafsil mikrofoni kasutada. Sinu hääl muutub selles telefonis tekstiks ja seda ei saadeta kuhugi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez tafs à utiliser le micro pour dicter. Votre voix devient du texte sur ce téléphone et n'est envoyée nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a tafs di usare il microfono per dettare. La tua voce diventa testo su questo telefono e non viene inviata da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力するには、tafsにマイクの使用を許可してください。声はこのスマートフォン上でテキストになり、どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기를 하려면 tafs의 마이크 사용을 허용하세요. 음성은 이 휴대폰에서 텍스트로 바뀌며 어디에도 보내지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiskite tafs naudoti mikrofoną diktavimui. Jūsų balsas paverčiamas tekstu šiame telefone ir niekur nesiunčiamas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atļauj lietotnei tafs izmantot mikrofonu, lai diktētu. Tava balss šajā tālrunī kļūst par tekstu un netiek nekur sūtīta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta tafs toe de microfoon te gebruiken om te dicteren. Je stem wordt op deze telefoon tekst en wordt nergens heen gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól tafs używać mikrofonu do dyktowania. Twój głos zamienia się w tekst na tym telefonie i nie jest nigdzie wysyłany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o tafs use o microfone para ditar. A sua voz torna-se texto neste telefone e não é enviada para lado nenhum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o tafs use o microfone para ditar. A sua voz torna-se texto neste telefone e não é enviada para lado nenhum."
          }
        }
      }
    },
    "voice.not_on_device": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon kann Sprache nicht direkt auf dem Gerät erkennen, daher funktioniert das Mikrofon hier nicht: Deine Stimme müsste es verlassen. Du kannst stattdessen tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can't recognise speech on the phone itself, so the mic doesn't work here: your voice would have to leave it. You can type instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no puede reconocer la voz en el propio teléfono, así que el micrófono no funciona aquí: tu voz tendría que salir de él. Puedes escribir en su lugar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See telefon ei tunne kõnet telefonis endas ära, seega mikrofon siin ei tööta: sinu hääl peaks sealt lahkuma. Võid hoopis kirjutada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone ne peut pas reconnaître la parole sur l'appareil même : le micro ne fonctionne donc pas ici, car votre voix devrait le quitter. Vous pouvez écrire à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non sa riconoscere il parlato sul telefono stesso, quindi il microfono qui non funziona: la tua voce dovrebbe lasciarlo. Puoi scrivere invece."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンは端末上で音声を認識できないため、ここではマイクが使えません。声が端末の外に出てしまうためです。代わりに入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰은 기기 자체에서 음성을 인식할 수 없어 여기서는 마이크가 작동하지 않습니다. 음성이 기기 밖으로 나가야 하기 때문입니다. 대신 입력할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis telefonas pats negali atpažinti kalbos, todėl mikrofonas čia neveikia: jūsų balsas turėtų jį palikti. Vietoj to galite rašyti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis tālrunis pats nevar atpazīt runu, tāpēc mikrofons šeit nedarbojas: tavai balsij būtu jāatstāj tālrunis. Tā vietā vari rakstīt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon kan spraak niet op het toestel zelf herkennen, dus de microfoon werkt hier niet: je stem zou het toestel moeten verlaten. Je kunt in plaats daarvan typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon nie potrafi rozpoznawać mowy na samym urządzeniu, więc mikrofon tu nie działa: Twój głos musiałby je opuścić. Możesz zamiast tego pisać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone não consegue reconhecer a fala no próprio telefone, por isso o microfone não funciona aqui: a sua voz teria de sair dele. Pode escrever em vez disso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone não consegue reconhecer a fala no próprio telefone, por isso o microfone não funciona aqui: a sua voz teria de sair dele. Pode escrever em vez disso."
          }
        }
      }
    },
