    "files.kept_line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ كل ملف 30 يومًا من تشغيله ثم يزول من تلقاء نفسه. يرى هذه الملفات كل من في هذا الحساب. أما مرفقات محادثتك الخاصة فتبقى مع رسائلها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər fayl işdən 30 gün saxlanılır, sonra özü silinir. Bu hesabdakı hər kəs bu faylları görür. Öz söhbət əlavələriniz mesajlarının yanında qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки файл се пази 30 дни от изпълнението си, след което изчезва сам. Всички в този акаунт виждат тези файлове. Прикачените файлове в собствените ви чатове остават със съобщенията си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি ফাইল রান থেকে ৩০ দিন রাখা হয়, তারপর নিজে থেকেই মুছে যায়। এই অ্যাকাউন্টের সবাই এই ফাইলগুলো দেখতে পান। আপনার নিজের চ্যাটের সংযুক্তি তাদের বার্তার সঙ্গেই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fitxer es conserva 30 dies des de la seva execució i després desapareix tot sol. Tothom en aquest compte veu aquests fitxers. Els teus propis adjunts dels xats es queden amb els seus missatges."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý soubor se uchovává 30 dní od svého běhu a pak sám zmizí. Tyto soubory vidí všichni v tomto účtu. Přílohy vašich chatů zůstávají u svých zpráv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Datei wird 30 Tage ab ihrem Lauf aufbewahrt und verschwindet dann von selbst. Alle in diesem Konto sehen diese Dateien. Deine eigenen Chat-Anhänge bleiben bei ihren Nachrichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each file is kept 30 days from its run, then goes away on its own. Everyone on this account sees these files. Your own chat attachments stay with their messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada archivo se guarda 30 días desde su ejecución y luego se va solo. Todo el mundo en esta cuenta ve estos archivos. Los adjuntos de tus chats se quedan con sus mensajes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga faili hoitakse 30 päeva alates selle käivitusest, siis kaob see ise. Kõik selle konto inimesed näevad neid faile. Sinu enda vestluste manused jäävad oma sõnumite juurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fichier est conservé 30 jours après son exécution, puis disparaît de lui-même. Tout le monde sur ce compte voit ces fichiers. Vos propres pièces jointes de chat restent avec leurs messages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל קובץ נשמר 30 יום מהריצה שלו, ואז נעלם מעצמו. כל מי שנמצא בחשבון הזה רואה את הקבצים האלה. הקבצים שצירפת בשיחות נשארים עם ההודעות שלהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर फ़ाइल उसकी रन से 30 दिन रखी जाती है, फिर अपने आप हट जाती है। इस खाते के सभी लोग ये फ़ाइलें देखते हैं। आपकी अपनी चैट के संलग्नक अपने संदेशों के साथ रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka se datoteka čuva 30 dana od svog izvođenja, a zatim sama nestaje. Sve ove datoteke vide svi na ovom računu. Vaši vlastiti privici razgovora ostaju uz njihove poruke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden fájl 30 napig marad meg a futásától számítva, aztán magától eltűnik. Ezeket a fájlokat a fiók minden tagja látja. A saját csevegésmellékleteid az üzeneteiknél maradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր ֆայլ պահվում է գործարկումից 30 օր, ապա ինքնին անհետանում է։ Այս ֆայլերը տեսնում են այս հաշվի բոլորը։ Ձեր զրույցների կցորդները մնում են իրենց հաղորդագրությունների հետ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap file disimpan 30 hari sejak eksekusinya, lalu hilang dengan sendirinya. Semua orang di akun ini melihat file-file ini. Lampiran obrolan Anda sendiri tetap bersama pesannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni file è conservato 30 giorni dalla sua esecuzione, poi sparisce da solo. Tutti in questo account vedono questi file. I tuoi allegati della chat restano con i loro messaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ファイルは実行から30日間保存され、その後自動的に削除されます。このアカウントの全員がこれらのファイルを見られます。あなた自身のチャットの添付ファイルはメッセージとともに残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყოველი ფაილი ინახება გაშვებიდან 30 დღე, შემდეგ თავისით ქრება. ამ ფაილებს ამ ანგარიშის ყველა ხედავს. თქვენი ჩატის დანართები თავიანთ შეტყობინებებთან რჩება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារនីមួយៗត្រូវបានរក្សាទុក ៣០ ថ្ងៃពីការដំណើរការរបស់វា រួចបាត់ទៅដោយខ្លួនឯង។ អ្នកគ្រប់គ្នាលើគណនីនេះឃើញឯកសារទាំងនេះ។ ឯកសារភ្ជាប់ក្នុងការសន្ទនារបស់អ្នកផ្ទាល់នៅជាមួយសាររបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 파일은 실행일로부터 30일 동안 보관된 후 자동으로 삭제됩니다. 이 계정의 모든 사람이 이 파일을 볼 수 있습니다. 내 채팅 첨부 파일은 해당 메시지와 함께 남습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແຕ່ລະໄຟລ໌ຖືກເກັບໄວ້ 30 ມື້ຈາກການເຮັດວຽກຂອງມັນ ແລ້ວຫາຍໄປເອງ. ທຸກຄົນໃນບັນຊີນີ້ເຫັນໄຟລ໌ເຫຼົ່ານີ້. ໄຟລ໌ແນບໃນການສົນທະນາຂອງທ່ານເອງຢູ່ກັບຂໍ້ຄວາມຂອງມັນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas failas saugomas 30 dienų nuo jo paleidimo, tada ištrinamas automatiškai. Šiuos failus mato visi šios paskyros nariai. Jūsų pačių pokalbių priedai lieka su savo žinutėmis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katrs fails tiek glabāts 30 dienas no tā palaišanas, pēc tam pazūd pats. Šos failus redz ikviens šajā kontā. Tavu sarunu pielikumi paliek kopā ar savām ziņām."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секоја датотека се чува 30 дена од нејзиното извршување, па сама исчезнува. Сите на оваа сметка ги гледаат овие датотеки. Твоите прикачени датотеки во разговорите остануваат со своите пораки."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл бүр ажиллалтаас хойш 30 хоног хадгалагдаж, дараа нь өөрөө устна. Энэ бүртгэлийн бүх хүн эдгээр файлыг харна. Таны өөрийн чатын хавсралтууд мессежтэйгээ хамт үлдэнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक फाइल चलाइदेखि ३० दिन राखिन्छ, त्यसपछि आफैँ हट्छ। यस खाताका सबैले यी फाइल देख्छन्। तपाईंका आफ्नै च्याट संलग्नहरू आफ्ना सन्देशसँगै रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk bestand wordt 30 dagen na zijn run bewaard en verdwijnt daarna vanzelf. Iedereen in dit account ziet deze bestanden. Je eigen chatbijlagen blijven bij hun berichten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy plik jest przechowywany 30 dni od swojego uruchomienia, a potem sam znika. Wszyscy na tym koncie widzą te pliki. Twoje własne załączniki z czatu zostają przy swoich wiadomościach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ficheiro é guardado 30 dias a partir da sua execução e depois desaparece sozinho. Toda a gente nesta conta vê estes ficheiros. Os seus próprios anexos de chat ficam com as suas mensagens."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada arquivo é guardado 30 dias a partir da sua execução e depois desaparece sozinho. Todos nesta conta veem estes arquivos. Os seus próprios anexos de chat ficam com as suas mensagens."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare fișier se păstrează 30 de zile de la rularea sa, apoi dispare singur. Toată lumea din acest cont vede aceste fișiere. Atașamentele din propriile conversații rămân cu mesajele lor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý súbor sa uchováva 30 dní od svojho behu a potom sám zmizne. Tieto súbory vidia všetci v tomto účte. Prílohy vašich chatov zostávajú pri svojich správach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka datoteka se hrani 30 dni od svojega zagona, nato izgine sama. Te datoteke vidijo vsi v tem računu. Priponke vaših klepetov ostanejo pri svojih sporočilih."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo skedar ruhet 30 ditë nga ekzekutimi i tij, pastaj zhduket vetë. Çdokush në këtë llogari i sheh këta skedarë. Bashkëngjitjet tuaja të bisedave qëndrojnë me mesazhet e tyre."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka se datoteka čuva 30 dana od svog izvršavanja, a zatim sama nestaje. Sve ove datoteke vide svi na ovom nalogu. Vaši vlastiti privici razgovora ostaju uz njihove poruke."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละไฟล์เก็บไว้ 30 วันนับจากการทำงาน แล้วหายไปเอง ทุกคนในบัญชีนี้เห็นไฟล์เหล่านี้ ไฟล์แนบในแชตของคุณเองยังอยู่กับข้อความของมัน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Her faýl işlemesinden 30 gün saklanýar, soňra özbaşdak ýok bolýar. Bu hasapdaky hemmeler bu faýllary görýär. Öz söhbetdeşlik goşundylaryňyz öz habarlary bilen galýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dosya çalıştırmasından itibaren 30 gün saklanır, sonra kendiliğinden kalkar. Bu dosyaları bu hesaptaki herkes görür. Kendi sohbet eklerinizi mesajlarıyla birlikte kalır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر فائل اپنے رن سے 30 دن رکھی جاتی ہے، پھر خود ہٹ جاتی ہے۔ اس اکاؤنٹ کا ہر فرد یہ فائلیں دیکھتا ہے۔ آپ کی اپنی چیٹ کے منسلکات اپنے پیغامات کے ساتھ رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi tệp được giữ 30 ngày kể từ lượt chạy của nó, rồi tự biến mất. Mọi người trong tài khoản này đều thấy các tệp này. Tệp đính kèm trong cuộc trò chuyện của riêng bạn vẫn ở cùng tin nhắn của chúng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個檔案自執行起保留 30 天，之後會自動移除。此帳號的所有人都看得到這些檔案。您自己在對話中的附件仍保留在各自的訊息中。"
          }
        }
      }
    },
