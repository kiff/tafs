    "chat.empty_named": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag %1$@, was er getan hat, oder sag ihm, was er anders machen soll. Er bleibt innerhalb seiner Card. Ein Aufruf, den du genehmigen musst, aus einem Chat oder einem geplanten Lauf, erscheint auch hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask %1$@ what it did, or tell it what to do differently. It stays inside its Card. A call it needs you to approve, from a chat or a scheduled run, shows here too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a %1$@ qué hizo, o dile qué hacer de otra forma. Se mantiene dentro de su Card. Aquí también aparece una llamada que necesite tu aprobación, desde un chat o una ejecución programada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à %1$@ ce qu'il a fait, ou dites-lui quoi faire autrement. Il reste dans sa Card. Un appel qu'il vous demande d'approuver, depuis un chat ou une exécution planifiée, s'affiche aussi ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a %1$@ cosa ha fatto, o digli cosa fare diversamente. Resta entro la sua Card. Anche una chiamata che deve farti approvare, da una chat o da un'esecuzione pianificata, compare qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag %1$@ wat het heeft gedaan, of zeg wat het anders moet doen. Het blijft binnen zijn Card. Een aanroep die je moet goedkeuren, uit een chat of een geplande run, verschijnt hier ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj %1$@, co zrobił, albo powiedz mu, co ma robić inaczej. Działa w ramach swojej Card. Wywołanie, które musisz zatwierdzić, z czatu lub zaplanowanego uruchomienia, też pojawi się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte a %1$@ o que fez, ou diga-lhe o que fazer de outra forma. Fica sempre dentro do seu Card. Uma chamada que precise da sua aprovação, de um chat ou de uma execução agendada, também aparece aqui."
          }
        }
      }
    },
