        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהתקן הזה (%1$@) אין קוד גישה, ו-%2$@ דורש קוד כזה. יש להגדיר קוד גישה ב%3$@, אחר כך להוסיף %4$@ ולחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस %1$@ में पासकोड नहीं है, और %2$@ को उसकी ज़रूरत है। %3$@ में पासकोड सेट करें, फिर %4$@ जोड़ें, फिर लौट आएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj %1$@ nema šifru, a za sljedeće je potrebna: %2$@. Postavite šifru u: %3$@, zatim dodajte: %4$@ i vratite se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen az eszközön (%1$@) nincs jelkód, pedig ehhez kell egy: %2$@. Állíts be jelkódot itt: %3$@, add hozzá ezt: %4$@, majd gyere vissza."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքը (%1$@) կոդ չունի, իսկ %2$@-ին այն պետք է։ Կարգավորեք կոդը՝ %3$@, ապա ավելացրեք՝ %4$@, ապա վերադարձեք։"
