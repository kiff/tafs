    "approval.security_key.enter_pin": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təhlükəsizlik açarınızın PIN-ini daxil edin. tafs bunu hər dəfə istəyir və heç vaxt saxlamır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете ПИН кода на ключа за сигурност. tafs го иска всеки път и никога не го съхранява."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte PIN bezpečnostního klíče. tafs se na něj zeptá pokaždé a nikdy ho neukládá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die PIN deines Sicherheitsschlüssels ein. tafs fragt jedes Mal danach und speichert sie nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your security key's PIN. tafs asks for it each time and never stores it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el PIN de tu llave de seguridad. tafs lo pide cada vez y nunca lo guarda."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta oma turvavõtme PIN-kood. tafs küsib seda iga kord ega salvesta seda kunagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code PIN de votre clé de sécurité. tafs le demande à chaque fois et ne l'enregistre jamais."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite PIN svojeg sigurnosnog ključa. tafs ga traži svaki put i nikad ga ne sprema."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a biztonsági kulcsod PIN-kódját. A tafs minden alkalommal kéri, és soha nem tárolja."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրեք ձեր անվտանգության բանալու PIN-ը։ tafs-ը այն խնդրում է ամեն անգամ և երբեք չի պահում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan PIN kunci keamanan Anda. tafs memintanya setiap kali dan tidak pernah menyimpannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il PIN della tua chiave di sicurezza. tafs lo chiede ogni volta e non lo salva mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティキーのPINを入力してください。tafsは毎回PINを求め、保存することはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეიყვანეთ თქვენი უსაფრთხოების გასაღების PIN. tafs მას ყოველ ჯერზე ითხოვს და არასოდეს ინახავს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 키의 PIN을 입력하세요. tafs는 매번 PIN을 묻고 저장하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite saugos rakto PIN. tafs jo prašo kaskart ir niekada jo nesaugo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadi savas drošības atslēgas PIN. tafs to prasa katru reizi un nekad neglabā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de pincode van je beveiligingssleutel in. tafs vraagt er elke keer om en bewaart hem nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz PIN swojego klucza bezpieczeństwa. tafs pyta o niego za każdym razem i nigdy go nie zapisuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza o PIN da sua chave de segurança. O tafs pede-o sempre e nunca o guarda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o PIN da sua chave de segurança. O tafs pede o PIN sempre e nunca o guarda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți PIN-ul cheii de securitate. tafs îl cere de fiecare dată și nu îl stochează niciodată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte PIN bezpečnostného kľúča. tafs sa naň opýta zakaždým a nikdy ho neukladá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite PIN varnostnega ključa. tafs ga zahteva vsakič in ga nikoli ne shrani."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Futni PIN-in e çelësit tuaj të sigurisë. tafs e kërkon çdo herë dhe nuk e ruan kurrë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite PIN svog sigurnosnog ključa. tafs ga traži svaki put i nikad ga ne čuva."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ PIN ของกุญแจความปลอดภัย tafs จะถามทุกครั้งและไม่เก็บไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik anahtarınızın PIN'ini girin. tafs her seferinde ister ve asla saklamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nhập PIN của khóa bảo mật. tafs hỏi mỗi lần và không bao giờ lưu nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入安全金鑰的 PIN。tafs 每次都會詢問，且不會儲存。"
          }
        }
      }
    },
    "approval.security_key.failed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təhlükəsizlik açarı imzalaya bilmədi, ona görə heç nə təsdiqlənmədi. Sorğu saxlanılıb: hazır olanda yenidən təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът за сигурност не можа да подпише, така че нищо не беше одобрено. Заявката се запазва: одобрете отново, когато сте готови."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostní klíč nemohl podepsat, takže se nic neschválilo. Žádost zůstává: schvalte znovu, až budete připraveni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sicherheitsschlüssel konnte nicht signieren, also wurde nichts genehmigt. Die Anfrage bleibt erhalten: Genehmige erneut, wenn du so weit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The security key couldn't sign, so nothing was approved. The request is kept: approve again when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llave de seguridad no pudo firmar, así que no se aprobó nada. La solicitud se conserva: vuelve a aprobar cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Turvavõti ei saanud allkirjastada, seega midagi ei kinnitatud. Päring jääb alles: kinnita uuesti, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de sécurité n'a pas pu signer : rien n'a été approuvé. La demande est conservée : approuvez à nouveau quand vous êtes prêt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosni ključ nije mogao potpisati pa ništa nije odobreno. Zahtjev je sačuvan: odobrite ponovno kad budete spremni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biztonsági kulcs nem tudott aláírni, így semmi sem lett jóváhagyva. A kérés megmarad: hagyd jóvá újra, ha készen állsz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անվտանգության բանալին չկարողացավ ստորագրել, ուստի ոչինչ չհաստատվեց։ Հարցումը պահպանվել է․ հաստատեք նորից, երբ պատրաստ լինեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci keamanan tidak dapat menandatangani, jadi tidak ada yang disetujui. Permintaan tetap disimpan: setujui lagi saat Anda siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di sicurezza non è riuscita a firmare, quindi non è stato approvato nulla. La richiesta resta: approva di nuovo quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティキーで署名できなかったため、何も承認されていません。リクエストは保持されています。準備ができたらもう一度承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უსაფრთხოების გასაღებმა ხელმოწერა ვერ შეძლო, ამიტომ არაფერი დამტკიცებულა. მოთხოვნა შენახულია: დაამტკიცეთ ხელახლა, როცა მზად იქნებით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 키로 서명하지 못해 승인된 것은 없습니다. 요청은 남아 있으니 준비되면 다시 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saugos raktas negalėjo pasirašyti, todėl niekas nepatvirtinta. Užklausa išsaugota: patvirtinkite dar kartą, kai būsite pasirengę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drošības atslēga nevarēja parakstīt, tāpēc nekas netika apstiprināts. Pieprasījums ir saglabāts: apstiprini vēlreiz, kad esi gatavs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beveiligingssleutel kon niet ondertekenen, dus er is niets goedgekeurd. Het verzoek blijft bewaard: keur het goed wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz bezpieczeństwa nie mógł podpisać, więc nic nie zostało zatwierdzone. Prośba zostaje zachowana: zatwierdź ją ponownie, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança não conseguiu assinar, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança não conseguiu assinar, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia de securitate nu a putut semna, așa că nu s-a aprobat nimic. Solicitarea se păstrează: aprobați din nou când sunteți gata."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostný kľúč nemohol podpísať, takže sa nič neschválilo. Žiadosť zostáva: schváľte znova, keď budete pripravení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Varnostni ključ ni mogel podpisati, zato ni bilo nič odobreno. Zahteva ostane: odobrite znova, ko boste pripravljeni."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çelësi i sigurisë nuk mundi të nënshkruajë, ndaj asgjë nuk u miratua. Kërkesa ruhet: miratoni sërish kur të jeni gati."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosni ključ nije mogao da potpiše, pa ništa nije odobreno. Zahtev je sačuvan: odobrite ponovo kad budete spremni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กุญแจความปลอดภัยลงนามไม่ได้ จึงไม่มีอะไรถูกอนุมัติ คำขอยังอยู่: อนุมัติอีกครั้งเมื่อคุณพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik anahtarı imzalayamadı, bu yüzden hiçbir şey onaylanmadı. İstek korunuyor: hazır olduğunuzda tekrar onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa bảo mật không thể ký nên không có gì được phê duyệt. Yêu cầu vẫn được giữ: hãy phê duyệt lại khi bạn sẵn sàng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全金鑰無法簽署，因此未核准任何項目。請求仍保留：準備好時再次核准。"
          }
        }
      }
    },
    "approval.security_key.locked": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu təhlükəsizlik açarı çox yanlış PIN-dən sonra kilidlənib, ona görə təsdiq edə bilmir. Telefonunuzda təsdiq edin. Açarı sıfırlamaq onu silir, ona görə açarla yenidən təsdiq etmək üçün bu kompüteri yenidən cütləşdirin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този ключ за сигурност е заключен след твърде много грешни ПИН кодове, така че не може да одобрява. Одобрявайте на телефона си. Нулирането на ключа го изтрива, така че, за да одобрявате отново с ключ, сдвоете този компютър отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento bezpečnostní klíč je po příliš mnoha špatných PINech zamčený, takže nemůže schvalovat. Schvalte v telefonu. Resetování klíč vymaže, takže pro schvalování klíčem tento počítač znovu spárujte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Sicherheitsschlüssel ist nach zu vielen falschen PINs gesperrt und kann nicht genehmigen. Genehmige auf deinem Telefon. Beim Zurücksetzen wird der Schlüssel gelöscht. Um wieder mit einem Schlüssel zu genehmigen, kopple diesen Computer erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This security key is locked after too many wrong PINs, so it can't approve. Approve on your phone. Resetting the key erases it, so to approve with a key again, pair this computer again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta llave de seguridad está bloqueada tras demasiados PIN incorrectos, así que no puede aprobar. Aprueba en tu teléfono. Restablecer la llave la borra, así que para volver a aprobar con una llave, vuelve a vincular este ordenador."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See turvavõti on liiga paljude valede PIN-koodide tõttu lukus, seega ei saa see kinnitada. Kinnita telefonis. Võtme lähtestamine kustutab selle, seega võtmega uuesti kinnitamiseks seo see arvuti uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé de sécurité est verrouillée après trop de codes PIN incorrects : elle ne peut pas approuver. Approuvez sur votre téléphone. Réinitialiser la clé l'efface : pour approuver de nouveau avec une clé, associez de nouveau cet ordinateur."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj je sigurnosni ključ zaključan zbog previše pogrešnih PIN-ova pa ne može odobravati. Odobrite na telefonu. Resetiranje ključa briše ga, pa da biste ponovno odobravali ključem, ponovno uparite ovo računalo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a biztonsági kulcs túl sok hibás PIN-kód után zárolva van, ezért nem tud jóváhagyni. Hagyd jóvá a telefonodon. A kulcs alaphelyzetbe állítása törli, ezért ha újra kulccsal akarsz jóváhagyni, párosítsd újra ezt a számítógépet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անվտանգության բանալին կողպվեց չափազանց շատ սխալ PIN-ներից հետո, ուստի չի կարող հաստատել։ Հաստատեք ձեր հեռախոսով։ Բանալու վերակայումը ջնջում է այն, ուստի բանալիով նորից հաստատելու համար նորից զուգակցեք այս համակարգիչը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci keamanan ini terkunci setelah terlalu banyak PIN yang salah, jadi tidak dapat menyetujui. Setujui di ponsel Anda. Mengatur ulang kunci akan menghapusnya, jadi untuk menyetujui dengan kunci lagi, pasangkan komputer ini lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chiave di sicurezza è bloccata dopo troppi PIN errati, quindi non può approvare. Approva sul telefono. Ripristinare la chiave la cancella, quindi per approvare di nuovo con una chiave, associa di nuovo questo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PINの誤入力が多すぎるため、このセキュリティキーはロックされ、承認できません。スマートフォンで承認してください。キーをリセットすると内容が消去されるため、再びキーで承認するには、このコンピュータをもう一度ペアリングしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს უსაფრთხოების გასაღები ჩაიკეტა ზედმეტი არასწორი PIN-ის შემდეგ, ამიტომ დამტკიცება არ შეუძლია. დაამტკიცეთ ტელეფონზე. გასაღების გადატვირთვა მას წაშლის, ამიტომ გასაღებით ხელახლა დასამტკიცებლად ისევ დააწყვილეთ ეს კომპიუტერი."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN을 너무 많이 틀려 이 보안 키가 잠겼으므로 승인할 수 없습니다. 휴대폰에서 승인하세요. 키를 재설정하면 키가 초기화되므로, 다시 키로 승인하려면 이 컴퓨터를 다시 페어링하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis saugos raktas užrakintas po per daug neteisingų PIN, todėl negali tvirtinti. Tvirtinkite telefone. Atkūrus rakto nustatymus jis išvalomas, todėl norėdami vėl tvirtinti raktu, iš naujo susiekite šį kompiuterį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī drošības atslēga ir bloķēta pēc pārāk daudziem nepareiziem PIN, tāpēc tā nevar apstiprināt. Apstiprini savā tālrunī. Atslēgas atiestatīšana to izdzēš, tāpēc, lai atkal apstiprinātu ar atslēgu, vēlreiz savieno šo datoru pārī."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze beveiligingssleutel is vergrendeld na te veel verkeerde pincodes, dus hij kan niet goedkeuren. Keur goed op je telefoon. Als je de sleutel herstelt, wordt hij gewist. Om weer met een sleutel goed te keuren, koppel je deze computer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten klucz bezpieczeństwa jest zablokowany po zbyt wielu złych PIN-ach, więc nie może zatwierdzać. Zatwierdź na telefonie. Zresetowanie klucza go wymazuje, więc aby znów zatwierdzać kluczem, sparuj ten komputer ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave de segurança está bloqueada após demasiados PIN errados, por isso não pode aprovar. Aprove no seu telefone. Repor a chave apaga-a, por isso, para voltar a aprovar com uma chave, associe novamente este computador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave de segurança está bloqueada após muitos PINs errados, por isso não pode aprovar. Aprove no seu telefone. Redefinir a chave a apaga; então, para voltar a aprovar com uma chave, associe novamente este computador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această cheie de securitate este blocată după prea multe PIN-uri greșite, așa că nu poate aproba. Aprobați pe telefon. Resetarea cheii o șterge, așa că, pentru a aproba din nou cu o cheie, asociați din nou acest computer."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento bezpečnostný kľúč je po príliš mnohých nesprávnych PIN zamknutý, takže nemôže schvaľovať. Schváľte v telefóne. Resetovanie kľúč vymaže, takže na schvaľovanie kľúčom tento počítač znova spárujte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta varnostni ključ je po preveč napačnih PIN-ih zaklenjen, zato ne more odobravati. Odobrite v telefonu. Ponastavitev ključ izbriše, zato za odobravanje s ključem ta računalnik znova seznanite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky çelës sigurie është kyçur pas shumë PIN-eve të gabuar, ndaj nuk mund të miratojë. Miratoni në telefonin tuaj. Rivendosja e çelësit e fshin, ndaj për të miratuar sërish me një çelës, çiftojeni sërish këtë kompjuter."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj sigurnosni ključ je zaključan posle previše pogrešnih PIN-ova, pa ne može da odobrava. Odobrite na telefonu. Resetovanje ključa ga briše, pa da biste ponovo odobravali ključem, ponovo uparite ovaj računar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กุญแจความปลอดภัยนี้ถูกล็อกเพราะใส่ PIN ผิดหลายครั้ง จึงอนุมัติไม่ได้ ให้อนุมัติบนโทรศัพท์ของคุณ การรีเซ็ตกุญแจจะลบข้อมูลในกุญแจ ดังนั้นหากต้องการอนุมัติด้วยกุญแจอีกครั้ง ให้จับคู่คอมพิวเตอร์เครื่องนี้ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu güvenlik anahtarı çok fazla yanlış PIN'den sonra kilitlendi, bu yüzden onay veremez. Telefonunuzdan onaylayın. Anahtarı sıfırlamak onu siler; bu yüzden bir anahtarla tekrar onaylamak için bu bilgisayarı yeniden eşleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa bảo mật này bị khóa sau quá nhiều PIN sai nên không thể phê duyệt. Hãy phê duyệt trên điện thoại của bạn. Đặt lại khóa sẽ xóa nó, vì vậy để phê duyệt bằng khóa lần nữa, hãy ghép đôi lại máy tính này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這把安全金鑰因 PIN 輸入錯誤次數過多而鎖定，因此無法核准。請在您的手機上核准。重設金鑰會清除它，所以若要再次以金鑰核准，請重新配對這部電腦。"
          }
        }
      }
    },
    "approval.security_key.no_key": {
