        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda (%1$@) parol yoxdur, %2$@ isə ona ehtiyac duyur. Parolu burada qurun: %3$@, sonra əlavə edin: %4$@, sonra qayıdın."
