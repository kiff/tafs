            "value": "Nur der Anfang wird angezeigt. Lade die Datei herunter, um alles zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the start is shown. Download the file to read all of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestra el principio. Descarga el archivo para leerlo entero."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Näidatakse ainult algust. Kogu faili lugemiseks laadi see alla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le début est affiché. Téléchargez le fichier pour le lire en entier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È mostrato solo l'inizio. Scarica il file per leggerlo tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先頭部分だけを表示しています。全体を読むにはファイルをダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞부분만 표시됩니다. 전체를 읽으려면 파일을 다운로드하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodoma tik pradžia. Atsisiųskite failą, kad perskaitytumėte visą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rādīts tikai sākums. Lejupielādē failu, lai izlasītu visu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het begin wordt getoond. Download het bestand om alles te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazano tylko początek. Pobierz plik, aby przeczytać całość."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
