          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte otisak prsta na ovaj telefon da biste s njega odobravali. Odbijanje i dalje radi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá ujjlenyomatot ehhez a telefonhoz, hogy jóváhagyhass róla. Az elutasítás továbbra is működik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելացրեք մատնահետք այս հեռախոսում՝ դրանից հաստատելու համար։ Մերժելը շարունակում է աշխատել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan sidik jari ke ponsel ini untuk menyetujui darinya. Menolak tetap berfungsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un'impronta a questo telefono per approvare da qui. Puoi comunque rifiutare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンから承認するには、指紋を追加してください。拒否は引き続きできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაამატეთ თითის ანაბეჭდი ამ ტელეფონზე, რომ მისგან დაამტკიცოთ. უარის თქმა კვლავ მუშაობს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에서 승인하려면 지문을 추가하세요. 거절은 계속 할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėkite piršto atspaudą šiame telefone, kad galėtumėte juo tvirtinti. Atmesti vis tiek galima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievieno šim tālrunim pirksta nospiedumu, lai apstiprinātu no tā. Atteikt joprojām var."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een vingerafdruk toe aan deze telefoon om ermee goed te keuren. Weigeren werkt nog steeds."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj odcisk palca na tym telefonie, aby z niego zatwierdzać. Odrzucanie nadal działa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma impressão digital a este telefone para aprovar a partir dele. Recusar continua a funcionar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma impressão digital a este telefone para aprovar a partir dele. Recusar continua funcionando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați o amprentă pe acest telefon pentru a aproba de pe el. Refuzul funcționează în continuare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete z tohto telefónu schvaľovať, pridajte doň odtlačok prsta. Odmietať sa dá aj tak."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za odobravanje s tega telefona vanj dodajte prstni odtis. Zavračanje še vedno deluje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shtoni një gjurmë gishti në këtë telefon për të miratuar prej tij. Refuzimi funksionon prapë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte otisak prsta na ovaj telefon da biste odobravali sa njega. Odbijanje i dalje radi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มลายนิ้วมือบนโทรศัพท์เครื่องนี้เพื่ออนุมัติจากเครื่อง การปฏิเสธยังใช้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefondan onaylamak için telefona bir parmak izi ekleyin. Reddetmek yine çalışır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm vân tay vào điện thoại này để phê duyệt từ đó. Từ chối vẫn dùng được."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在這部手機上新增指紋，才能用它核准。拒絕仍可使用。"
          }
        }
      }
    },
