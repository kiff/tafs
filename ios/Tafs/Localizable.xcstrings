    "door.anyone_else_today": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ من %2$@ من أي شخص آخر اليوم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün başqalarından %2$@ içindən %1$@."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ от %2$@ от всеки друг днес."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ অন্য কারও কাছ থেকে %2$@-এর মধ্যে %1$@।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ de qualsevol altra persona avui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od kohokoli jiného dnes %1$@ z %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@ von allen anderen heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@ from anyone else today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ de cualquier otra persona hoy."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täna kõigilt teistelt %1$@/%2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
