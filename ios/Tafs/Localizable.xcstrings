        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកចូលចិត្តឱ្យខ្ញុំពន្យល់ការសម្រេចចិត្តក្នុងមួយបន្ទាត់ ជាជាងក្នុងកថាខណ្ឌមួយ។"
