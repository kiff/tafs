            "value": "%1$@ татгалзсан. Юу ч хийгдээгүй бөгөөд өнөөдрийн хязгаарт тооцогдохгүй"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ले अस्वीकार गर्‍यो। केही गरिएन, र यो आजका सीमामा गनिँदैन"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft het geweigerd. Er is niets gedaan, en het telt niet mee voor de limieten van vandaag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to odrzucił. Nic nie zostało zrobione i nie liczy się to do dzisiejszych limitów"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recusou. Nada foi feito, e não conta para os limites de hoje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recusou. Nada foi feito, e não conta para os limites de hoje"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ l-a refuzat. Nu s-a făcut nimic și nu se numără în limitele de azi"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to odmietol (odmietla). Nič sa neurobilo a do dnešných limitov sa to nepočíta"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je to zavrnil(a). Nič ni bilo storjeno in se ne šteje v današnje omejitve"
