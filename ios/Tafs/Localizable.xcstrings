    "sign_in.again_to_sign": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ilə yenidən daxil olun: bu giriş telefon üçün imzalaya bilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влезте отново с KIFF: този вход не може да подписва за телефона."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se znovu přes KIFF: toto přihlášení nemůže podepisovat za telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich erneut mit KIFF an: Diese Anmeldung kann nicht für das Telefon signieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with KIFF again: this sign-in can't sign for the phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a iniciar sesión con KIFF: este inicio de sesión no puede firmar por el teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Logi uuesti KIFFiga sisse: see sisselogimine ei saa telefoni eest allkirjastada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous avec KIFF : cette connexion ne peut pas signer pour le téléphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se ponovno KIFF-om: ova prijava ne može potpisivati za telefon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezz be újra a KIFF-fel: ez a bejelentkezés nem tud aláírni a telefon nevében."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նորից մուտք գործեք KIFF-ով․ այս մուտքը չի կարող ստորագրել հեռախոսի համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan KIFF lagi: proses masuk ini tidak dapat menandatangani untuk ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi di nuovo con KIFF: questo accesso non può firmare per il telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度KIFFでサインインしてください。このサインインではスマートフォンで署名できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კვლავ შედით KIFF-ით: ამ შესვლას ტელეფონისთვის ხელმოწერა არ შეუძლია."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF로 다시 로그인하세요. 이 로그인으로는 휴대폰에서 서명할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar kartą prisijunkite su KIFF: šis prisijungimas negali pasirašyti už telefoną."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēlreiz pieraksties ar KIFF: šī pierakstīšanās nevar parakstīt tālruņa vārdā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log opnieuw in met KIFF: deze login kan niet voor de telefoon ondertekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się ponownie przez KIFF: to logowanie nie może podpisywać za ten telefon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão novamente com o KIFF: esta sessão não pode assinar pelo telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre novamente com o KIFF: esta sessão não pode assinar pelo telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectați-vă din nou cu KIFF: această conectare nu poate semna pentru telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihláste sa znova cez KIFF: toto prihlásenie nemôže podpisovať za telefón."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova se prijavite s KIFF: ta prijava ne more podpisovati za telefon."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyni sërish me KIFF: kjo hyrje nuk mund të nënshkruajë për telefonin."
          }
        },
        "sr-Latn": {
