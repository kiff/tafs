    "coach.sign_in_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح صفحة المزوّد نفسه. لا يرى أي taf تسجيل دخولك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təchizatçının öz səhifəsi açılır. Heç bir taf sizin girişinizi görmür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отваря се собствената страница на доставчика. Никой taf не вижда входа ви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিক্রেতার নিজস্ব পাতা খোলে। কোনো taf আপনার সাইন-ইন দেখে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'obre la pàgina del mateix proveïdor. Cap taf no veu el teu inici de sessió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře se vlastní stránka dodavatele. Žádný taf nevidí vaše přihlášení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigene Seite des Anbieters öffnet sich. Kein taf sieht deine Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vendor's own page opens. No taf sees your sign-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre la propia página del proveedor. Ningún taf ve tu inicio de sesión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaneb pakkuja enda leht. Ükski taf ei näe sinu sisselogimist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page du fournisseur s'ouvre. Aucun taf ne voit votre connexion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדף של הספק עצמו נפתח. אף taf לא רואה את הכניסה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विक्रेता का अपना पृष्ठ खुलता है। कोई taf आपका साइन-इन नहीं देखता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara se pružateljeva vlastita stranica. Nijedan taf ne vidi vašu prijavu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szolgáltató saját oldala nyílik meg. Egyetlen taf sem látja a bejelentkezésedet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացվում է հենց մատակարարի էջը։ Ոչ մի taf չի տեսնում ձեր մուտքը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman milik vendor sendiri terbuka. Tidak ada taf yang melihat proses masuk Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apre la pagina del fornitore. Nessun taf vede il tuo accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供元のページが開きます。tafがあなたのサインイン情報を見ることはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იხსნება თავად მომწოდებლის გვერდი. არც ერთი taf არ ხედავს თქვენს შესვლას."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទំព័ររបស់អ្នកផ្តល់សេវាផ្ទាល់បើក។ គ្មាន taf ណាឃើញការចូលរបស់អ្នកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스의 자체 페이지가 열립니다. 어떤 taf도 내 로그인 정보를 볼 수 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໜ້າຂອງຜູ້ໃຫ້ບໍລິການເອງເປີດຂຶ້ນ. ບໍ່ມີ taf ເຫັນການເຂົ້າສູ່ລະບົບຂອງທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsidaro paties teikėjo puslapis. Joks taf nemato jūsų prisijungimo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atveras paša nodrošinātāja lapa. Neviens taf neredz tavu pierakstīšanos."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Се отвора сопствената страница на давателот. Ниеден taf не ја гледа твојата најава."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үйлчилгээ үзүүлэгчийн өөрийн хуудас нээгдэнэ. Ямар ч taf таны нэвтрэлтийг харахгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "विक्रेताको आफ्नै पृष्ठ खुल्छ। कुनै taf ले तपाईंको साइन इन देख्दैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eigen pagina van de leverancier opent. Geen enkel taf ziet je login."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otworzy się strona samego dostawcy. Żaden taf nie widzi Twojego logowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre-se a própria página do fornecedor. Nenhum taf vê o seu início de sessão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A própria página do fornecedor é aberta. Nenhum taf vê o seu login."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se deschide pagina proprie a furnizorului. Niciun taf nu vă vede conectarea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí sa vlastná stránka dodávateľa. Žiadny taf nevidí vaše prihlásenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpre se lastna stran ponudnika. Noben taf ne vidi vaše prijave."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapet faqja e vetë furnizuesit. Asnjë taf nuk e sheh hyrjen tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara se davaočeva vlastita stranica. Nijedan taf ne vidi vašu prijavu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าของผู้ให้บริการเองจะเปิดขึ้น ไม่มี taf ใดเห็นข้อมูลเข้าสู่ระบบของคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Üpjün edijiniň öz sahypasy açylýar. Hiç bir taf girişiňizi görmeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcının kendi sayfası açılır. Hiçbir taf oturum açmanızı görmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وینڈر کا اپنا صفحہ کھلتا ہے۔ کوئی taf آپ کا سائن اِن نہیں دیکھتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang riêng của nhà cung cấp sẽ mở ra. Không taf nào thấy thông tin đăng nhập của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會開啟服務供應商自己的頁面。沒有任何 taf 看得到您的登入資訊。"
          }
        }
      }
    },
