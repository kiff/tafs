        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចូលម្តងទៀតនៅលើទូរសព្ទនេះដើម្បីអនុម័ត ឬអនុម័តពីទូរសព្ទផ្សេងរបស់អ្នក។"
