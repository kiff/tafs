    "attachment.not_taken": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs bu faylı əlavə edə bilmir: o, qəbul etdiyi növdə və ya ölçüdə deyil. Başqasını seçin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs не може да прикачи този файл: типът или размерът му не се приемат. Изберете друг."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs tento soubor nemůže přiložit: takový typ nebo velikost nepřijímá. Vyberte jiný."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs kann diese Datei nicht anhängen: Art oder Größe werden nicht unterstützt. Wähle eine andere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs can't attach this file: it isn't a kind or size it takes. Pick another one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs no puede adjuntar este archivo: no es de un tipo o tamaño que acepte. Elige otro."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ei saa seda faili lisada: see ei ole sobivat tüüpi või suurusega. Vali mõni teine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ne peut pas joindre ce fichier : son type ou sa taille n'est pas accepté. Choisissez-en un autre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ne može priložiti ovu datoteku: nije vrste ili veličine koju prihvaća. Odaberite drugu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafs nem tudja csatolni ezt a fájlt: ilyen típust vagy méretet nem fogad. Válassz másikat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-ը չի կարող կցել այս ֆայլը․ այն այն տեսակի կամ չափի չէ, որ ընդունում է։ Ընտրեք մեկ ուրիշը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs tidak dapat melampirkan file ini: jenis atau ukurannya tidak diterima. Pilih file lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs non può allegare questo file: non è di un tipo o di una dimensione accettati. Scegline un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsはこのファイルを添付できません：対応する種類やサイズではありません。別のファイルを選んでください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ვერ მიამაგრებს ამ ფაილს: ის არ არის სახეობა ან ზომა, რომელსაც იღებს. აირჩიეთ სხვა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs가 이 파일을 첨부할 수 없습니다. 지원하는 종류나 크기가 아닙니다. 다른 파일을 선택하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs negali pridėti šio failo: jo tipas ar dydis netinka. Pasirinkite kitą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nevar pievienot šo failu: tas nav pieņemama veida vai izmēra. Izvēlies citu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs kan dit bestand niet bijvoegen: het soort of de grootte wordt niet ondersteund. Kies een ander bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nie może załączyć tego pliku: ma nieobsługiwany typ lub rozmiar. Wybierz inny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não pode anexar este ficheiro: não é de um tipo ou tamanho aceite. Escolha outro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não pode anexar este arquivo: não é de um tipo ou tamanho aceito. Escolha outro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nu poate atașa acest fișier: nu are un tip sau o dimensiune acceptată. Alegeți altul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs tento súbor nemôže priložiť: taký typ alebo veľkosť neprijíma. Vyberte iný."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs te datoteke ne more priložiti: takšne vrste ali velikosti ne sprejema. Izberite drugo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nuk mund ta bashkëngjitë këtë skedar: nuk është lloj ose madhësi që pranon. Zgjidhni një tjetër."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ne može da priloži ovu datoteku: nije vrsta ili veličina koju prima. Izaberite drugu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs แนบไฟล์นี้ไม่ได้: ชนิดหรือขนาดไม่รองรับ เลือกไฟล์อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs bu dosyayı ekleyemez: kabul ettiği bir tür veya boyutta değil. Başka bir dosya seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs không thể đính kèm tệp này: loại hoặc kích thước của nó không được chấp nhận. Hãy chọn tệp khác."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs 無法附加此檔案：其種類或大小不被接受。請選擇其他檔案。"
          }
        }
      }
    },
