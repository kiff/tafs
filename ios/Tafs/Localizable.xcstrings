    "version.trial.changed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du genehmigen sollst, hat sich geändert, seit es angezeigt wurde. Lies es erneut und starte dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you're asked to approve changed since it was shown. Read it again, then start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se te pide aprobar cambió desde que se mostró. Vuelve a leerlo y luego empieza."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See, mida sul palutakse kinnitada, on pärast näitamist muutunud. Loe see uuesti läbi ja alusta siis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l'on vous demande d'approuver a changé depuis son affichage. Relisez-le, puis commencez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che ti viene chiesto di approvare è cambiato da quando è stato mostrato. Rileggilo, poi inizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認を求められている内容は、表示後に変更されました。もう一度確認してから開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 요청 내용이 표시된 뒤로 바뀌었습니다. 다시 읽고 시작하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai, ką prašoma patvirtinti, pasikeitė nuo tada, kai buvo parodyta. Perskaitykite dar kartą, tada pradėkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas, ko tev lūdz apstiprināt, mainījās, kopš tas tika parādīts. Izlasi to vēlreiz, tad sāc."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je moet goedkeuren, is gewijzigd sinds het werd getoond. Lees het opnieuw en begin dan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co masz zatwierdzić, zmieniło się od chwili pokazania. Przeczytaj to ponownie, a potem zacznij."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que lhe pedem para aprovar mudou desde que foi mostrado. Leia-o novamente e depois comece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que lhe pedem para aprovar mudou desde que foi mostrado. Leia-o novamente e depois comece."
          }
        }
      }
    },
