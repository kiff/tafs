        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Nē” atdod tā Card rezervi atpakaļ. Atbildot prasīs %1$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nee geeft zijn Card de ruimte terug. Antwoorden vraagt om %1$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nie” przywraca zapas jego Card. Odpowiedź wymaga %1$@."
          }
        },
        "pt": {
