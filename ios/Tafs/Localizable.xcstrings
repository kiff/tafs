    "approval.security_key.no_pin_set": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu təhlükəsizlik açarında PIN yoxdur, ona görə təsdiq edə bilmir. Bu kompüterə uyğun olanı qoşun. Sıfırlanıbsa, telefonda təsdiq edin və açarla təsdiq etmək üçün bu kompüteri yenidən cütləşdirin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този ключ за сигурност няма ПИН код, така че не може да одобрява. Включете ключа, който е за този компютър. Ако е бил нулиран, одобрявайте на телефона си и сдвоете този компютър отново, за да одобрявате с ключ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento bezpečnostní klíč nemá PIN, takže nemůže schvalovat. Připojte ten, který patří k tomuto počítači. Pokud byl resetován, schvalte v telefonu a pro schvalování klíčem tento počítač znovu spárujte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Sicherheitsschlüssel hat keine PIN und kann nicht genehmigen. Steck den Schlüssel ein, der zu diesem Computer gehört. Wurde er zurückgesetzt, genehmige auf deinem Telefon und kopple diesen Computer erneut, um mit einem Schlüssel zu genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This security key has no PIN, so it can't approve. Plug in the one that goes with this computer. If it was reset, approve on your phone, and pair this computer again to approve with a key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta llave de seguridad no tiene PIN, así que no puede aprobar. Conecta la que va con este ordenador. Si se restableció, aprueba en tu teléfono y vuelve a vincular este ordenador para aprobar con una llave."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellel turvavõtmel pole PIN-koodi, seega ei saa see kinnitada. Ühenda see, mis kuulub selle arvuti juurde. Kui see lähtestati, kinnita telefonis ja võtmega kinnitamiseks seo see arvuti uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé de sécurité n'a pas de code PIN : elle ne peut pas approuver. Branchez celle liée à cet ordinateur. Si elle a été réinitialisée, approuvez sur votre téléphone, et associez de nouveau cet ordinateur pour approuver avec une clé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj sigurnosni ključ nema PIN pa ne može odobravati. Priključite onaj koji pripada ovom računalu. Ako je resetiran, odobrite na telefonu i ponovno uparite ovo računalo da biste odobravali ključem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a biztonsági kulcsnak nincs PIN-kódja, ezért nem tud jóváhagyni. Csatlakoztasd azt, amelyik ehhez a számítógéphez tartozik. Ha alaphelyzetbe lett állítva, hagyd jóvá a telefonodon, és párosítsd újra ezt a számítógépet, hogy kulccsal hagyhass jóvá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անվտանգության բանալին PIN չունի, ուստի չի կարող հաստատել։ Միացրեք այն, որը համապատասխանում է այս համակարգչին։ Եթե այն վերակայվել է, հաստատեք հեռախոսով և նորից զուգակցեք այս համակարգիչը՝ բանալիով հաստատելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci keamanan ini tidak memiliki PIN, jadi tidak dapat menyetujui. Colokkan yang cocok dengan komputer ini. Jika sudah diatur ulang, setujui di ponsel Anda dan pasangkan komputer ini lagi untuk menyetujui dengan kunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chiave di sicurezza non ha un PIN, quindi non può approvare. Collega quella che va con questo computer. Se è stata ripristinata, approva sul telefono e associa di nuovo questo computer per approvare con una chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセキュリティキーにはPINがないため、承認できません。このコンピュータ用のキーを差し込んでください。リセットした場合は、スマートフォンで承認し、キーで承認するにはこのコンピュータをもう一度ペアリングしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ უსაფრთხოების გასაღებს PIN არ აქვს, ამიტომ დამტკიცება არ შეუძლია. ჩართეთ ის, რომელიც ამ კომპიუტერს შეესაბამება. თუ გადატვირთულია, დაამტკიცეთ ტელეფონზე და ისევ დააწყვილეთ ეს კომპიუტერი გასაღებით დასამტკიცებლად."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보안 키에는 PIN이 없어 승인할 수 없습니다. 이 컴퓨터와 짝을 이룬 키를 꽂으세요. 키를 재설정했다면 휴대폰에서 승인하고, 키로 승인하려면 이 컴퓨터를 다시 페어링하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis saugos raktas neturi PIN, todėl negali tvirtinti. Prijunkite raktą, susietą su šiuo kompiuteriu. Jei jo nustatymai atkurti, tvirtinkite telefone ir iš naujo susiekite šį kompiuterį, kad galėtumėte tvirtinti raktu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šai drošības atslēgai nav PIN, tāpēc tā nevar apstiprināt. Pievieno to, kas pieder šim datoram. Ja tā tika atiestatīta, apstiprini savā tālrunī un vēlreiz savieno šo datoru pārī, lai apstiprinātu ar atslēgu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze beveiligingssleutel heeft geen pincode, dus hij kan niet goedkeuren. Steek de sleutel erin die bij deze computer hoort. Is hij hersteld, keur dan goed op je telefoon en koppel deze computer opnieuw om met een sleutel goed te keuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten klucz bezpieczeństwa nie ma PIN-u, więc nie może zatwierdzać. Podłącz klucz powiązany z tym komputerem. Jeśli został zresetowany, zatwierdź na telefonie i sparuj ten komputer ponownie, aby zatwierdzać kluczem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave de segurança não tem PIN, por isso não pode aprovar. Ligue a que vai com este computador. Se foi reposta, aprove no seu telefone e associe novamente este computador para aprovar com uma chave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave de segurança não tem PIN, por isso não pode aprovar. Conecte a que vai com este computador. Se ela foi redefinida, aprove no seu telefone e associe novamente este computador para aprovar com uma chave."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această cheie de securitate nu are PIN, așa că nu poate aproba. Conectați-o pe cea care merge cu acest computer. Dacă a fost resetată, aprobați pe telefon și asociați din nou acest computer pentru a aproba cu o cheie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento bezpečnostný kľúč nemá PIN, takže nemôže schvaľovať. Pripojte ten, ktorý patrí k tomuto počítaču. Ak bol resetovaný, schváľte v telefóne a na schvaľovanie kľúčom tento počítač znova spárujte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta varnostni ključ nima PIN-a, zato ne more odobravati. Priključite tistega, ki spada k temu računalniku. Če je bil ponastavljen, odobrite v telefonu in za odobravanje s ključem ta računalnik znova seznanite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky çelës sigurie nuk ka PIN, ndaj nuk mund të miratojë. Futni atë që shkon me këtë kompjuter. Nëse është rivendosur, miratoni në telefonin tuaj dhe çiftojeni sërish këtë kompjuter për të miratuar me një çelës."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj sigurnosni ključ nema PIN, pa ne može da odobrava. Priključite onaj koji pripada ovom računaru. Ako je resetovan, odobrite na telefonu i ponovo uparite ovaj računar da biste odobravali ključem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กุญแจความปลอดภัยนี้ไม่มี PIN จึงอนุมัติไม่ได้ เสียบกุญแจที่ใช้คู่กับคอมพิวเตอร์เครื่องนี้ หากถูกรีเซ็ต ให้อนุมัติบนโทรศัพท์ของคุณ และจับคู่คอมพิวเตอร์เครื่องนี้ใหม่เพื่ออนุมัติด้วยกุญแจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu güvenlik anahtarının PIN'i yok, bu yüzden onay veremez. Bu bilgisayara ait olanı takın. Sıfırlandıysa telefonunuzdan onaylayın ve anahtarla onaylamak için bu bilgisayarı yeniden eşleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa bảo mật này chưa có PIN nên không thể phê duyệt. Hãy cắm khóa đi cùng máy tính này. Nếu nó đã bị đặt lại, hãy phê duyệt trên điện thoại và ghép đôi lại máy tính này để phê duyệt bằng khóa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這把安全金鑰沒有 PIN，因此無法核准。請插入與這部電腦搭配的那一把。若它曾被重設，請在您的手機上核准，並重新配對這部電腦，以便用金鑰核准。"
          }
        }
      }
    },
    "approval.security_key.not_allowed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təhlükəsizlik açarı buna icazə vermədi, ona görə heç nə təsdiqlənmədi. Sorğu saxlanılıb: hazır olanda yenidən təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът за сигурност не го разреши, така че нищо не беше одобрено. Заявката се запазва: одобрете отново, когато сте готови."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostní klíč to nedovolil, takže se nic neschválilo. Žádost zůstává: schvalte znovu, až budete připraveni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sicherheitsschlüssel hat es nicht zugelassen, also wurde nichts genehmigt. Die Anfrage bleibt erhalten: Genehmige erneut, wenn du so weit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The security key didn't allow it, so nothing was approved. The request is kept: approve again when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llave de seguridad no lo permitió, así que no se aprobó nada. La solicitud se conserva: vuelve a aprobar cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Turvavõti ei lubanud seda, seega midagi ei kinnitatud. Päring jääb alles: kinnita uuesti, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de sécurité ne l'a pas autorisé : rien n'a été approuvé. La demande est conservée : approuvez à nouveau quand vous êtes prêt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosni ključ to nije dopustio pa ništa nije odobreno. Zahtjev je sačuvan: odobrite ponovno kad budete spremni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biztonsági kulcs nem engedélyezte, így semmi sem lett jóváhagyva. A kérés megmarad: hagyd jóvá újra, ha készen állsz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անվտանգության բանալին դա չթույլատրեց, ուստի ոչինչ չհաստատվեց։ Հարցումը պահպանվել է․ հաստատեք նորից, երբ պատրաստ լինեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci keamanan tidak mengizinkannya, jadi tidak ada yang disetujui. Permintaan tetap disimpan: setujui lagi saat Anda siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di sicurezza non l'ha consentito, quindi non è stato approvato nulla. La richiesta resta: approva di nuovo quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティキーが許可しなかったため、何も承認されていません。リクエストは保持されています。準備ができたらもう一度承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უსაფრთხოების გასაღებმა ეს არ დაუშვა, ამიტომ არაფერი დამტკიცებულა. მოთხოვნა შენახულია: დაამტკიცეთ ხელახლა, როცა მზად იქნებით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 키가 허용하지 않아 승인된 것은 없습니다. 요청은 남아 있으니 준비되면 다시 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saugos raktas to neleido, todėl niekas nepatvirtinta. Užklausa išsaugota: patvirtinkite dar kartą, kai būsite pasirengę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drošības atslēga to neatļāva, tāpēc nekas netika apstiprināts. Pieprasījums ir saglabāts: apstiprini vēlreiz, kad esi gatavs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beveiligingssleutel stond het niet toe, dus er is niets goedgekeurd. Het verzoek blijft bewaard: keur het goed wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz bezpieczeństwa na to nie pozwolił, więc nic nie zostało zatwierdzone. Prośba zostaje zachowana: zatwierdź ją ponownie, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança não o permitiu, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança não o permitiu, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia de securitate nu a permis, așa că nu s-a aprobat nimic. Solicitarea se păstrează: aprobați din nou când sunteți gata."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostný kľúč to nedovolil, takže sa nič neschválilo. Žiadosť zostáva: schváľte znova, keď budete pripravení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Varnostni ključ tega ni dovolil, zato ni bilo nič odobreno. Zahteva ostane: odobrite znova, ko boste pripravljeni."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çelësi i sigurisë nuk e lejoi, ndaj asgjë nuk u miratua. Kërkesa ruhet: miratoni sërish kur të jeni gati."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosni ključ to nije dozvolio, pa ništa nije odobreno. Zahtev je sačuvan: odobrite ponovo kad budete spremni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กุญแจความปลอดภัยไม่อนุญาต จึงไม่มีอะไรถูกอนุมัติ คำขอยังอยู่: อนุมัติอีกครั้งเมื่อคุณพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik anahtarı buna izin vermedi, bu yüzden hiçbir şey onaylanmadı. İstek korunuyor: hazır olduğunuzda tekrar onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa bảo mật không cho phép nên không có gì được phê duyệt. Yêu cầu vẫn được giữ: hãy phê duyệt lại khi bạn sẵn sàng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全金鑰未允許，因此未核准任何項目。請求仍保留：準備好時再次核准。"
          }
        }
      }
