        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei vastanud Coachi tööriistade kohta. Proovi hetke pärast uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas répondu au sujet des outils de Coach. Réessayez dans un instant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF לא השיב לגבי הכלים של Coach. יש לנסות שוב בעוד רגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ने Coach के टूल के बारे में उत्तर नहीं दिया। थोड़ी देर में फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nije odgovorio o Coachovim alatima. Pokušajte ponovno za trenutak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF nem válaszolt a Coach eszközeiről. Próbáld újra egy pillanat múlva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը Coach-ի գործիքների մասին չպատասխանեց։ Փորձեք մի պահ անց։"
