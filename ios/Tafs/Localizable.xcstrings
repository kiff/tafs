    "watch.ask_needs_consent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل أن تسأل tafs، اسمح باستخدام الذكاء الاصطناعي في tafs على هاتفك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-dan soruşmazdan əvvəl telefonunuzda tafs-da süni intellektin istifadəsinə icazə verin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преди да питате tafs, разрешете използването на ИИ в tafs на телефона си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-কে জিজ্ঞেস করার আগে আপনার ফোনে tafs-এ AI ব্যবহারের অনুমতি দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Abans de preguntar a tafs, permet l'ús de la IA a tafs al telèfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než se zeptáte tafs, povolte v tafs v telefonu používání AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du tafs fragst, erlaube die KI-Nutzung in tafs auf deinem Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you ask tafs, allow AI use in tafs on your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de pedir algo a tafs, permite el uso de IA en tafs en tu teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Enne tafsilt küsimist luba telefonis tafsis tehisintellekti (AI) kasutamine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de demander à tafs, autorisez l'IA dans tafs sur votre téléphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפני ששואלים את tafs, יש לאפשר בטלפון שימוש ב-AI ב-tafs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs से पूछने से पहले, अपने फ़ोन पर tafs में AI के उपयोग की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prije nego što pitate tafs, dopustite upotrebu AI-ja u tafsu na telefonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mielőtt a tafst kérdezed, engedélyezd az MI használatát a tafsben a telefonodon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախքան tafs-ին հարցնելը, ձեր հեռախոսում tafs-ում թույլատրեք AI-ի օգտագործումը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelum bertanya ke tafs, izinkan penggunaan AI di tafs pada ponsel Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di chiedere a tafs, consenti l'uso dell'IA in tafs sul telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsに質問する前に、スマートフォンのtafsでAIの使用を許可してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სანამ tafs-ს ჰკითხავთ, თქვენს ტელეფონზე tafs-ში ჩართეთ AI-ის გამოყენება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មុនពេលសួរ tafs សូមអនុញ្ញាតការប្រើ AI ក្នុង tafs នៅលើទូរសព្ទរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs에 묻기 전에 휴대폰의 tafs에서 AI 사용을 허용하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກ່ອນຖາມ tafs ໃຫ້ອະນຸຍາດການໃຊ້ AI ໃນ tafs ໃນໂທລະສັບຂອງທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš klausdami tafs, telefone leiskite tafs naudoti AI."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms jautā tafs, atļauj AI lietošanu tafs savā tālrunī."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
