        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leisti %1$@ skaityti, kas rašoma: %2$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ļaut %1$@ lasīt to, kas rakstīts: %2$@"
