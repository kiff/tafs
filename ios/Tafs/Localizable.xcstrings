          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach toca, escribe y se desplaza en esta app mientras miras. Nunca confirma nada. Toca la app o toca Detener para recuperar el control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach touche, écrit et fait défiler dans cette app sous vos yeux. Il ne confirme jamais rien. Touchez l'app ou touchez Arrêter pour reprendre la main."
