    "approval.security_key.add_enter_pin": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die PIN deines Sicherheitsschlüssels ein, um ihn hinzuzufügen. tafs fragt jedes Mal danach und speichert sie nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your security key's PIN to add it. tafs asks for it each time and never stores it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el PIN de tu llave de seguridad para añadirla. tafs lo pide cada vez y nunca lo guarda."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Turvavõtme lisamiseks sisesta selle PIN-kood. tafs küsib seda iga kord ega salvesta seda kunagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code PIN de votre clé de sécurité pour l'ajouter. tafs le demande à chaque fois et ne l'enregistre jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il PIN della tua chiave di sicurezza per aggiungerla. tafs lo chiede ogni volta e non lo salva mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加するにはセキュリティキーのPINを入力してください。tafsは毎回PINを求め、保存することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가하려면 보안 키의 PIN을 입력하세요. tafs는 매번 PIN을 묻고 저장하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite saugos rakto PIN, kad jį pridėtumėte. tafs jo prašo kaskart ir niekada jo nesaugo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadi savas drošības atslēgas PIN, lai to pievienotu. tafs to prasa katru reizi un nekad neglabā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de pincode van je beveiligingssleutel in om hem toe te voegen. tafs vraagt er elke keer om en bewaart hem nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz PIN swojego klucza bezpieczeństwa, aby go dodać. tafs pyta o niego za każdym razem i nigdy go nie zapisuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza o PIN da sua chave de segurança para a adicionar. O tafs pede-o sempre e nunca o guarda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o PIN da sua chave de segurança para adicioná-la. O tafs pede o PIN sempre e nunca o guarda."
          }
        }
      }
    },
