    "settings.delete_account.kiff_not_deleted": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-larınız və qoşulmalarınız silindi, amma KIFF hesabı silmədi. %1$@"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите tafs и връзки са изтрити, но KIFF не изтри акаунта. %1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy a připojení jsou vymazané, ale KIFF účet nesmazal. %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs und Verbindungen sind gelöscht, aber KIFF hat das Konto nicht gelöscht. %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tafs and connections are erased, but KIFF didn't delete the account. %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tafs y conexiones se borraron, pero KIFF no eliminó la cuenta. %1$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tafid ja ühendused on kustutatud, kuid KIFF ei kustutanud kontot. %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tafs et vos connexions sont effacés, mais KIFF n'a pas supprimé le compte. %1$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafovi i veze su izbrisani, ali KIFF nije izbrisao račun. %1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafjaid és kapcsolataid törölve, de a KIFF nem törölte a fiókot. %1$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր taf-երն ու կապերը ջնջվեցին, բայց KIFF-ը չջնջեց հաշիվը։ %1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs dan koneksi Anda dihapus, tetapi KIFF tidak menghapus akunnya. %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tafs e collegamenti sono cancellati, ma KIFF non ha eliminato l'account. %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsと接続は消去されましたが、KIFFはアカウントを削除しませんでした。%1$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი taf-ები და კავშირები წაიშალა, მაგრამ KIFF-მა ანგარიში არ წაშალა. %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs와 연결은 삭제되었지만 KIFF가 계정을 삭제하지 않았습니다. %1$@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų taf ir ryšiai ištrinti, bet KIFF neištrynė paskyros. %1$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavi taf un savienojumi ir izdzēsti, bet KIFF neizdzēsa kontu. %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tafs en koppelingen zijn gewist, maar KIFF heeft het account niet verwijderd. %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje tafs i połączenia zostały usunięte, ale KIFF nie usunął konta. %1$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs e ligações foram apagados, mas o KIFF não eliminou a conta. %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs e conexões foram apagados, mas o KIFF não excluiu a conta. %1$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafurile și conexiunile dvs. sunt șterse, dar KIFF nu a șters contul. %1$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy a pripojenia sú vymazané, ale KIFF účet neodstránil. %1$@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafi in povezave so izbrisani, KIFF pa računa ni izbrisal. %1$@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs-et dhe lidhjet tuaja u fshinë, por KIFF nuk e fshiu llogarinë. %1$@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafovi i veze su izbrisani, ali KIFF nije izbrisao nalog. %1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
