        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը կանգ առավ․ այս առաջադրանքը մեկ առաջադրանքի համար սահմանված սահմանաչափից ավելի քայլեր պահանջեց։ Խնդրեք ավելի նեղ բան։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ berhenti: tugas ini memakan lebih banyak langkah daripada batasnya untuk satu tugas. Minta sesuatu yang lebih sempit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si è fermato: questa attività ha richiesto più passi del suo limite per un'attività. Chiedi qualcosa di più circoscritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が停止しました：このタスクは1タスクあたりの手順の上限を超えました。範囲を絞って依頼してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ გაჩერდა: ამ ამოცანამ ერთი ამოცანისთვის დადგენილ ლიმიტზე მეტი ნაბიჯი მოითხოვა. მოითხოვეთ რაიმე უფრო ვიწრო."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 멈췄습니다: 이 작업은 작업 1건 한도보다 단계가 많았습니다. 범위를 좁혀 요청하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sustojo: šiai užduočiai prireikė daugiau žingsnių nei leidžia limitas vienai užduočiai. Paprašykite ko nors siauresnio."
