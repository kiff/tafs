    "version.card_note.issues": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء التبديل لا يعمل الـ taf لديك. التأكيد مرة واحدة يصدر هذه الـ Cards في KIFF، ثم تصبح هذه النسخة فعّالة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Keçid zamanı taf-ınız işləmir. Bir dəfə təsdiq etmək bu Card-ları KIFF-də verir, sonra bu versiya işə düşür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докато превключва, вашият taf не работи. Едно потвърждение издава тези Cards в KIFF и после тази версия става активна."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বদলানোর সময় আপনার taf চলে না। একবার নিশ্চিত করলে KIFF-এ এই Card দেওয়া হয়, তারপর এই সংস্করণ চালু হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre canvia, el teu taf no s'executa. Confirmar una vegada emet aquests Card a KIFF, i després aquesta versió entra en producció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během přepnutí váš taf neběží. Jedno potvrzení vydá tyto Card v KIFF a pak se tato verze aktivuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während des Wechsels läuft dein taf nicht. Eine Bestätigung stellt diese Cards in KIFF aus, dann geht diese Version live."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While it switches, your taf doesn't run. Confirming once issues these Cards in KIFF, then this version goes live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras cambia, tu taf no se ejecuta. Al confirmar una vez se emiten estas Cards en KIFF y luego esta versión se activa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahetuse ajal sinu taf ei tööta. Üks kinnitus väljastab need Cardid KIFFis, siis võetakse see versioon kasutusele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le changement, votre taf ne s'exécute pas. Une seule confirmation émet ces Cards dans KIFF, puis cette version est mise en service."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בזמן המעבר ה-taf שלך לא רץ. אישור חד-פעמי מנפיק את ה-Card האלה ב-KIFF, ואז הגרסה הזו נהיית פעילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बदलते समय आपका taf नहीं चलता। एक बार पुष्टि करने से ये Card KIFF में जारी होते हैं, फिर यह संस्करण चालू हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok se prebacuje, vaš taf ne radi. Potvrda jednom izdaje ove Cardove u KIFF-u, zatim ova verzija ide u rad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg átvált, a tafod nem fut. Egyetlen megerősítés kiadja ezeket a Cardokat a KIFF-ben, majd ez a verzió élesedik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխարկման ընթացքում ձեր taf-ը չի աշխատում։ Մեկ անգամ հաստատելը թողարկում է այս Card-երը KIFF-ում, ապա այս տարբերակը դառնում է ակտիվ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama peralihan, taf Anda tidak berjalan. Mengonfirmasi sekali menerbitkan Card ini di KIFF, lalu versi ini aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante il passaggio, il tuo taf non lavora. Una sola conferma emette queste Card in KIFF, poi questa versione diventa attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替え中、tafは動きません。一度確認するとKIFFでこれらのCardが発行され、このバージョンが適用されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადართვისას თქვენი taf არ მუშაობს. ერთხელ დადასტურება ამ Card-ებს KIFF-ში გასცემს, შემდეგ ეს ვერსია აქტიური ხდება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពេលវាផ្លាស់ប្តូរ taf របស់អ្នកមិនដំណើរការទេ។ ការបញ្ជាក់ម្តងចេញ Card ទាំងនេះក្នុង KIFF បន្ទាប់មកកំណែនេះចាប់ផ្តើមដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환하는 동안 taf는 실행되지 않습니다. 한 번 확인하면 KIFF에서 이 Card들을 발급한 뒤 이 버전이 적용됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃນຂະນະທີ່ປ່ຽນ taf ຂອງທ່ານບໍ່ເຮັດວຽກ. ການຢືນຢັນຄັ້ງດຽວອອກ Card ເຫຼົ່ານີ້ໃນ KIFF ແລ້ວເວີຊັນນີ້ເລີ່ມໃຊ້ງານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kol vyksta perjungimas, jūsų taf neveikia. Vienas patvirtinimas išduoda šias Card KIFF, tada ši versija tampa aktyvi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamēr notiek pārslēgšana, tavs taf nedarbojas. Vienreizējs apstiprinājums izsniedz šīs Card KIFF, pēc tam šī versija tiek laista darbā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додека се префрла, твојот taf не работи. Потврдата еднаш ги издава овие Card во KIFF, па оваа верзија станува активна."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шилжиж байх үед таны taf ажиллахгүй. Нэг удаа баталгаажуулбал эдгээр Card-ыг KIFF дээр олгож, дараа нь энэ хувилбар идэвхжинэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "स्विच हुँदा तपाईंको taf चल्दैन। एकपटक पुष्टि गर्दा यी Card KIFF मा जारी हुन्छन्, त्यसपछि यो संस्करण सक्रिय हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens het overschakelen draait je taf niet. Eén keer bevestigen geeft deze Cards uit in KIFF, daarna gaat deze versie live."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas przełączania Twój taf nie działa. Jedno potwierdzenie wydaje te Card w KIFF, a potem ta wersja zaczyna działać na żywo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a mudança, o seu taf não é executado. Confirmar uma vez emite estes Cards no KIFF, e depois esta versão entra em produção."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a mudança, o seu taf não é executado. Confirmar uma vez emite estes Cards no KIFF, e depois esta versão entra em produção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât timp se face trecerea, taful nu rulează. O singură confirmare emite aceste Carduri în KIFF, apoi această versiune devine activă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas prepnutia váš taf nebeží. Jedno potvrdenie vydá tieto Card v KIFF a potom sa táto verzia aktivuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med preklopom vaš taf ne teče. Ena potrditev izda te Card v KIFF, nato ta različica postane aktivna."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndërsa ndërron, taf-i juaj nuk ekzekutohet. Konfirmimi një herë i lëshon këta Card në KIFF, pastaj ky version bëhet aktiv."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok se prebacuje, vaš taf ne radi. Potvrda jednom izdaje ove Cardove u KIFF-u, zatim ova verzija ide u rad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างการสลับ taf ของคุณจะไม่ทำงาน การยืนยันครั้งเดียวจะออก Card เหล่านี้ใน KIFF แล้วเวอร์ชันนี้จะเริ่มใช้งาน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ol çalşylýarka taf-yňyz işlemeýär. Bir gezek tassyklamak bu Card-lary KIFF-de berýär, soňra bu wersiýa işjeň bolýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçiş sırasında taf'ınız çalışmaz. Bir kez onaylamak bu Card'ları KIFF'te verir, sonra bu sürüm yayına girer."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بدلتے وقت آپ کا taf نہیں چلتا۔ ایک بار تصدیق KIFF میں یہ Cards جاری کرتی ہے، پھر یہ ورژن لائیو ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong lúc chuyển đổi, taf của bạn không chạy. Một lần xác nhận sẽ cấp các Card này trong KIFF, rồi phiên bản này đi vào hoạt động."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換期間，您的 taf 不會執行。確認一次會在 KIFF 中發出這些 Card，然後此版本即生效。"
          }
        }
      }
    },
    "version.card_note.issues_biometry": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء التبديل لا يعمل الـ taf لديك. التأكيد بـ %1$@ مرة واحدة يصدر هذه الـ Cards في KIFF، ثم تصبح هذه النسخة فعّالة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Keçid zamanı taf-ınız işləmir. %1$@ ilə bir dəfə təsdiq etmək bu Card-ları KIFF-də verir, sonra bu versiya işə düşür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докато превключва, вашият taf не работи. Едно потвърждение с %1$@ издава тези Cards в KIFF и после тази версия става активна."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বদলানোর সময় আপনার taf চলে না। %1$@ দিয়ে একবার নিশ্চিত করলে KIFF-এ এই Card দেওয়া হয়, তারপর এই সংস্করণ চালু হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre canvia, el teu taf no s'executa. Confirmar amb %1$@ una vegada emet aquests Card a KIFF, i després aquesta versió entra en producció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během přepnutí váš taf neběží. Jedno potvrzení přes %1$@ vydá tyto Card v KIFF a pak se tato verze aktivuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während des Wechsels läuft dein taf nicht. Eine Bestätigung mit %1$@ stellt diese Cards in KIFF aus, dann geht diese Version live."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While it switches, your taf doesn't run. Confirming with %1$@ once issues these Cards in KIFF, then this version goes live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras cambia, tu taf no se ejecuta. Al confirmar una vez con %1$@ se emiten estas Cards en KIFF y luego esta versión se activa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahetuse ajal sinu taf ei tööta. Üks kinnitus %1$@ abil väljastab need Cardid KIFFis, siis võetakse see versioon kasutusele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le changement, votre taf ne s'exécute pas. Une seule confirmation avec %1$@ émet ces Cards dans KIFF, puis cette version est mise en service."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בזמן המעבר ה-taf שלך לא רץ. אישור חד-פעמי באמצעות %1$@ מנפיק את ה-Card האלה ב-KIFF, ואז הגרסה הזו נהיית פעילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बदलते समय आपका taf नहीं चलता। %1$@ से एक बार पुष्टि करने से ये Card KIFF में जारी होते हैं, फिर यह संस्करण चालू हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok se prebacuje, vaš taf ne radi. Potvrda (%1$@) jednom izdaje ove Cardove u KIFF-u, zatim ova verzija ide u rad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg átvált, a tafod nem fut. Egyetlen megerősítés ezzel (%1$@) kiadja ezeket a Cardokat a KIFF-ben, majd ez a verzió élesedik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխարկման ընթացքում ձեր taf-ը չի աշխատում։ Մեկ անգամ հաստատելը (%1$@) թողարկում է այս Card-երը KIFF-ում, ապա այս տարբերակը դառնում է ակտիվ։"
          }
