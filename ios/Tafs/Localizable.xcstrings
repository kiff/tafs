    "sample.memory.ask_first": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeyri-adi hər şeydən əvvəl, Card-a uyğun olsa belə, soruşun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Питай, преди да направиш нещо необичайно, дори ако се вписва в Card."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptat se před čímkoli neobvyklým, i když to odpovídá Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor allem Ungewöhnlichen fragen, auch wenn es zur Card passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask before anything unusual, even when it fits the Card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta antes de cualquier cosa inusual, aunque encaje en la Card."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Küsi enne kõike ebatavalist, isegi kui see mahub Cardi piiresse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander avant toute chose inhabituelle, même si cela entre dans la Card."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitajte prije svega neobičnog, čak i kad odgovara Cardu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérdezz, mielőtt bármi szokatlant tennél, akkor is, ha belefér a Cardba."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հարցրեք ցանկացած անսովոր բանից առաջ, նույնիսկ երբ այն համապատասխանում է Card-ին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bertanya sebelum hal yang tidak biasa, bahkan saat sesuai Card."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi prima di qualsiasi cosa insolita, anche quando rientra nella Card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardに合っていても、いつもと違うことは先に確認します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იკითხე ნებისმიერ უჩვეულოზე ადრე, Card-ს რომ შეესაბამებოდეს, მაშინაც."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Card에 맞더라도 평소와 다른 일은 먼저 물어봅니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Klausti prieš bet ką neįprasta, net jei tai atitinka Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jautāt pirms jebkā neparasta, pat ja tas atbilst Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag het eerst bij alles wat ongewoon is, ook als het binnen de Card past."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytaj przed wszystkim, co nietypowe, nawet jeśli mieści się w Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar antes de qualquer coisa invulgar, mesmo quando cabe no Card."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar antes de qualquer coisa invulgar, mesmo quando cabe no Card."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întreabă înainte de orice neobișnuit, chiar dacă se încadrează în Card."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opýtať sa pred čímkoľvek nezvyčajným, aj keď to zodpovedá Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vprašaj pred čimer koli nenavadnim, tudi ko ustreza Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyet para çdo gjëje të pazakontë, edhe kur përshtatet me Card-in."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitajte pre svega neobičnog, čak i kad odgovara Cardu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามก่อนทำสิ่งผิดปกติ แม้จะอยู่ใน Card"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Card'a uysa bile olağandışı her şeyden önce sor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi trước mọi việc bất thường, kể cả khi nó nằm trong Card."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到任何不尋常的事，即使符合 Card，也要先詢問。"
          }
        }
      }
    },
    "sample.memory.explain": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qərarı paraqrafla yox, bir cümlə ilə izah etməyimi üstün tutursunuz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпочитате да обяснявам решение с един ред, а не с абзац."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Raději vysvětlím rozhodnutí jedním řádkem než odstavcem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du möchtest Entscheidungen lieber in einer Zeile erklärt bekommen als in einem Absatz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'd rather I explain a decision in one line than in a paragraph."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefieres que explique una decisión en una línea antes que en un párrafo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eelistad, et selgitan otsust ühe rea, mitte lõiguga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous préférez que j'explique une décision en une ligne plutôt qu'en un paragraphe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radije da odluku objasnim u jednom retku nego u odlomku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkább egy sorban magyarázzam el a döntéseimet, mint egy bekezdésben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախընտրում եք, որ որոշումը բացատրեմ մեկ տողով, ոչ թե պարբերությամբ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda lebih suka saya menjelaskan keputusan dalam satu baris, bukan satu paragraf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferisci che spieghi una decisione in una riga piuttosto che in un paragrafo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判断の説明は段落より1行がよいとのことです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მირჩევნია ერთ ხაზში განმარტო გადაწყვეტილება და არა აბზაცში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결정은 한 문단보다 한 줄로 설명하는 것을 선호합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jums labiau patinka, kai sprendimą paaiškinu viena eilute, o ne pastraipa."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dod priekšroku tam, lai lēmumu izskaidroju vienā rindā, nevis rindkopā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wilt liever dat ik een beslissing in één regel uitleg dan in een alinea."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolisz, żebym wyjaśniał decyzję w jednym zdaniu, a nie w akapicie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefere que explique uma decisão numa linha em vez de num parágrafo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefere que explique uma decisão em uma linha em vez de em um parágrafo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferați să explic o decizie într-un rând, nu într-un paragraf."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Radšej vysvetlím rozhodnutie jedným riadkom než odsekom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raje razložim odločitev v eni vrstici kot v odstavku."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferoni që ta shpjegoj një vendim me një rresht dhe jo me një paragraf."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Radije da odluku objasnim u jednom retku nego u odlomku."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยากให้ฉันอธิบายการตัดสินใจในบรรทัดเดียวมากกว่าทั้งย่อหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kararı paragrafla değil, tek satırda açıklamamı tercih edersiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn tôi giải thích một quyết định trong một dòng thay vì một đoạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您希望我用一行話解釋決定，而不是一整段。"
          }
        }
      }
    },
    "sample.memory.regulars": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər həftə yazan müştərilər eyni səhər cavab alır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Клиентите, които пишат всяка седмица, получават отговор същата сутрин."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zákazníci, kteří píšou každý týden, dostanou odpověď ještě to ráno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunden, die jede Woche schreiben, bekommen am selben Morgen eine Antwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customers who write every week get a reply the same morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clientes que escriben cada semana reciben respuesta esa misma mañana."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliendid, kes kirjutavad iga nädal, saavad vastuse samal hommikul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clients qui écrivent chaque semaine reçoivent une réponse le matin même."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupci koji pišu svaki tjedan dobivaju odgovor isto jutro."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hetente író vásárlók még aznap délelőtt választ kapnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաճախորդները, ովքեր ամեն շաբաթ գրում են, պատասխան են ստանում նույն առավոտ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelanggan yang menulis setiap minggu mendapat balasan di pagi yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I clienti che scrivono ogni settimana ricevono una risposta la mattina stessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎週連絡をくれる顧客には、同じ日の朝に返信します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კლიენტები, რომლებიც ყოველკვირეულად წერენ, პასუხს იმავე დილით იღებენ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매주 연락하는 고객에게는 같은 날 아침에 답장합니다."
