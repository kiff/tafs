    "voice.speech_recognition_off_tafs_turn": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitq tanıma tafs üçün söndürülüb. Onu Parametrlər › Məxfilik və təhlükəsizlik › Nitq tanıma bölməsində aktiv edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разпознаването на реч е изключено за tafs. Включете го в Настройки › Поверителност и сигурност › Разпознаване на реч."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávání řeči je pro tafs vypnuté. Zapněte ho v Nastavení › Soukromí a zabezpečení › Rozpoznávání řeči."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung ist für tafs ausgeschaltet. Schalte sie unter Einstellungen › Datenschutz & Sicherheit › Spracherkennung ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is off for tafs. Turn it on in Settings › Privacy & Security › Speech Recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz está desactivado para tafs. Actívalo en Ajustes › Privacidad y seguridad › Reconocimiento de voz."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõnetuvastus on tafsi jaoks välja lülitatud. Lülita see sisse menüüs Settings › Privacy & Security › Speech Recognition."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est désactivée pour tafs. Activez-la dans Réglages › Confidentialité et sécurité › Reconnaissance vocale."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje govora je isključeno za tafs. Uključite ga u Postavke › Privatnost i sigurnost › Prepoznavanje govora."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszédfelismerés ki van kapcsolva a tafs számára. Kapcsold be itt: Beállítások › Adatvédelem és biztonság › Beszédfelismerés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խոսքի ճանաչումը անջատված է tafs-ի համար։ Միացրեք՝ Կարգավորումներ › Գաղտնիություն և անվտանգություն › Խոսքի ճանաչում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengenalan ucapan nonaktif untuk tafs. Aktifkan di Pengaturan › Privasi & Keamanan › Pengenalan Ucapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale è disattivato per tafs. Attivalo in Impostazioni › Privacy e sicurezza › Riconoscimento vocale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsの音声認識がオフになっています。設定 › プライバシーとセキュリティ › 音声認識でオンにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მეტყველების ამოცნობა გამორთულია tafs-ისთვის. ჩართეთ პარამეტრები › კონფიდენციალურობა და უსაფრთხოება › მეტყველების ამოცნობა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs의 음성 인식이 꺼져 있습니다. 설정 › 개인정보 보호 및 보안 › 음성 인식에서 켜세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalbos atpažinimas programėlei tafs išjungtas. Įjunkite jį skiltyje Nustatymai › Privatumas ir sauga › Kalbos atpažinimas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Runas atpazīšana lietotnei tafs ir izslēgta. Ieslēdz to sadaļā Iestatījumi › Privātums un drošība › Runas atpazīšana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraakherkenning staat uit voor tafs. Zet het aan in Instellingen › Privacy en beveiliging › Spraakherkenning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie mowy jest wyłączone dla tafs. Włącz je w Ustawienia › Prywatność i ochrona › Rozpoznawanie mowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está desativado para o tafs. Ative-o em Definições › Privacidade e segurança › Reconhecimento de fala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está desativado para o tafs. Ative-o em Ajustes › Privacidade e Segurança › Reconhecimento de Fala."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recunoașterea vorbirii este dezactivată pentru tafs. Activați-o în Configurări › Confidențialitate și securitate › Recunoaștere vorbire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávanie reči je pre tafs vypnuté. Zapnite ho v Nastaveniach › Súkromie a bezpečnosť › Rozpoznávanie reči."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje govora je za tafs izklopljeno. Vklopite ga v Nastavitve › Zasebnost in varnost › Prepoznavanje govora."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Njohja e të folurit është joaktive për tafs. Aktivizojeni te Cilësimet › Privatësia dhe Siguria › Njohja e të folurit."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje govora je isključeno za tafs. Uključite ga u Podešavanja › Privatnost i sigurnost › Prepoznavanje govora."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรู้จำเสียงพูดปิดอยู่สำหรับ tafs เปิดได้ที่การตั้งค่า › ความเป็นส่วนตัวและความปลอดภัย › การรู้จำเสียงพูด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma tanıma, tafs için kapalı. Ayarlar › Gizlilik ve Güvenlik › Konuşma Tanıma'dan açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận dạng giọng nói đang tắt đối với tafs. Hãy bật trong Cài đặt › Quyền riêng tư & Bảo mật › Nhận dạng giọng nói."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音辨識已對 tafs 關閉。請在「設定」›「隱私權與安全性」›「語音辨識」中開啟。"
          }
        }
      }
    },
