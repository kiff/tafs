          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tafs sont effacés, mais pas encore vos connexions. %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tafs sono cancellati, ma i tuoi collegamenti non ancora. %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tafs zijn gewist, maar je koppelingen nog niet. %1$@"
          }
        },
        "pl": {
