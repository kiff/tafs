    "chat.held": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتظر حتى ينتهي، ثم يُرسل كرسالتك التالية"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İş bitənə qədər gözləyir, sonra növbəti mesajınız kimi gedir"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изчаква да приключи, след това заминава като следващото ви съобщение"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজ শেষ হওয়া পর্যন্ত অপেক্ষা করে, তারপর আপনার পরবর্তী বার্তা হিসেবে যায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera fins que acabi i després surt com el teu missatge següent"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počká, až skončí, a pak odejde jako vaše další zpráva"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet, bis er fertig ist, und geht dann als deine nächste Nachricht raus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waits until it's done, then goes as your next message"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine y luego va como tu próximo mensaje"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ootab, kuni see on valmis, siis läheb sinu järgmise sõnumina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attend la fin, puis part comme votre prochain message"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממתין עד שיסיים, ואז יישלח כהודעה הבאה שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पूरा होने तक इंतज़ार करता है, फिर आपके अगले संदेश के रूप में जाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeka dok ne završi, zatim ide kao vaša sljedeća poruka"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megvárja, amíg végez, aztán a következő üzeneteként megy el"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սպասում է, մինչև ավարտվի, ապա գնում է որպես ձեր հաջորդ հաղորդագրությունը"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu sampai selesai, lalu dikirim sebagai pesan Anda berikutnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspetta che abbia finito, poi parte come tuo prossimo messaggio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了を待って、次のメッセージとして送信します"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ელოდება, სანამ დასრულდება, შემდეგ იგზავნება როგორც თქვენი შემდეგი შეტყობინება"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រង់ចាំរហូតដល់វាចប់ រួចទៅជាសារបន្ទាប់របស់អ្នក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 끝날 때까지 기다렸다가 다음 메시지로 보냅니다"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລໍຈົນມັນເຮັດແລ້ວ ແລ້ວສົ່ງເປັນຂໍ້ຄວາມຕໍ່ໄປຂອງທ່ານ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauks, kol bus baigta, tada bus išsiųsta kaip kita jūsų žinutė"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaida, līdz darbs ir pabeigts, tad tiek nosūtīts kā tava nākamā ziņa"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чека додека не заврши, па оди како твојата следна порака"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуустал хүлээгээд, дараагийн мессеж болж явна"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सकिएपछि मात्र तपाईंको अर्को सन्देशका रूपमा जान्छ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot het klaar is en gaat dan als je volgende bericht"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczeka, aż skończy, i pójdzie jako Twoja następna wiadomość"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarda até terminar e depois segue como a sua próxima mensagem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarda até terminar e depois segue como a sua próxima mensagem"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Așteaptă să termine, apoi pleacă drept următorul dvs. mesaj"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počká, kým skončí, a potom odíde ako vaša ďalšia správa"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Počaka, da konča, nato gre kot vaše naslednje sporočilo"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pret derisa të mbarojë, pastaj shkon si mesazhi juaj tjetër"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeka dok ne završi, zatim ide kao vaša sledeća poruka"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอจนกว่ามันจะเสร็จ แล้วส่งเป็นข้อความถัดไปของคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ol gutarýança garaşýar, soňra indiki habaryňyz hökmünde gidýär"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitene kadar bekler, sonra bir sonraki mesajınız olarak gider"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ مکمل ہونے تک انتظار کرتا ہے، پھر آپ کے اگلے پیغام کے طور پر جاتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chờ đến khi nó xong, rồi gửi như tin nhắn tiếp theo của bạn"
