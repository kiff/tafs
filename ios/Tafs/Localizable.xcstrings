    "billing.another_account": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alış bu Google hesabındakı başqa tafs hesabına aiddir, ona görə burada heç nə əlavə edilmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази покупка принадлежи на друг акаунт в tafs в този акаунт в Google, така че нищо не беше добавено тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento nákup patří jinému účtu tafs v tomto účtu Google, takže se sem nic nepřidalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kauf gehört zu einem anderen tafs-Konto mit diesem Google-Konto, daher wurde hier nichts hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This purchase belongs to another tafs account on this Google account, so nothing was added here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compra pertenece a otra cuenta de tafs de esta cuenta de Google, así que no se añadió nada aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ost kuulub selle Google'i konto teisele tafsi kontole, seega siia ei lisatud midagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat appartient à un autre compte tafs sur ce compte Google : rien n'a été ajouté ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova kupnja pripada drugom tafs računu na ovom Google računu pa ovdje ništa nije dodano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a vásárlás egy másik tafs-fiókhoz tartozik ezen a Google-fiókon, ezért itt semmi sem lett hozzáadva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գնումը պատկանում է այս Google հաշվի մեկ այլ tafs հաշվին, ուստի այստեղ ոչինչ չավելացվեց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian ini milik akun tafs lain di akun Google ini, jadi tidak ada yang ditambahkan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo acquisto appartiene a un altro account tafs su questo account Google, quindi qui non è stato aggiunto nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この購入はこのGoogleアカウントの別のtafsアカウントのものなので、ここには何も追加されませんでした。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს შეძენა ეკუთვნის სხვა tafs ანგარიშს ამ Google ანგარიშზე, ამიტომ აქ არაფერი დამატებულა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구매는 이 Google 계정의 다른 tafs 계정에 속하므로 여기에는 아무것도 추가되지 않았습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis pirkinys priklauso kitai tafs paskyrai šioje Google paskyroje, todėl čia nieko nepridėta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis pirkums pieder citam tafs kontam šajā Google kontā, tāpēc šeit nekas netika pievienots."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze aankoop hoort bij een ander tafs-account op dit Google-account, dus hier is niets toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten zakup należy do innego konta tafs na tym koncie Google, więc nic tu nie dodano."
