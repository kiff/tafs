    "coach.nothing_reaches_until_you_resume": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يصله شيء حتى تستأنفه. ثم أرسل هذا مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz davam etdirənə qədər ona heç nə çatmır. Sonra bunu yenidən göndərin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо не стига до него, докато не го възобновите. Тогава изпратете това отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি আবার চালু না করা পর্যন্ত এতে কিছু পৌঁছায় না। তারপর এটি আবার পাঠান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi arriba res fins que el reprenguis. Després envia això de nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se k němu nedostane, dokud ho neobnovíte. Pak to pošlete znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts erreicht ihn, bis du ihn fortsetzt. Sende das dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing reaches it until you resume it. Then send this again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No le llega nada hasta que lo reanudes. Luego vuelve a enviar esto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinna ei jõua midagi enne, kui selle jätkad. Siis saada see uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne lui parvient tant que vous ne le reprenez pas. Renvoyez ensuite ceci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא מגיע אליו עד שתחדש אותו. אז יש לשלוח את זה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप इसे फिर शुरू नहीं करते, इस तक कुछ नहीं पहुँचता। फिर इसे दोबारा भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa ne stiže do njega dok ga ne nastavite. Tada ovo pošaljite ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem éri el, amíg nem folytatod. Aztán küldd el ezt újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրան ոչինչ չի հասնում, մինչև չվերսկսեք։ Ապա ուղարկեք սա նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang sampai kepadanya sampai Anda melanjutkannya. Lalu kirim ini lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non gli arriva nulla finché non lo riprendi. Poi invialo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開するまで何も届きません。再開後にもう一度送信してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მასთან არაფერი აღწევს, სანამ არ განაახლებთ. შემდეგ ეს გაგზავნეთ ხელახლა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានអ្វីទៅដល់វាទេ រហូតដល់អ្នកបន្តវា។ បន្ទាប់មកផ្ញើរឿងនេះម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재개할 때까지 아무것도 전달되지 않습니다. 재개한 뒤 다시 보내세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ມີຫຍັງເຖິງມັນຈົນກວ່າທ່ານຈະສືບຕໍ່ມັນ. ແລ້ວສົ່ງອັນນີ້ອີກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas jo nepasieks, kol jo netęsite. Tada išsiųskite tai dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas to nesasniedz, kamēr tu to neturpini. Tad nosūti šo vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ништо не стигнува до него додека не го продолжиш. Потоа испрати го ова повторно."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та үргэлжлүүлэх хүртэл түүнд юу ч хүрэхгүй. Дараа нь үүнийг дахин илгээнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले फेरि सुरु नगरेसम्म यसमा केही पुग्दैन। त्यसपछि यो फेरि पठाउनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bereikt het niets tot je het hervat. Verzend dit daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic do niego nie dotrze, dopóki go nie wznowisz. Potem wyślij to ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada lhe chega até o retomar. Depois, envie isto novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada lhe chega até o retomar. Depois, envie isto novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu ajunge la el până nu îl reluați. Apoi trimiteți din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič sa k nemu nedostane, kým ho neobnovíte. Potom to pošlite znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič ga ne doseže, dokler ga ne nadaljujete. Nato to pošljite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Asgjë nuk arrin te ai derisa ta riniseni. Pastaj dërgojeni këtë sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa ne stiže do njega dok ga ne nastavite. Tada ovo pošaljite ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะไม่มีอะไรไปถึงมันจนกว่าคุณจะให้มันทำต่อ จากนั้นส่งอีกครั้ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz ony dowam etdirýänçäňiz oňa hiç zat ýetmeýär. Soňra muny täzeden iberiň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz sürdürene kadar ona hiçbir şey ulaşmaz. Sonra bunu tekrar gönderin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ اسے دوبارہ نہ چلائیں اس تک کچھ نہیں پہنچتا۔ پھر اسے دوبارہ بھیجیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
