    "record.connection_refused_before_sending": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضه الاتصال قبل الإرسال. لم يُرسل شيء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoşulma onu göndərilməzdən əvvəl rədd etdi. Heç nə göndərilmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връзката го отказа преди изпращане. Нищо не беше изпратено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোগ পাঠানোর আগেই এটি প্রত্যাখ্যান করেছে। কিছু পাঠানো হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexió ho ha rebutjat abans d'enviar. No s'ha enviat res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení to odmítlo před odesláním. Nic se neodeslalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung hat es vor dem Senden abgelehnt. Es wurde nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection refused it before sending. Nothing was sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión lo rechazó antes de enviarlo. No se envió nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendus keeldus enne saatmist. Midagi ei saadetud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion l'a refusé avant l'envoi. Rien n'a été envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור דחה את זה לפני השליחה. שום דבר לא נשלח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन ने इसे भेजने से पहले अस्वीकार कर दिया। कुछ नहीं भेजा गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza je to odbila prije slanja. Ništa nije poslano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolat küldés előtt elutasította. Semmi sem ment el."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կապը մերժեց այն ուղարկելուց առաջ։ Ոչինչ չուղարկվեց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi menolaknya sebelum mengirim. Tidak ada yang dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento l'ha rifiutato prima dell'invio. Non è stato inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信前に接続先が拒否しました。何も送信されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კავშირმა უარყო გაგზავნამდე. არაფერი გაიგზავნა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការតភ្ជាប់បានបដិសេធវាមុនពេលផ្ញើ។ គ្មានអ្វីត្រូវបានផ្ញើទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기 전에 연결이 거절했습니다. 보낸 것은 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການເຊື່ອມຕໍ່ປະຕິເສດກ່ອນສົ່ງ. ບໍ່ມີຫຍັງຖືກສົ່ງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryšys ją atmetė prieš išsiunčiant. Niekas neišsiųsta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Savienojums to atteica pirms nosūtīšanas. Nekas netika nosūtīts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Врската го одби пред да го испрати. Ништо не е испратено."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Холболт илгээхээс өмнө татгалзсан. Юу ч илгээгдээгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जडानले पठाउनुअघि नै अस्वीकार गर्‍यो। केही पठाइएन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De koppeling heeft het vóór verzending geweigerd. Er is niets verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie odrzuciło to przed wysłaniem. Nic nie zostało wysłane."
          }
        },
        "pt": {
