    "coach.waiting_for_vendor": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich die Anmeldeseite des Anbieters geöffnet hat, schließ die Anmeldung dort ab und komm zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
