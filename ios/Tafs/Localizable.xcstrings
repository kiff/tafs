        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinnitamiseks on vaja: %1$@, kuid selles seadmes (%2$@) pole seda veel seadistatud. Seadista see menüüs %3$@ ja tule siis tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver demande %1$@, et rien n'est encore configuré sur %4$@. Configurez-le dans %3$@, puis revenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per approvare serve %1$@, e nessuno è ancora configurato su questo %2$@. Configuralo in %3$@, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認には%1$@が必要ですが、この%2$@にはまだ設定されていません。%3$@で設定してから戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하려면 %1$@이(가) 필요한데, 이 %2$@에는 아직 설정되어 있지 않습니다. %3$@에서 설정한 뒤 돌아오세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvirtinant reikia šio būdo: %1$@, bet šiame įrenginyje (%2$@) jis dar nenustatytas. Nustatykite jį (%3$@), tada grįžkite."
