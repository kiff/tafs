    "sign_in.waiting_for_browser": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار متصفحك… تحقق من أنه يعرض %1$@، ووافق فقط وهذا الجهاز (%2$@) في يدك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Brauzeriniz gözlənilir… %1$@ göstərdiyini yoxlayın və yalnız bu %2$@ əlinizdə olanda təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изчакване на браузъра ви… Проверете дали показва %1$@ и одобрявайте само ако държите този %2$@ в ръцете си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ব্রাউজারের অপেক্ষায়… এটি %1$@ দেখাচ্ছে কিনা যাচাই করুন, এবং শুধু এই %2$@ আপনার হাতে থাকলেই অনুমোদন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperant el teu navegador… Comprova que mostri %1$@, i aprova només amb aquest dispositiu (%2$@) a les mans."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čekám na váš prohlížeč… Zkontrolujte, že ukazuje %1$@, a schvalte jen s tímto zařízením (%2$@) v rukou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf deinen Browser… Prüfe, ob er %1$@ zeigt, und genehmige nur mit diesem %2$@ in deinen Händen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your browser… Check that it shows %1$@, and approve only with this %2$@ in your hands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a tu navegador… Comprueba que muestra %1$@, y aprueba solo con este %2$@ en tus manos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Brauseri ootamine… Kontrolli, et see näitab koodi %1$@, ja kinnita ainult siis, kui see %2$@ on sinu käes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de votre navigateur… Vérifiez qu'il affiche %1$@, et n'approuvez qu'avec %3$@ en main."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממתין לדפדפן שלך… יש לוודא שהוא מציג %1$@, ולאשר רק כשההתקן הזה (%2$@) בידיים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके ब्राउज़र का इंतज़ार… जाँचें कि वह %1$@ दिखाता है, और केवल यह %2$@ आपके हाथ में होने पर ही मंज़ूर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čekanje vašeg preglednika… Provjerite prikazuje li %1$@ i odobrite samo ako imate ovaj uređaj (%2$@) u rukama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Várakozás a böngésződre… Ellenőrizd, hogy ezt mutatja: %1$@, és csak akkor hagyd jóvá, ha ez az eszköz (%2$@) a kezedben van."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սպասում ենք ձեր բրաուզերին… Ստուգեք, որ այն ցույց է տալիս %1$@-ը, և հաստատեք միայն այս սարքով (%2$@), որ ձեր ձեռքում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu browser Anda… Pastikan menampilkan %1$@, dan setujui hanya saat %2$@ ini ada di tangan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa del browser… Verifica che mostri %1$@, e approva solo con questo %2$@ in mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザを待っています…%1$@が表示されていることを確認し、この%2$@を手元に持った状態でのみ承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენს ბრაუზერს ველოდებით… შეამოწმეთ, რომ ის აჩვენებს %1$@-ს, და დაამტკიცეთ მხოლოდ ამ მოწყობილობით (%2$@), რომელიც ხელში გიჭირავთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំពុងរង់ចាំកម្មវិធីរុករករបស់អ្នក… ពិនិត្យថាវាបង្ហាញ %1$@ ហើយអនុម័តតែនៅពេលអ្នកកាន់ %2$@ នេះនៅក្នុងដៃប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저를 기다리는 중… %1$@ 코드가 표시되는지 확인하고, 이 %2$@을(를) 손에 든 상태에서만 승인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກຳລັງລໍຖ້າເບົາເຊີຂອງທ່ານ… ກວດວ່າມັນສະແດງ %1$@ ແລ້ວອະນຸມັດສະເພາະເມື່ອທ່ານຖື %2$@ ນີ້ຢູ່ໃນມື."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laukiama naršyklės… Patikrinkite, ar ji rodo %1$@, ir tvirtinkite tik laikydami šį įrenginį (%2$@) rankose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaida tavu pārlūku… Pārbaudi, vai tas rāda %1$@, un apstiprini tikai tad, ja šis %2$@ ir tavās rokās."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Се чека твојот прелистувач… Провери дека го покажува %1$@ и одобри само со овој %2$@ во рацете."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны хөтчийг хүлээж байна… Энэ нь %1$@-ийг харуулж байгааг шалгаад, зөвхөн энэ %2$@ гартаа барьж байгаа үедээ зөвшөөрнө үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको ब्राउजरको प्रतीक्षा हुँदैछ… यसले %1$@ देखाएको जाँच्नुहोस्, र यो %2$@ आफ्नो हातमा हुँदा मात्र स्वीकृत गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht op je browser… Controleer of die %1$@ toont, en keur alleen goed met deze %2$@ in je handen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czeka na Twoją przeglądarkę… Sprawdź, czy pokazuje %1$@, i zatwierdzaj tylko z tym urządzeniem (%2$@) w rękach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "À espera do seu navegador… Verifique se mostra %1$@, e aprove apenas com este %2$@ nas suas mãos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando o seu navegador… Verifique se ele mostra %1$@, e aprove só com este %2$@ nas suas mãos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se așteaptă browserul… Verificați că afișează %1$@ și aprobați doar dacă țineți acest dispozitiv (%2$@) în mână."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čakám na váš prehliadač… Skontrolujte, že ukazuje %1$@, a schváľte len s týmto zariadením (%2$@) v rukách."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Čakam na vaš brskalnik… Preverite, da prikazuje %1$@, in odobrite samo s to napravo (%2$@) v rokah."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Po pritet shfletuesi juaj… Kontrolloni që shfaq %1$@, dhe miratoni vetëm me këtë pajisje (%2$@) në duar."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Čekanje vašeg preglednika… Proverite prikazuje li %1$@ i odobrite samo ako imate ovaj uređaj (%2$@) u rukama."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรอเบราว์เซอร์ของคุณ… ตรวจสอบว่ามันแสดง %1$@ และอนุมัติเฉพาะเมื่อ%2$@เครื่องนี้อยู่ในมือคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Brauzeriňize garaşylýar… Onuň %1$@ görkezýändigini barlaň, we diňe bu %2$@ eliňizde bolanda tassyklaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcınız bekleniyor… %1$@ gösterdiğinden emin olun ve yalnızca bu %2$@ elinizdeyken onaylayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے براؤزر کا انتظار ہے… دیکھیں کہ یہ %1$@ دکھاتا ہے، اور صرف تب منظور کریں جب یہ %2$@ آپ کے ہاتھ میں ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ trình duyệt của bạn… Hãy kiểm tra nó hiển thị %1$@, và chỉ phê duyệt khi %2$@ này đang ở trong tay bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待您的瀏覽器…請確認它顯示%1$@，並且只在這部%2$@握在您手中時才核准。"
          }
        }
      }
    },
