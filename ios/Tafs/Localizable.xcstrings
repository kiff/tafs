        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ taf रोकिँदैछ: कुनै चलाइ सुरु हुँदैन। KIFF ले प्रत्येक भाग पुष्टि गरेको छैन; पुष्टि भएपछि tafs ले देखाउँछ।"
