            "value": "Het heeft KIFF niet bereikt. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie dotarło do KIFF. Spróbuj ponownie."
          }
        },
        "pt": {
