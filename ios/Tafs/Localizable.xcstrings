    "taf.unless_you_approve_tools_sign": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alətlərini təsdiq etməsəniz, giriş %1$@ ləğv edilir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако не одобрите инструментите му, входът се оттегля %1$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud neschválíte jeho nástroje, přihlášení se odvolá %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du seine Tools nicht genehmigst, wird die Anmeldung %1$@ widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unless you approve its tools, the sign-in is revoked %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no apruebas sus herramientas, el inicio de sesión se revoca %1$@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui sa selle tööriistu ei kinnita, tühistatakse sisselogimine %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous n'approuvez pas ses outils, la connexion est révoquée %1$@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ne odobrite njegove alate, prijava se opoziva %1$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha nem hagyod jóvá az eszközeit, a bejelentkezés visszavonásra kerül: %1$@."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե չհաստատեք նրա գործիքները, մուտքը չեղարկվում է %1$@։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecuali Anda menyetujui alatnya, proses masuk dicabut %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non approvi i suoi strumenti, l'accesso viene revocato %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールを承認しない場合、サインインは%1$@に取り消されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ მისი ინსტრუმენტები არ დაამტკიცეთ, შესვლა უქმდება %1$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구를 승인하지 않으면 로그인이 %1$@에 취소됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei nepatvirtinsite jo įrankių, prisijungimas bus atšauktas %1$@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja tu neapstiprināsi tā rīkus, pierakstīšanās tiks atsaukta %1$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de tools niet goedkeurt, wordt de login %1$@ ingetrokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli nie zatwierdzisz jego narzędzi, logowanie zostanie unieważnione %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A menos que aprove as suas ferramentas, o início de sessão é revogado %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A menos que aprove as suas ferramentas, o login é revogado %1$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă nu îi aprobați instrumentele, conectarea este revocată %1$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak neschválite jeho nástroje, prihlásenie sa odvolá %1$@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če ne odobrite njegovih orodij, se prijava odvzame %1$@."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse nuk i miratoni mjetet e tij, hyrja revokohet %1$@."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ne odobrite njegove alate, prijava se opoziva %1$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณไม่อนุมัติเครื่องมือของมัน การเข้าสู่ระบบจะถูกเพิกถอน %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araçlarını onaylamazsanız oturum açma %1$@ iptal edilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn không phê duyệt các công cụ của nó, việc đăng nhập sẽ bị thu hồi %1$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您核准它的工具，否則登入會在%1$@撤銷。"
          }
        }
      }
    },
