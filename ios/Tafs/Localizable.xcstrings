    "setup.place.app_words": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من تم الرد عليه ومن أي باب، دون كلماته أبدًا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimin cavablandırıldığı və hansı qapı ilə, heç vaxt sözləri yox"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На кого е отговорено и през коя врата, никога думите му"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাকে উত্তর দেওয়া হয়েছে এবং কোন দরজা দিয়ে, কখনও তার কথা নয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A qui s'ha respost i per quina porta, mai les seves paraules"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Komu a přes které dveře odpověděl, nikdy jeho slova"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wem über welche Tür geantwortet wurde, nie der Wortlaut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who was answered and through which door, never its words"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A quién se respondió y por qué puerta, nunca sus palabras"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kellele vastati ja millise ukse kaudu, mitte kunagi selle sõnu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À qui il a été répondu et par quelle porte, jamais son contenu"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למי השיבו ובאיזו דלת, אף פעם לא המילים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसे उत्तर दिया और किस द्वार से, कभी उसके शब्द नहीं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tko je dobio odgovor i kroz koja vrata, nikad njegove riječi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinek és melyik ajtón válaszolt, soha a szavait"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ումն էր պատասխանվել և ո՛ր դռնով, երբեք նրա բառերը"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa yang dijawab dan lewat pintu mana, tidak pernah kata-katanya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A chi è stato risposto e tramite quale porta, mai le sue parole"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの窓口で誰に回答したかだけを送り、内容は送りません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვის უპასუხა და რომელი კარით, არასოდეს მისი სიტყვები"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកណាត្រូវបានឆ្លើយ និងតាមទ្វារណា មិនដែលជាពាក្យរបស់វាទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구에게 어떤 창구로 답했는지만 보내며 내용은 보내지 않습니다"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃຜຖືກຕອບ ແລະ ຜ່ານປະຕູໃດ, ບໍ່ເຄີຍເປັນຄຳເວົ້າຂອງມັນ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kam atsakyta ir per kurias duris, bet niekada ne atsakymo žodžiai"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kam tika atbildēts un caur kurām durvīm, nekad tā vārdus"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кој е одговорен и преку кои врати, никогаш неговите зборови"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэнд, ямар хаалгаар хариулсныг, хэзээ ч түүний үгийг биш"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कसलाई जवाफ दिइयो र कुन ढोकाबाट, यसका शब्द कहिल्यै होइन"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie er is beantwoord en via welke deur, nooit de woorden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komu i przez które drzwi odpowiedziano, nigdy treść"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A quem foi respondido e por que porta, nunca as palavras"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A quem foi respondido e por que porta, nunca as palavras"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cui i s-a răspuns și prin ce ușă, niciodată cuvintele sale"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Komu a cez ktoré dvere odpovedal, nikdy jeho slová"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komu in skozi katera vrata je odgovoril, nikoli njegovih besed"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kujt iu përgjigj dhe përmes cilës portë, kurrë fjalët e tij"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je dobio odgovor i kroz koja vrata, nikad njegove reči"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครได้รับคำตอบและผ่านประตูใด ไม่มีถ้อยคำของมัน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kime jogap berildi we haýsy gapy arkaly, hiç haçan onuň sözleri däl"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kime ve hangi kapıdan yanıt verildiği; sözleri asla"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کس کو جواب دیا گیا اور کس دروازے سے، اس کے الفاظ کبھی نہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai đã được trả lời và qua cửa nào, không bao giờ kèm lời của nó"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
