    "connect.request_does_not_match_what": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage stimmt nicht mit dem überein, was sie zeigt, daher kann sie nicht genehmigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request doesn't match what it shows, so it can't be approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud no coincide con lo que muestra, así que no se puede aprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande ne correspond pas à ce qu'elle affiche : elle ne peut pas être approuvée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa richiesta non corrisponde a ciò che mostra, quindi non può essere approvata."
