          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Почива до утре"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpočívá do zítřka"
          }
        },
        "de": {
