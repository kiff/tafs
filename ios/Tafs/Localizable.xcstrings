    },
    "needs_you.request_taf_missing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage konnte nicht gelesen werden: Ihr taf ist nicht auf diesem Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request couldn't be read: its taf isn't on this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer esa solicitud: su taf no está en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande n'a pas pu être lue : son taf n'est pas sur ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere quella richiesta: il suo taf non è su questo telefono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat verzoek kon niet worden gelezen: het taf staat niet op deze telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać tej prośby: jej tafa nie ma na tym telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler esse pedido: o seu taf não está neste telefone."
          }
        }
      }
    },
    "needs_you.second_step": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zusatzspielraum ist durchgegangen. Dieser Aufruf wird wegen eines eigenen Limits erneut zurückgehalten: %1$@. Genehmige ihn einmal, damit er durchgeht, oder lehne ihn ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra room went through. This call is held again for a limit of its own: %1$@. Approve it once to let it go, or refuse it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El margen extra se aplicó. Esta llamada vuelve a estar retenida por un límite propio: %1$@. Aprueba una vez para dejarla pasar, o recházala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La marge supplémentaire a été accordée. Cet appel est à nouveau retenu pour une limite qui lui est propre : %1$@. Approuvez-le une fois pour le laisser passer, ou refusez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il margine extra è stato applicato. Questa chiamata è di nuovo trattenuta per un suo limite: %1$@. Approvala una volta per lasciarla passare, o rifiutala."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra ruimte is gelukt. Deze aanroep wordt opnieuw vastgehouden voor een eigen limiet: %1$@. Je kunt het eenmalig goedkeuren om het door te laten, of het weigeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowy zapas został przyznany. To wywołanie jest znowu oczekujące z powodu własnego limitu: %1$@. Zatwierdź je raz, aby je przepuścić, albo je odrzuć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A margem extra foi concedida. Esta chamada está novamente retida por um limite próprio: %1$@. Aprove-a uma vez para a deixar seguir, ou recuse-a."
          }
        }
      }
    },
    "needs_you.sign_in_again_instead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stattdessen erneut anmelden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again instead"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a iniciar sesión en su lugar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reconnecter plutôt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi di nuovo, invece"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In plaats daarvan opnieuw inloggen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiast tego zaloguj się ponownie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sessão novamente"
          }
        }
      }
    },
    "needs_you.sign_in_again_to_answer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich ab und erneut an, um von diesem Telefon zu antworten, damit KIFF seinen Schlüssel kennt. Oder beantworte diese hier in KIFF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out and in again to answer from this phone, so KIFF knows its key. Or answer this one in KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra sesión y vuelve a iniciarla para responder desde este teléfono, así KIFF conoce su clave. O responde a esta en KIFF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous puis reconnectez-vous pour répondre depuis ce téléphone, afin que KIFF connaisse sa clé. Ou répondez à celle-ci dans KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci e accedi di nuovo per rispondere da questo telefono, così KIFF conosce la sua chiave. Oppure rispondi a questa in KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log uit en opnieuw in om vanaf deze telefoon te antwoorden, zodat KIFF de sleutel kent. Of beantwoord deze in KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyloguj się i zaloguj ponownie, aby odpowiadać z tego telefonu, żeby KIFF znał jego klucz. Albo odpowiedz na to w KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine a sessão e inicie sessão novamente para responder a partir deste telefone, para que o KIFF conheça a sua chave. Ou responda a este no KIFF."
          }
        }
      }
    },
    "needs_you.someone_answers": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand, der in diesem Konto genehmigt, beantwortet das. Die Antwort erscheint hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone who approves on this account answers this. Their answer shows here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien aprueba en esta cuenta responde a esto. Su respuesta aparece aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne qui approuve sur ce compte y répond. Sa réponse s'affiche ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risponde chi approva in questo account. La sua risposta compare qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand die in dit account goedkeurt, beantwoordt dit. Het antwoord verschijnt hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiada na to osoba zatwierdzająca na tym koncie. Jej odpowiedź pojawi się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém que aprova nesta conta responde a isto. A resposta aparece aqui."
          }
        }
      }
    },
    "needs_you.tab_label": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht dich, %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs you, %1$@"
