    "alert.sign_in_again": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişləri aktiv etmək üçün KIFF ilə yenidən daxil olun: bu giriş telefon üçün imzalaya bilməz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влезте отново с KIFF, за да включите известията: този вход не може да подписва за телефона."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro zapnutí upozornění se znovu přihlaste přes KIFF: toto přihlášení nemůže podepisovat za telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich erneut mit KIFF an, um Benachrichtigungen einzuschalten: Diese Anmeldung kann nicht für das Telefon signieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with KIFF again to turn on alerts: this sign-in can't sign for the phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a iniciar sesión con KIFF para activar las alertas: este inicio de sesión no puede firmar por el teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teavituste sisselülitamiseks logi uuesti KIFFiga sisse: see sisselogimine ei saa telefoni eest allkirjastada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous avec KIFF pour activer les alertes : cette connexion ne peut pas signer pour le téléphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se ponovno KIFF-om da uključite obavijesti: ova prijava ne može potpisivati za telefon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések bekapcsolásához jelentkezz be újra a KIFF-fel: ez a bejelentkezés nem tud aláírni a telefon nevében."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նորից մուտք գործեք KIFF-ով՝ ծանուցումները միացնելու համար․ այս մուտքը չի կարող ստորագրել հեռախոսի համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan KIFF lagi untuk mengaktifkan peringatan: proses masuk ini tidak dapat menandatangani untuk ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi di nuovo con KIFF per attivare gli avvisi: questo accesso non può firmare per il telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知をオンにするには、もう一度KIFFでサインインしてください：このサインインではスマートフォンで署名できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კვლავ შედით KIFF-ით შეტყობინებების ჩასართავად: ამ შესვლას ტელეფონისთვის ხელმოწერა არ შეუძლია."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 켜려면 KIFF로 다시 로그인하세요. 이 로그인으로는 휴대폰에서 서명할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdami įjungti pranešimus, dar kartą prisijunkite su KIFF: šis prisijungimas negali pasirašyti už telefoną."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai ieslēgtu paziņojumus, vēlreiz pieraksties ar KIFF: šī pierakstīšanās nevar parakstīt tālruņa vārdā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log opnieuw in met KIFF om meldingen aan te zetten: deze login kan niet voor de telefoon ondertekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się ponownie przez KIFF, aby włączyć alerty: to logowanie nie może podpisywać za ten telefon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão novamente com o KIFF para ativar os alertas: esta sessão não pode assinar pelo telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre novamente com o KIFF para ativar os alertas: esta sessão não pode assinar pelo telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectați-vă din nou cu KIFF pentru a activa alertele: această conectare nu poate semna pentru telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zapnutie upozornení sa znova prihláste cez KIFF: toto prihlásenie nemôže podpisovať za telefón."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za vklop opozoril se znova prijavite s KIFF: ta prijava ne more podpisovati za telefon."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyni sërish me KIFF për të aktivizuar njoftimet: kjo hyrje nuk mund të nënshkruajë për telefonin."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se ponovo KIFF-om da uključite obaveštenja: ova prijava ne može da potpisuje za telefon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบด้วย KIFF อีกครั้งเพื่อเปิดการแจ้งเตือน: การเข้าสู่ระบบนี้ลงนามให้โทรศัพท์ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarıları açmak için KIFF ile tekrar oturum açın: bu oturum telefon adına imzalayamıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng nhập lại bằng KIFF để bật thông báo: lần đăng nhập này không thể ký cho điện thoại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新以 KIFF 登入以開啟通知：這次登入無法為手機簽署。"
          }
        }
      }
