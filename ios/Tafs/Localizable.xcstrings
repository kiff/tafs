        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho zprávy přes %1$@ mu odteď dávají práci"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Nachrichten per %1$@ geben ihm ab jetzt Arbeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their messages by %1$@ give it work from now on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de ahora, sus mensajes por %1$@ le dan trabajo"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema sõnumid ukse %1$@ kaudu annavad sellele nüüdsest tööd"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses messages par %1$@ lui donnent désormais du travail"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעכשיו ההודעות שלו דרך %1$@ נותנות לו עבודה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ से उनके संदेश अब से इसे काम देते हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njihove poruke putem: %1$@ od sada mu daju posao"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ezen (%1$@) érkező üzenetei mostantól munkát adnak neki"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրանց հաղորդագրությունները %1$@-ով այսուհետ աշխատանք են տալիս"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan mereka lewat %1$@ memberinya pekerjaan mulai sekarang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "D'ora in poi i suoi messaggi via %1$@ gli danno lavoro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後、%1$@経由のメッセージで仕事を依頼できます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მათი შეტყობინებები კარით %1$@ ამიერიდან სამუშაოს აძლევს"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សាររបស់ពួកគេតាម %1$@ ផ្តល់ការងារដល់វាចាប់ពីពេលនេះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제부터 %1$@에서 보낸 메시지로 작업을 맡깁니다"
