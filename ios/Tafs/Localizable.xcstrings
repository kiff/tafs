    "needs_you.answer_in_kiff_until": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefondan cavab vermək KIFF telefonun imzasını yoxlayandan sonra gəlir. O vaxta qədər KIFF-də cavab verin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговорът от телефона пристига, след като KIFF провери подписа на телефона. Дотогава отговаряйте в KIFF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpověď z telefonu dorazí, až KIFF ověří podpis telefonu. Do té doby odpovídejte v KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten vom Telefon kommen an, sobald KIFF die Signatur des Telefons prüft. Bis dahin antworte in KIFF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answering from the phone arrives once KIFF checks the phone's signature. Until then, answer in KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas desde el teléfono llegarán cuando KIFF compruebe la firma del teléfono. Hasta entonces, responde en KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonist vastamine jõuab kohale, kui KIFF on telefoni allkirja kontrollinud. Seni vasta KIFFis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réponse depuis le téléphone arrive dès que KIFF vérifie la signature du téléphone. D'ici là, répondez dans KIFF."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovaranje s telefona stiže kad KIFF provjeri potpis telefona. Do tada odgovorite u KIFF-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefonról adott válasz akkor érkezik meg, amikor a KIFF ellenőrzi a telefon aláírását. Addig a KIFF-ben válaszolj."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հեռախոսից պատասխանը հասանելի կդառնա, երբ KIFF-ը ստուգի հեռախոսի ստորագրությունը։ Մինչ այդ պատասխանեք KIFF-ում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjawab dari ponsel tersedia setelah KIFF memeriksa tanda tangan ponsel. Sampai saat itu, jawab di KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte dal telefono arrivano quando KIFF verifica la firma del telefono. Fino ad allora, rispondi in KIFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンからの回答は、KIFFがスマートフォンの署名を確認した後に届きます。それまではKIFFで回答してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ტელეფონიდან პასუხი ხელმისაწვდომი გახდება, როცა KIFF ტელეფონის ხელმოწერას შეამოწმებს. მანამდე უპასუხეთ KIFF-ში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰에서 한 답변은 KIFF가 휴대폰의 서명을 확인한 뒤에 도착합니다. 그때까지는 KIFF에서 답변하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsakymas iš telefono bus priimtas, kai KIFF patikrins telefono parašą. Iki tol atsakykite KIFF."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbilde no tālruņa pienāks, kad KIFF pārbaudīs tālruņa parakstu. Līdz tam atbildi KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden vanaf de telefoon komt aan zodra KIFF de handtekening van de telefoon controleert. Antwoord tot dan in KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadanie z telefonu zadziała, gdy KIFF zacznie sprawdzać podpis telefonu. Do tego czasu odpowiadaj w KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas a partir do telefone chegam quando o KIFF verificar a assinatura do telefone. Até lá, responda no KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas a partir do telefone chegam quando o KIFF verificar a assinatura do telefone. Até lá, responda no KIFF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsul de pe telefon ajunge după ce KIFF verifică semnătura telefonului. Până atunci, răspundeți în KIFF."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpoveď z telefónu dorazí, keď KIFF overí podpis telefónu. Dovtedy odpovedajte v KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovor iz telefona prispe, ko KIFF preveri podpis telefona. Do takrat odgovarjajte v KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigjja nga telefoni vjen kur KIFF kontrollon nënshkrimin e telefonit. Deri atëherë, përgjigjuni në KIFF."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovaranje s telefona stiže kad KIFF proveri potpis telefona. Do tada odgovorite u KIFF-u."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตอบจากโทรศัพท์จะใช้ได้เมื่อ KIFF ตรวจลายเซ็นของโทรศัพท์ จนกว่าจะถึงตอนนั้น ให้ตอบใน KIFF"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefondan yanıtlama, KIFF telefonun imzasını doğrulayınca gelir. O zamana kadar KIFF'te yanıtlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời từ điện thoại sẽ có khi KIFF kiểm tra chữ ký của điện thoại. Cho đến lúc đó, hãy trả lời trong KIFF."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待 KIFF 驗證手機簽章後，即可從手機回覆。在那之前，請在 KIFF 中回覆。"
          }
        }
      }
    },
    "needs_you.answer_names_each": {
      "extractionState": "manual",
      "localizations": {
        "az": {
