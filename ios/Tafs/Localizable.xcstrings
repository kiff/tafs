    "record.tool_refused_amount": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat es abgelehnt. Es wurde nichts ausgeführt, aber es zählt trotzdem zur heutigen Summe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ refused it. Nothing was done, but it still counts against today's total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lo rechazó. No se hizo nada, pero sigue contando para el total de hoy."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ keeldus. Midagi ei tehtud, kuid see läheb ikka tänase kogusumma arvesse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ l'a refusé. Rien n'a été fait, mais cela compte quand même dans le total du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ l'ha rifiutata. Non è stato fatto nulla, ma conta comunque nel totale di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が拒否しました。何も実行されていませんが、今日の合計にはカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 거절했습니다. 아무것도 하지 않았지만 오늘 합계에는 여전히 포함됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tai atmetė. Nieko nepadaryta, bet tai vis tiek įskaičiuojama į šiandienos bendrą sumą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to atteica. Nekas netika izdarīts, bet tas joprojām tiek ieskaitīts šodienas kopsummā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft het geweigerd. Er is niets gedaan, maar het telt nog wel mee voor het totaal van vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to odrzucił. Nic nie zostało zrobione, ale nadal liczy się do dzisiejszej sumy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recusou. Nada foi feito, mas continua a contar para o total de hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recusou. Nada foi feito, mas continua contando para o total de hoje."
          }
        }
      }
    },
