    "connect.apps_connect_taf_make_one": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqlər taf üçün qoşulur. Əvvəlcə birini yaradın, sonra tətbiqlərini burada qoşun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложенията се свързват за taf. Първо създайте такъв, после свържете приложенията му тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace se připojují pro taf. Nejdřív jeden vytvořte a pak tady připojte jeho aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps werden für einen taf verbunden. Erstelle zuerst einen und verbinde dann hier seine Apps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps connect for a taf. Make one first, then connect its apps here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps se conectan para un taf. Crea uno primero y luego conecta aquí sus apps."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendused ühendatakse tafi jaoks. Loo kõigepealt taf, siis ühenda siin selle rakendused."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps se connectent pour un taf. Créez-en un d'abord, puis connectez ses apps ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije se povezuju za taf. Najprije ga izradite, pa ovdje povežite njegove aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazások egy tafhoz csatlakoznak. Előbb hozz létre egyet, aztán itt csatlakoztasd az alkalmazásait."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածները միանում են taf-ի համար։ Նախ ստեղծեք մեկը, ապա այստեղ միացրեք նրա հավելվածները։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi dihubungkan untuk sebuah taf. Buat satu dulu, lalu hubungkan aplikasinya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app si collegano per un taf. Creane prima uno, poi collega qui le sue app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはtafのために接続します。先にtafを作ってから、ここでアプリを接続してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპები taf-ისთვის უკავშირდება. ჯერ შექმენით ერთი, შემდეგ აქ დააკავშირეთ მისი აპები."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 taf를 위해 연결됩니다. 먼저 taf를 만든 뒤 여기서 앱을 연결하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programėlės prijungiamos taf. Pirmiausia sukurkite jį, tada čia prijunkite jo programėles."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotnes tiek pievienotas taf. Vispirms izveido taf, tad pievieno tā lietotnes šeit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps worden voor een taf gekoppeld. Maak eerst een taf en koppel hier dan de apps ervan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje łączy się dla tafa. Najpierw go utwórz, a potem połącz tu jego aplikacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As apps ligam-se para um taf. Crie primeiro um e depois ligue aqui as suas apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps se conectam para um taf. Crie primeiro um e depois conecte aqui os seus apps."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile se conectează pentru un taf. Creați mai întâi unul, apoi conectați-i aplicațiile aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácie sa pripájajú pre taf. Najprv jeden vytvorte a potom tu pripojte jeho aplikácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije se povežejo za taf. Najprej ga ustvarite, nato tukaj povežite njegove aplikacije."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacionet lidhen për një taf. Krijoni një më parë, pastaj lidhni aplikacionet e tij këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije se povezuju za taf. Prvo ga izradite, pa ovdje povežite njegove aplikacije."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปเชื่อมต่อให้ taf สร้าง taf ก่อน แล้วเชื่อมต่อแอปของมันที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar bir taf için bağlanır. Önce bir tane oluşturun, sonra uygulamalarını burada bağlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng được kết nối cho một taf. Hãy tạo một taf trước, rồi kết nối ứng dụng của nó ở đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 是為 taf 連接的。請先建立一個，再在這裡連接它的 App。"
          }
        }
      }
    },
