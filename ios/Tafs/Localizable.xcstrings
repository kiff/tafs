    "record.did_this_happen.what_no_does": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«لا» تعيد المساحة إلى الـ Card. و«نعم» تُبقيه محتسبًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Xeyr» Card-a yeri geri qaytarır. «Bəli» onu hesaba salınmış saxlayır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Не“ връща лимита на Card. „Да“ го оставя отчетен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "«না» বললে Card তার জায়গা ফিরে পায়। «হ্যাঁ» বললে এটি গণনায় থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«No» retorna el marge al Card. «Sí» ho manté comptat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vrátí Card prostor. Ano ho nechá započítaný."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nein“ gibt der Card ihren Spielraum zurück. „Ja“ lässt es gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No gives the Card its room back. Yes keeps it counted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«No» devuelve el margen a la Card. «Sí» lo mantiene contado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ei” annab Cardile ruumi tagasi. „Jah” jätab selle arvesse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non rend sa marge à la Card. Oui le garde compté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "«לא» מחזיר ל-Card את המקום. «כן» משאיר את זה נספר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नहीं Card को उसकी जगह लौटा देता है। हाँ इसे गिना हुआ रखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vraća Cardu njegov prostor. Da ostaje ubrojeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Nem visszaadja a keretet a Cardnak. Az Igen beszámítva hagyja."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ոչ»-ը Card-ին վերադարձնում է նրա տարածքը։ «Այո»-ն պահում է այն հաշվարկված։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak mengembalikan ruangnya ke Card. Ya tetap menghitungnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No restituisce il margine alla Card. Sì lo lascia conteggiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「いいえ」を選ぶとCardの枠が戻ります。「はい」を選ぶとカウントされたままです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "„არა“ Card-ს სივრცეს უბრუნებს. „დიახ“ დათვლილად ტოვებს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "«ទេ» ឱ្យកន្លែងត្រឡប់ទៅ Card វិញ។ «បាទ/ចាស» រក្សាវាឱ្យនៅរាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아니요를 누르면 Card의 여유가 돌아옵니다. 예를 누르면 계속 집계됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ ຄືນພື້ນທີ່ໃຫ້ Card. ແມ່ນ ຍັງນັບຢູ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ne“ grąžina Card rezervą. „Taip“ palieka tai įskaičiuotą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Nē” atdod Card tās rezervi atpakaļ. “Jā” to patur ieskaitītu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не му го враќа просторот на Card. Да го задржува сметано."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үгүй нь Card-д зайг нь буцааж өгнө. Тийм нь тоологдсон хэвээр үлдээнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "होइनले Card लाई ठाउँ फिर्ता दिन्छ। हो ले यसलाई गणनामै राख्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nee geeft de Card zijn ruimte terug. Ja laat het meetellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nie” przywraca zapas Card. „Tak” pozostawia to policzone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não devolve a margem ao Card. Sim mantém-na contada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não devolve a margem ao Card. Sim mantém-na contada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu îi redă Cardului spațiul. Da îl lasă numărat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie vráti Card priestor. Áno ho nechá započítaný."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vrne Card prostor. Da ga pusti štetega."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo ia kthen Card-it hapësirën e tij. Po e mban të numëruar."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vraća Cardu njegov prostor. Da ostaje ubrojeno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ จะคืนพื้นที่ให้ Card ใช่ จะนับต่อไป"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýok Card-a ýerini yzyna berýär. Hawa ony hasaplananlygyna galdyrýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayır, Card'ına payını geri verir. Evet, sayılmaya devam eder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نہیں کہنے سے Card کو اس کی گنجائش واپس ملتی ہے۔ ہاں کہنے سے یہ گنا ہوا رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn Không sẽ trả lại dư địa cho Card. Chọn Có sẽ giữ nó trong số đã tính."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選「否」會把額度還給 Card。選「是」則維持計入。"
          }
        }
      }
    },
    "record.did_this_happen.why_lost": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضاع رده، لذا لا يستطيع KIFF معرفة ما إذا كان قد تم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cavabı itdi, ona görə KIFF onun keçib-keçmədiyini deyə bilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговорът му се изгуби, така че KIFF не може да каже дали е минало."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর উত্তর হারিয়ে গেছে, তাই KIFF বলতে পারে না এটি সম্পন্ন হয়েছে কি না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La seva resposta s'ha perdut, així que KIFF no pot saber si ha passat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho odpověď se ztratila, takže KIFF nepozná, jestli prošlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Antwort ging verloren, daher kann KIFF nicht sagen, ob es durchgegangen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its answer was lost, so KIFF can't tell whether it went through."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió su respuesta, así que KIFF no puede saber si se completó."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle vastus läks kaotsi, seega ei saa KIFF öelda, kas see läks läbi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa réponse a été perdue : KIFF ne peut pas savoir s'il a abouti."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התשובה שלו אבדה, ולכן KIFF לא יכול לדעת אם זה עבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसका उत्तर खो गया, इसलिए KIFF नहीं बता सकता कि यह पूरा हुआ या नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegov je odgovor izgubljen pa KIFF ne može reći je li prošlo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válasza elveszett, ezért a KIFF nem tudja, hogy átment-e."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրա պատասխանը կորավ, ուստի KIFF-ը չի կարող ասել՝ անցավ, թե ոչ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawabannya hilang, jadi KIFF tidak dapat memastikan apakah berhasil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua risposta è andata persa, quindi KIFF non può sapere se è andata a buon fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答が失われたため、完了したかどうかKIFFには分かりません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისი პასუხი დაიკარგა, ამიტომ KIFF ვერ ამბობს, გავიდა თუ არა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចម្លើយរបស់វាបាត់ ដូច្នេះ KIFF មិនអាចប្រាប់ថាវាបានជោគជ័យឬអត់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 사라져 KIFF가 처리 여부를 알 수 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຳຕອບຂອງມັນຫາຍໄປ ສະນັ້ນ KIFF ບໍ່ຮູ້ວ່າມັນຜ່ານໄປຫຼືບໍ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos atsakymas prarastas, todėl KIFF negali nustatyti, ar ji įvykdyta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā atbilde pazuda, tāpēc KIFF nevar zināt, vai tas tika izpildīts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неговиот одговор се загуби, па KIFF не може да каже дали поминало."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түүний хариу алга болсон тул KIFF нэвтэрсэн эсэхийг хэлж чадахгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसको जवाफ हरायो, त्यसैले यो पार भयो कि भएन KIFF ले भन्न सक्दैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het antwoord is verloren gegaan, dus KIFF kan niet zien of het is gelukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego odpowiedź zaginęła, więc KIFF nie wie, czy to przeszło."
