    "coach.coach_mode_has_change_request": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach-Modus muss diese Anfrage ändern, bevor du sie genehmigen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach mode has to change this request before you can approve it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo Coach tiene que cambiar esta solicitud antes de que puedas aprobarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Coachi režiim peab seda päringut muutma, enne kui saad selle kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
