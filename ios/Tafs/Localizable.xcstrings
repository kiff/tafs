    "door.api.two_keys": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens zwei Schlüssel, damit du einen ersetzen kannst, ohne den anderen zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most two keys, so you can replace one without stopping the other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como máximo dos claves, para que puedas sustituir una sin detener la otra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõige rohkem kaks võtit, et saaksid ühe asendada nii, et teine töötab edasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux clés au plus, pour pouvoir en remplacer une sans arrêter l'autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo due chiavi, così puoi sostituirne una senza fermare l'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは最大2つなので、一方を止めずにもう一方を置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 최대 두 개라서, 하나를 교체하는 동안 다른 하나를 멈추지 않아도 됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Daugiausia du raktai, kad galėtumėte pakeisti vieną, o kitas veiktų toliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vairāk kā divas atslēgas, lai vienu varētu nomainīt, kamēr otra darbojas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogstens twee sleutels, zodat je er een kunt vervangen zonder de andere te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwyżej dwa klucze, aby można było wymienić jeden bez zatrzymywania drugiego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo duas chaves, para poder substituir uma sem parar a outra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo duas chaves, para poder substituir uma sem parar a outra."
          }
        }
      }
    },
