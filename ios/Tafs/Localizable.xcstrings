        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ste to tražili pa to odobrava netko drugi na nalogu. I dalje to možete odbiti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเป็นผู้ขอรายการนี้ ผู้อื่นในบัญชีจึงอนุมัติ คุณยังปฏิเสธได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu siz istediniz, bu yüzden hesaptaki başka biri onaylar. Yine de reddedebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính bạn yêu cầu việc này nên người khác trên tài khoản sẽ phê duyệt. Bạn vẫn có thể từ chối."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是您提出的請求，因此由帳號中的其他人核准。您仍然可以拒絕。"
          }
        }
      }
    },
    "needs_you.refused.signed_in_approver": {
      "extractionState": "manual",
      "localizations": {
        "az": {
