        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისგან არაფერი მუშაობს, სანამ არ განაახლებთ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재개할 때까지 아무것도 실행되지 않습니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas iš jo nevykdoma, kol jo netęsite"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas no tā nedarbojas, līdz tu to turpini"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er draait niets van tot je het hervat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic z niego nie działa, dopóki go nie wznowisz"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada dele é executado até o retomar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada dele é executado até o retomar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic din el nu rulează până nu îl reluați"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič z neho nebeží, kým ho neobnovíte"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič od njega ne teče, dokler ga ne nadaljujete"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Asgjë prej tij nuk ekzekutohet derisa ta riniseni"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa od njega ne radi dok ga ne nastavite"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรของมันทำงานจนกว่าคุณจะให้ทำต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz sürdürene kadar ondan hiçbir şey çalışmaz"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì của nó chạy cho đến khi bạn cho tiếp tục"
