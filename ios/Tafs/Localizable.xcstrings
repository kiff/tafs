        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍນິ້ວມືຂອງທ່ານເພີ່ງປ່ຽນ. ລອງໃໝ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ką tik pasikeitė jūsų piršto atspaudai. Bandykite dar kartą."
