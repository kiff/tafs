        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您必須年滿 %1$@ 歲。"
          }
        }
      }
    },
    "onboarding.card_lead": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər taf sizin verdiyiniz Card daxilində işləyir: nə edə bilər, hansı tətbiqlə və nə qədər. Ondan kənarda sizdən soruşur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки taf работи в рамките на Card, която издавате: какво може да прави, с кое приложение и колко. Отвъд нея ви пита."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý taf pracuje v rámci Card, kterou vydáte: co smí dělat, v které aplikaci a za kolik. Nad rámec se zeptá vás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder taf arbeitet innerhalb einer Card, die du ausstellst: was er darf, mit welcher App und wie viel. Darüber hinaus fragt er dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each taf works within a Card you issue: what it may do, with which app, and how much. Past it, it asks you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada taf trabaja dentro de una Card que tú emites: qué puede hacer, con qué app y cuánto. Más allá, te pregunta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga taf töötab sinu väljastatud Cardi piires: mida see tohib teha, millise rakendusega ja kui palju. Sellest kaugemale minnes küsib see sinult."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque taf travaille dans le cadre d'une Card que vous émettez : ce qu'il peut faire, avec quelle app et pour combien. Au-delà, il vous demande."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki taf radi unutar Carda koji mu izdate: što smije raditi, s kojom aplikacijom i koliko. Izvan toga pita vas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden taf az általad kiadott Card keretein belül dolgozik: mit tehet, melyik alkalmazással és mennyiért. Azon túl téged kérdez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր taf աշխատում է ձեր թողարկած Card-ի շրջանակներում՝ ինչ կարող է անել, որ հավելվածով և որքան։ Դրանից դուրս նա հարցնում է ձեզ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap taf bekerja dalam Card yang Anda terbitkan: apa yang boleh dilakukan, dengan aplikasi apa, dan seberapa banyak. Di luar itu, taf bertanya kepada Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni taf lavora entro una Card che emetti tu: cosa può fare, con quale app e quanto. Oltre, ti chiede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各tafは、あなたが発行したCardの範囲内で働きます。何をしてよいか、どのアプリで、いくらまでかをCardが決めます。それを超えるときは、あなたに確認します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითოეული taf მუშაობს თქვენ მიერ გაცემული Card-ის ფარგლებში: რისი გაკეთება შეუძლია, რომელ აპთან და რამდენად. მის მიღმა გეკითხებათ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 taf는 내가 발급한 Card 안에서 일합니다. 무엇을, 어떤 앱으로, 얼마까지 할 수 있는지 정하고, 그 이상은 나에게 물어봅니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas taf dirba jūsų išduotos Card ribose: ką jis gali daryti, su kuria programėle ir už kiek. Už šių ribų jis klausia jūsų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katrs taf strādā tevis izsniegtas Card ietvaros: ko tas drīkst darīt, ar kuru lietotni un par cik. Ārpus tās tas jautā tev."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke taf werkt binnen een Card die jij uitgeeft: wat hij mag, met welke app en hoeveel. Daarbuiten vraagt hij het jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy taf działa w ramach Card, którą wydajesz: co może robić, w jakiej aplikacji i za ile. Poza tym pyta Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada taf trabalha dentro de uma Card que emite: o que pode fazer, com que app e quanto. Para além disso, pergunta-lhe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada taf trabalha dentro de um Card que você emite: o que pode fazer, com qual app e quanto. Além disso, ele pergunta a você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare taf lucrează în limitele unui Card pe care îl emiteți: ce poate face, cu ce aplicație și cât. Dincolo de el, vă întreabă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý taf pracuje v rámci Card, ktorú vydáte: čo smie robiť, v ktorej aplikácii a za koľko. Nad rámec sa opýta vás."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak taf dela v okviru Card, ki jo izdate: kaj sme, s katero aplikacijo in koliko. Zunaj tega vpraša vas."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo taf punon brenda një Card-i që lëshoni ju: çfarë mund të bëjë, me cilin aplikacion dhe sa. Përtej tij, ju pyet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki taf radi unutar Carda koji mu izdate: šta sme raditi, s kojom aplikacijom i koliko. Izvan toga pita vas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละ taf ทำงานภายใน Card ที่คุณออกให้: สิ่งที่ทำได้ กับแอปใด และมากเท่าใด เกินกว่านั้นมันจะถามคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her taf, sizin verdiğiniz bir Card içinde çalışır: neyi, hangi uygulamayla ve ne kadar yapabileceği. Bunun ötesinde size sorar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi taf làm việc trong một Card do bạn cấp: nó được làm gì, với ứng dụng nào và ở mức nào. Ngoài đó, nó hỏi bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個 taf 都在您發出的 Card 範圍內運作：它能做什麼、使用哪個 App、金額多少。超出範圍，它會先詢問您。"
          }
        }
      }
    },
