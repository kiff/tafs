    "chat.steer.stopped_before_read": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast ihn gestoppt, bevor er das gelesen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stopped it before it read this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo detuviste antes de que lo leyera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõpetasid selle enne, kui see seda luges."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous l'avez arrêté avant qu'il ne le lise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hai fermato prima che lo leggesse."
