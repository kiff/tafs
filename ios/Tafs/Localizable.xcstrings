    "record.extra_room_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Card hat den Spielraum für diese Summe bekommen, bis sie zurückgesetzt wird. Liegt der Aufruf auch über einem Limit für einen Aufruf, wird er dafür erneut zurückgehalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its Card got the room for this total, until it resets. Over a limit for one call as well, the call is held again for that"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su Card obtuvo el margen para este total, hasta que se reinicie. Si también supera un límite por llamada, la llamada vuelve a quedar retenida por eso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Card a obtenu la marge pour ce total, jusqu'à sa remise à zéro. Si l'appel dépasse aussi une limite pour un appel, il est à nouveau retenu pour celle-ci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua Card ha ricevuto il margine per questo totale, finché non si azzera. Se supera anche un limite per singola chiamata, la chiamata viene trattenuta di nuovo per quello"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zijn Card kreeg de ruimte voor dit totaal, tot het wordt gereset. Gaat de aanroep ook boven een limiet voor één aanroep, dan wordt hij daarvoor opnieuw vastgehouden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego Card dostała zapas na tę sumę, do jej wyzerowania. Jeśli przekracza też limit na jedno wywołanie, wywołanie znowu jest z tego powodu oczekujące"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu Card recebeu a margem para este total, até ser reposto. Se também exceder um limite por chamada, a chamada fica novamente retida por isso"
          }
        }
      }
    },
