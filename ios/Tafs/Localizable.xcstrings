    "needs_you.answer_in_kiff": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworte diese in KIFF. Antworten vom Telefon kommen an, sobald KIFF die Signatur des Telefons prüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer this one in KIFF. Answering from the phone arrives once KIFF checks the phone's signature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde a esta en KIFF. Las respuestas desde el teléfono llegarán cuando KIFF compruebe la firma del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez à celle-ci dans KIFF. Une réponse depuis le téléphone arrive dès que KIFF vérifie la signature du téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi a questa in KIFF. Le risposte dal telefono arrivano quando KIFF verifica la firma del telefono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord deze in KIFF. Antwoorden vanaf de telefoon komt aan zodra KIFF de handtekening van de telefoon controleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedz na to w KIFF. Odpowiadanie z telefonu zadziała, gdy KIFF zacznie sprawdzać podpis telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda a este no KIFF. As respostas a partir do telefone chegam quando o KIFF verificar a assinatura do telefone."
          }
        }
      }
    },
