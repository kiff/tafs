    "taf.memory.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء بعد. يدوّن ما يتعلمه عن الطريقة التي تحب أن تُنجَز بها المهمة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ heç nə yoxdur. O, işin sizin necə xoşunuza gəldiyi barədə öyrəndiklərini yazır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още нищо. Записва какво научава за това как искате да се свърши работата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কিছু নেই। কাজ আপনি কীভাবে করাতে পছন্দ করেন সে সম্পর্কে এটি যা শেখে তা লিখে রাখে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha res. Anota el que va aprenent sobre com t'agrada que es faci la feina."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nic. Zapisuje si, co se naučí o tom, jak chcete práci dělat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts. Er schreibt auf, was er darüber lernt, wie du die Aufgabe erledigt haben möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet. It writes down what it learns about how you like the job done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada todavía. Anota lo que aprende sobre cómo te gusta que se haga el trabajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Veel midagi pole. See paneb kirja, mida õpib selle kohta, kuidas sulle töö tegemine meeldib."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l'instant. Il note ce qu'il apprend sur la façon dont vous aimez que le travail soit fait."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין כלום. הוא רושם מה שהוא לומד על האופן שבו אתה אוהב שהעבודה תיעשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कुछ नहीं। यह लिख लेता है कि आप काम कैसे करवाना पसंद करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još ništa. Zapisuje što uči o tome kako volite da se posao radi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még semmi. Feljegyzi, amit megtud arról, hogyan szereted, ha a munka el van végezve."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեռ ոչինչ։ Այն գրի է առնում, թե ինչ է սովորում այն մասին, թե ինչպես եք ուզում, որ աշխատանքը կատարվի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada apa-apa. Ia mencatat apa yang dipelajarinya tentang cara Anda ingin tugas dikerjakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente. Annota ciò che impara su come preferisci che faccia il lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだありません。仕事の進め方についてあなたの好みを学ぶと、ここに書き留めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არაფერი. ის იწერს, რას სწავლობს იმის შესახებ, როგორ გინდათ სამუშაოს შესრულება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនទាន់មានអ្វីនៅឡើយ។ វាកត់ត្រាអ្វីដែលវាសិក្សាអំពីរបៀបដែលអ្នកចូលចិត្តឱ្យការងារត្រូវបានធ្វើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 없습니다. 내가 원하는 일 처리 방식에 대해 배운 것을 적어 둡니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍັງບໍ່ມີຫຍັງ. ມັນຈົດສິ່ງທີ່ມັນຮຽນຮູ້ກ່ຽວກັບວິທີທີ່ທ່ານມັກໃຫ້ເຮັດວຽກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kol kas nieko. Jis užsirašo, ką sužino apie tai, kaip norite, kad darbas būtų atliktas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagaidām nekā. Tas pieraksta, ko uzzina par to, kā tu vēlies, lai darbs tiktu darīts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште ништо. Запишува што учи за тоа како сакаш да се врши работата."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Одоогоор юу ч алга. Таны ажлыг хэрхэн хийлгэх дуртайг сурсан зүйлээ тэмдэглэнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अहिलेसम्म केही छैन। तपाईंलाई काम कसरी गरिएको मन पर्छ भन्ने सिकेका कुरा यसले लेख्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets. Het schrijft op wat het leert over hoe jij het werk gedaan wilt hebben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nic. Zapisuje to, czego się dowie o tym, jak chcesz, żeby wykonywał zadanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada. Anota o que aprende sobre a forma como gosta que o trabalho seja feito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada. Anota o que aprende sobre a forma como gosta que o trabalho seja feito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic deocamdată. Notează ce învață despre cum vă place să fie făcută treaba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nič. Zapisuje si, čo sa naučí o tom, ako chcete prácu robiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še nič. Zapisuje si, kar se nauči o tem, kako želite, da je delo opravljeno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende asgjë. Shkruan atë që mëson se si ju pëlqen që të kryhet puna."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Još ništa. Zapisuje šta uči o tome kako volite da se posao radi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีอะไร มันจดสิ่งที่เรียนรู้เกี่ยวกับวิธีที่คุณชอบให้ทำงาน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Heniz hiç zat ýok. Ol işiň siziň islän ýaly edilmegi barada öwrenen zadyny ýazýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir şey yok. İşin nasıl yapılmasını istediğinizle ilgili öğrendiklerini not eder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کچھ نہیں۔ یہ لکھ لیتا ہے کہ آپ کام کیسے کروانا پسند کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì. Nó ghi lại những gì học được về cách bạn muốn công việc được làm."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有內容。它會記下學到的、關於您希望如何完成工作的事項。"
          }
        }
      }
    },
    "taf.memory.explains": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ كل تشغيل ومحادثة بهذه. تشكّل طريقة عمله، ولا تغيّر أبدًا ما تسمح به الـ Card الخاصة به. «النسيان» يزيل تلك الملاحظة وحدها ونسخها السابقة؛ وتبقى المحادثات السابقة وتقارير التشغيل حتى يُزال الـ taf."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər iş və söhbət bunlarla başlayır. Onlar necə işlədiyini formalaşdırır, Card-ın nəyə icazə verdiyini yox. «Unutun» həmin qeydi və onun əvvəlki versiyalarını silir; keçmiş söhbətlər və iş hesabatları taf silinənə qədər qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко изпълнение и чат започва с тези бележки. Те оформят как работи, никога какво позволява неговата Card. „Забравяне“ премахва тази бележка и предишните ѝ версии; минали чатове и отчети за изпълнения остават, докато taf не бъде премахнат."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি রান ও চ্যাট এগুলো দিয়ে শুরু হয়। এগুলো ঠিক করে এটি কীভাবে কাজ করে, Card কী অনুমতি দেয় তা নয়। «ভুলে যান» সেই একটি নোট ও এর আগের সংস্করণ সরায়; আগের চ্যাট ও রান রিপোর্ট taf সরানো পর্যন্ত থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada execució i xat comença amb això. Donen forma a com treballa, mai al que el seu Card permet. «Oblida» treu aquesta nota i les seves versions anteriors; els xats passats i els informes d'execució es queden fins que el taf s'elimini."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý běh a chat začíná s těmito poznámkami. Ovlivňují, jak pracuje, nikdy co jeho Card dovoluje. Zapomenout odstraní tu jednu poznámku a její dřívější verze; minulé chaty a zprávy z běhů zůstávají, dokud se taf neodstraní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Lauf und jeder Chat beginnt damit. Sie prägen, wie er arbeitet, nie, was seine Card erlaubt. „Vergessen“ entfernt genau diese Notiz und ihre früheren Versionen; frühere Chats und Laufberichte bleiben, bis der taf entfernt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every run and chat starts with these. They shape how it works, never what its Card allows. Forget removes that one note and its earlier versions; past chats and run reports stay until the taf is removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ejecución y cada chat empiezan con estas notas. Determinan cómo trabaja, nunca lo que permite su Card. Olvidar quita esa nota y sus versiones anteriores; los chats e informes de ejecución pasados se conservan hasta que se elimina el taf."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga käivitus ja vestlus algab nendega. Need mõjutavad seda, kuidas see töötab, mitte kunagi seda, mida selle Card lubab. Unusta eemaldab selle ühe märkme ja selle varasemad versioonid; varasemad vestlused ja käivituste aruanded jäävad alles, kuni taf eemaldatakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque exécution et chaque chat commencent par celles-ci. Elles façonnent sa manière de travailler, jamais ce que sa Card autorise. Oublier supprime cette note et ses versions antérieures ; les anciens chats et rapports d'exécution restent jusqu'à la suppression du taf."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל ריצה וכל שיחה מתחילות עם אלה. הן מעצבות איך הוא עובד, אף פעם לא מה שה-Card שלו מתיר. «שכחה» מסירה את ההערה הזו ואת הגרסאות הקודמות שלה; שיחות קודמות ודוחות ריצה נשארים עד שה-taf יוסר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर रन और चैट इनसे शुरू होती है। ये तय करते हैं कि यह कैसे काम करता है, कभी यह नहीं कि उसका Card क्या अनुमति देता है। भूलें उस एक नोट और उसके पुराने संस्करण हटाता है; पिछली चैट और रन रिपोर्ट taf के हटाए जाने तक रहती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako izvođenje i razgovor počinju s ovim. Oblikuju kako radi, nikad što njegov Card dopušta. Zaboravljanje uklanja tu jednu bilješku i njezine ranije verzije; prošli razgovori i izvješća izvođenja ostaju dok se taf ne ukloni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden futás és csevegés ezekkel indul. Azt alakítják, hogyan dolgozik, soha azt, amit a Cardja enged. Az Elfelejtés csak azt az egy jegyzetet és korábbi verzióit távolítja el; a korábbi csevegések és futási jelentések a taf eltávolításáig megmaradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր գործարկում և զրույց սկսվում է սրանցով։ Դրանք ձևավորում են, թե ինչպես է աշխատում, երբեք՝ թե ինչ է թույլատրում նրա Card-ը։ «Մոռանալը» հեռացնում է այդ մեկ նշումը և նրա նախորդ տարբերակները․ անցյալ զրույցները և գործարկումների հաշվետվությունները մնում են, մինչև taf-ը հեռացվի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap eksekusi dan obrolan dimulai dengan ini. Ini membentuk cara kerjanya, tidak pernah apa yang diizinkan Card-nya. Lupakan menghapus satu catatan itu dan versi sebelumnya; obrolan lama dan laporan eksekusi tetap ada sampai taf dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni esecuzione e ogni chat partono da queste. Influenzano come lavora, mai ciò che la sua Card consente. Dimentica rimuove quella nota e le sue versioni precedenti; le chat passate e i resoconti delle esecuzioni restano finché il taf non viene rimosso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての実行とチャットはこれらのメモから始まります。メモは働き方に影響しますが、Cardが許可する範囲は変わりません。「忘れる」を選ぶとそのメモと以前のバージョンが削除されます。過去のチャットと実行レポートはtafが削除されるまで残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყოველი გაშვება და ჩატი ამით იწყება. ისინი განსაზღვრავენ, როგორ მუშაობს, არასოდეს იმას, რასაც მისი Card უშვებს. „დავიწყება“ შლის იმ ერთ ჩანაწერს და მის ადრინდელ ვერსიებს; წარსული ჩატები და გაშვების ანგარიშები რჩება, სანამ taf არ წაიშლება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រាល់ការដំណើរការ និងការសន្ទនាចាប់ផ្តើមជាមួយទាំងនេះ។ ពួកវាកំណត់ទម្រង់របៀបដែលវាធ្វើការ មិនមែនអ្វីដែល Card របស់វាអនុញ្ញាតទេ។ «ភ្លេច» ដកកំណត់ត្រានោះ និងកំណែមុនៗរបស់វាចេញ; ការសន្ទនាកន្លងមក និងរបាយការណ៍ការដំណើរការនៅរហូតដល់ taf ត្រូវបានដកចេញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 실행과 채팅은 이 메모로 시작합니다. 메모는 일하는 방식을 정할 뿐, Card가 허용하는 범위는 바꾸지 않습니다. 잊기를 누르면 그 메모와 이전 버전만 삭제되며, 지난 채팅과 실행 보고서는 taf를 삭제할 때까지 남습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທຸກການເຮັດວຽກ ແລະ ການສົນທະນາເລີ່ມຈາກສິ່ງເຫຼົ່ານີ້. ມັນກຳນົດວິທີທີ່ມັນເຮັດວຽກ, ບໍ່ແມ່ນສິ່ງທີ່ Card ຂອງມັນອະນຸຍາດ. ລືມລຶບບັນທຶກນັ້ນ ແລະ ເວີຊັນກ່ອນໆຂອງມັນ; ການສົນທະນາທີ່ຜ່ານມາ ແລະ ລາຍງານການເຮັດວຽກຍັງຢູ່ຈົນກວ່າຈະເອົາ taf ອອກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas paleidimas ir pokalbis prasideda nuo jų. Jos lemia, kaip jis dirba, bet niekada – ką leidžia jo Card. „Pamiršti“ pašalina tą vieną pastabą ir ankstesnes jos versijas; ankstesni pokalbiai ir paleidimų ataskaitos lieka, kol taf pašalinamas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katra palaišana un saruna sākas ar šīm piezīmēm. Tās nosaka, kā tas strādā, nekad ne to, ko atļauj tā Card. “Aizmirst” noņem šo vienu piezīmi un tās iepriekšējās versijas; iepriekšējās sarunas un palaišanu ziņojumi paliek, līdz taf tiek noņemts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секое извршување и разговор започнува со овие. Тие го обликуваат начинот на работа, никогаш она што го дозволува неговиот Card. Заборави ја отстранува таа белешка и нејзините претходни верзии; минатите разговори и извештаите од извршувањата остануваат додека не се отстрани tafот."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ажиллалт, чат бүр эдгээрээр эхэлнэ. Эдгээр нь түүний ажиллах арга барилыг тодорхойлдог, Card-ынх нь зөвшөөрсөн зүйлийг хэзээ ч биш. Мартах нь тэр тэмдэглэл болон түүний өмнөх хувилбаруудыг хасна; өнгөрсөн чат болон ажиллалтын тайлан taf-ыг хасах хүртэл үлдэнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक चलाइ र च्याट यिनैबाट सुरु हुन्छ। यिनले यो कसरी काम गर्छ त्यसलाई आकार दिन्छन्, यसको Card ले के अनुमति दिन्छ त्यसलाई होइन। बिर्सनुहोस्ले त्यो एउटा टिपोट र यसका पुराना संस्करण हटाउँछ; पुराना च्याट र चलाइका रिपोर्ट taf हटाइएसम्म रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke run en chat begint hiermee. Ze bepalen hoe het werkt, nooit wat zijn Card toestaat. Vergeten verwijdert die ene notitie en de eerdere versies ervan; eerdere chats en runrapporten blijven tot het taf wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde uruchomienie i czat zaczyna się od tych notatek. Kształtują sposób jego pracy, nigdy to, na co pozwala jego Card. Zapomnij usuwa tę jedną notatkę i jej wcześniejsze wersje; dawne czaty i raporty z uruchomień zostają do usunięcia tafa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada execução e cada chat começam com estas notas. Moldam a forma como trabalha, nunca o que o seu Card permite. Esquecer remove essa nota e as suas versões anteriores; os chats e relatórios de execução passados mantêm-se até o taf ser removido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada execução e cada chat começam com estas notas. Moldam a forma como trabalha, nunca o que o seu Card permite. Esquecer remove essa nota e as suas versões anteriores; os chats e relatórios de execução passados mantêm-se até o taf ser removido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare rulare și conversație începe cu acestea. Influențează cum lucrează, niciodată ce îi permite Cardul. Uitați elimină acea notiță și versiunile ei anterioare; conversațiile și rapoartele de rulare trecute rămân până la eliminarea tafului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý beh a chat začína s týmito poznámkami. Ovplyvňujú, ako pracuje, nikdy čo jeho Card dovoľuje. Zabudnúť odstráni tú jednu poznámku a jej skoršie verzie; minulé chaty a správy z behov zostávajú, kým sa taf neodstráni."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak zagon in klepet se začne s temi zapiski. Oblikujejo, kako dela, nikoli tega, kar dovoli njegova Card. Pozabi odstrani ta en zapisek in njegove prejšnje različice; pretekli klepeti in poročila o zagonih ostanejo, dokler taf ni odstranjen."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo ekzekutim dhe bisedë fillon me këto. Ato formësojnë mënyrën si punon, kurrë atë që lejon Card-i i tij. Harro e heq atë shënim dhe versionet e tij të mëparshme; bisedat e kaluara dhe raportet e ekzekutimeve mbeten derisa të hiqet taf-i."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako izvršavanje i razgovor počinju s ovim. Oblikuju kako radi, nikad šta njegov Card dopušta. Zaboravljanje uklanja tu jednu belešku i njene ranije verzije; prošli razgovori i izveštaja izvršavanja ostaju dok se taf ne ukloni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกการทำงานและแชตเริ่มด้วยสิ่งเหล่านี้ มันกำหนดวิธีที่มันทำงาน ไม่เคยกำหนดสิ่งที่ Card ของมันอนุญาต การลืมจะลบบันทึกนั้นและเวอร์ชันก่อนหน้า แชตและรายงานการทำงานที่ผ่านมายังอยู่จนกว่า taf จะถูกนำออก"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Her işleme we söhbetdeşlik şulardan başlaýar. Olar onuň nähili işleýşini kesgitleýär, hiç haçan Card-yň rugsat berýänini däl. Unut diňe şol bir belligi we onuň öňki wersiýalaryny aýyrýar; öňki söhbetdeşlikler we işleme hasabatlary taf aýrylýança galýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her çalıştırma ve sohbet bunlarla başlar. Nasıl çalıştığını şekillendirir, Card'ının neye izin verdiğini asla. Unut, yalnızca o notu ve önceki sürümlerini kaldırır; geçmiş sohbetler ve çalıştırma raporları taf kaldırılana kadar kalır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر رن اور چیٹ انہی سے شروع ہوتی ہے۔ یہ طے کرتے ہیں کہ یہ کیسے کام کرتا ہے، کبھی یہ نہیں کہ اس کا Card کیا اجازت دیتا ہے۔ بھلانے سے وہی ایک نوٹ اور اس کے پہلے ورژن ہٹ جاتے ہیں؛ پچھلی چیٹس اور رن رپورٹس taf ہٹنے تک رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lượt chạy và cuộc trò chuyện đều bắt đầu bằng những ghi chú này. Chúng định hình cách nó làm việc, không bao giờ định hình điều Card của nó cho phép. Quên sẽ xóa ghi chú đó và các phiên bản trước của nó; các cuộc trò chuyện và báo cáo lượt chạy trước đây vẫn còn cho đến khi taf bị gỡ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次執行和對話都以這些內容為起點。它們影響它的做事方式，但絕不影響它的 Card 允許什麼。「忘記」會移除那則備註及其先前版本；過去的對話和執行報告會保留到 taf 被移除為止。"
          }
        }
      }
    },
