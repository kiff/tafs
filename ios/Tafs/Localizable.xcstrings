    "needs_you.over_total": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز إجمالي الـ Card، كإجمالي يوم مثلًا. يستطيع من يدير الـ Cards منحه مساحة إضافية، أو يمكنك رفضه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, Card cəmini, məsələn günlük cəmi aşır. Card-ları idarə edən biri ona əlavə yer verə bilər, ya da siz onu rədd edə bilərsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Надвишава общ лимит на Card, например дневния. Който управлява Cards, може да му даде допълнителен лимит, или можете да го откажете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি Card-এর মোট, যেমন দিনের মোট, ছাড়িয়ে যায়। যিনি Card পরিচালনা করেন তিনি এতে বাড়তি জায়গা দিতে পারেন, অথবা আপনি এটি প্রত্যাখ্যান করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera un total del Card, com ara el d'un dia. Qui gestiona els Card li pot donar marge addicional, o ho pots rebutjar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překračuje celkový limit Card, například denní. Kdo spravuje Card, mu může dát víc prostoru, nebo to můžete odmítnout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es liegt über einer Summe der Card, etwa einer Tagessumme. Jemand, der die Cards verwaltet, kann ihm Zusatzspielraum geben, oder du lehnst es ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's over a Card total, such as a day's. Someone who manages the Cards can give it extra room, or you can refuse it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera un total de la Card, como el de un día. Alguien que gestione las Cards puede darle margen extra, o puedes rechazarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ületab Cardi kogusumma, näiteks päevase. Cardide haldaja saab sellele lisaruumi anda või võid sa sellest keelduda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela dépasse un total de la Card, par exemple sur une journée. Une personne qui gère les Cards peut lui donner une marge supplémentaire, ou vous pouvez le refuser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מעבר לסכום כולל של Card, למשל של יום. מי שמנהל את ה-Card יכול לתת לזה מקום נוסף, או שאפשר לדחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Card के कुल से, जैसे दिन के कुल से, ऊपर है। Card सँभालने वाला कोई इसे अतिरिक्त जगह दे सकता है, या आप इसे अस्वीकार कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premašuje ukupni iznos Carda, primjerice dnevni. Netko tko upravlja Cardovima može mu dati dodatni prostor ili ga možete odbiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túllépi a Card egyik összesítő limitjét, például a napit. Aki a Cardokat kezeli, extra keretet adhat neki, vagy elutasíthatod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն գերազանցում է Card-ի ընդհանուրը, օրինակ՝ օրականը։ Card-երը կառավարողը կարող է լրացուցիչ տարածք տալ, կամ դուք կարող եք մերժել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melebihi total Card, misalnya total harian. Orang yang mengelola Card dapat memberinya ruang tambahan, atau Anda dapat menolaknya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera un totale della Card, come quello di un giorno. Chi gestisce le Card può darle un margine extra, oppure puoi rifiutarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日の合計など、Cardの合計を超えています。Cardを管理する人が枠を追加するか、あなたが拒否できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ის Card-ის ჯამს აღემატება, მაგალითად დღიურს. ვინც Card-ებს მართავს, შეუძლია დამატებითი სივრცის მიცემა, ან შეგიძლიათ უარი უთხრათ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាលើសពីសរុបរបស់ Card ដូចជាសរុបប្រចាំថ្ងៃ។ អ្នកដែលគ្រប់គ្រង Card អាចផ្តល់កន្លែងបន្ថែមឱ្យវា ឬអ្នកអាចបដិសេធវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 한도 같은 Card 합계를 넘었습니다. Card를 관리하는 사람이 추가로 허용하거나, 내가 거절할 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມັນເກີນຍອດລວມຂອງ Card ເຊັ່ນຂອງມື້ໜຶ່ງ. ຜູ້ທີ່ຈັດການ Card ໃຫ້ພື້ນທີ່ເພີ່ມໄດ້ ຫຼື ທ່ານປະຕິເສດມັນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Viršijama Card bendra suma, pvz., dienos. Kas tvarko Card, gali suteikti papildomą rezervą, arba galite ją atmesti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas pārsniedz Card kopsummu, piemēram, dienas. Kāds, kas pārvalda Card, var tam dot papildu rezervi, vai arī tu vari to atteikt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Над вкупниот износ на Card е, како на дневниот. Некој што управува со Card може да му даде дополнителен простор, или можеш да го одбиеш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ нь Card-ын нийт дүнгээс, жишээ нь өдрийнхөөс хэтэрсэн. Card-уудыг удирддаг хүн нэмэлт зай өгч болно, эсвэл та татгалзаж болно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो Card को कुनै जम्मा सीमा, जस्तै एक दिनको, भन्दा बढी भयो। Card हरू व्यवस्थापन गर्ने कसैले यसलाई थप ठाउँ दिन सक्छन्, वा तपाईं अस्वीकार गर्न सक्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gaat boven een totaal van de Card, zoals dat van een dag. Iemand die de Cards beheert, kan het extra ruimte geven, of je kunt het weigeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekracza sumę Card, np. dzienną. Osoba zarządzająca Card może dać dodatkowy zapas albo możesz to odrzucić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excede um total do Card, como o de um dia. Alguém que gere os Cards pode dar-lhe margem extra, ou pode recusar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa de um total do Card, como o de um dia. Alguém que gerencia os Cards pode dar margem extra a ele, ou você pode recusar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Depășește un total al Cardului, de exemplu cel zilnic. Cine gestionează Cardurile îi poate da spațiu suplimentar, sau îl puteți refuza."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekračuje celkový limit Card, napríklad denný. Kto spravuje Card, mu môže dať viac priestoru, alebo to môžete odmietnuť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Presega skupno omejitev Card, na primer dnevno. Kdor upravlja Card, mu lahko da dodaten prostor, ali pa to zavrnete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Është mbi një total të Card-it, si ai i një dite. Dikush që menaxhon Card-et mund t'i japë hapësirë shtesë, ose mund ta refuzoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Premašuje ukupni iznos Carda, na primer dnevni. Netko ko upravlja Cardovima može mu dati dodatni prostor ili ga možete odbiti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกินยอดรวมของ Card เช่นยอดรายวัน ผู้ที่ดูแล Card สามารถเพิ่มพื้นที่ให้ หรือคุณปฏิเสธก็ได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ol Card jeminden, meselem günlük jemden, artyk. Card-lary dolandyrýan biri oňa goşmaça ýer berip biler, ýa-da siz ony ret edip bilersiňiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Card toplamını aşıyor (örneğin günlük). Card'ları yöneten biri ek pay verebilir veya reddedebilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ Card کے کل سے زیادہ ہے، جیسے دن کا کل۔ Card منظم کرنے والا کوئی فرد اسے اضافی گنجائش دے سکتا ہے، یا آپ اسے مسترد کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vượt tổng của Card, chẳng hạn tổng một ngày. Người quản lý các Card có thể cho nó thêm hạn mức, hoặc bạn có thể từ chối."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已超出 Card 的總額，例如單日總額。管理 Card 的人可以給它額外額度，或者您可以拒絕。"
          }
        }
      }
    },
    "needs_you.over_total_manager": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز إجمالي الـ Card، كإجمالي يوم مثلًا. المساحة الإضافية تسمح بهذا الطلب وحده."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, Card cəmini, məsələn günlük cəmi aşır. Əlavə yer yalnız bu çağırışı buraxır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Надвишава общ лимит на Card, например дневния. Допълнителният лимит пропуска само тази заявка."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি Card-এর মোট, যেমন দিনের মোট, ছাড়িয়ে যায়। বাড়তি জায়গা শুধু এই কলটি যেতে দেয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera un total del Card, com ara el d'un dia. El marge addicional només deixa passar aquesta crida."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překračuje celkový limit Card, například denní. Víc prostoru pustí jen toto volání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es liegt über einer Summe der Card, etwa einer Tagessumme. Zusatzspielraum lässt nur diesen Aufruf durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's over a Card total, such as a day's. Extra room lets only this call through."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera un total de la Card, como el de un día. El margen extra deja pasar solo esta llamada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ületab Cardi kogusumma, näiteks päevase. Lisaruum laseb läbi ainult selle päringu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela dépasse un total de la Card, par exemple sur une journée. La marge supplémentaire ne laisse passer que cet appel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מעבר לסכום כולל של Card, למשל של יום. מקום נוסף מאפשר רק לקריאה הזו לעבור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Card के कुल से, जैसे दिन के कुल से, ऊपर है। अतिरिक्त जगह केवल इस कॉल को जाने देती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premašuje ukupni iznos Carda, primjerice dnevni. Dodatni prostor propušta samo ovaj poziv."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túllépi a Card egyik összesítő limitjét, például a napit. Az extra keret csak ezt a hívást engedi át."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն գերազանցում է Card-ի ընդհանուրը, օրինակ՝ օրականը։ Լրացուցիչ տարածքը թողնում է անցնել միայն այս զանգը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melebihi total Card, misalnya total harian. Ruang tambahan hanya meloloskan panggilan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera un totale della Card, come quello di un giorno. Il margine extra fa passare solo questa chiamata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日の合計など、Cardの合計を超えています。枠を追加すると、この呼び出しだけが通ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ის Card-ის ჯამს აღემატება, მაგალითად დღიურს. დამატებითი სივრცე მხოლოდ ამ ზარს ატარებს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាលើសពីសរុបរបស់ Card ដូចជាសរុបប្រចាំថ្ងៃ។ កន្លែងបន្ថែមអនុញ្ញាតតែការហៅនេះប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 한도 같은 Card 합계를 넘었습니다. 추가 허용은 이 호출만 통과시킵니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມັນເກີນຍອດລວມຂອງ Card ເຊັ່ນຂອງມື້ໜຶ່ງ. ພື້ນທີ່ເພີ່ມໃຫ້ການໂທນີ້ຜ່ານເທົ່ານັ້ນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Viršijama Card bendra suma, pvz., dienos. Papildomas rezervas praleidžia tik šią užklausą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas pārsniedz Card kopsummu, piemēram, dienas. Papildu rezerve ļauj izpildīt tikai šo izsaukumu."
          }
        },
        "mk": {
