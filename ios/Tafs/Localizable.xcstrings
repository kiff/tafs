    "billing.bought_not_recorded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekauft. KIFF hat es noch nicht hinzugefügt: tafs versucht es beim nächsten Öffnen erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bought. KIFF hasn't added it yet: tafs tries again when it opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprado. KIFF aún no lo ha añadido: tafs lo vuelve a intentar al abrirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acheté. KIFF ne l'a pas encore ajouté : tafs réessaie à son ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquistato. KIFF non l'ha ancora aggiunto: tafs riprova quando si apre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekocht. KIFF heeft het nog niet toegevoegd: tafs probeert het opnieuw wanneer het opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupiono. KIFF jeszcze tego nie dodał: tafs spróbuje ponownie po otwarciu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprado. O KIFF ainda não o adicionou: o tafs tenta novamente quando abrir."
          }
        }
      }
    },
