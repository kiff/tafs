          }
        }
      }
    },
    "settings.time_zone.uses_this": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fristen zurückgehaltener Aufrufe, Aktivität, das Protokoll und was deine tafs schreiben nutzen diese Zeitzone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds' deadlines, Activity, the Record and what your tafs write use this time zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plazos de las retenciones, la Actividad, el Registro y lo que escriben tus tafs usan esta zona horaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les échéances des appels retenus, l'Activité, le Registre et ce qu'écrivent vos tafs utilisent ce fuseau horaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scadenze delle trattenute, l'Attività, il Registro e ciò che scrivono i tuoi tafs usano questo fuso orario."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines van vastgehouden aanroepen, Activiteit, het Logboek en wat je tafs schrijven gebruiken deze tijdzone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminy oczekujących wywołań, Aktywność, Rejestr i to, co piszą Twoje tafs, używają tej strefy czasowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os prazos das retenções, a Atividade, o Registo e o que os seus tafs escrevem usam este fuso horário."
          }
        }
      }
    },
    "settings.time_zone_offer.text_device": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fristen zurückgehaltener Aufrufe, Aktivität, das Protokoll und was deine tafs schreiben würden die Zeitzone auf diesem %1$@ nutzen. Dein Konto nutzt jetzt %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds' deadlines, Activity, the Record and what your tafs write would use this %3$@ time zone. Your account uses %2$@ now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plazos de las retenciones, la Actividad, el Registro y lo que escriben tus tafs usarían la zona horaria de este %1$@. Ahora tu cuenta usa %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les échéances des appels retenus, l'Activité, le Registre et ce qu'écrivent vos tafs utiliseraient le fuseau horaire de cet %1$@. Votre compte utilise actuellement %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scadenze delle trattenute, l'Attività, il Registro e ciò che scrivono i tuoi tafs userebbero il fuso orario di questo %1$@. Ora il tuo account usa %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines van vastgehouden aanroepen, Activiteit, het Logboek en wat je tafs schrijven zouden de tijdzone van deze %1$@ gebruiken. Je account gebruikt nu %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminy oczekujących wywołań, Aktywność, Rejestr i to, co piszą Twoje tafs, używałyby strefy czasowej tego urządzenia (%1$@). Twoje konto używa teraz %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os prazos das retenções, a Atividade, o Registo e o que os seus tafs escrevem passariam a usar o fuso horário deste %1$@. A sua conta usa agora %2$@."
          }
        }
      }
    },
