    "needs_you.refused.approver_only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Konto beantwortet nur ein Genehmiger zurückgehaltene Aufrufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an approver answers held calls on this account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta cuenta, solo un aprobador responde a las llamadas retenidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un approbateur répond aux appels retenus sur ce compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo account solo un approvatore risponde alle chiamate trattenute."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een goedkeurder beantwoordt vastgehouden aanroepen in dit account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym koncie na oczekujące wywołania odpowiada tylko zatwierdzający."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta conta, só um aprovador responde a chamadas retidas."
          }
        }
      }
    },
    "needs_you.refused.card_changer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Card geändert, an der das zurückgehalten wurde, daher beantwortet es ein anderer Genehmiger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You changed the Card this was held against, so another approver answers it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiaste la Card por la que esto quedó retenido, así que lo responde otro aprobador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez modifié la Card par rapport à laquelle ceci a été retenu : un autre approbateur y répond donc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai modificato la Card in base alla quale questa è stata trattenuta, quindi risponde un altro approvatore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de Card gewijzigd waartegen dit werd vastgehouden, dus een andere goedkeurder beantwoordt het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Card, przez którą to wywołanie jest oczekujące, została zmieniona przez Ciebie, więc odpowiada na nie inny zatwierdzający."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterou o Card com base no qual isto foi retido, por isso é outro aprovador que responde."
          }
        }
      }
    },
    "needs_you.refused.check_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF konnte gerade nicht prüfen, wer antworten darf. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF couldn't check who may answer just now. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no pudo comprobar ahora mismo quién puede responder. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas pu vérifier qui peut répondre pour le moment. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non è riuscito a verificare chi può rispondere in questo momento. Riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kon nu niet controleren wie mag antwoorden. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie mógł teraz sprawdzić, kto może odpowiedzieć. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não conseguiu verificar neste momento quem pode responder. Tente novamente."
          }
        }
      }
    },
    "needs_you.refused.other": {
