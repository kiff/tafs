    "door.slack.no_channels": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack botu hələ heç bir kanalı görmür. Onu Slack-da bir kanala əlavə edin, sonra yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ботът на Slack още не вижда нито един канал. Добавете го в канал в Slack и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Slacku zatím nevidí žádný kanál. Přidejte ho ve Slacku do kanálu a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Slack-Bot sieht noch keinen Kanal. Füge ihn in Slack einem Kanal hinzu und versuch es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Slack bot can't see any channel yet. Add it to a channel in Slack, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bot de Slack aún no ve ningún canal. Añádelo a un canal en Slack y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Slacki bot ei näe veel ühtegi kanalit. Lisa see Slackis mõnele kanalile ja proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bot Slack ne voit encore aucun canal. Ajoutez-le à un canal dans Slack, puis réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack bot još ne vidi nijedan kanal. Dodajte ga u kanal u Slacku, pa pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Slack-bot még egyetlen csatornát sem lát. Add hozzá egy csatornához a Slackben, majd próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack բոտը դեռ ոչ մի ալիք չի տեսնում։ Ավելացրեք այն ալիքում Slack-ում, ապա նորից փորձեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Slack belum dapat melihat saluran apa pun. Tambahkan ke sebuah saluran di Slack, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bot Slack non vede ancora nessun canale. Aggiungilo a un canale in Slack, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Slackボットにはまだチャンネルが見えません。Slackでボットをチャンネルに追加してから、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack-ის ბოტი ჯერ არც ერთ არხს ვერ ხედავს. დაამატეთ ის არხში Slack-ში, შემდეგ სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack 봇이 아직 어떤 채널도 볼 수 없습니다. Slack에서 채널에 추가한 뒤 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack botas dar nemato jokio kanalo. Pridėkite jį prie kanalo Slack programėlėje ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack bots vēl neredz nevienu kanālu. Pievieno to kanālam Slack, tad mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Slack-bot ziet nog geen kanaal. Voeg hem in Slack toe aan een kanaal en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Slacka nie widzi jeszcze żadnego kanału. Dodaj go do kanału w Slacku, a potem spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot do Slack ainda não vê nenhum canal. Adicione-o a um canal no Slack e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
