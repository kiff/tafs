    "coach.connecting_failed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqlərin qoşulması alınmadı. Yenidən cəhd etmək üçün «Başlayın» düyməsinə toxunun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свързването на приложенията ви не успя. Докоснете „Старт“, за да опитате отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení vašich aplikací nefungovalo. Klepnutím na Začít to zkusíte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verbinden deiner Apps hat nicht geklappt. Tippe auf „Starten“, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting your apps didn't work. Tap Start to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron conectar tus apps. Toca Empezar para volver a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu rakenduste ühendamine ei õnnestunud. Uuesti proovimiseks puuduta Alusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion de vos apps n'a pas fonctionné. Touchez Démarrer pour réessayer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezivanje vaših aplikacija nije uspjelo. Dodirnite Pokrenite da pokušate ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazásaid csatlakoztatása nem sikerült. Koppints az Indításra az újrapróbáláshoz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր հավելվածների միացումը չստացվեց։ Հպեք «Սկսել»՝ նորից փորձելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghubungkan aplikasi Anda tidak berhasil. Ketuk Mulai untuk mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento delle tue app non ha funzionato. Tocca Avvia per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを接続できませんでした。もう一度試すには「開始」をタップしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი აპების დაკავშირება ვერ მოხერხდა. შეეხეთ „დაწყებას“ ხელახლა საცდელად."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 연결하지 못했습니다. 다시 시도하려면 시작을 누르세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko prijungti jūsų programėlių. Palieskite „Pradėti“ ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotņu pievienošana neizdevās. Pieskaries “Sākt”, lai mēģinātu vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het koppelen van je apps is niet gelukt. Tik op Starten om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączenie Twoich aplikacji nie powiodło się. Dotknij Start, aby spróbować ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ligar as suas apps. Toque em Começar para tentar novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar os seus apps. Toque em Começar para tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarea aplicațiilor nu a reușit. Atingeți Porniți pentru a reîncerca."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojenie vašich aplikácií nefungovalo. Ťuknutím na Začať to skúsite znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezovanje vaših aplikacij ni uspelo. Tapnite Začni za nov poskus."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidhja e aplikacioneve tuaja nuk funksionoi. Prekni Fillo për të provuar sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezivanje vaših aplikacija nije uspelo. Dodirnite Pokrenite da pokušate ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อแอปของคุณไม่สำเร็จ แตะเริ่มเพื่อลองอีกครั้ง"
