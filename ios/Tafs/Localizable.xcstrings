    "pair.refused_key_registered": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Handy sagt, dass dieser %1$@ schon mit deinem Konto gekoppelt ist. Zeig einen neuen Code und scanne ihn erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone says this %1$@ is already paired with your account. Show a new code and scan it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono indica que este %1$@ ya está vinculado a tu cuenta. Muestra un código nuevo y vuelve a escanearlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefoni järgi on see %1$@ sinu kontoga juba seotud. Näita uut koodi ja skanni see uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléphone indique que %2$@ est déjà associé à votre compte. Affichez un nouveau code et scannez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono indica che questo %1$@ è già associato al tuo account. Mostra un nuovo codice e scansionalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンによると、この%1$@はすでにアカウントとペアリングされています。新しいコードを表示して、もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰에 따르면 이 %1$@은(는) 이미 내 계정과 페어링되어 있습니다. 새 코드를 표시하고 다시 스캔하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų telefonas praneša, kad šis įrenginys (%1$@) jau susietas su jūsų paskyra. Parodykite naują kodą ir nuskaitykite jį dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavs tālrunis saka, ka šis %1$@ jau ir savienots pārī ar tavu kontu. Parādi jaunu kodu un skenē to vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon zegt dat deze %1$@ al aan je account is gekoppeld. Toon een nieuwe code en scan hem opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon podaje, że to urządzenie (%1$@) jest już sparowane z Twoim kontem. Pokaż nowy kod i zeskanuj go ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O telemóvel indica que este %1$@ já está associado à sua conta. Mostre um código novo e leia-o de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular indica que este %1$@ já está associado à sua conta. Mostre um código novo e leia-o de novo."
