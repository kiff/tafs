    "watch.view_only_phone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الهاتف للعرض فقط، لذا لا يمكنك السؤال من الساعة. سجّل الدخول على هاتف يستطيع الموافقة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon yalnız baxa bilir, ona görə saatdan soruşa bilməzsiniz. Təsdiq edə bilən telefonda daxil olun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този телефон може само да преглежда, така че не можете да питате от часовника. Влезте на телефон, който може да одобрява."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোন শুধু দেখতে পারে, তাই ঘড়ি থেকে জিজ্ঞেস করতে পারবেন না। অনুমোদন করতে পারে এমন ফোনে সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest telèfon només pot veure, així que no pots preguntar des del rellotge. Inicia la sessió en un telèfon que pugui aprovar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento telefon může jen prohlížet, takže se z hodinek ptát nemůžete. Přihlaste se v telefonu, který může schvalovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Handy kann nur ansehen, daher kannst du nicht von der Uhr aus fragen. Melde dich auf einem Handy an, das genehmigen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can only view, so you can't ask from the watch. Sign in on a phone that can approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono solo puede ver, así que no puedes pedir desde el reloj. Inicia sesión en un teléfono que pueda aprobar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See telefon saab ainult vaadata, seega ei saa sa kellast küsida. Logi sisse telefonis, mis saab kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone peut seulement consulter, vous ne pouvez donc pas demander depuis la montre. Connectez-vous sur un téléphone qui peut approuver."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטלפון הזה יכול רק להציג, ולכן אי אפשר לשאול מהשעון. יש להיכנס בטלפון שיכול לאשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोन केवल देख सकता है, इसलिए आप घड़ी से नहीं पूछ सकते। मंज़ूर कर सकने वाले फ़ोन पर साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon može samo pregledavati pa ne možete pitati sa sata. Prijavite se na telefonu koji može odobravati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a telefon csak megtekinteni tud, ezért az óráról nem kérdezhetsz. Jelentkezz be egy jóváhagyásra képes telefonon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հեռախոսը կարող է միայն դիտել, ուստի ժամացույցից չեք կարող հարցնել։ Մուտք գործեք հեռախոսում, որը կարող է հաստատել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini hanya dapat melihat, jadi Anda tidak dapat bertanya dari jam tangan. Masuk di ponsel yang dapat menyetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono può solo visualizzare, quindi non puoi chiedere dall'orologio. Accedi da un telefono che può approvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンは表示のみのため、ウォッチから質問できません。承認できるスマートフォンでサインインしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ტელეფონი მხოლოდ ნახვას ახერხებს, ამიტომ საათიდან ვერ ჰკითხავთ. შედით ტელეფონზე, რომელსაც დამტკიცება შეუძლია."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទូរសព្ទនេះអាចមើលតែប៉ុណ្ណោះ ដូច្នេះអ្នកមិនអាចសួរពីនាឡិកាបានទេ។ ចូលនៅលើទូរសព្ទដែលអាចអនុម័តបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰은 보기만 할 수 있어 워치에서 물을 수 없습니다. 승인할 수 있는 휴대폰에서 로그인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂທລະສັບນີ້ເບິ່ງໄດ້ຢ່າງດຽວ ສະນັ້ນທ່ານຖາມຈາກໂມງບໍ່ໄດ້. ເຂົ້າສູ່ລະບົບໃນໂທລະສັບທີ່ອະນຸມັດໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis telefonas gali tik peržiūrėti, todėl iš laikrodžio klausti negalima. Prisijunkite telefone, kuris gali tvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis tālrunis var tikai skatīt, tāpēc no pulksteņa nevar jautāt. Pieraksties tālrunī, kas var apstiprināt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој телефон може само да гледа, па не можеш да прашуваш од часовникот. Најави се на телефон што може да одобрува."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ утас зөвхөн харах боломжтой тул цагнаасаа асууж чадахгүй. Зөвшөөрч чадах утсан дээр нэвтэрнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो फोनले हेर्न मात्र मिल्छ, त्यसैले घडीबाट सोध्न सकिँदैन। स्वीकृत गर्न सक्ने फोनमा साइन इन गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon kan alleen bekijken, dus je kunt niets vragen vanaf je horloge. Log in op een telefoon die kan goedkeuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon może tylko wyświetlać, więc nie możesz pytać z zegarka. Zaloguj się na telefonie, który może zatwierdzać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telemóvel só pode ver, por isso não pode pedir a partir do relógio. Inicie sessão num telemóvel que possa aprovar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este celular só pode ver, por isso não pode pedir a partir do relógio. Entre em um celular que possa aprovar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest telefon poate doar vizualiza, așa că nu puteți întreba de pe ceas. Conectați-vă pe un telefon care poate aproba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento telefón môže len prezerať, takže sa z hodiniek pýtať nemôžete. Prihláste sa v telefóne, ktorý môže schvaľovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta telefon lahko samo prikazuje, zato z ure ne morete spraševati. Prijavite se v telefonu, ki lahko odobrava."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky telefon mund vetëm të shikojë, ndaj nuk mund të pyesni nga ora. Hyni në një telefon që mund të miratojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon može samo pregledavati pa ne možete pitati sa sata. Prijavite se na telefonu koji može odobravati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์เครื่องนี้ดูได้อย่างเดียว คุณจึงถามจากนาฬิกาไม่ได้ เข้าสู่ระบบบนโทรศัพท์ที่อนุมัติได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon diňe görüp bilýär, şonuň üçin sagatdan soramak bolmaýar. Tassyklap bilýän telefonda giriň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon yalnızca görüntüleyebilir, bu yüzden saatten soramazsınız. Onay verebilen bir telefonda oturum açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ فون صرف دیکھ سکتا ہے، اس لیے آپ گھڑی سے پوچھ نہیں سکتے۔ ایسے فون پر سائن اِن کریں جو منظور کر سکتا ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại này chỉ xem được, nên bạn không thể hỏi từ đồng hồ. Hãy đăng nhập trên một điện thoại có thể phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
