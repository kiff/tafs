    "door.add_intro": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ üçün insanların yaza biləcəyi ünvan verin. Siz birini aktiv edənə qədər onun heç biri yoxdur və nə etdiyini yenə də Card-ı müəyyən edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте на %1$@ адрес, на който хората могат да пишат. Няма такъв, докато не включите някой, а неговата Card продължава да решава какво прави."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte %1$@ adresu, na kterou mu lidé mohou psát. Žádnou nemá, dokud ji nezapnete, a co dělá, dál rozhoduje jeho Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib %1$@ eine Adresse, an die man schreiben kann. Er hat keine, bis du eine einschaltest, und seine Card entscheidet weiterhin, was er tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give %1$@ an address people can write to. It has none until you turn one on, and its Card still decides what it does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da a %1$@ una dirección a la que la gente pueda escribir. No tiene ninguna hasta que actives una, y su Card sigue decidiendo lo que hace."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna tafile %1$@ aadress, kuhu inimesed saavad kirjutada. Sellel pole ühtegi enne, kui sa mõne sisse lülitad, ja selle Card otsustab ikka, mida see teeb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez à %1$@ une adresse à laquelle on peut écrire. Il n'en a aucune tant que vous n'en activez pas une, et sa Card décide toujours de ce qu'il fait."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dajte tafu %1$@ adresu na koju ljudi mogu pisati. Nema je dok je ne uključite, a njegov Card i dalje odlučuje što radi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj neki (%1$@) egy címet, amelyre írni lehet. Addig nincs neki, amíg be nem kapcsolsz egyet, és továbbra is a Cardja dönti el, mit tesz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվեք %1$@-ին հասցե, որին մարդիկ կարող են գրել։ Այն չունի ոչ մեկը, մինչև չմիացնեք, և նրա Card-ը դեռ որոշում է, թե ինչ է անում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri %1$@ sebuah alamat yang dapat ditulisi orang. Belum punya alamat sampai Anda mengaktifkannya, dan Card-nya tetap yang menentukan apa yang dilakukannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai a %1$@ un indirizzo a cui le persone possono scrivere. Non ne ha finché non ne attivi uno, e la sua Card decide comunque cosa fa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に、人が連絡できるアドレスを与えます。オンにするまでアドレスはなく、何をするかは引き続きCardが決めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიეცით %1$@-ს მისამართი, რომელზეც ადამიანებს შეუძლიათ წერა. მას არც ერთი არ აქვს, სანამ არ ჩართავთ, და მისი Card მაინც ადგენს, რას აკეთებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람들이 연락할 수 있는 주소를 %1$@에게 주세요. 켜기 전까지는 주소가 없으며, 무엇을 할지는 여전히 Card가 정합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suteikite %1$@ adresą, kuriuo žmonės galėtų rašyti. Jo nėra, kol jo neįjungiate, o ką jis daro, vis tiek lemia jo Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dod %1$@ adresi, uz kuru cilvēki var rakstīt. Tādas nav, kamēr tu to neieslēdz, un tā Card joprojām nosaka, ko tas dara."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef %1$@ een adres waar mensen naar kunnen schrijven. Het heeft er geen tot je er een aanzet, en zijn Card bepaalt nog steeds wat het doet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daj %1$@ adres, na który można pisać. Nie ma go, dopóki go nie włączysz, a o tym, co robi, nadal decyduje jego Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a %1$@ um endereço para onde as pessoas possam escrever. Não tem nenhum até ativar um, e o seu Card continua a decidir o que faz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a %1$@ um endereço para onde as pessoas possam escrever. Não tem nenhum até ativar um, e o seu Card continua decidindo o que faz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dați-i lui %1$@ o adresă la care oamenii pot scrie. Nu are niciuna până nu activați una, iar Cardul său decide în continuare ce face."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dajte %1$@ adresu, na ktorú mu ľudia môžu písať. Žiadnu nemá, kým ju nezapnete, a čo robí, ďalej rozhoduje jeho Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dajte %1$@ naslov, na katerega mu ljudje lahko pišejo. Nima ga, dokler ga ne vklopite, kaj naredi, pa še vedno odloča njegova Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Jepini %1$@ një adresë ku njerëzit mund të shkruajnë. Nuk ka asnjë derisa të aktivizoni një, dhe Card-i i tij vendos prapë çfarë bën."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dajte tafu %1$@ adresu na koju ljudi mogu pisati. Nema je dok je ne uključite, a njegov Card i dalje odlučuje šta radi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มอบที่อยู่ให้ %1$@ เพื่อให้ผู้คนเขียนถึงได้ มันยังไม่มีจนกว่าคุณจะเปิดสักอัน และ Card ของมันยังเป็นผู้ตัดสินว่ามันทำอะไรได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ taf'ına insanların yazabileceği bir adres verin. Siz bir tane açana kadar adresi yoktur ve ne yapacağına yine Card'ı karar verir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấp cho %1$@ một địa chỉ để mọi người viết tới. Nó chưa có địa chỉ nào cho đến khi bạn bật một cái, và Card của nó vẫn quyết định nó làm gì."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 %1$@ 提供一個大家可以寫信過去的地址。在您開啟之前它沒有地址，而且它能做什麼仍由它的 Card 決定。"
          }
        }
      }
    },
