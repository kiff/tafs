    "usage.company_billed_kiff_solo_bought": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبحت Company تُفوتَر عبر KIFF الآن. يتجدد Solo المشترى من App Store في %1$@ ما لم يُلغَ، من حساب Apple الذي اشتراه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Company indi KIFF tərəfindən ödənilir. App Store-da alınmış Solo, onu alan Apple hesabından ləğv edilməsə, %1$@ tarixində yenilənir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Company вече се таксува от KIFF. Купеният в App Store Solo се подновява на %1$@, освен ако не бъде анулиран от акаунта в Apple, който го е купил."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Company এখন KIFF বিল করে। App Store-এ কেনা Solo, যে Apple অ্যাকাউন্ট কিনেছে সেখান থেকে বাতিল না করলে, %1$@-এ নবায়ন হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Company ara el factura KIFF. El Solo comprat a l'App Store es renova el %1$@ tret que es cancel·li, des del compte d'Apple que el va comprar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Company teď účtuje KIFF. Solo koupené v App Storu se obnoví %1$@, pokud ho nezrušíte z účtu Apple, který ho koupil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Company wird jetzt über KIFF abgerechnet. Das im App Store gekaufte Solo verlängert sich am %1$@, sofern es nicht über den Apple-Account gekündigt wird, mit dem es gekauft wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Company is billed by KIFF now. The Solo bought in the App Store renews on %1$@ unless it's cancelled, from the Apple account that bought it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Company ahora la factura KIFF. El Solo comprado en App Store se renueva el %1$@ salvo que se cancele, desde la cuenta de Apple que lo compró."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Company paketi eest arveldab nüüd KIFF. App Store'ist ostetud Solo uueneb %1$@, kui seda ei tühistata Apple'i kontost, millega see osteti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Company est désormais facturé par KIFF. Le Solo acheté sur l'App Store se renouvelle le %1$@ sauf s'il est résilié, depuis le compte Apple qui l'a acheté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Company מחויב כעת על ידי KIFF. ה-Solo שנרכש ב-App Store מתחדש ב-%1$@ אלא אם הוא יבוטל, מחשבון Apple שרכש אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Company का बिल अब KIFF बनाता है। App Store में खरीदा Solo, उसे खरीदने वाले Apple खाते से रद्द न हो तो, %1$@ को नवीनीकृत होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Company se sada naplaćuje preko KIFF-a. Solo kupljen u App Storeu obnavlja se (%1$@) ako se ne otkaže, s Apple računa kojim je kupljen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Company számlázója most a KIFF. Az App Store-ban vásárolt Solo ekkor megújul: %1$@, hacsak le nem mondják az azt megvásárló Apple-fiókból."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Company-ի հաշիվը հիմա դուրս է գրում KIFF-ը։ App Store-ում գնված Solo-ն նորացվում է %1$@, եթե չեղարկվի այն Apple հաշվից, որով գնվել է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Company kini ditagih oleh KIFF. Solo yang dibeli di App Store diperpanjang pada %1$@ kecuali dibatalkan, dari akun Apple yang membelinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Company ora è fatturato da KIFF. Il Solo acquistato nell'App Store si rinnova il %1$@ se non viene annullato, dall'account Apple che l'ha acquistato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CompanyはKIFFから請求されるようになりました。App Storeで購入したSoloは、解約しない限り%1$@に更新されます。購入したApple IDから解約してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Company-ს ახლა KIFF უწერს ანგარიშს. App Store-ში ნაყიდი Solo ახლდება %1$@, თუ არ გაუქმდება იმ Apple ანგარიშიდან, რომელმაც იყიდა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឥឡូវនេះ KIFF គិតប្រាក់ Company។ Solo ដែលបានទិញក្នុង App Store នឹងបន្តនៅ %1$@ លុះត្រាតែបោះបង់ ពីគណនី Apple ដែលបានទិញវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 Company는 KIFF가 청구합니다. App Store에서 구매한 Solo는 취소하지 않으면 %1$@에 갱신됩니다. 구매한 Apple 계정에서 취소하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດຽວນີ້ KIFF ເກັບເງິນ Company. Solo ທີ່ຊື້ໃນ App Store ຈະຕໍ່ອາຍຸໃນ %1$@ ເວັ້ນແຕ່ຖືກຍົກເລີກ, ຈາກບັນຊີ Apple ທີ່ຊື້ມັນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Company planą dabar apmokestina KIFF. App Store įsigytas Solo bus atnaujintas %1$@, nebent jį atšauksite iš jį įsigijusios Apple paskyros."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Par Company tagad rēķinu izraksta KIFF. App Store pirktais Solo atjaunosies %1$@, ja vien tas netiks atcelts no Apple konta, ar kuru tas tika pirkts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Company сега го наплатува KIFF. Solo купен во App Store се обновува на %1$@ освен ако не се откаже, од Apple сметката што го купила."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Company-ийн төлбөрийг одоо KIFF нэхэмжилнэ. App Store-оос худалдаж авсан Solo нь цуцлаагүй бол үүнийг худалдаж авсан Apple бүртгэлээс %1$@-д сунгагдана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Company को बिल अब KIFF ले काट्छ। App Store बाट किनिएको Solo रद्द नगरेसम्म, यसलाई किन्ने Apple खाताबाट %1$@ मा नवीकरण हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Company wordt nu gefactureerd door KIFF. De Solo die in de App Store is gekocht, wordt op %1$@ verlengd tenzij die wordt opgezegd, via het Apple-account waarmee hij is gekocht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Company jest teraz rozliczane przez KIFF. Solo kupione w App Store odnowi się %1$@, chyba że zostanie anulowane z konta Apple, z którego je kupiono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Company é agora faturado pelo KIFF. O Solo comprado na App Store renova-se a %1$@ a menos que seja cancelado, a partir da conta Apple que o comprou."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Company é agora faturado pelo KIFF. O Solo comprado na App Store renova-se a %1$@ a menos que seja cancelado, a partir da conta Apple que o comprou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Company este acum facturat de KIFF. Solo cumpărat în App Store se reînnoiește pe %1$@, dacă nu este anulat din contul Apple care l-a cumpărat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Company teraz účtuje KIFF. Solo kúpené v App Store sa obnoví %1$@, ak ho nezrušíte z účtu Apple, ktorý ho kúpil."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Company zdaj zaračunava KIFF. Solo, kupljen v App Storu, se podaljša %1$@, razen če ga prekličete v računu Apple, s katerim je bil kupljen."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Company faturohet tani nga KIFF. Solo i blerë në App Store rinovohet më %1$@ përveç nëse anulohet, nga llogaria Apple që e bleu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Company se sada naplaćuje preko KIFF-a. Solo kupljen u App Storeu obnavlja se (%1$@) ako se ne otkaže, s Apple naloga kojim je kupljen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้ Company เรียกเก็บโดย KIFF Solo ที่ซื้อบน App Store จะต่ออายุเมื่อ %1$@ เว้นแต่ถูกยกเลิก จากบัญชี Apple ที่ซื้อ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Company indi KIFF tarapyndan hasaba goýulýar. App Store-da satyn alnan Solo, ony satyn alan Apple hasabyndan ýatyrylmasa, %1$@ täzelenýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Company artık KIFF üzerinden faturalanıyor. App Store'dan alınan Solo, iptal edilmezse %1$@ tarihinde, onu satın alan Apple hesabından yenilenir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Company کا بل اب KIFF بھیجتا ہے۔ App Store میں خریدا گیا Solo %1$@ کو تجدید ہوتا ہے جب تک منسوخ نہ کیا جائے، اس Apple اکاؤنٹ سے جس نے اسے خریدا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Company hiện do KIFF thanh toán. Solo mua trên App Store sẽ gia hạn vào %1$@ trừ khi bị hủy, từ tài khoản Apple đã mua nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Company 目前由 KIFF 計費。在 App Store 購買的 Solo 會在 %1$@ 續訂，除非取消，並從購買它的 Apple 帳號扣款。"
          }
        }
      }
    },
