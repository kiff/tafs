        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī izmaiņa nav tā, kas tika piedāvāta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze wijziging is niet wat werd aangeboden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta zmiana nie jest tą, którą zaproponowano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alteração não é a que foi proposta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alteração não é a que foi proposta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această modificare nu este cea oferită."
