        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ dari %1$@ dari Anda dan pengirim yang dipasangkan hari ini. Hanya teks: lampiran tidak dibuka, dan balasan menyebutkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ su %1$@ da te e dai mittenti associati oggi. Solo testo: gli allegati non vengono aperti, e la risposta lo dice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のあなたと登録済みの送信者からの連絡：%1$@件中%2$@件。テキストのみ：添付ファイルは開かれず、返信でその旨を伝えます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@-დან თქვენგან და დაწყვილებული გამგზავნებისგან დღეს. მხოლოდ ტექსტი: დანართები არ იხსნება და პასუხი ამას ამბობს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ក្នុងចំណោម %1$@ ពីអ្នក និងអ្នកផ្ញើដែលបានផ្គូផ្គងថ្ងៃនេះ។ អត្ថបទតែប៉ុណ្ណោះ៖ ឯកសារភ្ជាប់មិនត្រូវបានបើកទេ ហើយចម្លើយនិយាយដូច្នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 나와 등록된 발신자에게서 %1$@건 중 %2$@건. 텍스트만 받습니다: 첨부 파일은 열지 않으며, 답장에서 그렇게 알립니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ຈາກ %1$@ ຈາກທ່ານ ແລະ ຜູ້ສົ່ງທີ່ຈັບຄູ່ໃນມື້ນີ້. ຂໍ້ຄວາມເທົ່ານັ້ນ: ໄຟລ໌ແນບບໍ່ຖືກເປີດ, ແລະ ຄຳຕອບບອກແນວນັ້ນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien: %2$@ iš %1$@ – iš jūsų ir susietų siuntėjų. Tik tekstas: priedai neatidaromi, ir atsakyme tai pasakoma."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "No tevis un pārī savienotajiem sūtītājiem šodien: %2$@ no %1$@. Tikai teksts: pielikumi netiek atvērti, un atbildē tas ir pateikts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ од %1$@ од тебе и спарени испраќачи денес. Само текст: прилозите не се отвораат, а одговорот го кажува тоа."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өнөөдөр таны болон хослуулсан илгээгчдийн %1$@-аас %2$@. Зөвхөн текст: хавсралтыг нээдэггүй бөгөөд хариу үүнийг хэлнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आज तपाईं र जोडिएका पठाउनेहरूबाट %1$@ मध्ये %2$@। केवल पाठ: संलग्नहरू खोलिँदैनन्, र जवाफले यो भन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ van %1$@ van jou en gekoppelde afzenders vandaag. Alleen tekst: bijlagen worden niet geopend, en het antwoord zegt dat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ z %1$@ od Ciebie i powiązanych nadawców dziś. Tylko tekst: załączniki nie są otwierane, a odpowiedź to mówi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ de %1$@ mensagens suas e de remetentes associados hoje. Só texto: os anexos não são abertos, e a resposta indica-o."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ de %1$@ mensagens suas e de remetentes associados hoje. Só texto: os anexos não são abertos, e a resposta indica-o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ din %1$@ de la dvs. și de la expeditorii asociați azi. Doar text: atașamentele nu se deschid, iar răspunsul spune asta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes %2$@ z %1$@ od vás a spárovaných odosielateľov. Len text: prílohy sa neotvárajú a odpoveď to uvedie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes %2$@ od %1$@ od vas in seznanjenih pošiljateljev. Samo besedilo: priponke se ne odpirajo in odgovor to pove."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ nga %1$@ nga ju dhe dërguesit e çiftuar sot. Vetëm tekst: bashkëngjitjet nuk hapen, dhe përgjigjja e thotë këtë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ od %1$@ od vas i uparenih pošiljatelja danas. Samo tekst: privici se ne otvaraju, a odgovor to kaže."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ จาก %1$@ จากคุณและผู้ส่งที่จับคู่แล้ววันนี้ เฉพาะข้อความ: ไม่เปิดไฟล์แนบ และการตอบจะบอกเช่นนั้น"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu gün siz we goşalanan iberijiler tarapyndan %1$@-dan %2$@. Diňe tekst: goşundylar açylmaýar, we jogap muny aýdýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün sizden ve eşleştirilmiş gönderenlerden %2$@ / %1$@. Yalnızca metin: ekler açılmaz ve yanıt bunu belirtir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج آپ اور جوڑے گئے بھیجنے والوں کی طرف سے %1$@ میں سے %2$@۔ صرف متن: منسلکات نہیں کھولے جاتے، اور جواب میں یہ بتایا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ / %1$@ từ bạn và những người gửi đã ghép đôi hôm nay. Chỉ văn bản: tệp đính kèm không được mở, và phản hồi sẽ nói như vậy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天來自您和已配對寄件者的有 %2$@ / %1$@。僅限文字：不會開啟附件，回覆中會說明。"
          }
        }
      }
    },
