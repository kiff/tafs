    "approval.turned_off_tafs_open_settings": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ متوقف لـ tafs. افتح الإعدادات وشغّل %2$@ لـ tafs."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs üçün söndürülüb. Parametrləri açın və tafs üçün aktiv edin: %2$@."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ е изключено за tafs. Отворете Настройки и включете %2$@ за tafs."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-এর জন্য %1$@ বন্ধ করা আছে। সেটিংস খুলে tafs-এর জন্য %2$@ চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ està desactivat per a tafs. Obre els Ajustos i activa %2$@ per a tafs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je pro tafs vypnuté. Otevřete Nastavení a zapněte pro tafs %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist für tafs ausgeschaltet. Öffne die Einstellungen und schalte %2$@ für tafs ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is turned off for tafs. Open Settings and turn on %2$@ for tafs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está desactivado para tafs. Abre Ajustes y activa %2$@ para tafs."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafsi jaoks on välja lülitatud: %1$@. Ava seaded ja lülita tafsi jaoks sisse: %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est désactivé pour tafs. Ouvrez Réglages et activez %2$@ pour tafs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ כבוי עבור tafs. יש לפתוח את ההגדרות ולהפעיל את %2$@ עבור tafs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs के लिए %1$@ बंद है। सेटिंग खोलें और tafs के लिए %2$@ चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključeno je za tafs: %1$@. Otvorite Postavke i za tafs uključite sljedeće: %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez ki van kapcsolva a tafs számára: %1$@. Nyisd meg a Beállításokat, és kapcsold be ezt a tafs számára: %2$@."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը անջատված է tafs-ի համար։ Բացեք Կարգավորումները և միացրեք՝ %2$@ tafs-ի համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nonaktif untuk tafs. Buka Pengaturan dan aktifkan %2$@ untuk tafs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è disattivato per tafs. Apri Impostazioni e attiva %2$@ per tafs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsの%1$@がオフになっています。設定を開き、tafsの%2$@をオンにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ გამორთულია tafs-ისთვის. გახსენით პარამეტრები და ჩართეთ: %2$@ tafs-ისთვის."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ត្រូវបានបិទសម្រាប់ tafs។ បើកការកំណត់ ហើយបើក %2$@ សម្រាប់ tafs។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs에서 %1$@이(가) 꺼져 있습니다. 설정을 열고 tafs의 %2$@을(를) 켜세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ປິດຢູ່ສຳລັບ tafs. ເປີດການຕັ້ງຄ່າ ແລ້ວເປີດ %2$@ ສຳລັບ tafs."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs programėlei išjungtas. Atidarykite nustatymus ir įjunkite %2$@ tafs programėlei."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ir izslēgts lietotnei tafs. Atver iestatījumus un ieslēdz %2$@ lietotnei tafs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ е исклучен за tafs. Отвори Поставки и вклучи %2$@ за tafs."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs-д унтраастай байна. Тохиргоог нээгээд tafs-д %2$@-ийг асаана уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs का लागि बन्द छ। सेटिङ खोल्नुहोस् र tafs का लागि %2$@ खोल्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ staat uit voor tafs. Open Instellingen en zet %2$@ aan voor tafs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest wyłączone dla tafs. Otwórz Ustawienia i włącz %2$@ dla tafs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está desativado para o tafs. Abra as Definições e ative %2$@ para o tafs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está desativado para o tafs. Abra os Ajustes e ative %2$@ para o tafs."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ este dezactivat pentru tafs. Deschideți Configurări și activați %2$@ pentru tafs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je pre tafs vypnuté. Otvorte Nastavenia a zapnite pre tafs %2$@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je za tafs izklopljeno. Odprite Nastavitve in vklopite %2$@ za tafs."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ është joaktiv për tafs. Hapni Cilësimet dhe aktivizoni: %2$@ për tafs."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je isključen za tafs. Otvorite Podešavanja i uključite: %2$@ za tafs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ถูกปิดสำหรับ tafs เปิดการตั้งค่าแล้วเปิด %2$@ สำหรับ tafs"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs üçin öçürilen. Sazlamalary açyp, tafs üçin %2$@ açyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs için kapalı: %1$@. Ayarlar'ı açın ve tafs için şunu açın: %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs کے لیے %1$@ بند ہے۔ سیٹنگز کھولیں اور tafs کے لیے %2$@ آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang tắt đối với tafs. Hãy mở Cài đặt và bật %2$@ cho tafs."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs 的%1$@已關閉。請開啟「設定」，並為 tafs 開啟%2$@。"
          }
        }
      }
    },
