        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្គូផ្គងតែ Chrome នៅលើកុំព្យូទ័រដែលអ្នកកំពុងប្រើប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
