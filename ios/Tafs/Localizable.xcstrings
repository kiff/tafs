      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitq tanıma tafs üçün söndürülüb. Onu Sistem parametrləri › Məxfilik və təhlükəsizlik › Nitq tanıma bölməsində aktiv edin (macOS 12-də: Sistem tərcihləri › Təhlükəsizlik və məxfilik › Məxfilik › Nitq tanıma)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разпознаването на реч е изключено за tafs. Включете го в Системни настройки › Поверителност и сигурност › Разпознаване на реч (на macOS 12: Системни предпочитания › Защита и поверителност › Поверителност › Разпознаване на реч)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávání řeči je pro tafs vypnuté. Zapněte ho v Nastavení systému › Soukromí a zabezpečení › Rozpoznávání řeči (v macOS 12: Předvolby systému › Zabezpečení a soukromí › Soukromí › Rozpoznávání řeči)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung ist für tafs ausgeschaltet. Schalte sie unter Systemeinstellungen › Datenschutz & Sicherheit › Spracherkennung ein (unter macOS 12: Systemeinstellungen › Sicherheit › Datenschutz › Spracherkennung)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is off for tafs. Turn it on in System Settings › Privacy & Security › Speech Recognition (on macOS 12: System Preferences › Security & Privacy › Privacy › Speech Recognition)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz está desactivado para tafs. Actívalo en Ajustes del Sistema › Privacidad y seguridad › Reconocimiento de voz (en macOS 12: Preferencias del Sistema › Seguridad y privacidad › Privacidad › Reconocimiento de voz)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõnetuvastus on tafsi jaoks välja lülitatud. Lülita see sisse menüüs System Settings › Privacy & Security › Speech Recognition (macOS 12-s: System Preferences › Security & Privacy › Privacy › Speech Recognition)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est désactivée pour tafs. Activez-la dans Réglages Système › Confidentialité et sécurité › Reconnaissance vocale (sous macOS 12 : Préférences Système › Sécurité et confidentialité › Confidentialité › Reconnaissance vocale)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje govora je isključeno za tafs. Uključite ga u Postavke sustava › Privatnost i sigurnost › Prepoznavanje govora (macOS 12: Postavke sustava › Sigurnost i privatnost › Privatnost › Prepoznavanje govora)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszédfelismerés ki van kapcsolva a tafs számára. Kapcsold be itt: Rendszerbeállítások › Adatvédelem és biztonság › Beszédfelismerés (macOS 12-n: Rendszerbeállítások › Biztonság és adatvédelem › Adatvédelem › Beszédfelismerés)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խոսքի ճանաչումը անջատված է tafs-ի համար։ Միացրեք՝ Համակարգի կարգավորումներ › Գաղտնիություն և անվտանգություն › Խոսքի ճանաչում (macOS 12-ում՝ Համակարգի նախապատվություններ › Անվտանգություն և գաղտնիություն › Գաղտնիություն › Խոսքի ճանաչում)։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengenalan ucapan nonaktif untuk tafs. Aktifkan di Pengaturan Sistem › Privasi & Keamanan › Pengenalan Ucapan (di macOS 12: Preferensi Sistem › Keamanan & Privasi › Privasi › Pengenalan Ucapan)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale è disattivato per tafs. Attivalo in Impostazioni di Sistema › Privacy e sicurezza › Riconoscimento vocale (su macOS 12: Preferenze di Sistema › Sicurezza e privacy › Privacy › Riconoscimento vocale)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macでtafsの音声認識がオフになっています。システム設定 › プライバシーとセキュリティ › 音声認識でオンにしてください（macOS 12：システム環境設定 › セキュリティとプライバシー › プライバシー › 音声認識）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მეტყველების ამოცნობა გამორთულია tafs-ისთვის. ჩართეთ სისტემის პარამეტრები › კონფიდენციალურობა და უსაფრთხოება › მეტყველების ამოცნობა (macOS 12-ზე: სისტემის პარამეტრები › უსაფრთხოება და კონფიდენციალურობა › კონფიდენციალურობა › მეტყველების ამოცნობა)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 tafs의 음성 인식이 꺼져 있습니다. 시스템 설정 › 개인정보 보호 및 보안 › 음성 인식에서 켜세요(macOS 12: 시스템 환경설정 › 보안 및 개인 정보 보호 › 개인 정보 보호 › 음성 인식)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalbos atpažinimas programėlei tafs išjungtas. Įjunkite jį skiltyje Sistemos nustatymai › Privatumas ir sauga › Kalbos atpažinimas (macOS 12: Sistemos nuostatos › Sauga ir privatumas › Privatumas › Kalbos atpažinimas)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Runas atpazīšana lietotnei tafs ir izslēgta. Ieslēdz to sadaļā Sistēmas iestatījumi › Privātums un drošība › Runas atpazīšana (macOS 12: Sistēmas preferences › Drošība un privātums › Privātums › Runas atpazīšana)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraakherkenning staat uit voor tafs. Zet het aan in Systeeminstellingen › Privacy en beveiliging › Spraakherkenning (op macOS 12: Systeemvoorkeuren › Beveiliging en privacy › Privacy › Spraakherkenning)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie mowy jest wyłączone dla tafs. Włącz je w Ustawienia systemowe › Prywatność i ochrona › Rozpoznawanie mowy (w macOS 12: Preferencje systemowe › Ochrona i prywatność › Prywatność › Rozpoznawanie mowy)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está desativado para o tafs. Ative-o em Definições do Sistema › Privacidade e segurança › Reconhecimento de fala (no macOS 12: Preferências do Sistema › Segurança e privacidade › Privacidade › Reconhecimento de fala)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está desativado para o tafs. Ative-o em Ajustes do Sistema › Privacidade e Segurança › Reconhecimento de Fala (no macOS 12: Preferências do Sistema › Segurança e Privacidade › Privacidade › Reconhecimento de Fala)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recunoașterea vorbirii este dezactivată pentru tafs. Activați-o în Configurări sistem › Confidențialitate și securitate › Recunoaștere vorbire (pe macOS 12: Preferințe sistem › Securitate și confidențialitate › Confidențialitate › Recunoaștere vorbire)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávanie reči je pre tafs vypnuté. Zapnite ho v Nastaveniach systému › Súkromie a bezpečnosť › Rozpoznávanie reči (v macOS 12: Systémové nastavenia › Bezpečnosť a súkromie › Súkromie › Rozpoznávanie reči)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje govora je za tafs izklopljeno. Vklopite ga v Sistemske nastavitve › Zasebnost in varnost › Prepoznavanje govora (v macOS 12: Sistemske nastavitve › Varnost in zasebnost › Zasebnost › Prepoznavanje govora)."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Njohja e të folurit është joaktive për tafs. Aktivizojeni te Cilësimet e Sistemit › Privatësia dhe Siguria › Njohja e të folurit (në macOS 12: Preferencat e Sistemit › Siguria dhe Privatësia › Privatësia › Njohja e të folurit)."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje govora je isključeno za tafs. Uključite ga u Podešavanja sistema › Privatnost i sigurnost › Prepoznavanje govora (macOS 12: Podešavanja sistema › Sigurnost i privatnost › Privatnost › Prepoznavanje govora)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรู้จำเสียงพูดปิดอยู่สำหรับ tafs เปิดได้ที่การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › การรู้จำเสียงพูด (บน macOS 12: ค่ากำหนดระบบ › ความปลอดภัยและความเป็นส่วนตัว › ความเป็นส่วนตัว › การรู้จำเสียงพูด)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma tanıma, tafs için kapalı. Sistem Ayarları › Gizlilik ve Güvenlik › Konuşma Tanıma'dan açın (macOS 12'de: Sistem Tercihleri › Güvenlik ve Gizlilik › Gizlilik › Konuşma Tanıma)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận dạng giọng nói đang tắt đối với tafs. Hãy bật trong Cài đặt Hệ thống › Quyền riêng tư & Bảo mật › Nhận dạng giọng nói (trên macOS 12: Tùy chọn Hệ thống › Bảo mật & Quyền riêng tư › Quyền riêng tư › Nhận dạng giọng nói)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音辨識已對 tafs 關閉。請在「系統設定」›「隱私權與安全性」›「語音辨識」中開啟（macOS 12：「系統偏好設定」›「安全性與隱私權」›「隱私權」›「語音辨識」）。"
          }
        }
      }
    },
    "voice.speech_recognition_restricted_device_dictation": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda nitq tanıma məhdudlaşdırılıb, ona görə səsli yazma işləyə bilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разпознаването на реч е ограничено на това устройство, така че диктовката не може да работи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávání řeči je na tomto zařízení omezené, takže diktování nemůže běžet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung ist auf diesem Gerät eingeschränkt, daher kann das Diktieren nicht laufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is restricted on this device, so dictation can't run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz está restringido en este dispositivo, así que el dictado no puede funcionar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõnetuvastus on selles seadmes piiratud, seega dikteerimine ei saa töötada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est restreinte sur cet appareil : la dictée ne peut pas fonctionner."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje govora je ograničeno na ovom uređaju pa diktiranje ne može raditi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszédfelismerés korlátozva van ezen az eszközön, ezért a diktálás nem futhat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խոսքի ճանաչումը այս սարքում սահմանափակված է, ուստի թելադրումը չի կարող աշխատել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengenalan ucapan dibatasi di perangkat ini, sehingga dikte tidak dapat berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale è limitato su questo dispositivo, quindi la dettatura non può funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは音声認識が制限されているため、音声入力を実行できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მეტყველების ამოცნობა ამ მოწყობილობაზე შეზღუდულია, ამიტომ კარნახი ვერ მუშაობს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 음성 인식이 제한되어 있어 받아쓰기를 실행할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalbos atpažinimas šiame įrenginyje apribotas, todėl diktuoti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Runas atpazīšana šajā ierīcē ir ierobežota, tāpēc diktēšana nevar darboties."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraakherkenning is beperkt op dit apparaat, dus dicteren kan niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie mowy jest ograniczone na tym urządzeniu, więc dyktowanie nie może działać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está restrito neste dispositivo, por isso o ditado não pode funcionar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está restrito neste dispositivo, por isso o ditado não pode funcionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recunoașterea vorbirii este restricționată pe acest dispozitiv, așa că dictarea nu poate rula."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávanie reči je na tomto zariadení obmedzené, takže diktovanie nemôže bežať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje govora je na tej napravi omejeno, zato narekovanje ne more delovati."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Njohja e të folurit është e kufizuar në këtë pajisje, ndaj diktimi nuk mund të ekzekutohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje govora je ograničeno na ovom uređaju pa diktiranje ne može raditi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรู้จำเสียงพูดถูกจำกัดบนอุปกรณ์นี้ จึงใช้การเขียนตามคำบอกไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma tanıma bu cihazda kısıtlı, bu yüzden dikte çalışamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận dạng giọng nói bị hạn chế trên thiết bị này nên không thể đọc chính tả."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置的語音辨識受到限制，因此無法進行聽寫。"
          }
        }
      }
    },
