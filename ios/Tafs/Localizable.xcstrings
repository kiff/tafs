        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre taf ne s'exécute pas tant qu'elle n'est pas installée ou que vous n'annulez pas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš taf ne radi dok se ne instalira ili ne otkažete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafod nem fut, amíg nincs telepítve, vagy amíg meg nem szakítod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր taf-ը չի աշխատում, մինչև այն տեղադրվի կամ չեղարկեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
