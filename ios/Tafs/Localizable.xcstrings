          "stringUnit": {
            "state": "translated",
            "value": "別の承認が進行中です。それが終わってからこれを承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 승인이 진행 중입니다. 끝나면 이것을 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vykdomas kitas patvirtinimas. Patvirtinkite šį, kai jis bus baigtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiek cits apstiprinājums. Apstiprini šo, kad tas būs pabeigts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt al een andere goedkeuring. Je kunt deze goedkeuren zodra die klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa inne zatwierdzenie. Zatwierdź to, gdy się zakończy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra aprovação está em curso. Aprove esta quando estiver concluída."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra aprovação está em andamento. Aprove esta quando estiver concluída."
          }
        }
