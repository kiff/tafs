          }
        }
      }
    },
    "taf.remove.connections_left|zero": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتعذّر إزالة الوصول إلى أي من تطبيقاته: أزله في «ربط التطبيقات»."
          }
        },
        "lv": {
          "stringUnit": {
