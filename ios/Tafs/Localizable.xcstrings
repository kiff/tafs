    "version.while_you_try.chat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجراءات النسخة %1$@ حقيقية، تحت Card خاصة بها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ versiyasının əməliyyatları həqiqidir, öz Card-ı altında."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Действията на версия %1$@ са истински, под собствената ѝ Card."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংস্করণ %1$@-এর কাজ বাস্তব, নিজের Card-এর অধীনে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les accions de la versió %1$@ són reals, sota el seu propi Card."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akce verze %1$@ jsou skutečné, pod její vlastní Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Version %1$@ tut, ist echt, unter ihrer eigenen Card."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@'s actions are real, under its own Card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones de la versión %1$@ son reales, con su propia Card."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiooni %1$@ toimingud on päris, selle oma Cardi all."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions de la version %1$@ sont réelles, sous sa propre Card."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולות של גרסה %1$@ אמיתיות, תחת ה-Card שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण %1$@ की कार्रवाइयाँ असली हैं, उसके अपने Card के तहत।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radnje verzije %1$@ su stvarne, pod njezinim vlastitim Cardom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@. verzió műveletei valódiak, a saját Cardja alatt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տարբերակ %1$@-ի գործողությունները իրական են՝ իր սեփական Card-ի ներքո։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan versi %1$@ nyata, di bawah Card miliknya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni della versione %1$@ sono reali, con la sua Card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン%1$@の操作は、専用のCardのもとで実際に行われます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერსია %1$@-ის მოქმედებები რეალურია, საკუთარი Card-ით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សកម្មភាពរបស់កំណែ %1$@ គឺពិតប្រាកដ ក្រោម Card ផ្ទាល់ខ្លួនរបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 %1$@의 행동은 자체 Card에 따른 실제 행동입니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການກະທຳຂອງເວີຊັນ %1$@ ແມ່ນຈິງ, ພາຍໃຕ້ Card ຂອງມັນເອງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ versijos veiksmai yra tikri, pagal jos pačios Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Versijas %1$@ darbības ir pa īstam, ar savu Card."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дејствата на верзијата %1$@ се вистински, под нејзин сопствен Card."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-р хувилбарын үйлдэл бодит бөгөөд өөрийн Card-ын дор явагдана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण %1$@ का कार्यहरू वास्तविक हुन्छन्, यसकै आफ्नै Card अन्तर्गत।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat versie %1$@ doet, is echt, onder een eigen Card."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działania wersji %1$@ są prawdziwe, w ramach jej własnej Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ações da versão %1$@ são reais, ao abrigo do seu próprio Card."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ações da versão %1$@ são reais, ao abrigo do seu próprio Card."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acțiunile versiunii %1$@ sunt reale, sub propriul Card."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcie verzie %1$@ sú skutočné, pod jej vlastnou Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejanja različice %1$@ so resnična, pod njeno lastno Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Veprimet e versionit %1$@ janë të vërteta, nën Card-in e vet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Radnje verzije %1$@ su stvarne, pod njenim vlastitim Cardom."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำของเวอร์ชัน %1$@ เป็นของจริง ภายใต้ Card ของมันเอง"
