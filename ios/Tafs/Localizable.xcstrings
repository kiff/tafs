    "version.install_body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ versiyası öz Card-ı ilə işləyən versiya olur. Bu söhbət silinir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия %1$@ става активната версия, със своята Card. Този чат се изтрива."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verze %1$@ se stane aktivní verzí, se svou Card. Tento chat se smaže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ wird mit ihrer Card zur Live-Version. Dieser Chat wird gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ becomes the live version, with its Card. This chat is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión %1$@ pasa a ser la versión activa, con su Card. Este chat se elimina."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Versioon %1$@ võetakse koos oma Cardiga kasutusele. See vestlus kustutatakse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version %1$@ devient la version en service, avec sa Card. Ce chat est supprimé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzija %1$@ postaje verzija u radu, sa svojim Cardom. Ovaj se razgovor briše."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@. verzió lesz az élő verzió, a Cardjával együtt. Ez a csevegés törlődik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տարբերակ %1$@-ը դառնում է ակտիվ տարբերակ՝ իր Card-ով։ Այս զրույցը ջնջվում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi %1$@ menjadi versi aktif, dengan Card miliknya. Obrolan ini dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione %1$@ diventa la versione attiva, con la sua Card. Questa chat viene eliminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン%1$@がCardとともに適用中のバージョンになります。このチャットは削除されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერსია %1$@ ხდება აქტიური ვერსია თავისი Card-ით. ეს ჩატი იშლება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 %1$@이(가) Card와 함께 적용된 버전이 됩니다. 이 채팅은 삭제됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ versija tampa aktyvia versija su savo Card. Šis pokalbis ištrinamas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Versija %1$@ kļūst par darbā esošo versiju ar savu Card. Šī saruna tiek dzēsta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versie %1$@ wordt de live versie, met zijn Card. Deze chat wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja %1$@ staje się wersją działającą na żywo, razem ze swoją Card. Ten czat zostanie usunięty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão %1$@ passa a ser a versão em produção, com o seu Card. Este chat é eliminado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão %1$@ passa a ser a versão em produção, com o seu Card. Este chat é excluído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea %1$@ devine versiunea activă, cu Cardul său. Această conversație se șterge."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzia %1$@ sa stane aktívnou verziou, so svojou Card. Tento chat sa odstráni."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Različica %1$@ postane aktivna različica, s svojo Card. Ta klepet se izbriše."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Versioni %1$@ bëhet versioni aktiv, me Card-in e vet. Kjo bisedë fshihet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzija %1$@ postaje verzija u radu, sa svojim Cardom. Ovaj se razgovor briše."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชัน %1$@ จะกลายเป็นเวอร์ชันที่ใช้งานพร้อม Card ของมัน แชตนี้จะถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. sürüm, Card'ıyla birlikte yayındaki sürüm olur. Bu sohbet silinir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản %1$@ trở thành phiên bản đang chạy, kèm Card của nó. Cuộc trò chuyện này bị xóa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %1$@ 會連同它的 Card 成為生效的版本。這個對話會被刪除。"
          }
        }
      }
    },
