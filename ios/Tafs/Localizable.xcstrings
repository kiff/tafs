    "settings.each_sends_who_answered_through": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər biri kimin cavablandırıldığını və hansı qapı ilə olduğunu göndərir, heç vaxt sözlərini yox. Onu taf-ın «Quraşdırma › Nəticələr hara gedir» bölməsində söndürün."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки изпраща на кого е отговорено и през коя врата, никога думите му. Изключете го в Setup на taf › Резултатите отиват в."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé posílá, komu a přes které dveře se odpovědělo, nikdy jeho slova. Vypněte to v Setup tafu › Výsledky jdou do."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede sagt, wem über welche Tür geantwortet wurde, nie den Wortlaut. Ausschalten kannst du das im Setup des tafs › Ergebnisse gehen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each sends who was answered and through which door, never its words. Turn it off in the taf's Setup › Results go to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada una indica a quién se respondió y por qué puerta, nunca sus palabras. Desactívalo en el taf, en Configuración › Los resultados van a."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igaüks saadab, kellele vastati ja millise ukse kaudu, mitte kunagi selle sõnu. Lülita see välja tafi menüüs Seadistus › Tulemused lähevad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacune indique à qui il a été répondu et par quelle porte, jamais son contenu. Désactivez-la dans Configuration du taf › Les résultats vont vers."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka šalje tko je dobio odgovor i kroz koja vrata, nikad njegove riječi. Isključite je u tafovu Setup › Rezultati idu u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindegyik elküldi, kinek és melyik ajtón válaszolt, soha a szavait. Kikapcsolhatod a taf Setup › Az eredmények ide mennek részében."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուրը ուղարկում է, թե ում պատասխանեցին և որ դռնով, երբեք նրա բառերը։ Անջատեք taf-ի Setup › Արդյունքները գնում են բաժնում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masing-masing mengirim siapa yang dijawab dan lewat pintu mana, tidak pernah kata-katanya. Matikan di Setup taf › Hasil dikirim ke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ognuno indica a chi è stato risposto e tramite quale porta, mai le sue parole. Disattivalo in Configurazione › I risultati vanno a, nel taf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの窓口で誰に回答したかだけを送り、内容は送りません。tafのセットアップ › 結果の送信先でオフにできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითოეული აგზავნის, ვის უპასუხეს და რომელი კარით, არასოდეს მის სიტყვებს. გამორთეთ taf-ის Setup › შედეგები მიდის."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 알림은 누구에게 어떤 창구로 답했는지만 보내며 내용은 보내지 않습니다. taf의 설정 › 결과 보낼 곳에서 끌 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas praneša, kam atsakyta ir per kurias duris, bet niekada ne atsakymo žodžius. Išjunkite tai taf skiltyje Setup › Rezultatai siunčiami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katrs paziņojums nosūta, kam tika atbildēts un caur kurām durvīm, nekad tā vārdus. Izslēdz to taf sadaļā Setup › Rezultāti tiek sūtīti uz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke melding vermeldt wie er is beantwoord en via welke deur, nooit de woorden. Zet het uit in Configuratie › Resultaten gaan naar van het taf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy z nich wysyła, komu i przez które drzwi odpowiedziano, nigdy treść. Wyłącz to w tafie: Konfiguracja › Wyniki trafiają do."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada um indica a quem foi respondido e por que porta, nunca as palavras. Desative-o na Configuração do taf › Os resultados vão para."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada um indica a quem foi respondido e por que porta, nunca as palavras. Desative-o na Configuração do taf › Os resultados vão para."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare trimite cui i s-a răspuns și prin ce ușă, niciodată cuvintele sale. Dezactivați-l în Setup-ul tafului › Rezultatele merg la."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé posiela, komu a cez ktoré dvere sa odpovedalo, nikdy jeho slová. Vypnite to v Setup tafu › Výsledky idú do."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak pošlje, komu je bilo odgovorjeno in skozi katera vrata, nikoli njegovih besed. Izklopite to v Setup tafa › Rezultati gredo v."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Secila dërgon kujt iu përgjigj dhe përmes cilës portë, kurrë fjalët e tij. Çaktivizojeni te Setup i taf-it › Rezultatet shkojnë te."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka šalje ko je dobio odgovor i kroz koja vrata, nikad njegove reči. Isključite je u tafovu Setup › Rezultati idu u."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละรายการส่งว่าใครได้รับคำตอบและผ่านประตูใด ไม่มีถ้อยคำของมัน ปิดได้ที่การตั้งค่าของ taf › ผลลัพธ์ไปที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her biri, kime ve hangi kapıdan yanıt verildiğini gönderir; sözlerini asla. Taf'ın Setup › Sonuçlar şuraya gider bölümünden kapatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi thông báo gửi ai đã được trả lời và qua cửa nào, không bao giờ kèm lời của nó. Hãy tắt trong Cài đặt của taf › Kết quả gửi tới."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每則通知都會傳送誰得到了回覆、透過哪扇門，但絕不包含它所說的話。可在 taf 的「設定」›「結果送往」中關閉。"
          }
        }
      }
    },
