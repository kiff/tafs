    "connect.key_goes_to": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذهب المفتاح من هذا الهاتف إلى خادم الاتصال، الذي يرسله إلى %1$@ فقط. ولا يذهب إلى Coach أبدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Açar bu telefondan qoşulma serverinə gedir, o isə onu yalnız %1$@ ünvanına göndərir. O, heç vaxt Coach-a getmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът отива от този телефон към сървъра за връзки, който го изпраща само до %1$@. Никога не стига до Coach."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী এই ফোন থেকে সংযোগ সার্ভারে যায়, যা এটি শুধু %1$@-এ পাঠায়। এটি কখনও Coach-এ যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La clau va d'aquest telèfon al servidor de connexions, que només l'envia a %1$@. Mai no va a Coach."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč jde z tohoto telefonu na server připojení, který ho posílá jen do %1$@. K Coachovi se nikdy nedostane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel geht von diesem Telefon an den Verbindungsserver, der ihn nur an %1$@ sendet. An Coach geht er nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key goes from this phone to the connection server, which sends it only to %1$@. It never goes to Coach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave va de este teléfono al servidor de conexiones, que solo la envía a %1$@. Nunca va a Coach."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võti läheb sellest telefonist ühendusserverisse, mis saadab selle ainult hostile %1$@. See ei lähe kunagi Coachile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé va de ce téléphone au serveur de connexion, qui ne l'envoie qu'à %1$@. Elle ne va jamais à Coach."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתח עובר מהטלפון הזה לשרת החיבור, ששולח אותו רק אל %1$@. הוא אף פעם לא מגיע ל-Coach."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी इस फ़ोन से कनेक्शन सर्वर तक जाती है, जो उसे केवल %1$@ को भेजता है। यह कभी Coach तक नहीं जाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ ide s ovog telefona na poslužitelj veze, koji ga šalje samo na %1$@. Nikad ne ide Coachu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcs erről a telefonról a kapcsolatszerverre kerül, amely csak ide küldi: %1$@. Soha nem kerül a Coachhoz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանալին գնում է այս հեռախոսից կապի սերվերին, որը այն ուղարկում է միայն՝ %1$@։ Այն երբեք չի գնում Coach-ին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci dikirim dari ponsel ini ke server koneksi, yang hanya meneruskannya ke %1$@. Tidak pernah dikirim ke Coach."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave va da questo telefono al server dei collegamenti, che la invia solo a %1$@. Non va mai a Coach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはこのスマートフォンから接続サーバーに送られ、サーバーは%1$@にだけ送信します。Coachに送られることはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გასაღები ამ ტელეფონიდან მიდის კავშირის სერვერზე, რომელიც მას აგზავნის მხოლოდ აქ: %1$@. ის არასოდეს მიდის Coach-თან."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កូនសោទៅពីទូរសព្ទនេះទៅម៉ាស៊ីនមេការតភ្ជាប់ ដែលផ្ញើវាទៅ %1$@ តែប៉ុណ្ណោះ។ វាមិនដែលទៅ Coach ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 이 휴대폰에서 연결 서버로 가고, 연결 서버는 %1$@에만 보냅니다. Coach에게는 절대 가지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກຸນແຈໄປຈາກໂທລະສັບນີ້ຫາເຊີບເວີການເຊື່ອມຕໍ່ ຊຶ່ງສົ່ງມັນໄປ %1$@ ເທົ່ານັ້ນ. ມັນບໍ່ເຄີຍໄປຫາ Coach."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raktas iš šio telefono siunčiamas į ryšių serverį, kuris jį siunčia tik %1$@. Jis niekada nepatenka pas Coach."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atslēga no šī tālruņa nonāk savienojumu serverī, kas to sūta tikai uz %1$@. Tā nekad nenonāk pie Coach."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клучот оди од овој телефон до серверот за врски, кој го испраќа само до %1$@. Никогаш не оди до Coach."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түлхүүр энэ утаснаас холболтын сервер рүү очиж, сервер түүнийг зөвхөн %1$@ руу илгээнэ. Coach руу хэзээ ч очдоггүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कुञ्जी यो फोनबाट जडान सर्भरमा जान्छ, जसले यसलाई %1$@ मा मात्र पठाउँछ। यो Coach मा कहिल्यै जाँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel gaat van deze telefoon naar de koppelingsserver, die hem alleen naar %1$@ stuurt. Hij gaat nooit naar Coach."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz trafia z tego telefonu na serwer połączeń, który wysyła go tylko do %1$@. Nigdy nie trafia do Coacha."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave vai deste telefone para o servidor de ligações, que só a envia para %1$@. Nunca vai para o Coach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave vai deste telefone para o servidor de conexões, que só a envia para %1$@. Nunca vai para o Coach."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia pleacă de pe acest telefon la serverul de conexiune, care o trimite doar la %1$@. Nu ajunge niciodată la Coach."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúč ide z tohto telefónu na server pripojenia, ktorý ho posiela len do %1$@. K Coachovi sa nikdy nedostane."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ gre iz tega telefona na strežnik povezave, ki ga pošlje samo na %1$@. Nikoli ne gre Coachu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çelësi shkon nga ky telefon te serveri i lidhjes, që e dërgon vetëm te %1$@. Nuk shkon kurrë te Coach."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ ide s ovog telefona na server veze, koji ga šalje samo na %1$@. Nikad ne ide Coachu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กุญแจไปจากโทรศัพท์เครื่องนี้ถึงเซิร์ฟเวอร์การเชื่อมต่อ ซึ่งส่งให้ %1$@ เท่านั้น ไม่เคยไปถึง Coach"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Açar bu telefondan birikme serwerine gidýär, ol ony diňe %1$@ salgysyna iberýär. Ol hiç haçan Coach-a gitmeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar bu telefondan bağlantı sunucusuna gider; sunucu onu yalnızca %1$@ adresine gönderir. Asla Coach'a gitmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید اس فون سے کنکشن سرور تک جاتی ہے، جو اسے صرف %1$@ کو بھیجتا ہے۔ یہ کبھی Coach تک نہیں جاتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa đi từ điện thoại này tới máy chủ kết nối, nơi chỉ gửi nó tới %1$@. Nó không bao giờ đến Coach."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰會從這部手機送到連線伺服器，伺服器只會將它傳給 %1$@。它絕不會傳給 Coach。"
          }
        }
      }
    },
