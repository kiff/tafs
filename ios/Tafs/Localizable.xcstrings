            "value": "გასაღებით, რომელიც ამ ტელეფონს არასოდეს ტოვებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰을 떠나지 않는 키로 서명했습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raktu, kuris niekada nepalieka šio telefono."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar atslēgu, kas nekad neatstāj šo tālruni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door een sleutel die deze telefoon nooit verlaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kluczem, który nigdy nie opuszcza tego telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por uma chave que nunca sai deste telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por uma chave que nunca sai deste telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Printr-o cheie care nu părăsește niciodată acest telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúčom, ktorý nikdy neopustí tento telefón."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S ključem, ki nikoli ne zapusti tega telefona."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nga një çelës që nuk largohet kurrë nga ky telefon."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključem koji nikad ne napušta ovaj telefon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดยกุญแจที่ไม่เคยออกจากโทรศัพท์เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefondan asla çıkmayan bir anahtarla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bằng một khóa không bao giờ rời điện thoại này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
