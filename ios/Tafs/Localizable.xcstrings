    "needs_you.card_unit.changed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر هذا الطلب. اقرأه مرة أخرى قبل تجاهله."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sorğu dəyişdi. Onu bağlamazdan əvvəl yenidən oxuyun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази заявка се промени. Прочетете я отново, преди да я отхвърлите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অনুরোধ বদলেছে। বাতিল করার আগে আবার পড়ুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta sol·licitud ha canviat. Torna-la a llegir abans de descartar-la."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato žádost se změnila. Před zamítnutím si ji přečtěte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage hat sich geändert. Lies sie erneut, bevor du sie verwirfst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request changed. Read it again before dismissing it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud cambió. Vuelve a leerla antes de descartarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See päring muutus. Loe see enne kõrvaldamist uuesti läbi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande a changé. Relisez-la avant de l'ignorer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבקשה הזו השתנתה. יש לקרוא אותה שוב לפני שמבטלים אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अनुरोध बदल गया। इसे खारिज करने से पहले फिर पढ़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj se zahtjev promijenio. Pročitajte ga ponovno prije odbacivanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kérés megváltozott. Elvetés előtt olvasd el újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հարցումը փոխվել է։ Նորից կարդացեք այն, նախքան մերժելը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan ini berubah. Baca lagi sebelum mengabaikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa richiesta è cambiata. Rileggila prima di ignorarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストは変更されました。閉じる前にもう一度確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოთხოვნა შეიცვალა. წაიკითხეთ ხელახლა, სანამ უარყოფთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សំណើនេះបានផ្លាស់ប្តូរ។ អានវាម្តងទៀតមុនពេលបដិសេធចោល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청이 바뀌었습니다. 닫기 전에 다시 읽어 보세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຳຂໍນີ້ປ່ຽນແປງ. ອ່ານມັນອີກກ່ອນປິດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis prašymas pasikeitė. Prieš atsisakydami perskaitykite jį dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis pieprasījums mainījās. Pirms to noraidi, izlasi to vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова барање се промени. Прочитај го повторно пред да го отфрлиш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ хүсэлт өөрчлөгдсөн. Хаахаасаа өмнө дахин уншина уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो अनुरोध परिवर्तन भयो। हटाउनुअघि फेरि पढ्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verzoek is gewijzigd. Lees het opnieuw voordat je het negeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prośba się zmieniła. Odczytaj ją ponownie, zanim ją odrzucisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido mudou. Leia-o novamente antes de o ignorar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido mudou. Leia-o novamente antes de o ignorar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această solicitare s-a schimbat. Citiți-o din nou înainte de a o respinge."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto žiadosť sa zmenila. Pred zamietnutím si ju prečítajte znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta zahteva se je spremenila. Preden jo opustite, jo znova preberite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo kërkesë ndryshoi. Lexojeni sërish para se ta hidhni poshtë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj se zahtev promenio. Pročitajte ga ponovo pre odbacivanja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอนี้เปลี่ยนไป อ่านอีกครั้งก่อนปิด"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu haýyş üýtgedi. Ony ýapmazdan öň täzeden okaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istek değişti. Kapatmadan önce tekrar okuyun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ درخواست بدل گئی۔ اسے ہٹانے سے پہلے دوبارہ پڑھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu này đã thay đổi. Hãy đọc lại trước khi bỏ qua."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此請求已變更。請重新閱讀後再關閉。"
          }
        }
      }
    },
