    "taf.revoke_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine neue Aktion geht durch. Was schon erledigt ist, bleibt erledigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No new action goes through. Anything already done stays done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se completa ninguna acción nueva. Lo que ya se hizo se mantiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune nouvelle action ne passe. Ce qui est déjà fait le reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna nuova azione va a buon fine. Ciò che è già stato fatto resta fatto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er gaat geen nieuwe actie meer door. Wat al is gedaan, blijft gedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna nowa akcja nie przejdzie. To, co już zostało zrobione, pozostaje zrobione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma ação nova é concluída. O que já foi feito mantém-se."
          }
        }
      }
    },
