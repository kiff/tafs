    "settings.devices.pair_not_a_pairing": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu QR kod cütləşdirilməyi xahiş edən kompüter deyil."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този QR код не е от компютър, който иска сдвояване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten QR kód není počítač, který žádá o spárování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser QR-Code ist keine Kopplungsanfrage eines Computers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That QR code isn't a computer asking to be paired."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código QR no es un ordenador que pide vincularse."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See QR-kood pole arvuti sidumistaotlus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code QR n'est pas une demande d'association d'un ordinateur."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taj QR kôd nije računalo koje traži uparivanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a QR-kód nem párosítást kérő számítógéptől származik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այդ QR կոդը համակարգիչ չէ, որ խնդրում է զուգակցում։"
