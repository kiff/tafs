    "sign_in.welcome.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einem taf eine Aufgabe. Er arbeitet innerhalb einer Card, die du festlegst, und fragt dich, wenn er mehr braucht."
          }
        },
