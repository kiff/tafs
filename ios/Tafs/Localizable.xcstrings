    "chat.failed.after": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yarıda dayandı, bu keçdikdən sonra: %2$@."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ спря по средата, след като мина това: %2$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se zastavil v půlce, poté co prošlo tohle: %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat mittendrin aufgehört, nachdem das durchging: %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stopped part-way, after this went through: %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detuvo a medias, después de que se completara esto: %2$@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lõpetas poole pealt, pärast seda, kui see läks läbi: %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s'est arrêté en cours de route, après que ceci a abouti : %2$@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
