    "record.connection_refused_before_sending": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoşulma onu göndərilməzdən əvvəl rədd etdi. Heç nə göndərilmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
