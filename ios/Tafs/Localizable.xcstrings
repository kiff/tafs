    "settings.time_zone.not_changed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat qurşağı dəyişmədi. %1$@"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовата зона не се промени. %1$@"
