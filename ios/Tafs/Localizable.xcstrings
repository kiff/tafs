    "taf.works_from_chat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل عندما تخبره، في محادثته: لا جدول يشغّله."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz söyləyəndə, söhbətində işləyir: onu heç bir cədvəl işlətmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Работи, когато му кажете, в чата си: никакъв график не го стартира."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি বললে এর চ্যাটে এটি কাজ করে: কোনো সূচি একে চালায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Treballa quan li ho dius, al seu xat: cap programació l'executa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracuje, když mu to řeknete, v jeho chatu: žádný plán ho nespouští."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er arbeitet, wenn du es ihm in seinem Chat sagst: Kein Zeitplan führt ihn aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It works when you tell it, in its chat: no schedule runs it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja cuando se lo dices, en su chat: ninguna programación lo ejecuta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See töötab siis, kui ütled seda selle vestluses: ükski ajakava seda ei käivita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il travaille quand vous le lui demandez, dans son chat : aucun planning ne le lance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא עובד כשאומרים לו, בשיחה שלו: שום תזמון לא מריץ אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह तब काम करता है जब आप इसकी चैट में कहते हैं: कोई निर्धारित समय इसे नहीं चलाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radi kad mu kažete, u njegovu razgovoru: nijedan ga raspored ne pokreće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkor dolgozik, amikor szólsz neki, a csevegésében: nem ütemezés futtatja."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Աշխատում է, երբ ասում եք նրա զրույցում․ ոչ մի ժամանակացույց այն չի գործարկում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekerja saat Anda memintanya, di obrolannya: tidak ada jadwal yang menjalankannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavora quando glielo dici, nella sua chat: nessuna pianificazione lo avvia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットで指示したときに動きます。スケジュールでは実行されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ის მუშაობს, როცა მის ჩატში ეტყვით: არც ერთი განრიგი არ უშვებს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាធ្វើការនៅពេលអ្នកប្រាប់វា ក្នុងការសន្ទនារបស់វា៖ គ្មានកាលវិភាគដំណើរការវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅에서 말할 때 작동합니다. 일정으로 실행되지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມັນເຮັດວຽກເມື່ອທ່ານບອກ, ໃນການສົນທະນາຂອງມັນ: ບໍ່ມີຕາຕະລາງເຮັດວຽກໃຫ້ມັນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jis dirba, kai liepiate jam pokalbyje: jo nepaleidžia joks tvarkaraštis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas strādā, kad tu to pasaki tā sarunā: neviens grafiks to nepalaiž."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Работи кога ќе му кажеш, во неговиот разговор: ниеден распоред не го извршува."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны хэлэхэд өөрийн чатад ажилладаг: ямар ч хуваарь түүнийг ажиллуулдаггүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले यसको च्याटमा भनेपछि यो काम गर्छ: कुनै तालिकाले यसलाई चलाउँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het werkt als je het zegt, in de chat: geen planning start het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa, gdy mu powiesz, w swoim czacie: żaden harmonogram go nie uruchamia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalha quando lhe diz, no seu chat: nenhum agendamento o executa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalha quando lhe diz, no seu chat: nenhum agendamento o executa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucrează când îi spuneți, în conversația sa: niciun program nu îl rulează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracuje, keď mu to poviete, v jeho chate: žiadny plán ho nespúšťa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela, ko mu poveste, v njegovem klepetu: noben urnik ga ne zažene."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Punon kur ia thoni, në bisedën e tij: asnjë orar nuk e ekzekuton."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Radi kad mu kažete, u njegovu razgovoru: nijedan ga raspored ne pokreće."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันทำงานเมื่อคุณบอก ในแชตของมัน: ไม่มีกำหนดการใดเรียกมัน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ol siz aýdanyňyzda, söhbetdeşliginde işleýär: ony hiç bir tertip işletmeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz söylediğinizde, sohbetinde çalışır: onu çalıştıran bir zamanlama yok."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ تب کام کرتا ہے جب آپ اسے اس کی چیٹ میں بتائیں: کوئی شیڈول اسے نہیں چلاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó làm việc khi bạn bảo, trong cuộc trò chuyện của nó: không có lịch nào chạy nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它在您於它的對話中告訴它時運作：沒有排程會執行它。"
          }
        }
      }
    },
