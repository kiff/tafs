    "sample.parcels.job": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlama gecikəndə müştərilərə onlar soruşmadan xəbər verin. Təkrar göndərişlər sizi gözləyir. Çatdırılma ünvanını heç vaxt e-poçta əsasən dəyişməyin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомявайте клиентите, когато пратка закъснява, преди да попитат. Повторните изпращания ви чакат. Никога не променяйте адрес за доставка по имейл."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dát zákazníkům vědět, že se zásilka zpožďuje, dřív než se zeptají. Nová odeslání čekají na vás. Nikdy neměnit doručovací adresu na základě e-mailu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag Kunden Bescheid, wenn ein Paket sich verspätet, bevor sie fragen. Neuversand wartet auf dich. Ändere nie eine Lieferadresse aufgrund einer E-Mail."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell customers when a parcel runs late, before they ask. Reships wait for you. Never change a delivery address from an email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar a los clientes cuando un paquete se retrasa, antes de que pregunten. Los reenvíos esperan tu aprobación. Nunca cambiar una dirección de entrega por un correo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teata klientidele, kui pakk hilineb, enne kui nad küsivad. Uuesti saatmised ootavad sind. Ära kunagi muuda tarneaadressi e-kirja põhjal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévenir les clients quand un colis prend du retard, avant qu'ils ne demandent. Les renvois vous attendent. Ne jamais changer une adresse de livraison à partir d'un e-mail."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijestite kupce kad pošiljka kasni, prije nego što pitaju. Ponovna slanja čekaju vas. Nikad ne mijenjajte adresu dostave na temelju e-pošte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szólj a vásárlóknak, ha egy csomag késik, mielőtt rákérdeznének. Az újraküldések rád várnak. Soha ne módosíts szállítási címet e-mail alapján."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ասեք հաճախորդներին, երբ ծանրոցը ուշանում է, նախքան նրանք հարցնեն։ Կրկին ուղարկումները սպասում են ձեզ։ Երբեք մի փոխեք առաքման հասցեն նամակի հիման վրա։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tahu pelanggan saat paket terlambat, sebelum mereka bertanya. Pengiriman ulang menunggu Anda. Jangan pernah mengubah alamat pengiriman dari sebuah email."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisare i clienti quando un pacco è in ritardo, prima che chiedano. Le rispedizioni aspettano te. Non cambiare mai un indirizzo di consegna per un'email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顧客に聞かれる前に、荷物の遅延を知らせます。再発送はあなたの承認を待ちます。メールだけで配送先住所を変えることはしません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უთხარით კლიენტებს, როცა ამანათი აგვიანებს, სანამ იკითხავენ. ხელახლა გაგზავნა გელოდებათ. არასოდეს შეცვალოთ მიწოდების მისამართი ელფოსტით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고객이 묻기 전에 소포가 늦어지면 알립니다. 재발송은 내 승인을 기다립니다. 이메일만 보고 배송 주소를 바꾸지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pranešti klientams, kai siuntinys vėluoja, dar jiems nepaklausus. Pakartotinis siuntimas laukia jūsų. Niekada nekeisti pristatymo adreso pagal el. laišką."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastāstīt klientiem, kad paka kavējas, pirms viņi jautā. Atkārtota nosūtīšana gaida tevi. Nekad nemainīt piegādes adresi pēc e-pasta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat klanten weten dat een pakket vertraagd is, voordat ze het vragen. Herzendingen wachten op jou. Wijzig nooit een afleveradres op basis van een e-mail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informuj klientów o spóźnionej paczce, zanim zapytają. Ponowne wysyłki czekają na Ciebie. Nigdy nie zmieniaj adresu dostawy na podstawie e-maila."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar os clientes quando uma encomenda se atrasa, antes de perguntarem. Os reenvios esperam por si. Nunca mudar uma morada de entrega a partir de um email."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar os clientes quando uma encomenda se atrasa, antes de perguntarem. Os reenvios esperam por você. Nunca mudar um endereço de entrega a partir de um email."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anunțați clienții când un colet întârzie, înainte să întrebe. Retrimiterile vă așteaptă. Nu schimbați niciodată o adresă de livrare pe baza unui e-mail."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dať zákazníkom vedieť, že zásielka mešká, skôr než sa opýtajú. Nové odoslania čakajú na vás. Nikdy nemeniť doručovaciu adresu na základe e-mailu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strankam povej, da pošiljka zamuja, preden vprašajo. Ponovne pošiljke čakajo na vas. Nikoli ne spremeni naslova dostave na podlagi e-pošte."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tregojini klientëve kur një pako vonohet, para se të pyesin. Ridërgimet presin ju. Mos ndryshoni kurrë një adresë dorëzimi nga një email."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavestite kupce kad pošiljka kasni, pre nego šta pitaju. Ponovna slanja čekaju vas. Nikad ne menjajte adresu dostave na temelju e-pošte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งลูกค้าเมื่อพัสดุล่าช้า ก่อนที่พวกเขาจะถาม การส่งซ้ำรอคุณ ห้ามเปลี่ยนที่อยู่จัดส่งตามอีเมล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir paket geciktiğinde, müşteriler sormadan önce haber ver. Yeniden gönderimler sizi bekler. Asla bir e-postayla teslimat adresini değiştirme."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cho khách hàng khi một bưu kiện bị trễ, trước khi họ hỏi. Việc gửi lại chờ bạn. Không bao giờ đổi địa chỉ giao hàng theo một email."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在客戶詢問之前，就告知他們包裹延誤。補寄要等您決定。絕不依據電子郵件變更送貨地址。"
          }
        }
      }
    },
