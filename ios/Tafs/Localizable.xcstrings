        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna impronta è configurata su questo telefono. Aggiungine una nelle sue impostazioni, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンには指紋が設定されていません。設定で追加してから戻ってください。"
