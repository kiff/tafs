    "settings.devices.pair_add_only": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazı hesabınıza əlavə edin. Yalnız bu cihaz; başqa heç nə dəyişmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавяне на това устройство към акаунта ви. Само това устройство; нищо друго не се променя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte toto zařízení ke svému účtu. Jen toto zařízení; nic jiného se nemění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät zu deinem Konto hinzufügen. Nur dieses Gerät, sonst ändert sich nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this device to your account. Only this device; nothing else changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir este dispositivo a tu cuenta. Solo este dispositivo; nada más cambia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa see seade oma kontole. Ainult see seade; midagi muud ei muutu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter cet appareil à votre compte. Uniquement cet appareil ; rien d'autre ne change."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte ovaj uređaj svom računu. Samo ovaj uređaj; ništa se drugo ne mijenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek az eszköznek a hozzáadása a fiókodhoz. Csak ez az eszköz; semmi más nem változik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելացրեք այս սարքը ձեր հաշվին։ Միայն այս սարքը․ ուրիշ ոչինչ չի փոխվում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan perangkat ini ke akun Anda. Hanya perangkat ini; tidak ada yang lain berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi questo dispositivo al tuo account. Solo questo dispositivo; nient'altro cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスをアカウントに追加します。このデバイスだけで、他は何も変わりません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაამატეთ ეს მოწყობილობა თქვენს ანგარიშს. მხოლოდ ეს მოწყობილობა; სხვა არაფერი იცვლება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기를 계정에 추가합니다. 이 기기만 추가되며 다른 것은 바뀌지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėkite šį įrenginį prie savo paskyros. Tik šį įrenginį; niekas kitas nesikeičia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievieno šo ierīci savam kontam. Tikai šo ierīci; nekas cits nemainās."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat aan je account toevoegen. Alleen dit apparaat; verder verandert er niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj to urządzenie do konta. Tylko to urządzenie; nic innego się nie zmienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar este dispositivo à sua conta. Só este dispositivo; nada mais muda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar este dispositivo à sua conta. Só este dispositivo; nada mais muda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați acest dispozitiv la cont. Doar acest dispozitiv; nimic altceva nu se schimbă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte toto zariadenie k svojmu účtu. Len toto zariadenie; nič iné sa nemení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte to napravo v svoj račun. Samo to napravo; nič drugega se ne spremeni."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shtoni këtë pajisje në llogarinë tuaj. Vetëm këtë pajisje; asgjë tjetër nuk ndryshon."
          }
        },
        "sr-Latn": {
          "stringUnit": {
