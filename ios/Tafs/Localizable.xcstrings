    "approval.approving_asks_none_set_up": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Genehmigen wird %1$@ abgefragt, und auf diesem %2$@ ist noch nichts davon eingerichtet. Richte es unter %3$@ ein und komm dann zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving asks for %1$@, and none is set up on this %2$@ yet. Set it up in %3$@, then come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para aprobar se pide %1$@, y aún no hay nada configurado en este %2$@. Configúralo en %3$@ y vuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver demande %1$@, et rien n'est encore configuré sur cet %2$@. Configurez-le dans %3$@, puis revenez."
          }
        },
        "it": {
