          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojenie to odmietlo pred odoslaním. Nič sa neodoslalo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezava je to zavrnila pred pošiljanjem. Nič ni bilo poslano."
