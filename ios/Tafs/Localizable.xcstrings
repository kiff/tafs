    "alert.tafs_could_not_reach_kiff": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs hat KIFF zum Ablehnen nicht erreicht. Öffne tafs, um zu antworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs couldn't reach KIFF to refuse it. Open tafs to answer it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs no pudo contactar con KIFF para rechazarla. Abre tafs para responder."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ei jõudnud keeldumiseks KIFFini. Vastamiseks ava tafs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs n'a pas pu joindre KIFF pour le refuser. Ouvrez tafs pour y répondre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs non è riuscita a raggiungere KIFF per rifiutarla. Apri tafs per rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsは拒否するためにKIFFに接続できませんでした。tafsを開いて回答してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs가 거절하려고 KIFF에 연결하지 못했습니다. tafs를 열어 응답하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nepavyko pasiekti KIFF, kad ją atmestų. Atidarykite tafs ir atsakykite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nevarēja sazināties ar KIFF, lai to atteiktu. Atver tafs, lai atbildētu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs kon KIFF niet bereiken om te weigeren. Open tafs om te antwoorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nie mógł połączyć się z KIFF, aby to odrzucić. Otwórz tafs, aby odpowiedzieć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não conseguiu contactar o KIFF para recusar. Abra o tafs para responder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não conseguiu contatar o KIFF para recusar. Abra o tafs para responder."
          }
        }
      }
    },
