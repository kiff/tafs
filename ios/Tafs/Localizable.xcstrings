            "value": "अपनी चैट निर्यात करने के लिए KIFF से साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se KIFF-om da biste izvezli svoje razgovore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csevegések exportálásához jelentkezz be a KIFF-fel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտք գործեք KIFF-ով՝ ձեր զրույցներն արտահանելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan KIFF untuk mengekspor obrolan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con KIFF per esportare le tue chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットをエクスポートするには、KIFFでサインインしてください。"
