    "sample.brief.expires.meanwhile": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى إعادة الشحن معلّقة؛ ولا يُرسل شيء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "təkrar göndəriş saxlanılır; heç nə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "повторното изпращане остава задържано; нищо не се изпраща."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরায় পাঠানো ধরে রাখা আছে; কিছু পাঠানো হচ্ছে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "el reenviament es reté; no s'envia res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "nové odeslání zůstává zadržené; nic se neodešle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "der Neuversand wird zurückgehalten; nichts wird gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the reship stays held; nothing is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "el reenvío queda retenido; no se envía nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "uuesti saatmine jääb kinni peetuks; midagi ei saadeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le renvoi est retenu ; rien n'est envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשלוח החוזר מוחזק; שום דבר לא נשלח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा भेजना रुका है; कुछ नहीं भेजा जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "ponovna isporuka ostaje zadržana; ništa se ne šalje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "az újraküldés visszatartva marad; semmi sem megy el."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "կրկին ուղարկումը պահվում է․ ոչինչ չի ուղարկվում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "pengiriman ulang tetap ditahan; tidak ada yang dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "la rispedizione resta in attesa; non viene inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再発送は保留のままで、何も送信されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხელახლა გაგზავნა დაკავებული რჩება; არაფერი იგზავნება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្ញើឡើងវិញនៅតែត្រូវបានផ្អាកទុក; គ្មានអ្វីត្រូវបានផ្ញើទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재발송은 보류 상태로 유지되며 아무것도 보내지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການສົ່ງໃໝ່ຍັງຖືກພັກໄວ້; ບໍ່ມີຫຍັງຖືກສົ່ງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "pakartotinis siuntimas lieka sulaikytas; niekas nesiunčiama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "atkārtotā nosūtīšana paliek aizturēta; nekas netiek nosūtīts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "повторното испраќање останува задржано; ништо не се испраќа."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "дахин илгээлт түр баригдсан хэвээр; юу ч илгээгдэхгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनः पठाइ रोकिएकै रहन्छ; केही पठाइँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
