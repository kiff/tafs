    "needs_you.when_taf_asks_something_outside": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein taf um etwas außerhalb seiner Card bittet, wartet er auf deine Antwort. Eine Benachrichtigung sagt es dir sofort, auf diesem %1$@ und seinem Sperrbildschirm, auch wenn tafs geschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a taf asks for something outside its Card, it waits for your answer. An alert tells you at once, on this %1$@ and its lock screen, even with tafs closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un taf pide algo fuera de su Card, espera tu respuesta. Una alerta te avisa al momento, en este %1$@ y en su pantalla de bloqueo, aunque tafs esté cerrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un taf demande quelque chose hors de sa Card, il attend votre réponse. Une alerte vous prévient aussitôt, sur cet %1$@ et son écran verrouillé, même si tafs est fermé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un taf chiede qualcosa fuori dalla sua Card, aspetta la tua risposta. Un avviso te lo dice subito, su questo %1$@ e sulla sua schermata di blocco, anche con tafs chiusa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een taf om iets buiten zijn Card vraagt, wacht het op je antwoord. Een melding laat het je meteen weten, op deze %1$@ en het toegangsscherm, ook als tafs gesloten is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy taf poprosi o coś poza swoją Card, czeka na Twoją odpowiedź. Alert powiadomi Cię od razu, na tym urządzeniu (%1$@) i jego ekranie blokady, nawet gdy tafs jest zamknięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf pede algo fora do seu Card, aguarda a sua resposta. Um alerta avisa-o de imediato, neste %1$@ e no ecrã bloqueado, mesmo com o tafs fechado."
          }
        }
      }
    },
