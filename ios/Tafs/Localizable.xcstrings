        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac này chỉ xem được. Để phê duyệt tại đây, hãy thêm nó từ điện thoại của bạn: Tài khoản › Thiết bị › Thêm thiết bị."
          }
