        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je to odbila. Ništa nije učinjeno i ne naloga se u današnja ograničenja"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ปฏิเสธ ยังไม่ได้ทำอะไร และไม่นับรวมในขีดจำกัดของวันนี้"
