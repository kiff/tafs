    "settings.devices.pair_code_differs": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF %1$@ cihazını %2$@ kodu ilə cütləşdirdi, yoxlanılan %3$@ ilə yox. Bu sizin kompüteriniz deyilsə, onu buradan çıxış etdirin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF сдвои %1$@ с кода %2$@, а не с проверения %3$@. Ако това не е вашият компютър, изведете го оттук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF spároval %1$@ s kódem %2$@, ne %3$@, jak jste zkontrolovali. Pokud to není váš počítač, odhlaste ho tady."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hat %1$@ mit dem Code %2$@ gekoppelt, nicht mit %3$@ wie geprüft. Ist das nicht dein Computer, melde ihn hier ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF paired %1$@ with the code %2$@, not %3$@ as checked. If that isn't your computer, sign it out here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF vinculó %1$@ con el código %2$@, no con %3$@ como comprobaste. Si no es tu ordenador, cierra su sesión aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF sidus seadme %1$@ koodiga %2$@, mitte kontrollitud koodiga %3$@. Kui see pole sinu arvuti, logi see siin välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF a associé %1$@ avec le code %2$@, et non %3$@ comme vérifié. Si ce n'est pas votre ordinateur, déconnectez-le ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF je upario uređaj %1$@ s kôdom %2$@, a ne %3$@ kako je provjereno. Ako to nije vaše računalo, odjavite ga ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF ezzel a kóddal párosította ezt: %1$@: %2$@, nem az ellenőrzött %3$@ kóddal. Ha ez nem a te számítógéped, jelentkeztesd ki itt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը զուգակցեց %1$@-ը %2$@ կոդով, ոչ թե %3$@-ով, ինչպես ստուգվեց։ Եթե դա ձեր համակարգիչը չէ, դուրս բերեք այն այստեղ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF memasangkan %1$@ dengan kode %2$@, bukan %3$@ seperti yang diperiksa. Jika itu bukan komputer Anda, keluarkan dari sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ha associato %1$@ con il codice %2$@, non %3$@ come verificato. Se non è il tuo computer, disconnettilo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFは、確認した%3$@ではなく、コード%2$@で%1$@をペアリングしました。それがあなたのコンピュータでない場合は、ここでサインアウトしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-მა %1$@ დააწყვილა კოდით %2$@, და არა %3$@-ით, როგორც შემოწმდა. თუ ეს თქვენი კომპიუტერი არ არის, გამოიყვანეთ აქედან."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 확인된 %3$@ 코드가 아니라 %2$@ 코드로 %1$@을(를) 페어링했습니다. 내 컴퓨터가 아니라면 여기서 로그아웃하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF susiejo %1$@ su kodu %2$@, o ne %3$@, kaip buvo patikrinta. Jei tai ne jūsų kompiuteris, atjunkite jį čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF savienoja pārī %1$@ ar kodu %2$@, nevis %3$@, kā tika pārbaudīts. Ja tas nav tavs dators, izraksti to šeit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF heeft %1$@ gekoppeld met de code %2$@, niet %3$@ zoals gecontroleerd. Is dat niet jouw computer, log hem hier dan uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF sparował %1$@ z kodem %2$@, a nie %3$@, jak sprawdzono. Jeśli to nie Twój komputer, wyloguj go tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF associou %1$@ com o código %2$@, não %3$@ como verificou. Se não for o seu computador, termine a sessão dele aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF associou %1$@ com o código %2$@, não %3$@ como verificou. Se não for o seu computador, encerre a sessão dele aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF a asociat %1$@ cu codul %2$@, nu cu %3$@ cum s-a verificat. Dacă nu este computerul dvs., deconectați-l de aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF spároval %1$@ s kódom %2$@, nie %3$@, ako ste skontrolovali. Ak to nie je váš počítač, odhláste ho tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF je seznanil %1$@ s kodo %2$@, ne %3$@, kot ste preverili. Če to ni vaš računalnik, ga odjavite tukaj."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF çiftoi %1$@ me kodin %2$@, jo %3$@ siç u kontrollua. Nëse ai nuk është kompjuteri juaj, nxirreni këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF je upario uređaj %1$@ s kôdom %2$@, a ne %3$@ kako je provereno. Ako to nije vaše računar, odjavite ga ovdje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF จับคู่ %1$@ ด้วยรหัส %2$@ ไม่ใช่ %3$@ ตามที่ตรวจสอบ หากนั่นไม่ใช่คอมพิวเตอร์ของคุณ ให้ออกจากระบบที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF %1$@ cihazını, denetlenen %3$@ kodu yerine %2$@ koduyla eşleştirdi. Bu sizin bilgisayarınız değilse buradan oturumunu kapatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF đã ghép đôi %1$@ với mã %2$@, không phải %3$@ như đã kiểm tra. Nếu đó không phải máy tính của bạn, hãy đăng xuất nó tại đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF 以代碼 %2$@ 配對了%1$@，而不是經確認的 %3$@。若那不是您的電腦，請在此將它登出。"
          }
        }
      }
    },
