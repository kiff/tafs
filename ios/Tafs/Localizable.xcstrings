    "record.answer_lost": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@، وأُرسل، لكن رد التطبيق ضاع: تحقق من سجلات التطبيق نفسه"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ və göndərildi, amma tətbiqin cavabı itdi: tətbiqin öz qeydlərini yoxlayın"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ и изпратено, но отговорът на приложението се изгуби: проверете собствените записи на приложението"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, এবং পাঠানো হয়েছে, কিন্তু অ্যাপের উত্তর হারিয়ে গেছে: অ্যাপের নিজস্ব রেকর্ড দেখুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, i enviat, però la resposta de l'aplicació s'ha perdut: mira els registres de l'aplicació mateixa"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a odesláno, ale odpověď aplikace se ztratila: zkontrolujte záznamy samotné aplikace"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und gesendet, aber die Antwort der App ging verloren: Prüfe die eigenen Aufzeichnungen der App"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, and sent, but the app's answer was lost: check the app's own records"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, y enviado, pero se perdió la respuesta de la app: revisa los registros de la propia app"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ja saadetud, kuid rakenduse vastus läks kaotsi: kontrolli rakenduse enda kirjeid"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, et envoyé, mais la réponse de l'app a été perdue : vérifiez les registres de l'app"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ונשלח, אבל התשובה של האפליקציה אבדה: יש לבדוק ברשומות של האפליקציה עצמה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, और भेजा गया, पर ऐप का उत्तर खो गया: ऐप के अपने रिकॉर्ड जाँचें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, i poslano, ali odgovor aplikacije je izgubljen: provjerite vlastite zapise aplikacije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, és elküldve, de az alkalmazás válasza elveszett: nézd meg az alkalmazás saját nyilvántartását"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, և ուղարկվեց, բայց հավելվածի պատասխանը կորավ․ ստուգեք հենց հավելվածի գրառումները"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, dan terkirim, tetapi jawaban aplikasi hilang: periksa catatan aplikasi itu sendiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, e inviata, ma la risposta dell'app è andata persa: controlla i registri dell'app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、送信済みですが、アプリの応答が失われました：アプリ側の記録を確認してください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, და გაიგზავნა, მაგრამ აპის პასუხი დაიკარგა: შეამოწმეთ თავად აპის ჩანაწერები"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ហើយបានផ្ញើ ប៉ុន្តែចម្លើយរបស់កម្មវិធីបាត់៖ ពិនិត្យកំណត់ត្រារបស់កម្មវិធីខ្លួនឯង"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 보냈지만 앱의 응답이 사라졌습니다: 앱의 자체 기록을 확인하세요"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ແລະ ສົ່ງແລ້ວ, ແຕ່ຄຳຕອບຂອງແອັບຫາຍໄປ: ກວດບັນທຶກຂອງແອັບເອງ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ir išsiųsta, bet programėlės atsakymas prarastas: patikrinkite pačios programėlės įrašus"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, un nosūtīts, bet lietotnes atbilde pazuda: pārbaudi pašas lietotnes ierakstus"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, и испратено, но одговорот на апликацијата се загуби: провери ги сопствените записи на апликацијата"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, илгээсэн боловч аппын хариу алга болсон: аппын өөрийн бүртгэлийг шалгана уу"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, र पठाइयो, तर एपको जवाफ हरायो: एपका आफ्नै अभिलेख जाँच्नुहोस्"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, en verzonden, maar het antwoord van de app is verloren gegaan: controleer de gegevens van de app zelf"
