    "coach.questions.talking": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تناقش هذه الأسئلة مع Coach."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz bu sualları Coach ilə müzakirə edirsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обсъждате тези въпроси с Coach."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি Coach-এর সঙ্গে এই প্রশ্নগুলো নিয়ে কথা বলছেন।"
          }
