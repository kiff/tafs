        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovo odgovara netko ko odobrava na ovom nalogu. Njegov se odgovor prikazuje ovdje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ที่อนุมัติได้ในบัญชีนี้จะเป็นผู้ตอบ คำตอบของเขาจะแสดงที่นี่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Muňa bu hasapda tassyklaýan biri jogap berýär. Onuň jogaby şu ýerde görünýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu bu hesapta onaylayan biri yanıtlar. Yanıtı burada görünür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اکاؤنٹ پر منظور کرنے والا کوئی فرد اس کا جواب دیتا ہے۔ ان کا جواب یہاں دکھایا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người phê duyệt trên tài khoản này sẽ trả lời việc này. Câu trả lời của họ hiện ở đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由此帳號中可核准的人回覆。他們的回覆會顯示在這裡。"
          }
        }
      }
    },
