          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja rola na tym koncie KIFF nie pozwala włączyć alertów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
