    "billing.cancel_any_time_least_day": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jederzeit kündbar, spätestens einen Tag vor der Verlängerung, unter „Abonnements“ in deinem Apple-Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel any time, at least a day before it renews, in your Apple account's Subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela cuando quieras, al menos un día antes de la renovación, en Suscripciones de tu cuenta de Apple."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tühista igal ajal, vähemalt päev enne uuenemist, oma Apple'i konto tellimustes (Subscriptions)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez à tout moment, au moins un jour avant le renouvellement, dans les Abonnements de votre compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla quando vuoi, almeno un giorno prima del rinnovo, negli Abbonamenti del tuo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新の1日前までなら、Apple IDのサブスクリプションでいつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갱신 최소 하루 전까지 Apple 계정의 구독에서 언제든지 취소할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atšaukite bet kada, ne vėliau kaip likus dienai iki atnaujinimo, savo Apple paskyros prenumeratose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atcel jebkurā laikā, vismaz dienu pirms atjaunošanas, sava Apple konta sadaļā Abonementi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt altijd opzeggen, minstens een dag voor de verlenging, in Abonnementen van je Apple-account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluj w dowolnym momencie, co najmniej dzień przed odnowieniem, w Subskrypcjach swojego konta Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele quando quiser, pelo menos um dia antes da renovação, nas Subscrições da sua conta Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele quando quiser, pelo menos um dia antes da renovação, em Assinaturas na sua conta Apple."
          }
        }
      }
    },
    "billing.contact_support": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kann diesen Kauf diesem Konto nicht hinzufügen. Du hast dafür bezahlt, also wende dich an support@kiff.dev, und wir klären das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF can't add this purchase to this account. You paid for it, so contact support at support@kiff.dev and we'll sort it out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no puede añadir esta compra a esta cuenta. La pagaste, así que escribe a soporte en support@kiff.dev y lo resolveremos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei saa seda ostu sellele kontole lisada. Sa maksid selle eest, seega kirjuta toele aadressil support@kiff.dev ja me lahendame selle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ne peut pas ajouter cet achat à ce compte. Vous l'avez payé : contactez l'assistance à support@kiff.dev et nous réglerons le problème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non può aggiungere questo acquisto a questo account. L'hai pagato, quindi contatta l'assistenza a support@kiff.dev e lo risolveremo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFはこの購入をこのアカウントに追加できません。お支払い済みですので、support@kiff.devまでお問い合わせください。対応いたします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 이 구매를 이 계정에 추가할 수 없습니다. 이미 결제하셨으니 support@kiff.dev로 지원팀에 문의해 주시면 해결해 드리겠습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF negali pridėti šio pirkinio prie šios paskyros. Už jį sumokėjote, todėl parašykite pagalbai adresu support@kiff.dev ir mes tai sutvarkysime."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nevar pievienot šo pirkumu šim kontam. Tu par to samaksāji, tāpēc sazinies ar atbalstu: support@kiff.dev, un mēs to atrisināsim."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kan deze aankoop niet aan dit account toevoegen. Je hebt ervoor betaald, dus neem contact op met support via support@kiff.dev en we lossen het op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie może dodać tego zakupu do tego konta. Zapłacono za niego, więc skontaktuj się z pomocą pod adresem support@kiff.dev, a my to rozwiążemy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não consegue adicionar esta compra a esta conta. Pagou por ela, por isso contacte o suporte em support@kiff.dev e resolveremos o assunto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não consegue adicionar esta compra a esta conta. Você pagou por ela, então entre em contato com o suporte em support@kiff.dev e resolveremos isso."
          }
        }
      }
    },
    "billing.conversation_goes_plan_tools_being": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während des Gesprächs erscheinen hier der Plan, die Apps, die verbunden werden, und die Card des tafs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As the conversation goes, the plan, the apps being connected and the taf's Card show here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A medida que avanza la conversación, aquí aparecen el plan, las apps que se conectan y la Card del taf."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vestluse käigus kuvatakse siin plaan, ühendatavad rakendused ja tafi Card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au fil de la conversation, le plan, les apps en cours de connexion et la Card du taf s'affichent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Man mano che la conversazione procede, qui compaiono il piano, le app da collegare e la Card del taf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話が進むにつれて、プラン、接続中のアプリ、tafのCardがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화가 진행되면서 계획, 연결 중인 앱, taf의 Card가 여기에 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokalbiui vykstant, čia rodomas planas, jungiamos programėlės ir taf Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarunas gaitā šeit parādās plāns, pievienojamās lietotnes un taf Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naarmate het gesprek vordert, verschijnen hier het plan, de apps die worden gekoppeld en de Card van het taf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W miarę rozmowy pojawią się tu plan, łączone aplikacje i Card tafa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "À medida que a conversa avança, o plano, as apps a ligar e o Card do taf aparecem aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À medida que a conversa avança, o plano, os apps a conectar e o Card do taf aparecem aqui."
          }
        }
      }
    },
