    "sign_in.not_signed_out": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-də hələ çıxış edilməyib. Yenidən cəhd edin və ya bu telefonu başqa cihazın Cihazlar bölməsindən çıxış etdirin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още не сте излезли от KIFF. Опитайте отново или изведете този телефон от „Устройства“ на друго устройство."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V KIFF ještě nejste odhlášeni. Zkuste to znovu, nebo tento telefon odhlaste v Zařízeních na jiném zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei KIFF noch nicht abgemeldet. Versuch es erneut oder melde dieses Telefon über „Geräte“ auf einem anderen Gerät ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed out at KIFF yet. Try again, or sign this phone out from another device's Devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha cerrado la sesión en KIFF. Vuelve a intentarlo, o cierra la sesión de este teléfono desde Dispositivos en otro dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFis pole veel välja logitud. Proovi uuesti või logi see telefon välja teise seadme vaatest Seadmed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore déconnecté de KIFF. Réessayez, ou déconnectez ce téléphone depuis Appareils sur un autre appareil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još niste odjavljeni u KIFF-u. Pokušajte ponovno ili odjavite ovaj telefon u Uređajima na drugom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF-ből még nem jelentkeztél ki. Próbáld újra, vagy jelentkeztesd ki ezt a telefont egy másik eszköz Eszközök részében."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ից դեռ դուրս չեք եկել։ Փորձեք նորից, կամ դուրս բերեք այս հեռախոսը մեկ այլ սարքի «Սարքեր»-ից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum keluar di KIFF. Coba lagi, atau keluarkan ponsel ini dari Perangkat di perangkat lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora disconnesso da KIFF. Riprova, o disconnetti questo telefono da Dispositivi su un altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFではまだサインアウトしていません。もう一度試すか、別のデバイスの「デバイス」からこのスマートフォンをサインアウトしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ში ჯერ არ გამოსულხართ. სცადეთ ხელახლა, ან გამოიყვანეთ ეს ტელეფონი სხვა მოწყობილობის „მოწყობილობებიდან“."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 KIFF에서 로그아웃되지 않았습니다. 다시 시도하거나, 다른 기기의 기기 목록에서 이 휴대폰을 로그아웃하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF dar neatjungė šio telefono. Bandykite dar kartą arba atjunkite jį iš kito įrenginio skilties „Įrenginiai“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF šo tālruni vēl nav izrakstījis. Mēģini vēlreiz vai izraksti šo tālruni no citas ierīces sadaļas “Ierīces”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet uitgelogd bij KIFF. Probeer het opnieuw, of log deze telefoon uit via Apparaten op een ander apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie wylogowano w KIFF. Spróbuj ponownie albo wyloguj ten telefon z sekcji Urządzenia na innym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem sessão terminada no KIFF. Tente novamente, ou termine a sessão deste telefone em Dispositivos noutro dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não saiu do KIFF. Tente novamente, ou encerre a sessão deste telefone em Dispositivos em outro dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu sunteți deconectat de la KIFF. Încercați din nou sau deconectați acest telefon din secțiunea Dispozitive a altui dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V KIFF ešte nie ste odhlásení. Skúste to znova, alebo tento telefón odhláste v Zariadeniach na inom zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri KIFF še niste odjavljeni. Poskusite znova ali odjavite ta telefon v Napravah na drugi napravi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende nuk keni dalë në KIFF. Provoni sërish, ose nxirreni këtë telefon nga Pajisjet e një pajisjeje tjetër."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Još niste odjavljeni u KIFF-u. Pokušajte ponovo ili odjavite ovaj telefon u Uređajima na drugom uređaju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ออกจากระบบที่ KIFF ลองอีกครั้ง หรือออกจากระบบโทรศัพท์เครื่องนี้จากอุปกรณ์ของอุปกรณ์เครื่องอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF'te henüz oturum kapatılmadı. Tekrar deneyin veya bu telefonun oturumunu başka bir cihazın Cihazlar bölümünden kapatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đăng xuất tại KIFF. Hãy thử lại, hoặc đăng xuất điện thoại này từ mục Thiết bị của một thiết bị khác."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未在 KIFF 登出。請再試一次，或從另一部裝置的「裝置」中登出這部手機。"
          }
        }
      }
    },
    "sign_in.not_signed_out_device": {
