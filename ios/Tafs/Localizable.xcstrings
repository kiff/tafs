    "knob.caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى يبدأ، ماذا يفعل بالترتيب، أين تذهب النتيجة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nə vaxt başlayır, Nə edir ardıcıllıqla, Nəticə hara gedir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кога стартира, Какво прави по ред, Къде отива резултатът."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কখন শুরু হয়, ক্রমানুসারে কী করে, ফলাফল কোথায় যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan comença, Què fa per ordre, On va el resultat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdy ho spouští, Co dělá a v jakém pořadí, Kam jde výsledek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann: was ihn startet. Was: was er der Reihe nach tut. Wohin: wohin das Ergebnis geht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When starts it, What it does in order, Where the result goes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo empieza, Qué hace en orden, Dónde va el resultado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Millal: mis selle käivitab. Mida: mida see järjest teeb. Kuhu: kuhu tulemus läheb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand : ce qui le lance. Quoi : ce qu'il fait, dans l'ordre. Où : où va le résultat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתי מתחיל, מה עושה לפי הסדר, לאן התוצאה הולכת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कब शुरू होता है, क्या करता है क्रम से, नतीजा कहाँ जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad počinje, Što radi redom, Kamo ide rezultat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikor indul, Mit csinál sorrendben, Hova megy az eredmény."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երբ է սկսվում, Ինչ է անում հերթականությամբ, Ուր է գնում արդյունքը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapan dimulai, Apa yang dilakukan berurutan, Ke mana hasil pergi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando lo avvia, Cosa fa in ordine, Dove va il risultato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつ始まるか、何を順に行うか、結果をどこに送るか。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "როდის იწყებს, რას აკეთებს თანმიმდევრობით, სად მიდის შედეგი."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពេលណាចាប់ផ្តើម អ្វីដែលវាធ្វើតាមលំដាប់ កន្លែងដែលលទ្ធផលទៅ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제 시작하는지, 무엇을 순서대로 하는지, 결과를 어디로 보내는지."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເລີ່ມເມື່ອໃດ, ເຮັດຫຍັງຕາມລຳດັບ, ຜົນລັບໄປໃສ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada: kas jį paleidžia. Ką: ką jis daro iš eilės. Kur: kur patenka rezultatas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad tas sākas, Ko tas dara pēc kārtas, Kur nonāk rezultāts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кога почнува, Што прави по ред, Каде оди резултатот."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэзээ эхэлдэг, Юу хийдэг дарааллаар, Үр дүн хаашаа очдог."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कहिले सुरु हुन्छ, के गर्छ क्रमैसँग, नतिजा कहाँ जान्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer het start, Wat het op volgorde doet, Waar het resultaat heen gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy go uruchamia, Co robi po kolei, Dokąd trafia wynik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o inicia, O que faz por ordem, Onde vai o resultado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o inicia, O que faz por ordem, Onde vai o resultado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când pornește, Ce face în ordine, Unde merge rezultatul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedy ho spúšťa, Čo robí a v akom poradí, Kam ide výsledok."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdaj ga zažene, Kaj naredi po vrsti, Kam gre rezultat."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur e nis, Çfarë bën sipas radhës, Ku shkon rezultati."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad počinje, Šta radi redom, Kamo ide rezultat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อไรที่มันเริ่ม สิ่งที่มันทำตามลำดับ ผลลัพธ์ไปที่ไหน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Haçan başlaýar, Näme edýär yzygiderlikde, Netije nirä gidýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne zaman başlar, Ne yapar (sırayla), Sonuç nereye gider."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کب اسے شروع کرتا ہے، کیا یہ ترتیب سے کرتا ہے، نتیجہ کہاں جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi nào nó bắt đầu, Nó làm gì theo thứ tự, Kết quả đi đâu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "何時啟動，依序做什麼，結果送往何處。"
          }
        }
      }
    },
