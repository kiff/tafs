    "help.code_lead": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّله في %1$@ › %2$@. بعد ذلك، عندما تطلب، يرسل KIFF بالبريد الإلكتروني رمزًا يعمل مرة واحدة، لمدة 10 دقائق، في المتصفح الذي طلبه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu %1$@ › %2$@ bölməsində aktiv edin. Sonra istədikdə KIFF bir dəfə, 10 dəqiqə ərzində, onu istəyən brauzerdə işləyən kodu e-poçtla göndərir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включете го в %1$@ › %2$@. След това, когато поискате, KIFF изпраща по имейл код, който важи веднъж, 10 минути, в браузъра, който го е поискал."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি %1$@ › %2$@-এ চালু করুন। এরপর আপনি চাইলে KIFF ইমেইলে এমন একটি কোড পাঠায় যা একবারই, ১০ মিনিট, যে ব্রাউজার চেয়েছে তাতে কাজ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa-ho a %1$@ › %2$@. Després, quan ho demanis, KIFF t'envia per correu un codi que serveix una sola vegada, durant 10 minuts, al navegador que l'ha demanat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte to v části %1$@ › %2$@. Pak vám KIFF na požádání pošle e-mailem kód, který platí jednou, 10 minut, v prohlížeči, který o něj požádal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte es unter %1$@ › %2$@ ein. Dann schickt dir KIFF auf Wunsch einen Code per E-Mail, der einmal gilt, 10 Minuten lang, in dem Browser, der ihn angefordert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on in %1$@ › %2$@. Then, when you ask, KIFF emails a code that works once, for 10 minutes, in the browser that asked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en %1$@ › %2$@. Después, cuando lo pidas, KIFF te envía por correo un código que sirve una sola vez, durante 10 minutos, en el navegador que lo pidió."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita see sisse jaotises %1$@ › %2$@. Siis saadab KIFF sinu soovil e-kirjaga koodi, mis kehtib ühe korra, 10 minutit, selles brauseris, mis seda küsis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le dans %1$@ › %2$@. Ensuite, quand vous le demandez, KIFF envoie par e-mail un code valable une seule fois, pendant 10 minutes, dans le navigateur qui l'a demandé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו זאת ב-%1$@ › %2$@. אחר כך, כשתבקשו, KIFF שולח במייל קוד שפועל פעם אחת, 10 דקות, בדפדפן שביקש אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे %1$@ › %2$@ में चालू करें। फिर, जब आप मांगें, KIFF ईमेल से एक कोड भेजता है जो एक बार, 10 मिनट तक, उसी ब्राउज़र में काम करता है जिसने मांगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite to u %1$@ › %2$@. Zatim vam KIFF na zahtjev e-poštom šalje kod koji vrijedi jednom, 10 minuta, u pregledniku koji ga je zatražio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be itt: %1$@ › %2$@. Ezután kérésedre a KIFF e-mailben küld egy kódot, amely egyszer érvényes, 10 percig, abban a böngészőben, amelyik kérte."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միացրեք այն %1$@ › %2$@-ում։ Հետո, երբ խնդրեք, KIFF-ը էլ. փոստով կուղարկի կոդ, որը գործում է մեկ անգամ, 10 րոպե, այն դիտարկիչում, որը խնդրել է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan di %1$@ › %2$@. Setelah itu, saat Anda memintanya, KIFF mengirim kode lewat email yang berlaku sekali, selama 10 menit, di browser yang memintanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo in %1$@ › %2$@. Poi, quando lo chiedi, KIFF ti manda per email un codice valido una sola volta, per 10 minuti, nel browser che l'ha richiesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ › %2$@ でオンにします。その後、依頼すると、KIFF が一度だけ、10 分間、依頼したブラウザーで使えるコードをメールで送ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართეთ %1$@ › %2$@-ში. შემდეგ, როცა მოითხოვთ, KIFF ელფოსტით გამოგიგზავნით კოდს, რომელიც მოქმედებს ერთხელ, 10 წუთის განმავლობაში, იმ ბრაუზერში, რომელმაც მოითხოვა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើវានៅក្នុង %1$@ › %2$@។ បន្ទាប់មក នៅពេលអ្នកស្នើសុំ KIFF នឹងផ្ញើកូដតាមអ៊ីមែលដែលប្រើបានតែម្តង ក្នុងរយៈពេល 10 នាទី នៅក្នុងកម្មវិធីរុករកដែលបានស្នើសុំ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ › %2$@에서 켜세요. 그다음 요청하면 KIFF가 한 번만, 10분 동안, 요청한 브라우저에서 쓸 수 있는 코드를 이메일로 보냅니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເປີດມັນໃນ %1$@ › %2$@. ຈາກນັ້ນ ເມື່ອທ່ານຂໍ KIFF ຈະສົ່ງລະຫັດທາງອີເມວທີ່ໃຊ້ໄດ້ຄັ້ງດຽວ ພາຍໃນ 10 ນາທີ ໃນບຣາວເຊີທີ່ຂໍ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjunkite tai skiltyje %1$@ › %2$@. Tada, kai paprašysite, KIFF el. paštu atsiųs kodą, kuris veikia vieną kartą, 10 minučių, naršyklėje, kuri jo paprašė."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieslēdz to sadaļā %1$@ › %2$@. Tad, kad pieprasīsi, KIFF nosūtīs e-pastā kodu, kas darbojas vienu reizi, 10 minūtes, pārlūkā, kas to pieprasīja."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вклучете го во %1$@ › %2$@. Потоа, кога ќе побарате, KIFF праќа по е-пошта код што важи еднаш, 10 минути, во прелистувачот што го побарал."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үүнийг %1$@ › %2$@-д асаа. Дараа нь чи хүсвэл KIFF нэг удаа, 10 минутын турш, хүссэн хөтөч дээр ажиллах кодыг и-мэйлээр илгээнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसलाई %1$@ › %2$@ मा खोल्नुहोस्। त्यसपछि तपाईंले अनुरोध गर्दा KIFF ले एक पटक मात्र काम गर्ने, १० मिनेटसम्म, अनुरोध गरेको ब्राउजरमा चल्ने कोड इमेलमा पठाउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet het aan in %1$@ › %2$@. Als je erom vraagt, mailt KIFF je daarna een code die één keer werkt, 10 minuten lang, in de browser die erom vroeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz to w %1$@ › %2$@. Potem, gdy o to poprosisz, KIFF wyśle e-mailem kod, który działa raz, przez 10 minut, w przeglądarce, która o niego poprosiła."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative-o em %1$@ › %2$@. Depois, quando o pedir, o KIFF envia-lhe por email um código que serve uma só vez, durante 10 minutos, no navegador que o pediu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative em %1$@ › %2$@. Depois, quando você pedir, o KIFF envia por e-mail um código que vale uma única vez, por 10 minutos, no navegador que o pediu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează-l în %1$@ › %2$@. Apoi, când ceri, KIFF îți trimite pe e-mail un cod care funcționează o singură dată, 10 minute, în browserul care l-a cerut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite to v časti %1$@ › %2$@. Potom vám KIFF na požiadanie pošle e-mailom kód, ktorý platí raz, 10 minút, v prehliadači, ktorý oň požiadal."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite to v razdelku %1$@ › %2$@. Nato vam KIFF na zahtevo pošlje kodo, ki velja enkrat, 10 minut, v brskalniku, ki jo je zahteval."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivizojeni te %1$@ › %2$@. Pastaj, kur e kërkoni, KIFF ju dërgon me email një kod që vlen një herë, për 10 minuta, në shfletuesin që e kërkoi."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite to u %1$@ › %2$@. Zatim vam KIFF na zahtev šalje e-poštom kod koji važi jednom, 10 minuta, u pregledaču koji ga je zatražio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้ที่ %1$@ › %2$@ จากนั้นเมื่อคุณขอ KIFF จะส่งรหัสทางอีเมลที่ใช้ได้ครั้งเดียว ภายใน 10 นาที ในเบราว์เซอร์ที่ขอ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ony %1$@ › %2$@ bölüminde açyň. Soňra siz soranyňyzda, KIFF bir gezek, 10 minutlap, ony soran brauzerde işleýän kody email bilen iberýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu %1$@ › %2$@ bölümünden aç. Sonra istediğinde KIFF, bir kez geçerli olan, 10 dakika boyunca, isteyen tarayıcıda çalışan bir kodu e-postayla gönderir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے %1$@ › %2$@ میں چالو کریں۔ پھر، جب آپ مانگیں، KIFF ای میل سے ایک کوڈ بھیجتا ہے جو ایک بار، 10 منٹ تک، اسی براؤزر میں کام کرتا ہے جس نے مانگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật tính năng này ở %1$@ › %2$@. Sau đó, khi bạn yêu cầu, KIFF gửi qua email một mã dùng được một lần, trong 10 phút, trên trình duyệt đã yêu cầu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %1$@ › %2$@ 開啟。之後您提出要求時，KIFF 會以電子郵件寄出一組代碼，僅能使用一次、10 分鐘內有效，且只能在提出要求的瀏覽器中使用。"
          }
        }
      }
    },
