    "approval.first_taf": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج إعداد taf إلى موافقات: يطلب منك Coach الموافقة على أدواته وعلى Card الخاصة بالـ taf."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-ın qurulması təsdiqlər tələb edir: Coach sizdən onun alətlərini və taf-ın Card-ını təsdiq etməyi xahiş edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройването на taf изисква одобрения: Coach ви моли да одобрите инструментите му и Card на taf."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "taf সেট আপ করতে অনুমোদন লাগে: Coach আপনাকে তার টুল ও taf-এর Card অনুমোদন করতে বলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurar un taf necessita aprovacions: Coach et demana que n'aprovis les eines i el Card del taf."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení tafu potřebuje schvalování: Coach vás požádá o schválení svých nástrojů a Card tafu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen taf einzurichten braucht Genehmigungen: Coach bittet dich, seine Tools und die Card des tafs zu genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting up a taf needs approvals: Coach asks you to approve its tools and the taf's Card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
