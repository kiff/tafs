        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ মোট %1$@, তারপর আপনাকে জিজ্ঞেস করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
