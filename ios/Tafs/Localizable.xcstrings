    "connect.disconnect.rest": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ istifadə edən digər taf-lar girişlərini saxlayır. Orada eyni hesabdan başqa taf istifadə etmirsə, %1$@ saytında giriş ləğv edilir; əks halda sonuncu silinəndə. %1$@ xidmətini yenidən istifadə etmək sizdən təsdiq etməyi və yenidən daxil olmağı xahiş edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Другите tafs, които използват %1$@, запазват достъпа си. Ако никой друг taf не използва същия акаунт там, входът се оттегля в %1$@; иначе — когато бъде премахнат последният. Повторното използване на %1$@ изисква да одобрите и да влезете отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatní tafy, které používají %1$@, si přístup nechají. Pokud tam stejný účet nepoužívá žádný jiný taf, přihlášení se u %1$@ odvolá; jinak až po odstranění posledního. Opětovné použití %1$@ vás požádá o schválení a nové přihlášení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere tafs, die %1$@ nutzen, behalten ihren Zugriff. Nutzt kein anderer taf dasselbe Konto dort, wird die Anmeldung bei %1$@ widerrufen; sonst, wenn der letzte entfernt wird. Wenn du %1$@ wieder nutzt, wirst du gebeten, erneut zu genehmigen und dich erneut anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other tafs that use %1$@ keep their access. If no other taf uses the same account there, the sign-in is revoked at %1$@; otherwise, when the last one is removed. Using %1$@ again asks you to approve and sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los demás tafs que usan %1$@ conservan su acceso. Si ningún otro taf usa la misma cuenta, el inicio de sesión se revoca en %1$@; si no, cuando se quita el último. Usar %1$@ de nuevo te pide aprobar e iniciar sesión otra vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teised tafid, mis kasutavad teenust %1$@, säilitavad oma juurdepääsu. Kui ükski teine taf ei kasuta seal sama kontot, tühistatakse sisselogimine teenuses %1$@; vastasel juhul siis, kui viimane neist eemaldatakse. Teenuse %1$@ uuesti kasutamisel pead uuesti kinnitama ja sisse logima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres tafs qui utilisent %1$@ gardent leur accès. Si aucun autre taf n'utilise le même compte, l'identifiant est révoqué chez %1$@ ; sinon, quand le dernier est retiré. Utiliser %1$@ à nouveau vous demande d'approuver et de vous reconnecter."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostali tafovi koji koriste aplikaciju %1$@ zadržavaju svoj pristup. Ako nijedan drugi taf tamo ne koristi isti račun, prijava se opoziva kod pružatelja %1$@; inače, kad se ukloni zadnji. Ponovno korištenje aplikacije %1$@ traži da odobrite i ponovno se prijavite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi taf, amely ezt használja (%1$@), megtartja a hozzáférését. Ha ott egyetlen másik taf sem használja ugyanazt a fiókot, a bejelentkezés visszavonásra kerül itt: %1$@; egyébként akkor, amikor az utolsót is eltávolítod. Ha újra használod ezt (%1$@), újra jóvá kell hagynod és be kell jelentkezned."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մյուս taf-երը, որ օգտագործում են %1$@-ը, պահում են իրենց հասանելիությունը։ Եթե ուրիշ taf չի օգտագործում նույն հաշիվը այնտեղ, մուտքը չեղարկվում է %1$@-ի մոտ․ հակառակ դեպքում՝ երբ վերջինը հեռացվի։ %1$@-ը նորից օգտագործելը խնդրում է ձեզ հաստատել և նորից մուտք գործել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf lain yang memakai %1$@ tetap memiliki aksesnya. Jika tidak ada taf lain yang memakai akun yang sama di sana, proses masuk dicabut di %1$@; jika tidak, saat yang terakhir dihapus. Memakai %1$@ lagi meminta Anda menyetujui dan masuk lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri taf che usano %1$@ mantengono il loro accesso. Se nessun altro taf usa lo stesso account, il login viene revocato presso %1$@; altrimenti, quando viene rimosso l'ultimo. Usare di nuovo %1$@ ti chiede di approvare e accedere di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を使う他のtafはアクセスを保持します。同じアカウントを使う他のtafがなければ、%1$@でサインインが取り消されます。あれば、最後のtafを外したときに取り消されます。再び%1$@を使うには、もう一度承認とサインインが必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვა taf-ები, რომლებიც %1$@-ს იყენებენ, წვდომას ინარჩუნებენ. თუ სხვა taf იმავე ანგარიშს იქ არ იყენებს, შესვლა უქმდება %1$@-თან; სხვაგვარად, როცა ბოლო ამოიღება. %1$@-ის ხელახლა გამოყენება გთხოვთ დაამტკიცოთ და ხელახლა შეხვიდეთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 쓰는 다른 tafs는 접근 권한을 유지합니다. 같은 계정을 쓰는 다른 taf가 없으면 %1$@에서 로그인이 취소되고, 있으면 마지막 taf를 제거할 때 취소됩니다. %1$@을(를) 다시 쓰려면 다시 승인하고 로그인해야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiti %1$@ naudojantys taf išlaiko savo prieigą. Jei joks kitas taf nenaudoja tos pačios paskyros ten, prisijungimas atšaukiamas %1$@ pusėje; kitu atveju – kai pašalinamas paskutinis. Norint vėl naudoti %1$@, reikės dar kartą patvirtinti ir prisijungti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Citi taf, kas izmanto %1$@, patur savu piekļuvi. Ja neviens cits taf tur neizmanto to pašu kontu, pierakstīšanās %1$@ tiek atsaukta; citādi – kad tiek noņemts pēdējais. Lai atkal izmantotu %1$@, tev būs vēlreiz jāapstiprina un jāpierakstās."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere tafs die %1$@ gebruiken, houden hun toegang. Als geen andere taf hetzelfde account gebruikt, wordt de aanmelding bij %1$@ ingetrokken; anders pas als de laatste wordt verwijderd. Als je %1$@ weer gebruikt, word je gevraagd opnieuw goed te keuren en je aan te melden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne tafy, które używają %1$@, zachowują dostęp. Jeśli żaden inny taf nie używa tego samego konta, logowanie zostanie cofnięte w %1$@; w przeciwnym razie, gdy usuniesz ostatni. Ponowne użycie %1$@ poprosi Cię o zatwierdzenie i ponowne zalogowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros tafs que usam %1$@ mantêm o seu acesso. Se nenhum outro taf usar a mesma conta, o início de sessão é revogado em %1$@; caso contrário, quando o último for removido. Usar %1$@ novamente pede-lhe que aprove e inicie sessão de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros tafs que usam %1$@ mantêm o acesso deles. Se nenhum outro taf usar a mesma conta, o login é revogado em %1$@; caso contrário, quando o último for removido. Usar %1$@ novamente pede que você aprove e faça login de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Celelalte tafuri care folosesc %1$@ își păstrează accesul. Dacă niciun alt taf nu folosește același cont acolo, conectarea este revocată la %1$@; altfel, când este eliminat ultimul. Dacă folosiți din nou %1$@, vi se cere să aprobați și să vă conectați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatné tafy, ktoré používajú %1$@, si prístup nechajú. Ak tam rovnaký účet nepoužíva žiadny iný taf, prihlásenie sa u %1$@ odvolá; inak až po odstránení posledného. Opätovné použitie %1$@ vás požiada o schválenie a nové prihlásenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi tafi, ki uporabljajo %1$@, obdržijo dostop. Če istega računa tam ne uporablja noben drug taf, se prijava pri %1$@ odvzame; sicer ko je odstranjen zadnji. Ponovna uporaba %1$@ vas prosi za odobritev in novo prijavo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs-et e tjerë që përdorin %1$@ e mbajnë qasjen e tyre. Nëse asnjë taf tjetër nuk përdor të njëjtën llogari aty, hyrja revokohet te %1$@; përndryshe, kur të hiqet i fundit. Përdorimi i %1$@ sërish ju kërkon të miratoni dhe të hyni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostali tafovi koji koriste aplikaciju %1$@ zadržavaju svoj pristup. Ako nijedan drugi taf tamo ne koristi isti nalog, prijava se opoziva kod pružatelja %1$@; inače, kad se ukloni poslednji. Ponovo korišćenje aplikacije %1$@ traži da odobrite i ponovo se prijavite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "taf อื่นที่ใช้ %1$@ ยังคงมีสิทธิ์เข้าถึง หากไม่มี taf อื่นใช้บัญชีเดียวกันที่นั่น การเข้าสู่ระบบจะถูกเพิกถอนที่ %1$@ มิฉะนั้นจะถูกเพิกถอนเมื่อ taf สุดท้ายถูกนำออก การใช้ %1$@ อีกครั้งจะขอให้คุณอนุมัติและเข้าสู่ระบบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kullanan diğer tafs erişimini korur. Orada aynı hesabı kullanan başka taf yoksa oturum açma %1$@ tarafında iptal edilir; aksi halde sonuncusu kaldırıldığında. %1$@ uygulamasını tekrar kullanmak, onaylamanızı ve tekrar oturum açmanızı ister."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các taf khác dùng %1$@ vẫn giữ quyền truy cập. Nếu không taf nào khác dùng cùng tài khoản đó, việc đăng nhập sẽ bị thu hồi tại %1$@; nếu không, nó bị thu hồi khi taf cuối cùng bị gỡ. Dùng %1$@ lại sẽ yêu cầu bạn phê duyệt và đăng nhập lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他使用 %1$@ 的 taf 仍保有存取權限。若沒有其他 taf 在該處使用同一個帳號，登入會在 %1$@ 撤銷；否則會在最後一個被移除時撤銷。再次使用 %1$@ 時，會請您核准並重新登入。"
          }
        }
      }
    },
    "connect.disconnect.rest_key": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ istifadə edən digər taf-lar girişlərini saxlayır. Heç bir taf açardan istifadə etməyəndə o, tafs-dan silinir. %1$@ xidmətini yenidən istifadə etmək sizdən təsdiq etməyi və açarı yenidən yapışdırmağı xahiş edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Другите tafs, които използват %1$@, запазват достъпа си. Ключът се изтрива от tafs, щом никой taf не го използва. Повторното използване на %1$@ изисква да одобрите и да поставите ключ отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatní tafy, které používají %1$@, si přístup nechají. Klíč se z tafs smaže, jakmile ho žádný taf nepoužívá. Opětovné použití %1$@ vás požádá o schválení a nové vložení klíče."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere tafs, die %1$@ nutzen, behalten ihren Zugriff. Der Schlüssel wird aus tafs gelöscht, sobald ihn kein taf mehr nutzt. Wenn du %1$@ wieder nutzt, wirst du gebeten, erneut zu genehmigen und einen Schlüssel einzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other tafs that use %1$@ keep their access. The key is deleted from tafs once no taf uses it. Using %1$@ again asks you to approve and paste a key again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los demás tafs que usan %1$@ conservan su acceso. La clave se elimina de tafs cuando ya ningún taf la use. Usar %1$@ de nuevo te pide aprobar y pegar una clave otra vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teised tafid, mis kasutavad teenust %1$@, säilitavad oma juurdepääsu. Võti kustutatakse tafsist, kui ükski taf seda enam ei kasuta. Teenuse %1$@ uuesti kasutamisel pead uuesti kinnitama ja võtme uuesti kleepima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres tafs qui utilisent %1$@ gardent leur accès. La clé est supprimée de tafs dès qu'aucun taf ne l'utilise. Utiliser %1$@ à nouveau vous demande d'approuver et de coller une clé à nouveau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostali tafovi koji koriste aplikaciju %1$@ zadržavaju svoj pristup. Ključ se briše iz tafsa čim ga nijedan taf ne koristi. Ponovno korištenje aplikacije %1$@ traži da odobrite i ponovno zalijepite ključ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi taf, amely ezt használja (%1$@), megtartja a hozzáférését. A kulcs törlődik a tafsből, amint egyetlen taf sem használja. Ha újra használod ezt (%1$@), újra jóvá kell hagynod és be kell illesztened egy kulcsot."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մյուս taf-երը, որ օգտագործում են %1$@-ը, պահում են իրենց հասանելիությունը։ Բանալին ջնջվում է tafs-ից, հենց որ ոչ մի taf այլևս չի օգտագործում այն։ %1$@-ը նորից օգտագործելը խնդրում է ձեզ հաստատել և նորից ներդնել բանալին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf lain yang memakai %1$@ tetap memiliki aksesnya. Kunci dihapus dari tafs setelah tidak ada taf yang memakainya. Memakai %1$@ lagi meminta Anda menyetujui dan menempelkan kunci lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri taf che usano %1$@ mantengono il loro accesso. La chiave viene eliminata da tafs quando nessun taf la usa più. Usare di nuovo %1$@ ti chiede di approvare e incollare di nuovo una chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を使う他のtafはアクセスを保持します。キーは、使うtafがなくなるとtafsから削除されます。再び%1$@を使うには、もう一度承認とキーの貼り付けが必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვა taf-ები, რომლებიც %1$@-ს იყენებენ, წვდომას ინარჩუნებენ. გასაღები tafs-იდან იშლება, როგორც კი არც ერთი taf მას აღარ იყენებს. %1$@-ის ხელახლა გამოყენება გთხოვთ დაამტკიცოთ და გასაღები ხელახლა ჩასვათ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 쓰는 다른 tafs는 접근 권한을 유지합니다. 키를 쓰는 taf가 없으면 tafs에서 키가 삭제됩니다. %1$@을(를) 다시 쓰려면 다시 승인하고 키를 붙여 넣어야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiti %1$@ naudojantys taf išlaiko savo prieigą. Raktas ištrinamas iš tafs, kai jo nebenaudoja nė vienas taf. Norint vėl naudoti %1$@, reikės dar kartą patvirtinti ir įklijuoti raktą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Citi taf, kas izmanto %1$@, patur savu piekļuvi. Atslēga tiek dzēsta no tafs, kad to vairs neizmanto neviens taf. Lai atkal izmantotu %1$@, tev būs vēlreiz jāapstiprina un jāielīmē atslēga."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere tafs die %1$@ gebruiken, houden hun toegang. De sleutel wordt uit tafs verwijderd zodra geen enkel taf hem nog gebruikt. Als je %1$@ weer gebruikt, word je gevraagd opnieuw goed te keuren en een sleutel te plakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne tafy, które używają %1$@, zachowują dostęp. Klucz zostanie usunięty z tafs, gdy żaden taf nie będzie go już używał. Ponowne użycie %1$@ poprosi Cię o zatwierdzenie i ponowne wklejenie klucza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros tafs que usam %1$@ mantêm o seu acesso. A chave é eliminada do tafs assim que nenhum taf a usar. Usar %1$@ novamente pede-lhe que aprove e cole uma chave de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros tafs que usam %1$@ mantêm o acesso deles. A chave é excluída do tafs assim que nenhum taf a usar. Usar %1$@ novamente pede que você aprove e cole uma chave de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Celelalte tafuri care folosesc %1$@ își păstrează accesul. Cheia se șterge din tafs când niciun taf nu o mai folosește. Dacă folosiți din nou %1$@, vi se cere să aprobați și să lipiți din nou o cheie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatné tafy, ktoré používajú %1$@, si prístup nechajú. Kľúč sa z tafs odstráni, keď ho žiadny taf nepoužíva. Opätovné použitie %1$@ vás požiada o schválenie a nové vloženie kľúča."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi tafi, ki uporabljajo %1$@, obdržijo dostop. Ključ se iz tafs izbriše, ko ga ne uporablja noben taf. Ponovna uporaba %1$@ vas prosi za odobritev in ponovno vstavitev ključa."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs-et e tjerë që përdorin %1$@ e mbajnë qasjen e tyre. Çelësi fshihet nga tafs sapo asnjë taf nuk e përdor. Përdorimi i %1$@ sërish ju kërkon të miratoni dhe të ngjitni një çelës sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostali tafovi koji koriste aplikaciju %1$@ zadržavaju svoj pristup. Ključ se briše iz tafsa čim ga nijedan taf ne koristi. Ponovo korišćenje aplikacije %1$@ traži da odobrite i ponovo nalepite ključ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "taf อื่นที่ใช้ %1$@ ยังคงมีสิทธิ์เข้าถึง กุญแจจะถูกลบออกจาก tafs เมื่อไม่มี taf ใดใช้ การใช้ %1$@ อีกครั้งจะขอให้คุณอนุมัติและวางกุญแจอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kullanan diğer tafs erişimini korur. Hiçbir taf kullanmadığında anahtar tafs'tan silinir. %1$@ uygulamasını tekrar kullanmak, onaylamanızı ve bir anahtarı tekrar yapıştırmanızı ister."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các taf khác dùng %1$@ vẫn giữ quyền truy cập. Khóa bị xóa khỏi tafs khi không còn taf nào dùng nó. Dùng %1$@ lại sẽ yêu cầu bạn phê duyệt và dán lại một khóa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他使用 %1$@ 的 taf 仍保有存取權限。當沒有 taf 使用該金鑰時，金鑰會從 tafs 中刪除。再次使用 %1$@ 時，會請您核准並重新貼上金鑰。"
          }
        }
      }
    },
