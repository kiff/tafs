            "state": "translated",
            "value": "Geannuleerd. Er is niets veranderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowano. Nic się nie zmieniło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado. Nada mudou."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado. Nada mudou."
          }
        }
      }
    },
    "approval.cancelled_nothing_approved_request_kept": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochen, also wurde nichts genehmigt. Die Anfrage bleibt erhalten: Genehmige erneut, wenn du so weit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled, so nothing was approved. The request is kept: approve again when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado, así que no se aprobó nada. La solicitud se conserva: vuelve a aprobar cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Katkestatud, seega midagi ei kinnitatud. Päring jääb alles: kinnita uuesti, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulé : rien n'a été approuvé. La demande est conservée : approuvez à nouveau quand vous êtes prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullato, quindi non è stato approvato nulla. La richiesta resta: approva di nuovo quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしたため、何も承認されていません。リクエストは保持されています。準備ができたらもう一度承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소되어 승인된 것은 없습니다. 요청은 남아 있으니 준비되면 다시 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atšaukta, todėl niekas nepatvirtinta. Užklausa išsaugota: patvirtinkite dar kartą, kai būsite pasirengę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atcelts, tāpēc nekas netika apstiprināts. Pieprasījums ir saglabāts: apstiprini vēlreiz, kad esi gatavs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geannuleerd, dus er is niets goedgekeurd. Het verzoek blijft bewaard: keur het goed wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowano, więc nic nie zostało zatwierdzone. Prośba zostaje zachowana: zatwierdź ją ponownie, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        }
      }
    },
