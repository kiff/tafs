        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մատնահետքի սենսորը հիմա հնարավոր չէ օգտագործել։ Փորձեք մի պահ անց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor sidik jari tidak dapat digunakan saat ini. Coba lagi sebentar lagi."
