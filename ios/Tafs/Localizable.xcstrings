    "record.event.paired_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسائلهم عبر %1$@ تعطيه عملًا من الآن فصاعدًا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan sonra onun %1$@ ilə mesajları ona iş verir"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съобщенията му през %1$@ му дават работа отсега нататък"
