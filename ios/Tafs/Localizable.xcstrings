    "needs_you.check_code": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob KIFF denselben Code zeigt, und genehmige nur mit diesem Telefon in deinen Händen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that KIFF shows the same code, and approve only with this phone in your hands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que KIFF muestra el mismo código, y aprueba solo con este teléfono en tus manos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que KIFF affiche le même code, et n'approuvez qu'avec ce téléphone en main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che KIFF mostri lo stesso codice, e approva solo con questo telefono in mano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of KIFF dezelfde code toont, en keur alleen goed met deze telefoon in je handen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy KIFF pokazuje ten sam kod, i zatwierdzaj tylko z tym telefonem w rękach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o KIFF mostra o mesmo código, e aprove apenas com este telefone nas suas mãos."
          }
        }
      }
    },
