    "halt_all.description": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün taf-ları bir anda dayandırır. Siz tafs-da onları davam etdirənə qədər heç nə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спира всички tafs наведнъж. Нищо ново не се изпраща, докато не ги възобновите в tafs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví všechny tafy najednou. Nic nového se neodešle, dokud je v tafs znovu nespustíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält jeden taf sofort an. Nichts Neues wird gesendet, bis du sie in tafs fortsetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops every taf at once. Nothing new is sent until you resume them in tafs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea todos los tafs a la vez. No se envía nada nuevo hasta que los reanudes en tafs."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peatab kõik tafid korraga. Midagi uut ei saadeta enne, kui jätkad neid tafsis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque tous les tafs d'un coup. Rien de nouveau n'est envoyé tant que vous ne les reprenez pas dans tafs."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaustavlja svakog tafa odjednom. Ništa novo ne šalje se dok ih ne nastavite u tafsu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszerre leállítja az összes tafot. Semmi új nem megy ki, amíg a tafsban nem folytatod őket."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանգնեցնում է բոլոր taf-երը միանգամից։ Ոչինչ չի ուղարկվում, մինչև tafs-ում չվերսկսեք դրանք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan setiap taf sekaligus. Tidak ada yang baru dikirim sampai Anda melanjutkannya di tafs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca tutti i tafs in una volta. Non viene inviato nulla di nuovo finché non li riprendi in tafs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのtafを一度に止めます。tafsで再開するまで、新しいものは何も送信されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველა taf-ს ერთდროულად აჩერებს. არაფერი იგზავნება, სანამ tafs-ში არ განაახლებთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 taf를 한 번에 멈춥니다. tafs에서 재개할 때까지 새로 보내는 것은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iškart sustabdo visus taf. Nieko naujo nesiunčiama, kol jų netęsite tafs programėlėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptur visus taf uzreiz. Nekas jauns netiek sūtīts, līdz tu tos turpini tafs lietotnē."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet alle tafs in één keer stil. Er wordt niets nieuws verzonden tot je ze in tafs hervat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuje wszystkie tafs naraz. Nic nowego nie zostanie wysłane, dopóki ich nie wznowisz w tafs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia todos os tafs de uma vez. Nada de novo é enviado até os retomar no tafs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia todos os tafs de uma vez. Nada de novo é enviado até os retomar no tafs."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprește toate tafurile deodată. Nimic nou nu se trimite până nu le reluați în tafs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví všetky tafy naraz. Nič nové sa neodošle, kým ich v tafs znova nespustíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustavi vse tafe naenkrat. Nič novega se ne pošlje, dokler jih v tafs ne zaženete znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "I ndalon të gjithë tafs-et menjëherë. Asgjë e re nuk dërgohet derisa t'i riniseni te tafs."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaustavlja svakog tafa odjednom. Ništa novo ne šalje se dok ih ne nastavite u tafsu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดทุก taf พร้อมกัน จะไม่มีอะไรใหม่ถูกส่งจนกว่าคุณจะทำต่อใน tafs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her taf'ı bir anda durdurur. Siz tafs'ta devam ettirene kadar yeni bir şey gönderilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng mọi taf cùng lúc. Sẽ không có gì mới được gửi cho đến khi bạn tiếp tục chúng trong tafs."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次讓所有 taf 停止。在您於 tafs 中繼續之前，不會傳送任何新內容。"
          }
        }
      }
    },
