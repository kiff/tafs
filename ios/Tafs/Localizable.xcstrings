    "chat.stopped.declined": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat gestoppt: Die KI hat es abgelehnt, fortzufahren. Versuch es anders zu formulieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stopped: the AI declined to continue. Try asking another way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detuvo: la IA se negó a continuar. Prueba a pedirlo de otra forma."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lõpetas: tehisintellekt (AI) keeldus jätkamast. Proovi küsida teisiti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s'est arrêté : l'IA a refusé de continuer. Essayez de demander autrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si è fermato: l'IA si è rifiutata di continuare. Prova a chiederlo in un altro modo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が停止しました：AIが続行を断りました。別の聞き方を試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 멈췄습니다: AI가 계속하기를 거부했습니다. 다른 방식으로 요청해 보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sustojo: AI atsisakė tęsti. Pabandykite paklausti kitaip."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ apstājās: AI atteicās turpināt. Pamēģini pajautāt citādi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gestopt: de AI weigerde verder te gaan. Vraag het op een andere manier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatrzymał się: AI odmówiła kontynuowania. Spróbuj zapytać inaczej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: a IA recusou-se a continuar. Experimente pedir de outra forma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: a IA recusou-se a continuar. Experimente pedir de outra forma."
          }
        }
      }
    },
    "chat.stopped.out_of_room": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat gestoppt: Seine Antwort hatte keinen Platz mehr. Bitte um etwas Kürzeres oder um einen Teil nach dem anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stopped: its reply ran out of room. Ask for something shorter, or for one part at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se detuvo: su respuesta se quedó sin espacio. Pide algo más corto, o una parte cada vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lõpetas: selle vastusel sai ruum otsa. Küsi midagi lühemat või üks osa korraga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s'est arrêté : sa réponse a manqué de place. Demandez quelque chose de plus court, ou une partie à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si è fermato: la sua risposta ha esaurito lo spazio. Chiedi qualcosa di più breve, o una parte alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が停止しました：返信が長すぎて収まりませんでした。短く頼むか、一部ずつ頼んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 멈췄습니다: 답변이 길이 한도를 넘었습니다. 더 짧게, 또는 한 부분씩 요청하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sustojo: jo atsakymui pritrūko vietos. Paprašykite ko nors trumpesnio arba po vieną dalį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ apstājās: tā atbildei pietrūka vietas. Palūdz kaut ko īsāku vai pa vienai daļai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gestopt: het antwoord had geen ruimte meer. Vraag om iets korters, of om één deel tegelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatrzymał się: w jego odpowiedzi zabrakło miejsca. Poproś o coś krótszego albo o jedną część naraz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: a resposta ficou sem espaço. Peça algo mais curto, ou uma parte de cada vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou: a resposta ficou sem espaço. Peça algo mais curto, ou uma parte de cada vez."
          }
        }
      }
    },
