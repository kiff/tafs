    "taf.halt.halting_wait": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dondurulur… hər hissənin təsdiqi gözlənilir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спиране… изчакване всяка част да потвърди."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavuji… čekám, až to potvrdí každá část."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird angehalten… wartet, bis jeder Teil bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halting… waiting for every part to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueando… esperando a que todas las partes lo confirmen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peatamine… ootan iga osa kinnitust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocage… en attente de la confirmation de chaque partie."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje… čeka se da svaki dio potvrdi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leállítás… várakozás, hogy minden rész megerősítse."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանգնեցվում է… սպասում ենք, որ յուրաքանչյուր մաս հաստատի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membekukan… menunggu setiap bagian mengonfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocco in corso… in attesa che ogni parte confermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮断しています…すべての部分の確認を待っています。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩერდება… ველოდებით, სანამ ყველა ნაწილი დაადასტურებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단하는 중… 모든 부분이 확인하기를 기다리고 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabdoma… laukiama, kol patvirtins visos dalys."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptur… gaida, kad katra daļa apstiprinās."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilzetten… wacht tot elk onderdeel het bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokowanie… czeka na potwierdzenie każdej części."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A bloquear… à espera de que cada parte confirme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueando… aguardando a confirmação de cada parte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se oprește… se așteaptă confirmarea fiecărei părți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavujem… čakám, kým to potvrdí každá časť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustavljam… čakam, da potrdi vsak del."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Po bllokohet… po pritet që çdo pjesë të konfirmojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje… čeka se da svaki dio potvrdi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังระงับ… รอให้ทุกส่วนยืนยัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donduruluyor… her parçanın onaylaması bekleniyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang đóng băng… chờ mọi phần xác nhận."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "凍結中…正在等待每個部分確認。"
          }
