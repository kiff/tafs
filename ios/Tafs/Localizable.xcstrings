        }
      }
    },
    "approval.security_key.failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على مفتاح الأمان التوقيع، فلم تتم الموافقة على شيء. الطلب محفوظ: وافق مرة أخرى عندما تكون مستعدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təhlükəsizlik açarı imzalaya bilmədi, ona görə heç nə təsdiqlənmədi. Sorğu saxlanılıb: hazır olanda yenidən təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът за сигурност не можа да подпише, така че нищо не беше одобрено. Заявката се запазва: одобрете отново, когато сте готови."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিকিউরিটি কী সই করতে পারেনি, তাই কিছু অনুমোদিত হয়নি। অনুরোধটি রাখা আছে: প্রস্তুত হলে আবার অনুমোদন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La clau de seguretat no ha pogut signar, així que no s'ha aprovat res. La sol·licitud es conserva: torna a aprovar quan estiguis a punt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostní klíč nemohl podepsat, takže se nic neschválilo. Žádost zůstává: schvalte znovu, až budete připraveni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sicherheitsschlüssel konnte nicht signieren, also wurde nichts genehmigt. Die Anfrage bleibt erhalten: Genehmige erneut, wenn du so weit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The security key couldn't sign, so nothing was approved. The request is kept: approve again when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llave de seguridad no pudo firmar, así que no se aprobó nada. La solicitud se conserva: vuelve a aprobar cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Turvavõti ei saanud allkirjastada, seega midagi ei kinnitatud. Päring jääb alles: kinnita uuesti, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de sécurité n'a pas pu signer : rien n'a été approuvé. La demande est conservée : approuvez à nouveau quand vous êtes prêt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח האבטחה לא הצליח לחתום, ולכן שום דבר לא אושר. הבקשה נשמרה: אפשר לאשר שוב כשתהיה מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा कुंजी हस्ताक्षर नहीं कर सकी, इसलिए कुछ मंज़ूर नहीं हुआ। अनुरोध रखा है: तैयार होने पर फिर मंज़ूर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosni ključ nije mogao potpisati pa ništa nije odobreno. Zahtjev je sačuvan: odobrite ponovno kad budete spremni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biztonsági kulcs nem tudott aláírni, így semmi sem lett jóváhagyva. A kérés megmarad: hagyd jóvá újra, ha készen állsz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անվտանգության բանալին չկարողացավ ստորագրել, ուստի ոչինչ չհաստատվեց։ Հարցումը պահպանվել է․ հաստատեք նորից, երբ պատրաստ լինեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci keamanan tidak dapat menandatangani, jadi tidak ada yang disetujui. Permintaan tetap disimpan: setujui lagi saat Anda siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di sicurezza non è riuscita a firmare, quindi non è stato approvato nulla. La richiesta resta: approva di nuovo quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティキーで署名できなかったため、何も承認されていません。リクエストは保持されています。準備ができたらもう一度承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უსაფრთხოების გასაღებმა ხელმოწერა ვერ შეძლო, ამიტომ არაფერი დამტკიცებულა. მოთხოვნა შენახულია: დაამტკიცეთ ხელახლა, როცა მზად იქნებით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សោសុវត្ថិភាពមិនអាចចុះហត្ថលេខាបានទេ ដូច្នេះគ្មានអ្វីត្រូវបានអនុម័តទេ។ សំណើត្រូវបានរក្សាទុក៖ អនុម័តម្តងទៀតនៅពេលអ្នករួចរាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 키로 서명하지 못해 승인된 것은 없습니다. 요청은 남아 있으니 준비되면 다시 승인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກຸນແຈຄວາມປອດໄພລົງລາຍເຊັນບໍ່ໄດ້ ສະນັ້ນບໍ່ມີຫຍັງຖືກອະນຸມັດ. ຄຳຂໍຖືກເກັບໄວ້: ອະນຸມັດອີກເມື່ອທ່ານພ້ອມ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saugos raktas negalėjo pasirašyti, todėl niekas nepatvirtinta. Užklausa išsaugota: patvirtinkite dar kartą, kai būsite pasirengę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drošības atslēga nevarēja parakstīt, tāpēc nekas netika apstiprināts. Pieprasījums ir saglabāts: apstiprini vēlreiz, kad esi gatavs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безбедносниот клуч не можеше да потпише, па ништо не е одобрено. Барањето се чува: одобри повторно кога ќе си подготвен."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Аюулгүй байдлын түлхүүр гарын үсэг зурж чадсангүй тул юу ч зөвшөөрөгдөөгүй. Хүсэлт хадгалагдсан: бэлэн болмогцоо дахин зөвшөөрнө үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा कुञ्जीले हस्ताक्षर गर्न सकेन, त्यसैले केही स्वीकृत भएन। अनुरोध राखिएको छ: तयार हुँदा फेरि स्वीकृत गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beveiligingssleutel kon niet ondertekenen, dus er is niets goedgekeurd. Het verzoek blijft bewaard: keur het goed wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz bezpieczeństwa nie mógł podpisać, więc nic nie zostało zatwierdzone. Prośba zostaje zachowana: zatwierdź ją ponownie, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança não conseguiu assinar, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança não conseguiu assinar, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia de securitate nu a putut semna, așa că nu s-a aprobat nimic. Solicitarea se păstrează: aprobați din nou când sunteți gata."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostný kľúč nemohol podpísať, takže sa nič neschválilo. Žiadosť zostáva: schváľte znova, keď budete pripravení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Varnostni ključ ni mogel podpisati, zato ni bilo nič odobreno. Zahteva ostane: odobrite znova, ko boste pripravljeni."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çelësi i sigurisë nuk mundi të nënshkruajë, ndaj asgjë nuk u miratua. Kërkesa ruhet: miratoni sërish kur të jeni gati."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosni ključ nije mogao da potpiše, pa ništa nije odobreno. Zahtev je sačuvan: odobrite ponovo kad budete spremni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กุญแจความปลอดภัยลงนามไม่ได้ จึงไม่มีอะไรถูกอนุมัติ คำขอยังอยู่: อนุมัติอีกครั้งเมื่อคุณพร้อม"
