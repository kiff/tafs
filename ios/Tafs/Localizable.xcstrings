    "settings.each_sends_who_answered_through": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede sagt, wem über welche Tür geantwortet wurde, nie den Wortlaut. Ausschalten kannst du das im Setup des tafs › Ergebnisse gehen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each sends who was answered and through which door, never its words. Turn it off in the taf's Setup › Results go to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada una indica a quién se respondió y por qué puerta, nunca sus palabras. Desactívalo en el taf, en Configuración › Los resultados van a."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacune indique à qui il a été répondu et par quelle porte, jamais son contenu. Désactivez-la dans Configuration du taf › Les résultats vont vers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ognuno indica a chi è stato risposto e tramite quale porta, mai le sue parole. Disattivalo in Configurazione › I risultati vanno a, nel taf."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke melding vermeldt wie er is beantwoord en via welke deur, nooit de woorden. Zet het uit in Configuratie › Resultaten gaan naar van het taf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy z nich wysyła, komu i przez które drzwi odpowiedziano, nigdy treść. Wyłącz to w tafie: Konfiguracja › Wyniki trafiają do."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada um indica a quem foi respondido e por que porta, nunca as palavras. Desative-o na Configuração do taf › Os resultados vão para."
          }
        }
      }
    },
