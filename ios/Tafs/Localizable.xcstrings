        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건이 이보다 오래 기다리면 알려 드립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jums pranešama, kai atvejis laukia ilgiau."
