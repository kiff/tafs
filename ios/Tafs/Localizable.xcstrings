        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 확인된 %3$@ 코드가 아니라 %2$@ 코드로 %1$@을(를) 페어링했습니다. 내 컴퓨터가 아니라면 여기서 로그아웃하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ຈັບຄູ່ %1$@ ດ້ວຍລະຫັດ %2$@, ບໍ່ແມ່ນ %3$@ ທີ່ກວດ. ຖ້ານັ້ນບໍ່ແມ່ນຄອມພິວເຕີຂອງທ່ານ ໃຫ້ມັນອອກຈາກລະບົບທີ່ນີ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF susiejo %1$@ su kodu %2$@, o ne %3$@, kaip buvo patikrinta. Jei tai ne jūsų kompiuteris, atjunkite jį čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF savienoja pārī %1$@ ar kodu %2$@, nevis %3$@, kā tika pārbaudīts. Ja tas nav tavs dators, izraksti to šeit."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF го спари %1$@ со кодот %2$@, не %3$@ како што беше проверено. Ако тоа не е твојот компјутер, одјави го овде."
