            "value": "KIFF Coach-yň gurallary barada jogap bermedi. Birazdan täzeden synanyşyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF, Coach'un araçları hakkında yanıt vermedi. Biraz sonra tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF نے Coach کے ٹولز کے بارے میں جواب نہیں دیا۔ تھوڑی دیر میں دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF không trả lời về công cụ của Coach. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF 未回覆關於 Coach 工具的詢問。請稍後再試。"
          }
        }
      }
    },
    "coach.unknown_answer": {
