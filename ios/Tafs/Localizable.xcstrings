    "chrome.release_unreadable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن قراءة هذا الملء، لذا لا يمكن السماح به. لا يزال بإمكانك رفضه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu doldurma oxuna bilmir, ona görə icazə verilə bilməz. Yenə də onu rədd edə bilərsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това попълване не може да бъде прочетено, затова не може да се разреши. Все пак можете да го откажете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পূরণটি পড়া যাচ্ছে না, তাই অনুমতি দেওয়া যাবে না। আপনি এখনো এটি প্রত্যাখ্যান করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest emplenament no es pot llegir, així que no es pot permetre. Encara el pots rebutjar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto vyplnění nelze přečíst, proto ho nelze povolit. Stále ho můžete odmítnout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Eingabe ist nicht lesbar und kann daher nicht erlaubt werden. Ablehnen kannst du sie trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This fill can't be read, so it can't be allowed. You can still refuse it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relleno no se puede leer, así que no se puede permitir. Aún puedes rechazarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda täitmist ei saa lugeda, seega ei saa seda lubada. Keelduda saad ikka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce remplissage est illisible, il ne peut donc pas être autorisé. Vous pouvez toujours le refuser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לקרוא את המילוי הזה, ולכן אי אפשר לאשר אותו. עדיין אפשר לסרב לו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भरने का यह अनुरोध पढ़ा नहीं जा सकता, इसलिए इसकी अनुमति नहीं दी जा सकती। आप अब भी इसे अस्वीकार कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo ispunjavanje ne može se pročitati, pa se ne može dopustiti. I dalje ga možete odbiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kitöltés nem olvasható, ezért nem engedélyezhető. Elutasítani továbbra is lehet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս լրացումը հնարավոր չէ կարդալ, ուստի այն հնարավոր չէ թույլատրել։ Դուք դեռ կարող եք մերժել այն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengisian ini tidak bisa dibaca, jadi tidak bisa diizinkan. Anda tetap bisa menolaknya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa compilazione non è leggibile, quindi non può essere consentita. Puoi comunque rifiutarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この入力は読み取れないため、許可できません。拒否はできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ შევსების წაკითხვა შეუძლებელია, ამიტომ მისი დაშვება შეუძლებელია. მისი უარყოფა მაინც შეგიძლიათ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចអានការបំពេញនេះបានទេ ដូច្នេះមិនអាចអនុញ្ញាតបានទេ។ អ្នកនៅតែអាចបដិសេធវាបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 입력을 읽을 수 없어 허용할 수 없습니다. 거부는 계속 할 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ສາມາດອ່ານການຕື່ມນີ້ໄດ້ ຈຶ່ງອະນຸຍາດບໍ່ໄດ້. ທ່ານຍັງປະຕິເສດມັນໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šio įrašymo neįmanoma perskaityti, todėl jo leisti negalima. Vis tiek galite jį atmesti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šo aizpildīšanu nevar nolasīt, tāpēc to nevar atļaut. Jūs joprojām varat to noraidīt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова пополнување не може да се прочита, па не може да се дозволи. Сѐ уште можете да го одбиете."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ бөглөлтийг уншиж чадахгүй тул зөвшөөрөх боломжгүй. Та татгалзаж болно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो भराइ पढ्न सकिँदैन, त्यसैले अनुमति दिन सकिँदैन। तपाईं अझै यसलाई अस्वीकार गर्न सक्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze invulling is niet leesbaar, dus kan ze niet worden toegestaan. Weigeren kan nog altijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego wypełnienia nie da się odczytać, więc nie można na nie zezwolić. Nadal możesz je odrzucić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este preenchimento não pode ser lido, por isso não pode ser permitido. Pode sempre recusá-lo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este preenchimento não pode ser lido, então não pode ser permitido. Você ainda pode recusá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această completare nu poate fi citită, deci nu poate fi permisă. O poți refuza în continuare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto vyplnenie sa nedá prečítať, preto ho nemožno povoliť. Stále ho môžete odmietnuť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te izpolnitve ni mogoče prebrati, zato je ni mogoče dovoliti. Še vedno jo lahko zavrnete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky plotësim nuk mund të lexohet, ndaj nuk mund të lejohet. Mund ta refuzoni gjithsesi."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo popunjavanje ne može da se pročita, pa ne može da se dozvoli. I dalje možete da ga odbijete."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านการกรอกนี้ไม่ได้ จึงอนุญาตไม่ได้ คุณยังปฏิเสธได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu doldurmany okap bolmaýar, şonuň üçin oňa rugsat berip bolmaýar. Ony henizem ret edip bilersiňiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu doldurma okunamıyor, bu yüzden izin verilemez. Yine de reddedebilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بھرنے کی یہ درخواست پڑھی نہیں جا سکتی، اس لیے اس کی اجازت نہیں دی جا سکتی۔ آپ اب بھی اسے مسترد کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được lần điền này nên không thể cho phép. Bạn vẫn có thể từ chối."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取這次填入，因此無法允許。你仍可拒絕。"
