    "taf.remove.cloud_did_not_answer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud hat nicht geantwortet (%2$@). Falls das Entfernen begonnen hat, schließt tafs es bei der nächsten Aktualisierung ab; falls nicht, tippe erneut auf „Entfernen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud didn't answer (%2$@). If it began, tafs finishes it the next time it refreshes; if not, tap Remove again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud no respondió (%2$@). Si empezó, tafs lo termina la próxima vez que se actualice; si no, vuelve a tocar Eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud n'a pas répondu (%2$@). Si la suppression a commencé, tafs la termine à la prochaine actualisation ; sinon, touchez à nouveau Supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud non ha risposto (%2$@). Se la rimozione è iniziata, tafs la completa al prossimo aggiornamento; altrimenti tocca di nuovo Rimuovi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud antwoordde niet (%2$@). Als het verwijderen is begonnen, rondt tafs het af bij de volgende vernieuwing; zo niet, tik dan nogmaals op Verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs cloud nie odpowiedział (%2$@). Jeśli usuwanie się zaczęło, tafs dokończy je przy następnym odświeżeniu; jeśli nie, dotknij ponownie Usuń."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ O tafs cloud não respondeu (%2$@). Se a remoção começou, o tafs conclui-a na próxima atualização; se não, toque novamente em Remover."
          }
        }
      }
    },
