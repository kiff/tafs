    "connect.disconnect.also_card": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم Card الخاصة بـ %1$@ هذه الأدوات أيضًا، لذا تتوقف هي الأخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Card: %1$@ da bu alətlərdən istifadə edir, ona görə o da dayanır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Card на %1$@ също използва тези инструменти, така че и тя спира."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-এর Card-ও এই টুল ব্যবহার করে, তাই সেটিও থামে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Card de %1$@ també fa servir aquestes eines, així que també s'atura."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto nástroje používá i Card tafu %1$@, takže se zastaví také."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ Card nutzt diese Tools auch, also stoppt sie ebenfalls."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ Card also uses these tools, so it stops too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Card de %1$@ también usa estas herramientas, así que también se detiene."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka tafi %1$@ Card kasutab neid tööriistu, seega lõpetab ka see."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Card de %1$@ utilise aussi ces outils : elle s'arrête aussi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Card של %1$@ משתמש גם הוא בכלים האלה, ולכן גם הוא נעצר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ का Card भी इन टूल का उपयोग करता है, इसलिए वह भी रुकता है।"
          }
