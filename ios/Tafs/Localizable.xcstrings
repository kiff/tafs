            "value": "Vrijdag vertrokken, volgens HR"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odszedł w piątek, według HR"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiu na sexta-feira, segundo os RH"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiu na sexta-feira, segundo os RH"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A plecat vineri, conform HR"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odišiel v piatok, podľa HR"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odšel v petek, po kadrovski"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Iku të premten, sipas HR"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Otišao u petak, prema kadrovskoj"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกวันศุกร์ ตามฝ่ายบุคคล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuma günü ayrıldı, İK'ya göre"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghỉ việc thứ Sáu, theo nhân sự"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "週五離職，依人資通知"
          }
        }
      }
    },
    "sample.access.job": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni gələnlərə tətbiqlərini verin və gedənləri getdikləri gün çıxarın. Rollar yalnız təsdiq edilmiş siyahıdan. Deaktiv edin, heç vaxt silməyin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Давайте на новите служители приложенията им и премахвайте тези на напускащите в деня, в който си тръгват. Само роли от одобрения списък. Деактивиране, никога изтриване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dávat nováčkům jejich aplikace a odebírat je odcházejícím v den odchodu. Jen role ze schváleného seznamu. Deaktivovat, nikdy nemazat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib neuen Leuten ihre Apps und entferne Ausscheidende an ihrem letzten Tag. Nur Rollen aus der genehmigten Liste. Deaktivieren, nie löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give new joiners their apps and remove leavers the day they go. Roles from the approved list only. Deactivate, never delete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da a las nuevas incorporaciones sus apps y retira las de quienes se van el día que se marchan. Solo roles de la lista aprobada. Desactivar, nunca eliminar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna uutele töötajatele nende rakendused ja eemalda lahkujad nende lahkumise päeval. Rollid ainult kinnitatud loendist. Deaktiveeri, ära kunagi kustuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donner leurs apps aux nouveaux arrivants et retirer celles des partants le jour de leur départ. Rôles de la liste approuvée uniquement. Désactiver, jamais supprimer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Novim zaposlenicima dajte njihove aplikacije, a odlazećima ih uklonite na dan odlaska. Uloge samo s odobrenog popisa. Deaktivirajte, nikad ne brišite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg az új belépőknek az alkalmazásaikat, és vedd el a távozókét a távozásuk napján. Csak a jóváhagyott listán lévő szerepkörök. Inaktiválás, soha nem törlés."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվեք նորեկներին իրենց հավելվածները և հեռացրեք գնացողներին նրանց գնալու օրը։ Դերեր՝ միայն հաստատված ցանկից։ Անջատեք, երբեք մի ջնջեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri karyawan baru aplikasi mereka dan hapus yang pergi pada hari kepergiannya. Peran hanya dari daftar yang disetujui. Nonaktifkan, jangan pernah hapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai ai nuovi arrivati le loro app e rimuovi chi se ne va il giorno stesso. Solo ruoli dall'elenco approvato. Disattiva, non eliminare mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新入社員にアプリを付与し、退職者は退職日に削除します。役割は承認済みリストからのみ。削除せず、無効化だけを行います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიეცით ახალ თანამშრომლებს თავიანთი აპები და ამოიღეთ წასულები წასვლის დღეს. როლები მხოლოდ დამტკიცებული სიიდან. გააუქმეთ, არასოდეს წაშალოთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 입사자에게 앱을 주고 퇴사자는 퇴사 당일 제거합니다. 역할은 승인된 목록에서만 줍니다. 삭제하지 않고 비활성화만 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suteikti naujokams jų programėles ir pašalinti išeinančius jų išėjimo dieną. Vaidmenys tik iš patvirtinto sąrašo. Išjungti, niekada netrinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dot jaunajiem darbiniekiem viņu lietotnes un noņemt tās aizgājējiem viņu aiziešanas dienā. Lomas tikai no apstiprinātā saraksta. Deaktivizēt, nekad nedzēst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef nieuwe collega's hun apps en verwijder vertrekkers op hun laatste dag. Alleen rollen van de goedgekeurde lijst. Deactiveren, nooit verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawaj nowym osobom ich aplikacje i odbieraj je odchodzącym w dniu odejścia. Tylko role z zatwierdzonej listy. Dezaktywuj, nigdy nie usuwaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar aos novos colaboradores as suas apps e remover quem sai no próprio dia. Só funções da lista aprovada. Desativar, nunca eliminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar aos novos colaboradores os seus apps e remover quem sai no próprio dia. Só funções da lista aprovada. Desativar, nunca excluir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dați noilor angajați aplicațiile lor și eliminați-le pe ale celor care pleacă în ziua plecării. Doar roluri din lista aprobată. Dezactivați, nu ștergeți niciodată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dávať nováčikom ich aplikácie a odoberať ich odchádzajúcim v deň odchodu. Len roly zo schváleného zoznamu. Deaktivovať, nikdy nemazať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Novincem dodeli njihove aplikacije in jih odvzemi tistim, ki odhajajo, na dan odhoda. Samo vloge s potrjenega seznama. Deaktiviraj, nikoli ne briši."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Jepini të porsaardhurve aplikacionet e tyre dhe hiqni ata që largohen ditën që ikin. Role vetëm nga lista e miratuar. Çaktivizoni, kurrë mos fshini."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Novim zaposlenicima dajte njihove aplikacije, a odlazećima ih uklonite na dan odlaska. Uloge samo s odobrenog popisa. Deaktivirajte, nikad ne brišite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มอบแอปให้ผู้เข้าใหม่และถอนสิทธิ์ผู้ลาออกในวันที่พวกเขาจากไป ใช้เฉพาะบทบาทจากรายการที่อนุมัติ ปิดใช้งาน ไม่ลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni gelenlere uygulamalarını ver, ayrılanların uygulamalarını ayrıldıkları gün kaldır. Roller yalnızca onaylı listeden. Devre dışı bırak, asla silme."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấp ứng dụng cho người mới vào và gỡ người nghỉ việc ngay ngày họ đi. Chỉ dùng các vai trò trong danh sách đã duyệt. Vô hiệu hóa, không bao giờ xóa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓新進人員取得所需的 App，並在離職者離開當天移除其權限。角色只能使用核准清單中的項目。只停用，不刪除。"
          }
        }
      }
    },
