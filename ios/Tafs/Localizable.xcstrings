          "stringUnit": {
            "state": "translated",
            "value": "تستطيع tafs لديك استخدام Chrome المقترن فقط على المواقع التي يذكرها الاتصال، وتوافق هنا على الخطوات الخطرة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin tafs-ınız cütləşmiş Chrome-dan yalnız bağlantının sadaladığı saytlarda istifadə edə bilər, riskli addımları isə burada təsdiq edirsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите tafs могат да използват сдвоен Chrome само на сайтовете, които дадена връзка изброява, а рисковите стъпки одобрявате тук."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার taf জোড়া লাগানো Chrome শুধু সেই সাইটগুলোতে ব্যবহার করতে পারে যেগুলো কোনো সংযোগ তালিকাভুক্ত করে, এবং ঝুঁকিপূর্ণ ধাপ আপনি এখানে অনুমোদন করেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus taf només poden utilitzar un Chrome aparellat als llocs que una connexió enumera, i tu aproves aquí els passos arriscats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy mohou spárovaný Chrome používat jen na webech, které uvádí připojení, a riskantní kroky schvalujete zde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs können ein gekoppeltes Chrome nur auf den Websites nutzen, die eine Verbindung nennt, und riskante Schritte bestätigst du hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tafs can use a paired Chrome only on the sites a connection lists, and you approve risky steps here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tafs solo pueden usar un Chrome vinculado en los sitios que indica una conexión, y tú apruebas aquí los pasos arriesgados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tafid saavad seotud Chrome'i kasutada ainult ühenduses loetletud saitidel ja riskantsed sammud kinnitad sina siin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tafs ne peuvent utiliser un Chrome associé que sur les sites qu'une connexion indique, et vous approuvez ici les étapes risquées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-taf שלך יכולים להשתמש ב-Chrome מוצמד רק באתרים שחיבור מפרט, ואתה מאשר כאן צעדים מסוכנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके taf जुड़े हुए Chrome का उपयोग केवल उन साइटों पर कर सकते हैं जो कनेक्शन सूचीबद्ध करता है, और जोखिम वाले कदम आप यहाँ मंज़ूर करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafovi mogu koristiti upareni Chrome samo na stranicama koje navodi veza, a rizične korake odobravate ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafjaid egy párosított Chrome-ot csak a kapcsolatban felsorolt webhelyeken használhatnak, a kockázatos lépéseket pedig itt hagyod jóvá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր tafs-ը կարող է օգտագործել զուգակցված Chrome-ը միայն այն կայքերում, որոնք նշված են կապի մեջ, իսկ վտանգավոր քայլերը դուք հաստատում եք այստեղ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs Anda hanya dapat memakai Chrome yang dipasangkan di situs yang tercantum pada sebuah koneksi, dan Anda menyetujui langkah berisiko di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tafs possono usare un Chrome associato solo sui siti indicati da un collegamento, e i passaggi rischiosi li approvi qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsがペアリング済みのChromeを使えるのは、接続に指定されたサイトだけです。リスクのある操作はここで承認します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენს tafs-ს დაწყვილებული Chrome შეუძლია გამოიყენოს მხოლოდ იმ საიტებზე, რომლებსაც კავშირი ჩამოთვლის, ხოლო სარისკო ნაბიჯებს აქ ამტკიცებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "taf របស់អ្នកអាចប្រើ Chrome ដែលបានផ្គូផ្គង តែនៅលើគេហទំព័រដែលការតភ្ជាប់មួយរាយបញ្ជីប៉ុណ្ណោះ ហើយអ្នកអនុម័តជំហានដែលមានហានិភ័យនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs는 페어링된 Chrome을 연결에 지정된 사이트에서만 사용할 수 있으며, 위험한 단계는 여기서 승인합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "taf ຂອງທ່ານໃຊ້ Chrome ທີ່ຈັບຄູ່ໄດ້ສະເພາະເວັບໄຊທີ່ການເຊື່ອມຕໍ່ລະບຸໄວ້ ແລະ ທ່ານອະນຸມັດຂັ້ນຕອນທີ່ມີຄວາມສ່ຽງຢູ່ບ່ອນນີ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų taf susietą Chrome gali naudoti tik ryšyje nurodytose svetainėse, o rizikingus veiksmus patvirtinate čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavi taf var izmantot savienoto Chrome tikai savienojumā norādītajās vietnēs, un riskantus soļus tu apstiprini šeit."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоите tafови можат да користат спарен Chrome само на сајтовите што ги наведува некоја врска, а ризичните чекори ги одобруваш тука."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны taf-ууд хослуулсан Chrome-ыг зөвхөн холболтын жагсаасан сайтууд дээр ашиглаж чадах бөгөөд эрсдэлтэй алхмуудыг та энд зөвшөөрнө."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंका taf हरूले जोडिएको Chrome जडानले सूचीबद्ध गरेका साइटमा मात्र प्रयोग गर्न सक्छन्, र जोखिमपूर्ण चरणहरू तपाईंले यहीँ स्वीकृत गर्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tafs kunnen een gekoppelde Chrome alleen gebruiken op de sites die een koppeling noemt, en riskante stappen keur je hier goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje tafs mogą używać powiązanego Chrome tylko na stronach, które wskazuje połączenie, a ryzykowne kroki zatwierdzasz tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs só podem usar um Chrome associado nos sites que uma ligação indica, e os passos arriscados são aprovados aqui."
