    "onboarding.control_lead": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يحتاجك taf ينتظر في «بانتظارك»، وعلى ساعتك إن كانت لديك. توافق بـ Face ID أو Touch ID، أو ترفض."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-a sizin lazım olduğunuz zaman, o, «Sizi gözləyir» bölməsində və saatınız varsa, onda gözləyir. Face ID və ya Touch ID ilə təsdiq edirsiniz, ya da rədd edirsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато taf има нужда от вас, той чака в „Чака ви“ и на часовника ви, ако имате такъв. Одобрявате с Face ID или Touch ID, или отказвате."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো taf-এর আপনাকে দরকার হলে সে «আপনার অপেক্ষায়» অপেক্ষা করে, এবং আপনার ঘড়ি থাকলে সেখানেও। আপনি Face ID বা Touch ID দিয়ে অনুমোদন করেন, অথবা প্রত্যাখ্যান করেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan un taf et necessita, espera a «Et necessita», i al teu rellotge si en tens un. Aproves amb Face ID o Touch ID, o rebutges."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když vás taf potřebuje, čeká v Čeká na vás, a na hodinkách, pokud je máte. Schválíte přes Face ID nebo Touch ID, nebo odmítnete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht dich ein taf, wartet er in „Braucht dich“ und, falls du eine hast, auf deiner Uhr. Du genehmigst mit Face ID oder Touch ID oder lehnst ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a taf needs you, it waits in Needs you, and on your watch if you have one. You approve with Face ID or Touch ID, or refuse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un taf te necesita, espera en «Te necesita» y, si tienes uno, en tu reloj. Apruebas con Face ID o Touch ID, o rechazas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui taf vajab sind, ootab see vaates Vajab sind ja kellas, kui sul see on. Kinnitad Face ID või Touch ID abil või keeldud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un taf a besoin de vous, il attend dans « Vous attend » et, si vous en avez une, sur votre montre. Vous approuvez avec Face ID ou Touch ID, ou vous refusez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כש-taf זקוק לך, הוא ממתין ב«זקוק לך», ובשעון שלך אם יש לך. אתה מאשר עם Face ID או Touch ID, או דוחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब किसी taf को आपकी ज़रूरत होती है, वह आपका इंतज़ार में, और आपके पास घड़ी हो तो घड़ी पर, इंतज़ार करता है। आप Face ID या Touch ID से मंज़ूर करते हैं, या अस्वीकार करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad tafu trebate vi, čeka u Čeka vas, a na satu ako ga imate. Odobravate Face ID-jem ili Touch ID-jem ili odbijate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha egy tafnak szüksége van rád, a Rád vár részben vár, és az órádon is, ha van. Face ID-val vagy Touch ID-val hagyod jóvá, vagy elutasítod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երբ taf-ին ձեր օգնությունն է պետք, նա սպասում է «Սպասում է ձեզ» բաժնում և ձեր ժամացույցում, եթե ունեք։ Դուք հաստատում եք Face ID-ով կամ Touch ID-ով, կամ մերժում եք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat sebuah taf membutuhkan Anda, taf menunggu di Menunggu Anda, dan di jam tangan Anda jika ada. Anda menyetujui dengan Face ID atau Touch ID, atau menolak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un taf ha bisogno di te, aspetta in «Ti aspetta» e, se ne hai uno, sull'orologio. Approvi con Face ID o Touch ID, oppure rifiuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafがあなたを必要とすると、要確認で待ちます。Apple Watchがあればそこでも待ちます。Face IDまたはTouch IDで承認するか、拒否してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "როცა taf-ს თქვენი დახმარება სჭირდება, ის ელოდება განყოფილებაში „გელოდებათ“ და თქვენს საათზე, თუ გაქვთ. ამტკიცებთ Face ID-ით ან Touch ID-ით, ან უარს ამბობთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅពេល taf ត្រូវការអ្នក វារង់ចាំក្នុង «ត្រូវការអ្នក» ហើយនៅលើនាឡិការបស់អ្នកប្រសិនបើមាន។ អ្នកអនុម័តដោយ Face ID ឬ Touch ID ឬបដិសេធ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf에 내가 필요하면 확인 필요에서 기다리고, 워치가 있으면 워치에서도 기다립니다. Face ID나 Touch ID로 승인하거나 거절하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເມື່ອ taf ຕ້ອງການທ່ານ ມັນລໍຖ້າໃນ «ຕ້ອງການທ່ານ» ແລະ ໃນໂມງຂອງທ່ານຖ້າມີ. ທ່ານອະນຸມັດດ້ວຍ Face ID ຫຼື Touch ID ຫຼື ປະຕິເສດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai taf jūsų laukia, jis laukia skiltyje „Laukia jūsų“ ir jūsų laikrodyje, jei jį turite. Tvirtinate su Face ID ar Touch ID arba atmetate."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad taf vajag tavu atbildi, tas gaida sadaļā “Gaida tevi” un tavā pulkstenī, ja tev tāds ir. Tu apstiprini ar Face ID vai Touch ID vai atsaki."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кога на некој taf му си потребен, чека во Те чека, и на твојот часовник ако имаш. Одобруваш со Face ID или Touch ID, или одбиваш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf таныг хэрэгтэй үед Таныг хүлээж байна хэсэгт хүлээнэ, танд цаг байвал цаган дээр нь ч гэсэн. Та Face ID эсвэл Touch ID-аар зөвшөөрч, эсвэл татгалзана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कुनै taf लाई तपाईं चाहिँदा यो तपाईंको प्रतीक्षामा पर्खन्छ, र तपाईंसँग घडी भए घडीमा पनि। तपाईं Face ID वा Touch ID ले स्वीकृत गर्नुहुन्छ, वा अस्वीकार गर्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een taf je nodig heeft, wacht hij in ‘Wacht op jou’ en, als je er een hebt, op je horloge. Je keurt goed met Face ID of Touch ID, of weigert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy taf Cię potrzebuje, czeka w „Czeka na Ciebie” i, jeśli go masz, na zegarku. Zatwierdzasz przez Face ID lub Touch ID albo odrzucasz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf precisa de si, espera em «Precisa de si» e, se tiver um, no relógio. Aprova com Face ID ou Touch ID, ou recusa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf precisa de você, espera em «Precisa de você» e, se tiver um, no relógio. Aprova com Face ID ou Touch ID, ou recusa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când un taf are nevoie de dvs., așteaptă în Vă așteaptă și pe ceas, dacă aveți unul. Aprobați cu Face ID sau Touch ID, ori refuzați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď vás taf potrebuje, čaká v Čaká na vás, a na hodinkách, ak ich máte. Schválite cez Face ID alebo Touch ID, alebo odmietnete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko vas taf potrebuje, čaka v Čaka na vas in na vaši uri, če jo imate. Odobrite s Face ID ali Touch ID ali zavrnete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur një taf ka nevojë për ju, pret te Ju pret, dhe në orën tuaj nëse keni një. Miratoni me Face ID ose Touch ID, ose refuzoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad tafu trebate vi, čeka u Čeka vas, a na satu ako ga imate. Odobravate Face ID-jem ili Touch ID-jem ili odbijate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อ taf ต้องการคุณ มันจะรออยู่ในรอคุณอยู่ และบนนาฬิกาของคุณหากมี คุณอนุมัติด้วย Face ID หรือ Touch ID หรือปฏิเสธ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf size zerur bolanda, ol Size garaşýar bölüminde, we sagadyňyz bar bolsa, sagatda garaşýar. Siz Face ID ýa-da Touch ID bilen tassyklaýarsyňyz, ýa-da ret edýärsiňiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir taf'ın size ihtiyacı olduğunda Sizi bekliyor'da, varsa saatinizde bekler. Face ID veya Touch ID ile onaylar ya da reddedersiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کسی taf کو آپ کی ضرورت ہوتی ہے تو وہ آپ کی ضرورت میں انتظار کرتا ہے، اور اگر آپ کے پاس گھڑی ہے تو اس پر بھی۔ آپ Face ID یا Touch ID سے منظور کرتے ہیں، یا مسترد کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một taf cần bạn, nó chờ trong Đang chờ bạn, và trên đồng hồ của bạn nếu có. Bạn phê duyệt bằng Face ID hoặc Touch ID, hoặc từ chối."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 taf 需要您時，它會在「等您處理」中等候，若您有手錶，也會顯示在手錶上。您可用 Face ID 或 Touch ID 核准，或拒絕。"
          }
        }
      }
    },
    "onboarding.control_lead_android": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يحتاجك taf ينتظر في «بانتظارك»، وعلى ساعتك إن كانت لديك. توافق بقفل الشاشة، أو ترفض."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-a sizin lazım olduğunuz zaman, o, «Sizi gözləyir» bölməsində və saatınız varsa, onda gözləyir. Ekran kilidinizlə təsdiq edirsiniz, ya da rədd edirsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато taf има нужда от вас, той чака в „Чака ви“ и на часовника ви, ако имате такъв. Одобрявате със заключването на екрана или отказвате."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো taf-এর আপনাকে দরকার হলে সে «আপনার অপেক্ষায়» অপেক্ষা করে, এবং আপনার ঘড়ি থাকলে সেখানেও। আপনি স্ক্রিন লক দিয়ে অনুমোদন করেন, অথবা প্রত্যাখ্যান করেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan un taf et necessita, espera a «Et necessita», i al teu rellotge si en tens un. Aproves amb el bloqueig de pantalla, o rebutges."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když vás taf potřebuje, čeká v Čeká na vás, a na hodinkách, pokud je máte. Schválíte zámkem obrazovky, nebo odmítnete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht dich ein taf, wartet er in „Braucht dich“ und, falls du eine hast, auf deiner Uhr. Du genehmigst mit deiner Displaysperre oder lehnst ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a taf needs you, it waits in Needs you, and on your watch if you have one. You approve with your screen lock, or refuse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un taf te necesita, espera en «Te necesita» y, si tienes uno, en tu reloj. Apruebas con el bloqueo de pantalla, o rechazas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui taf vajab sind, ootab see vaates Vajab sind ja kellas, kui sul see on. Kinnitad ekraaniluku abil või keeldud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un taf a besoin de vous, il attend dans « Vous attend » et, si vous en avez une, sur votre montre. Vous approuvez avec le verrouillage de l'écran, ou vous refusez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כש-taf זקוק לך, הוא ממתין ב«זקוק לך», ובשעון שלך אם יש לך. אתה מאשר עם נעילת המסך, או דוחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब किसी taf को आपकी ज़रूरत होती है, वह आपका इंतज़ार में, और आपके पास घड़ी हो तो घड़ी पर, इंतज़ार करता है। आप अपने स्क्रीन लॉक से मंज़ूर करते हैं, या अस्वीकार करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad tafu trebate vi, čeka u Čeka vas, a na satu ako ga imate. Odobravate zaključavanjem zaslona ili odbijate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha egy tafnak szüksége van rád, a Rád vár részben vár, és az órádon is, ha van. A képernyőzárral hagyod jóvá, vagy elutasítod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երբ taf-ին ձեր օգնությունն է պետք, նա սպասում է «Սպասում է ձեզ» բաժնում և ձեր ժամացույցում, եթե ունեք։ Դուք հաստատում եք էկրանի կողպմամբ, կամ մերժում եք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat sebuah taf membutuhkan Anda, taf menunggu di Menunggu Anda, dan di jam tangan Anda jika ada. Anda menyetujui dengan kunci layar, atau menolak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un taf ha bisogno di te, aspetta in «Ti aspetta» e, se ne hai uno, sull'orologio. Approvi con il blocco schermo, oppure rifiuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafがあなたを必要とすると、要確認で待ちます。スマートウォッチがあればそこでも待ちます。画面ロックで承認するか、拒否してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "როცა taf-ს თქვენი დახმარება სჭირდება, ის ელოდება განყოფილებაში „გელოდებათ“ და თქვენს საათზე, თუ გაქვთ. ამტკიცებთ ეკრანის ჩაკეტვით, ან უარს ამბობთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅពេល taf ត្រូវការអ្នក វារង់ចាំក្នុង «ត្រូវការអ្នក» ហើយនៅលើនាឡិការបស់អ្នកប្រសិនបើមាន។ អ្នកអនុម័តដោយការចាក់សោអេក្រង់ ឬបដិសេធ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf에 내가 필요하면 확인 필요에서 기다리고, 워치가 있으면 워치에서도 기다립니다. 화면 잠금으로 승인하거나 거절하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເມື່ອ taf ຕ້ອງການທ່ານ ມັນລໍຖ້າໃນ «ຕ້ອງການທ່ານ» ແລະ ໃນໂມງຂອງທ່ານຖ້າມີ. ທ່ານອະນຸມັດດ້ວຍການລັອກໜ້າຈໍ ຫຼື ປະຕິເສດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai taf jūsų laukia, jis laukia skiltyje „Laukia jūsų“ ir jūsų laikrodyje, jei jį turite. Tvirtinate ekrano užraktu arba atmetate."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad taf vajag tavu atbildi, tas gaida sadaļā “Gaida tevi” un tavā pulkstenī, ja tev tāds ir. Tu apstiprini ar ekrāna bloķēšanu vai atsaki."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кога на некој taf му си потребен, чека во Те чека, и на твојот часовник ако имаш. Одобруваш со заклучувањето на екранот, или одбиваш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf таныг хэрэгтэй үед Таныг хүлээж байна хэсэгт хүлээнэ, танд цаг байвал цаган дээр нь ч гэсэн. Та дэлгэцийн түгжээгээрээ зөвшөөрч, эсвэл татгалзана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कुनै taf लाई तपाईं चाहिँदा यो तपाईंको प्रतीक्षामा पर्खन्छ, र तपाईंसँग घडी भए घडीमा पनि। तपाईं स्क्रिन लकले स्वीकृत गर्नुहुन्छ, वा अस्वीकार गर्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een taf je nodig heeft, wacht hij in ‘Wacht op jou’ en, als je er een hebt, op je horloge. Je keurt goed met je schermvergrendeling, of weigert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy taf Cię potrzebuje, czeka w „Czeka na Ciebie” i, jeśli go masz, na zegarku. Zatwierdzasz blokadą ekranu albo odrzucasz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf precisa de si, espera em «Precisa de si» e, se tiver um, no relógio. Aprova com o bloqueio de ecrã, ou recusa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf precisa de você, espera em «Precisa de você» e, se tiver um, no relógio. Aprova com o bloqueio de tela, ou recusa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când un taf are nevoie de dvs., așteaptă în Vă așteaptă și pe ceas, dacă aveți unul. Aprobați cu blocarea ecranului sau refuzați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď vás taf potrebuje, čaká v Čaká na vás, a na hodinkách, ak ich máte. Schválite zámkou obrazovky, alebo odmietnete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko vas taf potrebuje, čaka v Čaka na vas in na vaši uri, če jo imate. Odobrite z zaklepanjem zaslona ali zavrnete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur një taf ka nevojë për ju, pret te Ju pret, dhe në orën tuaj nëse keni një. Miratoni me kyçjen e ekranit, ose refuzoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad tafu trebate vi, čeka u Čeka vas, a na satu ako ga imate. Odobravate zaključavanjem ekrana ili odbijate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อ taf ต้องการคุณ มันจะรออยู่ในรอคุณอยู่ และบนนาฬิกาของคุณหากมี คุณอนุมัติด้วยการล็อกหน้าจอ หรือปฏิเสธ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf size zerur bolanda, ol Size garaşýar bölüminde, we sagadyňyz bar bolsa, sagatda garaşýar. Siz ekran gulpyňyz bilen tassyklaýarsyňyz, ýa-da ret edýärsiňiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir taf'ın size ihtiyacı olduğunda Sizi bekliyor'da, varsa saatinizde bekler. Ekran kilidinizle onaylar ya da reddedersiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کسی taf کو آپ کی ضرورت ہوتی ہے تو وہ آپ کی ضرورت میں انتظار کرتا ہے، اور اگر آپ کے پاس گھڑی ہے تو اس پر بھی۔ آپ اپنے اسکرین لاک سے منظور کرتے ہیں، یا مسترد کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một taf cần bạn, nó chờ trong Đang chờ bạn, và trên đồng hồ của bạn nếu có. Bạn phê duyệt bằng khóa màn hình, hoặc từ chối."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 taf 需要您時，它會在「等您處理」中等候，若您有手錶，也會顯示在手錶上。您可用螢幕鎖定核准，或拒絕。"
          }
        }
      }
    },
