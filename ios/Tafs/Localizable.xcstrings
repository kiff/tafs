    "voice.cannot": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon kann %1$@ nicht direkt auf dem Gerät erkennen, daher funktioniert das Mikrofon hier nicht. Du kannst stattdessen tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can't recognise %1$@ on the phone itself, so the mic doesn't work here. You can type instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no puede reconocer %1$@ en el propio teléfono, así que el micrófono no funciona aquí. Puedes escribir en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone ne peut pas reconnaître le %1$@ sur l'appareil même : le micro ne fonctionne donc pas ici. Vous pouvez écrire à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non sa riconoscere %1$@ sul telefono stesso, quindi il microfono qui non funziona. Puoi scrivere invece."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon kan %1$@ niet op het toestel zelf herkennen, dus de microfoon werkt hier niet. Je kunt in plaats daarvan typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon nie potrafi rozpoznawać mowy w języku %1$@ na samym urządzeniu, więc mikrofon tu nie działa. Możesz zamiast tego pisać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone não consegue reconhecer %1$@ no próprio telefone, por isso o microfone não funciona aqui. Pode escrever em vez disso."
          }
        }
      }
