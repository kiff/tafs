    "usage.limit_ceiling": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit ist so hoch, wie es sich in der App erhöhen lässt. Wende dich an KIFF, um es weiter zu erhöhen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limit is as high as it can be raised from the app. Contact KIFF to raise it further."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite está tan alto como se puede subir desde la app. Contacta con KIFF para subirlo más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite est au plus haut possible depuis l'app. Contactez KIFF pour aller au-delà."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite è già al massimo aumentabile dall'app. Contatta KIFF per aumentarlo ancora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De limiet is zo hoog als hij vanuit de app kan worden verhoogd. Neem contact op met KIFF om hem verder te verhogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit jest już tak wysoki, jak można go podnieść w aplikacji. Skontaktuj się z KIFF, aby go podnieść."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite está no máximo que pode ser aumentado a partir da app. Contacte o KIFF para o aumentar mais."
          }
        }
      }
    },
    "usage.limit_changed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit hat sich inzwischen geändert. So ist es jetzt: Erhöhe es erneut, wenn es noch nötig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limit changed meanwhile. Here it is now: raise it again if it's still needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite cambió mientras tanto. Así está ahora: vuelve a subirlo si aún hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite a changé entre-temps. La voici maintenant : relevez-la à nouveau si c'est encore nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel frattempo il limite è cambiato. Eccolo ora: aumentalo di nuovo se serve ancora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De limiet is intussen gewijzigd. Zo staat hij nu: verhoog hem opnieuw als dat nog nodig is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W międzyczasie limit się zmienił. Oto jego obecna wartość: podnieś go ponownie, jeśli nadal jest to potrzebne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite mudou entretanto. Aqui está agora: aumente-o novamente se ainda for preciso."
