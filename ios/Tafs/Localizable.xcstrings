    "approval.add_face_id_first": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte zuerst Face ID oder einen Fingerabdruck in den Einstellungen ein: Dieses %1$@ genehmigt damit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Face ID or a fingerprint in Settings first: this %1$@ approves with one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade Face ID o una huella en Ajustes: este %1$@ aprueba con ello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord Face ID ou une empreinte dans Réglages : cet %1$@ approuve avec l'un des deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima Face ID o un'impronta in Impostazioni: questo %1$@ approva con uno dei due."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg eerst Face ID of een vingerafdruk toe in Instellingen: deze %1$@ keurt daarmee goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw dodaj Face ID lub odcisk palca w Ustawieniach: ten %1$@ zatwierdza za ich pomocą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione primeiro o Face ID ou uma impressão digital nas Definições: este %1$@ aprova com um deles."
          }
        }
      }
    },
    "approval.adding_face_fingerprint_later_ends": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügst du später ein Gesicht oder einen Fingerabdruck hinzu, endet der Genehmigungsschlüssel dieses Geräts, und du genehmigst dieses Gerät dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding a face or fingerprint later ends this device's approval key, so you approve this device again then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si más adelante añades una cara o una huella, la clave de aprobación de este dispositivo deja de valer, y tendrás que volver a aprobar este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter plus tard un visage ou une empreinte met fin à la clé d'approbation de cet appareil : vous devrez alors approuver à nouveau cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se in seguito aggiungi un volto o un'impronta, la chiave di approvazione di questo dispositivo termina, quindi dovrai approvare di nuovo questo dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg je later een gezicht of vingerafdruk toe, dan vervalt de goedkeuringssleutel van dit apparaat en keur je dit apparaat opnieuw goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodanie później twarzy lub odcisku palca unieważnia klucz zatwierdzania tego urządzenia, więc wtedy zatwierdzisz to urządzenie ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar mais tarde um rosto ou uma impressão digital anula a chave de aprovação deste dispositivo; terá então de aprovar este dispositivo novamente."
          }
        }
      }
    },
