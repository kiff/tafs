    "door.key.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@، لذا لا يستطيع أحد هنا إعطاء %2$@ عملًا. وكل ما يصل يطرق الباب."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ona görə burada heç kim %2$@ taf-ına iş verə bilməz. Gələn hər şey döyür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, така че никой тук не може да дава работа на %2$@. Всичко, което идва, чука."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, তাই এখানে কেউ %2$@-কে কাজ দিতে পারে না। যা আসে সবই কড়া নাড়ে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, així que ningú aquí pot donar feina a %2$@. Tot el que arriba només truca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, takže tady nikdo nemůže %2$@ dávat práci. Všechno, co přijde, jen klepe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, daher kann hier niemand %2$@ Arbeit geben. Alles, was ankommt, klopft an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, so no one here can give %2$@ work. Everything that comes through knocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, así que aquí nadie puede dar trabajo a %2$@. Todo lo que llega es una llamada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, seega ei saa keegi siin tafile %2$@ tööd anda. Kõik, mis tuleb, koputab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : personne ici ne peut donc donner du travail à %2$@. Tout ce qui arrive est une demande d'accès."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ולכן אף אחד כאן לא יכול לתת ל-%2$@ עבודה. כל מה שמגיע דופק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, इसलिए यहाँ कोई %2$@ को काम नहीं दे सकता। जो भी आता है वह दस्तक देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, pa nitko ovdje ne može davati posao tafu %2$@. Sve što stigne kuca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ezért itt senki sem adhat munkát neki (%2$@). Minden, ami beérkezik, kopog."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ուստի այստեղ ոչ ոք չի կարող %2$@-ին աշխատանք տալ։ Ամեն ինչ, ինչ գալիս է, թակում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, jadi tidak ada yang di sini dapat memberi %2$@ pekerjaan. Semua yang masuk hanya mengetuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, quindi nessuno qui può dare lavoro a %2$@. Tutto ciò che arriva è una bussata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。そのため、ここでは誰も%2$@に仕事を頼めません。届いたものはすべてノックになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ამიტომ აქ ვერავინ მისცემს %2$@-ს სამუშაოს. ყველაფერი, რაც მოდის, აკაკუნებს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ដូច្នេះគ្មាននរណានៅទីនេះអាចផ្តល់ការងារឱ្យ %2$@ បានទេ។ អ្វីៗទាំងអស់ដែលមកដល់គ្រាន់តែគោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. 그래서 여기서는 아무도 %2$@에게 작업을 맡길 수 없습니다. 들어오는 것은 모두 노크로 처리됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ສະນັ້ນບໍ່ມີໃຜຢູ່ນີ້ມອບວຽກໃຫ້ %2$@ ໄດ້. ທຸກຢ່າງທີ່ເຂົ້າມາແມ່ນການເຄາະ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, todėl niekas čia negali duoti darbo %2$@. Viskas, kas ateina, tik beldžiasi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, tāpēc neviens šeit nevar dot %2$@ darbu. Viss, kas ienāk, klauvē."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, па никој тука не може да му даде работа на %2$@. Сè што доаѓа само тропа."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, тиймээс энд хэн ч %2$@-д ажил өгч чадахгүй. Ирсэн бүхэн зөвхөн тогшино."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, त्यसैले यहाँ कसैले %2$@ लाई काम दिन सक्दैनन्। आएका सबै ढकढक मात्र हुन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, dus niemand hier kan %2$@ werk geven. Alles wat binnenkomt, klopt aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, więc nikt tutaj nie może zlecać pracy %2$@. Wszystko, co przychodzi, puka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, por isso ninguém aqui pode dar trabalho a %2$@. Tudo o que chega fica como pedido de contacto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, por isso ninguém aqui pode dar trabalho a %2$@. Tudo o que chega fica como pedido de contato."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, așa că nimeni de aici nu îi poate da lui %2$@ de lucru. Tot ce vine bate la ușă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, takže tu nikto nemôže %2$@ dávať prácu. Všetko, čo príde, len klope."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, zato tu nihče ne more dati dela %2$@. Vse, kar pride, samo potrka."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ndaj askush këtu nuk mund t'i japë %2$@ punë. Gjithçka që vjen troket."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, pa nitko ovdje ne može davati posao tafu %2$@. Sve šta stigne kuca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จึงไม่มีใครที่นี่มอบงานให้ %2$@ ได้ ทุกอย่างที่เข้ามาเป็นเพียงการเคาะประตู"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, şonuň üçin bu ýerde hiç kim %2$@-a iş berip bilmeýär. Gelýän hemme zat kakýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, bu yüzden burada kimse %2$@ taf'ına iş veremez. Gelen her şey kapıyı çalar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@، اس لیے یہاں کوئی %2$@ کو کام نہیں دے سکتا۔ جو کچھ آتا ہے وہ دستک ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, nên không ai ở đây giao việc được cho %2$@. Mọi thứ đến đều chỉ là gõ cửa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，因此這裡沒有人能交付工作給 %2$@。所有進來的都只是敲門。"
          }
        }
      }
    },
