            "value": "Փորձեք նորից կամ նորից մուտք գործեք, եթե փոխվել է՝ %1$@։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba lagi, atau masuk lagi jika %1$@ Anda berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova, o accedi di nuovo se il tuo %1$@ è cambiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度試すか、%1$@が変更された場合はもう一度サインインしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სცადეთ ხელახლა ან კვლავ შედით, თუ შეიცვალა: %1$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도하거나, %1$@이(가) 바뀌었다면 다시 로그인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandykite dar kartą arba vėl prisijunkite, jei pasikeitė: %1$@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mēģini vēlreiz vai vēlreiz pieraksties, ja nomainīji %1$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer het opnieuw, of log opnieuw in als je %1$@ is gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie albo zaloguj się ponownie, jeśli Twoje %1$@ się zmieniło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente, ou inicie sessão novamente se o seu %1$@ mudou."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente, ou entre novamente se o seu %1$@ mudou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încercați din nou sau conectați-vă din nou dacă %1$@ s-a schimbat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúste to znova, alebo sa znova prihláste, ak sa %1$@ zmenilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskusite znova ali se znova prijavite, če se je %1$@ spremenilo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Provoni sërish, ose hyni sërish nëse ndryshoi: %1$@."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušajte ponovo ili se ponovo prijavite ako se promenilo: %1$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองอีกครั้ง หรือเข้าสู่ระบบอีกครั้งหาก %1$@ ของคุณเปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar deneyin veya şu değiştiyse tekrar oturum açın: %1$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thử lại, hoặc đăng nhập lại nếu %1$@ của bạn đã đổi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請再試一次；若您的%1$@已變更，請重新登入。"
          }
        }
      }
    },
    "approval.nothing_approved_request_kept_approve": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Heç nə təsdiqlənmədi. Sorğu saxlanılıb: hazır olanda yenidən təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо не беше одобрено. Заявката се запазва: одобрете отново, когато сте готови."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se neschválilo. Žádost zůstává: schvalte znovu, až budete připraveni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts genehmigt. Die Anfrage bleibt erhalten: Genehmige erneut, wenn du so weit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was approved. The request is kept: approve again when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se aprobó nada. La solicitud se conserva: vuelve a aprobar cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi ei kinnitatud. Päring jääb alles: kinnita uuesti, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été approuvé. La demande est conservée : approuvez à nouveau quand vous êtes prêt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije odobreno. Zahtjev je sačuvan: odobrite ponovno kad budete spremni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem lett jóváhagyva. A kérés megmarad: hagyd jóvá újra, ha készen állsz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոչինչ չհաստատվեց։ Հարցումը պահպանվել է․ հաստատեք նորից, երբ պատրաստ լինեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang disetujui. Permintaan tetap disimpan: setujui lagi saat Anda siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato approvato nulla. La richiesta resta: approva di nuovo quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も承認されていません。リクエストは保持されています。準備ができたらもう一度承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არაფერი დამტკიცებულა. მოთხოვნა შენახულია: დაამტკიცეთ ხელახლა, როცა მზად იქნებით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인된 것은 없습니다. 요청은 남아 있으니 준비되면 다시 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas nepatvirtinta. Užklausa išsaugota: patvirtinkite dar kartą, kai būsite pasirengę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas netika apstiprināts. Pieprasījums ir saglabāts: apstiprini vēlreiz, kad esi gatavs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets goedgekeurd. Het verzoek blijft bewaard: keur het goed wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostało zatwierdzone. Prośba zostaje zachowana: zatwierdź ją ponownie, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a aprobat nimic. Solicitarea se păstrează: aprobați din nou când sunteți gata."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič sa neschválilo. Žiadosť zostáva: schváľte znova, keď budete pripravení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič ni bilo odobreno. Zahteva ostane: odobrite znova, ko boste pripravljeni."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Asgjë nuk u miratua. Kërkesa ruhet: miratoni sërish kur të jeni gati."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije odobreno. Zahtev je sačuvan: odobrite ponovo kad budete spremni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรถูกอนุมัติ คำขอยังอยู่: อนุมัติอีกครั้งเมื่อคุณพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey onaylanmadı. İstek korunuyor: hazır olduğunuzda tekrar onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì được phê duyệt. Yêu cầu vẫn được giữ: hãy phê duyệt lại khi bạn sẵn sàng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未核准任何項目。請求仍保留：準備好時再次核准。"
          }
        }
      }
    },
