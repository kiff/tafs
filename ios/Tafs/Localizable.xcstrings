    "needs_you.nothing": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizi gözləyən heç nə yoxdur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо не ви чака."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic na vás nečeká."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts braucht dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing needs you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada te necesita."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Miski ei vaja sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne vous attend."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa ne čeka vas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem vár rád."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոչինչ չի սպասում ձեզ։"
          }
        },
        "id": {
          "stringUnit": {
