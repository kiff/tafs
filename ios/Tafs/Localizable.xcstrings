    "version.install_unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل تثبيت النسخة %1$@: لم يؤكد KIFF الـ Card الخاصة بها. %2$@ لا يعمل الـ taf لديك حتى تُنهيه أو تُلغيه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ versiyasının quraşdırılması tamamlanmadı: KIFF onun Card-ını təsdiqləmədi. %2$@ Siz tamamlayana və ya ləğv edənə qədər taf-ınız işləmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирането на версия %1$@ не завърши: KIFF не потвърди Card ѝ. %2$@ Вашият taf не работи, докато не завършите или откажете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংস্করণ %1$@ ইনস্টল শেষ হয়নি: KIFF এর Card নিশ্চিত করেনি। %2$@ আপনি শেষ বা বাতিল না করা পর্যন্ত আপনার taf চলে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La instal·lació de la versió %1$@ no ha acabat: KIFF no n'ha confirmat el Card. %2$@ El teu taf no s'executa fins que ho acabis o ho cancel·lis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalace verze %1$@ se nedokončila: KIFF nepotvrdil její Card. %2$@ Váš taf neběží, dokud ji nedokončíte nebo nezrušíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation von Version %1$@ wurde nicht abgeschlossen: KIFF hat ihre Card nicht bestätigt. %2$@ Dein taf läuft nicht, bis du sie abschließt oder abbrichst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing version %1$@ didn't finish: KIFF didn't confirm its Card. %2$@ Your taf doesn't run until you finish or cancel it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación de la versión %1$@ no terminó: KIFF no confirmó su Card. %2$@ Tu taf no se ejecuta hasta que la termines o la canceles."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiooni %1$@ paigaldamine jäi pooleli: KIFF ei kinnitanud selle Cardi. %2$@ Sinu taf ei tööta enne, kui selle lõpetad või sellest loobud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installation de la version %1$@ n'a pas abouti : KIFF n'a pas confirmé sa Card. %2$@ Votre taf ne s'exécute pas tant que vous ne la terminez pas ou ne l'annulez pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקנת גרסה %1$@ לא הושלמה: KIFF לא אישר את ה-Card שלה. %2$@ ה-taf שלך לא רץ עד שתסיים או תבטל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण %1$@ का इंस्टॉल पूरा नहीं हुआ: KIFF ने उसके Card की पुष्टि नहीं की। %2$@ जब तक आप इसे पूरा या रद्द नहीं करते, आपका taf नहीं चलता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacija verzije %1$@ nije završena: KIFF nije potvrdio njezin Card. %2$@ Vaš taf ne radi dok je ne dovršite ili otkažete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@. verzió telepítése nem fejeződött be: a KIFF nem erősítette meg a Cardját. %2$@ A tafod nem fut, amíg be nem fejezed vagy meg nem szakítod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տարբերակ %1$@-ի տեղադրումը չավարտվեց․ KIFF-ը չհաստատեց նրա Card-ը։ %2$@ Ձեր taf-ը չի աշխատում, մինչև չավարտեք կամ չեղարկեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemasangan versi %1$@ tidak selesai: KIFF tidak mengonfirmasi Card-nya. %2$@ Taf Anda tidak berjalan sampai Anda menyelesaikan atau membatalkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installazione della versione %1$@ non è stata completata: KIFF non ha confermato la sua Card. %2$@ Il tuo taf non lavora finché non la completi o la annulli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン%1$@のインストールは完了しませんでした：KIFFがCardを確認しませんでした。%2$@ 完了するかキャンセルするまで、tafは動きません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერსია %1$@-ის დაყენება არ დასრულდა: KIFF-მა მისი Card არ დაადასტურა. %2$@ თქვენი taf არ მუშაობს, სანამ არ დაასრულებთ ან არ გააუქმებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការដំឡើងកំណែ %1$@ មិនបានបញ្ចប់ទេ៖ KIFF មិនបានបញ្ជាក់ Card របស់វាទេ។ %2$@ taf របស់អ្នកមិនដំណើរការទេ រហូតដល់អ្នកបញ្ចប់ ឬបោះបង់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 %1$@ 설치가 끝나지 않았습니다: KIFF가 Card를 확인하지 않았습니다. %2$@ 마치거나 취소할 때까지 taf는 실행되지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການຕິດຕັ້ງເວີຊັນ %1$@ ບໍ່ສຳເລັດ: KIFF ບໍ່ໄດ້ຢືນຢັນ Card ຂອງມັນ. %2$@ taf ຂອງທ່ານບໍ່ເຮັດວຽກຈົນກວ່າທ່ານຈະສຳເລັດ ຫຼື ຍົກເລີກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ versijos diegimas nebaigtas: KIFF nepatvirtino jos Card. %2$@ Jūsų taf neveikia, kol jo neužbaigsite ar neatšauksite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Versijas %1$@ instalēšana netika pabeigta: KIFF neapstiprināja tās Card. %2$@ Tavs taf nedarbojas, līdz tu to pabeigsi vai atcelsi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирањето на верзијата %1$@ не заврши: KIFF не го потврди нејзиниот Card. %2$@ Твојот taf не работи додека не завршиш или не откажеш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-р хувилбарыг суулгаж дуусгасангүй: KIFF түүний Card-ыг баталгаажуулсангүй. %2$@ Дуусгах эсвэл цуцлах хүртэл таны taf ажиллахгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण %1$@ को स्थापना सकिएन: KIFF ले यसको Card पुष्टि गरेन। %2$@ तपाईंले सक्नुअघि वा रद्द नगरेसम्म तपाईंको taf चल्दैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het installeren van versie %1$@ is niet afgerond: KIFF heeft de Card niet bevestigd. %2$@ Je taf draait niet tot je het afrondt of annuleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacja wersji %1$@ nie została ukończona: KIFF nie potwierdził jej Card. %2$@ Twój taf nie działa, dopóki jej nie dokończysz albo nie anulujesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação da versão %1$@ não foi concluída: o KIFF não confirmou o seu Card. %2$@ O seu taf não é executado até a concluir ou cancelar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação da versão %1$@ não foi concluída: o KIFF não confirmou o seu Card. %2$@ O seu taf não é executado até a concluir ou cancelar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalarea versiunii %1$@ nu s-a finalizat: KIFF nu i-a confirmat Cardul. %2$@ Taful nu rulează până nu finalizați sau anulați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Inštalácia verzie %1$@ sa nedokončila: KIFF nepotvrdil jej Card. %2$@ Váš taf nebeží, kým ju nedokončíte alebo nezrušíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namestitev različice %1$@ se ni dokončala: KIFF ni potrdil njene Card. %2$@ Vaš taf ne teče, dokler je ne dokončate ali prekličete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalimi i versionit %1$@ nuk përfundoi: KIFF nuk e konfirmoi Card-in e tij. %2$@ Taf-i juaj nuk ekzekutohet derisa ta përfundoni ose ta anuloni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacija verzije %1$@ nije završena: KIFF nije potvrdio njen Card. %2$@ Vaš taf ne radi dok je ne dovršite ili otkažete."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การติดตั้งเวอร์ชัน %1$@ ไม่เสร็จสิ้น: KIFF ไม่ได้ยืนยัน Card ของมัน %2$@ taf ของคุณจะไม่ทำงานจนกว่าคุณจะทำให้เสร็จหรือยกเลิก"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wersiýany gurmak gutarmady: KIFF onuň Card-yny tassyklamady. %2$@ Siz gutarýançaňyz ýa-da ýatyrýançaňyz taf-yňyz işlemeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. sürümün kurulumu tamamlanmadı: KIFF Card'ını onaylamadı. %2$@ Siz bitirene veya iptal edene kadar taf'ınız çalışmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ورژن %1$@ کی انسٹالیشن مکمل نہیں ہوئی: KIFF نے اس کے Card کی تصدیق نہیں کی۔ %2$@ جب تک آپ اسے مکمل یا منسوخ نہ کریں آپ کا taf نہیں چلتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc cài phiên bản %1$@ chưa hoàn tất: KIFF chưa xác nhận Card của nó. %2$@ Taf của bạn không chạy cho đến khi bạn hoàn tất hoặc hủy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝版本 %1$@ 未完成：KIFF 未確認它的 Card。%2$@ 在您完成或取消之前，您的 taf 不會執行。"
          }
        }
      }
