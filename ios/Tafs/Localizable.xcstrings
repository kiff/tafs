    "export.not_offered": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ الملفات على هذا الهاتف. حرّر بعض المساحة ثم حاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayllar bu telefonda saxlanıla bilmədi. Bir az yer boşaldın, sonra yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файловете не можаха да се запазят на този телефон. Освободете място и опитайте отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনে ফাইলগুলো সংরক্ষণ করা যায়নি। কিছু জায়গা খালি করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'han pogut desar els fitxers en aquest telèfon. Allibera una mica d'espai i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory nešlo v tomto telefonu uložit. Uvolněte místo a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien konnten auf diesem Telefon nicht gespeichert werden. Schaffe etwas Platz und versuch es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files couldn't be saved on this phone. Free up some space, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los archivos en este teléfono. Libera espacio y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Faile ei õnnestunud selles telefonis salvestada. Vabasta ruumi ja proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers n'ont pas pu être enregistrés sur ce téléphone. Libérez de l'espace, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לשמור את הקבצים בטלפון הזה. יש לפנות קצת מקום ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें इस फ़ोन में सहेजी नहीं जा सकीं। थोड़ी जगह खाली करें, फिर दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke nije bilo moguće spremiti na ovaj telefon. Oslobodite malo prostora pa pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlokat nem sikerült menteni erre a telefonra. Szabadíts fel helyet, majd próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլերը չկարողացան պահվել այս հեռախոսում։ Ազատեք տեղ, ապա նորից փորձեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tidak dapat disimpan di ponsel ini. Kosongkan sedikit ruang, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare i file su questo telefono. Libera un po' di spazio, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンにファイルを保存できませんでした。空き容量を増やしてから、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფაილები ამ ტელეფონზე ვერ შეინახა. გაათავისუფლეთ ადგილი და სცადეთ ხელახლა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចរក្សាទុកឯកសារនៅលើទូរសព្ទនេះបានទេ។ សូមសម្អាតទំហំទំនេរខ្លះ រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에 파일을 저장할 수 없습니다. 공간을 확보한 후 다시 시도하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
