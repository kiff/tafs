    "sample.brief.expires.cant_wait": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, gözləyə bilməz: vaxtı 12:00-da bitir, növbəti xülasədən əvvəl."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това не може да чака: изтича в 12:00, преди следващото резюме."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle nepočká: vyprší ve 12:00, před dalším přehledem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann nicht warten: Die Frist endet um 12:00, vor dem nächsten Briefing."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't wait: it expires at 12:00, before the next brief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no puede esperar: el plazo vence a las 12:00, antes del próximo resumen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ei saa oodata: see aegub kell 12:00, enne järgmist kokkuvõtet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça ne peut pas attendre : le délai expire à 12:00, avant le prochain briefing."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo ne može čekati: ističe u 12:00, prije sljedećeg sažetka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem várhat: 12:00-kor lejár, a következő összefoglaló előtt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա չի կարող սպասել․ ժամկետը լրանում է 12:00-ին, հաջորդ ամփոփումից առաջ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak bisa menunggu: berakhir pukul 12:00, sebelum ringkasan berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non può aspettare: il termine scade alle 12:00, prima del prossimo riepilogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待てません：次のブリーフィングの前、12:00に期限切れになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ვერ დაელოდება: ვადა ეწურება 12:00-ზე, შემდეგ მიმოხილვამდე."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기다릴 수 없습니다. 다음 브리핑 전인 12:00에 만료됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai negali laukti: nebegalios 12:00, prieš kitą suvestinę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas nevar gaidīt: derīgs līdz 12:00, pirms nākamā kopsavilkuma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet wachten: de termijn sluit om 12:00, voor het volgende overzicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie może czekać: termin mija o 12:00, przed następnym przeglądem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não pode esperar: o prazo fecha às 12:00, antes do próximo resumo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não pode esperar: o prazo fecha às 12:00, antes do próximo resumo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu poate aștepta: expiră la 12:00, înainte de următorul rezumat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nepočká: vyprší o 12:00, pred ďalším prehľadom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ne more čakati: poteče ob 12:00, pred naslednjim pregledom."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo nuk pret: skadon në 12:00, para përmbledhjes së radhës."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo ne može čekati: ističe u 12:00, pre sledećeg sažetka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรื่องนี้รอไม่ได้: จะหมดอายุเวลา 12:00 ก่อนสรุปครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bekleyemez: saat 12:00'de, bir sonraki özetten önce sona eriyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này không thể chờ: nó hết hạn lúc 12:00, trước bản tóm tắt tiếp theo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這件事不能等：它在 12:00 到期，早於下一次摘要。"
          }
        }
      }
    },
