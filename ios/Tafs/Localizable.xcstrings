    "door.key.foot": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. تُحتسب الرسالة منهم فقط عندما يتحقق ذلك؛ وأي شخص آخر يطرق الباب."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Mesaj yalnız bu şərt ödənəndə onlarınkı sayılır; başqası döyür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Съобщение се счита за тяхно само когато това е вярно; всеки друг чука."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@। বার্তা শুধু তখনই তাদের বলে গণ্য হয় যখন এটি ঠিক থাকে; আর কেউ কড়া নাড়ে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un missatge només compta com a seu quan això es compleix; la resta de gent només truca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Zpráva se počítá za jejich, jen když to platí; kdokoli jiný jen klepe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Eine Nachricht gilt nur dann als ihre, wenn das zutrifft; alle anderen klopfen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. A message counts as theirs only when that holds; anyone else knocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un mensaje cuenta como suyo solo cuando eso se cumple; los de cualquier otra persona llegan como llamada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Sõnum loetakse nende omaks ainult siis, kui see kehtib; kõik teised koputavad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un message n'est considéré comme le sien que si c'est le cas ; toute autre personne fait une demande d'accès."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. הודעה נחשבת שלהם רק כשזה מתקיים; כל אחד אחר דופק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@। संदेश तभी उनका माना जाता है जब यह हो; बाकी सब दस्तक देते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Poruka se računa kao njihova samo kad to vrijedi; svi ostali kucaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Egy üzenet csak akkor számít az övének, ha ez teljesül; bárki más csak kopog."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@։ Հաղորդագրությունը նրանցինն է համարվում միայն երբ դա ճիշտ է․ մնացածը թակում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Sebuah pesan dihitung sebagai milik mereka hanya saat itu berlaku; selain itu mengetuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un messaggio conta come suo solo se questo è vero; per chiunque altro è una bussata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。それが確認できたときだけ、その人のメッセージとして扱われます。それ以外の人はノックになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. შეტყობინება მათად ითვლება მხოლოდ მაშინ, როცა ეს მართალია; დანარჩენი აკაკუნებს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@។ សារត្រូវបានរាប់ជារបស់ពួកគេ តែនៅពេលនោះពិត; អ្នកផ្សេងទៀតគ្រាន់តែគោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. 이것이 확인될 때만 그 사람의 메시지로 봅니다. 그 밖의 사람은 노크만 합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. ຂໍ້ຄວາມນັບວ່າເປັນຂອງເຂົາເຈົ້າເມື່ອສິ່ງນັ້ນເປັນຈິງເທົ່ານັ້ນ; ຄົນອື່ນເຄາະ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Žinutė laikoma jų tik tada, kai tai patvirtinama; visi kiti tik beldžiasi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Ziņa tiek uzskatīta par viņu ziņu tikai tad, ja tas izpildās; visi pārējie klauvē."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Пораката се брои како нивна само кога тоа важи; секој друг само тропа."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Үүнд таарсан тохиолдолд л мессеж тэдний гэж тооцогдоно; бусад нь зөвхөн тогшино."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@। यो लागू हुँदा मात्र सन्देश उनीहरूको मानिन्छ; अरू जोसुकैले ढकढक मात्र गर्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Een bericht telt alleen als het hunne als dat zo is; ieder ander klopt aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Wiadomość liczy się jako ich tylko wtedy, gdy to się zgadza; każdy inny puka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Uma mensagem só conta como dessa pessoa quando isso se verifica; qualquer outra pessoa faz um pedido de contacto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Uma mensagem só conta como dessa pessoa quando isso se verifica; qualquer outra pessoa faz um pedido de contato."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un mesaj contează ca al lor doar când asta e adevărat; oricine altcineva bate la ușă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Správa sa počíta za ich, len keď to platí; ktokoľvek iný len klope."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Sporočilo šteje za njihovo samo, ko to drži; vsi drugi samo potrkajo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Një mesazh numërohet si i tyre vetëm kur kjo vlen; çdo tjetër troket."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Poruka se naloga kao njihova samo kad to važi; svi ostali kucaju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ข้อความจะนับว่าเป็นของพวกเขาก็ต่อเมื่อเงื่อนไขนั้นเป็นจริง นอกนั้นเป็นเพียงการเคาะประตู"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Habar diňe şeýle bolanda olaryňky hasaplanýar; galan adamlar kakýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Bir mesaj yalnızca bu geçerliyse onlardan sayılır; başka herkes kapıyı çalar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@۔ پیغام صرف تب ان کا شمار ہوتا ہے جب یہ ثابت ہو؛ باقی سب دستک دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Một tin nhắn chỉ được tính là của họ khi điều đó đúng; còn lại chỉ là gõ cửa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。只有在這個條件成立時，訊息才算是他們的；其他人只是敲門。"
          }
        }
      }
    },
    "door.key.no_one_paired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد مقترن هنا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada heç kim cütləşməyib"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тук няма сдвоени"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে কেউ জোড়া লাগানো নেই"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningú no està aparellat aquí"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tady není nikdo spárovaný"
          }
        },
        "de": {
