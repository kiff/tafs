    "approval.add_face_id_first": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlcə Parametrlərdə Face ID və ya barmaq izi əlavə edin: bu cihaz (%1$@) onlardan biri ilə təsdiq edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Първо добавете Face ID или пръстов отпечатък в Настройки: този %1$@ одобрява с някое от тях."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív v Nastavení přidejte Face ID nebo otisk prstu: tento %1$@ jím schvaluje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte zuerst Face ID oder einen Fingerabdruck in den Einstellungen ein: Dieses %1$@ genehmigt damit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Face ID or a fingerprint in Settings first: this %1$@ approves with one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade Face ID o una huella en Ajustes: este %1$@ aprueba con ello."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa esmalt seadetes Face ID või sõrmejälg: see %1$@ kinnitab sellega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord Face ID ou une empreinte dans Réglages : %2$@ approuve avec l'un des deux."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije dodajte Face ID ili otisak prsta u Postavkama: ovaj %1$@ odobrava jednim od njih."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb adj hozzá Face ID-t vagy ujjlenyomatot a Beállításokban: ez az eszköz (%1$@) azzal hagy jóvá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախ Կարգավորումներում ավելացրեք Face ID կամ մատնահետք․ այս սարքը (%1$@) հաստատում է դրանցից մեկով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan Face ID atau sidik jari di Pengaturan terlebih dahulu: %1$@ ini menyetujui dengan salah satunya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima Face ID o un'impronta in Impostazioni: questo %1$@ approva con uno dei due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に設定でFace IDまたは指紋を追加してください。この%1$@はそれで承認します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ პარამეტრებში დაამატეთ Face ID ან თითის ანაბეჭდი: ეს მოწყობილობა (%1$@) მათგან ერთ-ერთით ამტკიცებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 설정에서 Face ID나 지문을 추가하세요. 이 %1$@에서는 그것으로 승인합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmiausia nustatymuose pridėkite Face ID arba piršto atspaudą: šis įrenginys (%1$@) tvirtina juo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vispirms iestatījumos pievieno Face ID vai pirksta nospiedumu: šis %1$@ apstiprina ar to."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg eerst Face ID of een vingerafdruk toe in Instellingen: deze %1$@ keurt daarmee goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw dodaj Face ID lub odcisk palca w Ustawieniach: ten %1$@ zatwierdza za ich pomocą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione primeiro o Face ID ou uma impressão digital nas Definições: este %1$@ aprova com um deles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione primeiro o Face ID ou uma impressão digital nas Configurações: este %1$@ aprova com um deles."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai întâi adăugați Face ID sau o amprentă în Configurări: acest dispozitiv (%1$@) aprobă cu una dintre ele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv v Nastaveniach pridajte Face ID alebo odtlačok prsta: tento %1$@ ním schvaľuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej v Nastavitvah dodajte Face ID ali prstni odtis: ta %1$@ z njim odobrava."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Së pari shtoni Face ID ose një gjurmë gishti te Cilësimet: kjo pajisje (%1$@) miraton me njërën prej tyre."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo dodajte Face ID ili otisak prsta u Podešavanjima: ovaj uređaj (%1$@) odobrava jednim od njih."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม Face ID หรือลายนิ้วมือในการตั้งค่าก่อน: %1$@เครื่องนี้อนุมัติด้วยวิธีใดวิธีหนึ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Ayarlar'dan Face ID veya parmak izi ekleyin: bu %1$@ onayı ikisinden biriyle verir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm Face ID hoặc vân tay trong Cài đặt trước: %1$@ này phê duyệt bằng một trong hai."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在「設定」中新增 Face ID 或指紋：這部%1$@需要透過其中一種方式核准。"
          }
        }
      }
    },
    "approval.adding_face_fingerprint_later_ends": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Üz və ya barmaq izini sonradan əlavə etmək bu cihazın təsdiq açarını ləğv edir, ona görə o zaman bu cihazı yenidən təsdiq edəcəksiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако по-късно добавите лице или пръстов отпечатък, ключът за одобрение на това устройство се прекратява и тогава одобрявате устройството отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud později přidáte obličej nebo otisk prstu, schvalovací klíč tohoto zařízení skončí a zařízení pak schválíte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügst du später ein Gesicht oder einen Fingerabdruck hinzu, endet der Genehmigungsschlüssel dieses Geräts, und du genehmigst dieses Gerät dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding a face or fingerprint later ends this device's approval key, so you approve this device again then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si más adelante añades una cara o una huella, la clave de aprobación de este dispositivo deja de valer, y tendrás que volver a aprobar este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui lisad hiljem näo või sõrmejälje, lõpeb selle seadme kinnitusvõti ja pead selle seadme siis uuesti kinnitama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter plus tard un visage ou une empreinte met fin à la clé d'approbation de cet appareil : vous devrez alors approuver à nouveau cet appareil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako kasnije dodate lice ili otisak prsta, ključ za odobravanje ovog uređaja prestaje vrijediti pa ćete tada ponovno odobriti ovaj uređaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha később arcot vagy ujjlenyomatot adsz hozzá, az megszünteti ennek az eszköznek a jóváhagyási kulcsát, így akkor újra jóvá kell hagynod ezt az eszközt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դեմքի կամ մատնահետքի ավելի ուշ ավելացումը չեղարկում է այս սարքի հաստատման բանալին, ուստի այդ ժամանակ այս սարքը նորից կհաստատեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan wajah atau sidik jari nanti akan mengakhiri kunci persetujuan perangkat ini, sehingga Anda menyetujui perangkat ini lagi saat itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se in seguito aggiungi un volto o un'impronta, la chiave di approvazione di questo dispositivo termina, quindi dovrai approvare di nuovo questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で顔や指紋を追加すると、このデバイスの承認キーが無効になるため、その時にこのデバイスをもう一度承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სახის ან თითის ანაბეჭდის მოგვიანებით დამატება ამ მოწყობილობის დამტკიცების გასაღებს აუქმებს, ამიტომ მაშინ ამ მოწყობილობას ხელახლა დაამტკიცებთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 얼굴이나 지문을 추가하면 이 기기의 승인 키가 종료되므로, 그때 이 기기를 다시 승인해야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vėliau pridėjus veidą ar piršto atspaudą, šio įrenginio patvirtinimo raktas nustoja galioti, todėl tada šį įrenginį turėsite patvirtinti dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja vēlāk pievienosi seju vai pirksta nospiedumu, šīs ierīces apstiprināšanas atslēga beigsies, un tev šī ierīce būs jāapstiprina vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg je later een gezicht of vingerafdruk toe, dan vervalt de goedkeuringssleutel van dit apparaat en keur je dit apparaat opnieuw goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodanie później twarzy lub odcisku palca unieważnia klucz zatwierdzania tego urządzenia, więc wtedy zatwierdzisz to urządzenie ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar mais tarde um rosto ou uma impressão digital anula a chave de aprovação deste dispositivo; terá então de aprovar este dispositivo novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar mais tarde um rosto ou uma impressão digital anula a chave de aprovação deste dispositivo; terá então de aprovar este dispositivo novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă adăugați mai târziu o față sau o amprentă, cheia de aprobare a acestui dispozitiv se încheie, așa că atunci aprobați din nou acest dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak neskôr pridáte tvár alebo odtlačok prsta, schvaľovací kľúč tohto zariadenia skončí a zariadenie potom schválite znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če pozneje dodate obraz ali prstni odtis, se ključ za odobritev te naprave konča, zato boste to napravo nato znova odobrili."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shtimi i një fytyre ose gjurme gishti më vonë e mbyll çelësin e miratimit të kësaj pajisjeje, ndaj atëherë e miratoni sërish këtë pajisje."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodavanje lica ili otiska prsta kasnije poništava ključ za odobravanje ovog uređaja, pa ćete tada ponovo odobriti ovaj uređaj."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเพิ่มใบหน้าหรือลายนิ้วมือภายหลังจะทำให้กุญแจอนุมัติของอุปกรณ์นี้สิ้นสุด คุณจึงต้องอนุมัติอุปกรณ์นี้อีกครั้งในตอนนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha sonra yüz veya parmak izi eklemek bu cihazın onay anahtarını sonlandırır, bu yüzden o zaman bu cihazı tekrar onaylarsınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm khuôn mặt hoặc vân tay sau này sẽ kết thúc khóa phê duyệt của thiết bị này, nên khi đó bạn phê duyệt lại thiết bị này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後新增臉部或指紋會使這部裝置的核准金鑰失效，屆時您需要重新核准這部裝置。"
          }
        }
      }
    },
