    "watch.sign_in_on_phone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى tafs على هاتفك أولًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlcə telefonunuzda tafs-a daxil olun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Първо влезте в tafs на телефона си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে আপনার ফোনে tafs-এ সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer inicia la sessió a tafs al telèfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív se v telefonu přihlaste do tafs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich zuerst auf deinem Handy bei tafs an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to tafs on your phone first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero inicia sesión en tafs en tu teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Logi kõigepealt telefonis tafsi sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous d'abord à tafs sur votre téléphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קודם יש להיכנס ל-tafs בטלפון שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले अपने फ़ोन पर tafs में साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije se prijavite u tafs na telefonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb jelentkezz be a tafsbe a telefonodon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախ մուտք գործեք tafs ձեր հեռախոսում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke tafs di ponsel Anda terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima accedi a tafs sul telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にスマートフォンでtafsにサインインしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ შედით tafs-ში თქვენს ტელეფონზე."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចូលទៅ tafs នៅលើទូរសព្ទរបស់អ្នកជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 휴대폰에서 tafs에 로그인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຂົ້າສູ່ລະບົບ tafs ໃນໂທລະສັບຂອງທ່ານກ່ອນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmiausia prisijunkite prie tafs telefone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vispirms pieraksties tafs savā tālrunī."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прво најави се во tafs на твојот телефон."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Эхлээд утсан дээрээ tafs-д нэвтэрнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिले आफ्नो फोनमा tafs मा साइन इन गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log eerst in bij tafs op je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zaloguj się do tafs na telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, inicie sessão no tafs no telemóvel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, entre no tafs no celular."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai întâi conectați-vă la tafs pe telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv sa v telefóne prihláste do tafs."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej se v telefonu prijavite v tafs."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Së pari hyni në tafs në telefonin tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo se prijavite u tafs na telefonu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบ tafs บนโทรศัพท์ของคุณก่อน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilki telefonyňyzda tafs-a giriň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce telefonunuzda tafs'ta oturum açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے اپنے فون پر tafs میں سائن اِن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng nhập tafs trên điện thoại của bạn trước."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
