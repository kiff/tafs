        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs hat KIFF zum Ablehnen nicht erreicht. Öffne tafs, um zu antworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs couldn't reach KIFF to refuse it. Open tafs to answer it."
          }
        },
