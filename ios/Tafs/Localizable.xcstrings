        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កញ្ចប់យឺតមិនបានដំណើរការម៉ោង 07:00៖ ការចូលក្រុមហ៊ុនដឹកជញ្ជូនរបស់វាត្រូវការអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배송 지연이 07:00에 실행되지 않았습니다. 택배사 로그인에 내 확인이 필요합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
