          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestis ei jõudnud telefoni. Proovi uuesti või kirjuta hoopis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
