        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi lido antes de o trabalho terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi lido antes de o trabalho terminar."
          }
