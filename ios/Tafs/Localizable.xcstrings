    "version.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Version installierst, wird sie zur Live-Version, ob neuer oder älter. Eine Bestätigung genügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing a version makes it the live version, forward or back. One confirmation covers it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar una versión la convierte en la versión activa, hacia delante o hacia atrás. Una sola confirmación basta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer une version la met en service, plus récente ou plus ancienne. Une seule confirmation suffit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installare una versione la rende la versione attiva, in avanti o indietro. Basta una conferma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een versie installeren maakt er de live versie van, vooruit of terug. Eén bevestiging is genoeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacja wersji czyni ją wersją działającą na żywo, nowszą lub starszą. Wystarczy jedno potwierdzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar uma versão torna-a a versão em produção, para a frente ou para trás. Uma confirmação basta."
          }
        }
      }
    },
