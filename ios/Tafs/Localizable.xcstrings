        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas savaitę rašantys klientai gauna atsakymą tą patį rytą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klienti, kas raksta katru nedēļu, saņem atbildi tajā pašā rītā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
