            "value": "tafs trabaja en su propio perfil de Chrome. Inicia sesión ahí solo en los sitios que quieras que usen tus tafs."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs töötab oma Chrome'i profiilis. Logi seal sisse ainult saitidele, mida tahad, et su tafid kasutaksid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs travaille dans son propre profil Chrome. Connectez-vous-y uniquement aux sites que vos tafs doivent utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs lavora in un proprio profilo di Chrome. Lì accedi solo ai siti che vuoi far usare ai tuoi tafs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsは専用のChromeプロファイルで動作します。そこでは、tafsに使わせたいサイトだけにサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs는 자체 Chrome 프로필에서 작동합니다. 그곳에서는 tafs가 사용할 사이트에만 로그인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs veikia savo Chrome profilyje. Ten prisijunkite tik prie svetainių, kurias norite, kad naudotų jūsų taf."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs strādā savā Chrome profilā. Piesakies tur tikai vietnēs, kuras vēlies, lai tavi taf izmanto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs werkt in een eigen Chrome-profiel. Log daar alleen in bij de sites die je tafs mogen gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs działa we własnym profilu Chrome. Loguj się tam tylko na strony, z których mają korzystać Twoje tafs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs trabalha no seu próprio perfil do Chrome. Inicie sessão aí apenas nos sites que quer que os seus tafs usem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs trabalha em seu próprio perfil do Chrome. Faça login lá apenas nos sites que você quer que seus tafs usem."
          }
        }
      }
    },
    "chrome.refused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Chrome hat diesen Code benutzt, also wurde nichts gekoppelt. Fang noch einmal an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another Chrome used this code, so nothing was paired. Start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro Chrome usó este código, así que no se vinculó nada. Empieza de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda koodi kasutas teine Chrome, seega midagi ei seotud. Alusta uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre Chrome a utilisé ce code, rien n'a donc été associé. Recommencez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro Chrome ha usato questo codice, quindi non è stato associato nulla. Ricomincia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のChromeがこのコードを使ったため、何もペアリングされませんでした。もう一度やり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Chrome이 이 코드를 사용해 아무것도 페어링되지 않았습니다. 다시 시작하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šį kodą panaudojo kita Chrome naršyklė, todėl niekas nesusieta. Pradėkite iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šo kodu izmantoja cits Chrome, tāpēc nekas netika savienots pārī. Sāc no jauna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere Chrome gebruikte deze code, dus er is niets gekoppeld. Begin opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny Chrome użył tego kodu, więc nic nie zostało powiązane. Zacznij od nowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro Chrome usou este código, por isso nada foi associado. Comece de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro Chrome usou este código, por isso nada foi associado. Comece de novo."
          }
        }
      }
    },
