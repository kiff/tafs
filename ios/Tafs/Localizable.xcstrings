    "needs_you.over_total": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es liegt über einer Summe der Card, etwa einer Tagessumme. Jemand, der die Cards verwaltet, kann ihm Zusatzspielraum geben, oder du lehnst es ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's over a Card total, such as a day's. Someone who manages the Cards can give it extra room, or you can refuse it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera un total de la Card, como el de un día. Alguien que gestione las Cards puede darle margen extra, o puedes rechazarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ületab Cardi kogusumma, näiteks päevase. Cardide haldaja saab sellele lisaruumi anda või võid sa sellest keelduda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela dépasse un total de la Card, par exemple sur une journée. Une personne qui gère les Cards peut lui donner une marge supplémentaire, ou vous pouvez le refuser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera un totale della Card, come quello di un giorno. Chi gestisce le Card può darle un margine extra, oppure puoi rifiutarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日の合計など、Cardの合計を超えています。Cardを管理する人が枠を追加するか、あなたが拒否できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 한도 같은 Card 합계를 넘었습니다. Card를 관리하는 사람이 추가로 허용하거나, 내가 거절할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Viršijama Card bendra suma, pvz., dienos. Kas tvarko Card, gali suteikti papildomą rezervą, arba galite ją atmesti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas pārsniedz Card kopsummu, piemēram, dienas. Kāds, kas pārvalda Card, var tam dot papildu rezervi, vai arī tu vari to atteikt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gaat boven een totaal van de Card, zoals dat van een dag. Iemand die de Cards beheert, kan het extra ruimte geven, of je kunt het weigeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekracza sumę Card, np. dzienną. Osoba zarządzająca Card może dać dodatkowy zapas albo możesz to odrzucić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excede um total do Card, como o de um dia. Alguém que gere os Cards pode dar-lhe margem extra, ou pode recusar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa de um total do Card, como o de um dia. Alguém que gerencia os Cards pode dar margem extra a ele, ou você pode recusar."
          }
        }
      }
    },
    "needs_you.over_total_manager": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es liegt über einer Summe der Card, etwa einer Tagessumme. Zusatzspielraum lässt nur diesen Aufruf durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's over a Card total, such as a day's. Extra room lets only this call through."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera un total de la Card, como el de un día. El margen extra deja pasar solo esta llamada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ületab Cardi kogusumma, näiteks päevase. Lisaruum laseb läbi ainult selle päringu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela dépasse un total de la Card, par exemple sur une journée. La marge supplémentaire ne laisse passer que cet appel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Supera un totale della Card, come quello di un giorno. Il margine extra fa passare solo questa chiamata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日の合計など、Cardの合計を超えています。枠を追加すると、この呼び出しだけが通ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 한도 같은 Card 합계를 넘었습니다. 추가 허용은 이 호출만 통과시킵니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Viršijama Card bendra suma, pvz., dienos. Papildomas rezervas praleidžia tik šią užklausą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas pārsniedz Card kopsummu, piemēram, dienas. Papildu rezerve ļauj izpildīt tikai šo izsaukumu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gaat boven een totaal van de Card, zoals dat van een dag. Extra ruimte laat alleen deze aanroep door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekracza sumę Card, np. dzienną. Dodatkowy zapas przepuszcza tylko to wywołanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excede um total do Card, como o de um dia. A margem extra deixa passar só esta chamada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excede um total do Card, como o de um dia. A margem extra deixa passar só esta chamada."
          }
        }
      }
    },
