    "taf.unless_you_approve_tools_sign": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du seine Tools nicht genehmigst, wird die Anmeldung %1$@ widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unless you approve its tools, the sign-in is revoked %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no apruebas sus herramientas, el inicio de sesión se revoca %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous n'approuvez pas ses outils, la connexion est révoquée %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non approvi i suoi strumenti, l'accesso viene revocato %1$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de tools niet goedkeurt, wordt de login %1$@ ingetrokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli nie zatwierdzisz jego narzędzi, logowanie zostanie unieważnione %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A menos que aprove as suas ferramentas, o início de sessão é revogado %1$@."
          }
        }
      }
    },
