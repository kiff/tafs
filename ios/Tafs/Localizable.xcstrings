        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifiutare la richiesta di aumentare il limite di spesa?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用上限の引き上げの依頼を却下しますか？"
