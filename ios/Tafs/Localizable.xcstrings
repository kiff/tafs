          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "celkem %1$@ %2$@, pak se zeptá vás"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ insgesamt %2$@, dann fragt er dich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in total %2$@, then it asks you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en total %2$@, después te pregunta"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kokku %2$@, siis küsib see sinult"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ au total %2$@, puis il vous demande"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ בסך הכול %2$@, ואז הוא שואל אותך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
