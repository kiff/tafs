    "coach.waiting_for_app": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا فُتحت صفحة تسجيل الدخول إلى %1$@، فأكملها هناك ثم عُد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ giriş səhifəsi açılıbsa, onu orada tamamlayın və qayıdın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако страницата за вход в %1$@ се отвори, завършете там и се върнете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-এর সাইন-ইন পাতা খুলে থাকলে সেখানে শেষ করে ফিরে আসুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si s'ha obert la pàgina d'inici de sessió de %1$@, acaba-la allà i torna."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se otevřela přihlašovací stránka %1$@, dokončete to tam a vraťte se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich die Anmeldeseite von %1$@ geöffnet hat, schließ die Anmeldung dort ab und komm zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If %1$@'s sign-in page opened, finish it there and come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se abrió la página de inicio de sesión de %1$@, termina allí y vuelve."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui rakenduse %1$@ sisselogimisleht avanes, lõpeta seal ja tule tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la page de connexion de %1$@ s'est ouverte, terminez-la là-bas et revenez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם דף הכניסה של %1$@ נפתח, יש לסיים אותו שם ולחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि %1$@ का साइन-इन पृष्ठ खुला हो, तो उसे वहीं पूरा करके लौट आएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako se otvorila stranica za prijavu za %1$@, dovršite je tamo i vratite se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha megnyílt a(z) %1$@ bejelentkezési oldala, fejezd be ott, és gyere vissza."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե %1$@-ի մուտքի էջը բացվեց, ավարտեք այնտեղ և վերադարձեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika halaman masuk %1$@ terbuka, selesaikan di sana lalu kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se si è aperta la pagina di accesso di %1$@, completala lì e torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のサインインページが開いた場合は、そこで完了してから戻ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ %1$@-ის შესვლის გვერდი გაიხსნა, დაასრულეთ იქ და დაბრუნდით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រសិនបើទំព័រចូលរបស់ %1$@ បានបើក សូមបញ្ចប់វានៅទីនោះ រួចត្រឡប់មកវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 로그인 페이지가 열렸다면 거기서 마친 뒤 돌아오세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຖ້າໜ້າເຂົ້າສູ່ລະບົບຂອງ %1$@ ເປີດຂຶ້ນ ໃຫ້ສຳເລັດຢູ່ບ່ອນນັ້ນ ແລ້ວກັບມາ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei atsidarė %1$@ prisijungimo puslapis, užbaikite ten ir grįžkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja atvērās %1$@ pierakstīšanās lapa, pabeidz to tur un atgriezies."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако се отвори страницата за најава на %1$@, заврши ја таму и врати се."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэрэв %1$@-ын нэвтрэх хуудас нээгдсэн бол тэнд дуусгаад буцаж ирнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को साइन इन पृष्ठ खुलेको भए त्यहीँ सक्नुहोस् र फर्कनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de inlogpagina van %1$@ is geopend, rond het daar af en kom terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli otworzyła się strona logowania do %1$@, dokończ tam i wróć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a página de início de sessão de %1$@ abriu, conclua-o lá e volte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a página de login de %1$@ abriu, conclua-o lá e volte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă s-a deschis pagina de conectare %1$@, terminați acolo și reveniți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak sa otvorila prihlasovacia stránka %1$@, dokončite to tam a vráťte sa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če se je odprla stran za prijavo %1$@, jo dokončajte tam in se vrnite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse u hap faqja e hyrjes së %1$@, përfundojeni atje dhe ktheheni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako se otvorila stranica za prijavu za %1$@, dovršite je tamo i vratite se."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากหน้าเข้าสู่ระบบของ %1$@ เปิดขึ้น ให้ทำให้เสร็จที่นั่นแล้วกลับมา"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Eger %1$@-yň giriş sahypasy açylan bolsa, ony şol ýerde gutaryp gaýdyp geliň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ oturum açma sayfası açıldıysa orada tamamlayıp geri dönün."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر %1$@ کا سائن اِن صفحہ کھل گیا ہو تو اسے وہیں مکمل کریں اور واپس آئیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu trang đăng nhập của %1$@ đã mở, hãy hoàn tất ở đó rồi quay lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若 %1$@ 的登入頁面已開啟，請在那裡完成後再回來。"
          }
        }
      }
    },
