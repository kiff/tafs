    "approval.locked_after_too_many_tries": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist nach zu vielen Versuchen gesperrt. Sperre dieses %2$@, entsperre es mit seinem Code und prüfe dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is locked after too many tries. Lock this %2$@, unlock it with its passcode, then check again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está bloqueado tras demasiados intentos. Bloquea este %2$@, desbloquéalo con su código y vuelve a comprobarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est verrouillé après trop de tentatives. Verrouillez cet %2$@, déverrouillez-le avec son code, puis vérifiez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è bloccato dopo troppi tentativi. Blocca questo %2$@, sbloccalo con il codice, poi controlla di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is vergrendeld na te veel pogingen. Vergrendel deze %2$@, ontgrendel hem met de toegangscode en controleer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest zablokowane po zbyt wielu próbach. Zablokuj ten %2$@, odblokuj go kodem, a potem sprawdź ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está bloqueado após demasiadas tentativas. Bloqueie este %2$@, desbloqueie-o com o código e verifique novamente."
          }
        }
      }
    },
