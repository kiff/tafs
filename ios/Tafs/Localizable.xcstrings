        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "atkārtotā nosūtīšana paliek aizturēta; nekas netiek nosūtīts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "de herzending wordt vastgehouden; er wordt niets verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
