          "stringUnit": {
            "state": "translated",
            "value": "Не е възобновено: не беше потвърдено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার চালু হয়নি: নিশ্চিত হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No reprès: no s'ha confirmat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobnoveno: nebylo potvrzeno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht fortgesetzt: Es wurde nicht bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not resumed: it wasn't confirmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reanudó: no se confirmó."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei jätkatud: seda ei kinnitatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non repris : ce n'a pas été confirmé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא חודש: זה לא אושר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर शुरू नहीं हुआ: उसकी पुष्टि नहीं हुई।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije nastavljeno: nije potvrđeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs folytatva: nem lett megerősítve."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չվերսկսվեց․ չհաստատվեց։"
          }
        },
        "id": {
