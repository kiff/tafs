    "door.not_read": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qapılar indi oxuna bilmədi. Bura qayıdanda yenidən cəhd edilir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вратите не можаха да бъдат прочетени в момента. Ще бъде опитано отново, когато се върнете тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dveře se teď nepodařilo načíst. Zkusí se to znovu, až se sem vrátíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Türen konnten gerade nicht gelesen werden. Es wird erneut versucht, wenn du hierher zurückkommst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The doors couldn't be read just now. They're tried again when you come back here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se pudieron leer las puertas. Se vuelve a intentar cuando regreses aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uksi ei õnnestunud praegu lugeda. Neid proovitakse uuesti, kui siia tagasi tuled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les portes n'ont pas pu être lues pour le moment. Elles seront relues à votre retour ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrata trenutačno nije bilo moguće pročitati. Pokušat će se ponovno kad se vratite ovamo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ajtókat most nem sikerült beolvasni. Amikor visszajössz ide, újra próbálkozunk."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դռները հիմա չկարողացան կարդացվել։ Դրանք նորից կփորձվեն, երբ վերադառնաք այստեղ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintu tidak dapat dibaca saat ini. Akan dicoba lagi saat Anda kembali ke sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere le porte in questo momento. Si riprova quando torni qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、窓口を読み込めませんでした。ここに戻ったときに再試行します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კარები ახლა ვერ წაიკითხა. ისინი ხელახლა იცდება, როცა აქ დაბრუნდებით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 창구를 읽지 못했습니다. 여기로 돌아오면 다시 시도합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiuo metu nepavyko nuskaityti durų. Bus bandoma dar kartą, kai čia sugrįšite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Durvis pašlaik nevarēja nolasīt. Tās tiks nolasītas vēlreiz, kad atgriezīsies šeit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De deuren konden nu niet worden gelezen. Dat wordt opnieuw geprobeerd als je hier terugkomt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz odczytać drzwi. Spróbujemy ponownie, gdy tu wrócisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as portas neste momento. Tentaremos novamente quando voltar aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as portas neste momento. Tentaremos novamente quando voltar aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ușile nu au putut fi citite acum. Se reîncearcă când reveniți aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvere sa teraz nepodarilo načítať. Skúsi sa to znova, keď sa sem vrátite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrat trenutno ni bilo mogoče prebrati. Ko se vrnete sem, se poskusi znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Portat nuk u lexuan dot tani. Provohen sërish kur të ktheheni këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrata trenutno nije bilo moguće pročitati. Pokušat će se ponovo kad se vratite ovamo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านประตูไม่ได้ในตอนนี้ จะลองใหม่เมื่อคุณกลับมาที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapılar şu anda okunamadı. Buraya döndüğünüzde yeniden denenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc các cửa lúc này. Chúng sẽ được thử lại khi bạn quay lại đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法讀取這些門。您回到這裡時會再次嘗試。"
          }
        }
      }
    },
