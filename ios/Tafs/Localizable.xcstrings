    "version.guide.install_or_back": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Installieren“ macht sie zur Live-Version; „Zurückkehren“ beendet den Test."
          }
