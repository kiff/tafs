            "value": "Fjalët e KIFF për këtë lidhje nuk dalin të sakta (%1$@). Asgjë nuk u miratua."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ove reči za ovu vezu ne prolaze proveru (%1$@). Ništa nije odobreno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้อยคำของ KIFF สำหรับการเชื่อมต่อนี้ไม่ตรงกัน (%1$@) ยังไม่ได้อนุมัติอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF'in bu bağlantı için sözleri doğrulanamadı (%1$@). Hiçbir şey onaylanmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời của KIFF cho kết nối này không khớp (%1$@). Chưa phê duyệt gì."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF 針對此連線的文字驗證未通過（%1$@）。未核准任何項目。"
          }
        }
      }
    },
