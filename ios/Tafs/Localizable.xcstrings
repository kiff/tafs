    "sample.reply.more_room": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann mir selbst keinen weiteren Spielraum geben: Nur du kannst das, indem du meine Card änderst. Alles darüber wartet unter „Braucht dich“ auf dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't give myself more room: only you can, by changing my Card. Anything over it waits for you in Needs you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedo darme más margen: solo tú puedes, cambiando mi Card. Todo lo que lo supere te espera en Te necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne peux pas me donner plus de marge : vous seul le pouvez, en modifiant ma Card. Tout ce qui la dépasse vous attend dans Vous attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non posso darmi più margine: puoi farlo solo tu, modificando la mia Card. Tutto ciò che la supera ti aspetta in Ti aspetta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kan mezelf geen extra ruimte geven: alleen jij kunt dat, door mijn Card te wijzigen. Alles daarboven wacht op je in Wacht op jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogę dać sobie więcej zapasu: możesz to zrobić tylko Ty, zmieniając moją Card. Wszystko ponad nią czeka na Ciebie w sekcji Czeka na Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não posso dar-me mais margem: só você pode, alterando o meu Card. Tudo o que o exceda aguarda por si em Precisa de si."
          }
        }
      }
    },
    "sample.reply.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(Beispielantwort. Mit KIFF angemeldet antwortet dein taf wirklich.)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(Sample reply. Signed in with KIFF, your taf answers for real.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(Respuesta de ejemplo. Con la sesión iniciada en KIFF, tu taf responde de verdad.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(Réponse d'exemple. Connecté avec KIFF, votre taf répond pour de vrai.)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "(Risposta di esempio. Con l'accesso a KIFF, il tuo taf risponde davvero.)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "(Voorbeeldantwoord. Ingelogd met KIFF antwoordt je taf echt.)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "(Przykładowa odpowiedź. Po zalogowaniu przez KIFF Twój taf odpowiada naprawdę.)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "(Resposta de exemplo. Com sessão iniciada no KIFF, o seu taf responde a sério.)"
          }
        }
      }
    },
