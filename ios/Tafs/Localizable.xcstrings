          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafovi su blokirani. Ništa novo ne šalje se dok ne nastavite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระงับ taf ของคุณแล้ว จะไม่มีอะไรใหม่ถูกส่งจนกว่าคุณจะทำต่อ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs-laryňyz togtadyldy. Siz dowam etdirýänçäňiz hiç zat täze iberilmeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm tafs'larınız donduruldu. Siz devam ettirene kadar yeni bir şey gönderilmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے tafs روک دیے گئے۔ جب تک آپ دوبارہ نہ چلائیں کچھ نیا نہیں بھیجا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đóng băng các tafs của bạn. Sẽ không có gì mới được gửi cho đến khi bạn tiếp tục."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
