    "needs_you.get_alert_when_call_waits": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dich benachrichtigen, wenn ein Aufruf auf deine Antwort wartet, auch wenn tafs geschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get an alert when a call waits for your answer, even with tafs closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe una alerta cuando una llamada espere tu respuesta, aunque tafs esté cerrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une alerte quand un appel attend votre réponse, même si tafs est fermé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi un avviso quando una chiamata aspetta la tua risposta, anche con tafs chiusa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg een melding als een aanroep op je antwoord wacht, ook als tafs gesloten is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj alert, gdy wywołanie czeka na Twoją odpowiedź, nawet gdy tafs jest zamknięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba um alerta quando uma chamada aguardar a sua resposta, mesmo com o tafs fechado."
          }
        }
      }
    },
    "needs_you.install_from_card": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere sie über ihre Karte: Die Version geht live, dann erfährt Coach davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install it from its card: the version goes live, then Coach hears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instálala desde su tarjeta: la versión se activa y luego Coach se entera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez-la depuis sa fiche : la version est mise en service, puis Coach est prévenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installala dalla sua scheda: la versione diventa attiva, poi Coach viene informato."
          }
        },
        "nl": {
