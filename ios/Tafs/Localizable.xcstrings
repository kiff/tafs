    "coach.stopped_part_way_before_finished": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bitməmiş yarıda dayandı."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това спря по средата, преди да завърши."
          }
