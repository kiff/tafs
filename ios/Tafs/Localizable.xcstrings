      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Niyə nəsə rədd edildi və ya saxlanıldı?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Защо нещо беше отказано или задържано?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proč bylo něco odmítnuto nebo zadrženo?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum wurde etwas abgelehnt oder zurückgehalten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why was something refused or held?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué algo fue rechazado o retenido?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Miks millestki keelduti või miks see kinni peeti?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi quelque chose a-t-il été refusé ou retenu ?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zašto je nešto odbijeno ili zadržano?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Miért lett valami elutasítva vagy visszatartva?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչու՞ մերժվեց կամ պահվեց ինչ-որ բան։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengapa sesuatu ditolak atau ditahan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché qualcosa è stato rifiutato o trattenuto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なぜ拒否または保留されたの？"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რატომ უარყვეს ან დააკავეს რამე?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왜 거절되거나 보류되었나요?"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodėl kažkas atmesta ar sulaikyta?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāpēc kaut kas tika atteikts vai aizturēts?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom is iets geweigerd of vastgehouden?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego coś zostało odrzucone lub jest oczekujące?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque é que algo foi recusado ou retido?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque é que algo foi recusado ou retido?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De ce a fost ceva refuzat sau reținut?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prečo bolo niečo odmietnuté alebo pozdržané?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakaj je bilo nekaj zavrnjeno ali zadržano?"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pse u refuzua ose u mbajt diçka?"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zašto je nešto odbijeno ili zadržano?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำไมบางสิ่งถูกปฏิเสธหรือพักไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey neden reddedildi veya tutuldu?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao có việc bị từ chối hoặc giữ lại?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為什麼有項目被拒絕或保留？"
          }
        }
      }
