        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Nav pabeigts: nevarēja noņemt šo: %2$@. tafs mēģina vēlreiz katrā atsvaidzināšanas reizē."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Niet afgerond: %2$@ kon niet worden verwijderd. tafs probeert het bij elke vernieuwing opnieuw."
