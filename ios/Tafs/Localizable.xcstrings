    "version.not_a_trial.confirmed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hat keinen Test gestartet: Es hat diese Cards als die eigenen des tafs ausgestellt. Prüfe seinen Card-Tab oder installiere die Version, die du hattest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF didn't start a trial: it issued these Cards as the taf's own. Check its Card tab, or install the version you had."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no inició una prueba: emitió estas Cards como propias del taf. Revisa su pestaña Card, o instala la versión que tenías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas lancé d'essai : il a émis ces Cards comme celles du taf. Vérifiez son onglet Card, ou installez la version que vous aviez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non ha avviato una prova: ha emesso queste Card come Card proprie del taf. Controlla la sua scheda Card, o installa la versione che avevi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF heeft geen proef gestart: het heeft deze Cards uitgegeven als die van het taf zelf. Controleer het tabblad Card, of installeer de versie die je had."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie rozpoczął próby: wydał te Card jako własne Card tafa. Sprawdź jego kartę Card albo zainstaluj wcześniejszą wersję."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
