    "knob.not_read_back": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung wurde vorgenommen, konnte aber nicht zurückgelesen werden. Tippe, um das Rad erneut zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change was made but couldn't be read back. Tap to read the dial again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio se hizo, pero no se pudo volver a leer. Toca para leer la rueda de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification a été faite mais n'a pas pu être relue. Touchez pour relire la molette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica è stata fatta ma non è stato possibile rileggerla. Tocca per rileggere il quadrante."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijziging is gemaakt maar kon niet worden teruggelezen. Tik om de draaiknop opnieuw te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana została wprowadzona, ale nie udało się jej odczytać. Dotknij, aby odczytać pokrętło ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração foi feita mas não foi possível relê-la. Toque para ler o seletor novamente."
          }
        }
      }
    },
    "knob.not_recorded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung hört zu, aber das Rad hat es noch nicht festgehalten. Genehmige erneut, um es festzuhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection is listening, but the dial hasn't recorded it yet. Approve again to record it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión está escuchando, pero la rueda aún no lo ha registrado. Vuelve a aprobar para registrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion écoute, mais la molette ne l'a pas encore enregistré. Approuvez à nouveau pour l'enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento è in ascolto, ma il quadrante non l'ha ancora registrato. Approva di nuovo per registrarlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De koppeling luistert, maar de draaiknop heeft het nog niet vastgelegd. Je moet het opnieuw goedkeuren om het vast te leggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie nasłuchuje, ale pokrętło jeszcze tego nie zapisało. Zatwierdź ponownie, aby to zapisać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação está à escuta, mas o seletor ainda não o registou. Aprove novamente para o registar."
          }
        }
      }
    },
