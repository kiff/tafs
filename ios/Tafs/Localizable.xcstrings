    "coach.not_allowed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach KIFF-in istifadəyə icazə verdiyi insanlar üçündür, standart olaraq hesabın administratorları."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach е за хората, на които KIFF позволява да го използват, по подразбиране администраторите на акаунта."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach je pro lidi, kterým ho KIFF dovolí používat, ve výchozím stavu pro správce účtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ist für die Personen da, die KIFF ihn nutzen lässt, standardmäßig die Admins des Kontos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach is for the people KIFF lets use it, by default the account's admins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach es para las personas a las que KIFF permite usarlo, por defecto los administradores de la cuenta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach on inimestele, kellel KIFF lubab seda kasutada, vaikimisi konto administraatoritele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach est réservé aux personnes que KIFF autorise, par défaut les administrateurs du compte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach je za ljude kojima ga KIFF dopušta, prema zadanim postavkama za administratore računa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Coach azoknak szól, akiknek a KIFF engedi, alapértelmezés szerint a fiók adminjainak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-ը նրանց համար է, ում KIFF-ը թույլ է տալիս օգտագործել, լռելյայն՝ հաշվի ադմինիստրատորների։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach untuk orang yang diizinkan KIFF memakainya, secara bawaan admin akun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach è per le persone a cui KIFF lo consente, di norma gli amministratori dell'account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachはKIFFが使用を許可した人のためのものです。既定ではアカウントの管理者です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach არის იმ ადამიანებისთვის, ვისაც KIFF უშვებს, ნაგულისხმევად ანგარიშის ადმინისტრატორებისთვის."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach는 KIFF가 허용한 사람(기본값: 계정 관리자)만 사용할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach skirtas žmonėms, kuriems KIFF tai leidžia, pagal numatytuosius nustatymus – paskyros administratoriams."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ir paredzēts tiem, kam KIFF ļauj to izmantot, pēc noklusējuma konta administratoriem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach is voor de mensen die KIFF het laat gebruiken, standaard de beheerders van het account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach jest dla osób, którym KIFF na to pozwala, domyślnie dla administratorów konta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach é para as pessoas a quem o KIFF permite usá-lo, por omissão os administradores da conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach é para as pessoas a quem o KIFF permite usá-lo, por omissão os administradores da conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach este pentru persoanele cărora KIFF le permite să-l folosească, implicit administratorii contului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach je pre ľudí, ktorým ho KIFF dovolí používať, predvolene pre správcov účtu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach je za ljudi, ki jim ga KIFF dovoli uporabljati, privzeto skrbnike računa."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach është për njerëzit që KIFF i lë ta përdorin, si parazgjedhje administratorët e llogarisë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach je za ljude kojima ga KIFF dopušta, prema zadanim podešavanjima za administratore naloga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach สำหรับผู้ที่ KIFF อนุญาตให้ใช้ โดยค่าเริ่มต้นคือผู้ดูแลระบบของบัญชี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach, KIFF'in kullanmasına izin verdiği kişiler içindir; varsayılan olarak hesabın yöneticileri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dành cho những người KIFF cho phép dùng, mặc định là quản trị viên của tài khoản."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach 供 KIFF 允許使用的人使用，預設為帳號的管理員。"
          }
        }
      }
    },
