    "sample.brief.pay.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Die 3 senden“ öffnet drei Genehmigungen, eine nach der anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the 3 opens three approvals, one after the other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Enviar los 3» abre tres aprobaciones, una tras otra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saada need 3 avab kolm kinnitust üksteise järel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Envoyer les 3 » ouvre trois approbations, l'une après l'autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Invia i 3» apre tre approvazioni, una dopo l'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「3件を送る」を押すと、承認が1件ずつ3回開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3개 보내기를 누르면 승인이 하나씩 차례로 세 번 열립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Siųsti visas 3“ atidaro tris patvirtinimus vieną po kito."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sūtīt 3” atver trīs apstiprinājumus, vienu pēc otra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Stuur de 3’ opent drie goedkeuringen, de een na de ander."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wyślij 3” otwiera trzy zatwierdzenia, jedno po drugim."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«Enviar as 3» abre três aprovações, uma após a outra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Enviar as 3» abre três aprovações, uma após a outra."
          }
