    "coach.chats.archive_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es verschwindet auf all deinen Geräten aus dieser Liste. Du findest es unter „Archiviert“, wo du es öffnen oder zurückholen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It leaves this list on all your devices. You'll find it under Archived, where you can open it or put it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale de esta lista en todos tus dispositivos. La encontrarás en Archivadas, donde puedes abrirla o restaurarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle quitte cette liste sur tous vos appareils. Vous la retrouverez dans Archivées, où vous pourrez l'ouvrir ou la restaurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce da questo elenco su tutti i tuoi dispositivi. La trovi in Archiviate, dove puoi aprirla o ripristinarla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verdwijnt uit deze lijst op al je apparaten. Je vindt het onder Gearchiveerd, waar je het kunt openen of terugzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zniknie z tej listy na wszystkich Twoich urządzeniach. Znajdziesz ją w Zarchiwizowanych, gdzie możesz ją otworzyć lub przywrócić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai desta lista em todos os seus dispositivos. Encontra-a em Arquivadas, onde a pode abrir ou repor."
          }
        }
      }
    },
