    "billing.play_cant_sell": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play bu telefonda satış edə bilmir, ona görə burada heç nə alına bilməz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play не може да продава на този телефон, така че нищо не може да се купи тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play v tomto telefonu nemůže prodávat, takže tu nelze nic koupit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play kann auf diesem Telefon nichts verkaufen, daher kann hier nichts gekauft werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play can't sell on this phone, so nothing can be bought here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play no puede vender en este teléfono, así que aquí no se puede comprar nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play ei saa selles telefonis müüa, seega siin ei saa midagi osta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play ne peut pas vendre sur ce téléphone : rien ne peut être acheté ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play ne može prodavati na ovom telefonu pa se ovdje ništa ne može kupiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Google Play ezen a telefonon nem tud értékesíteni, ezért itt semmit sem lehet vásárolni."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play-ը չի կարող վաճառել այս հեռախոսում, ուստի այստեղ ոչինչ չի կարելի գնել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play tidak dapat menjual di ponsel ini, jadi tidak ada yang dapat dibeli di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play non può vendere su questo telefono, quindi qui non si può acquistare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンではGoogle Playが販売できないため、ここでは何も購入できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play-ს ამ ტელეფონზე გაყიდვა არ შეუძლია, ამიტომ აქ ვერაფერს იყიდით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에서는 Google Play가 판매할 수 없어 여기서는 아무것도 구매할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play šiame telefone negali parduoti, todėl čia nieko nusipirkti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play šajā tālrunī nevar pārdot, tāpēc šeit neko nevar nopirkt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play kan op deze telefoon niet verkopen, dus hier kan niets worden gekocht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play nie może sprzedawać na tym telefonie, więc nic nie można tu kupić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Google Play não pode vender neste telefone, por isso não é possível comprar nada aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Google Play não pode vender neste telefone, por isso não é possível comprar nada aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play nu poate vinde pe acest telefon, așa că nu se poate cumpăra nimic aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play v tomto telefóne nemôže predávať, takže sa tu nedá nič kúpiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play v tem telefonu ne more prodajati, zato tu ni mogoče nič kupiti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play nuk mund të shesë në këtë telefon, ndaj këtu nuk mund të blihet asgjë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play ne može da prodaje na ovom telefonu, pa se ovde ništa ne može kupiti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play ขายบนโทรศัพท์เครื่องนี้ไม่ได้ จึงซื้ออะไรที่นี่ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play bu telefonda satış yapamıyor, bu yüzden burada hiçbir şey satın alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play không thể bán trên điện thoại này nên không thể mua gì ở đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play 無法在這部手機上銷售，因此這裡無法購買任何項目。"
          }
        }
      }
    },
