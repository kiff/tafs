    "settings.devices.passkey_not_registered": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Passkey wurde auf diesem Telefon erstellt, aber nicht zu deinem Konto hinzugefügt. Du kannst ihn aus den gespeicherten Passwörtern und Passkeys dieses Telefons entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passkey was made on this phone but not added to your account. You can remove it from this phone's saved passwords and passkeys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llave de acceso se creó en este teléfono, pero no se añadió a tu cuenta. Puedes quitarla de las contraseñas y llaves de acceso guardadas en este teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pääsuvõti loodi selles telefonis, kuid seda ei lisatud sinu kontole. Võid selle eemaldada selle telefoni salvestatud paroolide ja pääsuvõtmete hulgast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé d'accès a été créée sur ce téléphone, mais pas ajoutée à votre compte. Vous pouvez la supprimer des mots de passe et clés d'accès enregistrés sur ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La passkey è stata creata su questo telefono, ma non è stata aggiunta al tuo account. Puoi rimuoverla dalle password e passkey salvate su questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスキーはこのスマートフォンで作成されましたが、アカウントには追加されませんでした。このスマートフォンの保存済みパスワードとパスキーから削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에서 패스키를 만들었지만 계정에 추가되지 않았습니다. 이 휴대폰의 저장된 암호 및 패스키에서 삭제할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieigos raktas sukurtas šiame telefone, bet nepridėtas prie jūsų paskyros. Galite jį pašalinti iš šio telefono išsaugotų slaptažodžių ir prieigos raktų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piekļuves atslēga tika izveidota šajā tālrunī, bet netika pievienota tavam kontam. Tu vari to noņemt no šī tālruņa saglabātajām parolēm un piekļuves atslēgām."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De passkey is op deze telefoon gemaakt, maar niet aan je account toegevoegd. Je kunt hem verwijderen uit de opgeslagen wachtwoorden en passkeys van deze telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz dostępu został utworzony na tym telefonie, ale nie dodano go do konta. Możesz usunąć go z haseł i kluczy dostępu zapisanych na tym telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de acesso foi criada neste telefone, mas não foi adicionada à sua conta. Pode removê-la das palavras-passe e chaves de acesso guardadas neste telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de acesso foi criada neste telefone, mas não foi adicionada à sua conta. Pode removê-la das senhas e chaves de acesso guardadas neste telefone."
          }
        }
      }
    },
    "settings.devices.passkey_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Passkey auf diesem Telefon kann ein Computer darüber genehmigen: Der Computer zeigt einen QR-Code, und du scannst ihn mit diesem Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a passkey on this phone, a computer can approve through it: the computer shows a QR code, and you scan it with this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una llave de acceso en este teléfono, un ordenador puede aprobar a través de él: el ordenador muestra un código QR y tú lo escaneas con este teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui selles telefonis on pääsuvõti, saab arvuti selle kaudu kinnitada: arvuti näitab QR-koodi ja sina skannid selle selle telefoniga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec une clé d'accès sur ce téléphone, un ordinateur peut approuver par son biais : l'ordinateur affiche un code QR, et vous le scannez avec ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una passkey su questo telefono, un computer può approvare tramite esso: il computer mostra un codice QR e tu lo scansioni con questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンにパスキーがあれば、コンピュータはそれを通じて承認できます。コンピュータにQRコードが表示されたら、このスマートフォンでスキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에 패스키가 있으면 컴퓨터가 이를 통해 승인할 수 있습니다. 컴퓨터에 QR 코드가 표시되면 이 휴대폰으로 스캔하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Turint prieigos raktą šiame telefone, kompiuteris gali tvirtinti per jį: kompiuteris rodo QR kodą, o jūs jį nuskaitote šiuo telefonu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja šajā tālrunī ir piekļuves atslēga, dators var apstiprināt caur to: dators parāda QR kodu, un tu to skenē ar šo tālruni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een passkey op deze telefoon kan een computer via deze telefoon goedkeuren: de computer toont een QR-code en jij scant die met deze telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z kluczem dostępu na tym telefonie komputer może zatwierdzać przez niego: komputer pokazuje kod QR, a Ty skanujesz go tym telefonem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma chave de acesso neste telefone, um computador pode aprovar através dele: o computador mostra um código QR, que lê com este telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma chave de acesso neste telefone, um computador pode aprovar através dele: o computador mostra um código QR, que lê com este telefone."
          }
        }
      }
    },
