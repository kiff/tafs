    "approval.device_can_not_approve_approve": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع هذا الجهاز الموافقة. وافق على جهاز آخر مسجّل الدخول إلى حسابك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz təsdiq edə bilmir. Hesabınıza daxil olmuş başqa cihazda təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това устройство не може да одобрява. Одобрявайте на друго устройство, влязло в акаунта ви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইস অনুমোদন করতে পারে না। আপনার অ্যাকাউন্টে সাইন ইন করা অন্য ডিভাইসে অনুমোদন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest dispositiu no pot aprovar. Aprova en un altre dispositiu amb la sessió iniciada al teu compte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení nemůže schvalovat. Schvalte na jiném zařízení přihlášeném k vašemu účtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann nicht genehmigen. Genehmige auf einem anderen Gerät, das bei deinem Konto angemeldet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device can't approve. Approve on another device signed in to your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede aprobar. Aprueba en otro dispositivo con la sesión iniciada en tu cuenta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See seade ei saa kinnitada. Kinnita mõnes teises seadmes, mis on sinu kontole sisse logitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas approuver. Approuvez sur un autre appareil connecté à votre compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתקן הזה לא יכול לאשר. יש לאשר בהתקן אחר שמחובר לחשבון שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस मंज़ूर नहीं कर सकता। अपने खाते में साइन इन किसी और डिवाइस पर मंज़ूर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj ne može odobravati. Odobrite na drugom uređaju prijavljenom na vaš račun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz nem tud jóváhagyni. Hagyd jóvá egy másik, a fiókodba bejelentkezett eszközön."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքը չի կարող հաստատել։ Հաստատեք ձեր հաշվում մուտք գործած մեկ այլ սարքում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini tidak dapat menyetujui. Setujui di perangkat lain yang masuk ke akun Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non può approvare. Approva su un altro dispositivo connesso al tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは承認できません。アカウントにサインインしている別のデバイスで承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ მოწყობილობას დამტკიცება არ შეუძლია. დაამტკიცეთ სხვა მოწყობილობაზე, რომელიც თქვენს ანგარიშშია შესული."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឧបករណ៍នេះមិនអាចអនុម័តបានទេ។ អនុម័តនៅលើឧបករណ៍ផ្សេងដែលបានចូលគណនីរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 승인할 수 없습니다. 내 계정으로 로그인한 다른 기기에서 승인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອຸປະກອນນີ້ອະນຸມັດບໍ່ໄດ້. ອະນຸມັດໃນອຸປະກອນອື່ນທີ່ເຂົ້າສູ່ລະບົບບັນຊີຂອງທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis įrenginys negali tvirtinti. Tvirtinkite kitame įrenginyje, prisijungusiame prie jūsų paskyros."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī ierīce nevar apstiprināt. Apstiprini citā ierīcē, kurā esi pierakstījies savā kontā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој уред не може да одобрува. Одобри на друг уред најавен на твојата сметка."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ төхөөрөмж зөвшөөрч чадахгүй. Таны бүртгэлд нэвтэрсэн өөр төхөөрөмж дээр зөвшөөрнө үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो उपकरणले स्वीकृत गर्न सक्दैन। तपाईंको खातामा साइन इन भएको अर्को उपकरणमा स्वीकृत गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat kan niet goedkeuren. Keur goed op een ander apparaat dat met je account is ingelogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie może zatwierdzać. Zatwierdź na innym urządzeniu zalogowanym na Twoje konto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não pode aprovar. Aprove noutro dispositivo com sessão iniciada na sua conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não pode aprovar. Aprove em outro dispositivo conectado à sua conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv nu poate aproba. Aprobați pe alt dispozitiv conectat la contul dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zariadenie nemôže schvaľovať. Schváľte na inom zariadení prihlásenom k vášmu účtu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta naprava ne more odobravati. Odobrite na drugi napravi, prijavljeni v vaš račun."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo pajisje nuk mund të miratojë. Miratoni në një pajisje tjetër të hyrë në llogarinë tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj ne može da odobrava. Odobrite na drugom uređaju prijavljenom na vaš nalog."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้อนุมัติไม่ได้ ให้อนุมัติบนอุปกรณ์อื่นที่เข้าสู่ระบบบัญชีของคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu enjam tassyklap bilmeýär. Hasabyňyza giren başga enjamda tassyklaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz onay veremez. Hesabınızda oturum açık olan başka bir cihazdan onaylayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آلہ منظور نہیں کر سکتا۔ اپنے اکاؤنٹ میں سائن اِن کسی اور آلے پر منظور کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không thể phê duyệt. Hãy phê duyệt trên một thiết bị khác đã đăng nhập vào tài khoản của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部裝置無法核准。請在另一部已登入您帳號的裝置上核准。"
          }
        }
      }
    },
    "approval.did_not_recognise_you_nothing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتعرف عليك %1$@، فلم تتم الموافقة على شيء. الطلب محفوظ: وافق مرة أخرى عندما تكون مستعدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sizi tanımadı, ona görə heç nə təsdiqlənmədi. Sorğu saxlanılıb: hazır olanda yenidən təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не ви разпозна, така че нищо не беше одобрено. Заявката се запазва: одобрете отново, когато сте готови."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ আপনাকে চিনতে পারেনি, তাই কিছু অনুমোদিত হয়নি। অনুরোধটি রাখা আছে: প্রস্তুত হলে আবার অনুমোদন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no t'ha reconegut, així que no s'ha aprovat res. La sol·licitud es conserva: torna a aprovar quan estiguis a punt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vás nerozpoznalo, takže se nic neschválilo. Žádost zůstává: schvalte znovu, až budete připraveni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat dich nicht erkannt, also wurde nichts genehmigt. Die Anfrage bleibt erhalten: Genehmige erneut, wenn du so weit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ didn't recognise you, so nothing was approved. The request is kept: approve again when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no te reconoció, así que no se aprobó nada. La solicitud se conserva: vuelve a aprobar cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuvastamine ei õnnestunud (%1$@), seega midagi ei kinnitatud. Päring jääb alles: kinnita uuesti, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne vous a pas reconnu : rien n'a été approuvé. La demande est conservée : approuvez à nouveau quand vous êtes prêt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ לא זיהה אותך, ולכן שום דבר לא אושר. הבקשה נשמרה: אפשר לאשר שוב כשתהיה מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ने आपको नहीं पहचाना, इसलिए कुछ मंज़ूर नहीं हुआ। अनुरोध रखा है: तैयार होने पर फिर मंज़ूर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje nije uspjelo (%1$@) pa ništa nije odobreno. Zahtjev je sačuvan: odobrite ponovno kad budete spremni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem ismert fel (%1$@), így semmi sem lett jóváhagyva. A kérés megmarad: hagyd jóvá újra, ha készen állsz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը ձեզ չճանաչեց, ուստի ոչինչ չհաստատվեց։ Հարցումը պահպանվել է․ հաստատեք նորից, երբ պատրաստ լինեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tidak mengenali Anda, jadi tidak ada yang disetujui. Permintaan tetap disimpan: setujui lagi saat Anda siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non ti ha riconosciuto, quindi non è stato approvato nulla. La richiesta resta: approva di nuovo quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@であなたを認識できなかったため、何も承認されていません。リクエストは保持されています。準備ができたらもう一度承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-მა ვერ გიცნოთ, ამიტომ არაფერი დამტკიცებულა. მოთხოვნა შენახულია: დაამტკიცეთ ხელახლა, როცა მზად იქნებით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ មិនស្គាល់អ្នកទេ ដូច្នេះគ្មានអ្វីត្រូវបានអនុម័តទេ។ សំណើត្រូវបានរក្សាទុក៖ អនុម័តម្តងទៀតនៅពេលអ្នករួចរាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 나를 인식하지 못해 승인된 것은 없습니다. 요청은 남아 있으니 준비되면 다시 승인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ຈື່ທ່ານບໍ່ໄດ້ ສະນັ້ນບໍ່ມີຫຍັງຖືກອະນຸມັດ. ຄຳຂໍຖືກເກັບໄວ້: ອະນຸມັດອີກເມື່ອທ່ານພ້ອມ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų neatpažino (%1$@), todėl niekas nepatvirtinta. Užklausa išsaugota: patvirtinkite dar kartą, kai būsite pasirengę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tevi neatpazina, tāpēc nekas netika apstiprināts. Pieprasījums ir saglabāts: apstiprini vēlreiz, kad esi gatavs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не те препозна, па ништо не е одобрено. Барањето се чува: одобри повторно кога ќе си подготвен."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ таныг таньсангүй тул юу ч зөвшөөрөгдөөгүй. Хүсэлт хадгалагдсан: бэлэн болмогцоо дахин зөвшөөрнө үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ले तपाईंलाई चिनेन, त्यसैले केही स्वीकृत भएन। अनुरोध राखिएको छ: तयार हुँदा फेरि स्वीकृत गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft je niet herkend, dus er is niets goedgekeurd. Het verzoek blijft bewaard: keur het goed wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Cię nie rozpoznało, więc nic nie zostało zatwierdzone. Prośba zostaje zachowana: zatwierdź ją ponownie, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento por %1$@ falhou, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento por %1$@ falhou, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nu v-a recunoscut, așa că nu s-a aprobat nimic. Solicitarea se păstrează: aprobați din nou când sunteți gata."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vás nerozpoznalo, takže sa nič neschválilo. Žiadosť zostáva: schváľte znova, keď budete pripravení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vas ni prepoznalo, zato ni bilo nič odobreno. Zahteva ostane: odobrite znova, ko boste pripravljeni."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nuk ju njohu, ndaj asgjë nuk u miratua. Kërkesa ruhet: miratoni sërish kur të jeni gati."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vas nije prepoznao, pa ništa nije odobreno. Zahtev je sačuvan: odobrite ponovo kad budete spremni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จำคุณไม่ได้ จึงไม่มีอะไรถูกอนุมัติ คำขอยังอยู่: อนุมัติอีกครั้งเมื่อคุณพร้อม"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sizi tanamady, şonuň üçin hiç zat tassyklanmady. Haýyş saklanýar: taýýar bolanyňyzda täzeden tassyklaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıma başarısız (%1$@), bu yüzden hiçbir şey onaylanmadı. İstek korunuyor: hazır olduğunuzda tekrar onaylayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ نے آپ کو نہیں پہچانا، اس لیے کچھ منظور نہیں ہوا۔ درخواست رکھی ہے: تیار ہونے پر دوبارہ منظور کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ không nhận ra bạn nên không có gì được phê duyệt. Yêu cầu vẫn được giữ: hãy phê duyệt lại khi bạn sẵn sàng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@無法辨識您，因此未核准任何項目。請求仍保留：準備好時再次核准。"
          }
        }
      }
    },
