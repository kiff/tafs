    "connect.kept.for_cards|one": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُبقي اتصال واحد لـ %2$@، تستخدمه Cards الخاصة به."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ saxlanıldı: %2$@ üçün, onun Card-ları bundan istifadə edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ е запазена за %2$@, чиито Cards я използват."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-এর জন্য %1$@টি রাখা হয়েছে, যার Card এটি ব্যবহার করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ha conservat %1$@ per a %2$@, els Cards del qual el fan servir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponecháno %1$@ pro %2$@, jehož Card ho používají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ für %2$@ behalten, deren Cards sie nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept %1$@ for %2$@, whose Cards use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservó %1$@ para %2$@, cuyas Cards la usan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jäeti alles: %2$@, mille Cardid seda kasutavad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ conservée pour %2$@, dont les Cards l'utilisent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר אחד עבור %2$@, ש-Card שלו משתמשים בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ के लिए %1$@ रखा गया, जिसके Card इसे उपयोग करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržana je %1$@ veza: koriste je Cardovi od: %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ megtartva ennek, mert a Cardjai használják: %2$@."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահվեց %1$@՝ %2$@-ի համար, որի Card-երը օգտագործում են այն։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenuto %1$@ per %2$@, le cui Card lo usano."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენარჩუნდა %1$@ %2$@-სთვის, რომლის Card-ები მას იყენებს."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išlaikytas %1$@, nes jį naudoja %2$@ Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paturēts %1$@: %2$@ Card to izmanto."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задржана %1$@ за %2$@, чии Card ја користат."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-ууд нь үүнийг ашигладаг %2$@-д зориулж %1$@-ийг үлдээсэн."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ का लागि %1$@ राखियो, जसका Card ले यो प्रयोग गर्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ behouden voor %2$@, waarvan de Cards hem gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowano %1$@ dla: %2$@, bo używają go ich Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mantida para %2$@, cujos Cards a usam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mantida para %2$@, cujos Cards a usam."
          }
        },
        "ro": {
