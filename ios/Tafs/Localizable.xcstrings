    "setup.place.email_words": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رده على %1$@؛ وليس وقت كتابتك للرسالة"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onun cavabı %1$@ ünvanına; mesajı nə vaxt yazdığınız yox"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговорът му до %1$@; не и кога сте написали съобщението"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-এ এর উত্তর; আপনি কখন বার্তা লিখেছিলেন তা নয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La seva resposta a %1$@; no quan vas escriure el missatge"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho odpověď na %1$@; ne kdy jste zprávu napsali"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Antwort an %1$@; nicht, wenn du die Nachricht geschrieben hast"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its answer to %1$@; not when you wrote the message"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su respuesta a %1$@; no cuando escribiste tú el mensaje"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle vastus aadressile %1$@; mitte siis, kui sõnumi kirjutasid sina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa réponse à %1$@ ; pas quand c'est vous qui avez écrit le message"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התשובה שלו אל %1$@; לא מתי כתבת את ההודעה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को इसका उत्तर; संदेश लिखने का समय नहीं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegov odgovor na %1$@; ne kad ste napisali poruku"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válasza ide: %1$@; nem az, hogy mikor írtad az üzenetet"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրա պատասխանը՝ %1$@․ ոչ թե երբ գրեցիք հաղորդագրությունը"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawabannya ke %1$@; bukan saat Anda menulis pesan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua risposta a %1$@; non quando il messaggio l'hai scritto tu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答を%1$@に送ります。メッセージを書いたのがあなたの場合は送りません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისი პასუხი: %1$@; არა მაშინ, როცა შეტყობინება დაწერეთ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចម្លើយរបស់វាទៅ %1$@; មិនមែនពេលអ្នកសរសេរសារទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(으)로 답변을 보냅니다. 내가 메시지를 썼을 때는 보내지 않습니다"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຳຕອບຂອງມັນໄປ %1$@; ບໍ່ແມ່ນເວລາທີ່ທ່ານຂຽນຂໍ້ຄວາມ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo atsakymas adresu %1$@; ne tada, kai žinutę parašėte jūs"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā atbilde uz %1$@; ne tad, kad ziņu rakstīji tu"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неговиот одговор на %1$@; не кога ја напиша пораката"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түүний хариу %1$@ руу; таныг мессеж бичсэн үед биш"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसको जवाफ %1$@ मा; तपाईंले सन्देश लेखेको समय होइन"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het antwoord naar %1$@; niet als jij het bericht schreef"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego odpowiedź na %1$@; nie wtedy, gdy autorem wiadomości jesteś Ty"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua resposta para %1$@; não quando foi você a escrever a mensagem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua resposta para %1$@; não quando foi você a escrever a mensagem"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsul său către %1$@; nu și când ați scris mesajul"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho odpoveď na %1$@; nie kedy ste správu napísali"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegov odgovor na %1$@; ne, ko ste sporočilo napisali"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigjja e tij te %1$@; jo kur e shkruat mesazhin"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegov odgovor na %1$@; ne kad ste napisali poruku"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบของมันไปที่ %1$@ ไม่ใช่ตอนที่คุณเขียนข้อความ"
