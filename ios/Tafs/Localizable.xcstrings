        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apstiprināšanai vajag %1$@, bet šajā ierīcē (%2$@) vēl nav iestatīts neviens no tiem. Iestati to: %3$@, tad atgriezies."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goedkeuren vraagt om %1$@, en dat is nog niet ingesteld op deze %2$@. Stel het in via %3$@ en kom dan terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdzenie wymaga %1$@, a na tym urządzeniu (%2$@) nic takiego nie jest jeszcze skonfigurowane. Skonfiguruj to w %3$@, a potem wróć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar pede %1$@, e nenhum está configurado neste %2$@. Configure-o em %3$@ e depois volte."
