    "pair.added_passkey": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ təsdiqləri özü imzalaya bilmir. Telefonunuzda və ya giriş açarı ilə təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този %1$@ не може сам да подписва одобрения. Одобрявайте от телефона си или с ключ за достъп."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento %1$@ nemůže sám podepisovat schválení. Schvalujte v telefonu nebo přístupovým klíčem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser %1$@ kann Genehmigungen nicht selbst signieren. Genehmige auf deinem Handy oder mit einem Passkey."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ can't sign approvals itself. Approve on your phone, or with a passkey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ no puede firmar aprobaciones por sí mismo. Aprueba en tu teléfono o con una llave de acceso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See %1$@ ei saa kinnitusi ise allkirjastada. Kinnita telefonis või pääsuvõtmega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ne peut pas signer les approbations lui-même. Approuvez sur votre téléphone, ou avec une clé d'identification."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj %1$@ ne može sam potpisivati odobrenja. Odobravajte na telefonu ili pristupnim ključem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz (%1$@) maga nem tud jóváhagyásokat aláírni. Hagyd jóvá a telefonodon vagy jelkulccsal."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքը (%1$@) ինքնուրույն չի կարող ստորագրել հաստատումները։ Հաստատեք ձեր հեռախոսով կամ մուտքի բանալիով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ini tidak dapat menandatangani persetujuan sendiri. Setujui di ponsel Anda, atau dengan kunci sandi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo %1$@ non può firmare le approvazioni da solo. Approva sul telefono o con una passkey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%1$@は自分で承認に署名できません。スマートフォンかパスキーで承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოწყობილობა (%1$@) დამტკიცებებს თვითონ ვერ აწერს ხელს. დაამტკიცეთ ტელეფონზე ან პასკით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %1$@은(는) 직접 승인에 서명할 수 없습니다. 휴대폰이나 패스키로 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis įrenginys (%1$@) pats negali pasirašyti patvirtinimų. Tvirtinkite telefone arba prieigos raktu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis %1$@ pats nevar parakstīt apstiprinājumus. Apstiprini savā tālrunī vai ar piekļuves atslēgu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %1$@ kan goedkeuringen niet zelf ondertekenen. Keur goed op je telefoon, of met een toegangssleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten %1$@ nie może sam podpisywać zatwierdzeń. Zatwierdzaj na telefonie albo kluczem dostępu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ não pode assinar aprovações sozinho. Aprove no telemóvel ou com uma chave de acesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ não pode assinar aprovações sozinho. Aprove no celular ou com uma chave de acesso."
          }
        },
        "ro": {
          "stringUnit": {
