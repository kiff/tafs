            "value": "Începe luni, conform HR"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastupuje v pondelok, podľa HR"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začne v ponedeljek, po kadrovski"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fillon të hënën, sipas HR"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Počinje u ponedeljak, prema kadrovskoj"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มวันจันทร์ ตามฝ่ายบุคคล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazartesi başlıyor, İK'ya göre"
          }
        },
        "vi": {
