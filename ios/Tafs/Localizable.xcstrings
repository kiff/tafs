    "door.day.open|one": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün sizdən və cütləşmiş göndərənlərdən %1$@ içindən %2$@. Yalnız mətn: əlavələr açılmır və cavab bunu bildirir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ от %1$@ от вас и сдвоените податели днес. Само текст: прикачените файлове не се отварят и отговорът го казва."
          }
        },
        "cs": {
