    "settings.devices.pair_invalid": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF konnte diesen Code nicht lesen. Lass einen neuen auf deinem Computer anzeigen und scanne ihn erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF couldn't read that code. Show a new one on your computer and scan it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no pudo leer ese código. Muestra uno nuevo en tu ordenador y escanéalo otra vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei saanud seda koodi lugeda. Näita arvutis uut ja skanni see uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas pu lire ce code. Affichez-en un nouveau sur votre ordinateur et scannez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non è riuscito a leggere quel codice. Mostrane uno nuovo sul tuo computer e scansionalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFがそのコードを読み取れませんでした。コンピュータに新しいコードを表示して、もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 그 코드를 읽지 못했습니다. 컴퓨터에 새 코드를 표시하고 다시 스캔하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nepavyko nuskaityti to kodo. Parodykite naują kompiuteryje ir nuskaitykite jį dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nevarēja nolasīt šo kodu. Parādi jaunu savā datorā un skenē to vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kon die code niet lezen. Toon een nieuwe op je computer en scan die opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie odczytał tego kodu. Wyświetl nowy na komputerze i zeskanuj go ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não conseguiu ler esse código. Mostre um novo no seu computador e leia-o outra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não conseguiu ler esse código. Mostre um novo no seu computador e leia-o outra vez."
          }
        }
      }
    },
