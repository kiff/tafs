    "setup.approve_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموافقة توقّع على هذا الهاتف؛ ولا يبدأ التطبيق بإخبار الـ taf إلا بعد ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təsdiq bu telefonda imzalayır; tətbiq taf-a yalnız bundan sonra xəbər verməyə başlayır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрението се подписва на този телефон; едва след това приложението започва да съобщава на taf."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমোদন এই ফোনে সই করে; অ্যাপ এরপরই শুধু taf-কে জানাতে শুরু করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar signa en aquest telèfon; l'aplicació només comença a avisar el taf després d'això."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Schválení se podepíše v tomto telefonu; aplikace začne taf informovat až potom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Genehmigen“ signiert auf diesem Telefon; erst danach beginnt die App, dem taf Bescheid zu geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve signs on this phone; the app starts telling the taf only after that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar firma en este teléfono; la app empieza a avisar al taf solo después."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinnitus allkirjastatakse selles telefonis; rakendus hakkab tafile teada andma alles pärast seda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver signe sur ce téléphone ; l'app ne commence à prévenir le taf qu'ensuite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האישור חותם בטלפון הזה; האפליקציה מתחילה לעדכן את ה-taf רק אחרי זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मंज़ूर करना इस फ़ोन पर हस्ताक्षर करता है; ऐप उसके बाद ही taf को बताना शुरू करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobravanje potpisuje na ovom telefonu; aplikacija tek nakon toga počinje obavještavati taf."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jóváhagyást ezen a telefonon írod alá; az alkalmazás csak ezután kezd szólni a tafnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաստատումը ստորագրվում է այս հեռախոսում․ հավելվածը սկսում է տեղեկացնել taf-ին միայն դրանից հետո։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persetujuan ditandatangani di ponsel ini; aplikasi baru mulai memberi tahu taf setelah itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva firma su questo telefono; l'app inizia ad avvisare il taf solo dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認すると、このスマートフォンで署名します。その後にだけ、アプリがtafに知らせ始めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დამტკიცება ამ ტელეფონზე იწერება; აპი taf-ს ამის შემდეგ იწყებს ინფორმირებას."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការអនុម័តចុះហត្ថលេខានៅលើទូរសព្ទនេះ; កម្មវិធីចាប់ផ្តើមប្រាប់ taf តែបន្ទាប់ពីនោះប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하면 이 휴대폰에서 서명합니다. 그 후에야 앱이 taf에 알리기 시작합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການອະນຸມັດລົງລາຍເຊັນໃນໂທລະສັບນີ້; ແອັບເລີ່ມບອກ taf ຫຼັງຈາກນັ້ນເທົ່ານັ້ນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Patvirtinimas pasirašomas šiame telefone; tik po to programėlė pradeda pranešti taf."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Apstiprināt” paraksta šajā tālrunī; tikai pēc tam lietotne sāk informēt taf."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобри потпишува на овој телефон; апликацијата почнува да му кажува на tafот дури потоа."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөвшөөрөх нь энэ утсан дээр гарын үсэг зурна; апп үүний дараа л taf-д хэлж эхэлнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वीकृतिले यो फोनमा हस्ताक्षर गर्छ; त्यसपछि मात्र एपले taf लाई भन्न थाल्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goedkeuren ondertekent op deze telefoon; pas daarna begint de app het taf te informeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zatwierdź” podpisuje na tym telefonie; aplikacja zaczyna powiadamiać tafa dopiero potem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar assina neste telefone; só depois disso a app começa a avisar o taf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar assina neste telefone; só depois disso o app começa a avisar o taf."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobarea se semnează pe acest telefon; abia după aceea aplicația începe să-i transmită tafului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Schválenie sa podpíše v tomto telefóne; aplikácia začne taf informovať až potom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobritev se podpiše v tem telefonu; aplikacija začne obveščati taf šele nato."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Miratimi nënshkruhet në këtë telefon; aplikacioni fillon t'i tregojë taf-it vetëm pas kësaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
