        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ didn't recognise you, so nothing was approved. The request is kept: approve again when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no te reconoció, así que no se aprobó nada. La solicitud se conserva: vuelve a aprobar cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne vous a pas reconnu : rien n'a été approuvé. La demande est conservée : approuvez à nouveau quand vous êtes prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non ti ha riconosciuto, quindi non è stato approvato nulla. La richiesta resta: approva di nuovo quando sei pronto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft je niet herkend, dus er is niets goedgekeurd. Het verzoek blijft bewaard: keur het goed wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Cię nie rozpoznało, więc nic nie zostało zatwierdzone. Prośba zostaje zachowana: zatwierdź ją ponownie, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento por %1$@ falhou, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        }
      }
    },
