        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი ჩატები არ ექსპორტირდა. შეამოწმეთ კავშირი და სცადეთ ხელახლა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការសន្ទនារបស់អ្នកមិនត្រូវបាននាំចេញទេ។ ពិនិត្យការតភ្ជាប់របស់អ្នក រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅을 내보내지 못했습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ໄດ້ສົ່ງອອກການສົນທະນາຂອງທ່ານ. ກວດການເຊື່ອມຕໍ່ຂອງທ່ານ ແລ້ວລອງໃໝ່."
          }
