        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Verspätete Pakete“ lief um 07:00 nicht: Die Anmeldung beim Versanddienst braucht dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Late parcels didn't run at 07:00: its carrier sign-in needs you."
          }
