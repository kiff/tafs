    "needs_you.check_code": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من أن KIFF يعرض الرمز نفسه، ووافق فقط وهذا الهاتف في يدك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-in eyni kodu göstərdiyini yoxlayın və yalnız bu telefon əlinizdə olanda təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверете дали KIFF показва същия код и одобрявайте само ако държите този телефон в ръцете си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF একই কোড দেখাচ্ছে কিনা যাচাই করুন, এবং শুধু এই ফোন আপনার হাতে থাকলেই অনুমোদন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprova que KIFF mostri el mateix codi i aprova només amb aquest telèfon a les mans."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte, že KIFF ukazuje stejný kód, a schvalte jen s tímto telefonem v rukou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob KIFF denselben Code zeigt, und genehmige nur mit diesem Telefon in deinen Händen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that KIFF shows the same code, and approve only with this phone in your hands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que KIFF muestra el mismo código, y aprueba solo con este teléfono en tus manos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli, et KIFF näitab sama koodi, ja kinnita ainult siis, kui see telefon on sinu käes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que KIFF affiche le même code, et n'approuvez qu'avec ce téléphone en main."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לוודא ש-KIFF מציג את אותו קוד, ולאשר רק כשהטלפון הזה בידיים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँचें कि KIFF वही कोड दिखाता है, और केवल यह फ़ोन आपके हाथ में होने पर ही मंज़ूर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite prikazuje li KIFF isti kôd i odobravajte samo ako imate ovaj telefon u rukama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizd, hogy a KIFF ugyanazt a kódot mutatja, és csak akkor hagyd jóvá, ha ez a telefon a kezedben van."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ստուգեք, որ KIFF-ը ցույց է տալիս նույն կոդը, և հաստատեք միայն այս հեռախոսով, որ ձեր ձեռքում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan KIFF menampilkan kode yang sama, dan setujui hanya saat ponsel ini ada di tangan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che KIFF mostri lo stesso codice, e approva solo con questo telefono in mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFに同じコードが表示されていることを確認し、このスマートフォンを手元に持った状態でのみ承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეამოწმეთ, რომ KIFF იგივე კოდს აჩვენებს, და დაამტკიცეთ მხოლოდ ამ ტელეფონით, რომელიც ხელში გიჭირავთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពិនិត្យថា KIFF បង្ហាញលេខកូដដូចគ្នា ហើយអនុម័តតែនៅពេលអ្នកកាន់ទូរសព្ទនេះក្នុងដៃប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF에 같은 코드가 표시되는지 확인하고, 이 휴대폰을 손에 든 상태에서만 승인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກວດວ່າ KIFF ສະແດງລະຫັດດຽວກັນ ແລ້ວອະນຸມັດສະເພາະເມື່ອທ່ານຖືໂທລະສັບນີ້ຢູ່ໃນມື."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Patikrinkite, ar KIFF rodo tą patį kodą, ir tvirtinkite tik laikydami šį telefoną rankose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārbaudi, vai KIFF rāda to pašu kodu, un apstiprini tikai tad, ja šis tālrunis ir tavās rokās."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Провери дека KIFF го покажува истиот код и одобри само со овој телефон во рацете."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ижил кодыг харуулж байгааг шалгаад, зөвхөн энэ утсыг гартаа барьж байхдаа зөвшөөрнө үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ले उही कोड देखाएको जाँच्नुहोस्, र यो फोन आफ्नो हातमा हुँदा मात्र स्वीकृत गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of KIFF dezelfde code toont, en keur alleen goed met deze telefoon in je handen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy KIFF pokazuje ten sam kod, i zatwierdzaj tylko z tym telefonem w rękach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o KIFF mostra o mesmo código, e aprove apenas com este telefone nas suas mãos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o KIFF mostra o mesmo código, e aprove apenas com este telefone nas suas mãos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați că KIFF afișează același cod și aprobați doar dacă țineți acest telefon în mână."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte, že KIFF ukazuje rovnaký kód, a schváľte len s týmto telefónom v rukách."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverite, da KIFF prikazuje isto kodo, in odobrite samo s tem telefonom v rokah."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolloni që KIFF shfaq të njëjtin kod, dhe miratoni vetëm me këtë telefon në duar."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Proverite prikazuje li KIFF isti kôd i odobravajte samo ako imate ovaj telefon u rukama."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบว่า KIFF แสดงรหัสเดียวกัน และอนุมัติเฉพาะเมื่อโทรศัพท์เครื่องนี้อยู่ในมือคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-iň şol bir kody görkezýändigini barlaň, we diňe bu telefon eliňizde bolanda tassyklaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF'in aynı kodu gösterdiğinden emin olun ve yalnızca bu telefon elinizdeyken onaylayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیکھیں کہ KIFF وہی کوڈ دکھاتا ہے، اور صرف تب منظور کریں جب یہ فون آپ کے ہاتھ میں ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kiểm tra KIFF hiển thị cùng một mã, và chỉ phê duyệt khi điện thoại này đang trong tay bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認 KIFF 顯示相同的代碼，並且只在這部手機握在您手中時才核准。"
          }
        }
      }
    },
