        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոչինչ չհաստատվեց։ Հարցումը պահպանվել է․ հաստատեք նորից, երբ պատրաստ լինեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang disetujui. Permintaan tetap disimpan: setujui lagi saat Anda siap."
