        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মঙ্গলবার উত্তর দেওয়া হয়েছে · তাদের উত্তরের অপেক্ষায় · পরবর্তী যাচাই শুক্রবার"
          }
        },
        "ca": {
