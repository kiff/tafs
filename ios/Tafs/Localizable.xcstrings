    "approval.key_gone_approve_again": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fingerabdrücke haben sich geändert oder keiner wurde erkannt, daher kann dieses Telefon erst wieder genehmigen, wenn du es erneut in deinem Browser genehmigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your fingerprints changed, or none was recognized, so this phone can't approve until you approve it again in your browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus huellas cambiaron o no se reconoció ninguna, así que este teléfono no puede aprobar hasta que lo vuelvas a aprobar en tu navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos empreintes ont changé ou n'ont pas été reconnues : ce téléphone ne peut plus approuver tant que vous ne l'approuvez pas à nouveau dans votre navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue impronte sono cambiate, o nessuna è stata riconosciuta, quindi questo telefono non può approvare finché non lo approvi di nuovo nel browser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vingerafdrukken zijn gewijzigd of niet herkend, dus deze telefoon kan niet goedkeuren tot je hem opnieuw goedkeurt in je browser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odciski palców się zmieniły albo żaden nie został rozpoznany, więc ten telefon nie może zatwierdzać, dopóki nie zatwierdzisz go ponownie w przeglądarce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas impressões digitais mudaram, ou nenhuma foi reconhecida, por isso este telefone não pode aprovar até o aprovar novamente no seu navegador."
          }
        }
      }
    },
