    "sample.reply.paused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert. Es geht nichts mehr raus, bis du mir sagst, dass ich weitermachen soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused. Nothing more goes out until you tell me to carry on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa. No sale nada más hasta que me digas que continúe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause. Plus rien ne part tant que vous ne me dites pas de continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa. Non esce più nulla finché non mi dici di continuare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd. Er gaat niets meer uit tot je zegt dat ik verder moet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane. Nic więcej nie wyjdzie, dopóki nie powiesz mi, żebym kontynuował."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa. Nada mais sai até me dizer para continuar."
          }
        }
      }
    },
