        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "„არა“ Card-ს სივრცეს უბრუნებს. პასუხს სჭირდება: %1$@."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "«ទេ» ឱ្យកន្លែងត្រឡប់ទៅ Card វិញ។ ការឆ្លើយត្រូវការ %1$@។"
