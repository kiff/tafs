        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি অনেক সময় নিয়েছে। আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha trigat massa. Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvalo to příliš dlouho. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat zu lange gedauert. Versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That took too long. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha tardado demasiado. Inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See võttis liiga kaua aega. Proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela a pris trop de temps. Réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה לקח יותר מדי זמן. יש לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें बहुत देर लगी। फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To je trajalo predugo. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez túl sokáig tartott. Próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դա չափազանց երկար տևեց։ Փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu terlalu lama. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci è voluto troppo tempo. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間がかかりすぎました。もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამას ძალიან დიდხანს დასჭირდა. სცადეთ ხელახლა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នោះចំណាយពេលយូរពេក។ សូមព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 너무 오래 걸렸습니다. 다시 시도하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃຊ້ເວລາດົນເກີນໄປ. ລອງໃໝ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai užtruko per ilgai. Bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas aizņēma pārāk ilgu laiku. Mēģini vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тоа траеше предолго. Обиди се повторно."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэт удаан болсон. Дахин оролдоно уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "त्यसले धेरै समय लियो। फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat duurde te lang. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwało to zbyt długo. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Demorou demasiado. Tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Demorou demais. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A durat prea mult. Încercați din nou."
