    "settings.sign_out_of_kiff.body_device": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف هذا الجهاز (%1$@) عن العمل لحسابك حتى تسجّل الدخول مرة أخرى. وتواصل tafs لديك عملها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenidən daxil olana qədər bu %1$@ hesabınız üçün işləməyi dayandırır. Taf-larınız işləməyə davam edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този %1$@ спира да работи за акаунта ви, докато не влезете отново. Вашите tafs продължават да работят."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার সাইন ইন না করা পর্যন্ত এই %1$@ আপনার অ্যাকাউন্টের জন্য কাজ করা বন্ধ করে। আপনার taf কাজ চালিয়ে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest dispositiu (%1$@) deixa de funcionar per al teu compte fins que tornis a iniciar la sessió. Els teus taf continuen funcionant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení (%1$@) přestane pro váš účet fungovat, dokud se znovu nepřihlásíte. Vaše tafy dál pracují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses %1$@ funktioniert für dein Konto nicht mehr, bis du dich erneut anmeldest. Deine tafs arbeiten weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ stops working for your account until you sign in again. Your tafs keep working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ deja de funcionar para tu cuenta hasta que vuelvas a iniciar sesión. Tus tafs siguen funcionando."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See %1$@ ei tööta sinu konto jaoks enne, kui uuesti sisse logid. Sinu tafid töötavad edasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ cesse de fonctionner pour votre compte jusqu'à ce que vous vous reconnectiez. Vos tafs continuent de travailler."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתקן הזה (%1$@) מפסיק לעבוד עבור החשבון שלך עד שתיכנס שוב. ה-taf שלך ממשיכים לעבוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह %1$@ फिर साइन इन करने तक आपके खाते के लिए काम करना बंद कर देता है। आपके taf काम करते रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj (%1$@) prestaje raditi za vaš račun dok se ponovno ne prijavite. Vaši tafovi nastavljaju raditi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz (%1$@) nem működik a fiókodhoz, amíg újra be nem jelentkezel. A tafjaid tovább dolgoznak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքը (%1$@) դադարում է աշխատել ձեր հաշվի համար, մինչև նորից մուտք չգործեք։ Ձեր taf-երը շարունակում են աշխատել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ini berhenti berfungsi untuk akun Anda sampai Anda masuk lagi. tafs Anda tetap bekerja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo %1$@ smette di funzionare per il tuo account finché non accedi di nuovo. I tuoi tafs continuano a lavorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度サインインするまで、この%1$@はあなたのアカウントで使えなくなります。tafsは動き続けます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოწყობილობა (%1$@) თქვენი ანგარიშისთვის მუშაობას წყვეტს, სანამ ხელახლა არ შეხვალთ. თქვენი taf-ები აგრძელებენ მუშაობას."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ នេះឈប់ធ្វើការសម្រាប់គណនីរបស់អ្នក រហូតដល់អ្នកចូលម្តងទៀត។ taf របស់អ្នកបន្តធ្វើការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 로그인할 때까지 이 %1$@에서는 계정을 사용할 수 없습니다. tafs는 계속 작동합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ນີ້ເຊົາເຮັດວຽກສຳລັບບັນຊີຂອງທ່ານຈົນກວ່າທ່ານຈະເຂົ້າສູ່ລະບົບອີກ. taf ຂອງທ່ານເຮັດວຽກຕໍ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis įrenginys (%1$@) nustos veikti jūsų paskyrai, kol vėl prisijungsite. Jūsų taf dirbs toliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis %1$@ pārstāj darboties tavam kontam, līdz tu atkal pierakstīsies. Tavi taf turpina strādāt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој %1$@ престанува да работи за твојата сметка додека не се најавиш повторно. Твоите tafови продолжуваат да работат."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ %1$@ дахин нэвтрэх хүртэл таны бүртгэлд ажиллахаа болино. Таны taf-ууд ажиллсаар байна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले फेरि साइन इन नगरेसम्म यो %1$@ तपाईंको खाताका लागि काम गर्न छोड्छ। तपाईंका taf काम गरिरहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %1$@ werkt niet meer voor je account tot je opnieuw inlogt. Je tafs blijven werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten %1$@ przestanie działać dla Twojego konta, dopóki nie zalogujesz się ponownie. Twoje tafs będą działać dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ deixa de funcionar para a sua conta até iniciar sessão novamente. Os seus tafs continuam a trabalhar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ deixa de funcionar para a sua conta até entrar novamente. Os seus tafs continuam trabalhando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv (%1$@) nu mai funcționează pentru contul dvs. până vă conectați din nou. Tafurile dvs. continuă să lucreze."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zariadenie (%1$@) prestane pre váš účet fungovať, kým sa znova neprihlásite. Vaše tafy ďalej pracujú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta naprava (%1$@) preneha delovati za vaš račun, dokler se znova ne prijavite. Vaši tafi še naprej delajo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo pajisje (%1$@) pushon së punuari për llogarinë tuaj derisa të hyni sërish. Tafs-et tuaj vazhdojnë të punojnë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj (%1$@) prestaje raditi za vaš nalog dok se ponovo ne prijavite. Vaši tafovi nastavljaju raditi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@เครื่องนี้จะหยุดทำงานกับบัญชีของคุณจนกว่าคุณจะเข้าสู่ระบบอีกครั้ง taf ของคุณยังทำงานต่อ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ täzeden girýänçäňiz hasabyňyz üçin işlemeýär. Tafs-laryňyz işlemegini dowam etdirýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@, tekrar oturum açana kadar hesabınız için çalışmayı bırakır. tafs'larınız çalışmaya devam eder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ دوبارہ سائن اِن نہ کریں یہ %1$@ آپ کے اکاؤنٹ کے لیے کام کرنا بند کر دیتا ہے۔ آپ کے tafs کام کرتے رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ này ngừng hoạt động với tài khoản của bạn cho đến khi bạn đăng nhập lại. Các taf của bạn vẫn tiếp tục làm việc."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您重新登入之前，這部%1$@將無法用於您的帳號。您的 taf 會繼續運作。"
          }
        }
      }
    },
