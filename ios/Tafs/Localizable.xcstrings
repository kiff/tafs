      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon hələ də təsdiq edə bilmir. Yenidən cəhd edin və ya Parametrlərdə yenidən daxil olun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този телефон все още не може да одобрява. Опитайте отново или влезте отново от Настройки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento telefon pořád nemůže schvalovat. Zkuste to znovu, nebo se znovu přihlaste v Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon kann immer noch nicht genehmigen. Versuch es erneut oder melde dich in den Einstellungen erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone still can't approve. Try again, or sign in again in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono sigue sin poder aprobar. Vuelve a intentarlo, o vuelve a iniciar sesión en Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See telefon ei saa ikka veel kinnitada. Proovi uuesti või logi seadetes uuesti sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone ne peut toujours pas approuver. Réessayez, ou reconnectez-vous dans Réglages."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon i dalje ne može odobravati. Pokušajte ponovno ili se ponovno prijavite u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a telefon még mindig nem tud jóváhagyni. Próbáld újra, vagy jelentkezz be újra a Beállításokban."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հեռախոսը դեռ չի կարող հաստատել։ Փորձեք նորից, կամ նորից մուտք գործեք Կարգավորումներում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini masih tidak dapat menyetujui. Coba lagi, atau masuk lagi di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non può ancora approvare. Riprova, o accedi di nuovo in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンはまだ承認できません。もう一度試すか、設定からもう一度サインインしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ტელეფონს მაინც არ შეუძლია დამტკიცება. სცადეთ ხელახლა, ან კვლავ შედით პარამეტრებში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰은 아직 승인할 수 없습니다. 다시 시도하거나, 설정에서 다시 로그인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis telefonas vis dar negali tvirtinti. Bandykite dar kartą arba vėl prisijunkite nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis tālrunis joprojām nevar apstiprināt. Mēģini vēlreiz vai vēlreiz pieraksties iestatījumos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon kan nog steeds niet goedkeuren. Probeer het opnieuw, of log opnieuw in via Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon nadal nie może zatwierdzać. Spróbuj ponownie albo zaloguj się ponownie w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone continua sem poder aprovar. Tente novamente, ou inicie sessão novamente nas Definições."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone continua sem poder aprovar. Tente novamente, ou entre novamente em Conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest telefon tot nu poate aproba. Încercați din nou sau conectați-vă din nou din Setări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento telefón stále nemôže schvaľovať. Skúste to znova, alebo sa znova prihláste v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta telefon še vedno ne more odobravati. Poskusite znova ali se znova prijavite v Nastavitvah."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky telefon ende nuk mund të miratojë. Provoni sërish, ose hyni sërish te Cilësimet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon i dalje ne može odobravati. Pokušajte ponovo ili se ponovo prijavite u Podešavanjima."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์เครื่องนี้ยังอนุมัติไม่ได้ ลองอีกครั้ง หรือเข้าสู่ระบบอีกครั้งในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon hâlâ onay veremiyor. Tekrar deneyin veya Ayarlar'dan tekrar oturum açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại này vẫn chưa thể phê duyệt. Hãy thử lại, hoặc đăng nhập lại trong Cài đặt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部手機仍無法核准。請再試一次，或在「設定」中重新登入。"
          }
        }
      }
    },
