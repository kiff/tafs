            "state": "translated",
            "value": "Alles nu stilzetten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokuj wszystko teraz"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear tudo agora"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear tudo agora"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opriți tot acum"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaviť všetko hneď"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Takoj ustavi vse"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bllokoni të gjithë tani"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokirajte sve odmah"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระงับทั้งหมดทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepsini şimdi dondur"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng băng tất cả ngay"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即全部凍結"
          }
        }
      }
    },
    "halt.explain.halted": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Donduruldu. Davam etdirmə yalnız yeni işə başlayır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спряно. Възобновяването стартира само нова работа."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaveno. Obnovení spustí jen novou práci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angehalten. Fortsetzen startet nur neue Arbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halted. Resuming starts only new work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. Al reanudar, solo empieza trabajo nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peatatud. Jätkamisel algab ainult uus töö."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqué. La reprise ne lance que du nouveau travail."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokirano. Nastavak pokreće samo novi rad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leállítva. A folytatás csak új munkát indít."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանգնեցված է։ Վերսկսումը սկսում է միայն նոր աշխատանք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibekukan. Melanjutkan hanya memulai pekerjaan baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccato. Riprendendo, parte solo lavoro nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮断済みです。再開すると新しい作業だけが始まります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაჩერებულია. განახლება მხოლოდ ახალ სამუშაოს იწყებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단됨. 재개하면 새 작업만 시작됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustabdyta. Tęsiant pradedamas tik naujas darbas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apturēts. Turpinot sākas tikai jauns darbs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilgezet. Hervatten start alleen nieuw werk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowane. Wznowienie uruchamia tylko nową pracę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. Ao retomar, só começa trabalho novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. Ao retomar, só começa trabalho novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprit. Reluarea pornește doar lucru nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavené. Obnovenie spustí len novú prácu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustavljeno. Nadaljevanje zažene samo novo delo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "I bllokuar. Rinisja nis vetëm punë të re."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokirano. Nastavak pokreće samo novi rad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระงับอยู่ การทำต่อจะเริ่มเฉพาะงานใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donduruldu. Devam ettirmek yalnızca yeni işi başlatır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đóng băng. Tiếp tục chỉ bắt đầu công việc mới."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已凍結。繼續後只會啟動新的工作。"
          }
        }
      }
    },
