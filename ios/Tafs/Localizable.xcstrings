    "usage.solo_terms": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pro %2$@. Verlängert sich nach jedem Abrechnungszeitraum (%2$@), bis du kündigst. Kündige jederzeit unter den Abonnements von Google Play, spätestens einen Tag vor der Verlängerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a %2$@. Renews every %2$@ until cancelled. Cancel any time in Google Play's subscriptions, at least a day before it renews."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ por %2$@. Se renueva cada %2$@ hasta que se cancele. Cancela cuando quieras en las suscripciones de Google Play, al menos un día antes de la renovación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ par %2$@. Se renouvelle chaque %2$@ jusqu'à résiliation. Résiliez à tout moment dans les abonnements Google Play, au moins un jour avant le renouvellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@/%2$@. Si rinnova ogni %2$@ finché non viene annullato. Annulla quando vuoi negli abbonamenti di Google Play, almeno un giorno prima del rinnovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ per %2$@. Wordt elke %2$@ verlengd tot je opzegt. Je kunt altijd opzeggen in de abonnementen van Google Play, minstens een dag voor de verlenging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@. Odnawia się co %2$@, dopóki nie anulujesz. Anuluj w dowolnym momencie w subskrypcjach Google Play, co najmniej dzień przed odnowieniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ por %2$@. Renova-se a cada %2$@ até ser cancelado. Cancele quando quiser nas subscrições do Google Play, pelo menos um dia antes da renovação."
          }
        }
      }
    },
    "usage.solo_terms_trial": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kostenlos, dann %2$@ pro %3$@. Verlängert sich nach jedem Abrechnungszeitraum (%3$@), bis du kündigst. Kündige jederzeit unter den Abonnements von Google Play, spätestens einen Tag vor der Verlängerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free for %1$@, then %2$@ a %3$@. Renews every %3$@ until cancelled. Cancel any time in Google Play's subscriptions, at least a day before it renews."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis durante %1$@, luego %2$@ por %3$@. Se renueva cada %3$@ hasta que se cancele. Cancela cuando quieras en las suscripciones de Google Play, al menos un día antes de la renovación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pendant %1$@, puis %2$@ par %3$@. Se renouvelle chaque %3$@ jusqu'à résiliation. Résiliez à tout moment dans les abonnements Google Play, au moins un jour avant le renouvellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per %1$@, poi %2$@/%3$@. Si rinnova ogni %3$@ finché non viene annullato. Annulla quando vuoi negli abbonamenti di Google Play, almeno un giorno prima del rinnovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis gedurende %1$@, daarna %2$@ per %3$@. Wordt elke %3$@ verlengd tot je opzegt. Je kunt altijd opzeggen in de abonnementen van Google Play, minstens een dag voor de verlenging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpłatnie przez %1$@, potem %2$@ / %3$@. Odnawia się co %3$@, dopóki nie anulujesz. Anuluj w dowolnym momencie w subskrypcjach Google Play, co najmniej dzień przed odnowieniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis durante %1$@, depois %2$@ por %3$@. Renova-se a cada %3$@ até ser cancelado. Cancele quando quiser nas subscrições do Google Play, pelo menos um dia antes da renovação."
          }
        }
      }
    },
