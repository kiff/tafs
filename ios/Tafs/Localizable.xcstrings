        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul KIFF pentru această conexiune nu se verifică (%1$@). Nu s-a aprobat nimic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slová KIFF k tomuto pripojeniu nesedia (%1$@). Nič sa neschválilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besede KIFF za to povezavo se ne ujemajo (%1$@). Nič ni bilo odobreno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjalët e KIFF për këtë lidhje nuk dalin të sakta (%1$@). Asgjë nuk u miratua."
          }
        },
        "sr-Latn": {
