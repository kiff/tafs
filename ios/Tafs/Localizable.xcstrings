        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendus ei öelnud, millise tellimuse see lõi. Proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion n'a pas indiqué quel abonnement elle a créé. Réessayez."
