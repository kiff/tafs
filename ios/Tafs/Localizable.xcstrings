    "version.trial.cant_try": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تجربة النسخة %1$@ الآن. %2$@"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ versiyası indi sınana bilmir. %2$@"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия %1$@ не може да бъде пробвана сега. %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংস্করণ %1$@ এখন চেষ্টা করা যাচ্ছে না। %2$@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La versió %1$@ ara no es pot provar. %2$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzi %1$@ teď nelze vyzkoušet. %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ kann jetzt nicht getestet werden. %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ can't be tried now. %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión %1$@ no se puede probar ahora. %2$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiooni %1$@ ei saa praegu proovida. %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version %1$@ ne peut pas être essayée maintenant. %2$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לנסות כעת את גרסה %1$@. %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण %1$@ अभी आज़माया नहीं जा सकता। %2$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verziju %1$@ sada nije moguće isprobati. %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@. verzió most nem próbálható ki. %2$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տարբերակ %1$@-ը հիմա հնարավոր չէ փորձել։ %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi %1$@ tidak dapat dicoba sekarang. %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione %1$@ non può essere provata ora. %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン%1$@は現在試せません。%2$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერსია %1$@-ის ცდა ახლა შეუძლებელია. %2$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចសាកល្បងកំណែ %1$@ ឥឡូវនេះបានទេ។ %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 버전 %1$@을(를) 시험할 수 없습니다. %2$@"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເວີຊັນ %1$@ ທົດລອງດຽວນີ້ບໍ່ໄດ້. %2$@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ versijos dabar išbandyti negalima. %2$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiju %1$@ tagad nevar izmēģināt. %2$@"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Верзијата %1$@ сега не може да се пробува. %2$@"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-р хувилбарыг одоо туршиж болохгүй. %2$@"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण %1$@ अहिले प्रयास गर्न सकिँदैन। %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versie %1$@ kan nu niet worden uitgeprobeerd. %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersji %1$@ nie można teraz wypróbować. %2$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível experimentar a versão %1$@ agora. %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível experimentar a versão %1$@ agora. %2$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea %1$@ nu poate fi încercată acum. %2$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Verziu %1$@ teraz nemožno vyskúšať. %2$@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Različice %1$@ zdaj ni mogoče preizkusiti. %2$@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Versioni %1$@ nuk mund të provohet tani. %2$@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Verziju %1$@ sada nije moguće isprobati. %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ทดลองเวอร์ชัน %1$@ ไม่ได้ %2$@"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wersiýa häzir synanylyp bilinmeýär. %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. sürüm şu an denenemez. %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ورژن %1$@ ابھی آزمایا نہیں جا سکتا۔ %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chưa thể thử phiên bản %1$@. %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %1$@ 目前無法試用。%2$@"
