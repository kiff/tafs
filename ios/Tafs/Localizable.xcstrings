        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierakstīšanās %1$@ atgriezās bez apstiprinājuma koda. Nekas netika pievienots."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De login bij %1$@ kwam terug zonder bevestigingscode. Er is niets gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie w %1$@ wróciło bez kodu potwierdzenia. Nic nie zostało połączone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão em %1$@ voltou sem o código de confirmação. Nada foi ligado."
