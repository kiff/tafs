          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet hervat: het is niet bevestigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wznowiono: nie zostało potwierdzone."
          }
        },
        "pt": {
