    "watch.ask_needs_consent": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-dan soruşmazdan əvvəl telefonunuzda tafs-da süni intellektin istifadəsinə icazə verin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преди да питате tafs, разрешете използването на ИИ в tafs на телефона си."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než se zeptáte tafs, povolte v tafs v telefonu používání AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du tafs fragst, erlaube die KI-Nutzung in tafs auf deinem Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you ask tafs, allow AI use in tafs on your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de pedir algo a tafs, permite el uso de IA en tafs en tu teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Enne tafsilt küsimist luba telefonis tafsis tehisintellekti (AI) kasutamine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de demander à tafs, autorisez l'IA dans tafs sur votre téléphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prije nego što pitate tafs, dopustite upotrebu AI-ja u tafsu na telefonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mielőtt a tafst kérdezed, engedélyezd az MI használatát a tafsben a telefonodon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախքան tafs-ին հարցնելը, ձեր հեռախոսում tafs-ում թույլատրեք AI-ի օգտագործումը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelum bertanya ke tafs, izinkan penggunaan AI di tafs pada ponsel Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di chiedere a tafs, consenti l'uso dell'IA in tafs sul telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsに質問する前に、スマートフォンのtafsでAIの使用を許可してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სანამ tafs-ს ჰკითხავთ, თქვენს ტელეფონზე tafs-ში ჩართეთ AI-ის გამოყენება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs에 묻기 전에 휴대폰의 tafs에서 AI 사용을 허용하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš klausdami tafs, telefone leiskite tafs naudoti AI."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms jautā tafs, atļauj AI lietošanu tafs savā tālrunī."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta eerst AI-gebruik toe in tafs op je telefoon voordat je tafs iets vraagt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim zapytasz tafs, zezwól na użycie AI w tafs na telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de pedir ao tafs, autorize a utilização de IA no tafs no telemóvel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de pedir ao tafs, autorize o uso de IA no tafs no celular."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înainte să întrebați tafs, permiteți utilizarea AI în tafs pe telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kým sa opýtate tafs, povoľte v tafs v telefóne používanie AI."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preden vprašate tafs, v tafs v telefonu dovolite uporabo umetne inteligence."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Para se të pyesni tafs, lejoni përdorimin e AI në tafs në telefonin tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre nego šta pitate tafs, dozvolite upotrebu AI-ja u tafsu na telefonu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนถาม tafs ให้อนุญาตการใช้ AI ใน tafs บนโทรศัพท์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs'a sormadan önce telefonunuzdaki tafs'ta yapay zekâ kullanımına izin verin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi hỏi tafs, hãy cho phép dùng AI trong tafs trên điện thoại của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詢問 tafs 之前，請先在手機上的 tafs 中允許使用 AI。"
          }
        }
      }
    },
    "watch.ask_not_on": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatdan soruşmaq hələ aktiv deyil."
          }
