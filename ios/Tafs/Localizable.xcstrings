    "door.slack_bot_sees_no_channel": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرى روبوت Slack أي قناة بعد. ادعُه إلى واحدة في Slack ثم عُد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack botu hələ heç bir kanalı görmür. Onu Slack-da birinə dəvət edin, sonra qayıdın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ботът на Slack още не вижда нито един канал. Поканете го в канал в Slack и се върнете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack বট এখনও কোনো চ্যানেল দেখতে পায় না। Slack-এ একটিতে একে আমন্ত্রণ জানান, তারপর ফিরে আসুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El bot de Slack encara no veu cap canal. Convida'l a un a Slack i torna aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Slacku zatím nevidí žádný kanál. Pozvěte ho do nějakého ve Slacku a vraťte se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Slack-Bot sieht noch keinen Kanal. Lade ihn in Slack in einen ein und komm dann zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Slack bot sees no channel yet. Invite it to one in Slack, then come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bot de Slack aún no ve ningún canal. Invítalo a uno en Slack y vuelve."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Slacki bot ei näe veel ühtegi kanalit. Kutsu see Slackis mõnele kanalile ja tule tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bot Slack ne voit encore aucun canal. Invitez-le dans un canal dans Slack, puis revenez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בוט ה-Slack עדיין לא רואה אף ערוץ. יש להזמין אותו לאחד ב-Slack ולחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack बॉट को अभी कोई चैनल नहीं दिखता। उसे Slack में किसी में आमंत्रित करें, फिर लौट आएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack bot još ne vidi nijedan kanal. Pozovite ga u jedan u Slacku, pa se vratite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Slack-bot még egyetlen csatornát sem lát. Hívd meg egybe a Slackben, majd gyere vissza."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack բոտը դեռ ոչ մի ալիք չի տեսնում։ Հրավիրեք այն մեկին Slack-ում, ապա վերադարձեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Slack belum melihat saluran apa pun. Undang ke satu saluran di Slack, lalu kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bot Slack non vede ancora nessun canale. Invitalo in uno da Slack, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Slackボットにはまだチャンネルが見えません。Slackでチャンネルに招待してから戻ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack-ის ბოტი ჯერ არც ერთ არხს ვერ ხედავს. მოიწვიეთ ის ერთში Slack-ში, შემდეგ დაბრუნდით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បុត Slack មិនទាន់ឃើញឆានែលណាមួយទេ។ អញ្ជើញវាចូលមួយក្នុង Slack រួចត្រឡប់មកវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
