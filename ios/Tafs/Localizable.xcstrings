    "settings.devices.passkey_remove_last": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا مفتاح المرور الوحيد لديك القادر على الموافقة. بدونه تحتاج إلى جهاز آخر يستطيع الموافقة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, təsdiq edə bilən yeganə giriş açarınızdır. Onsuz təsdiq edə bilən başqa cihaz lazımdır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е единственият ви ключ за достъп, който може да одобрява. Без него ви трябва друго устройство, което може да одобрява."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনার একমাত্র পাসকি যা অনুমোদন করতে পারে। এটি ছাড়া অনুমোদন করতে পারে এমন আরেকটি ডিভাইস দরকার।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta és l'única clau d'accés teva que pot aprovar. Sense ella, necessites un altre dispositiu que pugui aprovar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle je váš jediný přístupový klíč, který může schvalovat. Bez něj potřebujete jiné zařízení, které může schvalovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein einziger Passkey, der genehmigen kann. Ohne ihn brauchst du ein anderes Gerät, das genehmigen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your only passkey that can approve. Without it, you need another device that can approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es tu única llave de acceso que puede aprobar. Sin ella, necesitas otro dispositivo que pueda aprobar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on sinu ainus pääsuvõti, mis saab kinnitada. Ilma selleta vajad teist seadet, mis saab kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est votre seule clé d'accès qui peut approuver. Sans elle, il vous faut un autre appareil qui peut approuver."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מפתח הגישה היחיד שלך שיכול לאשר. בלעדיו תצטרך התקן אחר שיכול לאשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपकी इकलौती passkey है जो मंज़ूर कर सकती है। इसके बिना आपको मंज़ूर कर सकने वाला कोई और डिवाइस चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je vaš jedini pristupni ključ koji može odobravati. Bez njega trebate drugi uređaj koji može odobravati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az egyetlen jelkulcsod, amely jóváhagyhat. Nélküle egy másik, jóváhagyásra képes eszközre lesz szükséged."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա ձեր միակ մուտքի բանալին է, որը կարող է հաստատել։ Առանց դրա ձեզ պետք է մեկ այլ սարք, որը կարող է հաստատել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini satu-satunya kunci sandi Anda yang dapat menyetujui. Tanpanya, Anda memerlukan perangkat lain yang dapat menyetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È la tua unica passkey che può approvare. Senza di essa, ti serve un altro dispositivo che può approvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは承認に使える唯一のパスキーです。これがないと、承認できる別のデバイスが必要になります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს თქვენი ერთადერთი პასკია, რომელსაც დამტკიცება შეუძლია. მის გარეშე გჭირდებათ სხვა მოწყობილობა, რომელსაც დამტკიცება შეუძლია."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នេះជា passkey តែមួយគត់របស់អ្នកដែលអាចអនុម័តបាន។ បើគ្មានវា អ្នកត្រូវការឧបករណ៍ផ្សេងដែលអាចអនុម័តបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인할 수 있는 유일한 패스키입니다. 삭제하면 승인할 수 있는 다른 기기가 필요합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ນີ້ແມ່ນ passkey ດຽວຂອງທ່ານທີ່ອະນຸມັດໄດ້. ຖ້າບໍ່ມີມັນ ທ່ານຕ້ອງມີອຸປະກອນອື່ນທີ່ອະນຸມັດໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai vienintelis jūsų prieigos raktas, kuriuo galima tvirtinti. Be jo jums reikės kito įrenginio, kuris gali tvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī ir tava vienīgā piekļuves atslēga, kas var apstiprināt. Bez tās tev vajadzēs citu ierīci, kas var apstiprināt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова е твојот единствен клуч за пристап што може да одобрува. Без него ти треба друг уред што може да одобрува."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ нь таны зөвшөөрч чадах цорын ганц нэвтрэх түлхүүр. Үүнгүйгээр зөвшөөрч чадах өөр төхөөрөмж хэрэгтэй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो स्वीकृत गर्न सक्ने तपाईंको एक मात्र पासकी हो। यसविना स्वीकृत गर्न सक्ने अर्को उपकरण चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is je enige passkey die kan goedkeuren. Zonder deze heb je een ander apparaat nodig dat kan goedkeuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To Twój jedyny klucz dostępu, który może zatwierdzać. Bez niego potrzebujesz innego urządzenia, które może zatwierdzać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É a sua única chave de acesso que pode aprovar. Sem ela, precisa de outro dispositivo que possa aprovar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É a sua única chave de acesso que pode aprovar. Sem ela, precisa de outro dispositivo que possa aprovar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta este singura cheie de acces care poate aproba. Fără ea, aveți nevoie de alt dispozitiv care poate aproba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je váš jediný prístupový kľúč, ktorý môže schvaľovať. Bez neho potrebujete iné zariadenie, ktoré môže schvaľovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je vaš edini ključ za dostop, ki lahko odobrava. Brez njega potrebujete drugo napravo, ki lahko odobrava."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky është çelësi juaj i vetëm i kalimit që mund të miratojë. Pa të, ju duhet një pajisje tjetër që mund të miratojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je vaš jedini pristupni ključ koji može odobravati. Bez njega trebate drugi uređaj koji može odobravati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือพาสคีย์เดียวของคุณที่อนุมัติได้ หากไม่มี คุณต้องใช้อุปกรณ์อื่นที่อนุมัติได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tassyklap biljek ýeke-täk passkey-iňiz. Onsuz, tassyklap biljek başga enjam gerek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, onay verebilen tek geçiş anahtarınız. Onsuz, onay verebilen başka bir cihaza ihtiyacınız olur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آپ کی واحد پاس کی ہے جو منظور کر سکتی ہے۔ اس کے بغیر آپ کو منظور کرنے والی کوئی اور ڈیوائس چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là khóa truy cập duy nhất của bạn có thể phê duyệt. Nếu không có nó, bạn cần một thiết bị khác có thể phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
