    "connect.kiff_words_connection_could_not": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة كلمات KIFF لهذا الاتصال. لم تتم الموافقة على شيء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-in bu qoşulma üçün sözləri oxuna bilmədi. Heç nə təsdiqlənmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстът на KIFF за тази връзка не можа да бъде прочетен. Нищо не беше одобрено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সংযোগের জন্য KIFF-এর কথা পড়া যায়নি। কিছু অনুমোদিত হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'han pogut llegir les paraules de KIFF per a aquesta connexió. No s'ha aprovat res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slova KIFF k tomuto připojení se nepodařilo načíst. Nic se neschválilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFs Worte zu dieser Verbindung konnten nicht gelesen werden. Es wurde nichts genehmigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF's words for this connection couldn't be read. Nothing was approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer las palabras de KIFF para esta conexión. No se aprobó nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFi sõnu selle ühenduse kohta ei õnnestunud lugeda. Midagi ei kinnitatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les textes de KIFF pour cette connexion n'ont pas pu être lus. Rien n'a été approuvé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא את המילים של KIFF לחיבור הזה. שום דבר לא אושר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कनेक्शन के लिए KIFF के शब्द पढ़े नहीं जा सके। कुछ मंज़ूर नहीं हुआ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ove riječi za ovu vezu nije bilo moguće pročitati. Ništa nije odobreno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF szövegét ehhez a kapcsolathoz nem sikerült beolvasni. Semmi sem lett jóváhagyva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ի բառերը այս կապի համար չկարողացան կարդացվել։ Ոչինչ չհաստատվեց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata KIFF untuk koneksi ini tidak dapat dibaca. Tidak ada yang disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere le parole di KIFF per questo collegamento. Non è stato approvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続に関するKIFFの説明を読み込めませんでした。何も承認されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ის სიტყვები ამ კავშირისთვის ვერ წაიკითხა. არაფერი დამტკიცებულა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចអានពាក្យរបស់ KIFF សម្រាប់ការតភ្ជាប់នេះបានទេ។ គ្មានអ្វីត្រូវបានអនុម័តទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에 대한 KIFF의 설명을 읽지 못했습니다. 승인된 것은 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອ່ານຄຳເວົ້າຂອງ KIFF ສຳລັບການເຊື່ອມຕໍ່ນີ້ບໍ່ໄດ້. ບໍ່ມີຫຍັງຖືກອະນຸມັດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko nuskaityti KIFF formuluotės šiam ryšiui. Niekas nepatvirtinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF formulējumu šim savienojumam nevarēja nolasīt. Nekas netika apstiprināts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зборовите на KIFF за оваа врска не можеа да се прочитаат. Ништо не е одобрено."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ холболтод зориулсан KIFF-ийн үгсийг уншиж чадсангүй. Юу ч зөвшөөрөгдсөнгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो जडानका लागि KIFF का शब्द पढ्न सकिएन। केही स्वीकृत भएन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woorden van KIFF voor deze koppeling konden niet worden gelezen. Er is niets goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać opisu KIFF dla tego połączenia. Nic nie zostało zatwierdzone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
