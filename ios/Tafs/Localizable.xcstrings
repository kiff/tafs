          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ მოწყობილობას (%1$@) არ აქვს პაროლი, ხოლო %2$@-ს ის სჭირდება. დააყენეთ პაროლი აქ: %3$@, შემდეგ დაამატეთ: %4$@, შემდეგ დაბრუნდით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ នេះគ្មានលេខសម្ងាត់ទេ ហើយ %2$@ ត្រូវការមួយ។ កំណត់លេខសម្ងាត់ក្នុង %3$@ បន្ទាប់មកបន្ថែម %4$@ រួចត្រឡប់មកវិញ។"
