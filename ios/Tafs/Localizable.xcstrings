    "approval.new_fingerprint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügst du später einen weiteren Fingerabdruck hinzu, kann dieses Telefon nicht mehr genehmigen, bis du es erneut genehmigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you add another fingerprint later, approving on this phone stops until you approve it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si más adelante añades otra huella, aprobar en este teléfono deja de funcionar hasta que lo vuelvas a aprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous ajoutez plus tard une autre empreinte, l'approbation sur ce téléphone s'arrête jusqu'à ce que vous l'approuviez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se in seguito aggiungi un'altra impronta, le approvazioni su questo telefono si fermano finché non lo approvi di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg je later nog een vingerafdruk toe, dan stopt goedkeuren op deze telefoon tot je hem opnieuw goedkeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli później dodasz kolejny odcisk palca, zatwierdzanie na tym telefonie przestanie działać, dopóki nie zatwierdzisz go ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se adicionar outra impressão digital mais tarde, as aprovações neste telefone param até o aprovar novamente."
          }
        }
      }
    },
