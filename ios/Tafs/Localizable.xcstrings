    "sign_in.ios_did_not_open_sign": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS giriş səhifəsini açmadı (xəta %1$@; %2$@). tafs açıq olanda yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS не отвори страницата за вход (грешка %1$@; %2$@). Опитайте отново с отворен tafs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS neotevřel přihlašovací stránku (chyba %1$@; %2$@). Zkuste to znovu s otevřeným tafs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat die Anmeldeseite nicht geöffnet (Fehler %1$@; %2$@). Versuch es erneut, während tafs geöffnet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS didn't open the sign-in page (error %1$@; %2$@). Try again with tafs open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no abrió la página de inicio de sesión (error %1$@; %2$@). Vuelve a intentarlo con tafs abierto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ei avanud sisselogimislehte (viga %1$@; %2$@). Proovi uuesti, kui tafs on avatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n'a pas ouvert la page de connexion (erreur %1$@ ; %2$@). Réessayez avec tafs ouvert."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS nije otvorio stranicu za prijavu (pogreška %1$@; %2$@). Pokušajte ponovno dok je tafs otvoren."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iOS nem nyitotta meg a bejelentkezési oldalt (hiba: %1$@; %2$@). Próbáld újra megnyitott tafs mellett."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-ը չբացեց մուտքի էջը (սխալ %1$@․ %2$@)։ Փորձեք նորից՝ tafs-ը բաց թողնելով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS tidak membuka halaman masuk (galat %1$@; %2$@). Coba lagi dengan tafs terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non ha aperto la pagina di accesso (errore %1$@; %2$@). Riprova con tafs aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSがサインインページを開きませんでした（エラー %1$@、%2$@）。tafsを開いた状態でもう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-მა შესვლის გვერდი არ გახსნა (შეცდომა %1$@; %2$@). სცადეთ ხელახლა ღია tafs-ით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 로그인 페이지를 열지 못했습니다(오류 %1$@; %2$@). tafs를 연 상태에서 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS neatidarė prisijungimo puslapio (klaida %1$@; %2$@). Bandykite dar kartą, kai tafs atidaryta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS neatvēra pierakstīšanās lapu (kļūda %1$@; %2$@). Mēģini vēlreiz, kad tafs ir atvērts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS heeft de inlogpagina niet geopend (fout %1$@; %2$@). Probeer het opnieuw met tafs geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS nie otworzył strony logowania (błąd %1$@; %2$@). Spróbuj ponownie przy otwartym tafs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não abriu a página de início de sessão (erro %1$@; %2$@). Tente novamente com o tafs aberto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não abriu a página de login (erro %1$@; %2$@). Tente novamente com o tafs aberto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS nu a deschis pagina de conectare (eroarea %1$@; %2$@). Încercați din nou cu tafs deschis."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS neotvoril prihlasovaciu stránku (chyba %1$@; %2$@). Skúste to znova s otvoreným tafs."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ni odprl strani za prijavo (napaka %1$@; %2$@). Poskusite znova z odprtim tafs."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS nuk e hapi faqen e hyrjes (gabimi %1$@; %2$@). Provoni sërish me tafs të hapur."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS nije otvorio stranicu za prijavu (greška %1$@; %2$@). Pokušajte ponovo dok je tafs otvoren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ไม่ได้เปิดหน้าเข้าสู่ระบบ (ข้อผิดพลาด %1$@; %2$@) ลองอีกครั้งโดยเปิด tafs ไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS oturum açma sayfasını açmadı (hata %1$@; %2$@). tafs açıkken tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS không mở được trang đăng nhập (lỗi %1$@; %2$@). Hãy thử lại khi đang mở tafs."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未開啟登入頁面（錯誤 %1$@；%2$@）。請在開啟 tafs 的狀態下再試一次。"
          }
        }
      }
    },
    "sign_in.lead": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-larınız KIFF Card-ları altında fəaliyyət göstərir. Bu %1$@ KIFF-də təsdiq edin, verdiyiniz Card-lar burada görünəcək."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите tafs действат според Cards на KIFF. Одобрете този %1$@ в KIFF и издадените от вас Cards ще се появят тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy jednají podle Card od KIFF. Schvalte toto zařízení (%1$@) v KIFF a Card, které jste vydali, se zobrazí tady."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs handeln unter KIFF-Cards. Genehmige dieses %1$@ in KIFF, und die Cards, die du ausgestellt hast, erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tafs act under KIFF Cards. Approve this %1$@ in KIFF, and the Cards you issued show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tafs actúan con Cards de KIFF. Aprueba este %1$@ en KIFF y aquí aparecerán las Cards que emitiste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu tafid tegutsevad KIFF Cardide alusel. Kinnita see %1$@ KIFFis ja sinu väljastatud Cardid ilmuvad siia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tafs agissent sous des Cards KIFF. Approuvez %2$@ dans KIFF, et les Cards que vous avez émises s'affichent ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafovi djeluju pod KIFF Cardovima. Odobrite ovaj uređaj (%1$@) u KIFF-u i Cardovi koje ste izdali pojavit će se ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafjaid KIFF Cardok alapján működnek. Hagyd jóvá ezt az eszközt (%1$@) a KIFF-ben, és az általad kiadott Cardok itt jelennek meg."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր taf-երը գործում են KIFF Card-երի ներքո։ Հաստատեք այս սարքը (%1$@) KIFF-ում, և ձեր թողարկած Card-երը կերևան այստեղ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs Anda bertindak di bawah Card KIFF. Setujui %1$@ ini di KIFF, dan Card yang Anda terbitkan akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tafs agiscono con le Card di KIFF. Approva questo %1$@ in KIFF, e le Card che hai emesso compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのtafsはKIFFのCardのもとで動きます。KIFFでこの%1$@を承認すると、発行したCardがここに表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი taf-ები მოქმედებენ KIFF Card-ების ქვეშ. დაამტკიცეთ ეს მოწყობილობა (%1$@) KIFF-ში და თქვენ მიერ გაცემული Card-ები აქ გამოჩნდება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs는 KIFF Card에 따라 일합니다. KIFF에서 이 %1$@을(를) 승인하면 발급한 Card가 여기에 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų taf veikia pagal KIFF Card. Patvirtinkite šį įrenginį (%1$@) KIFF, ir jūsų išduotos Card bus rodomos čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavi taf darbojas KIFF Card ietvaros. Apstiprini šo ierīci (%1$@) KIFF, un šeit parādīsies tevis izsniegtās Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tafs handelen onder KIFF-Cards. Je kunt deze %1$@ goedkeuren in KIFF, waarna de Cards die je hebt uitgegeven hier verschijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje tafs działają w ramach Card KIFF. Zatwierdź to urządzenie (%1$@) w KIFF, a wydane przez Ciebie Card pojawią się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs agem ao abrigo de Cards do KIFF. Aprove este %1$@ no KIFF, e os Cards que emitiu aparecem aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus tafs agem ao abrigo de Cards do KIFF. Aprove este %1$@ no KIFF, e os Cards que emitiu aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafurile dvs. acționează pe baza Cardurilor KIFF. Aprobați acest dispozitiv (%1$@) în KIFF, iar Cardurile emise de dvs. apar aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tafy konajú podľa Card od KIFF. Schváľte toto zariadenie (%1$@) v KIFF a Card, ktoré ste vydali, sa zobrazia tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafi delujejo po Card od KIFF. Odobrite to napravo (%1$@) v KIFF in Card, ki ste jih izdali, se prikažejo tukaj."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs-et tuaj veprojnë nën Card-et e KIFF. Miratoni këtë pajisje (%1$@) në KIFF, dhe Card-et që keni lëshuar shfaqen këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši tafovi deluju pod KIFF Cardovima. Odobrite ovaj uređaj (%1$@) u KIFF-u i Cardovi koje ste izdali pojavit će se ovdje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "taf ของคุณทำงานภายใต้ Card ของ KIFF อนุมัติ%1$@เครื่องนี้ใน KIFF แล้ว Card ที่คุณออกไว้จะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs'larınız KIFF Card'ları altında çalışır. Bu %1$@ cihazını KIFF'te onaylayın, verdiğiniz Card'lar burada görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tafs của bạn hoạt động theo Card của KIFF. Hãy phê duyệt %1$@ này trong KIFF, và các Card bạn đã cấp sẽ hiện ở đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 taf 在 KIFF Card 之下運作。請在 KIFF 中核准這部%1$@，您發出的 Card 就會顯示在這裡。"
          }
        }
      }
    },
