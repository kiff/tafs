            "value": "%1$@ olduğu gibi çalışmaya devam eder. Bu sürümün yaptığı gerçektir, kendi Card'ı altında."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ جیسا ہے ویسا کام کرتا رہتا ہے۔ یہ ورژن جو کرتا ہے وہ حقیقی ہے، اس کے اپنے Card کے تحت۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tiếp tục làm việc như hiện tại. Những gì phiên bản này làm là thật, dưới Card riêng của nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 維持現狀繼續運作。此版本所做的事是真實的，在它自己的 Card 之下。"
