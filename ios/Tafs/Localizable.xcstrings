    "connect.one_taf": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bir taf üçün qoşulub, o isə onu Card-ının icazə verdiyi qədər istifadə edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ е свързано за един taf, който го използва, както позволява неговата Card."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je připojená pro jeden taf, který ji používá tak, jak dovoluje jeho Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist für einen taf verbunden, der sie nutzt, wie seine Card es erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is connected for one taf, which uses it as its Card allows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está conectado para un taf, que lo usa como permite su Card."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on ühendatud ühe tafi jaoks, mis kasutab seda nii, nagu selle Card lubab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est connecté pour un taf, qui l'utilise comme sa Card le permet."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija %1$@ povezana je za jedan taf, koji je koristi koliko mu Card dopušta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ egy tafhoz van csatlakoztatva, amely úgy használja, ahogy a Cardja engedi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը միացված է մեկ taf-ի համար, որն այն օգտագործում է այնպես, ինչպես թույլատրում է նրա Card-ը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ terhubung untuk satu taf, yang memakainya sebatas yang diizinkan Card-nya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è collegata per un taf, che la usa come consente la sua Card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は1つのtaf用に接続されており、そのtafはCardが許可する範囲で使います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ დაკავშირებულია ერთი taf-ისთვის, რომელიც მას იყენებს ისე, როგორც მისი Card უშვებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) taf 하나를 위해 연결되었고, 그 taf는 Card가 허용하는 대로 사용합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ prijungta vienam taf, kuris ją naudoja taip, kaip leidžia jo Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ir pievienota vienam taf, kas to izmanto tā, kā atļauj tā Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gekoppeld voor één taf, dat hem gebruikt zoals zijn Card toestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest połączona dla jednego tafa, który używa jej tak, jak pozwala jego Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está ligado para um taf, que o usa como o seu Card permite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está conectado para um taf, que o usa como o seu Card permite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ este conectat pentru un taf, care îl folosește cum îi permite Cardul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je pripojená pre jeden taf, ktorý ju používa tak, ako dovoľuje jeho Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je povezana za en taf, ki jo uporablja, kot dovoli njegova Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ është lidhur për një taf, që e përdor siç e lejon Card-i i tij."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija %1$@ povezana je za jedan taf, koji je koristi koliko mu Card dopušta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ เชื่อมต่อให้ taf หนึ่งตัว ซึ่งใช้ตามที่ Card ของมันอนุญาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bir taf için bağlandı; taf onu Card'ının izin verdiği ölçüde kullanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ được kết nối cho một taf, dùng nó trong phạm vi Card cho phép."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已為一個 taf 連接，該 taf 在其 Card 允許的範圍內使用它。"
          }
        }
      }
    },
