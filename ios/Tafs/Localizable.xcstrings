    "billing.another_account": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kauf gehört zu einem anderen tafs-Konto mit diesem Google-Konto, daher wurde hier nichts hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This purchase belongs to another tafs account on this Google account, so nothing was added here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compra pertenece a otra cuenta de tafs de esta cuenta de Google, así que no se añadió nada aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ost kuulub selle Google'i konto teisele tafsi kontole, seega siia ei lisatud midagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat appartient à un autre compte tafs sur ce compte Google : rien n'a été ajouté ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo acquisto appartiene a un altro account tafs su questo account Google, quindi qui non è stato aggiunto nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この購入はこのGoogleアカウントの別のtafsアカウントのものなので、ここには何も追加されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구매는 이 Google 계정의 다른 tafs 계정에 속하므로 여기에는 아무것도 추가되지 않았습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis pirkinys priklauso kitai tafs paskyrai šioje Google paskyroje, todėl čia nieko nepridėta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis pirkums pieder citam tafs kontam šajā Google kontā, tāpēc šeit nekas netika pievienots."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze aankoop hoort bij een ander tafs-account op dit Google-account, dus hier is niets toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten zakup należy do innego konta tafs na tym koncie Google, więc nic tu nie dodano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compra pertence a outra conta tafs nesta conta Google, por isso nada foi adicionado aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compra pertence a outra conta tafs nesta conta Google, por isso nada foi adicionado aqui."
          }
        }
      }
    },
