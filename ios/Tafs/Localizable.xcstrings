            "state": "translated",
            "value": "Textul KIFF pentru această conexiune nu a putut fi citit. Nu s-a aprobat nimic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slová KIFF k tomuto pripojeniu sa nepodarilo načítať. Nič sa neschválilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besed KIFF za to povezavo ni bilo mogoče prebrati. Nič ni bilo odobreno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjalët e KIFF për këtë lidhje nuk u lexuan dot. Asgjë nuk u miratua."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ove reči za ovu vezu nije bilo moguće pročitati. Ništa nije odobreno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านถ้อยคำของ KIFF สำหรับการเชื่อมต่อนี้ไม่ได้ ยังไม่ได้อนุมัติอะไร"
