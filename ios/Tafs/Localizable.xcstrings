    "coach.coach_mode_has_change_request": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على وضع Coach تغيير هذا الطلب قبل أن تتمكن من الموافقة عليه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz təsdiq etməzdən əvvəl Coach rejimi bu sorğunu dəyişməlidir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимът Coach трябва да промени тази заявка, преди да можете да я одобрите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অনুমোদন করার আগে Coach মোডকে এই অনুরোধ বদলাতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El mode Coach ha de canviar aquesta sol·licitud abans que la puguis aprovar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Režim Coach musí tuto žádost změnit, než ji budete moci schválit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach-Modus muss diese Anfrage ändern, bevor du sie genehmigen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach mode has to change this request before you can approve it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo Coach tiene que cambiar esta solicitud antes de que puedas aprobarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Coachi režiim peab seda päringut muutma, enne kui saad selle kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode Coach doit modifier cette demande avant que vous puissiez l'approuver."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב Coach צריך לשנות את הבקשה הזו לפני שתוכל לאשר אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मंज़ूर करने से पहले Coach मोड को यह अनुरोध बदलना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Način rada Coach mora promijeniti ovaj zahtjev prije nego što ga možete odobriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Coach módnak módosítania kell ezt a kérést, mielőtt jóváhagyhatnád."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-ի ռեժիմը պետք է փոխի այս հարցումը, նախքան այն հաստատելը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode Coach harus mengubah permintaan ini sebelum Anda dapat menyetujuinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità Coach deve modificare questa richiesta prima che tu possa approvarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認する前に、Coachモードでこのリクエストを変更する必要があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-ის რეჟიმმა ეს მოთხოვნა უნდა შეცვალოს, სანამ დაამტკიცებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "របៀប Coach ត្រូវផ្លាស់ប្តូរសំណើនេះ មុនពេលអ្នកអាចអនុម័តវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하기 전에 Coach 모드에서 이 요청을 바꿔야 합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂໝດ Coach ຕ້ອງປ່ຽນຄຳຂໍນີ້ກ່ອນທ່ານອະນຸມັດໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach režimas turi pakeisti šią užklausą, kad galėtumėte ją patvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach režīmam jāmaina šis pieprasījums, pirms tu to vari apstiprināt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимот Coach мора да го промени ова барање пред да можеш да го одобриш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та зөвшөөрөхөөс өмнө Coach горим энэ хүсэлтийг өөрчлөх ёстой."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले स्वीकृत गर्नुअघि Coach मोडले यो अनुरोध परिवर्तन गर्नुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Coach-modus moet dit verzoek aanpassen voordat je het kunt goedkeuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb Coach musi zmienić tę prośbę, zanim będzie można ją zatwierdzić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo Coach tem de alterar este pedido antes de o poder aprovar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo Coach precisa alterar este pedido antes que você possa aprová-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul Coach trebuie să schimbe această solicitare înainte să o puteți aproba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Režim Coach musí túto žiadosť zmeniť, kým ju budete môcť schváliť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Način Coach mora to zahtevo spremeniti, preden jo lahko odobrite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mënyra Coach duhet ta ndryshojë këtë kërkesë para se ta miratoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Način rada Coach mora promeniti ovaj zahtev pre nego šta ga možete odobriti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมด Coach ต้องเปลี่ยนคำขอนี้ก่อนที่คุณจะอนุมัติได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach rejimi tassyklamazdan öň bu haýyşy üýtgetmeli."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylayabilmeniz için Coach modunun bu isteği değiştirmesi gerekir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منظور کرنے سے پہلے Coach موڈ کو اس درخواست میں تبدیلی کرنی ہوگی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ Coach phải sửa yêu cầu này trước khi bạn có thể phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach 模式必須先變更此請求，您才能核准。"
          }
        }
      }
