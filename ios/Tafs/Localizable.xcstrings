    "version.while_you_try.chat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du chattest mit Version %1$@ in einem eigenen Fenster. Was sie tut, ist echt: Ihre Aufrufe laufen über KIFF unter der Card unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You chat with version %1$@ in its own window. What it does is real: its calls go through KIFF under the Card below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chateas con la versión %1$@ en su propia ventana. Lo que hace es real: sus llamadas pasan por KIFF con la Card de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous discutez avec la version %1$@ dans sa propre fenêtre. Ce qu'elle fait est réel : ses appels passent par KIFF sous la Card ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parli con la versione %1$@ nella sua finestra. Ciò che fa è reale: le sue chiamate passano da KIFF con la Card qui sotto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je chat met versie %1$@ in een eigen venster. Wat het doet, is echt: de aanroepen gaan via KIFF onder de Card hieronder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmawiasz z wersją %1$@ w jej własnym oknie. To, co robi, dzieje się naprawdę: jej wywołania przechodzą przez KIFF w ramach Card poniżej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversa com a versão %1$@ na sua própria janela. O que faz é real: as suas chamadas passam pelo KIFF ao abrigo do Card abaixo."
          }
        }
      }
    },
    "version.while_you_try.counts_from_zero": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Card des Tests zählt ab null, daher kann dein taf an einem Tag die Limits seiner Live-Card plus die dieser ausschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trial's Card counts from zero, so on a day your taf can spend its live Card's limits plus this one's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Card de la prueba cuenta desde cero, así que en un día tu taf puede gastar los límites de su Card activa más los de esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Card de l'essai compte à partir de zéro : sur une journée, votre taf peut donc dépenser les limites de sa Card en service plus celles de celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Card della prova conta da zero, quindi in un giorno il tuo taf può spendere i limiti della sua Card attiva più quelli di questa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Card van de proef telt vanaf nul, dus op een dag kan je taf de limieten van zijn live Card plus die van deze besteden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Card próby liczy od zera, więc jednego dnia Twój taf może wydać limity swojej Card na żywo plus limity tej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Card da experiência conta a partir de zero, por isso num dia o seu taf pode gastar os limites do Card em produção mais os deste."
          }
        }
      }
    },
    "version.while_you_try.ends": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er endet, wenn du sie installierst oder zurückkehrst, oder nach 7 ungenutzten Tagen. Sein Chat wird dann gelöscht, und unter „Versionen“ bleibt eine Zeile dazu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It ends when you install it or go back, or after 7 days unused. Its chat is then deleted, and Versions keeps one line about it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina cuando la instalas o vuelves atrás, o tras 7 días sin usarla. Entonces su chat se elimina, y Versiones conserva una línea sobre ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prend fin quand vous l'installez ou revenez en arrière, ou après 7 jours sans utilisation. Son chat est alors supprimé, et Versions en garde une ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina quando la installi o torni indietro, o dopo 7 giorni senza uso. La sua chat viene poi eliminata, e Versioni ne conserva una riga."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het eindigt als je het installeert of teruggaat, of na 7 dagen zonder gebruik. De chat wordt dan verwijderd, en Versies bewaart er één regel over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy się, gdy ją zainstalujesz lub wrócisz, albo po 7 dniach nieużywania. Jej czat zostanie wtedy usunięty, a w Wersjach zostanie o niej jeden wiersz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina quando a instalar ou voltar atrás, ou após 7 dias sem uso. O seu chat é então eliminado, e Versões guarda uma linha sobre ela."
          }
        }
      }
    },
    "version.while_you_try.live_keeps_working": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Version arbeitet weiter: Ihr Zeitplan, ihre Card und ihr Budget ändern sich nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live version keeps working: its schedule, Card and budget don't change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión activa sigue trabajando: su programación, su Card y su presupuesto no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version en service continue de travailler : son planning, sa Card et son budget ne changent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione attiva continua a lavorare: la sua pianificazione, la Card e il budget non cambiano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De live versie blijft werken: de planning, Card en het budget veranderen niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja działająca na żywo pracuje dalej: jej harmonogram, Card i budżet się nie zmieniają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão em produção continua a trabalhar: o seu agendamento, Card e orçamento não mudam."
          }
        }
      }
    },
