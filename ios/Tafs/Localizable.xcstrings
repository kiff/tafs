    "settings.delete_account.confirm_with": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bestätigst mit %1$@, bevor etwas gelöscht wird. Bist du anderswo angemeldet, wirst du dort ebenfalls abgemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You confirm with %1$@ before anything is deleted. Signed in elsewhere, you're signed out there too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmas con %1$@ antes de que se elimine nada. Si tienes la sesión iniciada en otro sitio, también se cerrará allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous confirmez avec %1$@ avant toute suppression. Si vous êtes connecté ailleurs, vous y serez aussi déconnecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermi con %1$@ prima che venga eliminato qualcosa. Se hai effettuato l'accesso altrove, vieni disconnesso anche lì."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bevestigt met %1$@ voordat er iets wordt verwijderd. Ben je ergens anders ingelogd, dan word je daar ook uitgelogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim cokolwiek zostanie usunięte, potwierdzisz to przez %1$@. Logowania na innych urządzeniach też zostaną zakończone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma com %1$@ antes de qualquer eliminação. Se tiver sessão iniciada noutro lado, a sessão também é terminada lá."
          }
        }
      }
    },
    "settings.delete_account.connections_left": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine tafs sind gelöscht, deine Verbindungen aber noch nicht. %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tafs are erased, but your connections aren't yet. %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
