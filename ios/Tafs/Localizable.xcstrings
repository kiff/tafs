            "state": "translated",
            "value": "Dodaj to urządzenie do konta. Tylko to urządzenie; nic innego się nie zmienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar este dispositivo à sua conta. Só este dispositivo; nada mais muda."
          }
        },
        "pt-BR": {
