    "taf.halt.halted_with_all": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün taf-larınızla birlikdə donduruldu. İşləməsi üçün hamısını davam etdirin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спряно заедно с всички ваши tafs. Възобновете ги всички, за да го пуснете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaveno se všemi vašimi tafy. Obnovte je všechny, aby mohl běžet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit allen deinen tafs angehalten. Setze alle fort, damit er läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halted with all your tafs. Resume them all to let it run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado junto con todos tus tafs. Reanuda todos para que funcione."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peatatud koos kõigi sinu tafidega. Et see töötaks, jätka need kõik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqué avec tous vos tafs. Reprenez-les tous pour le laisser s'exécuter."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiran zajedno sa svim vašim tafovima. Nastavite ih sve da ga pustite da radi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leállítva az összes tafoddal együtt. Folytasd mindet, hogy futhasson."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանգնեցված է ձեր բոլոր taf-երի հետ։ Վերսկսեք բոլորը, որ այն աշխատի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibekukan bersama semua tafs Anda. Lanjutkan semuanya agar ia berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccato insieme a tutti i tuoi tafs. Riprendili tutti per lasciarlo lavorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのtafとともに遮断されています。実行するには、すべてを再開してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაჩერებულია თქვენს ყველა taf-თან ერთად. განაახლეთ ყველა, რომ ის გაეშვას."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 tafs와 함께 차단되었습니다. 실행하려면 모두 재개하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustabdytas kartu su visais jūsų taf. Tęskite juos visus, kad jis galėtų veikti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apturēts kopā ar visiem taviem taf. Turpini tos visus, lai tas varētu darboties."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilgezet met al je tafs. Hervat ze allemaal om het te laten draaien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowane razem ze wszystkimi Twoimi tafs. Wznów je wszystkie, aby mógł działać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
