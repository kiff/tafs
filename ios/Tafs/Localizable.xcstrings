    "settings.sign_in_again_confirm.body_device": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ əvvəlcə KIFF-dən çıxış edir, sonra siz brauzerdə yenidən daxil olursunuz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този %1$@ първо излиза от KIFF, после влизате отново в браузъра."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení (%1$@) se nejdřív odhlásí z KIFF a pak se znovu přihlásíte v prohlížeči."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses %1$@ meldet sich zuerst von KIFF ab, dann meldest du dich in deinem Browser erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ signs out of KIFF first, then you sign in again in your browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero este %1$@ cierra la sesión de KIFF y luego vuelves a iniciar sesión en tu navegador."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See %1$@ logib esmalt KIFFist välja, siis logid brauseris uuesti sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ se déconnecte d'abord de KIFF, puis vous vous reconnectez dans votre navigateur."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj (%1$@) najprije se odjavljuje iz KIFF-a, a zatim se ponovno prijavljujete u pregledniku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz (%1$@) előbb kijelentkezik a KIFF-ből, aztán újra bejelentkezel a böngésződben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքը (%1$@) նախ դուրս է գալիս KIFF-ից, ապա դուք նորից մուտք եք գործում ձեր բրաուզերում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ini keluar dari KIFF terlebih dahulu, lalu Anda masuk lagi di browser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo %1$@ esce prima da KIFF, poi accedi di nuovo nel browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%1$@はまずKIFFからサインアウトし、その後ブラウザでもう一度サインインします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოწყობილობა (%1$@) ჯერ KIFF-იდან გამოდის, შემდეგ ბრაუზერში ხელახლა შედიხართ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %1$@이(가) 먼저 KIFF에서 로그아웃한 뒤, 브라우저에서 다시 로그인합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis įrenginys (%1$@) pirmiausia atsijungs nuo KIFF, tada vėl prisijungsite naršyklėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis %1$@ vispirms izrakstās no KIFF, tad tu pieraksties vēlreiz savā pārlūkā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %1$@ logt eerst uit bij KIFF, daarna log je opnieuw in via je browser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten %1$@ najpierw wyloguje się z KIFF, a potem zalogujesz się ponownie w przeglądarce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ termina primeiro a sessão no KIFF, e depois inicia sessão novamente no seu navegador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ encerra primeiro a sessão no KIFF, e depois faz login novamente no seu navegador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv (%1$@) se deconectează mai întâi de la KIFF, apoi vă conectați din nou în browser."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zariadenie (%1$@) sa najprv odhlási z KIFF a potom sa znova prihlásite v prehliadači."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta naprava (%1$@) se najprej odjavi iz KIFF, nato se znova prijavite v brskalniku."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo pajisje (%1$@) del fillimisht nga KIFF, pastaj hyni sërish në shfletuesin tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj (%1$@) prvo se odjavljuje iz KIFF-a, a zatim se ponovo prijavljujete u pregledniku."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@เครื่องนี้จะออกจากระบบ KIFF ก่อน แล้วคุณเข้าสู่ระบบอีกครั้งในเบราว์เซอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ önce KIFF'ten çıkış yapar, sonra tarayıcınızda tekrar oturum açarsınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ này sẽ đăng xuất khỏi KIFF trước, rồi bạn đăng nhập lại trong trình duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部%1$@會先登出 KIFF，然後您在瀏覽器中重新登入。"
          }
        }
      }
    },
