    "record.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was deine tafs getan haben, was abgelehnt wurde und wonach sie dich gefragt haben. Neueste zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything your tafs did, were refused, or asked you. Newest first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que tus tafs hicieron, lo que se les rechazó o lo que te preguntaron. Lo más reciente primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vos tafs ont fait, ce qui leur a été refusé ou ce qu'ils vous ont demandé. Les plus récents d'abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che i tuoi tafs hanno fatto, che è stato loro rifiutato o che ti hanno chiesto. Prima i più recenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je tafs deden, wat werd geweigerd of wat ze je vroegen. Nieuwste eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co Twoje tafs zrobiły, co im odrzucono lub o co Cię pytały. Od najnowszych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que os seus tafs fizeram, o que lhes foi recusado ou o que lhe perguntaram. Mais recente primeiro."
          }
        }
      }
    },
