          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klienci, którzy piszą co tydzień, dostają odpowiedź tego samego ranka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clientes que escrevem todas as semanas recebem resposta na mesma manhã."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clientes que escrevem todas as semanas recebem resposta na mesma manhã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clienții care scriu săptămânal primesc răspuns în aceeași dimineață."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zákazníci, ktorí píšu každý týždeň, dostanú odpoveď ešte v to ráno."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stranke, ki pišejo vsak teden, dobijo odgovor še isto jutro."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Klientët që shkruajnë çdo javë marrin përgjigje të njëjtin mëngjes."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupci koji pišu svaki nedelja dobivaju odgovor isto jutro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลูกค้าที่เขียนมาทุกสัปดาห์จะได้รับคำตอบภายในเช้าวันเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hafta yazan müşteriler aynı sabah yanıt alır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khách hàng viết mỗi tuần sẽ được trả lời ngay trong sáng hôm đó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每週來信的客戶，當天早上就會收到回覆。"
          }
        }
      }
    },
