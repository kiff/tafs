    "alert.tafs_could_not_reach_kiff": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs imtina etmək üçün KIFF-ə çata bilmədi. Cavab vermək üçün tafs-ı açın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs не можа да стигне до KIFF, за да откаже. Отворете tafs, за да отговорите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs se nemohl spojit s KIFF a odmítnout to. Otevřete tafs a odpovězte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs hat KIFF zum Ablehnen nicht erreicht. Öffne tafs, um zu antworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs couldn't reach KIFF to refuse it. Open tafs to answer it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs no pudo contactar con KIFF para rechazarla. Abre tafs para responder."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ei jõudnud keeldumiseks KIFFini. Vastamiseks ava tafs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs n'a pas pu joindre KIFF pour le refuser. Ouvrez tafs pour y répondre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nije mogao doći do KIFF-a da to odbije. Otvorite tafs da odgovorite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafs nem érte el a KIFF-et az elutasításhoz. Nyisd meg a tafst a válaszhoz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-ը չկարողացավ կապվել KIFF-ի հետ՝ մերժելու համար։ Բացեք tafs-ը՝ պատասխանելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs tidak dapat menghubungi KIFF untuk menolaknya. Buka tafs untuk menjawabnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs non è riuscita a raggiungere KIFF per rifiutarla. Apri tafs per rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsは拒否するためにKIFFに接続できませんでした。tafsを開いて回答してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-ს KIFF-თან დაკავშირება ვერ მოხერხდა უარის სათქმელად. გახსენით tafs, რომ უპასუხოთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs가 거절하려고 KIFF에 연결하지 못했습니다. tafs를 열어 응답하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nepavyko pasiekti KIFF, kad ją atmestų. Atidarykite tafs ir atsakykite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nevarēja sazināties ar KIFF, lai to atteiktu. Atver tafs, lai atbildētu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs kon KIFF niet bereiken om te weigeren. Open tafs om te antwoorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nie mógł połączyć się z KIFF, aby to odrzucić. Otwórz tafs, aby odpowiedzieć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não conseguiu contactar o KIFF para recusar. Abra o tafs para responder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não conseguiu contatar o KIFF para recusar. Abra o tafs para responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nu a putut contacta KIFF pentru a refuza. Deschideți tafs pentru a răspunde."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs sa nemohol spojiť s KIFF a odmietnuť to. Otvorte tafs a odpovedzte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ni mogel doseči KIFF, da bi to zavrnil. Odprite tafs in odgovorite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nuk arriti te KIFF për ta refuzuar. Hapni tafs për t'u përgjigjur."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nije mogao da dopre do KIFF-a da to odbije. Otvorite tafs da odgovorite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs เชื่อมต่อ KIFF เพื่อปฏิเสธไม่ได้ เปิด tafs เพื่อตอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs reddetmek için KIFF'e ulaşamadı. Yanıtlamak için tafs'ı açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs không kết nối được KIFF để từ chối. Hãy mở tafs để trả lời."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs 無法連線至 KIFF 進行拒絕。請開啟 tafs 回覆。"
          }
        }
      }
    },
