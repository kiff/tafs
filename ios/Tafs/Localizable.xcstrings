        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքը (%1$@) կոդ չունի, իսկ %2$@-ին այն պետք է։ Կարգավորեք կոդը՝ %3$@, ապա ավելացրեք՝ %4$@, ապա վերադարձեք։"
          }
