    "voice.microphone_off_tafs_turn_settings": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist für tafs ausgeschaltet. Schalte es unter Einstellungen › tafs › Mikrofon ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is off for tafs. Turn it on in Settings › tafs › Microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono está desactivado para tafs. Actívalo en Ajustes › tafs › Micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro est désactivé pour tafs. Activez-le dans Réglages › tafs › Micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è disattivato per tafs. Attivalo in Impostazioni › tafs › Microfono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon staat uit voor tafs. Zet hem aan in Instellingen › tafs › Microfoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon jest wyłączony dla tafs. Włącz go w Ustawienia › tafs › Mikrofon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está desativado para o tafs. Ative-o em Definições › tafs › Microfone."
          }
        }
      }
    },
    "voice.no_microphone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube tafs, das Mikrofon zum Diktieren zu nutzen. Deine Stimme wird auf diesem Telefon zu Text und nirgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow tafs to use the microphone to dictate. Your voice becomes text on this phone and isn't sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que tafs use el micrófono para dictar. Tu voz se convierte en texto en este teléfono y no se envía a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez tafs à utiliser le micro pour dicter. Votre voix devient du texte sur ce téléphone et n'est envoyée nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a tafs di usare il microfono per dettare. La tua voce diventa testo su questo telefono e non viene inviata da nessuna parte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta tafs toe de microfoon te gebruiken om te dicteren. Je stem wordt op deze telefoon tekst en wordt nergens heen gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól tafs używać mikrofonu do dyktowania. Twój głos zamienia się w tekst na tym telefonie i nie jest nigdzie wysyłany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o tafs use o microfone para ditar. A sua voz torna-se texto neste telefone e não é enviada para lado nenhum."
          }
        }
      }
    },
    "voice.not_on_device": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon kann Sprache nicht direkt auf dem Gerät erkennen, daher funktioniert das Mikrofon hier nicht: Deine Stimme müsste es verlassen. Du kannst stattdessen tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can't recognise speech on the phone itself, so the mic doesn't work here: your voice would have to leave it. You can type instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no puede reconocer la voz en el propio teléfono, así que el micrófono no funciona aquí: tu voz tendría que salir de él. Puedes escribir en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone ne peut pas reconnaître la parole sur l'appareil même : le micro ne fonctionne donc pas ici, car votre voix devrait le quitter. Vous pouvez écrire à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non sa riconoscere il parlato sul telefono stesso, quindi il microfono qui non funziona: la tua voce dovrebbe lasciarlo. Puoi scrivere invece."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon kan spraak niet op het toestel zelf herkennen, dus de microfoon werkt hier niet: je stem zou het toestel moeten verlaten. Je kunt in plaats daarvan typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon nie potrafi rozpoznawać mowy na samym urządzeniu, więc mikrofon tu nie działa: Twój głos musiałby je opuścić. Możesz zamiast tego pisać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone não consegue reconhecer a fala no próprio telefone, por isso o microfone não funciona aqui: a sua voz teria de sair dele. Pode escrever em vez disso."
          }
        }
      }
    },
