    "push.channel.briefs_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملخصك في أوقاته المحددة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xülasəniz təyin olunmuş vaxtlarda."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашето резюме в зададените часове."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্ধারিত সময়ে আপনার সারসংক্ষেপ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu resum a les hores establertes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš přehled v nastavených časech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Briefing zu den festen Zeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your brief at its set times."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu resumen a sus horas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu kokkuvõte määratud aegadel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre briefing aux heures prévues."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסיכום שלך בשעות שנקבעו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी ब्रीफ़ उसके तय समयों पर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš sažetak u zadano vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összefoglalód a beállított időpontokban."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր ամփոփումը սահմանված ժամերին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringkasan Anda pada waktu yang ditentukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo riepilogo ai suoi orari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した時刻に届くブリーフィング。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი მიმოხილვა დადგენილ დროს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សេចក្តីសង្ខេបរបស់អ្នកតាមម៉ោងដែលបានកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정해진 시간에 받는 브리핑."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບົດສະຫຼຸບຂອງທ່ານຕາມເວລາທີ່ກຳນົດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų suvestinė nustatytu laiku."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavs kopsavilkums noteiktajos laikos."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твојот преглед во зададените часови."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны товчлол тогтоосон цагт."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तोकिएको समयमा तपाईंको सारांश।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw briefing op de vaste tijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój przegląd o stałych porach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu resumo às horas definidas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu resumo às horas definidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezumatul dvs., la orele stabilite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš prehľad v nastavených časoch."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš pregled ob nastavljenih časih."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përmbledhja juaj në orët e caktuara."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš sažetak u zadano vreme."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สรุปของคุณตามเวลาที่ตั้งไว้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Siziň gysgaça maglumatyňyz bellenen wagtlarynda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özetiniz, belirlenen saatlerde."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی بریف اس کے مقررہ اوقات پر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản tóm tắt của bạn vào các giờ đã đặt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定的時間送上您的摘要。"
          }
        }
      }
    },
    "push.channel.holds_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب استدعاء معلّق بانتظار ردك. لا يُرسل شيء حتى توافق عليه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çağırış cavabınız üçün saxlanılıb. Siz təsdiq edənə qədər heç nə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявка е задържана за вашия отговор. Нищо не се изпраща, докато не я одобрите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি কল আপনার উত্তরের জন্য ধরে রাখা হয়েছে। আপনি অনুমোদন না করা পর্যন্ত কিছু পাঠানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una crida es reté per a la teva resposta. No s'envia res fins que ho aprovis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volání čeká na vaši odpověď. Nic se neodešle, dokud ho neschválíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Aufruf wird für deine Antwort zurückgehalten. Nichts wird gesendet, bevor du ihn genehmigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A call is held for your answer. Nothing is sent until you approve it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una llamada está retenida a la espera de tu respuesta. No se envía nada hasta que la apruebes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Päring on kinni peetud ja ootab sinu vastust. Midagi ei saadeta enne, kui selle kinnitad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appel est retenu en attente de votre réponse. Rien n'est envoyé tant que vous ne l'approuvez pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאה מוחזקת עד שתשיב. שום דבר לא נשלח עד שתאשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कॉल आपके उत्तर के लिए रोकी गई है। आपके मंज़ूर करने तक कुछ नहीं भेजा जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziv je zadržan do vašeg odgovora. Ništa se ne šalje dok ga ne odobrite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy hívás a válaszodra vár. Semmi sem megy ki, amíg jóvá nem hagyod."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Զանգը պահվում է ձեր պատասխանի համար։ Ոչինչ չի ուղարկվում, մինչև չհաստատեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah panggilan ditahan menunggu jawaban Anda. Tidak ada yang dikirim sampai Anda menyetujuinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chiamata è trattenuta in attesa della tua risposta. Non viene inviato nulla finché non la approvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "呼び出しがあなたの回答を待って保留されています。承認するまで何も送信されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზარი თქვენს პასუხს ელოდება. არაფერი იგზავნება, სანამ არ დაამტკიცებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការហៅមួយត្រូវបានផ្អាកទុករង់ចាំចម្លើយរបស់អ្នក។ គ្មានអ្វីត្រូវបានផ្ញើទេ រហូតដល់អ្នកអនុម័ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호출이 내 답변을 기다리며 보류되었습니다. 승인하기 전에는 아무것도 보내지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການໂທຖືກພັກໄວ້ລໍຖ້າຄຳຕອບຂອງທ່ານ. ບໍ່ມີຫຍັງຖືກສົ່ງຈົນກວ່າທ່ານຈະອະນຸມັດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užklausa sulaikyta, kol atsakysite. Niekas nesiunčiama, kol jos nepatvirtinsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izsaukums ir aizturēts, gaidot tavu atbildi. Nekas netiek nosūtīts, kamēr tu to neapstiprini."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Едно барање е задржано за твојот одговор. Ништо не се испраќа додека не го одобриш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэг хүсэлт таны хариуг хүлээж түр барьсан. Та зөвшөөрөхгүй бол юу ч илгээгдэхгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "एउटा अनुरोध तपाईंको जवाफका लागि रोकिएको छ। तपाईंले स्वीकृत नगरेसम्म केही पठाइँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aanroep wordt vastgehouden voor je antwoord. Er wordt niets verzonden tot je het goedkeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wywołanie jest oczekujące na Twoją odpowiedź. Nic nie zostanie wysłane, dopóki go nie zatwierdzisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma chamada está retida à espera da sua resposta. Nada é enviado até a aprovar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma chamada está retida aguardando a sua resposta. Nada é enviado até você aprovar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un apel este reținut pentru răspunsul dvs. Nimic nu se trimite până nu îl aprobați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Volanie čaká na vašu odpoveď. Nič sa neodošle, kým ho neschválite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klic čaka na vaš odgovor. Nič se ne pošlje, dokler ga ne odobrite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një thirrje mbahet për përgjigjen tuaj. Asgjë nuk dërgohet derisa ta miratoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziv je zadržan do vašeg odgovora. Ništa se ne šalje dok ga ne odobrite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการเรียกที่ถูกพักไว้รอคำตอบของคุณ จะไม่มีอะไรถูกส่งจนกว่าคุณจะอนุมัติ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Çagyryş siziň jogabyňyz üçin saklanýar. Siz tassyklamaňyzça hiç zat iberilmeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çağrı yanıtınızı bekliyor. Siz onaylayana kadar hiçbir şey gönderilmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی کال آپ کے جواب کے لیے روکی گئی ہے۔ آپ کے منظور کرنے تک کچھ نہیں بھیجا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lệnh gọi đang được giữ lại chờ bạn trả lời. Sẽ không có gì được gửi cho đến khi bạn phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一項呼叫已保留，等待您的回覆。在您核准之前不會傳送任何內容。"
          }
        }
      }
    },
