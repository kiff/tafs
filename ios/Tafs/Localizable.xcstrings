          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nieuwe berichten in #%2$@ laten horen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól %1$@ słyszeć nowe wiadomości w #%2$@"
