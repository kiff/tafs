    "sample.deploys.job": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انشر الإصلاحات المدمجة في الإنتاج عندما يكون CI أخضر، وتراجع عندما ترتفع الأخطاء. لا تُسقط بيانات الإنتاج ولا تحذفها أبدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "CI yaşıl olanda birləşdirilmiş düzəlişləri istehsala çıxarın və xətalar artanda geri qaytarın. İstehsal məlumatlarını heç vaxt atmayın və ya silməyin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пускайте обединените поправки в продукция, когато CI е зелено, и връщайте назад, когато грешките скочат. Никога не премахвайте и не изтривайте продукционни данни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "CI সবুজ হলে মার্জ করা সমাধান প্রোডাকশনে পাঠান, এবং ত্রুটি বেড়ে গেলে ফিরিয়ে আনুন। প্রোডাকশন ডেটা কখনও ফেলে দেবেন না বা মুছবেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta a producció les correccions fusionades quan CI està en verd, i desfés quan els errors es disparin. Mai no eliminis ni esborris dades de producció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasazovat sloučené opravy do produkce, když je CI zelené, a vracet zpět, když vyskočí chyby. Nikdy nemazat produkční data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe gemergte Fixes in die Produktion, wenn CI grün ist, und rolle zurück, wenn die Fehler steigen. Produktionsdaten nie verwerfen oder löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ship merged fixes to production when CI is green, and roll back when errors spike. Never drop or delete production data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva a producción las correcciones fusionadas cuando CI esté en verde, y revierte cuando se disparen los errores. Nunca borres ni elimines datos de producción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vii ühendatud parandused tootmisse, kui CI on roheline, ja võta tagasi, kui vead järsult kasvavad. Ära kunagi kustuta tootmisandmeid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Livrer en production les correctifs fusionnés quand la CI est au vert, et revenir en arrière quand les erreurs grimpent. Ne jamais supprimer de données de production."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להעלות לייצור תיקונים שמוזגו כש-CI ירוק, ולחזור אחורה כשהשגיאות מזנקות. לעולם לא להשמיט או למחוק נתוני ייצור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CI हरा होने पर मर्ज किए गए सुधार प्रोडक्शन में भेजें, और त्रुटियाँ बढ़ने पर वापस लें। प्रोडक्शन डेटा कभी न हटाएँ या मिटाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šaljite spojene ispravke u produkciju kad je CI zelen, a vraćajte kad pogreške naglo porastu. Nikad ne brišite produkcijske podatke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepítsd élesbe a beolvasztott javításokat, ha a CI zöld, és állítsd vissza, ha megugranak a hibák. Soha ne dobj el és ne törölj éles adatot."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արտադրություն ուղարկեք միացված ուղղումները, երբ CI-ը կանաչ է, և հետ գլորեք, երբ սխալները շատանում են։ Երբեք մի ջնջեք արտադրական տվյալները։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim perbaikan yang sudah digabung ke produksi saat CI hijau, dan kembalikan saat galat melonjak. Jangan pernah menghapus data produksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta in produzione le correzioni unite quando la CI è verde, e torna indietro quando gli errori aumentano. Non eliminare né cancellare mai dati di produzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CIが通ったらマージ済みの修正を本番に出し、エラーが急増したらロールバックします。本番データの削除は決して行いません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაგზავნეთ გაერთიანებული გასწორებები წარმოებაში, როცა CI მწვანეა, და დააბრუნეთ უკან, როცა შეცდომები იმატებს. არასოდეს წაშალოთ წარმოების მონაცემები."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដាក់ពង្រាយការជួសជុលដែលបានបញ្ចូលគ្នាទៅផលិតកម្មនៅពេល CI បៃតង ហើយត្រឡប់ក្រោយនៅពេលកំហុសកើនឡើង។ កុំទម្លាក់ ឬលុបទិន្នន័យផលិតកម្មឱ្យសោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CI가 통과하면 병합된 수정 사항을 운영 환경에 배포하고, 오류가 급증하면 롤백합니다. 운영 데이터를 삭제하지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສົ່ງການແກ້ໄຂທີ່ຮວມແລ້ວຂຶ້ນ production ເມື່ອ CI ຂຽວ, ແລະ ຖອຍຫຼັງເມື່ອຂໍ້ຜິດພາດເພີ່ມຂຶ້ນ. ບໍ່ເຄີຍທຳລາຍ ຫຼື ລຶບຂໍ້ມູນ production."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įdiegti sujungtus pataisymus į produkciją, kai CI žalias, ir atšaukti, kai klaidų šokteli. Niekada neišmesti ir netrinti produkcinių duomenų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvietot apvienotos labojumus produkcijā, kad CI ir zaļš, un atritināt, kad kļūdu skaits strauji pieaug. Nekad neizmest un nedzēst produkcijas datus."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пушти споени поправки во производство кога CI е зелен и врати назад кога грешките ќе скокнат. Никогаш не отфрлај или бриши производствени податоци."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "CI ногоон үед нэгтгэсэн засваруудыг үйлдвэрлэлд байршуул, алдаа огцом нэмэгдэхэд буцаа. Үйлдвэрлэлийн өгөгдлийг хэзээ ч бүү хая, бүү устга."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "CI हरियो हुँदा मर्ज भएका सुधार उत्पादनमा पठाउनुहोस्, र त्रुटि बढ्दा फर्काउनुहोस्। उत्पादन डेटा कहिल्यै नफाल्नुहोस् वा नमेट्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet gemergede fixes in productie als CI groen is, en draai terug als het aantal fouten piekt. Verwijder nooit productiedata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wdrażaj scalone poprawki na produkcję, gdy CI jest zielone, i wycofuj je, gdy błędy gwałtownie rosną. Nigdy nie usuwaj danych produkcyjnych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar para produção as correções integradas quando a CI estiver verde, e reverter quando os erros dispararem. Nunca apagar nem eliminar dados de produção."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar para produção as correções integradas quando a CI estiver verde, e reverter quando os erros dispararem. Nunca apagar nem excluir dados de produção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Livrați în producție remedierile integrate când CI e verde și reveniți când erorile cresc brusc. Nu eliminați și nu ștergeți niciodată date de producție."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasadzovať zlúčené opravy do produkcie, keď je CI zelené, a vracať späť, keď vyskočia chyby. Nikdy nemazať produkčné dáta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Združene popravke uvajaj v produkcijo, ko je CI zelen, in jih povrni, ko napake poskočijo. Nikoli ne briši produkcijskih podatkov."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Dërgoni në prodhim rregullimet e bashkuara kur CI është e gjelbër, dhe kthejini mbrapsht kur gabimet rriten. Mos fshini kurrë të dhënat e prodhimit."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Šaljite spojene ispravke u produkciju kad je CI zelen, a vraćajte kad greške naglo porastu. Nikad ne brišite produkcijske podatke."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปล่อยการแก้ไขที่รวมแล้วสู่ระบบจริงเมื่อ CI เป็นสีเขียว และย้อนกลับเมื่อข้อผิดพลาดพุ่งสูง ห้ามทิ้งหรือลบข้อมูลในระบบจริง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "CI ýaşyl bolanda birleşdirilen düzedişleri önümçilige iberiň, ýalňyşlyklar köpelende yzyna alyň. Hiç haçan önümçilik maglumatlaryny taşlamaň ýa-da pozmaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CI yeşilken birleştirilmiş düzeltmeleri üretime gönder, hatalar arttığında geri al. Asla üretim verilerini silme veya bırakma."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "CI سبز ہونے پر ضم شدہ اصلاحات پروڈکشن میں بھیجیں، اور غلطیاں بڑھنے پر رول بیک کریں۔ پروڈکشن ڈیٹا کبھی ڈراپ یا حذف نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa các bản sửa đã gộp lên môi trường sản xuất khi CI xanh, và quay lui khi lỗi tăng vọt. Không bao giờ bỏ hay xóa dữ liệu sản xuất."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
