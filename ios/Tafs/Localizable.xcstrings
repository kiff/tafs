    "people.rename_hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız ad dəyişir: adamları və taf-ları qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Променя се само името: хората и tafs остават."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změní se jen název: její lidé a tafy zůstávají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Name ändert sich: Ihre Personen und tafs bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the name changes: its people and tafs stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cambia el nombre: sus personas y tafs se mantienen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutub ainult nimi: selle inimesed ja tafid jäävad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le nom change : ses membres et ses tafs restent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijenja se samo naziv: njezini ljudi i tafovi ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a név változik: a tagjai és tafjai maradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխվում է միայն անունը․ նրա մարդիկ և taf-երը մնում են։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya nama yang berubah: anggota dan tafs-nya tetap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia solo il nome: le sue persone e i suoi tafs restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変わるのは名前だけで、メンバーとtafsはそのままです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იცვლება მხოლოდ სახელი: მისი ადამიანები და taf-ები რჩება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름만 바뀝니다. 사람과 taf는 그대로입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Keičiasi tik pavadinimas: jos nariai ir taf lieka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainās tikai nosaukums: tās cilvēki un taf paliek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de naam verandert: de mensen en tafs blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia się tylko nazwa: jej członkowie i tafs zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o nome muda: as suas pessoas e os seus tafs mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o nome muda: as suas pessoas e os seus tafs mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se schimbă doar numele: membrii și tafurile rămân."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmení sa len názov: jej ľudia a tafy zostávajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremeni se samo ime: njeni ljudje in tafi ostanejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndryshon vetëm emri: njerëzit dhe tafs-et e tij mbeten."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Menja se samo naziv: njeni ljudi i tafovi ostaju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนเฉพาะชื่อ: สมาชิกและ taf ของกลุ่มยังเหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ad değişir: kişileri ve tafs'ları kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tên thay đổi: các thành viên và tafs của nhóm vẫn giữ nguyên."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會變更名稱：群組的成員和 taf 維持不變。"
          }
        }
      }
    },
