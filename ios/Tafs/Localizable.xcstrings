    "connect.words_another_connection_than_one": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sözlər göstərilən qoşulmadan başqa qoşulma üçündür. Heç nə təsdiqlənə bilməz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този текст е за друга връзка, а не за показаната. Нищо не може да бъде одобрено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato slova patří k jinému připojení, než je zobrazené. Nelze nic schválit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Worte gehören zu einer anderen Verbindung als der angezeigten. Es kann nichts genehmigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These words are for another connection than the one shown. Nothing can be approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas palabras son para otra conexión distinta de la que se muestra. No se puede aprobar nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Need sõnad on teise ühenduse kohta kui näidatu. Midagi ei saa kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces textes concernent une autre connexion que celle affichée. Rien ne peut être approuvé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove riječi odnose se na drugu vezu od prikazane. Ništa se ne može odobriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szöveg egy másik kapcsolathoz tartozik, mint a megjelenített. Semmi sem hagyható jóvá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս բառերը մեկ այլ կապի համար են, քան ցուցադրվածը։ Ոչինչ չի կարող հաստատվել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata ini untuk koneksi lain dari yang ditampilkan. Tidak ada yang dapat disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste parole sono per un collegamento diverso da quello mostrato. Non si può approvare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この説明は表示されている接続とは別の接続のものです。何も承認できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს სიტყვები სხვა კავშირისთვისაა, ვიდრე ნაჩვენები. არაფრის დამტკიცება შეუძლებელია."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설명은 표시된 것과 다른 연결에 대한 것입니다. 승인할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ši formuluotė skirta kitam ryšiui, nei rodomas. Nieko negalima patvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis formulējums ir citam savienojumam, nevis parādītajam. Neko nevar apstiprināt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze woorden zijn voor een andere koppeling dan de getoonde. Er kan niets worden goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten opis dotyczy innego połączenia niż pokazane. Nic nie można zatwierdzić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas palavras são para outra ligação que não a mostrada. Nada pode ser aprovado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas palavras são para outra conexão que não a mostrada. Nada pode ser aprovado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest text este pentru altă conexiune decât cea afișată. Nimic nu poate fi aprobat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto slová patria k inému pripojeniu, než je zobrazené. Nedá sa nič schváliť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te besede so za drugo povezavo, kot je prikazana. Ničesar ni mogoče odobriti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Këto fjalë janë për një lidhje tjetër nga ajo e shfaqur. Asgjë nuk mund të miratohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove reči odnose se na drugu vezu od prikazane. Ništa se ne može odobriti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้อยคำเหล่านี้เป็นของการเชื่อมต่ออื่นที่ไม่ใช่รายการที่แสดง อนุมัติอะไรไม่ได้"
