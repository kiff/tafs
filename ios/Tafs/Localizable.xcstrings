    "drive.card_note_pauses": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tippt und schreibt in dieser App, während du zusiehst, nur für diese Anfrage. Er bestätigt nie etwas. Berühre die App, um ihn zu pausieren, oder tippe auf „Stoppen“, um ihn zu beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach taps and types in this app while you watch, for this request only. It never confirms anything. Touch the app to pause it, or tap Stop to end it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach toca y escribe en esta app mientras miras, solo para esta solicitud. Nunca confirma nada. Toca la app para pausarlo o toca Detener para terminar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach puudutab ja kirjutab selles rakenduses, kuni sina vaatad, ainult selle päringu jaoks. See ei kinnita kunagi midagi. Pausile panemiseks puuduta rakendust, lõpetamiseks puuduta Lõpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach touche et écrit dans cette app sous vos yeux, pour cette demande uniquement. Il ne confirme jamais rien. Touchez l'app pour le mettre en pause, ou touchez Arrêter pour terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tocca e scrive in questa app mentre guardi, solo per questa richiesta. Non conferma mai nulla. Tocca l'app per metterlo in pausa o tocca Ferma per terminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストに限り、あなたが見ている間にCoachがこのアプリでタップと入力を行います。何かを確定することはありません。一時停止するにはアプリに触れ、終了するには「停止」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach는 이 요청에 한해, 내가 지켜보는 동안 이 앱에서 탭하고 입력합니다. 무엇도 확정하지 않습니다. 일시 중지하려면 앱을 터치하고, 끝내려면 중지를 탭하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach liečia ir rašo šioje programėlėje, kol jūs stebite, tik šiai užklausai. Jis niekada nieko netvirtina. Palieskite programėlę, kad jį pristabdytumėte, arba palieskite „Nutraukti Coach“, kad baigtumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach pieskaras un raksta šajā lietotnē, kamēr tu skaties, tikai šim pieprasījumam. Tas nekad neko neapstiprina. Pieskaries lietotnei, lai to iepauzētu, vai pieskaries “Pārtraukt”, lai to beigtu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tikt en typt in deze app terwijl je kijkt, alleen voor dit verzoek. Het bevestigt nooit iets. Raak de app aan om het te pauzeren, of tik op Stoppen om het te beëindigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dotyka i pisze w tej aplikacji, gdy patrzysz, tylko dla tej prośby. Nigdy niczego nie potwierdza. Dotknij aplikacji, aby go wstrzymać, lub Zatrzymaj, aby zakończyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach toca e escreve nesta app enquanto observa, apenas para este pedido. Nunca confirma nada. Toque na app para o pausar ou em Parar para terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach toca e escreve neste app enquanto você observa, apenas para este pedido. Nunca confirma nada. Toque no app para pausar ou em Parar para terminar."
          }
        }
      }
    },
    "drive.card_note_scrolls_pauses": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tippt, schreibt und scrollt in dieser App, während du zusiehst. Er bestätigt nie etwas. Berühre die App, um ihn zu pausieren, oder tippe auf „Stoppen“, um ihn zu beenden."
