    "attachment.not_taken": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع tafs إرفاق هذا الملف: نوعه أو حجمه غير مقبول. اختر ملفًا آخر."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs bu faylı əlavə edə bilmir: o, qəbul etdiyi növdə və ya ölçüdə deyil. Başqasını seçin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs не може да прикачи този файл: типът или размерът му не се приемат. Изберете друг."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs এই ফাইল সংযুক্ত করতে পারে না: এটি এমন ধরন বা আকারের নয় যা সে নেয়। অন্য একটি বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs no pot adjuntar aquest fitxer: no és d'un tipus o d'una mida que accepti. Tria'n un altre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs tento soubor nemůže přiložit: takový typ nebo velikost nepřijímá. Vyberte jiný."
          }
        },
        "de": {
