    "watch.glance_description": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Neçəsi sizi gözləyir, nə olduğunu və ya kim olduğunu yox."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Колко ви чакат, никога какво или кой."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik jich na vás čeká, nikdy co ani kdo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele dich brauchen, nie was oder wer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many need you, never what or who."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántos te necesitan, nunca qué ni quién."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitu vajab sind, mitte kunagi mida või kes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien vous attendent, jamais quoi ni qui."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko ih čeka vas, nikad što ni tko."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hány vár rád, soha nem az, hogy mi vagy ki."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քանիսն են սպասում ձեզ, երբեք ինչը կամ ովքեր։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa yang menunggu Anda, bukan apa atau siapa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanti ti aspettano, mai cosa né chi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要確認の件数だけを表示し、内容や相手は表示しません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რამდენი გელოდებათ, არასოდეს რა ან ვინ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인이 필요한 개수만 표시하며, 무엇인지 누구인지는 표시하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiek užklausų jūsų laukia, bet niekada – kokios ar nuo ko."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cik daudz gaida tevi, nekad ne kas vai kurš."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel er op je wachten, nooit wat of wie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile czeka na Ciebie, nigdy co ani kto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos precisam de si, nunca o quê nem quem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos precisam de você, nunca o quê nem quem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câte vă așteaptă, niciodată ce sau cine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Koľko ich na vás čaká, nikdy čo ani kto."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko vas jih potrebuje, nikoli kaj ali kdo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa ju presin, kurrë çfarë apo kush."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko ih čeka vas, nikad šta ni ko."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีกี่เรื่องที่ต้องการคุณ ไม่บอกว่าอะไรหรือใคร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaç tanesinin sizi beklediği; ne olduğu veya kim olduğu asla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có bao nhiêu việc cần bạn, không bao giờ nói là gì hay của ai."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有多少項需要您，但不會顯示是什麼或是誰。"
          }
        }
      }
    },
