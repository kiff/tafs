        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩანაწერი თქვენს ტელეფონამდე ვერ მივიდა. სცადეთ ხელახლა ან აკრიფეთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការថតមិនបានទៅដល់ទូរសព្ទរបស់អ្នកទេ។ សូមព្យាយាមម្តងទៀត ឬវាយជំនួស។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 휴대폰에 전달되지 않았습니다. 다시 시도하거나 직접 입력하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການບັນທຶກບໍ່ເຖິງໂທລະສັບຂອງທ່ານ. ລອງໃໝ່ ຫຼື ພິມແທນ."
