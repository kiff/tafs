    "record.event.halted_detail": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onu davam etdirənə qədər ondan heç nə işləmir"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо от него не работи, докато не го възобновите"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic z něj neběží, dokud ho neobnovíte"
