    "drive.card_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tippt und schreibt in dieser App, während du zusiehst, nur für diese Anfrage. Er bestätigt nie etwas. Berühre die App oder tippe auf „Stoppen“, um zu übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach taps and types in this app while you watch, for this request only. It never confirms anything. Touch the app or tap Stop to take over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach toca y escribe en esta app mientras miras, solo para esta solicitud. Nunca confirma nada. Toca la app o toca Detener para tomar el control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach touche et écrit dans cette app sous vos yeux, pour cette demande uniquement. Il ne confirme jamais rien. Touchez l'app ou touchez Arrêter pour reprendre la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tocca e scrive in questa app mentre guardi, solo per questa richiesta. Non conferma mai nulla. Tocca l'app o tocca Ferma per riprendere il controllo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tikt en typt in deze app terwijl je kijkt, alleen voor dit verzoek. Het bevestigt nooit iets. Raak de app aan of tik op Stoppen om het over te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dotyka i pisze w tej aplikacji, gdy patrzysz, tylko dla tej prośby. Nigdy niczego nie potwierdza. Dotknij aplikacji lub Zatrzymaj, aby przejąć sterowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach toca e escreve nesta app enquanto você observa, apenas para este pedido. Nunca confirma nada. Toque na app ou em Parar para assumir o controlo."
          }
        }
      }
    },
    "drive.card_note_pauses": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tippt und schreibt in dieser App, während du zusiehst, nur für diese Anfrage. Er bestätigt nie etwas. Berühre die App, um ihn anzuhalten, oder tippe auf „Stoppen“, um ihn zu beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach taps and types in this app while you watch, for this request only. It never confirms anything. Touch the app to pause it, or tap Stop to end it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach toca y escribe en esta app mientras miras, solo para esta solicitud. Nunca confirma nada. Toca la app para pausarlo o toca Detener para terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach touche et écrit dans cette app sous vos yeux, pour cette demande uniquement. Il ne confirme jamais rien. Touchez l'app pour le mettre en pause, ou touchez Arrêter pour terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tocca e scrive in questa app mentre guardi, solo per questa richiesta. Non conferma mai nulla. Tocca l'app per metterlo in pausa o tocca Ferma per terminare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tikt en typt in deze app terwijl je kijkt, alleen voor dit verzoek. Het bevestigt nooit iets. Raak de app aan om het te pauzeren, of tik op Stoppen om het te beëindigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dotyka i pisze w tej aplikacji, gdy patrzysz, tylko dla tej prośby. Nigdy niczego nie potwierdza. Dotknij aplikacji, aby go wstrzymać, lub Zatrzymaj, aby zakończyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach toca e escreve nesta app enquanto você observa, apenas para este pedido. Nunca confirma nada. Toque na app para o pausar ou em Parar para terminar."
          }
        }
      }
    },
    "drive.card_note_scrolls": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tippt, schreibt und scrollt in dieser App, während du zusiehst. Er bestätigt nie etwas. Berühre die App oder tippe auf „Stoppen“, um sie zurückzunehmen."
