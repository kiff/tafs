          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafがあなたを必要としたときに通知を受け取る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf에 내가 필요할 때 알림 받기"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaukite pranešimą, kai taf jūsų laukia"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saņem paziņojumu, kad taf gaida tevi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg een melding als een taf op jou wacht"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj alert, gdy taf czeka na Ciebie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba um alerta quando um taf precisar de si"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba um alerta quando um taf precisar de você"
          }
        }
      }
    },
    "alert.role_cant": {
