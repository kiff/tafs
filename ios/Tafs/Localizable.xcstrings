    "version.trial.card_not_read": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة Card تجربة النسخة %1$@. %2$@"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ versiyasının sınaq Card-ı oxuna bilmədi. %2$@"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробната Card на версия %1$@ не можа да бъде прочетена. %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংস্করণ %1$@-এর পরীক্ষামূলক Card পড়া যায়নি। %2$@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut llegir el Card de prova de la versió %1$@. %2$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební Card verze %1$@ se nepodařilo načíst. %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Test-Card von Version %1$@ konnte nicht gelesen werden. %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %3$@ trial Card couldn't be read. %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la Card de prueba de la versión %1$@. %2$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiooni %1$@ proovi Cardi ei õnnestunud lugeda. %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Card d'essai de la version %1$@ n'a pas pu être lue. %2$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא את ה-Card של הניסיון של גרסה %1$@. %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण %1$@ का ट्रायल Card पढ़ा नहीं जा सका। %2$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Probni Card verzije %1$@ nije bilo moguće pročitati. %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@. verzió próba-Cardját nem sikerült beolvasni. %2$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տարբերակ %1$@-ի փորձնական Card-ը չկարողացավ կարդացվել։ %2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Card uji coba versi %1$@ tidak dapat dibaca. %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere la Card di prova della versione %1$@. %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン%1$@の試用Cardを読み込めませんでした。%2$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერსია %1$@-ის საცდელი Card ვერ წაიკითხა. %2$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចអាន Card សាកល្បងរបស់កំណែ %1$@ បានទេ។ %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 %1$@의 시험 Card를 읽지 못했습니다. %2$@"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອ່ານ Card ທົດລອງຂອງເວີຊັນ %1$@ ບໍ່ໄດ້. %2$@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko nuskaityti %1$@ versijos bandomosios Card. %2$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Versijas %1$@ izmēģinājuma Card nevarēja nolasīt. %2$@"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробниот Card на верзијата %1$@ не можеше да се прочита. %2$@"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-р хувилбарын туршилтын Card-ыг уншиж чадсангүй. %2$@"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण %1$@ को परीक्षण Card पढ्न सकिएन। %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De proef-Card van versie %1$@ kon niet worden gelezen. %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać Card próbnej wersji %1$@. %2$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o Card de experiência da versão %1$@. %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o Card de experiência da versão %1$@. %2$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardul de probă al versiunii %1$@ nu a putut fi citit. %2$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúšobnú Card verzie %1$@ sa nepodarilo načítať. %2$@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskusne Card različice %1$@ ni bilo mogoče prebrati. %2$@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-i provë i versionit %1$@ nuk u lexua dot. %2$@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Probni Card verzije %1$@ nije bilo moguće pročitati. %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่าน Card ทดลองของเวอร์ชัน %1$@ ไม่ได้ %2$@"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wersiýanyň synag Card-y okalyp bilinmedi. %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. sürümün deneme Card'ı okunamadı. %2$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ورژن %1$@ کا آزمائشی Card پڑھا نہیں جا سکا۔ %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc Card thử nghiệm của phiên bản %1$@. %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取版本 %1$@ 的試用 Card。%2$@"
          }
        }
      }
    },
    "version.trial.changed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر ما يُطلب منك الموافقة عليه منذ عرضه. اقرأه مرة أخرى ثم ابدأ."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təsdiq etməyiniz istənilən şey göstərildikdən sonra dəyişib. Onu yenidən oxuyun, sonra başlayın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това, което трябва да одобрите, се промени, откакто беше показано. Прочетете го отново и започнете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে যা অনুমোদন করতে বলা হচ্ছে তা দেখানোর পর বদলেছে। আবার পড়ুন, তারপর শুরু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El que et demanen aprovar ha canviat des que es va mostrar. Torna-ho a llegir i després comença."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co máte schválit, se změnilo od chvíle, kdy se to zobrazilo. Přečtěte si to znovu a začněte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du genehmigen sollst, hat sich geändert, seit es angezeigt wurde. Lies es erneut und starte dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you're asked to approve changed since it was shown. Read it again, then start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se te pide aprobar cambió desde que se mostró. Vuelve a leerlo y luego empieza."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See, mida sul palutakse kinnitada, on pärast näitamist muutunud. Loe see uuesti läbi ja alusta siis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l'on vous demande d'approuver a changé depuis son affichage. Relisez-le, puis commencez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה שמבקשים ממך לאשר השתנה מאז שהוצג. יש לקרוא אותו שוב ואז להתחיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसे मंज़ूर करने को कहा गया वह दिखाए जाने के बाद बदल गया। इसे फिर पढ़ें, फिर शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ono što se traži da odobrite promijenilo se otkako je prikazano. Pročitajte ponovno, pa počnite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az, amit jóvá kell hagynod, megváltozott, amióta megjelent. Olvasd el újra, majd indítsd el."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն, ինչ խնդրվում է հաստատել, փոխվել է ցուցադրվելուց հետո։ Կարդացեք նորից, ապա սկսեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang diminta untuk Anda setujui berubah sejak ditampilkan. Baca lagi, lalu mulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che ti viene chiesto di approvare è cambiato da quando è stato mostrato. Rileggilo, poi inizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認を求められている内容は、表示後に変更されました。もう一度確認してから開始してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რასაც დასამტკიცებლად გთავაზობენ, ნაჩვენები იყო მას შემდეგ შეიცვალა. წაიკითხეთ ხელახლა, შემდეგ დაიწყეთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីដែលអ្នកត្រូវបានស្នើឱ្យអនុម័តបានផ្លាស់ប្តូរតាំងពីវាត្រូវបានបង្ហាញ។ អានវាម្តងទៀត រួចចាប់ផ្តើម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 요청 내용이 표시된 뒤로 바뀌었습니다. 다시 읽고 시작하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສິ່ງທີ່ທ່ານຖືກຂໍໃຫ້ອະນຸມັດປ່ຽນໄປຕັ້ງແຕ່ມັນຖືກສະແດງ. ອ່ານອີກ ແລ້ວເລີ່ມ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai, ką prašoma patvirtinti, pasikeitė nuo tada, kai buvo parodyta. Perskaitykite dar kartą, tada pradėkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas, ko tev lūdz apstiprināt, mainījās, kopš tas tika parādīts. Izlasi to vēlreiz, tad sāc."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Она што се бара да го одобриш се промени откако беше прикажано. Прочитај го повторно, па започни."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таныг зөвшөөрөхийг хүссэн зүйл харуулснаас хойш өөрчлөгдсөн. Дахин уншаад эхлүүлнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंलाई स्वीकृत गर्न भनिएको कुरा देखाइएपछि परिवर्तन भयो। फेरि पढ्नुहोस्, अनि सुरु गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je moet goedkeuren, is gewijzigd sinds het werd getoond. Lees het opnieuw en begin dan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co masz zatwierdzić, zmieniło się od chwili pokazania. Przeczytaj to ponownie, a potem zacznij."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que lhe pedem para aprovar mudou desde que foi mostrado. Leia-o novamente e depois comece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que lhe pedem para aprovar mudou desde que foi mostrado. Leia-o novamente e depois comece."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce vi se cere să aprobați s-a schimbat de când a fost afișat. Citiți din nou, apoi începeți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "To, čo máte schváliť, sa zmenilo od chvíle, keď sa to zobrazilo. Prečítajte si to znova a začnite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kar morate odobriti, se je spremenilo, odkar je bilo prikazano. Preberite znova, nato začnite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajo që kërkohet të miratoni ndryshoi që kur u shfaq. Lexojeni sërish, pastaj filloni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ono šta se traži da odobrite promenilo se otkako je prikazano. Pročitajte ponovo, pa počnite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คุณถูกขอให้อนุมัติเปลี่ยนไปนับตั้งแต่ที่แสดง อ่านอีกครั้ง แล้วเริ่ม"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tassyklamagyňyz soralýan zat görkezilenden soň üýtgedi. Ony täzeden okaň, soňra başladyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamanız istenen şey gösterildiğinden beri değişti. Tekrar okuyun, sonra başlayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ سے جو منظور کرنے کو کہا گیا وہ دکھائے جانے کے بعد بدل گیا۔ اسے دوبارہ پڑھیں، پھر شروع کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều bạn được yêu cầu phê duyệt đã thay đổi kể từ khi nó được hiện. Hãy đọc lại, rồi bắt đầu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要請您核准的內容，自顯示以來已變更。請重新閱讀，然後開始。"
          }
        }
      }
    },
