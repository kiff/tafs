    "sign_in.welcome.inside_rest": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل، ولكل إجراء إيصال."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "o fəaliyyət göstərir və hər əməliyyatın qəbzi var."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "действа и всяко действие има разписка."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি কাজ করে, এবং প্রতিটি কাজের একটি রসিদ থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "actua, i cada acció té un rebut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "jedná a každá akce má potvrzení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "handelt er, und jede Aktion hat einen Beleg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "it acts, and every action has a receipt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "actúa, y cada acción tiene un recibo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tegutseb see ja igal toimingul on kviitung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "il agit, et chaque action a un reçu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא פועל, ולכל פעולה יש קבלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्रवाई करता है, और हर कार्रवाई की रसीद होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "djeluje, a svaka radnja ima potvrdu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "cselekszik, és minden műveletről van nyugta."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "այն գործում է, և յուրաքանչյուր գործողություն անդորրագիր ունի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "ia bertindak, dan setiap tindakan punya tanda terima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "agisce, e ogni azione ha una ricevuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafが動き、すべての操作に領収書が残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ის მოქმედებს და ყოველ მოქმედებას ქვითარი აქვს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាធ្វើសកម្មភាព ហើយរាល់សកម្មភាពមានបង្កាន់ដៃ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 행동하고, 모든 행동에 영수증이 남습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມັນດຳເນີນການ ແລະ ທຸກການກະທຳມີໃບຮັບເງິນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "jis veikia, ir kiekvienas veiksmas turi kvitą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tas rīkojas, un katrai darbībai ir kvīts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "дејствува, а секое дејство има признаница."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "үйлдэл хийнэ, үйлдэл бүрт баримт байна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो काम गर्छ, र हरेक कार्यको रसिद हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "handelt het, en elke actie heeft een ontvangstbewijs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "działa, a każda akcja ma potwierdzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "age, e cada ação tem um recibo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "age, e cada ação tem um recibo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "acționează, iar fiecare acțiune are o chitanță."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "koná a každá akcia má potvrdenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "deluje in vsako dejanje ima potrdilo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "vepron, dhe çdo veprim ka një dëftesë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "deluje, a svaka radnja ima potvrdu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันลงมือทำ และทุกการกระทำมีใบเสร็จ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "ol hereket edýär, we her hereketiň kwitansiýasy bar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "çalışır ve her eylemin bir makbuzu vardır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ عمل کرتا ہے، اور ہر عمل کی رسید ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "nó hành động, và mỗi hành động đều có biên nhận."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它採取行動，而且每個動作都有收據。"
          }
        }
      }
    },
    "sign_in.welcome.lead": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي الـ taf مهمته ضمن الـ Card التي تحدّدها. وما وراءها يسألك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf sizin təyin etdiyiniz Card daxilində bir iş görür. Ondan kənarda sizdən soruşur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Един taf върши работа в рамките на Card, която задавате. Отвъд нея ви пита."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি taf আপনার ঠিক করা Card-এর মধ্যে একটি কাজ করে। এর বাইরে সে আপনাকে জিজ্ঞেস করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf fa una feina dins del Card que has establert. Més enllà, et pregunta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf dělá práci v rámci Card, kterou nastavíte. Nad rámec se zeptá vás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein taf erledigt eine Aufgabe innerhalb der Card, die du festlegst. Darüber hinaus fragt er dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A taf does a job within the Card you set. Past it, it asks you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf hace un trabajo dentro de la Card que tú defines. Más allá, te pregunta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf teeb tööd sinu seatud Cardi piires. Sellest kaugemale minnes küsib see sinult."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf accomplit une mission dans la Card que vous définissez. Au-delà, il vous le demande."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "taf עושה עבודה בתוך ה-Card שהגדרת. מעבר לו הוא שואל אותך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "taf आपके तय किए Card के भीतर काम करता है। उससे आगे वह आपसे पूछता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf radi posao unutar Carda koji postavite. Izvan njega pita vas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy taf az általad beállított Card keretein belül végez el egy munkát. Azon túl téged kérdez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf-ը աշխատանք է անում ձեր սահմանած Card-ի շրջանակներում։ Դրանից դուրս նա հարցնում է ձեզ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah taf mengerjakan tugas dalam Card yang Anda tetapkan. Di luar itu, ia bertanya kepada Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf svolge un lavoro dentro la Card che imposti tu. Oltre, te lo chiede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafは、あなたが設定したCardの範囲内で仕事をします。それを超えるときは、あなたに確認します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "taf აკეთებს სამუშაოს თქვენ მიერ დადგენილი Card-ის ფარგლებში. მის მიღმა გეკითხებათ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "taf ធ្វើការងារក្នុង Card ដែលអ្នកកំណត់។ លើសពីនោះ វាសួរអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf는 내가 정한 Card 안에서 일합니다. 그 이상은 나에게 물어봅니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "taf ເຮັດວຽກພາຍໃນ Card ທີ່ທ່ານຕັ້ງ. ເກີນນັ້ນ ມັນຖາມທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "taf atlieka darbą jūsų nustatytos Card ribose. Už jų jis klausia jūsų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "taf veic darbu tevis iestatītās Card ietvaros. Ārpus tās tas jautā tev."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafот врши работа во рамки на Card што го зададуваш. Над тоа, те прашува тебе."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf таны тохирууулсан Card-ын хүрээнд ажил хийдэг. Түүнээс цааш таниас асууна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "taf ले तपाईंले तोकेको Card भित्र काम गर्छ। त्यसभन्दा बाहिर यसले तपाईंलाई सोध्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een taf doet een taak binnen de Card die jij instelt. Daarbuiten vraagt het jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf wykonuje zadanie w ramach ustawionej przez Ciebie Card. Poza nią pyta Cię."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taf faz uma tarefa dentro do Card que define. Para lá disso, pergunta-lhe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um taf faz uma tarefa dentro do Card que você define. Além disso, ele pergunta a você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un taf face o sarcină în limitele Cardului pe care îl setați. Dincolo de el, vă întreabă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf robí prácu v rámci Card, ktorú nastavíte. Nad rámec sa opýta vás."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf opravi delo v okviru Card, ki jo nastavite. Zunaj nje vpraša vas."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një taf bën një punë brenda Card-it që vendosni ju. Përtej tij, ju pyet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf radi posao unutar Carda koji podesite. Izvan njega pita vas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "taf ทำงานภายใน Card ที่คุณกำหนด เกินกว่านั้นมันจะถามคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf siziň belleýän Card-yňyzyň çäginde iş edýär. Ondan daşarda ol sizden soraýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir taf, belirlediğiniz Card içinde bir iş yapar. Bunun ötesinde size sorar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "taf آپ کے طے کیے ہوئے Card کے اندر کام کرتا ہے۔ اس سے آگے وہ آپ سے پوچھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một taf làm một công việc trong phạm vi Card bạn đặt. Vượt quá đó, nó hỏi bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "taf 在您設定的 Card 範圍內完成一項工作。超出範圍，它會詢問您。"
          }
        }
      }
    },
