        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sensore di impronte non può essere usato ora. Riprova tra un attimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指紋センサーは現在使用できません。少し待ってからもう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითის ანაბეჭდის სენსორი ახლა ვერ გამოიყენება. სცადეთ ცოტა ხანში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 지문 센서를 사용할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Piršto atspaudo jutiklio šiuo metu naudoti negalima. Netrukus bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirkstu nospiedumu sensoru pašlaik nevar izmantot. Pēc brīža mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vingerafdruksensor kan nu niet worden gebruikt. Probeer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytnika linii papilarnych nie można teraz użyć. Spróbuj ponownie za chwilę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível usar o sensor de impressões digitais neste momento. Tente novamente daqui a pouco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível usar o sensor de impressões digitais neste momento. Tente novamente daqui a pouco."
