            "value": "Ботът още слуша, така че вратата остава. %1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot pořád naslouchá, takže dveře zůstávají. %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bot hört weiterhin zu, daher bleibt die Tür. %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bot still listens, so the door stays. %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bot sigue escuchando, así que la puerta se mantiene. %1$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot kuulab ikka, seega uks jääb. %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bot écoute toujours : la porte reste. %1$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot i dalje osluškuje pa vrata ostaju. %1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bot még figyel, ezért az ajtó marad. %1$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բոտը դեռ լսում է, ուստի դուռը մնում է։ %1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot masih mendengarkan, jadi pintu tetap ada. %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bot ascolta ancora, quindi la porta resta. %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットがまだ受信しているため、窓口は残ります。%1$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოტი მაინც უსმენს, ამიტომ კარი რჩება. %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "봇이 아직 듣고 있어 창구가 유지됩니다. %1$@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Botas vis dar klausosi, todėl durys lieka. %1$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bots joprojām klausās, tāpēc durvis paliek. %1$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bot luistert nog, dus de deur blijft. %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot nadal nasłuchuje, więc drzwi zostają. %1$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot continua a ouvir, por isso a porta mantém-se. %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot continua ouvindo, por isso a porta continua. %1$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Botul încă ascultă, așa că ușa rămâne. %1$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot stále počúva, takže dvere zostávajú. %1$@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot še vedno posluša, zato vrata ostanejo. %1$@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Boti ende dëgjon, ndaj porta mbetet. %1$@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot i dalje osluškuje pa vrata ostaju. %1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอตยังรับฟังอยู่ ประตูจึงยังอยู่ %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot hâlâ dinliyor, bu yüzden kapı duruyor. %1$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot vẫn đang lắng nghe nên cửa vẫn còn. %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器人仍在監聽，因此門會保留。%1$@"
          }
        }
      }
    },
