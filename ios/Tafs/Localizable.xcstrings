            "value": "%1$@ to odmietol (odmietla) a stále sa to počíta do dnešných limitov%2$@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je to zavrnil(a) in se še vedno šteje v današnje omejitve%2$@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ e refuzoi, dhe prapë numërohet te kufijtë e sotëm%2$@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je to odbila i to se i dalje naloga u današnja ograničenja%2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ปฏิเสธ และยังนับรวมในขีดจำกัดของวันนี้%2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reddetti ve yine de bugünkü limitlere sayılıyor%2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã từ chối, và nó vẫn được tính vào các giới hạn của hôm nay%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@拒絕了，而且仍計入今天的上限%2$@"
          }
        }
      }
    },
    "record.tool_refused_money": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ onu rədd etdi. Pul köçürülmədi, amma o, yenə də bugünkü cəmə daxildir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ го отказа. Не бяха преведени пари, но все пак се отчита в днешния общ лимит."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to odmítl(a). Žádné peníze se nepřevedly, ale pořád se to počítá do dnešního celkového limitu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat es abgelehnt. Es wurde kein Geld bewegt, aber es zählt trotzdem zur heutigen Summe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ refused it. No money moved, but it still counts against today's total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lo rechazó. No se movió dinero, pero sigue contando para el total de hoy."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ keeldus. Raha ei liikunud, kuid see läheb ikka tänase kogusumma arvesse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ l'a refusé. Aucun argent n'a été transféré, mais cela compte quand même dans le total du jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je to odbila. Novac nije premješten, ali se i dalje računa u današnji ukupni iznos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ elutasította. Nem mozdult pénz, de a mai összesítőbe így is beleszámít."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը մերժեց այն։ Գումար չտեղափոխվեց, բայց այն դեռ հաշվարկվում է այսօրվա ընդհանուրի դեմ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ menolaknya. Tidak ada uang yang pindah, tetapi tetap dihitung terhadap total hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ l'ha rifiutata. Nessun denaro trasferito, ma conta comunque nel totale di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が拒否しました。お金は移動していませんが、今日の合計にはカウントされます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-მ უარყო. ფული არ გადასულა, მაგრამ ის მაინც ითვლება დღევანდელი ჯამის წინააღმდეგ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 거절했습니다. 돈은 움직이지 않았지만 오늘 합계에는 여전히 포함됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tai atmetė. Pinigai nepervesti, bet tai vis tiek įskaičiuojama į šiandienos bendrą sumą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to atteica. Nauda netika pārskaitīta, bet tas joprojām tiek ieskaitīts šodienas kopsummā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft het geweigerd. Er is geen geld verplaatst, maar het telt nog wel mee voor het totaal van vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to odrzucił. Pieniądze nie zostały przelane, ale nadal liczy się to do dzisiejszej sumy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recusou. Nenhum dinheiro foi movimentado, mas continua a contar para o total de hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recusou. Nenhum dinheiro foi movimentado, mas continua contando para o total de hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ l-a refuzat. Nu s-au transferat bani, dar se numără totuși în totalul de azi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to odmietol (odmietla). Žiadne peniaze sa nepreviedli, ale stále sa to počíta do dnešného celkového limitu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je to zavrnil(a). Noben denar se ni premaknil, a se še vedno šteje v današnjo skupno vsoto."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ e refuzoi. Asnjë para nuk u zhvendos, por prapë numërohet kundrejt totalit të sotëm."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je to odbila. Novac nije premešten, ali se i dalje naloga u današnji ukupni iznos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ปฏิเสธ ไม่มีเงินเคลื่อนไหว แต่ยังนับรวมในยอดของวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reddetti. Para aktarılmadı ama yine de bugünkü toplama sayılıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã từ chối. Không có tiền nào được chuyển, nhưng nó vẫn được tính vào tổng hôm nay."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@拒絕了。沒有金額異動，但仍計入今天的總額。"
          }
        }
      }
    },
