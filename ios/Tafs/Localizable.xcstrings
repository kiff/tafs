        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រសិនបើទំព័រចូលរបស់អ្នកផ្តល់សេវាបានបើក សូមបញ្ចប់វានៅទីនោះ រួចត្រឡប់មកវិញ។"
