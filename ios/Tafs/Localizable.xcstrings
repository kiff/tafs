            "state": "translated",
            "value": "არაფერი გელოდებათ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인할 것이 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas jūsų nelaukia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas tevi negaida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets wacht op jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie czeka na Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada precisa de si."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada precisa de você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu vă așteaptă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič na vás nečaká."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič ne čaka na vas."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Asgjë nuk ju pret."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa ne čeka vas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรรอคุณอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizi bekleyen bir şey yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì đang chờ bạn."
          }
        },
        "zh-Hant": {
