            "value": "tafs kon je tafs niet stilzetten. %1$@ Open tafs om ze stil te zetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nie mógł zablokować Twoich tafs. %1$@ Otwórz tafs, aby je zablokować."
