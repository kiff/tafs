    "coach.improve_line": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag, was sich ändern soll, oder frag, wie es läuft. Der Coach-Modus geht davon aus, was %1$@ getan hat und was seine Card erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say what should change, or ask how it's going. Coach mode starts from what %1$@ did and what its Card allows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di qué debería cambiar, o pregunta cómo va. El modo Coach parte de lo que hizo %1$@ y de lo que permite su Card."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ütle, mis peaks muutuma, või küsi, kuidas läheb. Coachi režiim lähtub sellest, mida %1$@ tegi ja mida selle Card lubab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites ce qui doit changer, ou demandez comment ça se passe. Le mode Coach part de ce que %1$@ a fait et de ce que sa Card autorise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' cosa dovrebbe cambiare, o chiedi come sta andando. La modalità Coach parte da ciò che %1$@ ha fatto e da ciò che la sua Card consente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変えたいことを伝えるか、調子を尋ねてください。Coachモードは、%1$@が行ったこととCardが許可する範囲から始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꿀 점을 말하거나 진행 상황을 물어보세요. Coach 모드는 %1$@이(가) 한 일과 Card가 허용하는 범위에서 시작합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasakykite, ką pakeisti, arba paklauskite, kaip sekasi. Coach režimas pradeda nuo to, ką padarė %1$@ ir ką leidžia jo Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasaki, kas jāmaina, vai pajautā, kā sokas. Coach režīms sāk no tā, ko %1$@ izdarīja un ko atļauj tā Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg wat er moet veranderen, of vraag hoe het gaat. De Coach-modus begint bij wat %1$@ heeft gedaan en wat zijn Card toestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz, co powinno się zmienić, albo zapytaj, jak idzie. Tryb Coach zaczyna od tego, co zrobił %1$@ i na co pozwala jego Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga o que deve mudar, ou pergunte como está a correr. O modo Coach parte do que %1$@ fez e do que o seu Card permite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga o que deve mudar, ou pergunte como está indo. O modo Coach parte do que %1$@ fez e do que o seu Card permite."
          }
        }
      }
    },
    "coach.improve_no_files": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien kommen mit deiner nächsten Nachricht: Sende zuerst diese, dann häng sie an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files go with your next message: send this one first, then attach them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos van con tu próximo mensaje: envía primero este y luego adjúntalos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Failid lähevad koos sinu järgmise sõnumiga: saada kõigepealt see, siis lisa need."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers partent avec votre prochain message : envoyez d'abord celui-ci, puis joignez-les."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vanno con il prossimo messaggio: invia prima questo, poi allegali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは次のメッセージと一緒に送られます。先にこのメッセージを送ってから添付してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 다음 메시지와 함께 보내집니다. 이 메시지를 먼저 보낸 뒤 첨부하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Failai siunčiami su kita jūsų žinute: pirmiausia išsiųskite šią, tada juos pridėkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili tiek sūtīti ar nākamo ziņu: vispirms nosūti šo, tad pievieno tos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden gaan mee met je volgende bericht: stuur eerst dit bericht en voeg ze daarna bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki trafią do następnej wiadomości: najpierw wyślij tę, a potem je załącz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros vão com a próxima mensagem: envie primeiro esta e depois anexe-os."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos vão com a próxima mensagem: envie primeiro esta e depois anexe-os."
          }
        }
      }
    },
