          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum taf usa %1$@ agora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun taf nu mai folosește %1$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ teraz nepoužíva žiadny taf."
          }
        },
        "sl": {
