    "coach.coach_knows": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعلم Coach، ويسلّمه مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach bilir və yenidən təhvil verir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach знае и го предава отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach জানে, এবং আবার হস্তান্তর করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ho sap, i ho torna a lliurar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach to ví a předá to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach weiß Bescheid und übergibt es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach knows, and hands it over again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach lo sabe y vuelve a entregarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach teab ja annab selle uuesti üle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach le sait, et le transmet à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach יודע, ומעביר שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach जानता है, और इसे फिर सौंपता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach zna i ponovno to predaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Coach tudja, és újra átadja."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-ը գիտի և նորից է հանձնում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tahu, dan menyerahkannya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach lo sa, e lo consegna di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coachは把握しており、もう一度引き渡します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach იცის და ხელახლა გადასცემს."
