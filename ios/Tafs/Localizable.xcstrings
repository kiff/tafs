          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De credits van de vorige periode konden niet worden gelezen. Kies die periode opnieuw om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
