    "door.api.key_not_here": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Açar burada yoxdur. Onu yaradanda kopyaladığınızdan istifadə edin və ya yeni açar yaradın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът не е тук. Използвайте този, който копирахте при създаването му, или създайте нов ключ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč tu není. Použijte ten, který jste zkopírovali při vytvoření, nebo vytvořte nový."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel ist hier nicht zu sehen. Nimm den, den du beim Erstellen kopiert hast, oder erstelle einen neuen Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key isn't here. Use the one you copied when you made it, or make a new key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave no está aquí. Usa la que copiaste al crearla o crea una clave nueva."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võtit siin pole. Kasuta seda, mille loomisel kopeerisid, või loo uus võti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé n'est pas ici. Utilisez celle que vous avez copiée en la créant, ou créez-en une nouvelle."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključa nema ovdje. Upotrijebite onaj koji ste kopirali kad ste ga izradili ili izradite novi ključ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcs nincs itt. Használd azt, amelyet a létrehozásakor kimásoltál, vagy hozz létre új kulcsot."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բանալին այստեղ չէ։ Օգտագործեք այն, որ պատճենեցիք ստեղծելիս, կամ ստեղծեք նոր բանալի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuncinya tidak ada di sini. Gunakan yang Anda salin saat membuatnya, atau buat kunci baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave non è qui. Usa quella che hai copiato quando l'hai creata, o crea una nuova chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはここにはありません。作成時にコピーしたものを使うか、新しいキーを作成してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გასაღები აქ არ არის. გამოიყენეთ ის, რომელიც შექმნისას დააკოპირეთ, ან შექმენით ახალი გასაღები."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 여기에 없습니다. 만들 때 복사한 키를 쓰거나 새 키를 만드세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakto čia nėra. Naudokite tą, kurį nukopijavote jį kurdami, arba sukurkite naują raktą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atslēgas šeit nav. Izmanto to, ko nokopēji, kad to izveidoji, vai izveido jaunu atslēgu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel staat hier niet. Gebruik die je kopieerde toen je hem maakte, of maak een nieuwe sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucza tu nie ma. Użyj tego, który skopiowano przy jego tworzeniu, albo utwórz nowy klucz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave não está aqui. Use a que copiou quando a criou, ou crie uma nova chave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave não está aqui. Use a que copiou quando a criou, ou crie uma nova chave."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia nu este aici. Folosiți-o pe cea copiată când ați creat-o sau creați o cheie nouă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúč tu nie je. Použite ten, ktorý ste skopírovali pri vytvorení, alebo vytvorte nový."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključa ni tukaj. Uporabite tistega, ki ste ga kopirali ob ustvarjanju, ali ustvarite novega."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çelësi nuk është këtu. Përdorni atë që kopjuat kur e krijuat, ose krijoni një çelës të ri."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključa nema ovdje. Upotrebite onaj koji ste kopirali kad ste ga izradili ili izradite novi ključ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีกุญแจอยู่ที่นี่ ใช้อันที่คุณคัดลอกไว้ตอนสร้าง หรือสร้างกุญแจใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar burada değil. Oluştururken kopyaladığınızı kullanın veya yeni bir anahtar oluşturun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa không có ở đây. Hãy dùng khóa bạn đã sao chép khi tạo, hoặc tạo khóa mới."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡沒有金鑰。請使用您建立時拷貝的那一把，或建立新的金鑰。"
          }
        }
      }
    },
