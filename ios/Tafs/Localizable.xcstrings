    "approval.security_key.failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sicherheitsschlüssel konnte nicht signieren, also wurde nichts genehmigt. Die Anfrage bleibt erhalten: Genehmige erneut, wenn du so weit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The security key couldn't sign, so nothing was approved. The request is kept: approve again when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llave de seguridad no pudo firmar, así que no se aprobó nada. La solicitud se conserva: vuelve a aprobar cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Turvavõti ei saanud allkirjastada, seega midagi ei kinnitatud. Päring jääb alles: kinnita uuesti, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de sécurité n'a pas pu signer : rien n'a été approuvé. La demande est conservée : approuvez à nouveau quand vous êtes prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di sicurezza non è riuscita a firmare, quindi non è stato approvato nulla. La richiesta resta: approva di nuovo quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティキーで署名できなかったため、何も承認されていません。リクエストは保持されています。準備ができたらもう一度承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 키로 서명하지 못해 승인된 것은 없습니다. 요청은 남아 있으니 준비되면 다시 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saugos raktas negalėjo pasirašyti, todėl niekas nepatvirtinta. Užklausa išsaugota: patvirtinkite dar kartą, kai būsite pasirengę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drošības atslēga nevarēja parakstīt, tāpēc nekas netika apstiprināts. Pieprasījums ir saglabāts: apstiprini vēlreiz, kad esi gatavs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beveiligingssleutel kon niet ondertekenen, dus er is niets goedgekeurd. Het verzoek blijft bewaard: keur het goed wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz bezpieczeństwa nie mógł podpisać, więc nic nie zostało zatwierdzone. Prośba zostaje zachowana: zatwierdź ją ponownie, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança não conseguiu assinar, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança não conseguiu assinar, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        }
      }
    },
    "approval.security_key.locked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Sicherheitsschlüssel ist nach zu vielen falschen PINs gesperrt und kann nicht genehmigen. Genehmige auf deinem Telefon. Beim Zurücksetzen wird der Schlüssel gelöscht. Um wieder mit einem Schlüssel zu genehmigen, kopple diesen Computer erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This security key is locked after too many wrong PINs, so it can't approve. Approve on your phone. Resetting the key erases it, so to approve with a key again, pair this computer again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta llave de seguridad está bloqueada tras demasiados PIN incorrectos, así que no puede aprobar. Aprueba en tu teléfono. Restablecer la llave la borra, así que para volver a aprobar con una llave, vuelve a vincular este ordenador."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See turvavõti on liiga paljude valede PIN-koodide tõttu lukus, seega ei saa see kinnitada. Kinnita telefonis. Võtme lähtestamine kustutab selle, seega võtmega uuesti kinnitamiseks seo see arvuti uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé de sécurité est verrouillée après trop de codes PIN incorrects : elle ne peut pas approuver. Approuvez sur votre téléphone. Réinitialiser la clé l'efface : pour approuver de nouveau avec une clé, associez de nouveau cet ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chiave di sicurezza è bloccata dopo troppi PIN errati, quindi non può approvare. Approva sul telefono. Ripristinare la chiave la cancella, quindi per approvare di nuovo con una chiave, associa di nuovo questo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PINの誤入力が多すぎるため、このセキュリティキーはロックされ、承認できません。スマートフォンで承認してください。キーをリセットすると内容が消去されるため、再びキーで承認するには、このコンピュータをもう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN을 너무 많이 틀려 이 보안 키가 잠겼으므로 승인할 수 없습니다. 휴대폰에서 승인하세요. 키를 재설정하면 키가 초기화되므로, 다시 키로 승인하려면 이 컴퓨터를 다시 페어링하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis saugos raktas užrakintas po per daug neteisingų PIN, todėl negali tvirtinti. Tvirtinkite telefone. Atkūrus rakto nustatymus jis išvalomas, todėl norėdami vėl tvirtinti raktu, iš naujo susiekite šį kompiuterį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī drošības atslēga ir bloķēta pēc pārāk daudziem nepareiziem PIN, tāpēc tā nevar apstiprināt. Apstiprini savā tālrunī. Atslēgas atiestatīšana to izdzēš, tāpēc, lai atkal apstiprinātu ar atslēgu, vēlreiz savieno šo datoru pārī."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze beveiligingssleutel is vergrendeld na te veel verkeerde pincodes, dus hij kan niet goedkeuren. Keur goed op je telefoon. Als je de sleutel herstelt, wordt hij gewist. Om weer met een sleutel goed te keuren, koppel je deze computer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten klucz bezpieczeństwa jest zablokowany po zbyt wielu złych PIN-ach, więc nie może zatwierdzać. Zatwierdź na telefonie. Zresetowanie klucza go wymazuje, więc aby znów zatwierdzać kluczem, sparuj ten komputer ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave de segurança está bloqueada após demasiados PIN errados, por isso não pode aprovar. Aprove no seu telefone. Repor a chave apaga-a, por isso, para voltar a aprovar com uma chave, associe novamente este computador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave de segurança está bloqueada após muitos PINs errados, por isso não pode aprovar. Aprove no seu telefone. Redefinir a chave a apaga; então, para voltar a aprovar com uma chave, associe novamente este computador."
          }
        }
      }
    },
    "approval.security_key.no_key": {
