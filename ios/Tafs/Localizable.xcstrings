          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Chats wurden nicht exportiert. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chats weren't exported. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus chats no se exportaron. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu vestlusi ei eksporditud. Kontrolli ühendust ja proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos chats n'ont pas été exportés. Vérifiez votre connexion et réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši razgovori nisu izvezeni. Provjerite vezu i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csevegéseid nem lettek exportálva. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր զրույցները չարտահանվեցին։ Ստուգեք ձեր կապը և փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrolan Anda tidak diekspor. Periksa koneksi Anda lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue chat non sono state esportate. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットはエクスポートされませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი ჩატები არ ექსპორტირდა. შეამოწმეთ კავშირი და სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅을 내보내지 못했습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų pokalbiai neeksportuoti. Patikrinkite interneto ryšį ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavas sarunas netika eksportētas. Pārbaudi interneta savienojumu un mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je chats zijn niet geëxporteerd. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje czaty nie zostały wyeksportowane. Sprawdź swoje połączenie i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus chats não foram exportados. Verifique a sua ligação e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus chats não foram exportados. Verifique a sua conexão e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversațiile dvs. nu au fost exportate. Verificați conexiunea și încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše chaty sa neexportovali. Skontrolujte pripojenie a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši klepeti niso bili izvoženi. Preverite povezavo in poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
