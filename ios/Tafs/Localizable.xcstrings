          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šeit neviens nav savienots pārī"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier is niemand gekoppeld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt nie jest tu powiązany"
          }
        },
        "pt": {
