        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está desativado para o tafs. Ative-o nas definições do tafs para aprovar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está desativado para o tafs. Ative-o nas configurações do tafs para aprovar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ este dezactivat pentru tafs. Activați-l în setările tafs pentru a aproba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je pre tafs vypnuté. Na schvaľovanie ho zapnite v nastaveniach tafs."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je za tafs izklopljeno. Za odobravanje ga vklopite v nastavitvah tafs."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ është joaktiv për tafs. Aktivizojeni te cilësimet e tafs për të miratuar."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je isključen za tafs. Uključite ga u podešavanjima tafsa da biste odobravali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ถูกปิดสำหรับ tafs เปิดในการตั้งค่าของ tafs เพื่ออนุมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs için kapalı: %1$@. Onaylamak için tafs ayarlarından açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang tắt đối với tafs. Hãy bật trong cài đặt của tafs để phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs 的%1$@已關閉。請在 tafs 的設定中開啟，才能核准。"
          }
        }
      }
    },
    "approval.view_only": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təsdiq etmək üçün bu telefonda yenidən daxil olun və ya digər telefonunuzdan təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влезте отново на този телефон, за да одобрявате, или одобрявайте от другия си телефон."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro schvalování se v tomto telefonu přihlaste znovu, nebo schvalte z druhého telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich auf diesem Telefon erneut an, um zu genehmigen, oder genehmige auf deinem anderen Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again on this phone to approve, or approve from your other phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a iniciar sesión en este teléfono para aprobar, o aprueba desde tu otro teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinnitamiseks logi selles telefonis uuesti sisse või kinnita oma teisest telefonist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous sur ce téléphone pour approuver, ou approuvez depuis votre autre téléphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se ponovno na ovom telefonu da biste odobravali ili odobrite s drugog telefona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jóváhagyáshoz jelentkezz be újra ezen a telefonon, vagy hagyd jóvá a másik telefonodról."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նորից մուտք գործեք այս հեռախոսում՝ հաստատելու համար, կամ հաստատեք ձեր մյուս հեռախոսից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk lagi di ponsel ini untuk menyetujui, atau setujui dari ponsel Anda yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi di nuovo su questo telefono per approvare, oppure approva dall'altro telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認するには、このスマートフォンでもう一度サインインするか、もう一台のスマートフォンから承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კვლავ შედით ამ ტელეფონზე დასამტკიცებლად ან დაამტკიცეთ სხვა ტელეფონიდან."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하려면 이 휴대폰에서 다시 로그인하거나, 다른 휴대폰에서 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad galėtumėte tvirtinti, dar kartą prisijunkite šiame telefone arba tvirtinkite kitame savo telefone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēlreiz pieraksties šajā tālrunī, lai apstiprinātu, vai apstiprini no sava otra tālruņa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log opnieuw in op deze telefoon om goed te keuren, of keur goed vanaf je andere telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się ponownie na tym telefonie, aby zatwierdzać, lub zatwierdź na drugim telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão novamente neste telefone para aprovar, ou aprove a partir do seu outro telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre novamente neste telefone para aprovar, ou aprove a partir do seu outro telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectați-vă din nou pe acest telefon pentru a aproba sau aprobați de pe celălalt telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na schvaľovanie sa v tomto telefóne prihláste znova, alebo schváľte z druhého telefónu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za odobravanje se v tem telefonu znova prijavite ali odobrite z drugega telefona."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyni sërish në këtë telefon për të miratuar, ose miratoni nga telefoni juaj tjetër."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se ponovo na ovom telefonu da biste odobravali ili odobrite sa drugog telefona."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบอีกครั้งบนโทรศัพท์เครื่องนี้เพื่ออนุมัติ หรืออนุมัติจากโทรศัพท์เครื่องอื่นของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamak için bu telefonda tekrar oturum açın veya diğer telefonunuzdan onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng nhập lại trên điện thoại này để phê duyệt, hoặc phê duyệt từ điện thoại khác của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在這部手機上重新登入以核准，或從您的另一部手機核准。"
          }
        }
      }
    },
    "approval.view_only_mac": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac yalnız baxa bilər. Burada təsdiq etmək üçün onu telefonunuzdan əlavə edin: Hesab › Cihazlar › Cihaz əlavə et."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този Mac може само да преглежда. За да одобрявате тук, добавете го от телефона си: Акаунт › Устройства › Добавяне на устройство."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento Mac může jen prohlížet. Chcete-li tady schvalovat, přidejte ho z telefonu: Účet › Zařízení › Přidat zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac kann nur ansehen. Um hier zu genehmigen, füge ihn auf deinem Telefon hinzu: Konto › Geräte › Gerät hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac can only view. To approve here, add it from your phone: Account › Devices › Add a device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac solo puede ver. Para aprobar aquí, añádelo desde tu teléfono: Cuenta › Dispositivos › Añadir un dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See Mac saab ainult vaadata. Siin kinnitamiseks lisa see telefonist: Konto › Seadmed › Lisa seade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac peut seulement consulter. Pour approuver ici, ajoutez-le depuis votre téléphone : Compte › Appareils › Ajouter un appareil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac može samo pregledavati. Da biste odobravali ovdje, dodajte ga s telefona: Račun › Uređaji › Dodaj uređaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a Mac csak megtekinteni tud. Ha itt akarsz jóváhagyni, add hozzá a telefonodról: Fiók › Eszközök › Eszköz hozzáadása."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս Mac-ը կարող է միայն դիտել։ Այստեղ հաստատելու համար ավելացրեք այն ձեր հեռախոսից․ Հաշիվ › Սարքեր › Ավելացնել սարք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini hanya dapat melihat. Untuk menyetujui di sini, tambahkan dari ponsel Anda: Akun › Perangkat › Tambah perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac può solo visualizzare. Per approvare qui, aggiungilo dal tuo telefono: Account › Dispositivi › Aggiungi un dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macは表示のみ可能です。ここで承認するには、スマートフォンから追加してください：アカウント › デバイス › デバイスを追加。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ Mac-ს მხოლოდ ნახვა შეუძლია. აქ დასამტკიცებლად დაამატეთ ის ტელეფონიდან: ანგარიში › მოწყობილობები › მოწყობილობის დამატება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서는 보기만 할 수 있습니다. 여기서 승인하려면 휴대폰에서 이 Mac을 추가하세요: 계정 › 기기 › 기기 추가."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis Mac gali tik peržiūrėti. Kad galėtumėte tvirtinti čia, pridėkite jį iš telefono: Paskyra › Įrenginiai › Pridėti įrenginį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis Mac var tikai skatīt. Lai apstiprinātu šeit, pievieno to no sava tālruņa: Konts › Ierīces › Pievienot ierīci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac kan alleen bekijken. Om hier goed te keuren, voeg je hem toe vanaf je telefoon: Account › Apparaten › Apparaat toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac może tylko wyświetlać. Aby zatwierdzać tutaj, dodaj go na telefonie: Konto › Urządzenia › Dodaj urządzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac só pode ver. Para aprovar aqui, adicione-o a partir do seu telefone: Conta › Dispositivos › Adicionar um dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac só pode ver. Para aprovar aqui, adicione-o a partir do seu telefone: Conta › Dispositivos › Adicionar um dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest Mac poate doar vizualiza. Pentru a aproba aici, adăugați-l de pe telefon: Cont › Dispozitive › Adăugați un dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento Mac môže len prezerať. Ak chcete tu schvaľovať, pridajte ho z telefónu: Účet › Zariadenia › Pridať zariadenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta Mac lahko samo prikazuje. Za odobravanje tukaj ga dodajte s telefona: Račun › Naprave › Dodaj napravo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky Mac mund vetëm të shikojë. Për të miratuar këtu, shtojeni nga telefoni juaj: Llogaria › Pajisjet › Shtoni një pajisje."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac može samo da prikazuje. Da biste odobravali ovde, dodajte ga sa telefona: Nalog › Uređaji › Dodaj uređaj."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้ดูได้อย่างเดียว หากต้องการอนุมัติที่นี่ ให้เพิ่มจากโทรศัพท์ของคุณ: บัญชี › อุปกรณ์ › เพิ่มอุปกรณ์."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac yalnızca görüntüleyebilir. Burada onaylamak için telefonunuzdan ekleyin: Hesap › Cihazlar › Cihaz ekle."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac này chỉ xem được. Để phê duyệt tại đây, hãy thêm nó từ điện thoại của bạn: Tài khoản › Thiết bị › Thêm thiết bị."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 僅供檢視。若要在此核准，請從您的手機新增它：帳號 ›「裝置」›「新增裝置」。"
          }
        }
      }
    },
    "approval.why": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-da verdiyiniz hər təsdiq, Card, bağlantı və ya limitdən artıq ödəniş, bu telefonda yalnız barmaq izinizin açdığı açarla imzalanır. PIN-iniz və ya naxışınız təsdiq edə bilməz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко одобрение, което давате в tafs, било то Card, връзка или плащане над лимит, се подписва на този телефон с ключ, който само пръстовият ви отпечатък отключва. ПИН кодът или фигурата ви не могат да одобряват."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé schválení, které v tafs dáte, ať jde o Card, připojení nebo platbu nad limit, se podepisuje v tomto telefonu klíčem, který odemkne jen váš otisk prstu. PIN ani gesto schvalovat nemohou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Genehmigung, die du in tafs gibst, ob für eine Card, eine Verbindung oder eine Zahlung über einem Limit, wird auf diesem Telefon mit einem Schlüssel signiert, den nur dein Fingerabdruck entsperrt. Deine PIN oder dein Muster kann nicht genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every approval you give in tafs, a Card, a connection or a payment over a limit, is signed on this phone with a key only your fingerprint unlocks. Your PIN or pattern can't approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada aprobación que das en tafs, una Card, una conexión o un pago por encima de un límite, se firma en este teléfono con una clave que solo tu huella desbloquea. Tu PIN o patrón no pueden aprobar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga kinnitus, mille tafsis annad, olgu Card, ühendus või limiiti ületav makse, allkirjastatakse selles telefonis võtmega, mille avab ainult sinu sõrmejälg. Sinu PIN-kood või muster ei saa kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque approbation que vous donnez dans tafs, une Card, une connexion ou un paiement au-delà d'une limite, est signée sur ce téléphone avec une clé que seule votre empreinte déverrouille. Votre code PIN ou votre schéma ne peut pas approuver."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako odobrenje koje dajete u tafsu, Card, vezu ili plaćanje iznad ograničenja, potpisuje se na ovom telefonu ključem koji otključava samo vaš otisak prsta. PIN ili uzorak ne mogu odobriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden jóváhagyásodat a tafsben, legyen az Card, kapcsolat vagy limit feletti fizetés, ezen a telefonon írod alá egy kulccsal, amelyet csak az ujjlenyomatod old fel. A PIN-kódod vagy mintád nem tud jóváhagyni."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր հաստատում, որ տալիս եք tafs-ում՝ Card, կապ կամ վճարում՝ սահմանաչափից ավելի, ստորագրվում է այս հեռախոսում բանալիով, որը բացում է միայն ձեր մատնահետքը։ Ձեր PIN-ը կամ նախշը չի կարող հաստատել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap persetujuan yang Anda berikan di tafs, baik Card, koneksi, atau pembayaran di atas batas, ditandatangani di ponsel ini dengan kunci yang hanya dibuka oleh sidik jari Anda. PIN atau pola Anda tidak dapat menyetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni approvazione che dai in tafs, una Card, un collegamento o un pagamento oltre un limite, viene firmata su questo telefono con una chiave che solo la tua impronta sblocca. Il PIN o la sequenza non possono approvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Card、接続、上限を超える支払いなど、tafsで行うすべての承認は、あなたの指紋でしか解除できないキーでこのスマートフォン上で署名されます。PINやパターンでは承認できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყოველი დამტკიცება, რომელსაც tafs-ში აძლევთ, Card, კავშირი ან გადახდა ლიმიტზე მეტი, ამ ტელეფონზე იწერება გასაღებით, რომელსაც მხოლოდ თქვენი თითის ანაბეჭდი ხსნის. თქვენი PIN ან ნიმუში ვერ ამტკიცებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs에서 하는 모든 승인(Card, 연결, 한도를 넘는 결제)은 내 지문으로만 잠금 해제되는 키로 이 휴대폰에서 서명됩니다. PIN이나 패턴으로는 승인할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas jūsų patvirtinimas tafs – Card, ryšys ar mokėjimas virš limito – pasirašomas šiame telefone raktu, kurį atrakina tik jūsų piršto atspaudas. PIN kodu ar atrakinimo piešiniu patvirtinti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katrs apstiprinājums, ko tu dod tafs lietotnē (Card, savienojums vai maksājums virs limita), tiek parakstīts šajā tālrunī ar atslēgu, ko atbloķē tikai tavs pirksta nospiedums. Tavs PIN vai kombinācija nevar apstiprināt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke goedkeuring die je in tafs geeft, een Card, een koppeling of een betaling boven een limiet, wordt op deze telefoon ondertekend met een sleutel die alleen je vingerafdruk ontgrendelt. Je pincode of patroon kan niet goedkeuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde zatwierdzenie w tafs, Card, połączenie czy płatność ponad limit, jest podpisywane na tym telefonie kluczem, który odblokowuje tylko Twój odcisk palca. Twój PIN ani wzór nie mogą zatwierdzać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada aprovação que dá no tafs, seja um Card, uma ligação ou um pagamento acima de um limite, é assinada neste telefone com uma chave que só a sua impressão digital desbloqueia. O seu PIN ou padrão não pode aprovar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada aprovação que dá no tafs, seja um Card, uma conexão ou um pagamento acima de um limite, é assinada neste telefone com uma chave que só a sua impressão digital desbloqueia. O seu PIN ou padrão não pode aprovar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare aprobare pe care o dați în tafs, fie un Card, o conexiune sau o plată peste o limită, se semnează pe acest telefon cu o cheie pe care doar amprenta dvs. o deblochează. PIN-ul sau modelul nu pot aproba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé schválenie, ktoré v tafs dáte, či ide o Card, pripojenie alebo platbu nad limit, sa podpisuje v tomto telefóne kľúčom, ktorý odomkne len váš odtlačok prsta. PIN ani vzor schvaľovať nemôžu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka odobritev, ki jo date v tafs, za Card, povezavo ali plačilo nad omejitvijo, je podpisana v tem telefonu s ključem, ki ga odklene samo vaš prstni odtis. Vaš PIN ali vzorec ne more odobriti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo miratim që jepni në tafs, një Card, një lidhje ose një pagesë mbi një kufi, nënshkruhet në këtë telefon me një çelës që e zhbllokon vetëm gjurma juaj e gishtit. PIN-i ose motivi juaj nuk mund të miratojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako odobravanje koje date u tafsu, Card, veza ili plaćanje preko ograničenja, potpisuje se na ovom telefonu ključem koji otključava samo vaš otisak prsta. Vaš PIN ili šablon ne može da odobrava."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกการอนุมัติที่คุณให้ใน tafs ไม่ว่าจะเป็น Card การเชื่อมต่อ หรือการชำระเงินที่เกินขีดจำกัด จะลงนามบนโทรศัพท์เครื่องนี้ด้วยกุญแจที่ปลดล็อกได้ด้วยลายนิ้วมือของคุณเท่านั้น PIN หรือรูปแบบการปลดล็อกอนุมัติไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs'ta verdiğiniz her onay (bir Card, bir bağlantı veya bir limiti aşan bir ödeme), bu telefonda yalnızca parmak izinizin açtığı bir anahtarla imzalanır. PIN'iniz veya deseniniz onay veremez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi phê duyệt bạn đưa ra trong tafs, dù là Card, kết nối hay khoản thanh toán vượt hạn mức, đều được ký trên điện thoại này bằng một khóa mà chỉ vân tay của bạn mở được. PIN hoặc hình mở khóa của bạn không thể phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您在 tafs 中給出的每一項核准，不論是 Card、連線，或超過上限的付款，都會在這部手機上以只有您的指紋才能解鎖的金鑰簽署。您的 PIN 或圖形無法核准。"
          }
        }
      }
    },
    "approval.without_allows": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təsdiqlər olmadan da daxil ola, nəzərdən keçirə, rədd edə və dondura bilərsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без одобрения все пак можете да влизате, преглеждате, отказвате и спирате."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez schvalování se můžete dál přihlašovat, kontrolovat, odmítat a zastavovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Genehmigungen kannst du dich weiterhin anmelden, prüfen, ablehnen und anhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without approvals you can still sign in, review, refuse and halt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin aprobaciones aún puedes iniciar sesión, revisar, rechazar y bloquear."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilma kinnitusteta saad ikka sisse logida, üle vaadata, keelduda ja peatada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans approbations, vous pouvez toujours vous connecter, consulter, refuser et bloquer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez odobrenja se i dalje možete prijaviti, pregledavati, odbijati i blokirati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jóváhagyások nélkül is bejelentkezhetsz, áttekinthetsz, elutasíthatsz és leállíthatsz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առանց հաստատումների դեռ կարող եք մուտք գործել, դիտել, մերժել և կանգնեցնել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa persetujuan Anda tetap dapat masuk, meninjau, menolak, dan membekukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza approvazioni puoi comunque accedere, controllare, rifiutare e bloccare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認なしでも、サインイン、確認、拒否、遮断はできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დამტკიცებების გარეშეც შეგიძლიათ შესვლა, გადახედვა, უარის თქმა და გაჩერება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 없이도 로그인, 검토, 거절, 차단은 할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Be patvirtinimų vis tiek galite prisijungti, peržiūrėti, atmesti ir sustabdyti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez apstiprināšanas tu joprojām vari pierakstīties, pārskatīt, atteikt un apturēt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder goedkeuringen kun je nog steeds inloggen, bekijken, weigeren en stilzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez zatwierdzania nadal możesz się zalogować, przeglądać, odrzucać i blokować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem aprovações, pode continuar a iniciar sessão, rever, recusar e bloquear."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem aprovações, ainda pode entrar, revisar, recusar e bloquear."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără aprobări vă puteți totuși conecta, verifica, refuza și opri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez schvaľovania sa môžete ďalej prihlasovať, kontrolovať, odmietať a zastavovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez odobritev se še vedno lahko prijavite, pregledujete, zavračate in ustavljate."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pa miratime mund të hyni, të shqyrtoni, të refuzoni dhe të bllokoni prapë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez odobravanja i dalje možete da se prijavite, pregledate, odbijate i blokirate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีการอนุมัติ คุณยังเข้าสู่ระบบ ตรวจสอบ ปฏิเสธ และระงับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaysız da oturum açabilir, inceleyebilir, reddedebilir ve dondurabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có phê duyệt, bạn vẫn có thể đăng nhập, xem lại, từ chối và đóng băng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有核准功能，您仍可登入、檢視、拒絕和凍結。"
          }
        }
      }
    },
