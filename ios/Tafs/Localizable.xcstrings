        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs თქვენს ხმას ტექსტად აქცევს ამ მოწყობილობაზე. თქვენი ხმა არსად იგზავნება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs បំប្លែងសំឡេងរបស់អ្នកជាអត្ថបទនៅលើឧបករណ៍នេះ។ សំឡេងរបស់អ្នកមិនត្រូវបានផ្ញើទៅកន្លែងណាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs는 이 기기에서 음성을 텍스트로 바꿉니다. 음성은 어디에도 보내지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ປ່ຽນສຽງຂອງທ່ານເປັນຂໍ້ຄວາມໃນອຸປະກອນນີ້. ສຽງຂອງທ່ານບໍ່ຖືກສົ່ງໄປບ່ອນໃດ."
