    "needs_you.knocks|one": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طرق أحدهم بابه. لم يتم شيء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimsə onun qapısını döydü. Heç nə edilmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Някой почука на вратата му. Нищо не беше направено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ এর দরজায় কড়া নেড়েছে। কিছু করা হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algú ha trucat a la seva porta. No s'ha fet res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo zaklepal na jeho dveře. Nic se neudělalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat an seine Tür geklopft. Es wurde nichts unternommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone knocked at its door. Nothing was done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien llamó a su puerta. No se hizo nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Keegi koputas selle uksele. Midagi ei tehtud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un a fait une demande d'accès à sa porte. Rien n'a été fait."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מישהו דפק בדלת שלו. שום דבר לא בוצע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी ने इसके द्वार पर दस्तक दी। कुछ नहीं किया गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Netko je pokucao na njegova vrata. Ništa nije učinjeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki kopogott az ajtaján. Semmi sem történt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչ-որ մեկը թակեց նրա դուռը։ Ոչինչ չարվեց։"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno ha bussato alla sua porta. Non è stato fatto nulla."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვიღაცამ მის კარზე დააკაკუნა. არაფერი გაკეთებულა."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ beldimas į jo duris. Nieko nepadaryta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ klauvējiens pie tā durvīm. Nekas netika izdarīts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Некој тропна на неговата врата. Ништо не е направено."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэн нэгэн түүний хаалгыг тогшсон. Юу ч хийгдээгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कसैले यसको ढोका ढकढक्यायो। केही गरिएन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand klopte aan bij zijn deur. Er is niets gedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś zapukał do jego drzwi. Nic nie zostało zrobione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém fez um pedido de contacto na sua porta. Nada foi feito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém fez um pedido de contato na sua porta. Nada foi feito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cineva a bătut la ușa sa. Nu s-a făcut nimic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekto zaklopal na jeho dvere. Nič sa neurobilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekdo je potrkal na njegova vrata. Nič ni bilo storjeno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikush trokiti te porta e tij. Asgjë nuk u bë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Netko je pokucao na njegova vrata. Ništa nije učinjeno."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimdir biri onuň gapysyny kakdy. Hiç zat edilmedi."
