    "home.tafs_shared_you_show": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا tafs التي تمت مشاركتها معك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizinlə paylaşılan taf-lar burada görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тук се показват tafs, споделени с вас."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সঙ্গে শেয়ার করা taf এখানে দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els taf compartits amb tu es mostren aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tady se zobrazí tafy sdílené s vámi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dir geteilte tafs erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafs shared with you show here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen los tafs compartidos contigo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinuga jagatud tafid on siin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tafs partagés avec vous s'affichent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "taf ששותפו איתך מוצגים כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके साथ साझा किए गए taf यहाँ दिखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje se prikazuju tafovi podijeljeni s vama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelennek meg a veled megosztott tafok."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեզ հետ կիսված taf-երը կերևան այստեղ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs yang dibagikan kepada Anda muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tafs condivisi con te compaiono qui."
