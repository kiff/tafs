    "sample.reply.paused": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasilədədir. Davam etməyimi deyənə qədər artıq heç nə getmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На пауза. Нищо повече не излиза, докато не ми кажете да продължа."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastaveno. Nic dalšího neodejde, dokud mi neřeknete, ať pokračuji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert. Es geht nichts mehr raus, bis du mir sagst, dass ich weitermachen soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused. Nothing more goes out until you tell me to carry on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa. No sale nada más hasta que me digas que continúe."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausil. Midagi rohkem ei lähe välja enne, kui ütled mulle, et jätkaksin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause. Plus rien ne part tant que vous ne me dites pas de continuer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzirano. Ništa više ne ide dok mi ne kažete da nastavim."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szüneteltetve. Semmi sem megy ki, amíg nem szólsz, hogy folytassam."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դադարեցված է։ Ոչինչ չի ուղարկվում, մինչև չասեք շարունակել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda. Tidak ada lagi yang keluar sampai Anda menyuruh saya melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa. Non esce più nulla finché non mi dici di continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止しました。続けるよう言われるまで、何も送信しません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაპაუზებულია. არაფერი გადის, სანამ არ მეტყვით გავაგრძელო."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 중지했습니다. 계속하라고 하실 때까지 아무것도 보내지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristabdyta. Daugiau niekas nesiunčiama, kol nepasakysite tęsti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iepauzēts. Nekas vairs netiek sūtīts, līdz tu man liksi turpināt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd. Er gaat niets meer uit tot je zegt dat ik verder moet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane. Nic więcej nie wyjdzie, dopóki nie powiesz mi, żebym kontynuował."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa. Nada mais sai até me dizer para continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa. Nada mais sai até me dizer para continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întrerupt. Nu mai pleacă nimic până nu îmi spuneți să continui."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastavené. Nič ďalšie neodíde, kým mi nepoviete, nech pokračujem."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začasno ustavljeno. Nič več ne gre ven, dokler mi ne rečete, naj nadaljujem."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pezulluar. Asgjë tjetër nuk del derisa të më thoni të vazhdoj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzirano. Ništa više ne ide dok mi ne kažete da nastavim."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดชั่วคราว จะไม่มีอะไรออกไปอีกจนกว่าคุณจะบอกให้ฉันทำต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatıldı. Devam etmemi söyleyene kadar başka bir şey çıkmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạm dừng. Sẽ không có gì được gửi đi nữa cho đến khi bạn bảo tôi tiếp tục."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停。在您告訴我繼續之前，不會再傳送任何內容。"
          }
        }
      }
    },
