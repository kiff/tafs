        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерни данни. Нов taf започва в Coach."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নমুনা তথ্য। নতুন taf Coach-এ শুরু হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dades d'exemple. Un taf nou comença a Coach."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukázková data. Nový taf začíná v Coachovi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispieldaten. Ein neuer taf beginnt in Coach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample data. A new taf starts in Coach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de ejemplo. Un taf nuevo empieza en Coach."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Näidisandmed. Uus taf algab Coachis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données d'exemple. Un nouveau taf commence dans Coach."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני דוגמה. taf חדש מתחיל ב-Coach."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
