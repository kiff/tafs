    "approval.key_gone_approve_again": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت بصماتك أو لم يتم التعرف على أي منها، لذا لا يستطيع هذا الهاتف الموافقة حتى توافق عليه مرة أخرى في متصفحك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Barmaq izləriniz dəyişib və ya heç biri tanınmadı, ona görə bu telefon brauzerdə yenidən təsdiq etməyincə təsdiq edə bilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пръстовите ви отпечатъци се промениха или нито един не беше разпознат, така че този телефон не може да одобрява, докато не го одобрите отново в браузъра."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার আঙুলের ছাপ বদলেছে, অথবা কোনোটিই চেনা যায়নি, তাই ব্রাউজারে আবার অনুমোদন না করা পর্যন্ত এই ফোন অনুমোদন করতে পারে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves empremtes han canviat o cap no s'ha reconegut, així que aquest telèfon no pot aprovar fins que el tornis a aprovar al navegador."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše otisky prstů se změnily nebo žádný nebyl rozpoznán, takže tento telefon nemůže schvalovat, dokud ho znovu neschválíte v prohlížeči."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fingerabdrücke haben sich geändert oder keiner wurde erkannt, daher kann dieses Telefon erst wieder genehmigen, wenn du es erneut in deinem Browser genehmigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your fingerprints changed, or none was recognized, so this phone can't approve until you approve it again in your browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus huellas cambiaron o no se reconoció ninguna, así que este teléfono no puede aprobar hasta que lo vuelvas a aprobar en tu navegador."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu sõrmejäljed muutusid või ühtegi ei tuvastatud, seega ei saa see telefon kinnitada enne, kui kinnitad selle brauseris uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos empreintes ont changé ou n'ont pas été reconnues : ce téléphone ne peut plus approuver tant que vous ne l'approuvez pas à nouveau dans votre navigateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טביעות האצבע שלך השתנו או שאף אחת לא זוהתה, ולכן הטלפון הזה לא יכול לאשר עד שתאשר אותו שוב בדפדפן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके फ़िंगरप्रिंट बदल गए, या कोई पहचाना नहीं गया, इसलिए यह फ़ोन तब तक मंज़ूर नहीं कर सकता जब तक आप इसे अपने ब्राउज़र में फिर मंज़ूर न करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši su se otisci prstiju promijenili ili nijedan nije prepoznat pa ovaj telefon ne može odobravati dok ga ponovno ne odobrite u pregledniku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ujjlenyomataid megváltoztak, vagy egyiket sem ismerte fel, ezért ez a telefon nem tud jóváhagyni, amíg újra jóvá nem hagyod a böngésződben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր մատնահետքերը փոխվել են, կամ ոչ մեկը չճանաչվեց, ուստի այս հեռախոսը չի կարող հաստատել, մինչև նորից չհաստատեք բրաուզերում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidik jari Anda berubah, atau tidak ada yang dikenali, jadi ponsel ini tidak dapat menyetujui sampai Anda menyetujuinya lagi di browser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue impronte sono cambiate, o nessuna è stata riconosciuta, quindi questo telefono non può approvare finché non lo approvi di nuovo nel browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指紋が変更されたか認識されなかったため、ブラウザでもう一度承認するまで、このスマートフォンでは承認できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი თითის ანაბეჭდები შეიცვალა ან არც ერთი არ ამოიცნო, ამიტომ ეს ტელეფონი ვერ დაამტკიცებს, სანამ ბრაუზერში ხელახლა არ დაამტკიცებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស្នាមម្រាមដៃរបស់អ្នកបានផ្លាស់ប្តូរ ឬគ្មានអ្វីត្រូវបានស្គាល់ ដូច្នេះទូរសព្ទនេះមិនអាចអនុម័តបានទេ រហូតដល់អ្នកអនុម័តវាម្តងទៀតក្នុងកម្មវិធីរុករករបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지문이 바뀌었거나 인식되지 않아, 브라우저에서 이 휴대폰을 다시 승인할 때까지 승인할 수 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍນິ້ວມືຂອງທ່ານປ່ຽນ ຫຼື ບໍ່ໄດ້ຮັບການຈື່ ສະນັ້ນໂທລະສັບນີ້ອະນຸມັດບໍ່ໄດ້ຈົນກວ່າທ່ານຈະອະນຸມັດມັນອີກໃນເບົາເຊີ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų piršto atspaudai pasikeitė arba nė vienas neatpažintas, todėl šis telefonas negali tvirtinti, kol jo dar kartą nepatvirtinsite naršyklėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavi pirkstu nospiedumi mainījās vai neviens netika atpazīts, tāpēc šis tālrunis nevar apstiprināt, kamēr tu to vēlreiz neapstiprini savā pārlūkā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоите отисоци се променија, или ниту еден не беше препознаен, па овој телефон не може да одобрува додека не го одобриш повторно во прелистувачот."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны хурууны хээ өөрчлөгдсөн, эсвэл ямар нь ч танигдаагүй тул та хөтөч дээрээ дахин зөвшөөрөх хүртэл энэ утас зөвшөөрч чадахгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंका फिंगरप्रिन्ट परिवर्तन भए, वा कुनै पहिचान भएन, त्यसैले तपाईंले ब्राउजरमा फेरि स्वीकृत नगरेसम्म यो फोनले स्वीकृत गर्न सक्दैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vingerafdrukken zijn gewijzigd of niet herkend, dus deze telefoon kan niet goedkeuren tot je hem opnieuw goedkeurt in je browser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odciski palców się zmieniły albo żaden nie został rozpoznany, więc ten telefon nie może zatwierdzać, dopóki nie zatwierdzisz go ponownie w przeglądarce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas impressões digitais mudaram, ou nenhuma foi reconhecida, por isso este telefone não pode aprovar até o aprovar novamente no seu navegador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas impressões digitais mudaram, ou nenhuma foi reconhecida, por isso este telefone não pode aprovar até o aprovar novamente no seu navegador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Amprentele dvs. s-au schimbat sau niciuna nu a fost recunoscută, așa că acest telefon nu poate aproba până nu îl aprobați din nou în browser."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše odtlačky prstov sa zmenili alebo žiadny nebol rozpoznaný, takže tento telefón nemôže schvaľovať, kým ho znova neschválite v prehliadači."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši prstni odtisi so se spremenili ali nobeden ni bil prepoznan, zato ta telefon ne more odobravati, dokler ga znova ne odobrite v brskalniku."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjurmët tuaja të gishtave ndryshuan, ose asnjë nuk u njoh, ndaj ky telefon nuk mund të miratojë derisa ta miratoni sërish në shfletuesin tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši otisci prstiju su promenjeni ili nijedan nije prepoznat, pa ovaj telefon ne može da odobrava dok ga ponovo ne odobrite u pregledaču."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลายนิ้วมือของคุณเปลี่ยนไป หรือไม่มีลายนิ้วมือใดถูกจดจำ โทรศัพท์เครื่องนี้จึงอนุมัติไม่ได้จนกว่าคุณจะอนุมัติอีกครั้งในเบราว์เซอร์"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Barmak yzlaryňyz üýtgedi ýa-da hiç biri tanalmady, şonuň üçin bu telefon brauzeriňizde täzeden tassyklaýançaňyz tassyklap bilmeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak izleriniz değişti veya hiçbiri tanınmadı, bu yüzden bu telefon, tarayıcınızda tekrar onaylayana kadar onay veremez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے فنگر پرنٹ بدل گئے، یا کوئی پہچانا نہیں گیا، اس لیے یہ فون تب تک منظور نہیں کر سکتا جب تک آپ اسے اپنے براؤزر میں دوبارہ منظور نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vân tay của bạn đã đổi, hoặc không có vân tay nào được nhận ra, nên điện thoại này không thể phê duyệt cho đến khi bạn phê duyệt lại nó trong trình duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的指紋已變更，或沒有辨識到任何指紋，因此在您於瀏覽器中重新核准之前，這部手機無法核准。"
          }
        }
      }
    },
