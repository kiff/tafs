        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានផ្អាក។ គ្មានអ្វីចេញទៀតទេ រហូតដល់អ្នកប្រាប់ខ្ញុំឱ្យបន្ត។"
