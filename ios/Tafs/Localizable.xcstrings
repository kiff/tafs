    "receipt.signed_on_device_why": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ilə, bu cihazı heç vaxt tərk etməyən açarla."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "С %1$@, с ключ, който никога не напуска това устройство."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přes %1$@, klíčem, který nikdy neopustí toto zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %1$@, durch einen Schlüssel, der dieses Gerät nie verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With %1$@, by a key that never leaves this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con %1$@, con una clave que nunca sale de este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ abil, võtmega, mis ei lahku kunagi sellest seadmest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec %1$@, par une clé qui ne quitte jamais cet appareil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz: %1$@, ključem koji nikad ne napušta ovaj uređaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel: %1$@, egy kulccsal, amely soha nem hagyja el ezt az eszközt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ով, բանալիով, որը երբեք չի լքում այս սարքը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan %1$@, oleh kunci yang tidak pernah meninggalkan perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con %1$@, con una chiave che non lascia mai questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@で、このデバイスから出ないキーにより署名。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ით, გასაღებით, რომელიც ამ მოწყობილობას არასოდეს ტოვებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(으)로, 이 기기를 떠나지 않는 키로 서명했습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · raktu, kuris niekada nepalieka šio įrenginio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar %1$@, ar atslēgu, kas nekad neatstāj šo ierīci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met %1$@, door een sleutel die dit apparaat nooit verlaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez %1$@, kluczem, który nigdy nie opuszcza tego urządzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com %1$@, por uma chave que nunca sai deste dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com %1$@, por uma chave que nunca sai deste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu %1$@, printr-o cheie care nu părăsește niciodată acest dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cez %1$@, kľúčom, ktorý nikdy neopustí toto zariadenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z %1$@, s ključem, ki nikoli ne zapusti te naprave."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Me %1$@, nga një çelës që nuk largohet kurrë nga kjo pajisje."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz: %1$@, ključem koji nikad ne napušta ovaj uređaj."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้วย %1$@ โดยกุญแจที่ไม่เคยออกจากอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ile, bu cihazdan asla çıkmayan bir anahtarla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bằng %1$@, với một khóa không bao giờ rời thiết bị này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以%1$@，由一把永遠不會離開這部裝置的金鑰簽署。"
          }
        }
      }
    },
