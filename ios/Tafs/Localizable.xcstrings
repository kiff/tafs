    "card.card_got_room_call_needed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-ına bu çağırışın tələb etdiyi yer verildi, bu cəm sıfırlanana qədər"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Неговата Card получи лимита, от който тази заявка имаше нужда, докато общият лимит не се нулира"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho Card dostala prostor, který toto volání potřebovalo, dokud se ten celkový limit nevynuluje"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Card hat den Spielraum bekommen, den dieser Aufruf brauchte, bis diese Summe zurückgesetzt wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its Card got the room this call needed, until that total resets"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su Card obtuvo el margen que necesitaba esta llamada, hasta que ese total se reinicie"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle Card sai ruumi, mida see päring vajas, kuni see kogusumma lähtestub"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Card a obtenu la marge dont cet appel avait besoin, jusqu'à la remise à zéro de ce total"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegov je Card dobio prostor koji je ovaj poziv trebao, do ponovnog postavljanja tog ukupnog iznosa"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cardja megkapta a hívásnak szükséges keretet, amíg az összesítő le nem nullázódik"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրա Card-ը ստացավ այն տարածքը, որ այս զանգին պետք էր, մինչև այդ ընդհանուրի վերակայումը"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-nya mendapat ruang yang dibutuhkan panggilan ini, sampai total itu diatur ulang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua Card ha ricevuto il margine che serviva a questa chiamata, finché quel totale non si azzera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計がリセットされるまで、この呼び出しに必要な枠がCardに追加されました"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისმა Card-მა მიიღო ადგილი, რომელიც ამ ზარს სჭირდებოდა, ამ ჯამის განულებამდე"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "합계가 초기화될 때까지 이 호출에 필요한 여유가 Card에 추가되었습니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo Card gavo šiai užklausai reikiamą rezervą, kol ta bendra suma bus atnaujinta"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā Card saņēma rezervi, kas bija vajadzīga šim izsaukumam, līdz šī kopsumma tiek atiestatīta"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zijn Card kreeg de ruimte die deze aanroep nodig had, tot dat totaal wordt gereset"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego Card dostała zapas, którego potrzebowało to wywołanie, do czasu wyzerowania tej sumy"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu Card recebeu a margem de que esta chamada precisava, até esse total ser reposto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu Card recebeu a margem de que esta chamada precisava, até esse total ser reposto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardul său a primit spațiul de care avea nevoie acest apel, până se resetează totalul"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho Card dostala priestor, ktorý toto volanie potrebovalo, kým sa ten celkový limit nevynuluje"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegova Card je dobila prostor, ki ga je ta klic potreboval, dokler se ta skupna vsota ne ponastavi"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-i i tij mori hapësirën që i duhej kësaj thirrjeje, deri sa të rivendoset ai total"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegov Card je dobio prostor koji je ovaj poziv tražio, do ponovnog postavljanja tog ukupnog iznosa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Card ของมันได้รับพื้นที่ที่การเรียกนี้ต้องการ จนกว่ายอดรวมนั้นจะรีเซ็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Card'ı, bu çağrının gerektirdiği payı, bu toplam sıfırlanana kadar aldı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Card của nó đã có đủ chỗ cho lượt gọi này, cho đến khi tổng đó được đặt lại"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的 Card 已獲得這次呼叫所需的額度，直到該總額重設"
          }
        }
      }
    },
