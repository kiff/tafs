    "halt_all.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält jeden taf sofort an. Nichts Neues wird gesendet, bis du sie in tafs fortsetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops every taf at once. Nothing new is sent until you resume them in tafs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea todos los tafs a la vez. No se envía nada nuevo hasta que los reanudes en tafs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque tous les tafs d'un coup. Rien de nouveau n'est envoyé tant que vous ne les reprenez pas dans tafs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca tutti i tafs in una volta. Non viene inviato nulla di nuovo finché non li riprendi in tafs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet alle tafs in één keer stil. Er wordt niets nieuws verzonden tot je ze in tafs hervat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuje wszystkie tafs naraz. Nic nowego nie zostanie wysłane, dopóki ich nie wznowisz w tafs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia todos os tafs de uma vez. Nada de novo é enviado até os retomar no tafs."
          }
        }
      }
    },
    "halt_all.failed": {
