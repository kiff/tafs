    "home.sample_foot": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispieldaten. Die Card wird auf diesem Telefon geprüft. Mit KIFF angemeldet entscheidet KIFF, und ein neuer taf beginnt in Coach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample data. The Card is checked on this phone. Signed in with KIFF, KIFF decides, and a new taf starts in Coach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de ejemplo. La Card se comprueba en este teléfono. Sesión iniciada con KIFF, KIFF decide, y un taf nuevo empieza en Coach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données d'exemple. La Card est vérifiée sur ce téléphone. Connecté avec KIFF, KIFF décide, et un nouveau taf commence dans Coach."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati di esempio. La Card viene verificata su questo telefono. Accesso effettuato con KIFF, KIFF decide, e un nuovo taf inizia in Coach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeeldgegevens. De Card wordt op deze telefoon gecontroleerd. Ingelogd met KIFF, KIFF beslist, en een nieuw taf begint in Coach."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane przykładowe. Card jest sprawdzana na tym telefonie. Po zalogowaniu przez KIFF decyduje KIFF, a nowy taf zaczyna się w Coachu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados de exemplo. O Card é verificado neste telefone. Com sessão iniciada no KIFF, o KIFF decide, e um novo taf começa no Coach."
          }
        }
      }
    },
