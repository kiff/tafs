        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs کے لیے تقریر کی شناخت بند ہے۔ اسے ترتیبات › پرائیویسی اور سیکیورٹی › تقریر کی شناخت میں چالو کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận dạng giọng nói đang tắt đối với tafs. Hãy bật trong Cài đặt › Quyền riêng tư & Bảo mật › Nhận dạng giọng nói."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音辨識已對 tafs 關閉。請在「設定」›「隱私權與安全性」›「語音辨識」中開啟。"
