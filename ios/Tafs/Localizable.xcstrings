    "settings.devices.signout_needs_approver": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ein anderes Gerät abzumelden, nutze ein Gerät, das genehmigen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To sign another device out, use a device that can approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cerrar la sesión de otro dispositivo, usa un dispositivo que pueda aprobar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teise seadme väljalogimiseks kasuta seadet, mis saab kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour déconnecter un autre appareil, utilisez un appareil qui peut approuver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per disconnettere un altro dispositivo, usa un dispositivo che può approvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスをサインアウトするには、承認できるデバイスを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기를 로그아웃하려면 승인할 수 있는 기기를 사용하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdami atjungti kitą įrenginį, naudokite įrenginį, kuris gali tvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai izrakstītu citu ierīci, izmanto ierīci, kas var apstiprināt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een apparaat dat kan goedkeuren om een ander apparaat uit te loggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wylogować inne urządzenie, użyj urządzenia, które może zatwierdzać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para terminar a sessão de outro dispositivo, use um dispositivo que possa aprovar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para terminar a sessão de outro dispositivo, use um dispositivo que possa aprovar."
          }
        }
      }
    },
