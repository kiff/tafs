    "taf.remove.done": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Zeitplan, seine Chats, Laufberichte, sein Gedächtnis und sein Schlüssel sind gelöscht, und der Name %1$@ ist frei. KIFFs Belege bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its schedule, chats, run reports, memory and key are deleted, and the name %1$@ is free. KIFF's receipts stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminaron su programación, sus chats, sus informes de ejecución, su memoria y su clave, y el nombre %1$@ queda libre. Los recibos de KIFF se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son planning, ses chats, ses rapports d'exécution, sa mémoire et sa clé sont supprimés, et le nom %1$@ redevient libre. Les reçus de KIFF restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua pianificazione, le chat, i resoconti delle esecuzioni, la memoria e la chiave vengono eliminati, e il nome %1$@ torna libero. Le ricevute di KIFF restano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De planning, chats, runrapporten, het geheugen en de sleutel zijn verwijderd, en de naam %1$@ is vrij. De ontvangstbewijzen van KIFF blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego harmonogram, czaty, raporty z uruchomień, pamięć i klucz zostały usunięte, a nazwa %1$@ jest wolna. Potwierdzenia KIFF zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu agendamento, chats, relatórios de execução, memória e chave foram eliminados, e o nome %1$@ está livre. Os recibos do KIFF mantêm-se."
          }
        }
      }
    },
    "taf.remove.finishes_on_refresh": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls das Entfernen begonnen hat, schließt tafs es bei der nächsten Aktualisierung ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the removal began, tafs finishes it the next time it refreshes."
          }
        },
        "es": {
