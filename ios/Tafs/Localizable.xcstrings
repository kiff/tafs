    "chat.jump_latest_something_new": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانتقال إلى الأحدث، يوجد جديد"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ən sonuncuya keçin, yenilik var"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Към най-новото, има нещо ново"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বশেষে যান, নতুন কিছু আছে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta a l'últim, hi ha alguna cosa nova"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejít na nejnovější, je tu něco nového"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Neuesten springen, es gibt etwas Neues"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump to the latest, something new"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir a lo más reciente, hay algo nuevo"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mine uusimale, on midagi uut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aller au plus récent, il y a du nouveau"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעבר לאחרון, יש משהו חדש"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे ताज़ा पर जाएँ, कुछ नया है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skočite na najnovije, ima nešto novo"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugrás a legújabbra, van valami új"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անցեք վերջինին, ինչ-որ նոր բան կա"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lompat ke yang terbaru, ada yang baru"
