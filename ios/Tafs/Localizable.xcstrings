    "alert.still_on_after_sign_out.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن tafs من إيقافها (%1$@). حاول مرة أخرى، أو سجّل الخروج على أي حال وأوقف إشعارات tafs من الإعدادات."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs onları söndürə bilmədi (%1$@). Yenidən cəhd edin və ya hər halda çıxış edin və Parametrlərdə tafs üçün bildirişləri söndürün."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs не успя да ги изключи (%1$@). Опитайте отново или излезте въпреки това и изключете известията за tafs в Настройки."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs সেগুলো বন্ধ করতে পারেনি (%1$@)। আবার চেষ্টা করুন, অথবা তবুও সাইন আউট করে সেটিংসে tafs-এর নোটিফিকেশন বন্ধ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs no les ha pogut desactivar (%1$@). Torna-ho a provar, o tanca la sessió igualment i desactiva les notificacions de tafs als Ajustos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs je nedokázal vypnout (%1$@). Zkuste to znovu, nebo se přesto odhlaste a vypněte oznámení pro tafs v Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs konnte sie nicht ausschalten (%1$@). Versuch es erneut oder melde dich trotzdem ab und schalte die Benachrichtigungen für tafs in den Einstellungen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs couldn't turn them off (%1$@). Try again, or sign out anyway and turn off notifications for tafs in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs no pudo desactivarlas (%1$@). Vuelve a intentarlo, o cierra sesión de todos modos y desactiva las notificaciones de tafs en Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ei saanud neid välja lülitada (%1$@). Proovi uuesti või logi siiski välja ja lülita seadetes tafsi teavitused välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs n'a pas pu les désactiver (%1$@). Réessayez, ou déconnectez-vous quand même et désactivez les notifications pour tafs dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs לא הצליח לכבות אותן (%1$@). יש לנסות שוב, או לצאת בכל זאת ולכבות את ההתראות של tafs בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs उन्हें बंद नहीं कर सका (%1$@)। दोबारा कोशिश करें, या फिर भी साइन आउट करें और सेटिंग में tafs की सूचनाएँ बंद करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ih nije mogao isključiti (%1$@). Pokušajte ponovno ili se svejedno odjavite i isključite obavijesti za tafs u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafs nem tudta kikapcsolni őket (%1$@). Próbáld újra, vagy jelentkezz ki mégis, és kapcsold ki a tafs értesítéseit a Beállításokban."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-ը չկարողացավ անջատել դրանք (%1$@). Նորից փորձեք կամ, միևնույն է, դուրս եկեք և անջատեք tafs-ի ծանուցումները Կարգավորումներում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs tidak dapat menonaktifkannya (%1$@). Coba lagi, atau tetap keluar dan nonaktifkan notifikasi untuk tafs di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs non è riuscito a disattivarli (%1$@). Riprova, oppure esci comunque e disattiva le notifiche per tafs in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsは通知をオフにできませんでした（%1$@）。もう一度試すか、このままサインアウトして、設定でtafsの通知をオフにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-მა ვერ გამორთო ისინი (%1$@). სცადეთ ხელახლა, ან მაინც გადით და პარამეტრებში გამორთეთ tafs-ის შეტყობინებები."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs មិនអាចបិទវាបានទេ (%1$@)។ សូមព្យាយាមម្តងទៀត ឬចាកចេញទោះយ៉ាងណាក៏ដោយ ហើយបិទការជូនដំណឹងសម្រាប់ tafs ក្នុងការកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs가 알림을 끄지 못했습니다(%1$@). 다시 시도하거나, 그래도 로그아웃한 뒤 설정에서 tafs의 알림을 끄세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ປິດມັນບໍ່ໄດ້ (%1$@). ລອງໃໝ່ ຫຼື ອອກຈາກລະບົບເລີຍ ແລ້ວປິດການແຈ້ງເຕືອນສຳລັບ tafs ໃນການຕັ້ງຄ່າ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nepavyko jų išjungti (%1$@). Bandykite dar kartą arba vis tiek atsijunkite ir išjunkite tafs pranešimus nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nevarēja tos izslēgt (%1$@). Mēģini vēlreiz vai tomēr izrakstieties un iestatījumos izslēdz paziņojumus no tafs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs не можеше да ги исклучи (%1$@). Обиди се повторно или сепак одјави се и исклучи ги известувањата за tafs во Поставки."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs тэдгээрийг унтрааж чадсангүй (%1$@). Дахин оролдох эсвэл ямар ч байсан гараад, Тохиргоонд tafs-ийн мэдэгдлийг унтраана уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ले तिनलाई बन्द गर्न सकेन (%1$@)। फेरि प्रयास गर्नुहोस्, वा जे भए पनि साइन आउट गरेर सेटिङमा tafs का सूचनाहरू बन्द गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs kon ze niet uitzetten (%1$@). Probeer het opnieuw, of log toch uit en zet meldingen voor tafs uit in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nie mógł ich wyłączyć (%1$@). Spróbuj ponownie albo mimo to wyloguj się i wyłącz powiadomienia tafs w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não conseguiu desativá-los (%1$@). Tente novamente, ou termine sessão na mesma e desative as notificações do tafs nas Definições."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não conseguiu desativá-los (%1$@). Tente novamente, ou saia mesmo assim e desative as notificações do tafs nas Configurações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nu le-a putut dezactiva (%1$@). Încercați din nou sau deconectați-vă oricum și dezactivați notificările pentru tafs în Configurări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ich nedokázal vypnúť (%1$@). Skúste to znova, alebo sa aj tak odhláste a vypnite upozornenia pre tafs v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs jih ni mogel izklopiti (%1$@). Poskusite znova ali se vseeno odjavite in v Nastavitvah izklopite obvestila za tafs."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nuk arriti t'i çaktivizojë (%1$@). Provoni sërish, ose dilni gjithsesi dhe çaktivizoni njoftimet për tafs te Cilësimet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nije mogao da ih isključi (%1$@). Pokušajte ponovo ili se ipak odjavite i isključite obaveštenja za tafs u Podešavanjima."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ปิดการแจ้งเตือนไม่ได้ (%1$@) ลองอีกครั้ง หรือออกจากระบบต่อไป แล้วปิดการแจ้งเตือนสำหรับ tafs ในการตั้งค่า"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs olary öçürip bilmedi (%1$@). Täzeden synanyşyň ýa-da her niçik hem çykyň we Sazlamalarda tafs üçin habarnamalary öçüriň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs bunları kapatamadı (%1$@). Tekrar deneyin ya da yine de oturumu kapatıp Ayarlar'dan tafs bildirimlerini kapatın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs انہیں بند نہیں کر سکا (%1$@)۔ دوبارہ کوشش کریں، یا پھر بھی سائن آؤٹ کریں اور سیٹنگز میں tafs کی اطلاعات بند کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs không tắt được chúng (%1$@). Hãy thử lại, hoặc vẫn đăng xuất rồi tắt thông báo cho tafs trong Cài đặt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs 無法關閉通知（%1$@）。請再試一次，或仍然登出，然後在「設定」中關閉 tafs 的通知。"
          }
        }
      }
    },
