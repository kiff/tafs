        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを読む前にあなたが停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전에 내가 멈췄습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutraukėte jį, kol jis to dar neperskaitė."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu to pārtrauci, pirms tas to izlasīja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt het gestopt voordat het dit las."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymano go, zanim to przeczytał."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parou-o antes de ele ler isto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parou-o antes de ele ler isto."
          }
