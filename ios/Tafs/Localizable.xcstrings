    "chrome.profile_note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs öz Chrome profilində işləyir. Orada yalnız tafs-ınızın istifadə etməsini istədiyiniz saytlara daxil olun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs работи в собствен профил на Chrome. Влизайте там само в сайтовете, които искате вашите tafs да използват."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs pracuje ve vlastním profilu Chromu. Přihlaste se v něm jen k webům, které mají vaše tafy používat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs arbeitet in einem eigenen Chrome-Profil. Melde dich dort nur bei den Websites an, die deine tafs nutzen sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs works in its own Chrome profile. Sign in there only to the sites you want your tafs to use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs trabaja en su propio perfil de Chrome. Inicia sesión ahí solo en los sitios que quieras que usen tus tafs."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs töötab oma Chrome'i profiilis. Logi seal sisse ainult saitidele, mida tahad, et su tafid kasutaksid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs travaille dans son propre profil Chrome. Connectez-vous-y uniquement aux sites que vos tafs doivent utiliser."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs radi u vlastitom Chromeovu profilu. Prijavite se u njemu samo na stranice koje želite da vaši tafovi koriste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafs saját Chrome-profilban dolgozik. Ott csak azokba a webhelyekbe jelentkezz be, amelyeket a tafjaidnak használniuk kell."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-ը աշխատում է իր սեփական Chrome պրոֆիլում։ Այնտեղ մուտք գործեք միայն այն կայքեր, որոնք ուզում եք, որ ձեր tafs-ը օգտագործի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs bekerja di profil Chrome-nya sendiri. Masuklah di sana hanya ke situs yang ingin Anda gunakan untuk tafs Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs lavora in un proprio profilo di Chrome. Lì accedi solo ai siti che vuoi far usare ai tuoi tafs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsは専用のChromeプロファイルで動作します。そこでは、tafsに使わせたいサイトだけにサインインしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs მუშაობს საკუთარ Chrome პროფილში. შედით იქ მხოლოდ იმ საიტებზე, რომელთა გამოყენებაც გსურთ თქვენს tafs-ს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs는 자체 Chrome 프로필에서 작동합니다. 그곳에서는 tafs가 사용할 사이트에만 로그인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs veikia savo Chrome profilyje. Ten prisijunkite tik prie svetainių, kurias norite, kad naudotų jūsų taf."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs strādā savā Chrome profilā. Piesakies tur tikai vietnēs, kuras vēlies, lai tavi taf izmanto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs werkt in een eigen Chrome-profiel. Log daar alleen in bij de sites die je tafs mogen gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs działa we własnym profilu Chrome. Loguj się tam tylko na strony, z których mają korzystać Twoje tafs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs trabalha no seu próprio perfil do Chrome. Inicie sessão aí apenas nos sites que quer que os seus tafs usem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs trabalha em seu próprio perfil do Chrome. Faça login lá apenas nos sites que você quer que seus tafs usem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs lucrează în propriul profil Chrome. Conectați-vă acolo doar la site-urile pe care vreți să le folosească tafurile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs pracuje vo vlastnom profile Chromu. Prihláste sa v ňom len na weby, ktoré majú vaše tafy používať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs dela v svojem profilu Chroma. Tam se prijavite samo na spletna mesta, ki naj jih uporabljajo vaši tafi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs punon në profilin e vet të Chrome. Hyni aty vetëm në sajtet që doni t'i përdorë tafs-i juaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs radi u svom Chrome profilu. Prijavite se tamo samo na sajtove koje želite da koristi vaš tafs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ทำงานในโปรไฟล์ Chrome ของมันเอง เข้าสู่ระบบที่นั่นเฉพาะเว็บไซต์ที่คุณต้องการให้ taf ใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs kendi Chrome profilinde çalışır. Orada yalnızca tafs'larınızın kullanmasını istediğiniz sitelerde oturum açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs làm việc trong hồ sơ Chrome riêng của nó. Chỉ đăng nhập ở đó vào các trang bạn muốn tafs của mình dùng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs 在它自己的 Chrome 設定檔中運作。請只在該設定檔中登入您想讓 taf 使用的網站。"
          }
        }
      }
    },
    "chrome.refused": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqa bir Chrome bu kodu istifadə etdi, ona görə heç nə cütləşmədi. Yenidən başlayın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Друг Chrome използва този код, така че нищо не беше сдвоено. Започнете отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kód použil jiný Chrome, takže se nic nespárovalo. Začněte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Chrome hat diesen Code benutzt, also wurde nichts gekoppelt. Fang noch einmal an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another Chrome used this code, so nothing was paired. Start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro Chrome usó este código, así que no se vinculó nada. Empieza de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda koodi kasutas teine Chrome, seega midagi ei seotud. Alusta uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre Chrome a utilisé ce code, rien n'a donc été associé. Recommencez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taj je kôd upotrijebio drugi Chrome pa ništa nije upareno. Počnite ispočetka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy másik Chrome használta ezt a kódot, így semmi sem lett párosítva. Kezdd újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեկ այլ Chrome օգտագործեց այս կոդը, ուստի ոչինչ չզուգակցվեց։ Սկսեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome lain memakai kode ini, jadi tidak ada yang dipasangkan. Mulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro Chrome ha usato questo codice, quindi non è stato associato nulla. Ricomincia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のChromeがこのコードを使ったため、何もペアリングされませんでした。もう一度やり直してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვა Chrome-მა გამოიყენა ეს კოდი, ამიტომ არაფერი დაწყვილდა. დაიწყეთ თავიდან."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Chrome이 이 코드를 사용해 아무것도 페어링되지 않았습니다. 다시 시작하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šį kodą panaudojo kita Chrome naršyklė, todėl niekas nesusieta. Pradėkite iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šo kodu izmantoja cits Chrome, tāpēc nekas netika savienots pārī. Sāc no jauna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere Chrome gebruikte deze code, dus er is niets gekoppeld. Begin opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny Chrome użył tego kodu, więc nic nie zostało powiązane. Zacznij od nowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro Chrome usou este código, por isso nada foi associado. Comece de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro Chrome usou este código, por isso nada foi associado. Comece de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alt Chrome a folosit acest cod, așa că nu s-a asociat nimic. Începeți din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kód použil iný Chrome, takže sa nič nespárovalo. Začnite znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To kodo je uporabil drug Chrome, zato ni bilo nič seznanjeno. Začnite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një Chrome tjetër e përdori këtë kod, ndaj asgjë nuk u çiftua. Filloni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi Chrome je upotrebio ovaj kôd, pa ništa nije upareno. Počnite ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มี Chrome อื่นใช้รหัสนี้แล้ว จึงยังไม่ได้จับคู่อะไร เริ่มใหม่อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kodu başka bir Chrome kullandı, bu yüzden hiçbir şey eşleştirilmedi. Baştan başlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một Chrome khác đã dùng mã này nên chưa có gì được ghép đôi. Hãy bắt đầu lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個 Chrome 使用了此代碼，因此未配對任何項目。請重新開始。"
          }
        }
      }
    },
