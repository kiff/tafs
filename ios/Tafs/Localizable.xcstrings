    "watch.mic_needed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um per Stimme zu fragen, erlaube tafs das Mikrofon auf dieser Uhr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To ask by voice, allow the microphone for tafs on this watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pedir con la voz, permite el micrófono a tafs en este reloj."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Häälega küsimiseks luba selles kellas tafsile mikrofon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour demander à la voix, autorisez le micro pour tafs sur cette montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per chiedere a voce, consenti il microfono a tafs su questo orologio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声で質問するには、このウォッチでtafsのマイク使用を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성으로 물으려면 이 워치에서 tafs의 마이크 사용을 허용하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad galėtumėte klausti balsu, šiame laikrodyje leiskite tafs naudoti mikrofoną."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai jautātu balsī, atļauj tafs izmantot mikrofonu šajā pulkstenī."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta de microfoon toe voor tafs op dit horloge om met je stem te vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby pytać głosem, zezwól tafs na mikrofon na tym zegarku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pedir por voz, autorize o microfone para o tafs neste relógio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pedir por voz, autorize o microfone para o tafs neste relógio."
          }
        }
      }
    },
