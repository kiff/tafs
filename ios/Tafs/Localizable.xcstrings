    "knob.listen_only_events_matching_filters": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمع فقط إلى الأحداث المطابقة لهذه المرشحات."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız bu filtrlərə uyğun hadisələri dinləyin."
          }
