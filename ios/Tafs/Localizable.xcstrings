        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ sur %1$@ de vous et des expéditeurs associés aujourd'hui. Texte uniquement : les pièces jointes ne sont pas ouvertes, et la réponse le précise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ su %1$@ da te e dai mittenti associati oggi. Solo testo: gli allegati non vengono aperti, e la risposta lo dice."
          }
        },
        "lt": {
          "stringUnit": {
