          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teavitused on peaaegu sees: tafs cloud ei vastanud (%1$@). Puuduta uuesti Lülita teavitused sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sont presque activées : tafs cloud n'a pas répondu (%1$@). Touchez à nouveau Activer les alertes."
