    "pair.view_only.lead": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ taf-larınızı, «Sizi gözləyir» bölməsini və Qeydləri göstərir. Onu telefonunuzla əlavə etməyincə təsdiq edə bilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този %1$@ показва вашите tafs, „Чака ви“ и Дневника. Не може да одобрява, докато не го добавите с телефона си."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento %1$@ ukazuje vaše tafy, Čeká na vás a Záznam. Schvalovat může až poté, co ho přidáte pomocí telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser %1$@ zeigt deine tafs, Braucht dich und das Protokoll. Genehmigen kann er erst, wenn du ihn mit deinem Handy hinzufügst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ shows your tafs, Needs you and the Record. It can't approve until you add it with your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ muestra tus tafs, Te necesita y el Registro. No puede aprobar hasta que lo añadas con tu teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See %1$@ näitab sinu tafisid, vaateid Vajab sind ja Logi. Kinnitada saab see alles siis, kui lisad selle telefoniga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ affiche vos tafs, Vous attend et le Registre. Il ne peut pas approuver tant que vous ne l'avez pas ajouté avec votre téléphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj %1$@ prikazuje vaše tafove, Čeka vas i Zapisnik. Ne može odobravati dok ga ne dodate pomoću telefona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz (%1$@) mutatja a tafjaidat, a Rád vár részt és a Naplót. Jóváhagyni csak akkor tud, ha hozzáadod a telefonoddal."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս սարքը (%1$@) ցույց է տալիս ձեր taf-երը, «Սպասում է ձեզ»-ը և Գրանցամատյանը։ Այն չի կարող հաստատել, մինչև չավելացնեք այն ձեր հեռախոսով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ini menampilkan tafs Anda, Menunggu Anda, dan Catatan. Tidak dapat menyetujui sampai Anda menambahkannya dengan ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo %1$@ mostra i tuoi tafs, Ti aspetta e il Registro. Non può approvare finché non lo aggiungi con il telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%1$@には、tafs、要確認、記録が表示されます。スマートフォンで追加するまで承認はできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოწყობილობა (%1$@) აჩვენებს თქვენს taf-ებს, „გელოდებათ“-ს და ჩანაწერს. ვერ დაამტკიცებს, სანამ თქვენი ტელეფონით არ დაამატებთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %1$@에는 tafs, 확인 필요, 기록이 표시됩니다. 휴대폰으로 추가하기 전까지는 승인할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis įrenginys (%1$@) rodo jūsų taf, „Laukia jūsų“ ir Žurnalą. Jis negali tvirtinti, kol nepridėsite jo telefonu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis %1$@ rāda tavus taf, sadaļu “Gaida tevi” un Žurnālu. Tas nevar apstiprināt, kamēr tu to nepievieno ar savu tālruni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %1$@ toont je tafs, Wacht op jou en het Logboek. Hij kan niets goedkeuren tot je hem toevoegt met je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten %1$@ pokazuje Twoje tafs, Czeka na Ciebie i Rejestr. Nie może zatwierdzać, dopóki nie dodasz go za pomocą telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ mostra os seus tafs, Precisa de si e o Registo. Não pode aprovar até o adicionar com o seu telemóvel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este %1$@ mostra os seus tafs, Precisa de você e o Registro. Não pode aprovar até o adicionar com o seu celular."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv (%1$@) afișează tafurile, Vă așteaptă și Jurnalul. Nu poate aproba până nu îl adăugați cu telefonul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento %1$@ ukazuje vaše tafy, Čaká na vás a Záznam. Schvaľovať môže až potom, čo ho pridáte pomocou telefónu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta %1$@ prikazuje vaše tafe, Čaka na vas in Dnevnik. Odobravati lahko šele, ko ga dodate s telefonom."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo pajisje (%1$@) shfaq tafs-et tuaj, Ju pret dhe Regjistrin. Nuk mund të miratojë derisa ta shtoni me telefonin tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj %1$@ prikazuje vaše tafove, Čeka vas i Zapisnik. Ne može odobravati dok ga ne dodate pomoću telefona."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@เครื่องนี้แสดง taf ของคุณ รอคุณอยู่ และบันทึก แต่อนุมัติไม่ได้จนกว่าคุณจะเพิ่มมันด้วยโทรศัพท์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@, tafs'larınızı, Sizi bekliyor'u ve Kayıt'ı gösterir. Telefonunuzla eklemediğiniz sürece onaylayamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ này hiển thị các tafs của bạn, Đang chờ bạn và Sổ ghi. Nó không thể phê duyệt cho đến khi bạn thêm nó bằng điện thoại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部%1$@會顯示您的 taf、「等您處理」和「紀錄」。在您用手機新增它之前，它無法核准。"
          }
        }
      }
    },
