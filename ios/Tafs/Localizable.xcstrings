        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ນີ້ບໍ່ມີລະຫັດຜ່ານ ແລະ %2$@ ຕ້ອງການມັນ. ຕັ້ງລະຫັດຜ່ານໃນ %3$@ ແລ້ວເພີ່ມ %4$@ ແລ້ວກັບມາ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis įrenginys (%1$@) neturi prieigos kodo, o jo reikia (%2$@). Nustatykite prieigos kodą (%3$@), tada pridėkite: %4$@, ir grįžkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šajā ierīcē (%1$@) nav piekļuves koda, bet %2$@ to prasa. Iestati piekļuves kodu: %3$@, tad pievieno %4$@ un atgriezies."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој %1$@ нема лозинка за уредот, а %2$@ бара една. Постави лозинка во %3$@, па додај %4$@, па врати се."
