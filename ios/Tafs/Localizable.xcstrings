    "record.not_sent_nothing_reached": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@، لكن تعذّر إرساله: لم يصل شيء إلى التطبيق"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, amma göndərilə bilmədi: tətbiqə heç nə çatmadı"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, но не можа да бъде изпратено: нищо не стигна до приложението"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, কিন্তু পাঠানো যায়নি: অ্যাপে কিছু পৌঁছায়নি"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, però no s'ha pogut enviar: no ha arribat res a l'aplicació"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ale nešlo to odeslat: do aplikace se nic nedostalo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, aber es konnte nicht gesendet werden: Nichts hat die App erreicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, but it couldn't be sent: nothing reached the app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, pero no se pudo enviar: nada llegó a la app"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, kuid seda ei saanud saata: midagi ei jõudnud rakenduseni"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, mais cela n'a pas pu être envoyé : rien n'a atteint l'app"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, אבל לא ניתן היה לשלוח: שום דבר לא הגיע לאפליקציה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, पर यह भेजा नहीं जा सका: ऐप तक कुछ नहीं पहुँचा"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ali nije se moglo poslati: ništa nije stiglo do aplikacije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, de nem lehetett elküldeni: semmi sem érte el az alkalmazást"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, բայց չկարողացավ ուղարկվել․ ոչինչ չհասավ հավելվածին"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, tetapi tidak dapat dikirim: tidak ada yang sampai ke aplikasi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ma non è stato possibile inviarla: nulla ha raggiunto l'app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、ただし送信できませんでした：アプリには何も届いていません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, მაგრამ ვერ გაიგზავნა: არაფერი მიაღწია აპს"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ប៉ុន្តែមិនអាចផ្ញើបានទេ៖ គ្មានអ្វីទៅដល់កម្មវិធីទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 하지만 보내지 못했습니다: 앱에 아무것도 도달하지 않았습니다"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ແຕ່ສົ່ງບໍ່ໄດ້: ບໍ່ມີຫຍັງເຖິງແອັບ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, bet jos nepavyko išsiųsti: niekas nepasiekė programėlės"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, bet to nevarēja nosūtīt: nekas nesasniedza lietotni"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, но не можеше да се испрати: ништо не стигна до апликацијата"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, гэхдээ илгээж чадсангүй: апп-д юу ч хүрээгүй"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, तर पठाउन सकिएन: एपमा केही पुगेन"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, maar het kon niet worden verzonden: niets heeft de app bereikt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ale nie udało się tego wysłać: nic nie dotarło do aplikacji"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, mas não foi possível enviar: nada chegou à app"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, mas não foi possível enviar: nada chegou ao app"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, dar nu a putut fi trimis: nimic nu a ajuns la aplicație"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ale nedalo sa to odoslať: do aplikácie sa nič nedostalo"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, a tega ni bilo mogoče poslati: nič ni doseglo aplikacije"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, por nuk u dërgua dot: asgjë nuk arriti te aplikacioni"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ali nije se moglo poslati: ništa nije stiglo do aplikacije"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ แต่ส่งไม่ได้: ไม่มีอะไรไปถึงแอป"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ýöne ibermek mümkin bolmady: programma hiç zat ýetmedi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ama gönderilemedi: uygulamaya hiçbir şey ulaşmadı"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@، مگر بھیجا نہیں جا سکا: ایپ تک کچھ نہیں پہنچا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, nhưng không gửi được: không có gì đến được ứng dụng"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，但無法傳送：沒有任何內容傳達到 App"
          }
        }
      }
    },
