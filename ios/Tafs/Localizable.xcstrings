    "sample.deploys.job": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe gemergte Fixes in die Produktion, wenn CI grün ist, und rolle zurück, wenn die Fehler steigen. Produktionsdaten nie verwerfen oder löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ship merged fixes to production when CI is green, and roll back when errors spike. Never drop or delete production data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva a producción las correcciones fusionadas cuando CI esté en verde, y revierte cuando se disparen los errores. Nunca borres ni elimines datos de producción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Livrer en production les correctifs fusionnés quand la CI est au vert, et revenir en arrière quand les erreurs grimpent. Ne jamais supprimer de données de production."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta in produzione le correzioni unite quando la CI è verde, e torna indietro quando gli errori aumentano. Non eliminare né cancellare mai dati di produzione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet gemergede fixes in productie als CI groen is, en draai terug als het aantal fouten piekt. Verwijder nooit productiedata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wdrażaj scalone poprawki na produkcję, gdy CI jest zielone, i wycofuj je, gdy błędy gwałtownie rosną. Nigdy nie usuwaj danych produkcyjnych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar para produção as correções integradas quando a CI estiver verde, e reverter quando os erros dispararem. Nunca apagar nem eliminar dados de produção."
          }
        }
      }
    },
