    "coach.connect_admin_only": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يربط التطبيقات إلا مسؤول في حساب KIFF هذا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız bu KIFF hesabının administratoru tətbiq qoşa bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само администратор на този акаунт в KIFF може да свързва приложения."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু এই KIFF অ্যাকাউন্টের অ্যাডমিন অ্যাপ সংযুক্ত করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només un administrador d'aquest compte de KIFF pot connectar aplicacions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace může připojovat jen správce tohoto účtu KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Admin dieses KIFF-Kontos kann Apps verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an admin of this KIFF account can connect apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un administrador de esta cuenta de KIFF puede conectar apps."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendusi saab ühendada ainult selle KIFFi konto administraator."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un administrateur de ce compte KIFF peut connecter des apps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק מנהל של חשבון KIFF הזה יכול לחבר אפליקציות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल इस KIFF खाते का एडमिन ऐप जोड़ सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije može povezivati samo administrator ovog KIFF računa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkalmazásokat csak ennek a KIFF-fióknak egy adminja csatlakoztathat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածներ կարող է միացնել միայն այս KIFF հաշվի ադմինիստրատորը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya admin akun KIFF ini yang dapat menghubungkan aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un amministratore di questo account KIFF può collegare app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを接続できるのは、このKIFFアカウントの管理者のみです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპების დაკავშირება მხოლოდ ამ KIFF ანგარიშის ადმინისტრატორს შეუძლია."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មានតែអ្នកគ្រប់គ្រងនៃគណនី KIFF នេះប៉ុណ្ណោះដែលអាចភ្ជាប់កម្មវិធី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 KIFF 계정의 관리자만 앱을 연결할 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມີແຕ່ຜູ້ດູແລບັນຊີ KIFF ນີ້ທີ່ເຊື່ອມຕໍ່ແອັບໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programėles prijungti gali tik šios KIFF paskyros administratorius."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotnes var pievienot tikai šī KIFF konta administrators."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Само администратор на оваа сметка на KIFF може да поврзува апликации."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөвхөн KIFF-ийн энэ бүртгэлийн админ апп холбож чадна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यस KIFF खाताका एडमिनले मात्र एप जडान गर्न सक्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een beheerder van dit KIFF-account kan apps koppelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko administrator tego konta KIFF może łączyć aplikacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só um administrador desta conta KIFF pode ligar apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só um administrador desta conta KIFF pode conectar apps."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar un administrator al acestui cont KIFF poate conecta aplicații."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácie môže pripájať len správca tohto účtu KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije lahko poveže samo skrbnik tega računa KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetëm një administrator i kësaj llogarie KIFF mund të lidhë aplikacione."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije može povezivati samo administrator ovog KIFF naloga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะผู้ดูแลระบบของบัญชี KIFF นี้เท่านั้นที่เชื่อมต่อแอปได้"
          }
