    "settings.devices.note": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazı çıxış etdirmək onun bu hesabdakı girişini dərhal bitirir. Bu telefonu çıxış etdirmək üçün Hesabda Çıxış seçin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Извеждането на устройство прекратява входа му в този акаунт веднага. За да изведете този телефон, използвайте „Изход“ в Акаунт."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlášení zařízení hned ukončí jeho přihlášení k tomuto účtu. Tento telefon odhlásíte přes Odhlásit se v Účtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Gerät abmeldest, endet seine Anmeldung bei diesem Konto sofort. Um dieses Telefon abzumelden, nutze „Abmelden“ unter „Konto“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing a device out ends its sign-in on this account at once. To sign out this phone, use Sign out in Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar la sesión de un dispositivo termina al instante su inicio de sesión en esta cuenta. Para cerrar la sesión de este teléfono, usa Cerrar sesión en Cuenta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadme väljalogimine lõpetab kohe selle sisselogimise sellel kontol. Selle telefoni väljalogimiseks kasuta vaates Konto valikut Logi välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter un appareil met fin immédiatement à sa connexion sur ce compte. Pour déconnecter ce téléphone, utilisez Se déconnecter dans Compte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava uređaja odmah završava njegovu prijavu na ovom računu. Da odjavite ovaj telefon, upotrijebite Odjava u Računu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy eszköz kijelentkeztetése azonnal megszünteti a bejelentkezését ebben a fiókban. Ennek a telefonnak a kijelentkeztetéséhez használd a Fiók részben a Kijelentkezést."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սարքը դուրս բերելը անմիջապես ավարտում է նրա մուտքը այս հաշվում։ Այս հեռախոսը դուրս բերելու համար օգտագործեք «Ելք»-ը Հաշվում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengeluarkan sebuah perangkat langsung mengakhiri proses masuknya di akun ini. Untuk keluar dari ponsel ini, gunakan Keluar di Akun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnettere un dispositivo termina subito il suo accesso a questo account. Per disconnettere questo telefono, usa Esci in Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスをサインアウトすると、このアカウントでのサインインがすぐに終了します。このスマートフォンをサインアウトするには、アカウントの「サインアウト」を使ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოწყობილობის გამოყვანა მის შესვლას ამ ანგარიშზე მაშინვე წყვეტს. ამ ტელეფონის გამოსაყვანად გამოიყენეთ „გასვლა“ ანგარიშში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 로그아웃하면 이 계정에서 그 기기의 로그인이 즉시 끝납니다. 이 휴대폰을 로그아웃하려면 계정에서 로그아웃을 사용하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atjungus įrenginį, jo prisijungimas prie šios paskyros iškart baigiamas. Norėdami atjungti šį telefoną, skiltyje „Paskyra“ naudokite „Atsijungti“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izrakstot ierīci, tās pierakstīšanās šajā kontā tiek nekavējoties beigta. Lai izrakstītu šo tālruni, sadaļā Konts izmanto “Izrakstīties”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een apparaat uitloggen beëindigt meteen de login ervan op dit account. Gebruik Uitloggen in Account om deze telefoon uit te loggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowanie urządzenia natychmiast kończy jego logowanie na tym koncie. Aby wylogować ten telefon, użyj Wyloguj w sekcji Konto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar a sessão de um dispositivo termina de imediato o seu início de sessão nesta conta. Para terminar a sessão neste telefone, use Terminar sessão em Conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerrar a sessão de um dispositivo encerra imediatamente o login dele nesta conta. Para encerrar a sessão neste telefone, use Sair em Conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectarea unui dispozitiv îi încheie imediat conectarea la acest cont. Pentru a deconecta acest telefon, folosiți Deconectați-vă din Cont."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásenie zariadenia hneď ukončí jeho prihlásenie k tomuto účtu. Tento telefón odhlásite cez Odhlásiť sa v Účte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava naprave takoj konča njeno prijavo v ta račun. Ta telefon odjavite z Odjava v Računu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Daljet e një pajisjeje e mbyll hyrjen e saj në këtë llogari menjëherë. Për ta nxjerrë këtë telefon, përdorni Dalje te Llogaria."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava uređaja odmah završava njegovu prijavu na ovom nalogu. Da odjavite ovaj telefon, upotrebite Odjava u Nalogu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การออกจากระบบอุปกรณ์จะสิ้นสุดการเข้าสู่ระบบของอุปกรณ์นั้นบนบัญชีนี้ทันที หากต้องการออกจากระบบโทรศัพท์เครื่องนี้ ให้ใช้ออกจากระบบในบัญชี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir cihazın oturumunu kapatmak, bu hesaptaki oturumunu hemen sonlandırır. Bu telefonun oturumunu kapatmak için Hesap'taki Oturumu kapat'ı kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng xuất một thiết bị sẽ chấm dứt ngay phiên đăng nhập của nó trên tài khoản này. Để đăng xuất điện thoại này, hãy dùng Đăng xuất trong Tài khoản."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出裝置會立即結束它在此帳號上的登入。若要登出這部手機，請使用「帳號」中的「登出」。"
          }
        }
      }
    },
    "settings.devices.note_device": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazı çıxış etdirmək onun bu hesabdakı girişini dərhal bitirir. Bu %1$@ çıxış etdirmək üçün KIFF-dən çıxış seçin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Извеждането на устройство прекратява входа му в този акаунт веднага. За да изведете този %1$@, използвайте „Изход от KIFF“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlášení zařízení hned ukončí jeho přihlášení k tomuto účtu. Toto zařízení (%1$@) odhlásíte přes Odhlásit se z KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Gerät abmeldest, endet seine Anmeldung bei diesem Konto sofort. Um dieses %1$@ abzumelden, nutze „Von KIFF abmelden“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing a device out ends its sign-in on this account at once. To sign out this %1$@, use Sign out of KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar la sesión de un dispositivo termina al instante su inicio de sesión en esta cuenta. Para cerrar la sesión de este %1$@, usa Cerrar sesión de KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadme väljalogimine lõpetab kohe selle sisselogimise sellel kontol. Selle seadme (%1$@) väljalogimiseks kasuta valikut Logi KIFFist välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter un appareil met fin immédiatement à sa connexion sur ce compte. Pour déconnecter %2$@, utilisez Se déconnecter de KIFF."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava uređaja odmah završava njegovu prijavu na ovom računu. Da odjavite ovaj uređaj (%1$@), upotrijebite Odjava iz KIFF-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy eszköz kijelentkeztetése azonnal megszünteti a bejelentkezését ebben a fiókban. Ennek az eszköznek (%1$@) a kijelentkeztetéséhez használd a Kijelentkezés a KIFF-ből lehetőséget."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սարքը դուրս բերելը անմիջապես ավարտում է նրա մուտքը այս հաշվում։ Այս սարքը (%1$@) դուրս բերելու համար օգտագործեք «Ելք KIFF-ից»։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengeluarkan sebuah perangkat langsung mengakhiri proses masuknya di akun ini. Untuk keluar dari %1$@ ini, gunakan Keluar dari KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnettere un dispositivo termina subito il suo accesso a questo account. Per disconnettere questo %1$@, usa Esci da KIFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスをサインアウトすると、このアカウントでのサインインがすぐに終了します。この%1$@をサインアウトするには、「KIFFからサインアウト」を使ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოწყობილობის გამოყვანა მის შესვლას ამ ანგარიშზე მაშინვე წყვეტს. ამ მოწყობილობის (%1$@) გამოსაყვანად გამოიყენეთ „გასვლა KIFF-იდან“."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 로그아웃하면 이 계정에서 그 기기의 로그인이 즉시 끝납니다. 이 %1$@을(를) 로그아웃하려면 KIFF에서 로그아웃을 사용하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atjungus įrenginį, jo prisijungimas prie šios paskyros iškart baigiamas. Norėdami atjungti šį įrenginį (%1$@), naudokite „Atsijungti nuo KIFF“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izrakstot ierīci, tās pierakstīšanās šajā kontā tiek nekavējoties beigta. Lai izrakstītu šo ierīci (%1$@), izmanto “Izrakstīties no KIFF”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een apparaat uitloggen beëindigt meteen de login ervan op dit account. Gebruik Uitloggen bij KIFF om deze %1$@ uit te loggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowanie urządzenia natychmiast kończy jego logowanie na tym koncie. Aby wylogować to urządzenie (%1$@), użyj Wyloguj z KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar a sessão de um dispositivo termina de imediato o seu início de sessão nesta conta. Para terminar a sessão neste %1$@, use Terminar sessão no KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerrar a sessão de um dispositivo encerra imediatamente o login dele nesta conta. Para encerrar a sessão neste %1$@, use Sair no KIFF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectarea unui dispozitiv îi încheie imediat conectarea la acest cont. Pentru a deconecta acest dispozitiv (%1$@), folosiți Deconectați-vă de la KIFF."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásenie zariadenia hneď ukončí jeho prihlásenie k tomuto účtu. Toto zariadenie (%1$@) odhlásite cez Odhlásiť sa z KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava naprave takoj konča njeno prijavo v ta račun. To napravo (%1$@) odjavite z Odjava iz KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Daljet e një pajisjeje e mbyll hyrjen e saj në këtë llogari menjëherë. Për ta nxjerrë këtë pajisje (%1$@), përdorni Dalje nga KIFF."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava uređaja odmah završava njegovu prijavu na ovom nalogu. Da odjavite ovaj uređaj (%1$@), upotrebite Odjava iz KIFF-a."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การออกจากระบบอุปกรณ์จะสิ้นสุดการเข้าสู่ระบบของอุปกรณ์นั้นบนบัญชีนี้ทันที หากต้องการออกจากระบบ%1$@เครื่องนี้ ให้ใช้ออกจากระบบ KIFF"
          }
        },
        "tr": {
          "stringUnit": {
