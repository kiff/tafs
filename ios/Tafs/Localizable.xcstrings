    "receipt.signs_within": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF qəbzləri qərardan sonra bir dəqiqə ərzində imzalayır. Bir azdan yenidən yoxlayın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF подписва разписките до минута след решението. Проверете отново скоро."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF podepisuje potvrzení do minuty od rozhodnutí. Zkontrolujte to za chvíli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF signiert Belege innerhalb einer Minute nach der Entscheidung. Prüfe gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF signs receipts within a minute of deciding. Check again shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF firma los recibos en menos de un minuto tras decidir. Vuelve a comprobarlo en breve."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF allkirjastab kviitungid minuti jooksul pärast otsust. Kontrolli varsti uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF signe les reçus dans la minute qui suit sa décision. Vérifiez à nouveau d'ici peu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF potpisuje potvrde unutar minute od odluke. Provjerite ponovno uskoro."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF a döntést követő egy percen belül aláírja a nyugtákat. Nézd meg újra hamarosan."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը անդորրագրերը ստորագրում է որոշումից մեկ րոպեի ընթացքում։ Ստուգեք նորից շուտով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF menandatangani tanda terima dalam semenit setelah memutuskan. Periksa lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF firma le ricevute entro un minuto dalla decisione. Verifica di nuovo tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFは決定から1分以内に領収書に署名します。少し待ってからもう一度確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ქვითრებს გადაწყვეტიდან ერთ წუთში აწერს ხელს. შეამოწმეთ ხელახლა მალე."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF는 결정 후 1분 이내에 영수증에 서명합니다. 잠시 후 다시 확인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF pasirašo kvitus per minutę nuo sprendimo. Netrukus patikrinkite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF paraksta kvītis minūtes laikā pēc lēmuma. Drīz pārbaudi vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ondertekent ontvangstbewijzen binnen een minuut na de beslissing. Controleer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF podpisuje potwierdzenia w ciągu minuty od decyzji. Sprawdź ponownie za chwilę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF assina os recibos no prazo de um minuto após decidir. Verifique novamente daqui a pouco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF assina os recibos no prazo de um minuto após decidir. Verifique novamente daqui a pouco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF semnează chitanțele în cel mult un minut de la decizie. Verificați din nou în curând."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF podpisuje potvrdenia do minúty od rozhodnutia. Skontrolujte to o chvíľu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF podpiše potrdila v minuti po odločitvi. Kmalu preverite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF i nënshkruan dëftesat brenda një minute nga vendimi. Kontrolloni sërish së shpejti."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF potpisuje potvrde unutar minute od odluke. Proverite ponovo uskoro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ลงนามใบเสร็จภายในหนึ่งนาทีหลังตัดสินใจ ตรวจสอบอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF makbuzları karardan sonra bir dakika içinde imzalar. Biraz sonra tekrar kontrol edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ký biên nhận trong vòng một phút sau khi quyết định. Hãy kiểm tra lại sau."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF 會在做出決定後一分鐘內簽署收據。請稍後再檢查。"
          }
        }
      }
    },
