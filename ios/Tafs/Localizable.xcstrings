    "knob.subscription_made_dial_has_not": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنشاء الاشتراك، لكن القرص لم يسجّله بعد. حاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Abunəlik yaradıldı, amma çevirici onu hələ qeyd etməyib. Yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Абонаментът е създаден, но скалата още не го е записала. Опитайте отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাবস্ক্রিপশন তৈরি হয়েছে, কিন্তু ডায়াল এখনও তা রেকর্ড করেনি। আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La subscripció s'ha creat, però el selector encara no l'ha registrada. Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odběr se vytvořil, ale číselník ho ještě nezaznamenal. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abonnement wurde angelegt, aber das Rad hat es noch nicht festgehalten. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription was made, but the dial hasn't recorded it yet. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se hizo, pero la rueda aún no la ha registrado. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tellimus loodi, kuid valikuketas pole seda veel salvestanud. Proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement a été créé, mais la molette ne l'a pas encore enregistré. Réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המנוי נוצר, אבל החוגה עדיין לא רשמה אותו. יש לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यता बन गई, पर डायल ने अभी इसे दर्ज नहीं किया। फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretplata je napravljena, ali je brojčanik još nije zabilježio. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előfizetés létrejött, de a tárcsa még nem rögzítette. Próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բաժանորդագրությունը ստեղծվեց, բայց թվատախտակը դեռ չի գրանցել այն։ Փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan dibuat, tetapi dial belum mencatatnya. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'iscrizione è stata fatta, ma il quadrante non l'ha ancora registrata. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購読は作成されましたが、まだダイヤルに記録されていません。もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოწერა შეიქმნა, მაგრამ ციფერბლატს ის ჯერ არ ჩაუწერია. სცადეთ ხელახლა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជាវត្រូវបានធ្វើ ប៉ុន្តែកុងតាក់មិនទាន់កត់ត្រាវានៅឡើយ។ សូមព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 만들어졌지만 다이얼에 아직 기록되지 않았습니다. 다시 시도하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການສະໝັກຖືກສ້າງແລ້ວ ແຕ່ປຸ່ມໝຸນຍັງບໍ່ໄດ້ບັນທຶກມັນ. ລອງໃໝ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerata sukurta, bet ratukas jos dar neįrašė. Bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonements tika izveidots, bet ripa to vēl nav reģistrējusi. Mēģini vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Претплатата е направена, но селекторот сè уште не ја запишал. Обиди се повторно."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүртгэл үүссэн боловч товчлуур үүнийг одоохондоо бүртгээгүй. Дахин оролдоно уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यता बन्यो, तर डायलले अहिलेसम्म यो दर्ता गरेको छैन। फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het abonnement is gemaakt, maar de draaiknop heeft het nog niet vastgelegd. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja została utworzona, ale pokrętło jeszcze jej nie zapisało. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A subscrição foi feita, mas o seletor ainda não a registou. Tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura foi feita, mas o seletor ainda não a registrou. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonamentul a fost creat, dar cadranul nu l-a înregistrat încă. Încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odber sa vytvoril, ale číselník ho ešte nezaznamenal. Skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naročnina je bila ustvarjena, a je številčnica še ni zabeležila. Poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonimi u bë, por cilësimi ende nuk e ka regjistruar. Provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretplata je napravljena, ali je brojčanik još nije zabilježio. Pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างการสมัครรับข้อมูลแล้ว แต่ปุ่มหมุนยังไม่ได้บันทึก ลองอีกครั้ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Abuna edildi, ýöne teker ony heniz ýazmady. Täzeden synanyşyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelik yapıldı ama kadran henüz kaydetmedi. Tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سبسکرپشن بن گئی، مگر ڈائل نے اسے ابھی درج نہیں کیا۔ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký đã được tạo, nhưng núm xoay chưa ghi lại. Hãy thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱已建立，但旋鈕尚未記錄。請再試一次。"
          }
        }
      }
    },
