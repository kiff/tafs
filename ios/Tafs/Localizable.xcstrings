    "sample.refunds.job": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledige Erstattungs- und Gutschriftanfragen aus der Support-Warteschlange. Nie mehr als die ursprüngliche Zahlung erstatten, nie zweimal, nie bei einer reklamierten Zahlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settle refund and credit requests from the support queue. Never refund more than the original charge, never twice, never on a disputed charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve solicitudes de reembolso y abono de la cola de soporte. Nunca reembolses más que el cargo original, nunca dos veces, nunca en un cargo en disputa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traiter les demandes de remboursement et d'avoir de la file du support. Ne jamais rembourser plus que le paiement d'origine, jamais deux fois, jamais sur un paiement contesté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci le richieste di rimborso e di credito dalla coda dell'assistenza. Non rimborsare mai più dell'addebito originale, mai due volte, mai su un addebito contestato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handel verzoeken om terugbetaling en tegoed uit de supportwachtrij af. Betaal nooit meer terug dan de oorspronkelijke betaling, nooit twee keer en nooit bij een betwiste betaling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpatruj prośby o zwrot i uznanie z kolejki wsparcia. Nigdy nie zwracaj więcej niż pierwotne obciążenie, nigdy dwa razy i nigdy przy spornym obciążeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolver pedidos de reembolso e de crédito da fila de suporte. Nunca reembolsar mais do que a cobrança original, nunca duas vezes, nunca numa cobrança em disputa."
          }
        }
      }
    },
