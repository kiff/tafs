        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie. Qualcuno di KIFF leggerà la tua segnalazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。KIFFの担当者が報告を読みます。"
