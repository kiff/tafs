    "chrome.release_sensitive": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا موقع حساس لم تسمح به لهذا Chrome، لذا لا يمكن السماح به."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bu Chrome üçün icazə vermədiyiniz həssas saytdır, ona görə icazə verilə bilməz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е чувствителен сайт, който не сте разрешили за този Chrome, затова не може да се разреши."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি একটি সংবেদনশীল সাইট যা আপনি এই Chrome-এর জন্য অনুমতি দেননি, তাই অনুমতি দেওয়া যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "És un lloc sensible que no has permès per a aquest Chrome, així que no es pot permetre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jde o citlivý web, který jste pro tento Chrome nepovolili, proto ho nelze povolit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine sensible Website, die du für dieses Chrome nicht erlaubt hast, daher kann es nicht erlaubt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a sensitive site you haven't allowed for this Chrome, so it can't be allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un sitio sensible que no permitiste para este Chrome, así que no se puede permitir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on tundlik sait, mida sa pole selle Chrome'i jaoks lubanud, seega ei saa seda lubada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un site sensible que vous n'avez pas autorisé pour ce Chrome, il ne peut donc pas être autorisé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה אתר רגיש שלא אישרת ל-Chrome הזה, ולכן אי אפשר לאשר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक संवेदनशील साइट है जिसकी आपने इस Chrome के लिए अनुमति नहीं दी है, इसलिए इसकी अनुमति नहीं दी जा सकती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je osjetljiva web-stranica koju niste dopustili za ovaj Chrome, pa se ne može dopustiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy érzékeny webhely, amelyet nem engedélyezett ehhez a Chrome-hoz, ezért nem engedélyezhető."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա զգայուն կայք է, որը դուք չեք թույլատրել այս Chrome-ի համար, ուստի այն հնարավոր չէ թույլատրել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini situs sensitif yang belum Anda izinkan untuk Chrome ini, jadi tidak bisa diizinkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un sito sensibile che non hai consentito per questo Chrome, quindi non può essere consentita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このChromeで許可していない重要なサイトのため、許可できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მგრძნობიარე საიტია, რომელიც ამ Chrome-ისთვის არ დაგიშვიათ, ამიტომ მისი დაშვება შეუძლებელია."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នេះជាគេហទំព័ររសើបដែលអ្នកមិនបានអនុញ្ញាតសម្រាប់ Chrome នេះ ដូច្នេះមិនអាចអនុញ្ញាតបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Chrome에 허용하지 않은 민감한 사이트라 허용할 수 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ນີ້ແມ່ນເວັບໄຊທີ່ລະອຽດອ່ອນທີ່ທ່ານບໍ່ໄດ້ອະນຸຍາດສຳລັບ Chrome ນີ້ ຈຶ່ງອະນຸຍາດບໍ່ໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai jautri svetainė, kurios neleidote šiam Chrome, todėl jo leisti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī ir sensitīva vietne, ko neesat atļāvis šim Chrome, tāpēc to nevar atļaut."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова е чувствителна страница што не сте ја дозволиле за овој Chrome, па не може да се дозволи."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ бол та энэ Chrome-д зөвшөөрөөгүй эмзэг сайт тул зөвшөөрөх боломжгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो तपाईंले यस Chrome का लागि अनुमति नदिएको संवेदनशील साइट हो, त्यसैले अनुमति दिन सकिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een gevoelige site die je voor deze Chrome niet hebt toegestaan, dus kan ze niet worden toegestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wrażliwa witryna, na którą nie zezwolono dla tego Chrome, więc nie można na nie zezwolić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É um site sensível que não permitiu para este Chrome, por isso não pode ser permitido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É um site sensível que você não permitiu para este Chrome, então não pode ser permitido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este un site sensibil pe care nu l-ai permis pentru acest Chrome, deci nu poate fi permisă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ide o citlivú stránku, ktorú ste pre tento Chrome nepovolili, preto ho nemožno povoliť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je občutljivo spletno mesto, ki ga za ta Chrome niste dovolili, zato je ni mogoče dovoliti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky është një sajt i ndjeshëm që nuk e keni lejuar për këtë Chrome, ndaj nuk mund të lejohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je osetljiv sajt koji niste dozvolili za ovaj Chrome, pa ne može da se dozvoli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือเว็บไซต์ที่มีความอ่อนไหวซึ่งคุณยังไม่ได้อนุญาตสำหรับ Chrome นี้ จึงอนุญาตไม่ได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu siziň bu Chrome üçin rugsat bermedik duýgur saýtyňyz, şonuň üçin oňa rugsat berip bolmaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bu Chrome için izin vermediğiniz hassas bir site, bu yüzden izin verilemez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ایک حساس سائٹ ہے جس کی آپ نے اس Chrome کے لیے اجازت نہیں دی، اس لیے اس کی اجازت نہیں دی جا سکتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là trang web nhạy cảm mà bạn chưa cho phép với Chrome này nên không thể cho phép."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是你未替這個 Chrome 允許的敏感網站，因此無法允許。"
          }
        }
      }
    },
