    "sample.refunds.job": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəstək növbəsindən geri ödəniş və kredit sorğularını həll edin. İlkin ödənişdən çox heç vaxt geri ödəməyin, heç vaxt iki dəfə, mübahisəli ödənişdə heç vaxt."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Уреждайте заявките за възстановяване и кредит от опашката на поддръжката. Никога не възстановявайте повече от първоначалното плащане, никога два пъти, никога за оспорено плащане."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyřizovat žádosti o vrácení peněz a dobropisy z fronty podpory. Nikdy nevracet víc než původní platbu, nikdy dvakrát, nikdy u sporné platby."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledige Erstattungs- und Gutschriftanfragen aus der Support-Warteschlange. Nie mehr als die ursprüngliche Zahlung erstatten, nie zweimal, nie bei einer reklamierten Zahlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settle refund and credit requests from the support queue. Never refund more than the original charge, never twice, never on a disputed charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve solicitudes de reembolso y abono de la cola de soporte. Nunca reembolses más que el cargo original, nunca dos veces, nunca en un cargo en disputa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahenda klienditoe järjekorrast tulevad tagasimakse- ja krediiditaotlused. Ära kunagi tagasta rohkem kui algne makse, ära kunagi kaks korda ega vaidlustatud makse puhul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traiter les demandes de remboursement et d'avoir de la file du support. Ne jamais rembourser plus que le paiement d'origine, jamais deux fois, jamais sur un paiement contesté."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rješavajte zahtjeve za povrat novca i odobrenja iz reda podrške. Nikad ne vraćajte više od izvorne naplate, nikad dvaput, nikad za osporenu naplatu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendezd az ügyfélszolgálati sorból érkező visszatérítési és jóváírási kérelmeket. Soha ne téríts vissza többet az eredeti terhelésnél, soha ne kétszer, és soha ne vitatott terhelésre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Լուծեք գումարի վերադարձի և կրեդիտի հարցումները աջակցության հերթից։ Երբեք մի վերադարձրեք բնօրինակ վճարումից ավելին, երբեք երկու անգամ, երբեք վիճարկվող վճարման համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan permintaan pengembalian dana dan kredit dari antrean dukungan. Jangan pernah mengembalikan lebih dari tagihan asli, jangan dua kali, jangan untuk pembayaran yang disengketakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci le richieste di rimborso e di credito dalla coda dell'assistenza. Non rimborsare mai più dell'addebito originale, mai due volte, mai su un addebito contestato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートの待ち行列にある返金とクレジットの依頼を処理します。元の請求額を超える返金、二重の返金、異議申し立て中の請求への返金は決して行いません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაარეგულირეთ თანხის დაბრუნებისა და კრედიტის მოთხოვნები მხარდაჭერის რიგიდან. არასოდეს დააბრუნოთ ორიგინალურ გადახდაზე მეტი, არასოდეს ორჯერ, არასოდეს გასაჩივრებულ გადახდაზე."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고객 지원 대기열의 환불 및 크레딧 요청을 처리합니다. 원래 결제 금액보다 많이, 두 번, 또는 분쟁 중인 결제에는 환불하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvarkyti pinigų grąžinimo ir kredito prašymus iš pagalbos eilės. Niekada negrąžinti daugiau nei pradinis mokėjimas, niekada du kartus, niekada už ginčijamą mokėjimą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nokārtot atmaksas un kredīta pieprasījumus no atbalsta rindas. Nekad neatmaksāt vairāk par sākotnējo maksājumu, nekad divreiz, nekad par apstrīdētu maksājumu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handel verzoeken om terugbetaling en tegoed uit de supportwachtrij af. Betaal nooit meer terug dan de oorspronkelijke betaling, nooit twee keer en nooit bij een betwiste betaling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpatruj prośby o zwrot i uznanie z kolejki wsparcia. Nigdy nie zwracaj więcej niż pierwotne obciążenie, nigdy dwa razy i nigdy przy spornym obciążeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolver pedidos de reembolso e de crédito da fila de suporte. Nunca reembolsar mais do que a cobrança original, nunca duas vezes, nunca numa cobrança em disputa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolver pedidos de reembolso e de crédito da fila de suporte. Nunca reembolsar mais do que a cobrança original, nunca duas vezes, nunca em uma cobrança em disputa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezolvați cererile de rambursare și credit din coada de suport. Nu rambursați niciodată mai mult decât plata inițială, niciodată de două ori, niciodată pentru o plată contestată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybavovať žiadosti o vrátenie peňazí a dobropisy z frontu podpory. Nikdy nevracať viac než pôvodnú platbu, nikdy dvakrát, nikdy pri spornej platbe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rešuj zahteve za vračila in dobropise iz vrste podpore. Nikoli ne vrni več od prvotne bremenitve, nikoli dvakrat, nikoli pri sporni bremenitvi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgjidhni kërkesat për kthim parash dhe kredit nga radha e mbështetjes. Mos ktheni kurrë më shumë se pagesa origjinale, kurrë dy herë, kurrë për një pagesë të kontestuar."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rješavajte zahteve za povrat novca i odobrenja iz reda podrške. Nikad ne vraćajte više od izvorne naplate, nikad dvaput, nikad za osporenu naplatu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการคำขอคืนเงินและเครดิตจากคิวฝ่ายสนับสนุน ห้ามคืนเกินยอดที่เรียกเก็บเดิม ห้ามคืนซ้ำ ห้ามคืนสำหรับรายการที่มีข้อพิพาท"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destek kuyruğundan iade ve alacak taleplerini çöz. Asla özgün ödemeden fazlasını, asla iki kez, asla itiraz edilen bir ödeme için iade etme."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải quyết các yêu cầu hoàn tiền và ghi có từ hàng chờ hỗ trợ. Không bao giờ hoàn nhiều hơn khoản thu gốc, không bao giờ hoàn hai lần, không bao giờ hoàn cho khoản thu đang bị khiếu nại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "處理客服佇列中的退款和入帳請求。退款絕不超過原始收費、絕不重複，也絕不用於有爭議的收費。"
          }
        }
      }
    },
