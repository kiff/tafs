    "coach.not_connected": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung bei %1$@ wurde nicht abgeschlossen, also wurde nichts verbunden. Melde dich erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in at %1$@ didn't finish, so nothing was connected. Try signing in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión en %1$@ no terminó, así que no se conectó nada. Vuelve a iniciar sesión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisselogimine teenusesse %1$@ jäi lõpetamata, seega midagi ei ühendatud. Proovi uuesti sisse logida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à %1$@ n'a pas abouti : rien n'a été connecté. Reconnectez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso a %1$@ non si è concluso, quindi non è stato collegato nulla. Accedi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@でのサインインが完了しなかったため、何も接続されていません。もう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 로그인이 끝나지 않아 연결된 것은 없습니다. 다시 로그인해 보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijungimas prie %1$@ nebaigtas, todėl niekas neprijungta. Pabandykite prisijungti dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierakstīšanās (%1$@) netika pabeigta, tāpēc nekas netika pievienots. Mēģini pierakstīties vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het inloggen bij %1$@ is niet afgerond, dus er is niets gekoppeld. Log opnieuw in."
          }
        },
        "pl": {
