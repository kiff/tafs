        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ტელეფონზე თითის ანაბეჭდი დაყენებული არ არის. დაამატეთ მისი პარამეტრებიდან, შემდეგ დაბრუნდით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានស្នាមម្រាមដៃត្រូវបានរៀបចំនៅលើទូរសព្ទនេះទេ។ បន្ថែមមួយក្នុងការកំណត់របស់វា រួចត្រឡប់មកវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에 등록된 지문이 없습니다. 설정에서 추가한 뒤 돌아오세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ມີລາຍນິ້ວມືຕັ້ງໃນໂທລະສັບນີ້. ເພີ່ມໃນການຕັ້ງຄ່າຂອງມັນ ແລ້ວກັບມາ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiame telefone nenustatytas joks piršto atspaudas. Pridėkite jį telefono nustatymuose ir grįžkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šajā tālrunī nav iestatīts neviens pirksta nospiedums. Pievieno to tālruņa iestatījumos, tad atgriezies."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нема поставен отисок на овој телефон. Додај го во неговите поставки, па врати се."
