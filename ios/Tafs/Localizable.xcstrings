    "connect.chats_were_not_exported_check": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söhbətləriniz ixrac edilmədi. Bağlantınızı yoxlayın və yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
