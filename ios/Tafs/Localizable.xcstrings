    "door.do_it.default": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu, worum es bittet, innerhalb deiner Card."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do what it asks, within your Card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz lo que pide, dentro de tu Card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais ce qu'il demande, dans ta Card."
          }
        },
        "it": {
