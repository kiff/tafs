        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু এই ফিল্টারের সঙ্গে মেলে এমন ঘটনা শুনুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolta només els esdeveniments que coincideixin amb aquests filtres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslouchat jen událostem, které odpovídají těmto filtrům."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf Ereignisse hören, die diesen Filtern entsprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen only for events matching these filters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchar solo los eventos que coincidan con estos filtros."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Oota ainult neile filtritele vastavaid sündmusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'écouter que les événements correspondant à ces filtres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להאזין רק לאירועים שתואמים למסננים האלה."
