    "door.add_intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib %1$@ eine Adresse, an die man schreiben kann. Er hat keine, bis du eine einschaltest, und seine Card entscheidet weiterhin, was er tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give %1$@ an address people can write to. It has none until you turn one on, and its Card still decides what it does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da a %1$@ una dirección a la que la gente pueda escribir. No tiene ninguna hasta que actives una, y su Card sigue decidiendo lo que hace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez à %1$@ une adresse à laquelle on peut écrire. Il n'en a aucune tant que vous n'en activez pas une, et sa Card décide toujours de ce qu'il fait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai a %1$@ un indirizzo a cui le persone possono scrivere. Non ne ha finché non ne attivi uno, e la sua Card decide comunque cosa fa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef %1$@ een adres waar mensen naar kunnen schrijven. Het heeft er geen tot je er een aanzet, en zijn Card bepaalt nog steeds wat het doet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daj %1$@ adres, na który można pisać. Nie ma go, dopóki go nie włączysz, a o tym, co robi, nadal decyduje jego Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a %1$@ um endereço para onde as pessoas possam escrever. Não tem nenhum até ativar um, e o seu Card continua a decidir o que faz."
          }
        }
      }
    },
