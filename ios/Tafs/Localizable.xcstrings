    "needs_you.sign_in_again_to_answer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich ab und erneut an, um von diesem Telefon zu antworten, damit KIFF seinen Schlüssel kennt. Oder beantworte diese hier in KIFF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out and in again to answer from this phone, so KIFF knows its key. Or answer this one in KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra sesión y vuelve a iniciarla para responder desde este teléfono, así KIFF conoce su clave. O responde a esta en KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellest telefonist vastamiseks logi välja ja uuesti sisse, et KIFF teaks selle võtit. Või vasta sellele KIFFis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous puis reconnectez-vous pour répondre depuis ce téléphone, afin que KIFF connaisse sa clé. Ou répondez à celle-ci dans KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci e accedi di nuovo per rispondere da questo telefono, così KIFF conosce la sua chiave. Oppure rispondi a questa in KIFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンから回答するには、サインアウトしてもう一度サインインし、KIFFにキーを認識させてください。または、これはKIFFで回答してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에서 답변하려면 로그아웃한 뒤 다시 로그인해 KIFF가 키를 알게 하세요. 또는 이 요청은 KIFF에서 답변하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsijunkite ir vėl prisijunkite, kad galėtumėte atsakyti iš šio telefono ir KIFF žinotų jo raktą. Arba į šią atsakykite KIFF."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izraksties un pieraksties vēlreiz, lai atbildētu no šī tālruņa un KIFF zinātu tā atslēgu. Vai atbildi uz šo KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log uit en opnieuw in om vanaf deze telefoon te antwoorden, zodat KIFF de sleutel kent. Of beantwoord deze in KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyloguj się i zaloguj ponownie, aby odpowiadać z tego telefonu, żeby KIFF znał jego klucz. Albo odpowiedz na to w KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine a sessão e inicie sessão novamente para responder a partir deste telefone, para que o KIFF conheça a sua chave. Ou responda a este no KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre a sessão e entre novamente para responder a partir deste telefone, para que o KIFF conheça a sua chave. Ou responda a este no KIFF."
          }
        }
      }
    },
    "needs_you.someone_answers": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand, der in diesem Konto genehmigt, beantwortet das. Die Antwort erscheint hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone who approves on this account answers this. Their answer shows here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien aprueba en esta cuenta responde a esto. Su respuesta aparece aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellele vastab keegi, kes sellel kontol kinnitab. Tema vastus ilmub siia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne qui approuve sur ce compte y répond. Sa réponse s'affiche ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risponde chi approva in questo account. La sua risposta compare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの承認者が回答します。回答はここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 승인자가 답변합니다. 답변은 여기에 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Į tai atsako tas, kas šioje paskyroje tvirtina. Jo atsakymas bus rodomas čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz šo atbild kāds, kurš šajā kontā apstiprina. Atbilde parādīsies šeit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand die in dit account goedkeurt, beantwoordt dit. Het antwoord verschijnt hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiada na to osoba zatwierdzająca na tym koncie. Jej odpowiedź pojawi się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém que aprova nesta conta responde a isto. A resposta aparece aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém que aprova nesta conta responde a isto. A resposta aparece aqui."
          }
        }
      }
    },
