    "sample.hello": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Salam, mən %1$@. Üzərindəyəm: %2$@. Məndən nə etdiyimi soruşun və ya başqa cür nə edəcəyimi deyin. Hər iki halda Card-ımın daxilində qalıram."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Здравейте, аз съм %1$@. Зает съм с: %2$@. Попитайте ме какво съм направил или ми кажете какво да правя различно. Във всеки случай оставам в рамките на своята Card."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahoj, jsem %1$@. Pracuji na tom: %2$@. Zeptejte se mě, co jsem udělal, nebo mi řekněte, co dělat jinak. Tak či tak zůstávám v rámci své Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, ich bin %1$@. Ich bin dran: %2$@. Frag mich, was ich getan habe, oder sag mir, was ich anders machen soll. Ich bleibe so oder so innerhalb meiner Card."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I'm %1$@. I'm on it: %2$@. Ask me what I did, or tell me what to do differently. I stay inside my Card either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola, soy %1$@. Estoy en ello: %2$@. Pregúntame qué hice, o dime qué hacer de otra forma. En cualquier caso, me mantengo dentro de mi Card."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tere, mina olen %1$@. Tegelen sellega: %2$@. Küsi minult, mida ma tegin, või ütle, mida teha teisiti. Igal juhul jään oma Cardi piiresse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour, je suis %1$@. Je m'en occupe : %2$@. Demandez-moi ce que j'ai fait, ou dites-moi quoi faire autrement. Je reste dans ma Card dans tous les cas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bok, ja sam %1$@. Radim na tome: %2$@. Pitajte me što sam napravio ili mi recite da radim drugačije. U oba slučaja ostajem unutar svog Carda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szia, %1$@ vagyok. Ezen dolgozom: %2$@. Kérdezd meg, mit csináltam, vagy mondd meg, mit csináljak másképp. Mindenképp a Cardomon belül maradok."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բարև, ես %1$@-ն եմ։ Զբաղված եմ՝ %2$@։ Հարցրեք, թե ինչ արեցի, կամ ասեք, թե ինչ անեմ այլ կերպ։ Երկու դեպքում էլ մնում եմ իմ Card-ի շրջանակներում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halo, saya %1$@. Saya sedang mengerjakan: %2$@. Tanyakan apa yang saya lakukan, atau katakan apa yang harus saya lakukan secara berbeda. Dalam kedua kasus saya tetap berada dalam Card saya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao, sono %1$@. Ci sto lavorando: %2$@. Chiedimi cosa ho fatto, o dimmi cosa fare diversamente. In ogni caso resto entro la mia Card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは、%1$@です。現在の作業：%2$@。私がしたことを尋ねたり、やり方を変えるよう伝えたりしてください。どちらの場合も、私はCardの範囲内で動きます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამარჯობა, მე ვარ %1$@. მუშაობას ვაგრძელებ: %2$@. ჰკითხეთ, რა გავაკეთე, ან მითხარით, რა გავაკეთო სხვანაირად. ორივე შემთხვევაში ჩემი Card-ის ფარგლებში ვრჩები."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요, 저는 %1$@입니다. 지금 하는 일: %2$@. 제가 한 일을 묻거나 다르게 할 일을 알려 주세요. 어느 쪽이든 저는 Card 범위 안에서만 움직입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveiki, aš – %1$@. Dirbu: %2$@. Paklauskite, ką padariau, arba pasakykite, ką daryti kitaip. Bet kuriuo atveju neperžengiu savo Card ribų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveiki, es esmu %1$@. Es pie tā strādāju: %2$@. Pajautā man, ko es izdarīju, vai pasaki, ko darīt citādi. Jebkurā gadījumā es palieku savas Card ietvaros."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoi, ik ben %1$@. Ik ben ermee bezig: %2$@. Vraag me wat ik heb gedaan, of zeg wat ik anders moet doen. Ik blijf hoe dan ook binnen mijn Card."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cześć, jestem %1$@. Zajmuję się tym: %2$@. Zapytaj mnie, co zrobiłem, albo powiedz, co mam robić inaczej. Tak czy inaczej działam w ramach swojej Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá, sou %1$@. Estou a tratar disto: %2$@. Pergunte-me o que fiz, ou diga-me o que fazer de outra forma. Fico sempre dentro do meu Card."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá, sou %1$@. Estou a tratar disto: %2$@. Pergunte-me o que fiz, ou diga-me o que fazer de outra forma. Fico sempre dentro do meu Card."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bună, sunt %1$@. Mă ocup: %2$@. Întrebați-mă ce am făcut sau spuneți-mi ce să fac altfel. Oricum rămân în limitele Cardului meu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahoj, som %1$@. Pracujem na tom: %2$@. Opýtajte sa ma, čo som urobil, alebo mi povedzte, čo robiť inak. Tak či tak zostávam v rámci svojej Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Živjo, sem %1$@. Delam na tem: %2$@. Vprašajte me, kaj sem naredil, ali mi povejte, kaj naj naredim drugače. Tako ali tako ostanem znotraj svoje Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përshëndetje, jam %1$@. Jam në punë: %2$@. Pyesni çfarë bëra, ose tregoni çfarë të bëj ndryshe. Qëndroj brenda Card-it tim në të dy rastet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bok, ja sam %1$@. Radim na tome: %2$@. Pitajte me šta sam napravio ili mi recite da radim drugačije. U oba slučaja ostajem unutar svog Carda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สวัสดี ฉันคือ %1$@ ฉันกำลังทำ: %2$@ ถามฉันได้ว่าฉันทำอะไรไป หรือบอกให้ฉันทำต่างออกไป ไม่ว่าอย่างไรฉันอยู่ใน Card ของฉันเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merhaba, ben %1$@. Şu an şunun üzerindeyim: %2$@. Ne yaptığımı sorun veya neyi farklı yapmam gerektiğini söyleyin. Her iki durumda da Card'ımın içinde kalırım."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xin chào, tôi là %1$@. Tôi đang làm: %2$@. Hãy hỏi tôi đã làm gì, hoặc bảo tôi nên làm khác đi thế nào. Dù thế nào tôi cũng ở trong Card của mình."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您好，我是 %1$@。我正在處理：%2$@。您可以問我做了什麼，或告訴我該換個方式做。無論如何，我都留在我的 Card 範圍內。"
          }
        }
      }
    },
