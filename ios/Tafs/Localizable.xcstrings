    "drive.card_note_pauses": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضغط Coach ويكتب في هذا التطبيق بينما تراقب، لهذا الطلب فقط. ولا يؤكد أي شيء أبدًا. المس التطبيق لإيقافه مؤقتًا، أو اضغط «إيقاف» لإنهائه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach siz izləyərkən bu tətbiqdə toxunur və yazır, yalnız bu sorğu üçün. O, heç nəyi təsdiqləmir. Dayandırmaq üçün tətbiqə toxunun və ya bitirmək üçün «Dayandırın» düyməsinə basın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach докосва и пише в това приложение, докато гледате, само за тази заявка. Никога не потвърждава нищо. Докоснете приложението, за да го спрете на пауза, или докоснете „Спиране“, за да приключите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি দেখার সময় Coach এই অ্যাপে ট্যাপ করে ও টাইপ করে, শুধু এই অনুরোধের জন্য। এটি কখনও কিছু নিশ্চিত করে না। থামাতে অ্যাপ ছুঁয়ে দিন, অথবা শেষ করতে «বন্ধ করুন» চাপুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach toca i escriu en aquesta aplicació mentre mires, només per a aquesta sol·licitud. Mai no confirma res. Toca l'aplicació per aturar-lo o toca «Atura» per acabar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach v této aplikaci klepe a píše, zatímco se díváte, jen pro tuto žádost. Nikdy nic nepotvrzuje. Dotykem aplikace ho pozastavíte, klepnutím na Zastavit ho ukončíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tippt und schreibt in dieser App, während du zusiehst, nur für diese Anfrage. Er bestätigt nie etwas. Berühre die App, um ihn zu pausieren, oder tippe auf „Stoppen“, um ihn zu beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach taps and types in this app while you watch, for this request only. It never confirms anything. Touch the app to pause it, or tap Stop to end it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach toca y escribe en esta app mientras miras, solo para esta solicitud. Nunca confirma nada. Toca la app para pausarlo o toca Detener para terminar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach puudutab ja kirjutab selles rakenduses, kuni sina vaatad, ainult selle päringu jaoks. See ei kinnita kunagi midagi. Pausile panemiseks puuduta rakendust, lõpetamiseks puuduta Lõpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach touche et écrit dans cette app sous vos yeux, pour cette demande uniquement. Il ne confirme jamais rien. Touchez l'app pour le mettre en pause, ou touchez Arrêter pour terminer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach לוחץ ומקליד באפליקציה הזו בזמן שאתה צופה, לבקשה הזו בלבד. הוא אף פעם לא מאשר דבר. יש לגעת באפליקציה כדי להשהות אותו, או ללחוץ על «עצירה» כדי לסיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach आपके देखते हुए, केवल इसी अनुरोध के लिए, इस ऐप में टैप और टाइप करता है। वह कभी कुछ पुष्ट नहीं करता। इसे थामने के लिए ऐप को छुएँ, या खत्म करने के लिए रोकें पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dodiruje i tipka u ovoj aplikaciji dok vi gledate, samo za ovaj zahtjev. Nikad ništa ne potvrđuje. Dodirnite aplikaciju da je pauzirate ili dodirnite Zaustavite da završite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Coach koppint és gépel ebben az alkalmazásban, miközben nézed, csak ehhez a kéréshez. Soha semmit nem erősít meg. Érintsd meg az alkalmazást a szüneteltetéshez, vagy koppints a Leállítás gombra a befejezéshez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-ը հպում և մուտքագրում է այս հավելվածում, մինչ դուք դիտում եք, միայն այս հարցման համար։ Այն երբեք ոչինչ չի հաստատում։ Հպեք հավելվածին՝ դադարեցնելու համար, կամ հպեք «Կանգնեցնել»՝ ավարտելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach mengetuk dan mengetik di aplikasi ini saat Anda menonton, hanya untuk permintaan ini. Ia tidak pernah mengonfirmasi apa pun. Sentuh aplikasi untuk menjedanya, atau ketuk Hentikan untuk mengakhirinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tocca e scrive in questa app mentre guardi, solo per questa richiesta. Non conferma mai nulla. Tocca l'app per metterlo in pausa o tocca Ferma per terminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストに限り、あなたが見ている間にCoachがこのアプリでタップと入力を行います。何かを確定することはありません。一時停止するにはアプリに触れ、終了するには「停止」をタップしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ეხება და წერს ამ აპში, სანამ თქვენ უყურებთ, მხოლოდ ამ მოთხოვნისთვის. ის არასოდეს ადასტურებს არაფერს. შეეხეთ აპს შესაჩერებლად ან შეეხეთ „გაჩერებას“ დასასრულებლად."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ចុច និងវាយក្នុងកម្មវិធីនេះ ខណៈអ្នកមើល សម្រាប់តែសំណើនេះប៉ុណ្ណោះ។ វាមិនដែលបញ្ជាក់អ្វីទេ។ ប៉ះកម្មវិធីដើម្បីផ្អាកវា ឬចុចបញ្ឈប់ដើម្បីបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach는 이 요청에 한해, 내가 지켜보는 동안 이 앱에서 탭하고 입력합니다. 무엇도 확정하지 않습니다. 일시 중지하려면 앱을 터치하고, 끝내려면 중지를 탭하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ແຕະ ແລະ ພິມໃນແອັບນີ້ ໃນຂະນະທີ່ທ່ານເບິ່ງ, ສຳລັບຄຳຂໍນີ້ເທົ່ານັ້ນ. ມັນບໍ່ເຄີຍຢືນຢັນຫຍັງ. ແຕະແອັບເພື່ອຢຸດມັນຊົ່ວຄາວ ຫຼື ແຕະ ຢຸດ ເພື່ອສິ້ນສຸດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach liečia ir rašo šioje programėlėje, kol jūs stebite, tik šiai užklausai. Jis niekada nieko netvirtina. Palieskite programėlę, kad jį pristabdytumėte, arba palieskite „Nutraukti Coach“, kad baigtumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach pieskaras un raksta šajā lietotnē, kamēr tu skaties, tikai šim pieprasījumam. Tas nekad neko neapstiprina. Pieskaries lietotnei, lai to iepauzētu, vai pieskaries “Pārtraukt”, lai to beigtu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach допира и пишува во оваа апликација додека гледаш, само за ова барање. Никогаш ништо не потврдува. Допри ја апликацијата за да го паузираш, или допри Стопирај за да заврши."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та харж байх үед Coach зөвхөн энэ хүсэлтийн хувьд энэ апп дээр товшиж, бичнэ. Тэр хэзээ ч юу ч баталгаажуулдаггүй. Түр зогсоохын тулд аппыг товшино уу, эсвэл дуусгахын тулд Зогсоох-ыг товшино уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले हेरिरहँदा Coach ले यो अनुरोधका लागि मात्र यो एपमा ट्याप र टाइप गर्छ। यसले कहिल्यै केही पुष्टि गर्दैन। पज गर्न एपलाई छुनुहोस्, वा अन्त्य गर्न रोक्नुहोस् ट्याप गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tikt en typt in deze app terwijl je kijkt, alleen voor dit verzoek. Het bevestigt nooit iets. Raak de app aan om het te pauzeren, of tik op Stoppen om het te beëindigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dotyka i pisze w tej aplikacji, gdy patrzysz, tylko dla tej prośby. Nigdy niczego nie potwierdza. Dotknij aplikacji, aby go wstrzymać, lub Zatrzymaj, aby zakończyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach toca e escreve nesta app enquanto observa, apenas para este pedido. Nunca confirma nada. Toque na app para o pausar ou em Parar para terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach toca e escreve neste app enquanto você observa, apenas para este pedido. Nunca confirma nada. Toque no app para pausar ou em Parar para terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach atinge și tastează în această aplicație în timp ce priviți, doar pentru această solicitare. Nu confirmă niciodată nimic. Atingeți aplicația pentru a-l întrerupe sau atingeți Opriți pentru a încheia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach v tejto aplikácii ťuká a píše, kým sa pozeráte, len pre túto žiadosť. Nikdy nič nepotvrdzuje. Dotykom aplikácie ho pozastavíte, ťuknutím na Zastaviť ho ukončíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach v tej aplikaciji tapka in tipka, medtem ko gledate, samo za to zahtevo. Nikoli ničesar ne potrdi. Dotaknite se aplikacije, da ga začasno ustavite, ali tapnite Ustavi, da ga končate."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach prek dhe shkruan në këtë aplikacion ndërsa shikoni, vetëm për këtë kërkesë. Nuk konfirmon kurrë asgjë. Prekni aplikacionin për ta ndërprerë, ose prekni Ndaloni për ta mbyllur."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dodiruje i tipka u ovoj aplikaciji dok vi gledate, samo za ovaj zahtev. Nikad ništa ne potvrđuje. Dodirnite aplikaciju da je pauzirate ili dodirnite Zaustavite da završite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach แตะและพิมพ์ในแอปนี้ขณะที่คุณดูอยู่ เฉพาะสำหรับคำขอนี้ มันไม่ยืนยันอะไรเลย แตะที่แอปเพื่อหยุดชั่วคราว หรือแตะหยุดเพื่อสิ้นสุด"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach siz synlap duranyňyzda, diňe bu haýyş üçin, bu programmada basýar we ýazýar. Ol hiç haçan hiç zady tassyklamaýar. Ony bes etmek üçin programma degiň, ýa-da gutarmak üçin Duruzyň düwmesine basyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach, siz izlerken bu uygulamada dokunur ve yazar; yalnızca bu istek için. Hiçbir şeyi onaylamaz. Duraklatmak için uygulamaya dokunun veya bitirmek için Durdur'a dokunun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach اس ایپ میں صرف اسی درخواست کے لیے ٹیپ کرتا اور ٹائپ کرتا ہے جبکہ آپ دیکھتے ہیں۔ یہ کبھی کسی چیز کی تصدیق نہیں کرتا۔ اسے روکنے کے لیے ایپ کو چھوئیں، یا ختم کرنے کے لیے روکیں پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach chạm và gõ trong ứng dụng này khi bạn theo dõi, chỉ cho yêu cầu này. Nó không bao giờ xác nhận gì cả. Hãy chạm vào ứng dụng để tạm dừng, hoặc chạm Dừng để kết thúc."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您在一旁觀看時，Coach 會在這個 App 中輕點和輸入，僅限這次請求。它絕不會確認任何事項。觸碰 App 即可暫停，或輕點「停止」結束。"
          }
        }
      }
    },
    "drive.card_note_scrolls_pauses": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضغط Coach ويكتب ويمرّر في هذا التطبيق بينما تراقب. ولا يؤكد أي شيء أبدًا. المس التطبيق لإيقافه مؤقتًا، أو اضغط «إيقاف» لإنهائه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach siz izləyərkən bu tətbiqdə toxunur, yazır və sürüşdürür. O, heç nəyi təsdiqləmir. Dayandırmaq üçün tətbiqə toxunun və ya bitirmək üçün «Dayandırın» düyməsinə basın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach докосва, пише и превърта в това приложение, докато гледате. Никога не потвърждава нищо. Докоснете приложението, за да го спрете на пауза, или докоснете „Спиране“, за да приключите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি দেখার সময় Coach এই অ্যাপে ট্যাপ করে, টাইপ করে ও স্ক্রল করে। এটি কখনও কিছু নিশ্চিত করে না। থামাতে অ্যাপ ছুঁয়ে দিন, অথবা শেষ করতে «বন্ধ করুন» চাপুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach toca, escriu i es desplaça en aquesta aplicació mentre mires. Mai no confirma res. Toca l'aplicació per aturar-lo o toca «Atura» per acabar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach v této aplikaci klepe, píše a posouvá, zatímco se díváte. Nikdy nic nepotvrzuje. Dotykem aplikace ho pozastavíte, klepnutím na Zastavit ho ukončíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tippt, schreibt und scrollt in dieser App, während du zusiehst. Er bestätigt nie etwas. Berühre die App, um ihn zu pausieren, oder tippe auf „Stoppen“, um ihn zu beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach taps, types and scrolls in this app while you watch. It never confirms anything. Touch the app to pause it, or tap Stop to end it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach toca, escribe y se desplaza en esta app mientras miras. Nunca confirma nada. Toca la app para pausarlo o toca Detener para terminar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach puudutab, kirjutab ja kerib selles rakenduses, kuni sina vaatad. See ei kinnita kunagi midagi. Pausile panemiseks puuduta rakendust, lõpetamiseks puuduta Lõpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach touche, écrit et fait défiler dans cette app sous vos yeux. Il ne confirme jamais rien. Touchez l'app pour le mettre en pause, ou touchez Arrêter pour terminer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach לוחץ, מקליד וגולל באפליקציה הזו בזמן שאתה צופה. הוא אף פעם לא מאשר דבר. יש לגעת באפליקציה כדי להשהות אותו, או ללחוץ על «עצירה» כדי לסיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach आपके देखते हुए इस ऐप में टैप, टाइप और स्क्रॉल करता है। वह कभी कुछ पुष्ट नहीं करता। इसे थामने के लिए ऐप को छुएँ, या खत्म करने के लिए रोकें पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dodiruje, tipka i pomiče sadržaj u ovoj aplikaciji dok vi gledate. Nikad ništa ne potvrđuje. Dodirnite aplikaciju da je pauzirate ili dodirnite Zaustavite da završite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Coach koppint, gépel és görget ebben az alkalmazásban, miközben nézed. Soha semmit nem erősít meg. Érintsd meg az alkalmazást a szüneteltetéshez, vagy koppints a Leállítás gombra a befejezéshez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-ը հպում, մուտքագրում և ոլորում է այս հավելվածում, մինչ դուք դիտում եք։ Այն երբեք ոչինչ չի հաստատում։ Հպեք հավելվածին՝ դադարեցնելու համար, կամ հպեք «Կանգնեցնել»՝ ավարտելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach mengetuk, mengetik, dan menggulir di aplikasi ini saat Anda menonton. Ia tidak pernah mengonfirmasi apa pun. Sentuh aplikasi untuk menjedanya, atau ketuk Hentikan untuk mengakhirinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tocca, scrive e scorre in questa app mentre guardi. Non conferma mai nulla. Tocca l'app per metterlo in pausa o tocca Ferma per terminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが見ている間に、Coachがこのアプリでタップ、入力、スクロールを行います。何かを確定することはありません。一時停止するにはアプリに触れ、終了するには「停止」をタップしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ეხება, წერს და ფურცლავს ამ აპში, სანამ თქვენ უყურებთ. ის არასოდეს ადასტურებს არაფერს. შეეხეთ აპს შესაჩერებლად ან შეეხეთ „გაჩერებას“ დასასრულებლად."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ចុច វាយ និងរមូរក្នុងកម្មវិធីនេះ ខណៈអ្នកមើល។ វាមិនដែលបញ្ជាក់អ្វីទេ។ ប៉ះកម្មវិធីដើម្បីផ្អាកវា ឬចុចបញ្ឈប់ដើម្បីបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach는 내가 지켜보는 동안 이 앱에서 탭하고, 입력하고, 스크롤합니다. 무엇도 확정하지 않습니다. 일시 중지하려면 앱을 터치하고, 끝내려면 중지를 탭하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ແຕະ, ພິມ ແລະ ເລື່ອນໃນແອັບນີ້ ໃນຂະນະທີ່ທ່ານເບິ່ງ. ມັນບໍ່ເຄີຍຢືນຢັນຫຍັງ. ແຕະແອັບເພື່ອຢຸດມັນຊົ່ວຄາວ ຫຼື ແຕະ ຢຸດ ເພື່ອສິ້ນສຸດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach liečia, rašo ir slenka šioje programėlėje, kol jūs stebite. Jis niekada nieko netvirtina. Palieskite programėlę, kad jį pristabdytumėte, arba palieskite „Nutraukti Coach“, kad baigtumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach pieskaras, raksta un ritina šajā lietotnē, kamēr tu skaties. Tas nekad neko neapstiprina. Pieskaries lietotnei, lai to iepauzētu, vai pieskaries “Pārtraukt”, lai to beigtu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach допира, пишува и лизга во оваа апликација додека гледаш. Никогаш ништо не потврдува. Допри ја апликацијата за да го паузираш, или допри Стопирај за да заврши."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та харж байх үед Coach энэ апп дээр товшиж, бичиж, гүйлгэнэ. Тэр хэзээ ч юу ч баталгаажуулдаггүй. Түр зогсоохын тулд аппыг товшино уу, эсвэл дуусгахын тулд Зогсоох-ыг товшино уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले हेरिरहँदा Coach ले यो एपमा ट्याप, टाइप र स्क्रोल गर्छ। यसले कहिल्यै केही पुष्टि गर्दैन। पज गर्न एपलाई छुनुहोस्, वा अन्त्य गर्न रोक्नुहोस् ट्याप गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tikt, typt en scrollt in deze app terwijl je kijkt. Het bevestigt nooit iets. Raak de app aan om het te pauzeren, of tik op Stoppen om het te beëindigen."
          }
        },
