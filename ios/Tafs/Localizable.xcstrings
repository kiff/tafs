        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de inlogpagina van de leverancier is geopend, rond het daar af en kom terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli otworzyła się strona logowania dostawcy, dokończ tam i wróć."
