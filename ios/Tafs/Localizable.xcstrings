    "connect.connections_could_not_disconnected_disconnect": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " تعذّرت إزالة الوصول إلى %1$@ من تطبيقاته: أزله من «ربط التطبيقات»."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": " Tətbiqlərindən %1$@ ədədinə giriş silinə bilmədi: onu «Tətbiqləri qoşun» bölməsində silin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": " Достъпът до %1$@ от приложенията му не можа да бъде премахнат: премахнете го в „Свързване на приложения“."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": " এর %1$@টি অ্যাপে প্রবেশাধিকার সরানো যায়নি: «অ্যাপ সংযুক্ত করুন»-এ তা সরান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": " No s'ha pogut treure l'accés a %1$@ de les seves aplicacions: treu-lo a Connecta aplicacions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": " Přístup k %1$@ jeho aplikacím se nepodařilo odebrat: odeberte ho v Připojit aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Der Zugriff auf %1$@ seiner Apps konnte nicht entfernt werden: Entferne ihn unter „Apps verbinden“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Access to %1$@ of its apps couldn't be removed: remove it in Connect apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " No se pudo quitar el acceso a %1$@ de sus apps: quítalo en Conectar apps."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": " Juurdepääsu %1$@ selle rakendusele ei õnnestunud eemaldada: eemalda see vaates Ühenda rakendused."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " L'accès à %1$@ de ses apps n'a pas pu être retiré : retirez-le dans Connecter des apps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " לא ניתן היה להסיר את הגישה ל-%1$@ מהאפליקציות שלו: יש להסיר אותה ב«חיבור אפליקציות»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " उसके %1$@ ऐप की पहुँच हटाई नहीं जा सकी: उसे ऐप जोड़ें में हटाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": " Pristup za %1$@ njegovih aplikacija nije bilo moguće ukloniti: uklonite ga u Poveži aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$@ alkalmazásához való hozzáférését nem sikerült megszüntetni: szüntesd meg az Alkalmazások csatlakoztatása részben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": " Նրա %1$@ հավելվածի հասանելիությունը չկարողացավ հեռացվել․ հեռացրեք «Հավելվածների միացում»-ում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " Akses ke %1$@ aplikasinya tidak dapat dihapus: hapus di Hubungkan aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Non è stato possibile rimuovere l'accesso a %1$@ delle sue app: rimuovilo in Collega app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@個のアプリへのアクセスを削除できませんでした。アプリを接続から削除してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": " მისი %1$@ აპის წვდომა ვერ ამოიღო: ამოიღეთ „აპების დაკავშირებაში“."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": " មិនអាចដកការចូលប្រើកម្មវិធី %1$@ របស់វាបានទេ៖ ដកវាក្នុង «ភ្ជាប់កម្មវិធី»។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 앱 %1$@개의 접근 권한을 삭제하지 못했습니다. 앱 연결에서 삭제하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": " ເອົາສິດເຂົ້າເຖິງ %1$@ ແອັບຂອງມັນອອກບໍ່ໄດ້: ເອົາອອກໃນ ເຊື່ອມຕໍ່ແອັບ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": " Nepavyko pašalinti prieigos prie kai kurių jo programėlių (%1$@): pašalinkite ją skiltyje „Prijungti programėles“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": " Piekļuvi daļai tā lietotņu (%1$@) nevarēja noņemt: noņem to sadaļā “Pievienot lietotnes”."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": " Пристапот до %1$@ од неговите апликации не можеше да се отстрани: отстрани го во Поврзи апликации."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": " Түүний %1$@ аппад хандах эрхийг хасаж чадсангүй: Апп холбох хэсэгт хасна уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": " यसका %1$@ एपको पहुँच हटाउन सकिएन: एप जडानमा हटाउनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " Toegang tot %1$@ van de apps kon niet worden ingetrokken: trek die in bij Apps koppelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Nie udało się usunąć dostępu do części jego aplikacji (%1$@): usuń go w Połącz aplikacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " Não foi possível remover o acesso a %1$@ das suas apps: remova-o em Ligar apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Não foi possível remover o acesso a %1$@ dos seus apps: remova-o em Conectar apps."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": " Accesul la %1$@ dintre aplicațiile sale nu a putut fi eliminat: eliminați-l în Conectați aplicații."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": " Prístup k %1$@ jeho aplikáciám sa nepodarilo odobrať: odoberte ho v Pripojiť aplikácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": " Dostopa do %1$@ njegovih aplikacij ni bilo mogoče odstraniti: odstranite ga v Poveži aplikacije."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": " Qasja në %1$@ nga aplikacionet e tij nuk u hoq dot: hiqeni te Lidhni aplikacione."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": " Pristup za %1$@ njegovih aplikacija nije bilo moguće ukloniti: uklonite ga u Poveži aplikacije."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " ถอนสิทธิ์เข้าถึง %1$@ แอปของมันไม่ได้: ถอนใน เชื่อมต่อแอป"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": " Onuň %1$@ programmasynyň elýeterligi aýrylyp bilinmedi: ony Programmalary birikdiriň bölüminde aýyryň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " Uygulamalarından %1$@ tanesine erişim kaldırılamadı: Uygulamaları bağla'dan kaldırın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": " اس کی %1$@ ایپس کی رسائی ہٹائی نہیں جا سکی: اسے ایپس جوڑیں میں ہٹائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": " Không thể gỡ quyền truy cập vào %1$@ ứng dụng của nó: hãy gỡ trong Kết nối ứng dụng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 無法移除它的 %1$@ 個 App 的存取權限：請在「連接 App」中移除。"
          }
        }
      }
