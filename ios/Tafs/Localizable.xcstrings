        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šodien vēl nekas nav izdarīts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag nog niets gedaan."
          }
        },
        "pl": {
