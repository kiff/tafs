    "settings.light_taps_when_you_send": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Göndərəndə və ya cavab verəndə yüngül toxunuş hiss olunur."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Светлината мига, когато изпращате или отговаряте."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při odeslání nebo odpovědi lehce ťukne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein leichtes Tippen, wenn du sendest oder antwortest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The light taps when you send or answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vibración suave al enviar o responder."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerge värin, kui saadad või vastad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une légère vibration quand vous envoyez ou répondez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagani dodir kad šaljete ili odgovarate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fény koppint, amikor küldesz vagy válaszolsz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թեթև հպում, երբ ուղարկում կամ պատասխանում եք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketukan ringan saat Anda mengirim atau menjawab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un leggero tocco quando invii o rispondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信や回答のときに軽く振動します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მსუბუქი შეხება, როცა აგზავნით ან პასუხობთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내거나 답할 때 가볍게 진동합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengva vibracija, kai siunčiate ar atsakote."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viegls piesitiens, kad tu sūti vai atbildi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een lichte tik als je verzendt of antwoordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lekkie stuknięcie, gdy wysyłasz lub odpowiadasz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vibração ligeira quando envia ou responde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vibração ligeira quando envia ou responde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumina pulsează când trimiteți sau răspundeți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri odoslaní alebo odpovedi jemne ťukne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob pošiljanju ali odgovoru rahlo potrka."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një prekje e lehtë kur dërgoni ose përgjigjeni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagani dodir kad šaljete ili odgovarate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสั่นเบา ๆ เมื่อคุณส่งหรือตอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderdiğinizde veya yanıtladığınızda hafif dokunuş."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một nhịp rung nhẹ khi bạn gửi hoặc trả lời."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
