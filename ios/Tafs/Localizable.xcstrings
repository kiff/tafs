    "door.api.draft_words_risk": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv edildikdə %1$@ öz sözləri ilə cavab verə bilər. Onlar oxuduqlarını, o cümlədən başqalarının məlumatlarını, %2$@ tətbiqinə geri apara bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако е включено, %1$@ може да отговаря със свои думи. Те могат да върнат към %2$@ това, което е прочел, включително данни на други хора."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je to zapnuté, %1$@ může odpovídat vlastními slovy. Ta by mohla do %2$@ vynést, co přečetl, včetně údajů jiných lidí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingeschaltet kann %1$@ in eigenen Worten antworten. Diese könnten zurück an %2$@ tragen, was er gelesen hat, auch Daten anderer Personen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned on, %1$@ may answer in its own words. They could carry what it read, other people's data included, back to %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo activas, %1$@ puede responder con sus propias palabras. Podrían llevar a %2$@ lo que leyó, incluidos datos de otras personas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui see on sees, võib %1$@ vastata oma sõnadega. Need võivad viia rakendusse %2$@ tagasi seda, mida see luges, sealhulgas teiste inimeste andmeid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si c'est activé, %1$@ peut répondre avec ses propres mots. Ils pourraient renvoyer à %2$@ ce qu'il a lu, y compris des données d'autres personnes."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je uključeno, taf %1$@ može odgovarati vlastitim riječima. One mogu u aplikaciju %2$@ vratiti ono što je pročitao, uključujući podatke drugih ljudi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolva %1$@ a saját szavaival válaszolhat. Ezek azt is visszavihetik ide (%2$@), amit olvasott, mások adatait is beleértve."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միացնելու դեպքում %1$@-ը կարող է պատասխանել իր բառերով։ Դրանք կարող են տանել այն, ինչ կարդացել է, ներառյալ ուրիշների տվյալները, հետ՝ %2$@-ին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat aktif, %1$@ dapat menjawab dengan kata-katanya sendiri. Kata-kata itu dapat membawa apa yang dibacanya, termasuk data orang lain, kembali ke %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lo attivi, %1$@ può rispondere con parole sue. Potrebbero riportare a %2$@ ciò che ha letto, compresi dati di altre persone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、%1$@は自分の言葉で回答する場合があります。その中に、読んだ内容（他の人のデータを含む）が含まれて%2$@に戻る可能性があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართვისას %1$@-მა შეიძლება თავისი სიტყვებით უპასუხოს. მათ შეიძლება ის, რაც წაიკითხა, სხვის მონაცემებთან ერთად, %2$@-ს უკან დაუბრუნონ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 %1$@이(가) 자체 문구로 답할 수 있습니다. 그 문구에 읽은 내용, 다른 사람의 데이터까지 담겨 %2$@에 돌아갈 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjungus %1$@ gali atsakyti savo žodžiais. Juose į %2$@ gali grįžti tai, ką jis perskaitė, įskaitant kitų žmonių duomenis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja ieslēgts, %1$@ var atbildēt saviem vārdiem. Tie var nogādāt atpakaļ uz %2$@ to, ko tas izlasīja, arī citu cilvēku datus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit aan staat, kan %1$@ in eigen woorden antwoorden. Die kunnen wat hij las, ook gegevens van andere mensen, terugbrengen naar %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu %1$@ może odpowiadać własnymi słowami. Mogą one przekazać do aplikacji %2$@ to, co przeczytał, w tym dane innych osób."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ativar, %1$@ pode responder com as suas próprias palavras. Estas podem levar para %2$@ o que leu, incluindo dados de outras pessoas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ativar, %1$@ pode responder com as suas próprias palavras. Estas podem levar para %2$@ o que leu, incluindo dados de outras pessoas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă e activat, %1$@ poate răspunde cu propriile cuvinte. Acestea ar putea duce înapoi la %2$@ ce a citit, inclusiv datele altor persoane."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď je to zapnuté, %1$@ môže odpovedať vlastnými slovami. Tie by mohli do %2$@ vyniesť, čo prečítal, vrátane údajov iných ľudí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je vklopljeno, lahko %1$@ odgovarja z lastnimi besedami. Te bi lahko v %2$@ odnesle, kar je prebral, vključno s podatki drugih ljudi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur aktivizohet, %1$@ mund të përgjigjet me fjalët e veta. Ato mund të mbartin atë që lexoi, përfshirë të dhënat e të tjerëve, prapa te %2$@."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je uključeno, taf %1$@ može odgovarati vlastitim rečima. One mogu u aplikaciju %2$@ vratiti ono šta je pročitao, uključujući podatke drugih ljudi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิด %1$@ อาจตอบด้วยถ้อยคำของมันเอง ซึ่งอาจนำสิ่งที่มันอ่าน รวมถึงข้อมูลของผู้อื่น กลับไปที่ %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken %1$@ kendi sözleriyle yanıt verebilir. Bunlar, okuduklarını (başkalarının verileri dahil) %2$@ uygulamasına taşıyabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, %1$@ có thể trả lời bằng lời của chính nó. Những lời đó có thể mang theo thứ nó đã đọc, kể cả dữ liệu của người khác, trả về %2$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，%1$@ 可能用它自己的話回覆。這些話可能把它讀到的內容（包括他人的資料）帶回給 %2$@。"
          }
        }
      }
    },
    "door.api.email_developer": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
