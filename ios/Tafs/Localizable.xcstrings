    "settings.devices.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Gerät abmeldest, endet seine Anmeldung bei diesem Konto sofort. Um dieses Telefon abzumelden, nutze „Abmelden“ unter „Konto“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing a device out ends its sign-in on this account at once. To sign out this phone, use Sign out in Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar la sesión de un dispositivo termina al instante su inicio de sesión en esta cuenta. Para cerrar la sesión de este teléfono, usa Cerrar sesión en Cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter un appareil met fin immédiatement à sa connexion sur ce compte. Pour déconnecter ce téléphone, utilisez Se déconnecter dans Compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnettere un dispositivo termina subito il suo accesso a questo account. Per disconnettere questo telefono, usa Esci in Account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een apparaat uitloggen beëindigt meteen de login ervan op dit account. Gebruik Uitloggen in Account om deze telefoon uit te loggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowanie urządzenia natychmiast kończy jego logowanie na tym koncie. Aby wylogować ten telefon, użyj Wyloguj w sekcji Konto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar a sessão de um dispositivo termina de imediato o seu início de sessão nesta conta. Para terminar a sessão neste telefone, use Terminar sessão em Conta."
          }
        }
      }
    },
