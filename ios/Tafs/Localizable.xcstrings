    "watch.coach_needs_consent": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ilə danışmazdan əvvəl telefonunuzda tafs-da süni intellektin istifadəsinə icazə verin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преди да говорите с Coach, разрешете използването на ИИ в tafs на телефона си."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než budete mluvit s Coachem, povolte v tafs v telefonu používání AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du mit Coach sprichst, erlaube die KI-Nutzung in tafs auf deinem Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you talk to Coach, allow AI use in tafs on your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de hablar con Coach, permite el uso de IA en tafs en tu teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Enne Coachiga rääkimist luba telefonis tafsis tehisintellekti (AI) kasutamine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de parler à Coach, autorisez l'utilisation de l'IA dans tafs sur votre téléphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prije nego što razgovarate s Coachom, dopustite upotrebu AI-ja u tafsu na telefonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mielőtt a Coach-csal beszélsz, engedélyezd az MI használatát a tafsben a telefonodon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախքան Coach-ի հետ խոսելը, ձեր հեռախոսում tafs-ում թույլատրեք AI-ի օգտագործումը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelum berbicara dengan Coach, izinkan penggunaan AI di tafs pada ponsel Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di parlare con Coach, consenti l'uso dell'IA in tafs sul telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coachと話す前に、スマートフォンのtafsでAIの使用を許可してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სანამ Coach-ს ესაუბრებით, თქვენს ტელეფონზე tafs-ში ჩართეთ AI-ის გამოყენება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach와 대화하기 전에 휴대폰의 tafs에서 AI 사용을 허용하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš kalbėdami su Coach, telefone leiskite tafs naudoti AI."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms runā ar Coach, atļauj AI lietošanu tafs savā tālrunī."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta eerst AI-gebruik toe in tafs op je telefoon voordat je met Coach praat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim porozmawiasz z Coachem, zezwól na użycie AI w tafs na telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de falar com o Coach, permita a utilização de IA no tafs no telemóvel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de falar com o Coach, permita o uso de IA no tafs no celular."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înainte să vorbiți cu Coach, permiteți utilizarea AI în tafs pe telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kým budete hovoriť s Coachom, povoľte v tafs v telefóne používanie AI."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preden se pogovarjate s Coachem, v tafs v telefonu dovolite uporabo umetne inteligence."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Para se të flisni me Coach, lejoni përdorimin e AI në tafs në telefonin tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre nego šta razgovarate s Coachom, dozvolite upotrebu AI-ja u tafsu na telefonu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนคุยกับ Coach ให้อนุญาตการใช้ AI ใน tafs บนโทรศัพท์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ile konuşmadan önce telefonunuzdaki tafs'ta yapay zekâ kullanımına izin verin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi trò chuyện với Coach, hãy cho phép dùng AI trong tafs trên điện thoại của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 Coach 交談之前，請先在手機上的 tafs 中允許使用 AI。"
          }
        }
      }
    },
