    "billing.ask.line_pack": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل طلبك إلى مسؤولي حسابك. عندما يضيف أحدهم الحزمة، تواصل tafs لديك عملها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınızın administratorları sorğunuzu alır. Biri paketi əlavə edəndə taf-larınız davam edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Администраторите на акаунта ви получават заявката ви. Когато някой добави пакета, вашите tafs продължават."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্টের অ্যাডমিনরা আপনার অনুরোধ পান। কেউ প্যাকটি যোগ করলে আপনার taf চলতে থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els administradors del teu compte reben la teva sol·licitud. Quan un afegeixi el paquet, els teus taf continuaran."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Správci vašeho účtu dostanou vaši žádost. Jakmile některý přidá balíček, vaše tafy pokračují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Admins deines Kontos erhalten deine Anfrage. Sobald einer das Paket hinzufügt, arbeiten deine tafs weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account's admins get your request. When one adds the pack, your tafs go on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los administradores de tu cuenta reciben tu solicitud. Cuando uno añada el paquete, tus tafs seguirán."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu konto administraatorid saavad sinu taotluse. Kui keegi neist krediidipaketi lisab, saavad sinu tafid jätkata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les administrateurs de votre compte reçoivent votre demande. Dès que l'un d'eux ajoute le pack, vos tafs continuent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנהלי החשבון שלך מקבלים את הבקשה. כשאחד מהם מוסיף את החבילה, ה-taf שלך ממשיכים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खाते के एडमिन को आपका अनुरोध मिलता है। जब कोई पैक जोड़ता है, आपके taf चलते रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratori vašeg računa primaju vaš zahtjev. Kad jedan doda paket, vaši tafovi nastavljaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiókod adminjai megkapják a kérésedet. Amint egyikük hozzáadja a csomagot, a tafjaid folytatják."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր հաշվի ադմինիստրատորները ստանում են ձեր հարցումը։ Երբ նրանցից մեկը ավելացնի փաթեթը, ձեր taf-երը կշարունակեն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Admin akun Anda menerima permintaan Anda. Saat salah satunya menambahkan paket, tafs Anda berlanjut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli amministratori del tuo account ricevono la tua richiesta. Quando uno aggiunge il pacchetto, i tuoi tafs continuano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼はアカウントの管理者に届きます。管理者がパックを追加すると、tafsは動作を続けます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი ანგარიშის ადმინისტრატორები იღებენ თქვენს მოთხოვნას. როცა ერთ-ერთი პაკეტს დაამატებს, თქვენი taf-ები გააგრძელებენ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកគ្រប់គ្រងគណនីរបស់អ្នកទទួលសំណើរបស់អ្នក។ នៅពេលម្នាក់បន្ថែមកញ្ចប់ taf របស់អ្នកបន្ត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정의 관리자에게 요청이 전달됩니다. 관리자가 팩을 추가하면 taf가 계속 작동합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຜູ້ດູແລຂອງບັນຊີທ່ານໄດ້ຮັບຄຳຂໍຂອງທ່ານ. ເມື່ອຄົນໜຶ່ງເພີ່ມຊຸດ taf ຂອງທ່ານສືບຕໍ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
