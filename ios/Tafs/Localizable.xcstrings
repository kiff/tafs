    "door.anyone_else_today": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@ von allen anderen heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@ from anyone else today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ de cualquier otra persona hoy."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täna kõigilt teistelt %1$@/%2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@ de toute autre personne aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ su %2$@ da chiunque altro oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の他の人からの連絡：%2$@件中%1$@件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 다른 사람에게서 %2$@건 중 %1$@건."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien: %1$@ iš %2$@ – iš kitų žmonių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "No visiem citiem šodien: %1$@ no %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van %2$@ van anderen vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ z %2$@ od wszystkich innych dziś."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ de qualquer outra pessoa hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ de qualquer outra pessoa hoje."
          }
        }
      }
    },
    "door.api.boundary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel einer Tür kann %1$@ nur Arbeit geben. Er kann nie zahlen oder kaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A door's key can only hand %1$@ work. It can never pay or buy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de una puerta solo puede darle trabajo a %1$@. Nunca puede pagar ni comprar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukse võti saab tafile %1$@ ainult tööd anda. See ei saa kunagi maksta ega osta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé d'une porte peut seulement confier du travail à %1$@. Elle ne peut jamais payer ni acheter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di una porta può solo affidare lavoro a %1$@. Non può mai pagare né comprare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "窓口のキーでできるのは%1$@に仕事を渡すことだけです。支払いや購入は決してできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창구의 키로는 %1$@에게 작업을 맡기는 것만 할 수 있습니다. 결제나 구매는 절대 할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durų raktas gali tik perduoti darbą %1$@. Juo niekada negalima mokėti ar pirkti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Durvju atslēga var tikai nodot %1$@ darbu. Tā nekad nevar maksāt vai pirkt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel van een deur kan %1$@ alleen werk geven. Hij kan nooit betalen of kopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz do drzwi może tylko zlecać pracę dla %1$@. Nigdy nie może płacić ani kupować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de uma porta só pode entregar trabalho a %1$@. Nunca pode pagar nem comprar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de uma porta só pode entregar trabalho a %1$@. Nunca pode pagar nem comprar."
          }
        }
      }
    },
    "door.api.copied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert. Er wird nicht noch einmal angezeigt."
          }
        },
        "en": {
