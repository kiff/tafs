    "card.kiff_did_not_revoke_cards": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُلغِ KIFF %1$@ من الـ Cards الخاصة به: ألغِها في KIFF."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF Card-larından %1$@ ədədini ləğv etmədi: onları KIFF-də ləğv edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF не оттегли %1$@ от неговите Cards: оттеглете ги в KIFF."
