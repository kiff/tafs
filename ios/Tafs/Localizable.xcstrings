        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo počnite iz Povezanih aplikacija na ovom uređaju (%1$@)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มจากแอปที่เชื่อมต่อบน%1$@เครื่องนี้ก่อน"
