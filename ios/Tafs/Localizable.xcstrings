    "connect.login_what": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ xidmətinə daxil olduğunuz e-poçt ünvanı. Açar %1$@ daxilində bu şəxs kimi fəaliyyət göstərir, ona görə özünüzünkündən istifadə edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имейл адресът, с който влизате в %1$@. Ключът действа като този човек в %1$@, затова използвайте своя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mailová adresa, kterou se přihlašujete do %1$@. Klíč jedná v %1$@ jako tento člověk, takže použijte svou vlastní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die E-Mail-Adresse, mit der du dich bei %1$@ anmeldest. Der Schlüssel handelt in %1$@ als diese Person, also nimm deine eigene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The email address you sign in to %1$@ with. The key acts as this person in %1$@, so use your own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección de correo con la que inicias sesión en %1$@. La clave actúa como esa persona en %1$@, así que usa la tuya."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posti aadress, millega logid sisse teenusesse %1$@. Võti tegutseb teenuses %1$@ selle inimesena, seega kasuta enda oma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse e-mail avec laquelle vous vous connectez à %1$@. La clé agit en tant que cette personne dans %1$@ : utilisez donc la vôtre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa e-pošte kojom se prijavljujete u aplikaciju %1$@. Ključ djeluje kao ova osoba u aplikaciji %1$@, zato upotrijebite svoju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az e-mail-cím, amellyel ide bejelentkezel: %1$@. A kulcs ennek a személynek a nevében cselekszik itt: %1$@, ezért a sajátodat használd."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Էլ. փոստի հասցեն, որով մուտք եք գործում %1$@։ Բանալին գործում է այս մարդու անունից %1$@-ում, ուստի օգտագործեք ձերը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat email yang Anda pakai untuk masuk ke %1$@. Kunci bertindak sebagai orang ini di %1$@, jadi pakai alamat Anda sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indirizzo email con cui accedi a %1$@. La chiave agisce come questa persona in %1$@, quindi usa il tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@へのサインインに使うメールアドレスです。キーは%1$@でこの人として動作するため、ご自身のものを使ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ელფოსტის მისამართი, რომლითაც %1$@-ში შედიხართ. გასაღები მოქმედებს ამ ადამიანის სახელით %1$@-ში, ამიტომ გამოიყენეთ თქვენი."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 로그인할 때 쓰는 이메일 주소입니다. 키는 %1$@에서 이 사람으로 행동하므로 내 주소를 쓰세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "El. pašto adresas, kuriuo prisijungiate prie %1$@. Raktas %1$@ veikia šio asmens vardu, todėl naudokite savo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "E-pasta adrese, ar kuru tu pierakstījies %1$@. Atslēga %1$@ darbojas šīs personas vārdā, tāpēc izmanto savējo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het e-mailadres waarmee je inlogt bij %1$@. De sleutel handelt in %1$@ als deze persoon, dus gebruik je eigen adres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres e-mail, którym logujesz się do %1$@. Klucz działa w %1$@ jako ta osoba, więc podaj własny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço de email com que inicia sessão no %1$@. A chave age como essa pessoa no %1$@, por isso use o seu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço de email com que faz login no %1$@. A chave age como essa pessoa no %1$@, por isso use o seu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa de e-mail cu care vă conectați la %1$@. Cheia acționează ca această persoană în %1$@, așa că folosiți-o pe a dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mailová adresa, ktorou sa prihlasujete do %1$@. Kľúč koná v %1$@ ako tento človek, takže použite svoju vlastnú."
