        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach знае, и го предава повторно."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach мэднэ, мөн дахин хүлээлгэн өгнө."
