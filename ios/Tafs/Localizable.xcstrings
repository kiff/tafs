    "settings.devices.passkey_too_slow": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق ذلك وقتًا طويلًا. حاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çox uzun çəkdi. Yenidən cəhd edin."
          }
