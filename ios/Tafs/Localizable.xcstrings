    "voice.tafs_turns_your_voice_into": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs səsinizi bu cihazda mətnə çevirir. Səsiniz heç yerə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs превръща гласа ви в текст на това устройство. Гласът ви не се изпраща никъде."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs mění váš hlas na text přímo v tomto zařízení. Váš hlas se nikam neodesílá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs wandelt deine Stimme auf diesem Gerät in Text um. Deine Stimme wird nirgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs turns your voice into text on this device. Your voice isn't sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs convierte tu voz en texto en este dispositivo. Tu voz no se envía a ningún sitio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs muudab sinu hääle selles seadmes tekstiks. Sinu häält ei saadeta kuhugi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs transforme votre voix en texte sur cet appareil. Votre voix n'est envoyée nulle part."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs pretvara vaš glas u tekst na ovom uređaju. Vaš glas ne šalje se nikamo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tafs ezen az eszközön alakítja szöveggé a hangodat. A hangod sehová sem kerül el."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-ը ձեր ձայնը վերածում է տեքստի այս սարքում։ Ձեր ձայնը ոչ մի տեղ չի ուղարկվում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs mengubah suara Anda menjadi teks di perangkat ini. Suara Anda tidak dikirim ke mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs trasforma la tua voce in testo su questo dispositivo. La tua voce non viene inviata da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsはこのデバイス上で声をテキストに変換します。声はどこにも送信されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs თქვენს ხმას ტექსტად აქცევს ამ მოწყობილობაზე. თქვენი ხმა არსად იგზავნება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs는 이 기기에서 음성을 텍스트로 바꿉니다. 음성은 어디에도 보내지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs paverčia jūsų balsą tekstu šiame įrenginyje. Jūsų balsas niekur nesiunčiamas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs šajā ierīcē pārvērš tavu balsi tekstā. Tava balss netiek nekur sūtīta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs zet je stem op dit apparaat om in tekst. Je stem wordt nergens heen gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs zamienia Twój głos w tekst na tym urządzeniu. Twój głos nie jest nigdzie wysyłany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs transforma a sua voz em texto neste dispositivo. A sua voz não é enviada para lado nenhum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs transforma a sua voz em texto neste dispositivo. A sua voz não é enviada para lado nenhum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs transformă vocea dvs. în text pe acest dispozitiv. Vocea nu este trimisă nicăieri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs mení váš hlas na text priamo v tomto zariadení. Váš hlas sa nikam neposiela."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs vaš glas spremeni v besedilo na tej napravi. Vaš glas se nikamor ne pošlje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs e kthen zërin tuaj në tekst në këtë pajisje. Zëri juaj nuk dërgohet askund."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs pretvara vaš glas u tekst na ovom uređaju. Vaš glas ne šalje se nikamo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs เปลี่ยนเสียงของคุณเป็นข้อความบนอุปกรณ์นี้ เสียงของคุณไม่ถูกส่งไปที่ไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs sesinizi bu cihazda metne dönüştürür. Sesiniz hiçbir yere gönderilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs chuyển giọng nói của bạn thành văn bản trên thiết bị này. Giọng nói của bạn không được gửi đi đâu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs 在這部裝置上將您的語音轉成文字。您的語音不會傳送到任何地方。"
          }
        }
      }
    },
