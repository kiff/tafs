        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leállítva az összes tafoddal együtt. Folytasd mindet, hogy futhasson."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանգնեցված է ձեր բոլոր taf-երի հետ։ Վերսկսեք բոլորը, որ այն աշխատի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibekukan bersama semua tafs Anda. Lanjutkan semuanya agar ia berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccato insieme a tutti i tuoi tafs. Riprendili tutti per lasciarlo lavorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのtafとともに遮断されています。実行するには、すべてを再開してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაჩერებულია თქვენს ყველა taf-თან ერთად. განაახლეთ ყველა, რომ ის გაეშვას."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានបញ្ឈប់ជាមួយ taf ទាំងអស់របស់អ្នក។ បន្តទាំងអស់ដើម្បីឱ្យវាដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 tafs와 함께 차단되었습니다. 실행하려면 모두 재개하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຢຸດພ້ອມທຸກ taf ຂອງທ່ານ. ສືບຕໍ່ທັງໝົດເພື່ອໃຫ້ມັນເຮັດວຽກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustabdytas kartu su visais jūsų taf. Tęskite juos visus, kad jis galėtų veikti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apturēts kopā ar visiem taviem taf. Turpini tos visus, lai tas varētu darboties."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрен со сите твои tafови. Продолжи ги сите за да работи."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны бүх taf-тай хамт зогссон. Ажиллуулахын тулд бүгдийг нь үргэлжлүүлнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंका सबै taf सँगै रोकिएको छ। चल्न दिन सबै फेरि सुरु गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilgezet met al je tafs. Hervat ze allemaal om het te laten draaien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowane razem ze wszystkimi Twoimi tafs. Wznów je wszystkie, aby mógł działać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado com todos os seus tafs. Retome-os todos para que possa funcionar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado com todos os seus tafs. Retome-os todos para que possa funcionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprit împreună cu toate tafurile dvs. Reluați-le pe toate ca să-l lăsați să ruleze."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavené so všetkými vašimi tafmi. Obnovte ich všetky, aby mohol bežať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustavljeno z vsemi vašimi tafi. Nadaljujte jih vse, da bo lahko tekel."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bllokuar me të gjithë tafs-et tuaj. Riniseni të gjithë që ai të ekzekutohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiran zajedno sa svim vašim tafovima. Nastavite ih sve da ga pustite da radi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถูกระงับพร้อม taf ทั้งหมดของคุณ ให้ทั้งหมดทำต่อเพื่อให้มันทำงาน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähli tafs-laryňyz bilen togtadyldy. Işlemegi üçin hemmesini dowam etdiriň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm tafs'larınızla birlikte donduruldu. Çalışması için hepsini sürdürün."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے تمام tafs کے ساتھ روکا گیا۔ اسے چلانے کے لیے سب کو دوبارہ چلائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bị đóng băng cùng mọi taf của bạn. Hãy cho tất cả tiếp tục để nó chạy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已與您的所有 taf 一同凍結。請全部繼續，才能讓它執行。"
          }
        }
      }
