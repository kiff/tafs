    "record.did_this_happen.what_no_does": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nein“ gibt der Card ihren Spielraum zurück. „Ja“ lässt es gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No gives the Card its room back. Yes keeps it counted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«No» devuelve el margen a la Card. «Sí» lo mantiene contado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non rend sa marge à la Card. Oui le garde compté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No restituisce il margine alla Card. Sì lo lascia conteggiato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nee geeft de Card zijn ruimte terug. Ja laat het meetellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nie” przywraca zapas Card. „Tak” pozostawia to policzone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não devolve a margem ao Card. Sim mantém-na contada."
          }
        }
      }
    },
    "record.did_this_happen.why_lost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Antwort ging verloren, daher kann KIFF nicht sagen, ob es durchgegangen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its answer was lost, so KIFF can't tell whether it went through."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió su respuesta, así que KIFF no puede saber si se completó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa réponse a été perdue : KIFF ne peut pas savoir s'il a abouti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua risposta è andata persa, quindi KIFF non può sapere se è andata a buon fine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het antwoord is verloren gegaan, dus KIFF kan niet zien of het is gelukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego odpowiedź zaginęła, więc KIFF nie wie, czy to przeszło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta perdeu-se, por isso o KIFF não sabe se foi concluída."
          }
        }
      }
    },
    "record.did_this_happen.why_probation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist einer der ersten Aufrufe eines neuen Geldvorgangs, daher fragt KIFF dich, was passiert ist."
          }
        },
        "en": {
