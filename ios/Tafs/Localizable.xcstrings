    "voice.puts_message_box_back": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد مربع الرسالة كما كان."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj qutusunu əvvəlki halına qaytarır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връща полето за съобщение както беше."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বার্তার বাক্স আগের মতো করে দেয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa el quadre de missatge com estava."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátí pole zprávy do původního stavu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt das Nachrichtenfeld auf den vorherigen Stand zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts the message box back as it was."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el cuadro de mensaje como estaba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastab sõnumikasti endisel kujul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet le champ de message tel qu'il était."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחזיר את תיבת ההודעה כפי שהייתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेश बॉक्स को वैसा ही वापस रखता है जैसा था।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraća okvir za poruku kakav je bio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítja az üzenetmezőt az eredeti állapotára."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաղորդագրության դաշտը վերադարձնում է ինչպես եղել է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengembalikan kotak pesan seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta la casella del messaggio com'era."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ欄を元に戻します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეტყობინების ველს ისე აბრუნებს, როგორც იყო."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដាក់ប្រអប់សារត្រឡប់ដូចដើម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지 입력란을 원래대로 되돌립니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເອົາກ່ອງຂໍ້ຄວາມກັບຄືນຄືເກົ່າ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grąžina žinutės laukelį į ankstesnę būseną."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atjauno ziņas lauku tādu, kāds tas bija."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Го враќа полето за порака како што беше."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Мессежийн талбарыг өмнөх байдалд нь буцаана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सन्देश बाकसलाई पहिलेकै अवस्थामा फर्काउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet het berichtvak terug zoals het was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca pole wiadomości do poprzedniego stanu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Repõe a caixa de mensagem como estava."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura a caixa de mensagem como estava."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Readuce caseta de mesaj cum era."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vráti pole správy do pôvodného stavu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polje za sporočilo vrne v prejšnje stanje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "E kthen kutinë e mesazhit siç ishte."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraća okvir za poruku kakav je bio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนช่องข้อความกลับเป็นเหมือนเดิม"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Habar gutusyny öňki ýagdaýyna goýýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj kutusunu eski haline getirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیغام کے خانے کو جیسا تھا ویسا کر دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả hộp tin nhắn về như cũ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將訊息框恢復原狀。"
          }
        }
      }
    },
    "voice.speech_recognition_not_available_language": {
