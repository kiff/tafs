    "knob.not_read_back": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəyişiklik edildi, amma geri oxuna bilmədi. Çeviricini yenidən oxumaq üçün toxunun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промяната е направена, но не можа да бъде прочетена обратно. Докоснете, за да прочетете скалата отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna proběhla, ale nepodařilo se ji zpětně načíst. Klepnutím načtete číselník znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung wurde vorgenommen, konnte aber nicht zurückgelesen werden. Tippe, um das Rad erneut zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change was made but couldn't be read back. Tap to read the dial again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio se hizo, pero no se pudo volver a leer. Toca para leer la rueda de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muudatus tehti, kuid seda ei õnnestunud tagasi lugeda. Puuduta, et valikuketas uuesti lugeda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification a été faite mais n'a pas pu être relue. Touchez pour relire la molette."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena je napravljena, ali je nije bilo moguće pročitati natrag. Dodirnite da ponovno pročitate brojčanik."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosítás megtörtént, de nem sikerült visszaolvasni. Koppints a tárcsa újraolvasásához."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոփոխությունը կատարվեց, բայց հետ չկարդացվեց։ Հպեք՝ թվատախտակը նորից կարդալու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan dibuat tetapi tidak dapat dibaca kembali. Ketuk untuk membaca dial lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica è stata fatta ma non è stato possibile rileggerla. Tocca per rileggere il quadrante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は行われましたが、再読み込みできませんでした。タップしてダイヤルを再読み込みしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცვლილება შესრულდა, მაგრამ უკან ვერ წაიკითხა. შეეხეთ, რომ ციფერბლატი ხელახლა წაიკითხოთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경은 되었지만 다시 읽지 못했습니다. 탭하여 다이얼을 다시 읽으세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakeitimas atliktas, bet jo nepavyko nuskaityti. Palieskite, kad dar kartą nuskaitytumėte ratuką."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmaiņa tika veikta, bet to nevarēja nolasīt atpakaļ. Pieskaries, lai vēlreiz nolasītu ripu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijziging is gemaakt maar kon niet worden teruggelezen. Tik om de draaiknop opnieuw te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana została wprowadzona, ale nie udało się jej odczytać. Dotknij, aby odczytać pokrętło ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração foi feita mas não foi possível relê-la. Toque para ler o seletor novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração foi feita mas não foi possível relê-la. Toque para ler o seletor novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificarea s-a făcut, dar nu a putut fi recitită. Atingeți pentru a citi din nou cadranul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena prebehla, ale nepodarilo sa ju spätne načítať. Ťuknutím načítate číselník znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprememba je bila narejena, a je ni bilo mogoče prebrati nazaj. Tapnite, da znova preberete številčnico."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndryshimi u bë, por nuk u lexua dot prapë. Prekni për ta lexuar sërish cilësimin."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Promena je napravljena, ali je nije bilo moguće pročitati natrag. Dodirnite da ponovo pročitate brojčanik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำการเปลี่ยนแปลงแล้วแต่อ่านกลับไม่ได้ แตะเพื่ออ่านปุ่มหมุนอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklik yapıldı ama geri okunamadı. Kadranı tekrar okumak için dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi đã được thực hiện nhưng không đọc lại được. Chạm để đọc lại núm xoay."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更已完成，但無法讀回。輕點以重新讀取旋鈕。"
          }
        }
      }
    },
    "knob.not_recorded": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoşulma dinləyir, amma çevirici onu hələ qeyd etməyib. Qeyd etmək üçün yenidən təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връзката следи, но скалата още не я е записала. Одобрете отново, за да я запише."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení naslouchá, ale číselník to ještě nezaznamenal. Schvalte znovu, aby se to zaznamenalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung hört zu, aber das Rad hat es noch nicht festgehalten. Genehmige erneut, um es festzuhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection is listening, but the dial hasn't recorded it yet. Approve again to record it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión está escuchando, pero la rueda aún no lo ha registrado. Vuelve a aprobar para registrarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendus ootab sündmusi, kuid valikuketas pole seda veel salvestanud. Salvestamiseks kinnita uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion écoute, mais la molette ne l'a pas encore enregistré. Approuvez à nouveau pour l'enregistrer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza osluškuje, ali je brojčanik još nije zabilježio. Odobrite ponovno da je zabilježite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolat figyel, de a tárcsa még nem rögzítette. Hagyd jóvá újra a rögzítéshez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կապը լսում է, բայց թվատախտակը դեռ չի գրանցել այն։ Հաստատեք նորից՝ գրանցելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi mendengarkan, tetapi dial belum mencatatnya. Setujui lagi untuk mencatatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento è in ascolto, ma il quadrante non l'ha ancora registrato. Approva di nuovo per registrarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続は受信中ですが、まだダイヤルに記録されていません。記録するにはもう一度承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კავშირი უსმენს, მაგრამ ციფერბლატს ის ჯერ არ ჩაუწერია. დაამტკიცეთ ხელახლა ჩასაწერად."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결은 수신 중이지만 다이얼에 아직 기록되지 않았습니다. 기록하려면 다시 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryšys klausosi, bet ratukas to dar neįrašė. Patvirtinkite dar kartą, kad tai būtų įrašyta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Savienojums klausās, bet ripa to vēl nav reģistrējusi. Apstiprini vēlreiz, lai to reģistrētu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De koppeling luistert, maar de draaiknop heeft het nog niet vastgelegd. Je moet het opnieuw goedkeuren om het vast te leggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie nasłuchuje, ale pokrętło jeszcze tego nie zapisało. Zatwierdź ponownie, aby to zapisać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação está à escuta, mas o seletor ainda não o registou. Aprove novamente para o registar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão está escutando, mas o seletor ainda não registrou isso. Aprove novamente para registrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea ascultă, dar cadranul nu a înregistrat-o încă. Aprobați din nou pentru a o înregistra."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojenie počúva, ale číselník to ešte nezaznamenal. Schváľte znova, aby sa to zaznamenalo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezava posluša, a številčnica tega še ni zabeležila. Znova odobrite, da se zabeleži."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidhja po dëgjon, por cilësimi ende nuk e ka regjistruar. Miratoni sërish për ta regjistruar."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza osluškuje, ali je brojčanik još nije zabilježio. Odobrite ponovo da je zabilježite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อกำลังรับฟังอยู่ แต่ปุ่มหมุนยังไม่ได้บันทึก อนุมัติอีกครั้งเพื่อบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı dinliyor ama kadran henüz kaydetmedi. Kaydetmek için tekrar onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối đang lắng nghe, nhưng núm xoay chưa ghi lại. Hãy phê duyệt lại để ghi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線正在監聽，但旋鈕尚未記錄。請再次核准以記錄。"
          }
        }
      }
    },
    "knob.one_confirmation": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir təsdiq üç halqanın hamısını təyin edir."
          }
        },
        "bg": {
