        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se podívám, co jsem poslední dobou udělal, "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ich mir ansehe, was ich in letzter Zeit getan habe, "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking at what I did lately, "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viendo lo que hice últimamente, "
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaadates, mida ma viimasel ajal tegin: "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En regardant ce que j'ai fait dernièrement, "
          }
        },
        "he": {
