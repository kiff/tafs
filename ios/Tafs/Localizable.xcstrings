        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefondan yanıtlamak için oturumu kapatıp tekrar açın, böylece KIFF anahtarını tanır. Ya da bunu KIFF'te yanıtlayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فون سے جواب دینے کے لیے سائن آؤٹ ہو کر دوبارہ سائن اِن کریں، تاکہ KIFF اس کی کلید جان لے۔ یا اس کا جواب KIFF میں دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng xuất rồi đăng nhập lại để trả lời từ điện thoại này, để KIFF biết khóa của nó. Hoặc trả lời cái này trong KIFF."
          }
        },
        "zh-Hant": {
          "stringUnit": {
