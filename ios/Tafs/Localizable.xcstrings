    "coach.ask_not_this_cards": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Quraşdırma bu telefondan bu kartın olmayan bir şeyi imzalamağı xahiş etdi. Heç nə imzalanmadı."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup помоли този телефон да подпише нещо, което не е от тази карта. Нищо не беше подписано."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup požádal tento telefon, aby podepsal něco, co nepatří k této kartě. Nic se nepodepsalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup hat dieses Telefon gebeten, etwas zu signieren, das nicht zu dieser Karte gehört. Es wurde nichts signiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup asked this phone to sign something that isn't this card's. Nothing was signed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración pidió a este teléfono firmar algo que no es de esta tarjeta. No se firmó nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup palus sellel telefonil allkirjastada midagi, mis pole selle kaardi oma. Midagi ei allkirjastatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Configuration a demandé à ce téléphone de signer quelque chose qui n'appartient pas à cette fiche. Rien n'a été signé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup je tražio da ovaj telefon potpiše nešto što nije od ove kartice. Ništa nije potpisano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Setup arra kérte ezt a telefont, hogy írjon alá valamit, ami nem ehhez a kártyához tartozik. Semmi sem lett aláírva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup-ը խնդրեց այս հեռախոսից ստորագրել մի բան, որ այս քարտինը չէ։ Ոչինչ չստորագրվեց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup meminta ponsel ini menandatangani sesuatu yang bukan milik kartu ini. Tidak ada yang ditandatangani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione ha chiesto a questo telefono di firmare qualcosa che non appartiene a questa scheda. Non è stato firmato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットアップがこのカードのものではない内容への署名をこのスマートフォンに求めました。何も署名されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup-მა ამ ტელეფონს სთხოვა ისეთის ხელმოწერა, რაც ამ ბარათისა არ არის. არაფერს მოეწერა ხელი."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성에서 이 휴대폰에 이 카드가 아닌 것에 서명해 달라고 요청했습니다. 서명된 것은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup paprašė šio telefono pasirašyti tai, kas nepriklauso šiai kortelei. Niekas nepasirašyta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup lūdza šim tālrunim parakstīt kaut ko, kas neattiecas uz šo kartīti. Nekas netika parakstīts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup vroeg deze telefoon iets te ondertekenen dat niet bij deze kaart hoort. Er is niets ondertekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja poprosiła ten telefon o podpisanie czegoś, co nie należy do tej karty. Nic nie zostało podpisane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Configuração pediu a este telefone para assinar algo que não pertence a este cartão. Nada foi assinado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Configuração pediu a este telefone para assinar algo que não pertence a este cartão. Nada foi assinado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup i-a cerut acestui telefon să semneze ceva ce nu ține de acest card. Nu s-a semnat nimic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup požiadal tento telefón, aby podpísal niečo, čo nepatrí k tejto karte. Nič sa nepodpísalo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup je ta telefon prosil, naj podpiše nekaj, kar ne pripada tej kartici. Nič ni bilo podpisano."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup i kërkoi këtij telefoni të nënshkruajë diçka që nuk është e kësaj karte. Asgjë nuk u nënshkrua."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup je tražio da ovaj telefon potpiše nešto šta nije od ove kartice. Ništa nije potpisano."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าขอให้โทรศัพท์เครื่องนี้ลงนามสิ่งที่ไม่ใช่ของการ์ดนี้ ยังไม่มีอะไรถูกลงนาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup bu telefondan, bu kartın olmayan bir şeyi imzalamasını istedi. Hiçbir şey imzalanmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt đã yêu cầu điện thoại này ký một thứ không thuộc về Card này. Chưa có gì được ký."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定要求這部手機簽署不屬於這張卡片的內容。未簽署任何項目。"
          }
        }
      }
    },
    "coach.away": {
