            "value": "Տարբերակ %1$@-ի տեղադրումը չավարտվեց։ %2$@ Ձեր taf-ը չի աշխատում, մինչև չավարտեք կամ չեղարկեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemasangan versi %1$@ tidak selesai. %2$@ Taf Anda tidak berjalan sampai Anda menyelesaikan atau membatalkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installazione della versione %1$@ non è stata completata. %2$@ Il tuo taf non lavora finché non la completi o la annulli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン%1$@のインストールは完了しませんでした。%2$@ 完了するかキャンセルするまで、tafは動きません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერსია %1$@-ის დაყენება არ დასრულდა. %2$@ თქვენი taf არ მუშაობს, სანამ არ დაასრულებთ ან არ გააუქმებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការដំឡើងកំណែ %1$@ មិនបានបញ្ចប់ទេ។ %2$@ taf របស់អ្នកមិនដំណើរការទេ រហូតដល់អ្នកបញ្ចប់ ឬបោះបង់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 %1$@ 설치가 끝나지 않았습니다. %2$@ 마치거나 취소할 때까지 taf는 실행되지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການຕິດຕັ້ງເວີຊັນ %1$@ ບໍ່ສຳເລັດ. %2$@ taf ຂອງທ່ານບໍ່ເຮັດວຽກຈົນກວ່າທ່ານຈະສຳເລັດ ຫຼື ຍົກເລີກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ versijos diegimas nebaigtas. %2$@ Jūsų taf neveikia, kol jo neužbaigsite ar neatšauksite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Versijas %1$@ instalēšana netika pabeigta. %2$@ Tavs taf nedarbojas, līdz tu to pabeigsi vai atcelsi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирањето на верзијата %1$@ не заврши. %2$@ Твојот taf не работи додека не завршиш или не откажеш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-р хувилбарыг суулгаж дуусгасангүй. %2$@ Дуусгах эсвэл цуцлах хүртэл таны taf ажиллахгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण %1$@ को स्थापना सकिएन। %2$@ तपाईंले सक्नुअघि वा रद्द नगरेसम्म तपाईंको taf चल्दैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het installeren van versie %1$@ is niet afgerond. %2$@ Je taf draait niet tot je het afrondt of annuleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacja wersji %1$@ nie została ukończona. %2$@ Twój taf nie działa, dopóki jej nie dokończysz albo nie anulujesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação da versão %1$@ não foi concluída. %2$@ O seu taf não é executado até a concluir ou cancelar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação da versão %1$@ não foi concluída. %2$@ O seu taf não é executado até a concluir ou cancelar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalarea versiunii %1$@ nu s-a finalizat. %2$@ Taful nu rulează până nu finalizați sau anulați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Inštalácia verzie %1$@ sa nedokončila. %2$@ Váš taf nebeží, kým ju nedokončíte alebo nezrušíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namestitev različice %1$@ se ni dokončala. %2$@ Vaš taf ne teče, dokler je ne dokončate ali prekličete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalimi i versionit %1$@ nuk përfundoi. %2$@ Taf-i juaj nuk ekzekutohet derisa ta përfundoni ose ta anuloni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacija verzije %1$@ nije završena. %2$@ Vaš taf ne radi dok je ne dovršite ili otkažete."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การติดตั้งเวอร์ชัน %1$@ ไม่เสร็จสิ้น %2$@ taf ของคุณจะไม่ทำงานจนกว่าคุณจะทำให้เสร็จหรือยกเลิก"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wersiýany gurmak gutarmady. %2$@ Siz gutarýançaňyz ýa-da ýatyrýançaňyz taf-yňyz işlemeýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. sürümün kurulumu tamamlanmadı. %2$@ Siz bitirene veya iptal edene kadar taf'ınız çalışmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ورژن %1$@ کی انسٹالیشن مکمل نہیں ہوئی۔ %2$@ جب تک آپ اسے مکمل یا منسوخ نہ کریں آپ کا taf نہیں چلتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc cài phiên bản %1$@ chưa hoàn tất. %2$@ Taf của bạn không chạy cho đến khi bạn hoàn tất hoặc hủy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝版本 %1$@ 未完成。%2$@ 在您完成或取消之前，您的 taf 不會執行。"
          }
        }
      }
    },
