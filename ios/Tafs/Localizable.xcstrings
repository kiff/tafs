    "door.start_connected_tools_first_slack": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne zuerst unter „Verbundene Apps“ auf diesem %1$@. Das Slack-Abonnement muss beendet werden, bevor seine Tür entfernt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start from Connected apps on this %1$@ first. Slack's subscription must be stopped before removing its door."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza primero desde Apps conectadas en este %1$@. La suscripción de Slack debe detenerse antes de eliminar su puerta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alusta kõigepealt selle seadme (%1$@) vaatest Ühendatud rakendused. Enne ukse eemaldamist tuleb Slacki tellimus lõpetada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez d'abord depuis Apps connectées sur %2$@. L'abonnement Slack doit être arrêté avant de supprimer sa porte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia prima da App collegate su questo %1$@. L'ascolto di Slack va interrotto prima di rimuovere la sua porta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずこの%1$@の「接続済みのアプリ」から始めてください。窓口を削除する前に、Slackの購読を停止する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 이 %1$@의 연결된 앱에서 시작하세요. 창구를 삭제하기 전에 Slack 구독을 멈춰야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmiausia pradėkite nuo „Prijungtos programėlės“ šiame įrenginyje (%1$@). Prieš šalinant Slack duris, reikia nutraukti Slack prenumeratą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vispirms sāc sadaļā “Pievienotās lietotnes” šajā ierīcē (%1$@). Pirms durvju noņemšanas jāatceļ Slack abonements."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin eerst bij Gekoppelde apps op deze %1$@. Het abonnement van Slack moet worden gestopt voordat je de deur verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zacznij od Połączonych aplikacji na tym urządzeniu (%1$@). Subskrypcja Slacka musi zostać zatrzymana przed usunięciem jego drzwi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece primeiro em Apps ligadas neste %1$@. A subscrição do Slack tem de ser parada antes de remover a sua porta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece primeiro em Apps conectados neste %1$@. A assinatura do Slack precisa ser interrompida antes de remover a sua porta."
          }
        }
      }
    },
