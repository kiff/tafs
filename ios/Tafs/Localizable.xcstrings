        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन पर कोई फ़िंगरप्रिंट सेट नहीं है। उसकी सेटिंग में एक जोड़ें, फिर लौट आएँ।"
