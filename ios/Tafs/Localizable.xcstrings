    "sample.bill_pay.job": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادفع فواتير الموردين الاعتيادية المطابقة لأمر شراء. الموردون الحاليون فقط. لا تغيّر التفاصيل المصرفية ولا تضف مستفيدًا أبدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Satınalma sifarişinə uyğun gələn adi təchizatçı hesablarını ödəyin. Yalnız mövcud təchizatçılar. Heç vaxt bank rekvizitlərini dəyişməyin və ya yeni alıcı əlavə etməyin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плащайте обичайните фактури на доставчици, които съответстват на поръчка за покупка. Само съществуващи доставчици. Никога не променяйте банкови данни и не добавяйте получатели."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্রয় আদেশের সঙ্গে মেলে এমন নিয়মিত সরবরাহকারীর বিল পরিশোধ করুন। শুধু বিদ্যমান সরবরাহকারী। ব্যাংকের তথ্য বদলাবেন না বা নতুন প্রাপক যোগ করবেন না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga les factures rutinàries de proveïdors que coincideixin amb una comanda de compra. Només proveïdors existents. Mai no canviïs dades bancàries ni afegeixis un destinatari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platit běžné faktury dodavatelů, které odpovídají objednávce. Jen stávající dodavatelé. Nikdy neměnit bankovní údaje ani nepřidávat příjemce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezahle routinemäßige Lieferantenrechnungen, die zu einer Bestellung passen. Nur bestehende Lieferanten. Ändere nie Bankdaten und füge keinen Zahlungsempfänger hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay routine vendor bills that match a purchase order. Existing vendors only. Never change bank details or add a payee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga facturas habituales de proveedores que coincidan con una orden de compra. Solo proveedores existentes. Nunca cambies datos bancarios ni añadas un beneficiario."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksa tavapärased tarnijate arved, mis vastavad ostutellimusele. Ainult olemasolevad tarnijad. Ära kunagi muuda pangaandmeid ega lisa makse saajat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payer les factures courantes des fournisseurs qui correspondent à un bon de commande. Fournisseurs existants uniquement. Ne jamais modifier les coordonnées bancaires ni ajouter de bénéficiaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשלם חשבוניות ספקים שגרתיות שתואמות להזמנת רכש. רק ספקים קיימים. לעולם לא לשנות פרטי בנק ולא להוסיף מוטב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीद ऑर्डर से मेल खाने वाले नियमित विक्रेता बिलों का भुगतान करें। केवल मौजूदा विक्रेता। बैंक विवरण कभी न बदलें और कोई नया प्राप्तकर्ता न जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaćajte redovne račune dobavljača koji odgovaraju narudžbenici. Samo postojeći dobavljači. Nikad ne mijenjajte bankovne podatke i ne dodajte primatelja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fizesd ki a rendelésnek megfelelő rutinszerű szállítói számlákat. Csak meglévő szállítók. Soha ne módosíts bankadatokat, és ne adj hozzá kedvezményezettet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վճարեք մատակարարների սովորական հաշիվները, որոնք համապատասխանում են գնման պատվերին։ Միայն առկա մատակարարներ։ Երբեք մի փոխեք բանկային տվյալները և մի ավելացրեք ստացող։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayar tagihan vendor rutin yang cocok dengan pesanan pembelian. Hanya vendor yang ada. Jangan pernah mengubah rincian bank atau menambah penerima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga le fatture ordinarie dei fornitori che corrispondono a un ordine d'acquisto. Solo fornitori esistenti. Non cambiare mai le coordinate bancarie e non aggiungere beneficiari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発注書と一致する定例の取引先請求書を支払います。既存の取引先のみ。口座情報の変更や支払先の追加は行いません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადაიხადეთ მომწოდებლების რუტინული ანგარიშები, რომლებიც ემთხვევა შესყიდვის ორდერს. მხოლოდ არსებული მომწოდებლები. არასოდეს შეცვალოთ საბანკო რეკვიზიტები და არ დაამატოთ მიმღები."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង់វិក្កយបត្រអ្នកផ្គត់ផ្គង់ធម្មតាដែលត្រូវនឹងបញ្ជាទិញ។ តែអ្នកផ្គត់ផ្គង់ដែលមានស្រាប់ប៉ុណ្ណោះ។ កុំផ្លាស់ប្តូរព័ត៌មានធនាគារ ឬបន្ថែមអ្នកទទួលថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 주문서와 일치하는 정기 공급업체 청구서를 지급합니다. 기존 공급업체만 해당합니다. 은행 정보를 바꾸거나 수취인을 추가하지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຈ່າຍໃບແຈ້ງໜີ້ຜູ້ຂາຍປະຈຳທີ່ກົງກັບໃບສັ່ງຊື້. ສະເພາະຜູ້ຂາຍທີ່ມີຢູ່. ບໍ່ເຄີຍປ່ຽນລາຍລະອຽດທະນາຄານ ຫຼື ເພີ່ມຜູ້ຮັບເງິນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apmokėti įprastas tiekėjų sąskaitas, atitinkančias pirkimo užsakymą. Tik esamiems tiekėjams. Niekada nekeisti banko duomenų ir nepridėti gavėjo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apmaksāt kārtējos piegādātāju rēķinus, kas atbilst pirkuma pasūtījumam. Tikai esošiem piegādātājiem. Nekad nemainīt bankas rekvizītus un nepievienot saņēmēju."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плаќај рутински сметки на добавувачи што се совпаѓаат со нарачка за набавка. Само постојни добавувачи. Никогаш не менувај банкарски податоци и не додавај нов примач."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Худалдан авалтын захиалгатай таарсан тогтмол нийлүүлэгчийн нэхэмжлэхийг төл. Зөвхөн одоо байгаа нийлүүлэгчид. Банкны мэдээллийг хэзээ ч бүү өөрчил, шинэ хүлээн авагч бүү нэм."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "खरिद आदेशसँग मिल्ने नियमित आपूर्तिकर्ताका बिल तिर्नुहोस्। अहिलेकै आपूर्तिकर्ता मात्र। बैंक विवरण कहिल्यै नबदल्नुहोस् र नयाँ प्राप्तकर्ता नथप्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaal gewone leveranciersrekeningen die bij een inkooporder passen. Alleen bestaande leveranciers. Wijzig nooit bankgegevens en voeg nooit een begunstigde toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opłacaj rutynowe faktury dostawców zgodne z zamówieniem. Tylko istniejący dostawcy. Nigdy nie zmieniaj danych bankowych ani nie dodawaj odbiorcy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar faturas habituais de fornecedores que correspondam a uma nota de encomenda. Só fornecedores existentes. Nunca alterar dados bancários nem adicionar um beneficiário."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar contas habituais de fornecedores que correspondam a um pedido de compra. Só fornecedores existentes. Nunca alterar dados bancários nem adicionar um beneficiário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plătiți facturile obișnuite ale furnizorilor care corespund unei comenzi de achiziție. Doar furnizori existenți. Nu schimbați niciodată datele bancare și nu adăugați beneficiari."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platiť bežné faktúry dodávateľov, ktoré zodpovedajú objednávke. Len existujúci dodávatelia. Nikdy nemeniť bankové údaje ani nepridávať príjemcov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plačuj običajne račune dobaviteljev, ki ustrezajo naročilnici. Samo obstoječi dobavitelji. Nikoli ne spreminjaj bančnih podatkov in ne dodajaj prejemnikov."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Paguani faturat rutinë të furnizuesve që përputhen me një porosi blerjeje. Vetëm furnizues ekzistues. Mos ndryshoni kurrë të dhënat bankare dhe mos shtoni përfitues."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaćajte redovne naloge dobavljača koji odgovaraju porudžbenice. Samo postojeći dobavljači. Nikad ne menjajte bankovne podatke i ne dodajte primatelja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชำระใบแจ้งหนี้ผู้ขายประจำที่ตรงกับใบสั่งซื้อ เฉพาะผู้ขายที่มีอยู่ ห้ามเปลี่ยนรายละเอียดธนาคารหรือเพิ่มผู้รับเงิน"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Satyn alma sargydyna gabat gelýän yzygiderli üpjün ediji hasaplaryny töläň. Diňe bar bolan üpjün edijiler. Hiç haçan bank maglumatlaryny üýtgetmäň ýa-da alyjy goşmaň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir satın alma siparişiyle eşleşen rutin tedarikçi faturalarını öde. Yalnızca mevcut tedarikçiler. Asla banka bilgilerini değiştirme veya alıcı ekleme."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خرید کے آرڈر سے ملنے والے معمول کے وینڈر بل ادا کریں۔ صرف موجودہ وینڈرز۔ کبھی بینک کی تفصیلات نہ بدلیں اور نیا وصول کنندہ شامل نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh toán các hóa đơn nhà cung cấp thường lệ khớp với một đơn mua hàng. Chỉ nhà cung cấp hiện có. Không bao giờ đổi thông tin ngân hàng hay thêm người nhận."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支付與採購單相符的例行供應商帳單。僅限現有供應商。絕不變更銀行資料，也不新增收款人。"
          }
        }
      }
    },
