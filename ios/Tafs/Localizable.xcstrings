    "taf.not_live_version_card_taf": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس في Card النسخة الفعّالة: لا يستخدمه الـ taf الآن. وقد يحتاجه الرجوع إلى نسخة أقدم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İşləyən versiyanın Card-ında yoxdur: taf onu indi istifadə etmir. Köhnə versiyaya qayıtmaq üçün ona ehtiyac ola bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не е в Card на активната версия: taf не го използва сега. Връщането към по-стара версия може да изисква това."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালু সংস্করণের Card-এ নেই: taf এখন এটি ব্যবহার করে না। পুরোনো সংস্করণে ফিরলে এটি লাগতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No és al Card de la versió activa: el taf no ho fa servir ara. Tornar a una versió més antiga potser ho necessita."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není na Card aktivní verze: taf to teď nepoužívá. Návrat ke starší verzi to může potřebovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht auf der Card der Live-Version: Der taf nutzt es gerade nicht. Eine Rückkehr zu einer älteren Version könnte es brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not on the live version's Card: the taf doesn't use it now. Going back to an older version may need it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está en la Card de la versión activa: el taf no lo usa ahora. Volver a una versión anterior podría necesitarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pole kasutusel oleva versiooni Cardil: taf ei kasuta seda praegu. Vanemale versioonile naasmisel võib seda vaja minna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absent de la Card de la version en service : le taf ne l'utilise pas actuellement. Une version antérieure peut en avoir besoin si vous y revenez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ב-Card של הגרסה הפעילה: ה-taf לא משתמש בו כעת. חזרה לגרסה ישנה יותר עשויה להזדקק לו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू संस्करण के Card पर नहीं: taf इसे अभी उपयोग नहीं करता। पुराने संस्करण पर लौटने में इसकी ज़रूरत पड़ सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije na Cardu verzije u radu: taf ga sada ne koristi. Povratak na stariju verziju možda će ga trebati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs rajta az élő verzió Cardján: a taf most nem használja. Egy régebbi verzióra való visszatéréshez szükség lehet rá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ակտիվ տարբերակի Card-ում չէ․ taf-ը հիմա այն չի օգտագործում։ Ավելի հին տարբերակին վերադառնալը կարող է այն պահանջել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada di Card versi yang aktif: taf tidak memakainya sekarang. Kembali ke versi lebih lama mungkin memerlukannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è nella Card della versione attiva: ora il taf non lo usa. Tornare a una versione precedente potrebbe richiederlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用中のバージョンのCardにありません：tafは現在これを使っていません。古いバージョンに戻すときに必要になる場合があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქტიური ვერსიის Card-ზე არ არის: taf ახლა მას არ იყენებს. ძველ ვერსიაზე დაბრუნებას ის შეიძლება დასჭირდეს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនមានក្នុង Card របស់កំណែដែលកំពុងដំណើរការ៖ taf មិនប្រើវាឥឡូវនេះទេ។ ការត្រឡប់ទៅកំណែចាស់ជាងអាចត្រូវការវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용된 버전의 Card에 없습니다. taf가 지금은 사용하지 않습니다. 이전 버전으로 돌아가면 필요할 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ຢູ່ໃນ Card ຂອງເວີຊັນທີ່ໃຊ້ງານ: ດຽວນີ້ taf ບໍ່ໃຊ້ມັນ. ການກັບໄປເວີຊັນເກົ່າອາດຕ້ອງການມັນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neįtraukta į aktyvios versijos Card: taf to dabar nenaudoja. Grįžus prie senesnės versijos to gali prireikti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav darbā esošās versijas Card: taf to tagad neizmanto. Atgriežoties pie vecākas versijas, tas var būt vajadzīgs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не е на Card на активната верзија: tafот сега не го користи. Враќањето на постара верзија може да го бара."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Идэвхтэй хувилбарын Card дээр алга: taf одоо үүнийг ашигладаггүй. Хуучин хувилбар руу буцахад үүнийг шаардаж магадгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय संस्करणको Card मा छैन: taf ले अहिले यो प्रयोग गर्दैन। पुरानो संस्करणमा फर्कँदा यो चाहिन सक्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet op de Card van de live versie: het taf gebruikt het nu niet. Teruggaan naar een oudere versie kan het nodig hebben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma tego na Card wersji działającej na żywo: taf teraz tego nie używa. Powrót do starszej wersji może tego wymagać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está no Card da versão em produção: o taf não o usa agora. Voltar a uma versão anterior pode precisar dele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está no Card da versão em produção: o taf não o usa agora. Voltar a uma versão anterior pode precisar dele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu este pe Cardul versiunii active: taful nu îl folosește acum. Revenirea la o versiune mai veche poate avea nevoie de el."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie je na Card aktívnej verzie: taf to teraz nepoužíva. Návrat k staršej verzii to môže potrebovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni na Card aktivne različice: taf tega zdaj ne uporablja. Vrnitev na starejšo različico ga bo morda potrebovala."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo në Card-in e versionit aktiv: taf-i nuk e përdor tani. Kthimi te një version më i vjetër mund ta kërkojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije na Cardu verzije u radu: taf ga sada ne koristi. Povratak na stariju verziju možda će ga trebati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่อยู่ใน Card ของเวอร์ชันที่ใช้งานอยู่: ตอนนี้ taf ไม่ได้ใช้ การย้อนกลับไปเวอร์ชันเก่าอาจต้องใช้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Işjeň wersiýanyň Card-ynda ýok: taf ony häzir ulanmaýar. Has köne wersiýa gaýdyp barmak oňa mätäç bolup biler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayındaki sürümün Card'ında yok: taf onu şu an kullanmıyor. Daha eski bir sürüme dönmek onu gerektirebilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائیو ورژن کے Card پر نہیں: taf اسے اب استعمال نہیں کرتا۔ پرانے ورژن پر واپس جانے کے لیے اس کی ضرورت پڑ سکتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có trong Card của phiên bản đang chạy: taf hiện không dùng nó. Quay lại một phiên bản cũ hơn có thể cần đến nó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不在目前生效版本的 Card 上：taf 目前並未使用它。回到較舊的版本時可能會需要它。"
          }
        }
      }
    },
