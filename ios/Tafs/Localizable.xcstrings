    "approval.state.temporarily_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Barmaq izi sensoru hazırda istifadə oluna bilmir. Bir az gözləyin və ya telefonun kilidini bir dəfə açın, sonra yenidən yoxlayın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сензорът за пръстови отпечатъци не може да се използва в момента. Изчакайте малко или отключете телефона веднъж и проверете отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtečku otisků teď nelze použít. Chvíli počkejte nebo telefon jednou odemkněte a zkontrolujte to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fingerabdrucksensor kann gerade nicht verwendet werden. Warte einen Moment oder entsperre das Telefon einmal und prüfe dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fingerprint sensor can't be used just now. Wait a moment, or unlock the phone once, then check again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se puede usar el sensor de huellas. Espera un momento, o desbloquea el teléfono una vez, y vuelve a comprobarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõrmejäljeandurit ei saa praegu kasutada. Oota hetk või ava telefon korra ja kontrolli siis uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le capteur d'empreintes ne peut pas être utilisé pour le moment. Patientez un instant, ou déverrouillez le téléphone une fois, puis vérifiez à nouveau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senzor otiska prsta trenutačno nije moguće upotrijebiti. Pričekajte trenutak ili jednom otključajte telefon, pa provjerite ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ujjlenyomat-érzékelő most nem használható. Várj egy pillanatot, vagy oldd fel egyszer a telefont, majd ellenőrizd újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մատնահետքի սենսորը հիմա հնարավոր չէ օգտագործել։ Սպասեք մի պահ կամ մեկ անգամ ապակողպեք հեռախոսը, ապա նորից ստուգեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor sidik jari tidak dapat digunakan saat ini. Tunggu sebentar, atau buka kunci ponsel sekali, lalu periksa lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sensore di impronte non può essere usato ora. Attendi un attimo, o sblocca il telefono una volta, poi controlla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指紋センサーは現在使用できません。少し待つか、一度スマートフォンのロックを解除してから、もう一度確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითის ანაბეჭდის სენსორი ახლა ვერ გამოიყენება. მოიცადეთ ცოტა ან ერთხელ განბლოკეთ ტელეფონი, შემდეგ შეამოწმეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 지문 센서를 사용할 수 없습니다. 잠시 기다리거나 휴대폰 잠금을 한 번 해제한 뒤 다시 확인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Piršto atspaudo jutiklio šiuo metu naudoti negalima. Palaukite arba vieną kartą atrakinkite telefoną, tada patikrinkite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirkstu nospiedumu sensoru pašlaik nevar izmantot. Uzgaidi brīdi vai vienreiz atbloķē tālruni, tad pārbaudi vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vingerafdruksensor kan nu niet worden gebruikt. Wacht even of ontgrendel de telefoon één keer, en controleer het dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytnika linii papilarnych nie można teraz użyć. Poczekaj chwilę albo raz odblokuj telefon, a potem sprawdź ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível usar o sensor de impressões digitais neste momento. Aguarde um pouco, ou desbloqueie o telefone uma vez, e verifique novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível usar o sensor de impressões digitais neste momento. Aguarde um pouco, ou desbloqueie o telefone uma vez, e verifique novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Senzorul de amprentă nu poate fi folosit acum. Așteptați puțin sau deblocați telefonul o dată, apoi verificați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímač odtlačkov teraz nemožno použiť. Chvíľu počkajte alebo telefón raz odomknite a skontrolujte to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bralnika prstnih odtisov trenutno ni mogoče uporabiti. Počakajte trenutek ali telefon enkrat odklenite in preverite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensori i gjurmës së gishtit nuk mund të përdoret tani. Prisni pak, ose zhbllokojeni telefonin një herë, pastaj kontrolloni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Senzor otiska prsta trenutno nije moguće koristiti. Sačekajte trenutak ili jednom otključajte telefon, pa proverite ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ใช้เซนเซอร์ลายนิ้วมือไม่ได้ รอสักครู่ หรือปลดล็อกโทรศัพท์หนึ่งครั้ง แล้วตรวจสอบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak izi sensörü şu anda kullanılamıyor. Biraz bekleyin veya telefonun kilidini bir kez açın, sonra tekrar kontrol edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không dùng được cảm biến vân tay. Hãy đợi một lát, hoặc mở khóa điện thoại một lần, rồi kiểm tra lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法使用指紋感應器。請稍候，或解鎖手機一次，然後再次檢查。"
          }
        }
      }
    },
