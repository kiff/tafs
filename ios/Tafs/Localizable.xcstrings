            "value": "el reenvío queda retenido; no se envía nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "uuesti saatmine jääb kinni peetuks; midagi ei saadeta."
          }
        },
        "fr": {
