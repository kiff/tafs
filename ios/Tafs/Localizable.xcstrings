    "approval.not_recognized": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenidən cəhd edin və ya barmaq izləri dəyişibsə yenidən daxil olun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Опитайте отново или влезте отново, ако пръстовите ви отпечатъци са се променили."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste to znovu, nebo se znovu přihlaste, pokud se vaše otisky prstů změnily."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuch es erneut oder melde dich erneut an, falls sich deine Fingerabdrücke geändert haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again, or sign in again if your fingerprints changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a intentarlo, o vuelve a iniciar sesión si tus huellas cambiaron."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi uuesti või logi uuesti sisse, kui sinu sõrmejäljed muutusid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez, ou reconnectez-vous si vos empreintes ont changé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušajte ponovno ili se ponovno prijavite ako su se otisci prstiju promijenili."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbáld újra, vagy jelentkezz be újra, ha az ujjlenyomataid megváltoztak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փորձեք նորից կամ նորից մուտք գործեք, եթե մատնահետքերը փոխվել են։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba lagi, atau masuk lagi jika sidik jari Anda berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova, o accedi di nuovo se le tue impronte sono cambiate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度試すか、指紋が変更された場合はもう一度サインインしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სცადეთ ხელახლა ან კვლავ შედით, თუ თითის ანაბეჭდები შეიცვალა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도하거나, 지문이 바뀌었다면 다시 로그인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandykite dar kartą arba vėl prisijunkite, jei pasikeitė jūsų piršto atspaudai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mēģini vēlreiz vai vēlreiz pieraksties, ja tavi pirkstu nospiedumi mainījās."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer het opnieuw, of log opnieuw in als je vingerafdrukken zijn gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie albo zaloguj się ponownie, jeśli Twoje odciski palców się zmieniły."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente, ou inicie sessão novamente se as suas impressões digitais mudaram."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente, ou entre novamente se as suas impressões digitais mudaram."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încercați din nou sau conectați-vă din nou dacă amprentele s-au schimbat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúste to znova, alebo sa znova prihláste, ak sa vaše odtlačky prstov zmenili."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskusite znova ali se znova prijavite, če so se vaši prstni odtisi spremenili."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Provoni sërish, ose hyni sërish nëse gjurmët e gishtave ndryshuan."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušajte ponovo ili se ponovo prijavite ako su se otisci prstiju promenili."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองอีกครั้ง หรือเข้าสู่ระบบอีกครั้งหากลายนิ้วมือของคุณเปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar deneyin veya parmak izleriniz değiştiyse tekrar oturum açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thử lại, hoặc đăng nhập lại nếu vân tay của bạn đã đổi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請再試一次；若您的指紋已變更，請重新登入。"
          }
        }
      }
    },
