            "state": "translated",
            "value": "Jelentkezz be újra, hogy regisztráld ennek a telefonnak a jóváhagyási kulcsát."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նորից մուտք գործեք՝ այս հեռախոսի հաստատման բանալին գրանցելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk lagi untuk mendaftarkan kunci persetujuan ponsel ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi di nuovo per registrare la chiave di approvazione di questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンの承認キーを登録するには、もう一度サインインしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კვლავ შედით, რომ ამ ტელეფონის დამტკიცების გასაღები დარეგისტრირდეს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចូលម្តងទៀតដើម្បីចុះឈ្មោះកូនសោអនុម័តរបស់ទូរសព្ទនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰의 승인 키를 등록하려면 다시 로그인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຂົ້າສູ່ລະບົບອີກເພື່ອລົງທະບຽນກຸນແຈອະນຸມັດຂອງໂທລະສັບນີ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijunkite dar kartą, kad užregistruotumėte šio telefono patvirtinimo raktą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieraksties vēlreiz, lai reģistrētu šī tālruņa apstiprināšanas atslēgu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Најави се повторно за да го регистрираш клучот за одобрување на овој телефон."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ утасны зөвшөөрлийн түлхүүрийг бүртгүүлэхийн тулд дахин нэвтэрнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो फोनको स्वीकृति कुञ्जी दर्ता गर्न फेरि साइन इन गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw inloggen om de goedkeuringssleutel van deze telefoon te registreren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się ponownie, aby zarejestrować klucz zatwierdzania tego telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão novamente para registar a chave de aprovação deste telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre novamente para registrar a chave de aprovação deste telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectați-vă din nou pentru a înregistra cheia de aprobare a acestui telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihláste sa znova, aby sa zaregistroval schvaľovací kľúč tohto telefónu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova se prijavite, da registrirate ključ za odobritev tega telefona."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyni sërish për të regjistruar çelësin e miratimit të këtij telefoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se ponovo da registrirate ključ za odobravanje ovog telefona."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบอีกครั้งเพื่อลงทะเบียนกุญแจอนุมัติของโทรศัพท์เครื่องนี้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonyň tassyklama açaryny hasaba almak üçin täzeden giriň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonun onay anahtarını kaydetmek için tekrar oturum açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فون کی منظوری کی کلید رجسٹر کرنے کے لیے دوبارہ سائن اِن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng nhập lại để đăng ký khóa phê duyệt của điện thoại này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新登入以註冊這部手機的核准金鑰。"
          }
        }
      }
    },
    "settings.sign_in_code.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التشغيل، يمكنك تسجيل الدخول برمز يُرسل إلى بريدك الإلكتروني بدل Apple أو Google أو GitHub. هو متوقف ما لم تشغّله، ويتطلب تشغيله تسجيل دخول حديثًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv olduqda, Apple, Google və ya GitHub əvəzinə e-poçtunuza göndərilən kodla daxil ola bilərsiniz. Siz aktiv etməyincə söndürülüb, aktiv etmək üçün isə yaxınlarda daxil olmuş olmalısınız."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато е включено, можете да влизате с код, изпратен на имейла ви, вместо с Apple, Google или GitHub. Изключено е, докато не го включите, а за включването е нужен скорошен вход."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালু থাকলে Apple, Google বা GitHub-এর বদলে আপনার ইমেইলে পাঠানো কোড দিয়ে সাইন ইন করতে পারবেন। আপনি চালু না করা পর্যন্ত এটি বন্ধ থাকে, আর চালু করতে সাম্প্রতিক সাইন-ইন লাগে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan està activat, pots iniciar la sessió amb un codi enviat al teu correu en lloc d'Apple, Google o GitHub. Està desactivat fins que l'activis, i activar-lo requereix un inici de sessió recent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je zapnuté, můžete se přihlásit kódem zaslaným na váš e-mail místo přes Apple, Google nebo GitHub. Dokud ho nezapnete, je vypnuté, a k zapnutí je potřeba nedávné přihlášení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sie an ist, kannst du dich mit einem Code anmelden, der an deine E-Mail geschickt wird, statt mit Apple, Google oder GitHub. Sie ist aus, solange du sie nicht einschaltest, und zum Einschalten brauchst du eine aktuelle Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it's on, you can sign in with a code sent to your email instead of Apple, Google or GitHub. It's off unless you turn it on, and turning it on needs a recent sign-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está activado, puedes iniciar sesión con un código enviado a tu correo en lugar de Apple, Google o GitHub. Está desactivado salvo que lo actives, y activarlo requiere un inicio de sesión reciente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui see on sees, saad sisse logida e-postile saadetud koodiga Apple'i, Google'i või GitHubi asemel. See on väljas, kuni sa selle sisse lülitad, ja sisselülitamiseks on vaja hiljutist sisselogimist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand il est activé, vous pouvez vous connecter avec un code envoyé par e-mail, au lieu d'Apple, de Google ou de GitHub. Il est désactivé tant que vous ne l'activez pas, et l'activer demande une connexion récente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשההגדרה פעילה, אפשר להיכנס עם קוד שנשלח לאימייל שלך במקום Apple, Google או GitHub. היא כבויה אלא אם תפעיל אותה, והפעלתה דורשת כניסה עדכנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर, आप Apple, Google या GitHub के बजाय अपने ईमेल पर भेजे कोड से साइन इन कर सकते हैं। यह आपके चालू करने तक बंद रहता है, और चालू करने के लिए हाल का साइन-इन चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je uključeno, možete se prijaviti kodom poslanim na vašu e-poštu umjesto s Apple, Google ili GitHub. Isključeno je dok ga ne uključite, a za uključivanje je potrebna nedavna prijava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolva a Apple, Google vagy GitHub helyett az e-mailedre küldött kóddal is bejelentkezhetsz. Alapból ki van kapcsolva, és a bekapcsolásához friss bejelentkezés kell."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երբ միացված է, կարող եք մուտք գործել ձեր էլ. փոստին ուղարկված կոդով՝ Apple-ի, Google-ի կամ GitHub-ի փոխարեն։ Այն անջատված է, քանի դեռ չեք միացրել, իսկ միացնելու համար պետք է վերջերս կատարված մուտք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat aktif, Anda bisa masuk dengan kode yang dikirim ke email Anda, bukan lewat Apple, Google, atau GitHub. Pengaturan ini nonaktif kecuali Anda mengaktifkannya, dan untuk mengaktifkannya diperlukan proses masuk yang baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è attivo, puoi accedere con un codice inviato alla tua email invece che con Apple, Google o GitHub. È disattivo finché non lo attivi, e per attivarlo serve un accesso recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、Apple、Google、GitHubの代わりに、メールで届くコードでサインインできます。オンにしない限りオフで、オンにするには最近のサインインが必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "როცა ჩართულია, შეგიძლიათ შეხვიდეთ თქვენს ელფოსტაზე გამოგზავნილი კოდით Apple-ის, Google-ის ან GitHub-ის ნაცვლად. ის გამორთულია, სანამ არ ჩართავთ, ხოლო ჩასართავად საჭიროა ახალი შესვლა."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅពេលបើក អ្នកអាចចូលដោយប្រើកូដដែលផ្ញើទៅអ៊ីមែលរបស់អ្នក ជំនួសឱ្យ Apple, Google ឬ GitHub។ វាបិទ លុះត្រាតែអ្នកបើក ហើយការបើកត្រូវការការចូលថ្មីៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 Apple, Google, GitHub 대신 이메일로 받은 코드로 로그인할 수 있습니다. 직접 켜지 않으면 꺼져 있으며, 켜려면 최근 로그인이 필요합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເມື່ອເປີດ ທ່ານສາມາດເຂົ້າສູ່ລະບົບດ້ວຍລະຫັດທີ່ສົ່ງໄປອີເມວຂອງທ່ານ ແທນ Apple, Google ຫຼື GitHub. ມັນປິດຢູ່ຈົນກວ່າທ່ານຈະເປີດ ແລະ ການເປີດຕ້ອງມີການເຂົ້າສູ່ລະບົບເມື່ອບໍ່ດົນມານີ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai įjungta, galite prisijungti kodu, išsiųstu į jūsų el. paštą, vietoje Apple, Google ar GitHub. Jei neįjungsite, ji išjungta, o norint įjungti reikia neseno prisijungimo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad tas ir ieslēgts, vari pierakstīties ar kodu, kas nosūtīts uz tavu e-pastu, nevis ar Apple, Google vai GitHub. Tas ir izslēgts, kamēr tu to neieslēdz, un ieslēgšanai vajag nesen veiktu pierakstīšanos."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кога е вклучено, можеш да се најавиш со код испратен на твојата е-пошта наместо со Apple, Google или GitHub. Исклучено е сè додека не го вклучиш, а за вклучување е потребна неодамнешна најава."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Асаалттай үед та Apple, Google эсвэл GitHub-ын оронд имэйлээр ирсэн кодоор нэвтэрч болно. Та асаахгүй бол унтарсан байна, асаахад саяхны нэвтрэлт шаардлагатай."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो खुला हुँदा, तपाईं Apple, Google वा GitHub को सट्टा इमेलमा पठाइएको कोडबाट साइन इन गर्न सक्नुहुन्छ। तपाईंले खोल्नुभएन भने यो बन्द रहन्छ, र खोल्न हालको साइन इन चाहिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het aan staat, kun je inloggen met een code die naar je e-mail wordt gestuurd, in plaats van met Apple, Google of GitHub. Het staat uit tenzij je het aanzet, en aanzetten vraagt een recente login."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy jest włączone, możesz zalogować się kodem wysłanym na Twój e-mail zamiast przez Apple, Google lub GitHub. Jest wyłączone, dopóki go nie włączysz, a włączenie wymaga niedawnego logowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando está ativado, pode iniciar sessão com um código enviado para o seu email, em vez de Apple, Google ou GitHub. Está desativado a menos que o ative, e ativá-lo exige um início de sessão recente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando está ativado, você pode entrar com um código enviado para o seu e-mail, em vez de Apple, Google ou GitHub. Ele fica desativado a menos que você o ative, e ativar exige um login recente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când este activată, vă puteți conecta cu un cod trimis pe e-mail, în loc de Apple, Google sau GitHub. Este dezactivată dacă nu o activați, iar activarea cere o conectare recentă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď je zapnuté, môžete sa prihlásiť kódom zaslaným na váš e-mail namiesto cez Apple, Google alebo GitHub. Kým ho nezapnete, je vypnuté, a na zapnutie treba nedávne prihlásenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je vklopljeno, se lahko prijavite s kodo, poslano na vaš e-naslov, namesto z Apple, Google ali GitHub. Dokler ga ne vklopite, je izklopljeno, za vklop pa je potrebna nedavna prijava."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur është aktiv, mund të hyni me një kod të dërguar në email-in tuaj, në vend të Apple, Google ose GitHub. Është joaktiv derisa ta aktivizoni, dhe aktivizimi kërkon një hyrje të fundit."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je uključeno, možete se prijaviti kodom poslanim na vašu e-poštu umesto preko Apple, Google ili GitHub. Isključeno je dok ga ne uključite, a za uključivanje je potrebna nedavna prijava."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดอยู่ คุณเข้าสู่ระบบด้วยรหัสที่ส่งไปยังอีเมลของคุณแทน Apple, Google หรือ GitHub ได้ ตั้งค่านี้ปิดอยู่จนกว่าคุณจะเปิด และการเปิดต้องมีการเข้าสู่ระบบครั้งล่าสุด"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Açyk bolanda, Apple, Google ýa-da GitHub ýerine email salgyňyza iberilen kod bilen girip bilersiňiz. Siz açmasaňyz ol öçük, we açmak üçin ýaňy giriş gerek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken Apple, Google veya GitHub yerine e-postanıza gönderilen kodla oturum açabilirsiniz. Siz açmadıkça kapalıdır ve açmak için yakın zamanda oturum açmış olmanız gerekir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چالو ہونے پر آپ Apple، Google یا GitHub کے بجائے ای میل پر بھیجے گئے کوڈ سے سائن اِن کر سکتے ہیں۔ یہ بند رہتا ہے جب تک آپ چالو نہ کریں، اور چالو کرنے کے لیے حالیہ سائن اِن چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, bạn có thể đăng nhập bằng mã gửi đến email của mình thay vì Apple, Google hoặc GitHub. Mặc định là tắt trừ khi bạn bật, và để bật cần một lần đăng nhập gần đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，您可以用寄到電子郵件的代碼登入，而不必用 Apple、Google 或 GitHub。除非您開啟，否則預設關閉，而開啟需要最近一次登入。"
          }
        }
      }
    },
