          "stringUnit": {
            "state": "translated",
            "value": "%2$@用に%1$@にサインインしました。次に、Coachが操作を選び、あなたが承認します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ შესულია %2$@-ისთვის. შემდეგ Coach ირჩევს მის მოქმედებებს და თქვენ ამტკიცებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានចូល %1$@ សម្រាប់ %2$@។ បន្ទាប់ Coach ជ្រើសរើសសកម្មភាព ហើយអ្នកអនុម័តពួកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@을(를) 위해 %1$@에 로그인했습니다. 다음으로 Coach가 행동을 고르고 내가 승인합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຂົ້າສູ່ລະບົບ %1$@ ສຳລັບ %2$@ ແລ້ວ. ຕໍ່ໄປ Coach ເລືອກການກະທຳຂອງມັນ ແລ້ວທ່ານອະນຸມັດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ prisijungta taf %2$@. Toliau Coach pasirenka jos veiksmus, o jūs juos patvirtinate."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierakstīšanās %1$@ šim taf (%2$@) ir veikta. Tālāk Coach izvēlas tās darbības, un tu tās apstiprini."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ е најавен за %2$@. Следно, Coach ги избира дејствата, а ти ги одобруваш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-д зориулж %1$@ дээр нэвтэрсэн. Дараа нь Coach үйлдлүүдийг сонгож, та зөвшөөрнө."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ का लागि %1$@ मा साइन इन गरियो। अब Coach ले कार्यहरू छान्छ र तपाईं तिनलाई स्वीकृत गर्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is ingelogd voor %2$@. Daarna kiest Coach de acties en keur jij ze goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest zalogowana dla %2$@. Teraz Coach wybierze jej akcje, a Ty je zatwierdzisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tem sessão iniciada para %2$@. A seguir, o Coach escolhe as suas ações e você aprova-as."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Login feito em %1$@ para %2$@. A seguir, o Coach escolhe as ações dele e você as aprova."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ este conectat pentru %2$@. Apoi Coach îi alege acțiunile, iar dvs. le aprobați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je prihlásená pre %2$@. Teraz Coach vyberie jej akcie a vy ich schválite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je prijavljena za %2$@. Nato Coach izbere njena dejanja, vi pa jih odobrite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ka hyrë për %2$@. Më pas, Coach zgjedh veprimet e tij dhe ju i miratoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavljeni ste u aplikaciju %1$@ za taf %2$@. Zatim Coach bira njene radnje, a vi ih odobravate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบ %1$@ ให้ %2$@ แล้ว ถัดไป Coach เลือกการกระทำของมันและคุณอนุมัติ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-a %2$@ üçin girildi. Soňra Coach onuň hereketlerini saýlaýar, siz bolsa olary tassyklaýarsyňyz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hesabında %2$@ taf'ı için oturum açıldı. Sonra Coach eylemlerini seçer ve siz onaylarsınız."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ میں %2$@ کے لیے سائن اِن ہو گیا۔ اس کے بعد Coach اس کے اعمال چنتا ہے اور آپ انہیں منظور کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã đăng nhập cho %2$@. Tiếp theo, Coach chọn các hành động của nó và bạn phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已為 %2$@ 登入。接下來由 Coach 選擇它的動作，並由您核准。"
          }
        }
      }
    },
