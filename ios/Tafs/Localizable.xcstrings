    "coach.nothing_reaches_until_you_resume": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz davam etdirənə qədər ona heç nə çatmır. Sonra bunu yenidən göndərin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо не стига до него, докато не го възобновите. Тогава изпратете това отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se k němu nedostane, dokud ho neobnovíte. Pak to pošlete znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts erreicht ihn, bis du ihn fortsetzt. Sende das dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing reaches it until you resume it. Then send this again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No le llega nada hasta que lo reanudes. Luego vuelve a enviar esto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinna ei jõua midagi enne, kui selle jätkad. Siis saada see uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne lui parvient tant que vous ne le reprenez pas. Renvoyez ensuite ceci."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa ne stiže do njega dok ga ne nastavite. Tada ovo pošaljite ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem éri el, amíg nem folytatod. Aztán küldd el ezt újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրան ոչինչ չի հասնում, մինչև չվերսկսեք։ Ապա ուղարկեք սա նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang sampai kepadanya sampai Anda melanjutkannya. Lalu kirim ini lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non gli arriva nulla finché non lo riprendi. Poi invialo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開するまで何も届きません。再開後にもう一度送信してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მასთან არაფერი აღწევს, სანამ არ განაახლებთ. შემდეგ ეს გაგზავნეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재개할 때까지 아무것도 전달되지 않습니다. 재개한 뒤 다시 보내세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas jo nepasieks, kol jo netęsite. Tada išsiųskite tai dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas to nesasniedz, kamēr tu to neturpini. Tad nosūti šo vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bereikt het niets tot je het hervat. Verzend dit daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic do niego nie dotrze, dopóki go nie wznowisz. Potem wyślij to ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada lhe chega até o retomar. Depois, envie isto novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada lhe chega até o retomar. Depois, envie isto novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu ajunge la el până nu îl reluați. Apoi trimiteți din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič sa k nemu nedostane, kým ho neobnovíte. Potom to pošlite znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič ga ne doseže, dokler ga ne nadaljujete. Nato to pošljite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Asgjë nuk arrin te ai derisa ta riniseni. Pastaj dërgojeni këtë sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa ne stiže do njega dok ga ne nastavite. Tada ovo pošaljite ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะไม่มีอะไรไปถึงมันจนกว่าคุณจะให้มันทำต่อ จากนั้นส่งอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz sürdürene kadar ona hiçbir şey ulaşmaz. Sonra bunu tekrar gönderin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì đến được nó cho đến khi bạn tiếp tục nó. Sau đó hãy gửi lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您繼續它之前，不會有任何內容傳達給它。之後請再傳送一次。"
          }
        }
      }
    },
    "coach.nothing_to_approve": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ artıq qoşulub. Təsdiq ediləcək yeni heç nə yoxdur, ona görə heç nə təsdiqlənmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ вече е свързано. Няма нищо ново за одобрение, така че нищо не беше одобрено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je už připojený. Není nic nového ke schválení, takže se nic neschválilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist bereits verbunden. Es gibt nichts Neues zu genehmigen, daher wurde nichts genehmigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is already connected. There's nothing new to approve, so nothing was approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ya está conectado. No hay nada nuevo que aprobar, así que no se aprobó nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on juba ühendatud. Uut kinnitatavat pole, seega midagi ei kinnitatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est déjà connecté. Il n'y a rien de nouveau à approuver : rien n'a été approuvé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već je povezano: %1$@. Nema ničeg novog za odobriti pa ništa nije odobreno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ már csatlakoztatva van. Nincs semmi új jóváhagyandó, ezért semmi sem lett jóváhagyva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը արդեն միացված է։ Հաստատելու նոր բան չկա, ուստի ոչինչ չհաստատվեց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sudah terhubung. Tidak ada yang baru untuk disetujui, jadi tidak ada yang disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è già collegato. Non c'è nulla di nuovo da approvare, quindi non è stato approvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はすでに接続されています。新たに承認するものはないため、何も承認されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ უკვე დაკავშირებულია. დასამტკიცებელი ახალი არაფერია, ამიტომ არაფერი დამტკიცებულა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 이미 연결되어 있습니다. 새로 승인할 것이 없어 승인된 것은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jau prijungta. Nėra nieko naujo, ką patvirtinti, todėl niekas nepatvirtinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jau ir pievienots. Nav nekā jauna, ko apstiprināt, tāpēc nekas netika apstiprināts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is al gekoppeld. Er is niets nieuws om goed te keuren, dus er is niets goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest już połączony. Nie ma nic nowego do zatwierdzenia, więc nic nie zostało zatwierdzone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ já está ligado. Não há nada de novo para aprovar, por isso nada foi aprovado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ já está conectado. Não há nada de novo para aprovar, por isso nada foi aprovado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ este deja conectat. Nu e nimic nou de aprobat, așa că nu s-a aprobat nimic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je už pripojený. Nie je nič nové na schválenie, takže sa nič neschválilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je že povezan. Ni nič novega za odobritev, zato ni bilo nič odobreno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ është lidhur tashmë. Nuk ka asgjë të re për të miratuar, ndaj asgjë nuk u miratua."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Već je povezano: %1$@. Nema ničeg novog za odobriti pa ništa nije odobreno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ %1$@ แล้ว ไม่มีอะไรใหม่ให้อนุมัติ จึงไม่ได้อนุมัติอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zaten bağlı. Onaylanacak yeni bir şey yok, bu yüzden hiçbir şey onaylanmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã được kết nối. Không có gì mới để phê duyệt, nên chưa phê duyệt gì."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已連接。沒有新的項目需要核准，因此未核准任何項目。"
          }
        }
      }
    },
