    "door.pair_intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Nachrichten an diese %1$@-Tür geben Arbeit, innerhalb der Card. Alle anderen klopfen nur an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their messages to this %1$@ door give work, within the Card. Anyone else's only knock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus mensajes a esta puerta de %1$@ dan trabajo, dentro de la Card. Los de cualquier otra persona solo llegan como llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses messages à cette porte %1$@ donnent du travail, dans la Card. Ceux de toute autre personne ne sont que des demandes d'accès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi messaggi a questa porta %1$@ danno lavoro, entro la Card. Quelli di chiunque altro sono solo bussate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hun berichten aan deze %1$@-deur geven werk, binnen de Card. Berichten van anderen kloppen alleen aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich wiadomości do tych drzwi %1$@ zlecają pracę, w ramach Card. Wiadomości od innych to tylko pukanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens desta pessoa para esta porta de %1$@ dão trabalho, dentro do Card. As de qualquer outra pessoa ficam só como pedido de contacto."
          }
        }
      }
    },
