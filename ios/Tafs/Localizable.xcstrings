    "door.knock.too_many": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind viele Nachrichten in wenigen Minuten. Warte kurz und sende es dann erneut: Es wurde nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's a lot of messages in a few minutes. Wait a little, then send it again: nothing was sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son muchos mensajes en pocos minutos. Espera un poco y vuelve a enviarlo: no se envió nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paari minutiga on see palju sõnumeid. Oota veidi ja saada see siis uuesti: midagi ei saadetud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fait beaucoup de messages en quelques minutes. Patientez un peu, puis renvoyez-le : rien n'a été envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono tanti messaggi in pochi minuti. Aspetta un po', poi invialo di nuovo: non è stato inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数分間にメッセージが多すぎます。少し待ってからもう一度送ってください。何も送信されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 분 사이에 메시지가 너무 많습니다. 조금 기다린 뒤 다시 보내세요. 보낸 것은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per kelias minutes – daug žinučių. Šiek tiek palaukite ir išsiųskite dar kartą: niekas neišsiųsta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dažās minūtēs ir daudz ziņu. Mazliet uzgaidi, tad sūti vēlreiz: nekas netika nosūtīts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zijn veel berichten in een paar minuten. Wacht even en verzend het dan opnieuw: er is niets verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To dużo wiadomości w kilka minut. Poczekaj chwilę, a potem wyślij ponownie: nic nie zostało wysłane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São muitas mensagens em poucos minutos. Aguarde um pouco e envie novamente: nada foi enviado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São muitas mensagens em poucos minutos. Aguarde um pouco e envie novamente: nada foi enviado."
          }
        }
      }
    },
    "door.knock.wrote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat geschrieben. Es wurde nichts unternommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wrote. Nothing was done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ escribió. No se hizo nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kirjutas. Midagi ei tehtud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a écrit. Rien n'a été fait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha scritto. Non è stato fatto nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@から連絡がありました。何も実行されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 메시지를 보냈습니다. 아무것도 하지 않았습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parašė %1$@. Nieko nepadaryta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rakstīja. Nekas netika izdarīts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ schreef. Er is niets gedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ napisał(a). Nic nie zostało zrobione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ escreveu. Nada foi feito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ escreveu. Nada foi feito."
          }
        }
      }
    },
