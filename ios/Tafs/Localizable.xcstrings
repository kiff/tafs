    "taf.halt.cloud_not_resumed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hat %1$@ fortgesetzt, tafs cloud aber noch nicht. %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF resumed %1$@, but tafs cloud didn't yet. %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF reanudó %1$@, pero tafs cloud aún no. %2$@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF jätkas tafi %1$@, kuid tafs cloud veel mitte. %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF a repris %1$@, mais tafs cloud pas encore. %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ha ripreso %1$@, ma tafs cloud non ancora. %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFは%1$@を再開しましたが、tafsクラウドはまだ再開していません。%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF는 %1$@을(를) 재개했지만 tafs cloud는 아직 재개하지 않았습니다. %2$@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF leido %1$@ tęsti darbą, bet tafs cloud dar ne. %2$@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF turpināja %1$@, bet tafs cloud vēl ne. %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF heeft %1$@ hervat, maar tafs cloud nog niet. %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF wznowił %1$@, ale tafs cloud jeszcze nie. %2$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF retomou %1$@, mas o tafs cloud ainda não. %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF retomou %1$@, mas o tafs cloud ainda não. %2$@"
          }
        }
      }
    },
