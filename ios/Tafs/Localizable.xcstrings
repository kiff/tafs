    "approval.nothing_approved_request_kept_approve": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم الموافقة على شيء. الطلب محفوظ: وافق مرة أخرى عندما تكون مستعدًا."
