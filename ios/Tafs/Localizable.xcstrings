          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf pede algo fora do seu Card, aparece aqui e no seu ecrã bloqueado."
          }
        }
      }
    },
    "needs_you.expired": {
      "extractionState": "manual",
      "localizations": {
