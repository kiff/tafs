          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo taf non lavora finché non viene installata o non annulli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールするかキャンセルするまで、tafは動きません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი taf არ მუშაობს, სანამ არ დაყენდება ან არ გააუქმებთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치하거나 취소할 때까지 taf는 실행되지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų taf neveikia, kol versija neįdiegta arba kol neatšauksite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavs taf nedarbojas, līdz tā tiek instalēta vai tu atcel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je taf draait niet tot het is geïnstalleerd of je annuleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój taf nie działa, dopóki nie zostanie zainstalowana albo dopóki tego nie anulujesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
