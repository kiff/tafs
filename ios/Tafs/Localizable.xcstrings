          "stringUnit": {
            "state": "translated",
            "value": "Gündə 40 bileti cavablandırın. Geri ödəniş, endirim və ya dəyişdirmə vədi sizi gözləyir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговаряне на до 40 запитвания на ден. Всяко обещание за възстановяване, отстъпка или замяна ви чака."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídat až na 40 tiketů denně. Každý příslib vrácení peněz, slevy nebo výměny čeká na vás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 40 Tickets am Tag beantworten. Jedes Versprechen einer Erstattung, eines Rabatts oder eines Ersatzes wartet auf dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer up to 40 tickets a day. Any promise of a refund, a discount or a replacement waits for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder hasta 40 tickets al día. Cualquier promesa de reembolso, descuento o cambio te espera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasta kuni 40 pöördumisele päevas. Iga tagasimakse, allahindluse või asenduse lubadus ootab sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondre jusqu'à 40 tickets par jour. Toute promesse de remboursement, de remise ou de remplacement vous attend."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovarajte na do 40 zahtjeva dnevno. Svako obećanje povrata novca, popusta ili zamjene čeka vas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Naponta legfeljebb 40 jegy megválaszolása. Minden visszatérítési, kedvezmény- vagy csereígéret rád vár."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատասխանեք օրական մինչև 40 տոմսի։ Ցանկացած խոստում փոխհատուցման, զեղչի կամ փոխարինման մասին սպասում է ձեզ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawab hingga 40 tiket sehari. Setiap janji pengembalian dana, diskon, atau penggantian menunggu Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondere fino a 40 ticket al giorno. Ogni promessa di rimborso, sconto o sostituzione aspetta te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日最大40件のチケットに回答します。返金、値引き、交換の約束はすべてあなたの承認を待ちます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უპასუხეთ დღეში 40 ბილეთამდე. ნებისმიერი დაპირება თანხის დაბრუნების, ფასდაკლების ან ჩანაცვლების შესახებ თქვენ გელოდებათ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 최대 40개 티켓에 답합니다. 환불, 할인 또는 교환 약속은 모두 내 승인을 기다립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsakyti į iki 40 užklausų per dieną. Bet koks pažadas grąžinti pinigus, suteikti nuolaidą ar pakeisti prekę laukia jūsų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbildēt uz līdz 40 pieteikumiem dienā. Jebkurš atmaksas, atlaides vai aizstājēja apsolījums gaida tevi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot 40 tickets per dag beantwoorden. Elke belofte van een terugbetaling, korting of vervanging wacht op jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadać na maksymalnie 40 zgłoszeń dziennie. Każda obietnica zwrotu, rabatu lub wymiany czeka na Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder a até 40 pedidos por dia. Qualquer promessa de reembolso, desconto ou substituição aguarda por si."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder a até 40 pedidos por dia. Qualquer promessa de reembolso, desconto ou substituição aguarda por você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunde la cel mult 40 de tichete pe zi. Orice promisiune de rambursare, reducere sau înlocuire vă așteaptă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovedať až na 40 tiketov denne. Každý prísľub vrátenia peňazí, zľavy alebo výmeny čaká na vás."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovori na do 40 zahtevkov na dan. Vsaka obljuba vračila, popusta ali zamenjave čaka na vas."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigju deri në 40 bileta në ditë. Çdo premtim për kthim parash, zbritje ose zëvendësim pret ju."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovarajte na do 40 zahteva dnevno. Svako obećanje povrata novca, popusta ili zamene čeka vas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอบได้สูงสุด 40 ตั๋วต่อวัน คำมั่นเรื่องการคืนเงิน ส่วนลด หรือการเปลี่ยนสินค้าทุกอย่างรอคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde en fazla 40 talebi yanıtla. İade, indirim veya değişim sözü içeren her şey sizi bekler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời tối đa 40 phiếu mỗi ngày. Mọi lời hứa hoàn tiền, giảm giá hoặc thay thế đều chờ bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天最多回覆 40 張工單。任何退款、折扣或更換的承諾都要等您決定。"
          }
        }
      }
    },
