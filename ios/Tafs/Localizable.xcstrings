    "watch.tap_start": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «بدء» ثم تحدّث. تظهر كلماتك هنا أثناء حديثك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Başlayın» düyməsinə toxunun, sonra danışın. Sözləriniz danışdıqca burada görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете „Старт“ и говорете. Думите ви се появяват тук, докато говорите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "«শুরু করুন» চাপুন, তারপর বলুন। আপনি বলার সঙ্গে সঙ্গে আপনার কথা এখানে দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Comença i després parla. Les teves paraules es mostren aquí mentre parles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na Start a mluvte. Vaše slova se tu zobrazují, jak mluvíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Starten und sprich. Deine Worte erscheinen hier, während du sprichst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Start, then speak. Your words show here as you talk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Empezar y habla. Tus palabras aparecen aquí mientras hablas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta Alusta ja räägi. Sinu sõnad ilmuvad siia rääkimise ajal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Démarrer, puis parlez. Vos mots s'affichent ici pendant que vous parlez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש ללחוץ על «התחלה» ואז לדבר. המילים שלך מוצגות כאן תוך כדי דיבור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करें पर टैप करें, फिर बोलें। आपके शब्द बोलते समय यहाँ दिखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite Pokrenite, zatim govorite. Vaše se riječi prikazuju ovdje dok govorite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints az Indításra, majd beszélj. A szavaid beszéd közben itt jelennek meg."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հպեք «Սկսել», ապա խոսեք։ Ձեր բառերը երևում են այստեղ խոսելիս։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Mulai, lalu bicara. Kata-kata Anda muncul di sini saat Anda berbicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Avvia, poi parla. Le tue parole compaiono qui mentre parli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「開始」をタップしてから話してください。話している間、言葉がここに表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეეხეთ „დაწყებას“, შემდეგ ისაუბრეთ. თქვენი სიტყვები აქ ჩანს საუბრისას."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចុចចាប់ផ្តើម រួចនិយាយ។ ពាក្យរបស់អ្នកបង្ហាញនៅទីនេះនៅពេលអ្នកនិយាយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작을 탭한 후 말하세요. 말하는 동안 내 말이 여기에 표시됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແຕະ ເລີ່ມ ແລ້ວເວົ້າ. ຄຳເວົ້າຂອງທ່ານສະແດງຢູ່ທີ່ນີ້ໃນຂະນະທີ່ທ່ານເວົ້າ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palieskite „Pradėti“ ir kalbėkite. Jūsų žodžiai čia rodomi kalbant."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskaries “Sākt”, tad runā. Tavi vārdi parādās šeit, kamēr runā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допри Започни, па зборувај. Твоите зборови се прикажуваат тука додека зборуваш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Эхлэх-ийг товшоод ярина уу. Таны үгс ярих бүрт энд харагдана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरु गर्नुहोस् ट्याप गरेर बोल्नुहोस्। तपाईंले बोल्दा शब्दहरू यहाँ देखिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Starten en spreek. Je woorden verschijnen hier terwijl je praat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij Start i mów. Twoje słowa pojawiają się tu na bieżąco."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Começar e fale. As suas palavras aparecem aqui enquanto fala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Começar e fale. As suas palavras aparecem aqui enquanto fala."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți Pornire, apoi vorbiți. Cuvintele dvs. apar aici pe măsură ce vorbiți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na Štart a hovorte. Vaše slová sa tu zobrazujú, ako hovoríte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite Začni in govorite. Vaše besede se prikazujejo tukaj, medtem ko govorite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekni Fillo, pastaj flisni. Fjalët tuaja shfaqen këtu ndërsa flisni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite Pokrenite, zatim govorite. Vaše se reči prikazuju ovdje dok govorite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเริ่ม แล้วพูด ถ้อยคำของคุณจะแสดงที่นี่ขณะที่คุณพูด"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Başla basyň, soňra gürläň. Sözleriňiz gürleýşiňiz bilen şu ýerde görünýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlat'a dokunun, sonra konuşun. Sözleriniz konuştukça burada görünür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع پر ٹیپ کریں، پھر بولیں۔ بولتے وقت آپ کے الفاظ یہاں دکھائی دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm Bắt đầu, rồi nói. Lời của bạn hiện ở đây khi bạn nói."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點「開始」，然後說話。您說的話會在說話時顯示在這裡。"
          }
        }
      }
    },
