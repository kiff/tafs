    "door.unproven_section": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimin yazdığını sübut edə bilmir · yalnız döyür"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не може да докаже кой пише · само чука"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neověří, kdo píše · jen klepání"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann nicht nachweisen, wer schreibt · nur Klopfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't prove who's writing · knocks only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede demostrar quién escribe · solo llamadas"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei saa tõestada, kes kirjutab · ainult koputused"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne peut pas prouver qui écrit · demandes d'accès uniquement"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne može dokazati tko piše · samo kuca"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem tudja igazolni, ki ír · csak kopogás"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չի կարող ապացուցել, թե ով է գրում · միայն թակում է"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membuktikan siapa yang menulis · hanya mengetuk"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non può dimostrare chi scrive · solo bussate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信者を証明できない・ノックのみ"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერ ამტკიცებს, ვინ წერს · მხოლოდ აკაკუნებს"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낸 사람을 증명할 수 없음 · 노크만"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Negali įrodyti, kas rašo · tik beldžiasi"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevar pierādīt, kas raksta · tikai klauvē"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet bewijzen wie er schrijft · alleen kloppen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie może potwierdzić, kto pisze · tylko pukanie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegue provar quem escreve · só pedidos de contacto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegue provar quem escreve · só pedidos de contato"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu poate dovedi cine scrie · doar bate la ușă"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neoverí, kto píše · len klopanie"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne more dokazati, kdo piše · samo trkanje"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuk mund të provojë kush shkruan · vetëm trokit"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne može dokazati ko piše · samo kuca"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิสูจน์ไม่ได้ว่าใครเขียน · เคาะได้อย่างเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimin yazdığını kanıtlayamaz · yalnızca çalar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không chứng minh được ai đang viết · chỉ gõ cửa"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法證明是誰寫的 · 只能敲門"
          }
        }
      }
    },
