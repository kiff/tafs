    "version.guide.give_task": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ihr eine Aufgabe, die die Änderung nutzt, so wie du es beim Live-%1$@ tun würdest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a task that uses the change, as you would the live %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale una tarea que use el cambio, como harías con %1$@ en su versión activa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna sellele ülesanne, mis kasutab muudatust, nagu annaksid kasutusel olevale tafile %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez-lui une tâche qui utilise le changement, comme vous le feriez avec %1$@ en service."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagli un'attività che usi la modifica, come faresti con %1$@ attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用中の%1$@と同じように、変更を使うタスクを渡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용된 %1$@에게 하듯이, 변경 내용을 쓰는 작업을 맡겨 보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duokite jai užduotį, kurioje naudojamas pakeitimas, kaip duotumėte aktyviam %1$@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dod tam uzdevumu, kas izmanto izmaiņu, kā to darītu ar darbā esošo %1$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef het een taak die de wijziging gebruikt, zoals je de live %1$@ zou doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daj mu zadanie, które korzysta ze zmiany, tak jak działającemu na żywo %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê-lhe uma tarefa que use a alteração, como faria com %1$@ em produção."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a ele uma tarefa que use a alteração, como faria com %1$@ em produção."
          }
        }
      }
    },
    "version.guide.install_or_back": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Installieren“ macht sie zur Live-Version; „Zurückkehren“ beendet den Test."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install makes it the live version; Go back ends the trial."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar la convierte en la versión activa; Volver atrás termina la prueba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigalda teeb sellest kasutusel oleva versiooni; Mine tagasi lõpetab proovi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer en fait la version en service ; Revenir en arrière met fin à l'essai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa la rende la versione attiva; Torna indietro termina la prova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「インストール」で適用中のバージョンになり、「元に戻す」で試用が終わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치하면 적용된 버전이 되고, 되돌아가기를 누르면 시험이 끝납니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Įdiegti“ padaro ją aktyvia versija; „Grįžti“ baigia bandymą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Instalēt” padara to par darbā esošo versiju; “Atgriezties” beidz izmēģinājumu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeren maakt er de live versie van; Teruggaan beëindigt de proef."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj czyni ją wersją działającą na żywo; Wróć kończy próbę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar torna-a a versão em produção; Voltar atrás termina a experiência."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar torna-a a versão em produção; Voltar atrás termina a experiência."
          }
        }
      }
    },
    "version.guide.keeps_working": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ arbeitet weiter wie bisher. Was diese Version tut, ist echt, unter ihrer eigenen Card."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ keeps working as it is. What this version does is real, under its own Card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sigue funcionando como está. Lo que hace esta versión es real, con su propia Card."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ töötab edasi nagu praegu. See, mida see versioon teeb, on päris, oma Cardi all."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continue de fonctionner tel quel. Ce que fait cette version est réel, sous sa propre Card."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continua a lavorare com'è. Ciò che fa questa versione è reale, con la sua Card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はそのまま動き続けます。このバージョンの操作は、専用のCardのもとで実際に行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 지금처럼 계속 작동합니다. 이 버전이 하는 일은 자체 Card에 따른 실제 행동입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dirba toliau kaip anksčiau. Ką daro ši versija, yra tikra, pagal jos pačios Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ turpina strādāt tāpat kā līdz šim. Tas, ko dara šī versija, ir pa īstam, ar savu Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ blijft werken zoals het is. Wat deze versie doet, is echt, onder een eigen Card."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ działa dalej bez zmian. To, co robi ta wersja, dzieje się naprawdę, w ramach jej własnej Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continua a funcionar como está. O que esta versão faz é real, ao abrigo do seu próprio Card."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continua funcionando como está. O que esta versão faz é real, ao abrigo do seu próprio Card."
          }
        }
      }
    },
