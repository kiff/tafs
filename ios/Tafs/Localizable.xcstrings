          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveiki, norėčiau susigrąžinti 15 $ už užsakymą T-3001."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveiki, vēlos atpakaļ 15 $ par pasūtījumu T-3001."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoi, ik wil graag $15 terug voor bestelling T-3001."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień dobry, proszę o zwrot 15 $ za zamówienie T-3001."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá, gostaria de receber de volta 15 $ da encomenda T-3001."
