          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्डमा मिले पनि असामान्य कुनै कुरा गर्नुअघि सोध्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag het eerst bij alles wat ongewoon is, ook als het binnen de Card past."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytaj przed wszystkim, co nietypowe, nawet jeśli mieści się w Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar antes de qualquer coisa invulgar, mesmo quando cabe no Card."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar antes de qualquer coisa invulgar, mesmo quando cabe no Card."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
