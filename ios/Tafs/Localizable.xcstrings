          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-PIN הזה ארוך מדי למפתח אבטחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह PIN सुरक्षा कुंजी के लिए बहुत लंबा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taj je PIN predug za sigurnosni ključ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a PIN-kód túl hosszú egy biztonsági kulcshoz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այդ PIN-ը չափազանց երկար է անվտանգության բանալու համար։"
          }
