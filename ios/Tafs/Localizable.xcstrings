        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El bot encara escolta, així que la porta es manté. %1$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot pořád naslouchá, takže dveře zůstávají. %1$@"
