    "version.guide.give_task": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعطه مهمة تستخدم التغيير، كما كنت ستعطي %1$@ الفعّال."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona dəyişikliyi istifadə edən tapşırıq verin, işləyən %1$@ taf-ına verdiyiniz kimi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте му задача, която използва промяната, както бихте дали на активния %1$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিবর্তনটি ব্যবহার করে এমন একটি কাজ দিন, যেমন চালু %1$@-কে দিতেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dona-li una tasca que faci servir el canvi, com ho faries amb el %1$@ actiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte mu úkol, který využije změnu, jako byste ho dali aktivnímu %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ihr eine Aufgabe, die die Änderung nutzt, so wie du es beim Live-%1$@ tun würdest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a task that uses the change, as you would the live %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale una tarea que use el cambio, como harías con %1$@ en su versión activa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna sellele ülesanne, mis kasutab muudatust, nagu annaksid kasutusel olevale tafile %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez-lui une tâche qui utilise le changement, comme vous le feriez avec %1$@ en service."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לתת לה משימה שמשתמשת בשינוי, כמו שהיית נותן ל-%1$@ הפעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे ऐसा काम दें जो बदलाव का उपयोग करे, जैसे आप चालू %1$@ को देते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte mu zadatak koji koristi promjenu, kao što biste zadali verziji u radu: %1$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj neki egy feladatot, amely használja a változást, ahogy az élő %1$@ tafnak adnál."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տվեք նրան առաջադրանք, որը օգտագործում է փոփոխությունը, ինչպես կտայիք ակտիվ %1$@-ին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tugas yang memakai perubahan itu, seperti yang Anda berikan kepada %1$@ yang aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagli un'attività che usi la modifica, come faresti con %1$@ attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用中の%1$@と同じように、変更を使うタスクを渡してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიეცით მას ამოცანა, რომელიც ცვლილებას იყენებს, ისე როგორც აქტიურ %1$@-ს მისცემდით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឱ្យវានូវកិច្ចការដែលប្រើការផ្លាស់ប្តូរ ដូចអ្នកឱ្យ %1$@ ដែលកំពុងដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용된 %1$@에게 하듯이, 변경 내용을 쓰는 작업을 맡겨 보세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃຫ້ວຽກທີ່ໃຊ້ການປ່ຽນແປງນັ້ນ ຄືກັບທີ່ທ່ານໃຫ້ %1$@ ທີ່ໃຊ້ງານຢູ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duokite jai užduotį, kurioje naudojamas pakeitimas, kaip duotumėte aktyviam %1$@."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dod tam uzdevumu, kas izmanto izmaiņu, kā to darītu ar darbā esošo %1$@."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дај му задача што ја користи промената, како што би го дал на активниот %1$@."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Идэвхтэй %1$@-д өгдөг шигээ өөрчлөлтийг ашигладаг даалгавар өгнө үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय %1$@ लाई जस्तै यसलाई परिवर्तन प्रयोग गर्ने कार्य दिनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef het een taak die de wijziging gebruikt, zoals je de live %1$@ zou doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daj mu zadanie, które korzysta ze zmiany, tak jak działającemu na żywo %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê-lhe uma tarefa que use a alteração, como faria com %1$@ em produção."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a ele uma tarefa que use a alteração, como faria com %1$@ em produção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dați-i o sarcină care folosește schimbarea, așa cum i-ați da versiunii active %1$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dajte mu úlohu, ktorá využije zmenu, ako by ste ju dali aktívnemu %1$@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dajte mu opravilo, ki uporabi spremembo, kot bi ga dali aktivnemu %1$@."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Jepini një detyrë që përdor ndryshimin, siç do ta bënit me %1$@ aktiv."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte mu zadatak koji koristi promenu, kao šta biste zadali verziji u radu: %1$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มอบงานที่ใช้การเปลี่ยนแปลงนี้ เหมือนที่คุณทำกับ %1$@ ที่ใช้งานอยู่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Oňa üýtgetmäni ulanýan iş beriň, işjeň %1$@-a berşiňiz ýaly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişikliği kullanan bir görev verin, yayındaki %1$@ taf'ına vereceğiniz gibi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے ایسا کام دیں جو اس تبدیلی کو استعمال کرے، جیسے آپ لائیو %1$@ کو دیتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy giao cho nó một nhiệm vụ dùng đến thay đổi, như bạn làm với %1$@ đang chạy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請給它一項會用到這項變更的任務，就像您對目前生效的 %1$@ 那樣。"
          }
        }
      }
    },
    "version.guide.install_or_back": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«تثبيت» يجعلها النسخة الفعّالة؛ و«رجوع» ينهي التجربة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Quraşdırın» onu işləyən versiya edir; «Geri qayıdın» sınağı bitirir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Инсталиране“ я прави активна версия; „Връщане“ приключва пробата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনস্টল একে চালু সংস্করণ করে; ফিরে যান পরীক্ষা শেষ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal·la la converteix en la versió activa; Torna enrere acaba la prova."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalovat z ní udělá aktivní verzi; Vrátit se ukončí zkoušku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Installieren“ macht sie zur Live-Version; „Zurückkehren“ beendet den Test."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install makes it the live version; Go back ends the trial."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar la convierte en la versión activa; Volver atrás termina la prueba."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paigalda teeb sellest kasutusel oleva versiooni; Mine tagasi lõpetab proovi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer en fait la version en service ; Revenir en arrière met fin à l'essai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "«התקנה» הופכת אותה לגרסה הפעילה; «חזרה» מסיימת את הניסיון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉल इसे चालू संस्करण बनाता है; वापस जाएँ ट्रायल खत्म करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacija je čini verzijom u radu; Vratite se završava probu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Telepítés élő verzióvá teszi; a Vissza befejezi a próbát."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեղադրումը այն դարձնում է ակտիվ տարբերակ․ «Վերադառնալ»-ը ավարտում է փորձարկումը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang menjadikannya versi aktif; Kembali mengakhiri uji coba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa la rende la versione attiva; Torna indietro termina la prova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「インストール」で適用中のバージョンになり、「元に戻す」で試用が終わります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაყენება მას აქტიურ ვერსიად ხდის; დაბრუნება ცდას ასრულებს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការដំឡើងធ្វើឱ្យវាក្លាយជាកំណែដែលកំពុងដំណើរការ; ត្រឡប់ក្រោយបញ្ចប់ការសាកល្បង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치하면 적용된 버전이 되고, 되돌아가기를 누르면 시험이 끝납니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕິດຕັ້ງເຮັດໃຫ້ມັນເປັນເວີຊັນທີ່ໃຊ້ງານ; ກັບຄືນຈົບການທົດລອງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Įdiegti“ padaro ją aktyvia versija; „Grįžti“ baigia bandymą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Instalēt” padara to par darbā esošo versiju; “Atgriezties” beidz izmēģinājumu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирај ја прави активна верзија; Врати се назад го завршува пробувањето."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Суулгах нь үүнийг идэвхтэй хувилбар болгоно; Буцах нь туршилтыг дуусгана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थापनाले यसलाई सक्रिय संस्करण बनाउँछ; पछाडि फर्कनुहोस्ले परीक्षण अन्त्य गर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeren maakt er de live versie van; Teruggaan beëindigt de proef."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj czyni ją wersją działającą na żywo; Wróć kończy próbę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar torna-a a versão em produção; Voltar atrás termina a experiência."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar torna-a a versão em produção; Voltar atrás termina a experiência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalați o face versiunea activă; Reveniți încheie proba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Inštalovať z nej urobí aktívnu verziu; Vrátiť sa ukončí skúšku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namesti jo naredi za aktivno različico; Vrni se konča preizkus."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalimi e bën versionin aktiv; Kthimi mbyll provën."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacija je čini verzijom u radu; Vratite se završava probu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งทำให้เป็นเวอร์ชันที่ใช้งาน ย้อนกลับสิ้นสุดการทดลอง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gurmak ony işjeň wersiýa edýär; Yzyna gaýdyň synagy gutarýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur, onu yayındaki sürüm yapar; Geri dön, denemeyi bitirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انسٹال اسے لائیو ورژن بناتا ہے؛ واپس جائیں آزمائش ختم کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt đưa nó thành phiên bản đang chạy; Quay lại kết thúc lần thử."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「安裝」會讓它成為生效的版本；「返回」會結束試用。"
          }
        }
      }
    },
    "version.guide.keeps_working": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يواصل %1$@ عمله كما هو. وما تفعله هذه النسخة حقيقي، تحت Card خاصة بها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ olduğu kimi işləməyə davam edir. Bu versiyanın etdikləri həqiqidir, öz Card-ı altında."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ продължава да работи както досега. Това, което прави тази версия, е истинско, под собствената ѝ Card."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ যেমন আছে তেমন কাজ করতে থাকে। এই সংস্করণ যা করে তা বাস্তব, নিজের Card-এর অধীনে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continua funcionant tal com és. El que fa aquesta versió és real, sota el seu propi Card."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dál pracuje jako dosud. Co dělá tato verze, je skutečné, pod její vlastní Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ arbeitet weiter wie bisher. Was diese Version tut, ist echt, unter ihrer eigenen Card."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ keeps working as it is. What this version does is real, under its own Card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sigue funcionando como está. Lo que hace esta versión es real, con su propia Card."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ töötab edasi nagu praegu. See, mida see versioon teeb, on päris, oma Cardi all."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continue de fonctionner tel quel. Ce que fait cette version est réel, sous sa propre Card."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ממשיך לעבוד כפי שהוא. מה שהגרסה הזו עושה הוא אמיתי, תחת ה-Card שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ जैसा है वैसा काम करता रहता है। यह संस्करण जो करता है वह असली है, अपने Card के तहत।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nastavlja raditi kakav jest. Ono što ova verzija radi je stvarno, pod njezinim vlastitim Cardom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ úgy dolgozik tovább, ahogy eddig. Amit ez a verzió tesz, az valódi, a saját Cardja alatt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը շարունակում է աշխատել ինչպես կա։ Ինչ անում է այս տարբերակը՝ իրական է, իր սեփական Card-ի ներքո։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tetap bekerja seperti sekarang. Yang dilakukan versi ini nyata, di bawah Card miliknya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continua a lavorare com'è. Ciò che fa questa versione è reale, con la sua Card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はそのまま動き続けます。このバージョンの操作は、専用のCardのもとで実際に行われます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ აგრძელებს მუშაობას ისე, როგორც არის. რასაც ეს ვერსია აკეთებს, რეალურია, საკუთარი Card-ით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ បន្តធ្វើការដូចដែលវាជា។ អ្វីដែលកំណែនេះធ្វើគឺពិតប្រាកដ ក្រោម Card ផ្ទាល់ខ្លួនរបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 지금처럼 계속 작동합니다. 이 버전이 하는 일은 자체 Card에 따른 실제 행동입니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ເຮັດວຽກຕໍ່ຄືເກົ່າ. ສິ່ງທີ່ເວີຊັນນີ້ເຮັດແມ່ນຈິງ, ພາຍໃຕ້ Card ຂອງມັນເອງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dirba toliau kaip anksčiau. Ką daro ši versija, yra tikra, pagal jos pačios Card."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ turpina strādāt tāpat kā līdz šim. Tas, ko dara šī versija, ir pa īstam, ar savu Card."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ продолжува да работи како што е. Она што го прави оваа верзија е вистинско, под нејзин сопствен Card."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ одоогийнхоороо үргэлжлэн ажиллана. Энэ хувилбарын хийдэг зүйл бодит бөгөөд өөрийн Card-ын дор явагдана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ जस्तो छ त्यसै काम गरिरहन्छ। यो संस्करणले गर्ने कुरा वास्तविक हुन्छ, आफ्नै Card अन्तर्गत।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ blijft werken zoals het is. Wat deze versie doet, is echt, onder een eigen Card."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ działa dalej bez zmian. To, co robi ta wersja, dzieje się naprawdę, w ramach jej własnej Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continua a funcionar como está. O que esta versão faz é real, ao abrigo do seu próprio Card."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continua funcionando como está. O que esta versão faz é real, ao abrigo do seu próprio Card."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continuă să lucreze ca acum. Ce face această versiune este real, sub propriul Card."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ďalej pracuje ako doteraz. Čo robí táto verzia, je skutočné, pod jej vlastnou Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ še naprej dela, kot dela. Kar naredi ta različica, je resnično, pod njeno lastno Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vazhdon të punojë siç është. Ajo që bën ky version është e vërtetë, nën Card-in e vet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
