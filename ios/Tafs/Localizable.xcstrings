    "setup.if_busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان لا يزال يعمل عندما يحين البدء التالي"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Növbəti başlanğıc gələndə hələ işləyirsə"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако още работи, когато дойде следващото стартиране"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরবর্তী শুরু আসার সময় এটি এখনও কাজ করলে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si encara està treballant quan arriba el començament següent"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když ještě pracuje, až přijde další spuštění"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn er beim nächsten Start noch arbeitet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it is still working when the next start comes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sigue trabajando cuando llega el siguiente inicio"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui see töötab veel, kui tuleb järgmine käivitusaeg"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il travaille encore au prochain démarrage"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם הוא עדיין עובד כשההתחלה הבאה מגיעה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि अगली शुरुआत आने पर भी यह काम कर रहा हो"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako još radi kad dođe sljedeće pokretanje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha még dolgozik, amikor jön a következő indítás"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե դեռ աշխատում է, երբ գալիս է հաջորդ սկիզբը"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika masih bekerja saat awal berikutnya tiba"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sta ancora lavorando quando arriva il prossimo avvio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の開始時刻にまだ作業中の場合"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ მაინც მუშაობს, როცა შემდეგი დაწყება მოდის"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រសិនបើវានៅតែកំពុងធ្វើការ នៅពេលការចាប់ផ្តើមបន្ទាប់មកដល់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 시작 시점에 아직 작업 중이라면"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຖ້າມັນຍັງເຮັດວຽກຢູ່ເມື່ອການເລີ່ມຕໍ່ໄປມາຮອດ"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei jis dar dirba, kai ateina kitas paleidimas"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja tas joprojām strādā, kad pienāk nākamais sākums"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако сè уште работи кога доаѓа следното започнување"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дараагийн эхлэл ирэхэд хэрэв тэр ажиллаж байвал"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अर्को सुरुवात आउँदा यो अझै काम गरिरहेको भए"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het nog bezig is wanneer de volgende start komt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli nadal pracuje, gdy nadejdzie następny start"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ainda estiver a trabalhar quando chegar o próximo início"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ainda estiver a trabalhar quando chegar o próximo início"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă încă lucrează când vine următoarea pornire"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď ešte pracuje, keď príde ďalšie spustenie"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če še dela, ko pride naslednji zagon"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse po punon ende kur vjen fillimi i radhës"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako još radi kad dođe sledeće pokretanje"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากมันยังทำงานอยู่เมื่อถึงเวลาเริ่มครั้งถัดไป"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiki başlama gelende ol henizem işleýän bolsa"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki başlangıç geldiğinde hâlâ çalışıyorsa"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اگلی شروعات کے وقت یہ ابھی کام کر رہا ہو"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu nó vẫn đang làm khi lần bắt đầu tiếp theo đến"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若下次啟動時它仍在工作"
          }
        }
      }
    },
