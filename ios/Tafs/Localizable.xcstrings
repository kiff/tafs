        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কণ্ঠ এই ডিভাইসেই লেখায় রূপান্তরিত হয়। আপনি পাঠানো পর্যন্ত এটি পাঠানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva veu es converteix en text en aquest dispositiu. No s'envia fins que l'envies."
