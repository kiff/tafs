        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो %1$@ मा पासकोड छैन, र %2$@ लाई एउटा चाहिन्छ। %3$@ मा पासकोड सेट गर्नुहोस्, त्यसपछि %4$@ थपेर फर्कनुहोस्।"
