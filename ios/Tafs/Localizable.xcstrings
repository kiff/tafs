    "billing.bought_not_recorded": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alındı. KIFF onu hələ əlavə etməyib: tafs açılanda yenidən cəhd edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Закупено. KIFF още не го е добавил: tafs ще опита отново при отваряне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koupeno. KIFF to ještě nepřidal: tafs to zkusí znovu při otevření."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekauft. KIFF hat es noch nicht hinzugefügt: tafs versucht es beim nächsten Öffnen erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bought. KIFF hasn't added it yet: tafs tries again when it opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprado. KIFF aún no lo ha añadido: tafs lo vuelve a intentar al abrirse."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostetud. KIFF pole seda veel lisanud: tafs proovib uuesti, kui see avaneb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acheté. KIFF ne l'a pas encore ajouté : tafs réessaie à son ouverture."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupljeno. KIFF to još nije dodao: tafs pokušava ponovno kad se otvori."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megvásárolva. A KIFF még nem adta hozzá: a tafs a következő megnyitáskor újra megpróbálja."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գնվեց։ KIFF-ը դեռ չի ավելացրել այն․ tafs-ը նորից կփորձի բացվելիս։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terbeli. KIFF belum menambahkannya: tafs mencoba lagi saat dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquistato. KIFF non l'ha ancora aggiunto: tafs riprova quando si apre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入しました。KIFFはまだ追加していません。tafsを開くと再試行します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნაყიდია. KIFF-მა ის ჯერ არ დაამატა: tafs ხელახლა ცდის გახსნისას."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매했습니다. KIFF가 아직 추가하지 않았습니다. tafs를 열면 다시 시도합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nupirkta. KIFF to dar nepridėjo: tafs bandys dar kartą atsidarius."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopirkts. KIFF to vēl nav pievienojis: tafs mēģinās vēlreiz, kad tiks atvērts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekocht. KIFF heeft het nog niet toegevoegd: tafs probeert het opnieuw wanneer het opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupiono. KIFF jeszcze tego nie dodał: tafs spróbuje ponownie po otwarciu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprado. O KIFF ainda não o adicionou: o tafs tenta novamente quando abrir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprado. O KIFF ainda não o adicionou: o tafs tenta novamente quando abrir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumpărat. KIFF nu l-a adăugat încă: tafs reîncearcă la deschidere."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kúpené. KIFF to ešte nepridal: tafs to skúsi znova pri otvorení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupljeno. KIFF tega še ni dodal: tafs poskusi znova, ko se odpre."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "U blua. KIFF ende nuk e ka shtuar: tafs provon sërish kur hapet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupljeno. KIFF to još nije dodao: tafs pokušava ponovo kad se otvori."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซื้อแล้ว แต่ KIFF ยังไม่ได้เพิ่ม: tafs จะลองอีกครั้งเมื่อเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alındı. KIFF henüz eklemedi: tafs açıldığında tekrar dener."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã mua. KIFF chưa thêm: tafs sẽ thử lại khi mở."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已購買。KIFF 尚未加入：tafs 會在開啟時重試。"
          }
        }
      }
    },
