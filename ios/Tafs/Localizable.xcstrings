          "stringUnit": {
            "state": "translated",
            "value": "Излязохте на този часовник. Телефонът ви остава влязъл."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ঘড়িতে সাইন আউট করা হয়েছে। আপনার ফোন সাইন ইন করা থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ha tancat la sessió en aquest rellotge. El teu telèfon manté la sessió iniciada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlášeno na těchto hodinkách. Telefon zůstává přihlášený."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dieser Uhr abgemeldet. Dein Handy bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed out on this watch. Your phone stays signed in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión cerrada en este reloj. Tu teléfono sigue con la sesión iniciada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selles kellas välja logitud. Telefon jääb sisse logituks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté de cette montre. Votre téléphone reste connecté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצאת בשעון הזה. הטלפון שלך נשאר מחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस घड़ी पर साइन आउट हुआ। आपका फ़ोन साइन इन रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavljeni na ovom satu. Vaš telefon ostaje prijavljen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijelentkeztél ezen az órán. A telefonod bejelentkezve marad."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս ժամացույցից դուրս եկաք։ Ձեր հեռախոսը մնում է մուտք գործած։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar di jam tangan ini. Ponsel Anda tetap masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessione chiusa su questo orologio. Il telefono resta connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウォッチでサインアウトしました。スマートフォンはサインインしたままです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ საათზე გამოხვედით. თქვენი ტელეფონი შესული რჩება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានចាកចេញនៅលើនាឡិកានេះ។ ទូរសព្ទរបស់អ្នកនៅតែចូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 워치에서 로그아웃했습니다. 휴대폰은 로그인 상태로 유지됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອອກຈາກລະບົບໃນໂມງນີ້ແລ້ວ. ໂທລະສັບຂອງທ່ານຍັງເຂົ້າສູ່ລະບົບຢູ່."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsijungta šiame laikrodyje. Telefonas lieka prisijungęs."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izrakstījies šajā pulkstenī. Tālrunis paliek pierakstījies."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одјавен на овој часовник. Твојот телефон останува најавен."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ цагнаас гарсан. Таны утас нэвтэрсэн хэвээр байна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो घडीमा साइन आउट भयो। तपाईंको फोन साइन इन रहन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgelogd op dit horloge. Je telefoon blijft ingelogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowano na tym zegarku. Telefon pozostaje zalogowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão terminada neste relógio. O telemóvel continua com sessão iniciada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão encerrada neste relógio. O celular continua conectado à sua conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectat pe acest ceas. Telefonul rămâne conectat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásené na týchto hodinkách. Telefón zostáva prihlásený."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavljeni na tej uri. Telefon ostane prijavljen."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolët nga kjo orë. Telefoni juaj mbetet i hyrë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavljeni na ovom satu. Vaš telefon ostaje prijavljen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจากระบบบนนาฬิกาเรือนนี้แล้ว โทรศัพท์ของคุณยังเข้าสู่ระบบอยู่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sagatda çykyldy. Telefonyňyz girilen galýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu saatte oturum kapatıldı. Telefonunuzda oturum açık kalır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس گھڑی پر سائن آؤٹ ہو گیا۔ آپ کا فون سائن اِن رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đăng xuất trên đồng hồ này. Điện thoại của bạn vẫn đăng nhập."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在這支手錶上登出。您的手機仍保持登入。"
          }
        }
      }
    },
