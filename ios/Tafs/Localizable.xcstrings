    "needs_you.check_code": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob KIFF denselben Code zeigt, und genehmige nur mit diesem Telefon in deinen Händen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that KIFF shows the same code, and approve only with this phone in your hands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que KIFF muestra el mismo código, y aprueba solo con este teléfono en tus manos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli, et KIFF näitab sama koodi, ja kinnita ainult siis, kui see telefon on sinu käes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que KIFF affiche le même code, et n'approuvez qu'avec ce téléphone en main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che KIFF mostri lo stesso codice, e approva solo con questo telefono in mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFに同じコードが表示されていることを確認し、このスマートフォンを手元に持った状態でのみ承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF에 같은 코드가 표시되는지 확인하고, 이 휴대폰을 손에 든 상태에서만 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Patikrinkite, ar KIFF rodo tą patį kodą, ir tvirtinkite tik laikydami šį telefoną rankose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārbaudi, vai KIFF rāda to pašu kodu, un apstiprini tikai tad, ja šis tālrunis ir tavās rokās."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of KIFF dezelfde code toont, en keur alleen goed met deze telefoon in je handen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy KIFF pokazuje ten sam kod, i zatwierdzaj tylko z tym telefonem w rękach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o KIFF mostra o mesmo código, e aprove apenas com este telefone nas suas mãos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o KIFF mostra o mesmo código, e aprove apenas com este telefone nas suas mãos."
          }
        }
      }
    },
