    "door.whatsapp_android": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة باب WhatsApp غير متاحة في تطبيق Android بعد. أضفه من tafs على iPhone."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp qapısı əlavə etmək hələ Android tətbiqində yoxdur. Onu iPhone-da tafs-dan əlavə edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавянето на врата в WhatsApp още го няма в приложението за Android. Добавете я от tafs на iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp দরজা যোগ করা এখনও Android অ্যাপে নেই। iPhone-এ tafs থেকে যোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegir una porta de WhatsApp encara no és a l'aplicació d'Android. Afegeix-la des de tafs en un iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidání dveří WhatsApp v aplikaci pro Android zatím není. Přidejte je z tafs na iPhonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine WhatsApp-Tür lässt sich in der Android-App noch nicht hinzufügen. Füge sie in tafs auf einem iPhone hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding a WhatsApp door isn't in the Android app yet. Add it from tafs on an iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir una puerta de WhatsApp aún no está en la app de Android. Añádela desde tafs en un iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsAppi ukse lisamist pole Androidi rakenduses veel. Lisa see iPhone'i tafsist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ajout d'une porte WhatsApp n'est pas encore disponible dans l'app Android. Ajoutez-la depuis tafs sur un iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת דלת WhatsApp עדיין לא נמצאת באפליקציית Android. יש להוסיף אותה מ-tafs ב-iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp द्वार जोड़ना अभी Android ऐप में नहीं है। इसे iPhone पर tafs से जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodavanje WhatsApp vrata još nije u Android aplikaciji. Dodajte ih iz tafsa na iPhoneu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp-ajtó hozzáadása még nincs az Android-alkalmazásban. Add hozzá a tafsből egy iPhone-on."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp դռան ավելացումը Android հավելվածում դեռ չկա։ Ավելացրեք tafs-ից iPhone-ում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan pintu WhatsApp belum ada di aplikasi Android. Tambahkan dari tafs di iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aggiunta di una porta WhatsApp non è ancora nell'app Android. Aggiungila da tafs su un iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp窓口の追加はまだAndroidアプリではできません。iPhoneのtafsから追加してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp-ის კარის დამატება Android აპში ჯერ არ არის. დაამატეთ tafs-იდან iPhone-ზე."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការបន្ថែមទ្វារ WhatsApp មិនទាន់មានក្នុងកម្មវិធី Android ទេ។ បន្ថែមវាពី tafs នៅលើ iPhone។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 앱에서는 아직 WhatsApp 창구를 추가할 수 없습니다. iPhone의 tafs에서 추가하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການເພີ່ມປະຕູ WhatsApp ຍັງບໍ່ຢູ່ໃນແອັບ Android. ເພີ່ມຈາກ tafs ໃນ iPhone."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp durų pridėjimo Android programėlėje dar nėra. Pridėkite jas iš tafs iPhone telefone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp durvju pievienošana Android lietotnē vēl nav pieejama. Pievieno tās no tafs iPhone tālrunī."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавањето врата на WhatsApp сè уште не е во апликацијата за Android. Додај ги од tafs на iPhone."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp хаалга нэмэх нь Android аппад хараахан алга. iPhone дээрх tafs-аас нэмнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp ढोका थप्ने सुविधा Android एपमा अहिलेसम्म छैन। iPhone मा tafs बाट थप्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een WhatsApp-deur toevoegen kan nog niet in de Android-app. Voeg hem toe vanuit tafs op een iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawania drzwi WhatsApp nie ma jeszcze w aplikacji na Androida. Dodaj je z tafs na iPhonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não é possível adicionar uma porta do WhatsApp na app Android. Adicione-a a partir do tafs num iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não é possível adicionar uma porta do WhatsApp no app Android. Adicione-a a partir do tafs em um iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugarea unei uși WhatsApp nu este încă în aplicația Android. Adăugați-o din tafs pe un iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridanie dverí WhatsApp v aplikácii pre Android zatiaľ nie je. Pridajte ich z tafs na iPhone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajanja vrat WhatsApp še ni v aplikaciji Android. Dodajte jih iz tafs v iPhonu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shtimi i një porte WhatsApp ende nuk është në aplikacionin Android. Shtojeni nga tafs në një iPhone."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodavanje WhatsApp vrata još nije u Android aplikaciji. Dodajte ih iz tafsa na iPhoneu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเพิ่มประตู WhatsApp ยังไม่มีในแอป Android เพิ่มได้จาก tafs บน iPhone"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp gapysyny goşmak heniz Android programmasynda ýok. Ony iPhone-daky tafs-dan goşuň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp kapısı ekleme Android uygulamasında henüz yok. Bir iPhone'daki tafs'tan ekleyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp دروازہ شامل کرنا ابھی Android ایپ میں نہیں ہے۔ اسے iPhone پر tafs سے شامل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm cửa WhatsApp chưa có trong ứng dụng Android. Hãy thêm từ tafs trên iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android App 尚無法新增 WhatsApp 門。請從 iPhone 上的 tafs 新增。"
          }
        }
      }
    },
    "door.whatsapp_elsewhere": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضاف أبواب WhatsApp حاليًا من tafs على iPhone؛ وعند إضافتها تظهر هنا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp qapıları hələlik iPhone-da tafs-dan əlavə edilir; əlavə ediləndən sonra burada görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вратите в WhatsApp засега се добавят от tafs на iPhone; след добавяне се показват тук."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp দরজা আপাতত iPhone-এ tafs থেকে যোগ করা হয়; যোগ হলে এখানে দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "De moment les portes de WhatsApp s'afegeixen des de tafs en un iPhone; un cop afegides, es mostren aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dveře WhatsApp se zatím přidávají z tafs na iPhonu; po přidání se zobrazí tady."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp-Türen werden vorerst in tafs auf einem iPhone hinzugefügt; danach erscheinen sie hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp doors are added from tafs on an iPhone for now; once added, they show here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora, las puertas de WhatsApp se añaden desde tafs en un iPhone; una vez añadidas, aparecen aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsAppi uksed lisatakse praegu iPhone'i tafsist; pärast lisamist on need siin näha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les portes WhatsApp s'ajoutent pour l'instant depuis tafs sur un iPhone ; une fois ajoutées, elles s'affichent ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דלתות WhatsApp נוספות כרגע מ-tafs ב-iPhone; לאחר שנוספו, הן מוצגות כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp द्वार अभी iPhone पर tafs से जोड़े जाते हैं; जुड़ने के बाद वे यहाँ दिखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp vrata za sada se dodaju iz tafsa na iPhoneu; kad su dodana, prikazuju se ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp-ajtókat egyelőre a tafsből lehet hozzáadni egy iPhone-on; hozzáadás után itt jelennek meg."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp դռները առայժմ ավելացվում են tafs-ից iPhone-ում․ ավելացնելուց հետո դրանք երևում են այստեղ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintu WhatsApp untuk sementara ditambahkan dari tafs di iPhone; setelah ditambahkan, muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora le porte WhatsApp si aggiungono da tafs su un iPhone; una volta aggiunte, compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp窓口は現在iPhoneのtafsから追加します。追加するとここに表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp-ის კარები ჯერჯერობით tafs-იდან iPhone-ზე ემატება; დამატების შემდეგ აქაც ჩანს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឥឡូវនេះទ្វារ WhatsApp ត្រូវបានបន្ថែមពី tafs នៅលើ iPhone; នៅពេលបានបន្ថែម ពួកវាបង្ហាញនៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 WhatsApp 창구를 iPhone의 tafs에서 추가합니다. 추가하면 여기에 표시됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດຽວນີ້ປະຕູ WhatsApp ຖືກເພີ່ມຈາກ tafs ໃນ iPhone; ເມື່ອເພີ່ມແລ້ວ ມັນສະແດງຢູ່ນີ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kol kas WhatsApp durys pridedamos iš tafs iPhone telefone; pridėtos jos rodomos čia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagaidām WhatsApp durvis pievieno no tafs iPhone tālrunī; kad pievienotas, tās parādās šeit."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вратата на WhatsApp засега се додаваат од tafs на iPhone; штом се додадат, се прикажуваат тука."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp хаалгыг одоохондоо iPhone дээрх tafs-аас нэмдэг; нэмэгдсэний дараа энд харагдана."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp ढोकाहरू अहिलेका लागि iPhone मा tafs बाट थपिन्छन्; थपिएपछि तिनी यहाँ देखिन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp-deuren worden voorlopig toegevoegd vanuit tafs op een iPhone; daarna verschijnen ze hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drzwi WhatsApp dodaje się na razie z tafs na iPhonie; po dodaniu pojawią się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por agora, as portas do WhatsApp são adicionadas a partir do tafs num iPhone; depois de adicionadas, aparecem aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por enquanto, as portas do WhatsApp são adicionadas a partir do tafs em um iPhone; depois de adicionadas, aparecem aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ușile WhatsApp se adaugă deocamdată din tafs pe un iPhone; după adăugare, apar aici."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvere WhatsApp sa zatiaľ pridávajú z tafs na iPhone; po pridaní sa zobrazia tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrata WhatsApp se zaenkrat dodajajo iz tafs v iPhonu; ko so dodana, se prikažejo tukaj."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Portat WhatsApp shtohen nga tafs në një iPhone për momentin; pasi të shtohen, shfaqen këtu."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp vrata za sada se dodaju iz tafsa na iPhoneu; kad su dodana, prikazuju se ovdje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ประตู WhatsApp เพิ่มได้จาก tafs บน iPhone เมื่อเพิ่มแล้วจะแสดงที่นี่"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp gapylary häzirlikçe iPhone-daky tafs-dan goşulýar; goşulandan soň olar şu ýerde görünýär."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp kapıları şimdilik bir iPhone'daki tafs'tan eklenir; eklendikten sonra burada görünür."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp دروازے فی الحال iPhone پر tafs سے شامل ہوتے ہیں؛ شامل ہونے کے بعد وہ یہاں دکھتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện các cửa WhatsApp được thêm từ tafs trên iPhone; sau khi thêm, chúng hiện ở đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp 門目前要從 iPhone 上的 tafs 新增；新增後會顯示在這裡。"
          }
        }
      }
    },
