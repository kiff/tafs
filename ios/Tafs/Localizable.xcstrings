          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามก่อนทำสิ่งผิดปกติ แม้จะอยู่ใน Card"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
