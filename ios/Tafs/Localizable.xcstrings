    "door.key.foot": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Mesaj yalnız bu şərt ödənəndə onlarınkı sayılır; başqası döyür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Съобщение се счита за тяхно само когато това е вярно; всеки друг чука."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Zpráva se počítá za jejich, jen když to platí; kdokoli jiný jen klepe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Eine Nachricht gilt nur dann als ihre, wenn das zutrifft; alle anderen klopfen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. A message counts as theirs only when that holds; anyone else knocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un mensaje cuenta como suyo solo cuando eso se cumple; los de cualquier otra persona llegan como llamada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Sõnum loetakse nende omaks ainult siis, kui see kehtib; kõik teised koputavad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un message n'est considéré comme le sien que si c'est le cas ; toute autre personne fait une demande d'accès."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Poruka se računa kao njihova samo kad to vrijedi; svi ostali kucaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Egy üzenet csak akkor számít az övének, ha ez teljesül; bárki más csak kopog."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@։ Հաղորդագրությունը նրանցինն է համարվում միայն երբ դա ճիշտ է․ մնացածը թակում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Sebuah pesan dihitung sebagai milik mereka hanya saat itu berlaku; selain itu mengetuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un messaggio conta come suo solo se questo è vero; per chiunque altro è una bussata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。それが確認できたときだけ、その人のメッセージとして扱われます。それ以外の人はノックになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. შეტყობინება მათად ითვლება მხოლოდ მაშინ, როცა ეს მართალია; დანარჩენი აკაკუნებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. 이것이 확인될 때만 그 사람의 메시지로 봅니다. 그 밖의 사람은 노크만 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Žinutė laikoma jų tik tada, kai tai patvirtinama; visi kiti tik beldžiasi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Ziņa tiek uzskatīta par viņu ziņu tikai tad, ja tas izpildās; visi pārējie klauvē."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Een bericht telt alleen als het hunne als dat zo is; ieder ander klopt aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Wiadomość liczy się jako ich tylko wtedy, gdy to się zgadza; każdy inny puka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Uma mensagem só conta como dessa pessoa quando isso se verifica; qualquer outra pessoa faz um pedido de contacto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Uma mensagem só conta como dessa pessoa quando isso se verifica; qualquer outra pessoa faz um pedido de contato."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un mesaj contează ca al lor doar când asta e adevărat; oricine altcineva bate la ușă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Správa sa počíta za ich, len keď to platí; ktokoľvek iný len klope."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Sporočilo šteje za njihovo samo, ko to drži; vsi drugi samo potrkajo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Një mesazh numërohet si i tyre vetëm kur kjo vlen; çdo tjetër troket."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Poruka se naloga kao njihova samo kad to važi; svi ostali kucaju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ข้อความจะนับว่าเป็นของพวกเขาก็ต่อเมื่อเงื่อนไขนั้นเป็นจริง นอกนั้นเป็นเพียงการเคาะประตู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Bir mesaj yalnızca bu geçerliyse onlardan sayılır; başka herkes kapıyı çalar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Một tin nhắn chỉ được tính là của họ khi điều đó đúng; còn lại chỉ là gõ cửa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。只有在這個條件成立時，訊息才算是他們的；其他人只是敲門。"
          }
        }
      }
    },
    "door.key.no_one_paired": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada heç kim cütləşməyib"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тук няма сдвоени"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tady není nikdo spárovaný"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist niemand gekoppelt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one is paired here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay nadie vinculado"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Siin pole kedagi seotud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne n'est associé ici"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje nitko nije uparen"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt senki sincs párosítva"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այստեղ ոչ ոք զուգակցված չէ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang dipasangkan di sini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno è associato qui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここには誰も登録されていません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აქ არავინ არის დაწყვილებული"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 등록된 사람이 없습니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Čia niekas nesusietas"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šeit neviens nav savienots pārī"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier is niemand gekoppeld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt nie jest tu powiązany"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém está associado aqui"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém está associado aqui"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeni nu este asociat aici"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nie je nikto spárovaný"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ni nihče seznanjen"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Askush nuk është çiftuar këtu"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje nitko nije uparen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีใครจับคู่ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada kimse eşleştirilmemiş"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa ai được ghép đôi ở đây"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡沒有人配對"
          }
        }
      }
    },
    "door.key.none": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ona görə burada heç kim %2$@ taf-ına iş verə bilməz. Gələn hər şey döyür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, така че никой тук не може да дава работа на %2$@. Всичко, което идва, чука."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, takže tady nikdo nemůže %2$@ dávat práci. Všechno, co přijde, jen klepe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, daher kann hier niemand %2$@ Arbeit geben. Alles, was ankommt, klopft an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, so no one here can give %2$@ work. Everything that comes through knocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, así que aquí nadie puede dar trabajo a %2$@. Todo lo que llega es una llamada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, seega ei saa keegi siin tafile %2$@ tööd anda. Kõik, mis tuleb, koputab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : personne ici ne peut donc donner du travail à %2$@. Tout ce qui arrive est une demande d'accès."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, pa nitko ovdje ne može davati posao tafu %2$@. Sve što stigne kuca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ezért itt senki sem adhat munkát neki (%2$@). Minden, ami beérkezik, kopog."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ուստի այստեղ ոչ ոք չի կարող %2$@-ին աշխատանք տալ։ Ամեն ինչ, ինչ գալիս է, թակում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, jadi tidak ada yang di sini dapat memberi %2$@ pekerjaan. Semua yang masuk hanya mengetuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, quindi nessuno qui può dare lavoro a %2$@. Tutto ciò che arriva è una bussata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。そのため、ここでは誰も%2$@に仕事を頼めません。届いたものはすべてノックになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ამიტომ აქ ვერავინ მისცემს %2$@-ს სამუშაოს. ყველაფერი, რაც მოდის, აკაკუნებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. 그래서 여기서는 아무도 %2$@에게 작업을 맡길 수 없습니다. 들어오는 것은 모두 노크로 처리됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, todėl niekas čia negali duoti darbo %2$@. Viskas, kas ateina, tik beldžiasi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, tāpēc neviens šeit nevar dot %2$@ darbu. Viss, kas ienāk, klauvē."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, dus niemand hier kan %2$@ werk geven. Alles wat binnenkomt, klopt aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, więc nikt tutaj nie może zlecać pracy %2$@. Wszystko, co przychodzi, puka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, por isso ninguém aqui pode dar trabalho a %2$@. Tudo o que chega fica como pedido de contacto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, por isso ninguém aqui pode dar trabalho a %2$@. Tudo o que chega fica como pedido de contato."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, așa că nimeni de aici nu îi poate da lui %2$@ de lucru. Tot ce vine bate la ușă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, takže tu nikto nemôže %2$@ dávať prácu. Všetko, čo príde, len klope."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, zato tu nihče ne more dati dela %2$@. Vse, kar pride, samo potrka."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ndaj askush këtu nuk mund t'i japë %2$@ punë. Gjithçka që vjen troket."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, pa nitko ovdje ne može davati posao tafu %2$@. Sve šta stigne kuca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จึงไม่มีใครที่นี่มอบงานให้ %2$@ ได้ ทุกอย่างที่เข้ามาเป็นเพียงการเคาะประตู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, bu yüzden burada kimse %2$@ taf'ına iş veremez. Gelen her şey kapıyı çalar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, nên không ai ở đây giao việc được cho %2$@. Mọi thứ đến đều chỉ là gõ cửa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，因此這裡沒有人能交付工作給 %2$@。所有進來的都只是敲門。"
          }
        }
      }
    },
