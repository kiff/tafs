            "value": "Las herramientas de %2$@ de %1$@ dejan de funcionar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafi %1$@ tööriistad teenuses %2$@ lakkavad töötamast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils %2$@ de %1$@ cessent de fonctionner."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestaju raditi alati aplikacije %2$@ za: %1$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-eszközei nem működnek tovább."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ի %2$@-ի գործիքները դադարում են աշխատել։"
          }
        },
        "id": {
          "stringUnit": {
