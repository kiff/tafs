    "door.do_it.default": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفّذ ما يطلبه، ضمن الـ Card الخاصة بك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstədiyini Card-ınız daxilində edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направете това, което иска, в рамките на вашата Card."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যা চাইছে তা করুন, আপনার Card-এর মধ্যে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes el que demana, dins del teu Card."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udělej, o co žádá, v rámci své Card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu, worum es bittet, innerhalb deiner Card."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do what it asks, within your Card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz lo que pide, dentro de tu Card."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee, mida see palub, sinu Cardi piires."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais ce qu'il demande, dans ta Card."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לעשות מה שהיא מבקשת, בתוך ה-Card שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो वह माँगता है, आपके Card के भीतर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Učinite što traži, unutar vašeg Carda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd meg, amit kér, a Cardod keretein belül."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արեք այն, ինչ խնդրում է, ձեր Card-ի շրջանակներում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lakukan yang diminta, dalam Card Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai ciò che chiede, entro la tua Card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardの範囲内で、依頼されたことを行ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გააკეთეთ, რასაც ითხოვს, თქვენი Card-ის ფარგლებში."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ធ្វើអ្វីដែលវាសុំ ក្នុង Card របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 일을 Card 안에서 하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຮັດສິ່ງທີ່ມັນຂໍ, ພາຍໃນ Card ຂອງທ່ານ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlikite tai, ko prašoma, savo Card ribose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari, ko tas lūdz, savas Card ietvaros."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи го тоа што бара, во рамки на твојот Card."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Card-ынхаа хүрээнд түүний хүссэнийг хий."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आफ्नो Card भित्र यसले मागेको काम गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe wat er gevraagd wordt, binnen je Card."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób to, o co prosi, w ramach swojej Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o que pede, dentro do seu Card."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o que pede, dentro do seu Card."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți ce cere, în limitele Cardului dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Urob, o čo žiada, v rámci svojej Card."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naredi, kar prosi, znotraj svoje Card."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bëni atë që kërkon, brenda Card-it tuaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Učinite šta traži, unutar vašeg Carda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำสิ่งที่มันขอ ภายใน Card ของคุณ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Soralan zady Card-yňyzyň çäginde ediň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğini Card'ınız içinde yap."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو وہ مانگتا ہے کریں، آپ کے Card کے اندر رہ کر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm điều nó yêu cầu, trong phạm vi Card của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的 Card 範圍內，執行它要求的事。"
          }
        }
      }
    },
    "door.do_it.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذهب رسالة %1$@ مع كلماتك، كمعلومة. يتصرف %2$@ وفق ما تقوله، ضمن الـ Card الخاصة به، ولا يرد عليهم إلا إذا طلبت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tərəfindən mesaj sizin sözlərinizlə, məlumat kimi gedir. %2$@ dediyinizə görə, Card-ı daxilində hərəkət edir və siz xahiş etməsəniz, onlara geri yazmır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съобщението на %1$@ отива с вашите думи, като информация. %2$@ прави това, което казвате, в рамките на своята Card, и не им отговаря, освен ако не поискате."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-এর বার্তা আপনার কথার সঙ্গে, তথ্য হিসেবে যায়। %2$@ আপনার কথা অনুযায়ী, তার Card-এর মধ্যে কাজ করে, এবং আপনি না বললে তাদের কাছে ফেরত লেখে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El missatge de %1$@ va amb les teves paraules, com a informació. %2$@ actua segons el que tu diguis, dins del seu Card, i no els respon tret que ho demanis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpráva od %1$@ jde s vašimi slovy jako informace. %2$@ jedná podle toho, co řeknete, v rámci své Card, a neodpovídá mu, pokud o to nepožádáte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht von %1$@ geht als Information mit deinen Worten mit. %2$@ handelt nach dem, was du sagst, innerhalb seiner Card, und schreibt nicht zurück, außer du bittest darum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ message goes with your words, as information. %2$@ acts on what you say, within its Card, and doesn't write back to them unless you ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje de %1$@ va con tus palabras, como información. %2$@ actúa según lo que dices, dentro de su Card, y no le responde a menos que se lo pidas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatja %1$@ sõnum läheb koos sinu sõnadega, teabena. %2$@ tegutseb selle järgi, mida sina ütled, oma Cardi piires, ega kirjuta neile tagasi, kui sa seda ei palu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message de %1$@ accompagne vos mots, à titre d'information. %2$@ agit selon ce que vous dites, dans sa Card, et ne répond pas à cette personne sauf si vous le demandez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההודעה של %1$@ מגיעה עם המילים שלך, כמידע. %2$@ פועל לפי מה שאתה אומר, בתוך ה-Card שלו, ולא כותב להם בחזרה אלא אם תבקש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ का संदेश आपके शब्दों के साथ, जानकारी के रूप में जाता है। %2$@ आपके कहे पर अपने Card के भीतर कार्रवाई करता है, और जब तक आप न कहें उन्हें जवाब नहीं लिखता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poruka: %1$@ ide uz vaše riječi, kao informacija. Taf %2$@ djeluje prema onome što kažete, unutar svog Carda, i ne odgovara im osim ako to ne zatražite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ üzenete a szavaiddal együtt megy, információként. %2$@ azt teszi, amit mondasz, a Cardján belül, és nem ír vissza neki, hacsak nem kéred."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաղորդագրությունը՝ %1$@, գնում է ձեր բառերի հետ, որպես տեղեկություն։ %2$@-ը գործում է ըստ ձեր ասածի, իր Card-ի շրջանակներում, և նրանց հետ չի գրում, եթե չխնդրեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan %1$@ dikirim bersama kata-kata Anda, sebagai informasi. %2$@ bertindak sesuai ucapan Anda, dalam Card-nya, dan tidak membalas mereka kecuali Anda memintanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio di %1$@ accompagna le tue parole, come informazione. %2$@ agisce in base a ciò che dici, entro la sua Card, e non risponde a quella persona se non glielo chiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のメッセージは、参考情報としてあなたの言葉と一緒に渡されます。%2$@はCardの範囲内であなたの言葉に従って動き、あなたが頼まない限りその人に返信しません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეტყობინება: %1$@ მიდის თქვენს სიტყვებთან ერთად, როგორც ინფორმაცია. %2$@ მოქმედებს იმის მიხედვით, რასაც ამბობთ, თავისი Card-ის ფარგლებში, და მათ უკან არ წერს, თუ არ სთხოვთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សាររបស់ %1$@ ទៅជាមួយពាក្យរបស់អ្នក ជាព័ត៌មាន។ %2$@ ធ្វើសកម្មភាពតាមអ្វីដែលអ្នកនិយាយ ក្នុង Card របស់វា ហើយមិនឆ្លើយទៅពួកគេទេ លុះត្រាតែអ្នកសុំ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 메시지는 참고 정보로 내 말과 함께 전달됩니다. %2$@은(는) 내가 말한 대로 Card 안에서 행동하며, 내가 요청하지 않으면 그 사람에게 답장하지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຂໍ້ຄວາມຂອງ %1$@ ໄປພ້ອມຄຳເວົ້າຂອງທ່ານ, ເປັນຂໍ້ມູນ. %2$@ ເຮັດຕາມສິ່ງທີ່ທ່ານບອກ, ພາຍໃນ Card ຂອງມັນ, ແລະ ບໍ່ຂຽນກັບຫາເຂົາເຈົ້າເວັ້ນແຕ່ທ່ານຂໍ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žinutė, kurią parašė %1$@, perduodama kartu su jūsų žodžiais kaip informacija. %2$@ veikia pagal tai, ką sakote, savo Card ribose, ir neatsako siuntėjui, nebent paprašote."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziņa no %1$@ tiek pievienota taviem vārdiem kā informācija. %2$@ rīkojas pēc tā, ko tu saki, savas Card ietvaros un neatbild sūtītājam, ja vien tu to nelūdz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пораката на %1$@ оди со твоите зборови, како информација. %2$@ дејствува според она што ќе кажеш, во рамки на својот Card, и не им одговара освен ако не побараш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ийн мессеж таны үгтэй хамт мэдээлэл болон очно. %2$@ таны хэлснээр Card-ынхаа хүрээнд үйлдэл хийх бөгөөд та хүсэхгүй бол тэдэнд хариулахгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को सन्देश तपाईंका शब्दसँगै जानकारीका रूपमा जान्छ। %2$@ ले तपाईंले भनेअनुसार आफ्नो Card भित्र काम गर्छ, र तपाईंले नभनेसम्म उनीहरूलाई जवाफ दिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bericht van %1$@ gaat als informatie mee met jouw woorden. %2$@ doet wat jij zegt, binnen zijn Card, en schrijft niet terug tenzij je erom vraagt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomość od %1$@ trafia razem z Twoimi słowami, jako informacja. %2$@ działa według tego, co mówisz, w ramach swojej Card, i nie odpisuje tej osobie, chyba że o to poprosisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem de %1$@ segue com as suas palavras, como informação. %2$@ age de acordo com o que diz, dentro do seu Card, e não responde a essa pessoa a menos que o peça."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem de %1$@ segue com as suas palavras, como informação. %2$@ age de acordo com o que diz, dentro do seu Card, e não responde a essa pessoa a menos que o peça."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajul de la %1$@ pleacă împreună cu cuvintele dvs., ca informație. %2$@ face ce spuneți, în limitele Cardului său, și nu le răspunde decât dacă cereți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Správa od %1$@ ide s vašimi slovami ako informácia. %2$@ koná podľa toho, čo poviete, v rámci svojej Card, a neodpovedá mu, ak o to nepožiadate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sporočilo od %1$@ gre z vašimi besedami kot informacija. %2$@ ukrepa po tem, kar rečete, znotraj svoje Card, in mu ne odgovori, razen če to zahtevate."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesazhi i: %1$@ shkon me fjalët tuaja, si informacion. %2$@ vepron sipas asaj që thoni, brenda Card-it të tij, dhe nuk u shkruan prapë atyre nëse nuk e kërkoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Poruka: %1$@ ide uz vaše reči, kao informacija. Taf %2$@ deluje prema onome šta kažete, unutar svog Carda, i ne odgovara im osim ako to ne zatražite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความของ %1$@ ไปพร้อมถ้อยคำของคุณ เป็นข้อมูล %2$@ ลงมือตามที่คุณบอก ภายใน Card ของมัน และไม่เขียนกลับถึงพวกเขาเว้นแต่คุณขอ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ habary siziň sözleriňiz bilen, maglumat hökmünde gidýär. %2$@ siziň aýdanyňyza Card-yň çäginde hereket edýär, we siz soramasaňyz olara jogap ýazmaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kişisinin mesajı bilgi olarak sizin sözlerinizle gider. %2$@, söylediğinize göre Card'ı içinde hareket eder ve siz istemedikçe onlara yanıt yazmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کا پیغام آپ کے الفاظ کے ساتھ، بطور معلومات جاتا ہے۔ %2$@ آپ کی بات پر اپنے Card کے اندر عمل کرتا ہے، اور جب تک آپ نہ کہیں انہیں جواب نہیں لکھتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn của %1$@ đi kèm lời của bạn, như thông tin. %2$@ hành động theo điều bạn nói, trong phạm vi Card của nó, và không viết lại cho họ trừ khi bạn yêu cầu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@的訊息會連同您的話一起作為資訊。%2$@ 依您所說的在它的 Card 範圍內行動，除非您要求，否則不會回信給對方。"
          }
        }
      }
    },
