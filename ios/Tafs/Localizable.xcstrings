    "kiff.kiff_can_not_do_sign": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع KIFF فعل ذلك بعد: سجّل الدخول مرة أخرى من الإعدادات لتتمكن من الموافقة من هذا الجهاز (%1$@)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF bunu hələ edə bilmir: bu cihazdan (%1$@) təsdiq etmək üçün Parametrlərdən yenidən daxil olun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF още не може да направи това: влезте отново от Настройки, за да одобрявате от този %1$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF এখনও এটি করতে পারে না: এই %1$@ থেকে অনুমোদন করতে সেটিংস থেকে আবার সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF encara no ho pot fer: torna a iniciar la sessió des dels Ajustos per aprovar des d'aquest dispositiu (%1$@)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF to zatím neumí: přihlaste se znovu v Nastavení, abyste mohli schvalovat z tohoto zařízení (%1$@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kann das noch nicht: Melde dich in den Einstellungen erneut an, um auf diesem %1$@ zu genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF can't do this yet: sign in again from Settings to approve from this %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF aún no puede hacer esto: vuelve a iniciar sesión desde Ajustes para aprobar desde este %1$@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei saa seda veel teha: logi seadetes uuesti sisse, et see %1$@ saaks kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ne peut pas encore le faire : reconnectez-vous depuis Réglages pour approuver depuis %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF עדיין לא יכול לעשות את זה: יש להיכנס שוב מההגדרות כדי לאשר מההתקן הזה (%1$@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF अभी यह नहीं कर सकता: इस %1$@ से मंज़ूर करने के लिए सेटिंग से फिर साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF to još ne može: prijavite se ponovno u Postavkama da biste odobravali s ovog uređaja (%1$@)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF ezt még nem tudja: jelentkezz be újra a Beállításokban, hogy erről az eszközről (%1$@) jóváhagyhass."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը դեռ չի կարող դա անել․ նորից մուտք գործեք Կարգավորումներից՝ այս սարքից (%1$@) հաստատելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF belum bisa melakukannya: masuk lagi dari Pengaturan untuk menyetujui dari %1$@ ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non può ancora farlo: accedi di nuovo da Impostazioni per approvare da questo %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFはまだこれを実行できません。この%1$@から承認するには、設定からもう一度サインインしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ს ეს ჯერ არ შეუძლია: კვლავ შედით პარამეტრებიდან, რომ ამ მოწყობილობიდან (%1$@) დაამტკიცოთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF មិនទាន់អាចធ្វើរឿងនេះបានទេ៖ ចូលម្តងទៀតពីការកំណត់ ដើម្បីអនុម័តពី %1$@ នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 아직 이 작업을 할 수 없습니다. 이 %1$@에서 승인하려면 설정에서 다시 로그인하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ຍັງເຮັດສິ່ງນີ້ບໍ່ໄດ້: ເຂົ້າສູ່ລະບົບອີກຈາກການຕັ້ງຄ່າ ເພື່ອອະນຸມັດຈາກ %1$@ ນີ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF to dar negali: dar kartą prisijunkite skiltyje „Nustatymai“, kad galėtumėte tvirtinti šiame įrenginyje (%1$@)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF to vēl nevar izdarīt: vēlreiz pieraksties no iestatījumiem, lai apstiprinātu no šīs ierīces (%1$@)."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF сè уште не може ова: најави се повторно од Поставки за да одобруваш од овој %1$@."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF үүнийг одоохондоо хийж чадахгүй: энэ %1$@-ээс зөвшөөрөхийн тулд Тохиргооноос дахин нэвтэрнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ले अहिले यो गर्न सक्दैन: यो %1$@ बाट स्वीकृत गर्न सेटिङबाट फेरि साइन इन गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kan dit nog niet: log opnieuw in via Instellingen om vanaf deze %1$@ goed te keuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF jeszcze tego nie umie: zaloguj się ponownie w Ustawieniach, aby zatwierdzać z tego urządzenia (%1$@)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF ainda não pode fazer isto: inicie sessão novamente nas Definições para aprovar a partir deste %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF ainda não pode fazer isto: entre novamente em Conta para aprovar a partir deste %1$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nu poate face asta încă: conectați-vă din nou din Setări pentru a aproba de pe acest dispozitiv (%1$@)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF to zatiaľ nevie: prihláste sa znova v Nastaveniach, aby ste mohli schvaľovať z tohto zariadenia (%1$@)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF tega še ne zmore: znova se prijavite v Nastavitvah, da boste lahko odobravali s te naprave (%1$@)."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nuk e bën dot këtë ende: hyni sërish nga Cilësimet për të miratuar nga kjo pajisje (%1$@)."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF to još ne može: prijavite se ponovo u Podešavanjima da biste odobravali s ovog uređaja (%1$@)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ยังทำสิ่งนี้ไม่ได้: เข้าสู่ระบบอีกครั้งจากการตั้งค่าเพื่ออนุมัติจาก%1$@เครื่องนี้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF muny heniz edip bilmeýär: bu %1$@-den tassyklamak üçin Sazlamalardan täzeden giriň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF bunu henüz yapamıyor: bu cihazdan (%1$@) onaylamak için Ayarlar'dan oturumu yeniden açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ابھی یہ نہیں کر سکتا: اس %1$@ سے منظور کرنے کے لیے سیٹنگز سے دوبارہ سائن اِن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF chưa làm được việc này: hãy đăng nhập lại từ Cài đặt để phê duyệt từ %1$@ này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF 目前還無法執行此操作：請從「設定」重新登入，以便在這部%1$@上核准。"
          }
        }
      }
    },
