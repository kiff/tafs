    "door.key.foot": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Eine Nachricht gilt nur dann als ihre, wenn das zutrifft; alle anderen klopfen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. A message counts as theirs only when that holds; anyone else knocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un mensaje cuenta como suyo solo cuando eso se cumple; los de cualquier otra persona llegan como llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un message n'est considéré comme le sien que si c'est le cas ; toute autre personne fait une demande d'accès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Un messaggio conta come suo solo se questo è vero; per chiunque altro è una bussata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Een bericht telt alleen als het hunne als dat zo is; ieder ander klopt aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Wiadomość liczy się jako ich tylko wtedy, gdy to się zgadza; każdy inny puka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Uma mensagem só conta como dessa pessoa quando isso se verifica; qualquer outra pessoa faz um pedido de contacto."
          }
        }
      }
    },
    "door.key.no_one_paired": {
      "extractionState": "manual",
      "localizations": {
