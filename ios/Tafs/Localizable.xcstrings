    "people.everyone_in": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabdakı hər kəs buradadır. İnsanları KIFF panelindən dəvət edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички в акаунта са тук. Каните хора от таблото на KIFF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsou tu všichni z účtu. Lidi zvěte z nástěnky KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle im Konto sind hier. Lade Personen über das KIFF-Dashboard ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone on the account is here. Invite people from the KIFF dashboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las personas de la cuenta están aquí. Invita a gente desde el panel de KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik konto inimesed on siin. Kutsu inimesi KIFFi juhtpaneelilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde sur le compte est ici. Invitez des personnes depuis le tableau de bord KIFF."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi s računa su ovdje. Pozovite ljude s KIFF nadzorne ploče."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiók minden tagja itt van. Embereket a KIFF irányítópultjáról hívhatsz meg."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվի բոլորը այստեղ են։ Հրավիրեք մարդկանց KIFF-ի վահանակից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua orang di akun ada di sini. Undang orang dari dasbor KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti nell'account sono qui. Invita persone dalla dashboard di KIFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの全員がここにいます。メンバーはKIFFのダッシュボードから招待してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ანგარიშის ყველა აქ არის. მოიწვიეთ ადამიანები KIFF-ის პანელიდან."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정의 모든 사람이 여기에 있습니다. KIFF 대시보드에서 사람을 초대하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visi paskyros nariai jau čia. Pakvieskite žmones iš KIFF valdymo skydelio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šeit ir visi konta cilvēki. Uzaicini cilvēkus no KIFF paneļa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen in het account staat hier. Nodig mensen uit via het KIFF-dashboard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszyscy na koncie są tutaj. Zapraszaj osoby z panelu KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as pessoas da conta estão aqui. Convide pessoas a partir do painel do KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as pessoas da conta estão aqui. Convide pessoas a partir do painel do KIFF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toată lumea din cont este aici. Invitați persoane din panoul KIFF."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sú tu všetci z účtu. Ľudí pozývajte z nástenky KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu so vsi v računu. Ljudi povabite z nadzorne plošče KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Të gjithë në llogari janë këtu. Ftoni njerëz nga paneli i KIFF."
