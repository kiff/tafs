        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อรอการอนุมัติ เครดิตของคุณจะถูกเพิ่มเมื่อเสร็จสิ้น"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Satyn alma tassyklama garaşýar. Ol gutarandan soň kreditleriňiz goşulýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma onay bekliyor. Tamamlanır tamamlanmaz kredileriniz eklenir."
