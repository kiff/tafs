          }
        }
      }
    },
    "connect.disconnect.rest": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere tafs, die %1$@ nutzen, behalten ihren Zugriff. Nutzt kein anderer taf dasselbe Konto dort, wird die Anmeldung bei %1$@ widerrufen; sonst, wenn der letzte entfernt wird. Wenn du %1$@ wieder nutzt, wirst du gebeten, erneut zu genehmigen und dich erneut anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other tafs that use %1$@ keep their access. If no other taf uses the same account there, the sign-in is revoked at %1$@; otherwise, when the last one is removed. Using %1$@ again asks you to approve and sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los demás tafs que usan %1$@ conservan su acceso. Si ningún otro taf usa la misma cuenta, el inicio de sesión se revoca en %1$@; si no, cuando se quita el último. Usar %1$@ de nuevo te pide aprobar e iniciar sesión otra vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teised tafid, mis kasutavad teenust %1$@, säilitavad oma juurdepääsu. Kui ükski teine taf ei kasuta seal sama kontot, tühistatakse sisselogimine teenuses %1$@; vastasel juhul siis, kui viimane neist eemaldatakse. Teenuse %1$@ uuesti kasutamisel pead uuesti kinnitama ja sisse logima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres tafs qui utilisent %1$@ gardent leur accès. Si aucun autre taf n'utilise le même compte, l'identifiant est révoqué chez %1$@ ; sinon, quand le dernier est retiré. Utiliser %1$@ à nouveau vous demande d'approuver et de vous reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri taf che usano %1$@ mantengono il loro accesso. Se nessun altro taf usa lo stesso account, il login viene revocato presso %1$@; altrimenti, quando viene rimosso l'ultimo. Usare di nuovo %1$@ ti chiede di approvare e accedere di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を使う他のtafはアクセスを保持します。同じアカウントを使う他のtafがなければ、%1$@でサインインが取り消されます。あれば、最後のtafを外したときに取り消されます。再び%1$@を使うには、もう一度承認とサインインが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 쓰는 다른 tafs는 접근 권한을 유지합니다. 같은 계정을 쓰는 다른 taf가 없으면 %1$@에서 로그인이 취소되고, 있으면 마지막 taf를 제거할 때 취소됩니다. %1$@을(를) 다시 쓰려면 다시 승인하고 로그인해야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiti %1$@ naudojantys taf išlaiko savo prieigą. Jei joks kitas taf nenaudoja tos pačios paskyros ten, prisijungimas atšaukiamas %1$@ pusėje; kitu atveju – kai pašalinamas paskutinis. Norint vėl naudoti %1$@, reikės dar kartą patvirtinti ir prisijungti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Citi taf, kas izmanto %1$@, patur savu piekļuvi. Ja neviens cits taf tur neizmanto to pašu kontu, pierakstīšanās %1$@ tiek atsaukta; citādi – kad tiek noņemts pēdējais. Lai atkal izmantotu %1$@, tev būs vēlreiz jāapstiprina un jāpierakstās."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere tafs die %1$@ gebruiken, houden hun toegang. Als geen andere taf hetzelfde account gebruikt, wordt de aanmelding bij %1$@ ingetrokken; anders pas als de laatste wordt verwijderd. Als je %1$@ weer gebruikt, word je gevraagd opnieuw goed te keuren en je aan te melden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne tafy, które używają %1$@, zachowują dostęp. Jeśli żaden inny taf nie używa tego samego konta, logowanie zostanie cofnięte w %1$@; w przeciwnym razie, gdy usuniesz ostatni. Ponowne użycie %1$@ poprosi Cię o zatwierdzenie i ponowne zalogowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros tafs que usam %1$@ mantêm o seu acesso. Se nenhum outro taf usar a mesma conta, o início de sessão é revogado em %1$@; caso contrário, quando o último for removido. Usar %1$@ novamente pede-lhe que aprove e inicie sessão de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros tafs que usam %1$@ mantêm o acesso deles. Se nenhum outro taf usar a mesma conta, o login é revogado em %1$@; caso contrário, quando o último for removido. Usar %1$@ novamente pede que você aprove e faça login de novo."
          }
        }
      }
    },
    "connect.disconnect.rest_key": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere tafs, die %1$@ nutzen, behalten ihren Zugriff. Der Schlüssel wird aus tafs gelöscht, sobald ihn kein taf mehr nutzt. Wenn du %1$@ wieder nutzt, wirst du gebeten, erneut zu genehmigen und einen Schlüssel einzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other tafs that use %1$@ keep their access. The key is deleted from tafs once no taf uses it. Using %1$@ again asks you to approve and paste a key again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los demás tafs que usan %1$@ conservan su acceso. La clave se elimina de tafs cuando ya ningún taf la use. Usar %1$@ de nuevo te pide aprobar y pegar una clave otra vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teised tafid, mis kasutavad teenust %1$@, säilitavad oma juurdepääsu. Võti kustutatakse tafsist, kui ükski taf seda enam ei kasuta. Teenuse %1$@ uuesti kasutamisel pead uuesti kinnitama ja võtme uuesti kleepima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres tafs qui utilisent %1$@ gardent leur accès. La clé est supprimée de tafs dès qu'aucun taf ne l'utilise. Utiliser %1$@ à nouveau vous demande d'approuver et de coller une clé à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri taf che usano %1$@ mantengono il loro accesso. La chiave viene eliminata da tafs quando nessun taf la usa più. Usare di nuovo %1$@ ti chiede di approvare e incollare di nuovo una chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を使う他のtafはアクセスを保持します。キーは、使うtafがなくなるとtafsから削除されます。再び%1$@を使うには、もう一度承認とキーの貼り付けが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 쓰는 다른 tafs는 접근 권한을 유지합니다. 키를 쓰는 taf가 없으면 tafs에서 키가 삭제됩니다. %1$@을(를) 다시 쓰려면 다시 승인하고 키를 붙여 넣어야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiti %1$@ naudojantys taf išlaiko savo prieigą. Raktas ištrinamas iš tafs, kai jo nebenaudoja nė vienas taf. Norint vėl naudoti %1$@, reikės dar kartą patvirtinti ir įklijuoti raktą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Citi taf, kas izmanto %1$@, patur savu piekļuvi. Atslēga tiek dzēsta no tafs, kad to vairs neizmanto neviens taf. Lai atkal izmantotu %1$@, tev būs vēlreiz jāapstiprina un jāielīmē atslēga."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere tafs die %1$@ gebruiken, houden hun toegang. De sleutel wordt uit tafs verwijderd zodra geen enkel taf hem nog gebruikt. Als je %1$@ weer gebruikt, word je gevraagd opnieuw goed te keuren en een sleutel te plakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne tafy, które używają %1$@, zachowują dostęp. Klucz zostanie usunięty z tafs, gdy żaden taf nie będzie go już używał. Ponowne użycie %1$@ poprosi Cię o zatwierdzenie i ponowne wklejenie klucza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros tafs que usam %1$@ mantêm o seu acesso. A chave é eliminada do tafs assim que nenhum taf a usar. Usar %1$@ novamente pede-lhe que aprove e cole uma chave de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros tafs que usam %1$@ mantêm o acesso deles. A chave é excluída do tafs assim que nenhum taf a usar. Usar %1$@ novamente pede que você aprove e cole uma chave de novo."
          }
        }
      }
    },
