        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხელახლა დამტკიცება ვერ მოხერხდა. სცადეთ ხელახლა, ან კვლავ შედით პარამეტრებში."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការអនុម័តម្តងទៀតមិនដំណើរការទេ។ សូមព្យាយាមម្តងទៀត ឬចូលម្តងទៀតក្នុងការកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 승인하지 못했습니다. 다시 시도하거나, 설정에서 다시 로그인하세요."
