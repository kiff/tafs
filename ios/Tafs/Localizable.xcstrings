    "door.start_connected_tools_first_slack": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne zuerst unter „Verbundene Apps“ auf diesem %1$@. Das Slack-Abonnement muss beendet werden, bevor seine Tür entfernt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start from Connected apps on this %1$@ first. Slack's subscription must be stopped before removing its door."
