    "settings.devices.signout_needs_approver": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتسجيل خروج جهاز آخر، استخدم جهازًا يستطيع الموافقة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqa cihazı çıxış etdirmək üçün təsdiq edə bilən cihazdan istifadə edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да изведете друго устройство, използвайте устройство, което може да одобрява."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য ডিভাইস সাইন আউট করাতে এমন একটি ডিভাইস ব্যবহার করুন যা অনুমোদন করতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tancar la sessió d'un altre dispositiu, utilitza un dispositiu que pugui aprovar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li odhlásit jiné zařízení, použijte zařízení, které může schvalovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ein anderes Gerät abzumelden, nutze ein Gerät, das genehmigen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To sign another device out, use a device that can approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cerrar la sesión de otro dispositivo, usa un dispositivo que pueda aprobar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teise seadme väljalogimiseks kasuta seadet, mis saab kinnitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour déconnecter un autre appareil, utilisez un appareil qui peut approuver."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להוציא התקן אחר מהחשבון, יש להשתמש בהתקן שיכול לאשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे डिवाइस को साइन आउट करने के लिए ऐसा डिवाइस उपयोग करें जो मंज़ूर कर सकता हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da odjavite drugi uređaj, upotrijebite uređaj koji može odobravati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy másik eszköz kijelentkeztetéséhez használj jóváhagyásra képes eszközt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեկ այլ սարք դուրս բերելու համար օգտագործեք սարք, որը կարող է հաստատել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengeluarkan perangkat lain, gunakan perangkat yang dapat menyetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per disconnettere un altro dispositivo, usa un dispositivo che può approvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスをサインアウトするには、承認できるデバイスを使ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვა მოწყობილობის გამოსაყვანად გამოიყენეთ მოწყობილობა, რომელსაც დამტკიცება შეუძლია."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដើម្បីចាកចេញពីឧបករណ៍ផ្សេង សូមប្រើឧបករណ៍ដែលអាចអនុម័តបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기를 로그아웃하려면 승인할 수 있는 기기를 사용하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພື່ອໃຫ້ອຸປະກອນອື່ນອອກຈາກລະບົບ ໃຫ້ໃຊ້ອຸປະກອນທີ່ອະນຸມັດໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdami atjungti kitą įrenginį, naudokite įrenginį, kuris gali tvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai izrakstītu citu ierīci, izmanto ierīci, kas var apstiprināt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "За да одјавиш друг уред, користи уред што може да одобрува."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өөр төхөөрөмжийг гаргахын тулд зөвшөөрч чадах төхөөрөмж ашиглана уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अर्को उपकरण साइन आउट गर्न स्वीकृत गर्न सक्ने उपकरण प्रयोग गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een apparaat dat kan goedkeuren om een ander apparaat uit te loggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wylogować inne urządzenie, użyj urządzenia, które może zatwierdzać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para terminar a sessão de outro dispositivo, use um dispositivo que possa aprovar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para terminar a sessão de outro dispositivo, use um dispositivo que possa aprovar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a deconecta alt dispozitiv, folosiți un dispozitiv care poate aproba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete odhlásiť iné zariadenie, použite zariadenie, ktoré môže schvaľovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za odjavo druge naprave uporabite napravo, ki lahko odobrava."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Për të nxjerrë një pajisje tjetër, përdorni një pajisje që mund të miratojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Da odjavite drugi uređaj, upotrebite uređaj koji može odobravati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการออกจากระบบอุปกรณ์อื่น ให้ใช้อุปกรณ์ที่อนุมัติได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Başga enjamy çykarmak üçin tassyklap biljek enjamy ulanyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cihazın oturumunu kapatmak için onay verebilen bir cihaz kullanın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی اور ڈیوائس کو سائن آؤٹ کرنے کے لیے ایسی ڈیوائس استعمال کریں جو منظور کر سکتی ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đăng xuất một thiết bị khác, hãy dùng một thiết bị có thể phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要登出另一部裝置，請使用可以核准的裝置。"
          }
        }
      }
    },
