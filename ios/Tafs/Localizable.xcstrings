          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnosť kódu na vašom počítači vypršala. Zobrazte nový a naskenujte ho znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda na vašem računalniku je potekla. Prikažite novo in jo znova skenirajte."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodi në kompjuterin tuaj skadoi. Shfaqni një të ri dhe skanojeni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôd na vašem računaru je istekao. Prikažite novi i skenirajte ga ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสบนคอมพิวเตอร์ของคุณหมดอายุ แสดงรหัสใหม่แล้วสแกนอีกครั้ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompýuteriňizdäki koduň möhleti gutardy. Täzesini görkeziň we täzeden skanirläň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınızdaki kodun süresi doldu. Yeni bir kod gösterip tekrar tarayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کمپیوٹر پر کوڈ کی مدت ختم ہو گئی۔ نیا دکھائیں اور دوبارہ اسکین کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã trên máy tính của bạn đã hết hạn. Hãy hiện mã mới và quét lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您電腦上的代碼已過期。請顯示新的代碼並再次掃描。"
          }
        }
      }
    },
    "settings.devices.pair_gives_enclave": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتمكن %1$@ من الموافقة على إجراءات tafs لديك بـ Touch ID."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ taf-larınızın əməliyyatlarını Touch ID ilə təsdiq edə biləcək."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ще може да одобрява действията на вашите tafs с Touch ID."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Touch ID দিয়ে আপনার taf-এর কাজ অনুমোদন করতে পারবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ podrà aprovar les accions dels teus taf amb Touch ID."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bude moci schvalovat akce vašich tafů přes Touch ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kann dann die Aktionen deiner tafs mit Touch ID genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will be able to approve your tafs' actions with Touch ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ podrá aprobar las acciones de tus tafs con Touch ID."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ saab sinu tafide toiminguid kinnitada Touch ID abil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pourra approuver les actions de vos tafs avec Touch ID."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ יוכל לאשר את הפעולות של ה-taf שלך באמצעות Touch ID."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Touch ID से आपके taf की कार्रवाइयाँ मंज़ूर कर सकेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređaj %1$@ moći će odobravati radnje vaših tafova uz Touch ID."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Touch ID-vel jóváhagyhatja majd a tafjaid műveleteit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը կկարողանա հաստատել ձեր taf-երի գործողությունները Touch ID-ով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ akan dapat menyetujui tindakan tafs Anda dengan Touch ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ potrà approvare le azioni dei tuoi tafs con Touch ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@でTouch IDを使ってtafsの操作を承認できるようになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ შეძლებს თქვენი taf-ების მოქმედებების დამტკიცებას Touch ID-ით."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ នឹងអាចអនុម័តសកម្មភាពរបស់ taf របស់អ្នកដោយ Touch ID។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 Touch ID로 tafs의 행동을 승인할 수 있게 됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ຈະອະນຸມັດການກະທຳຂອງ taf ທ່ານດ້ວຍ Touch ID ໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ galės tvirtinti jūsų taf veiksmus su Touch ID."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ varēs apstiprināt tavu taf darbības ar Touch ID."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ќе може да ги одобрува дејствата на твоите tafови со Touch ID."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ таны taf-уудын үйлдлийг Touch ID-аар зөвшөөрч чадна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ले Touch ID बाट तपाईंका taf का कार्य स्वीकृत गर्न सक्नेछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kan dan de acties van je tafs goedkeuren met Touch ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ będzie mógł zatwierdzać działania Twoich tafs za pomocą Touch ID."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ poderá aprovar as ações dos seus tafs com Touch ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ poderá aprovar as ações dos seus tafs com Touch ID."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ va putea aproba acțiunile tafurilor dvs. cu Touch ID."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bude môcť schvaľovať akcie vašich tafov cez Touch ID."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bo lahko odobraval dejanja vaših tafov s Touch ID."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ do të mund të miratojë veprimet e tafs-eve tuaj me Touch ID."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređaj %1$@ moći će odobravati radnje vaših tafova uz Touch ID."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จะสามารถอนุมัติการกระทำของ taf ของคุณด้วย Touch ID"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs-laryňyzyň hereketlerini Touch ID bilen tassyklap biler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, tafs'larınızın eylemlerini Touch ID ile onaylayabilecek."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Touch ID سے آپ کے tafs کے اعمال منظور کر سکے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sẽ có thể phê duyệt các hành động của taf bằng Touch ID."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@將能以 Touch ID 核准您的 taf 的動作。"
          }
        }
      }
    },
