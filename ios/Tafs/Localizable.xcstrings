    "settings.devices.pair_invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت على KIFF قراءة ذلك الرمز. اعرض رمزًا جديدًا على كمبيوترك وامسحه مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF bu kodu oxuya bilmədi. Kompüterinizdə yenisini göstərin və yenidən skan edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF не можа да прочете този код. Покажете нов на компютъра си и го сканирайте отново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF সেই কোড পড়তে পারেনি। আপনার কম্পিউটারে নতুন একটি দেখান এবং আবার স্ক্যান করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no ha pogut llegir aquest codi. Mostra'n un de nou al teu ordinador i torna a escanejar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ten kód nepřečetl. Zobrazte na počítači nový a naskenujte ho znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF konnte diesen Code nicht lesen. Lass einen neuen auf deinem Computer anzeigen und scanne ihn erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF couldn't read that code. Show a new one on your computer and scan it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no pudo leer ese código. Muestra uno nuevo en tu ordenador y escanéalo otra vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei saanud seda koodi lugeda. Näita arvutis uut ja skanni see uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas pu lire ce code. Affichez-en un nouveau sur votre ordinateur et scannez-le à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF לא הצליח לקרוא את הקוד הזה. יש להציג חדש במחשב ולסרוק שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF वह कोड पढ़ नहीं सका। अपने कंप्यूटर पर नया दिखाएँ और फिर स्कैन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nije mogao pročitati taj kôd. Prikažite novi na računalu i skenirajte ga ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF nem tudta beolvasni ezt a kódot. Jeleníts meg egy újat a számítógépeden, és olvasd be újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը չկարողացավ կարդալ այդ կոդը։ Ցույց տվեք նորը ձեր համակարգչում և նորից սկանավորեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF tidak dapat membaca kode itu. Tampilkan kode baru di komputer Anda lalu pindai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non è riuscito a leggere quel codice. Mostrane uno nuovo sul tuo computer e scansionalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFがそのコードを読み取れませんでした。コンピュータに新しいコードを表示して、もう一度スキャンしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-მა ის კოდი ვერ წაიკითხა. აჩვენეთ ახალი თქვენს კომპიუტერზე და ხელახლა დაასკანერეთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF មិនអាចអានលេខកូដនោះបានទេ។ បង្ហាញលេខកូដថ្មីនៅលើកុំព្យូទ័ររបស់អ្នក រួចស្កែនម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 그 코드를 읽지 못했습니다. 컴퓨터에 새 코드를 표시하고 다시 스캔하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ອ່ານລະຫັດນັ້ນບໍ່ໄດ້. ສະແດງອັນໃໝ່ໃນຄອມພິວເຕີຂອງທ່ານ ແລ້ວສະແກນອີກ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nepavyko nuskaityti to kodo. Parodykite naują kompiuteryje ir nuskaitykite jį dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nevarēja nolasīt šo kodu. Parādi jaunu savā datorā un skenē to vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF не можеше да го прочита тој код. Прикажи нов на твојот компјутер и скенирај го повторно."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF тэр кодыг уншиж чадсангүй. Компьютер дээрээ шинийг харуулаад дахин скан хийнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ले त्यो कोड पढ्न सकेन। आफ्नो कम्प्युटरमा नयाँ देखाएर फेरि स्क्यान गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kon die code niet lezen. Toon een nieuwe op je computer en scan die opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie odczytał tego kodu. Wyświetl nowy na komputerze i zeskanuj go ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não conseguiu ler esse código. Mostre um novo no seu computador e leia-o outra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não conseguiu ler esse código. Mostre um novo no seu computador e leia-o outra vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nu a putut citi acel cod. Afișați unul nou pe computer și scanați-l din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ten kód neprečítal. Zobrazte na počítači nový a naskenujte ho znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF te kode ni mogel prebrati. Na računalniku prikažite novo in jo znova skenirajte."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nuk e lexoi dot atë kod. Shfaqni një të ri në kompjuterin tuaj dhe skanojeni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nije mogao pročitati taj kôd. Prikažite novi na računaru i skenirajte ga ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF อ่านรหัสนั้นไม่ได้ แสดงรหัสใหม่บนคอมพิวเตอร์ของคุณแล้วสแกนอีกครั้ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ol kody okap bilmedi. Kompýuteriňizde täzesini görkeziň we täzeden skanirläň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF o kodu okuyamadı. Bilgisayarınızda yeni bir kod gösterip tekrar tarayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF وہ کوڈ پڑھ نہیں سکا۔ اپنے کمپیوٹر پر نیا دکھائیں اور دوبارہ اسکین کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF không đọc được mã đó. Hãy hiện mã mới trên máy tính của bạn và quét lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
