      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und gesendet, aber die Antwort der App ging verloren: Prüfe die eigenen Aufzeichnungen der App"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, and sent, but the app's answer was lost: check the app's own records"
