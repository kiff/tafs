        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тохиргоонд tafs-д мэдэгдэл зөвшөөрч, дахин оролдоно уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिङमा tafs का लागि सूचना अनुमति दिनुहोस्, त्यसपछि फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta meldingen voor tafs toe in Instellingen en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól tafs na powiadomienia w Ustawieniach, a potem spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita as notificações do tafs nas Definições e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita as notificações do tafs nas Configurações e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți notificările pentru tafs în Configurări, apoi încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte upozornenia pre tafs v Nastaveniach a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V Nastavitvah dovolite obvestila za tafs in poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejoni njoftimet për tafs te Cilësimet, pastaj provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite obaveštenja za tafs u Podešavanjima, pa pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการแจ้งเตือนสำหรับ tafs ในการตั้งค่า แล้วลองอีกครั้ง"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sazlamalarda tafs üçin habarnamalara rugsat beriň, soňra täzeden synanyşyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'dan tafs için bildirimlere izin verin, sonra tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیٹنگز میں tafs کے لیے اطلاعات کی اجازت دیں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép thông báo cho tafs trong Cài đặt, rồi thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許 tafs 傳送通知，然後再試一次。"
