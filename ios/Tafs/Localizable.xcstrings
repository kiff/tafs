    "sample.reply.paused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف مؤقتًا. لا يخرج شيء آخر حتى تطلب مني المتابعة."
          }
        },
        "az": {
          "stringUnit": {
