    "voice.microphone_off_tafs_turn_settings": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon tafs üçün söndürülüb. Onu Parametrlər › tafs › Mikrofon bölməsində aktiv edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофонът е изключен за tafs. Включете го в Настройки › tafs › Микрофон."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon je pro tafs vypnutý. Zapněte ho v Nastavení › tafs › Mikrofon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist für tafs ausgeschaltet. Schalte es unter Einstellungen › tafs › Mikrofon ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is off for tafs. Turn it on in Settings › tafs › Microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono está desactivado para tafs. Actívalo en Ajustes › tafs › Micrófono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon on tafsi jaoks välja lülitatud. Lülita see sisse menüüs Settings › tafs › Microphone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro est désactivé pour tafs. Activez-le dans Réglages › tafs › Micro."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon je isključen za tafs. Uključite ga u Postavke › tafs › Mikrofon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofon ki van kapcsolva a tafs számára. Kapcsold be itt: Beállítások › tafs › Mikrofon."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խոսափողը անջատված է tafs-ի համար։ Միացրեք՝ Կարգավորումներ › tafs › Խոսափող։"
