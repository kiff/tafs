        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv (%1$@) nu are cod de acces, iar %2$@ are nevoie de unul. Setați un cod de acces în %3$@, adăugați %4$@, apoi reveniți."
