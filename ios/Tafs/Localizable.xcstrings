    "settings.alerts_off.turn_on": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv edin"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включване"
          }
        },
