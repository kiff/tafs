    "sample.reply.looking_lately": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ich mir ansehe, was ich in letzter Zeit getan habe, "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking at what I did lately, "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viendo lo que hice últimamente, "
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaadates, mida ma viimasel ajal tegin: "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En regardant ce que j'ai fait dernièrement, "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardando cosa ho fatto ultimamente, "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の作業を見ると、"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근에 한 일을 보면, "
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žvelgiant į tai, ką padariau pastaruoju metu, "
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skatoties uz to, ko pēdējā laikā izdarīju, "
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als ik kijk naar wat ik recent heb gedaan, "
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrząc na to, co ostatnio zrobiłem, "
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olhando para o que fiz recentemente, "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olhando para o que fiz recentemente, "
          }
        }
      }
    },
    "sample.reply.more_room": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann mir selbst keinen weiteren Spielraum geben: Nur du kannst das, indem du meine Card änderst. Alles darüber wartet unter „Braucht dich“ auf dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't give myself more room: only you can, by changing my Card. Anything over it waits for you in Needs you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedo darme más margen: solo tú puedes, cambiando mi Card. Todo lo que lo supere te espera en Te necesita."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma ei saa endale rohkem ruumi anda: seda saad teha ainult sina, muutes minu Cardi. Kõik, mis seda ületab, ootab sind vaates Vajab sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne peux pas me donner plus de marge : vous seul le pouvez, en modifiant ma Card. Tout ce qui la dépasse vous attend dans Vous attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non posso darmi più margine: puoi farlo solo tu, modificando la mia Card. Tutto ciò che la supera ti aspetta in Ti aspetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で範囲を広げることはできません。広げられるのは、Cardを変更するあなただけです。範囲を超えることは要確認で待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저 스스로 범위를 넓힐 수는 없습니다. 직접 Card를 바꾸셔야만 넓힐 수 있습니다. 범위를 넘는 일은 확인 필요에서 기다립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Negaliu sau suteikti daugiau rezervo: tai galite tik jūs, pakeisdami mano Card. Viskas, kas viršija jos ribas, laukia jūsų skiltyje „Laukia jūsų“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Es nevaru sev dot vairāk rezerves: to vari tikai tu, mainot manu Card. Viss, kas to pārsniedz, gaida tevi sadaļā “Gaida tevi”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kan mezelf geen extra ruimte geven: alleen jij kunt dat, door mijn Card te wijzigen. Alles daarboven wacht op je in Wacht op jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogę dać sobie więcej zapasu: możesz to zrobić tylko Ty, zmieniając moją Card. Wszystko ponad nią czeka na Ciebie w sekcji Czeka na Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não posso dar-me mais margem: só você pode, alterando o meu Card. Tudo o que o exceda aguarda por si em Precisa de si."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não posso me dar mais margem: só você pode, alterando o meu Card. Tudo o que passar dele aguarda por você em Precisa de você."
          }
        }
      }
    },
    "sample.reply.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
