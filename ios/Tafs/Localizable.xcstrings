    "record.answer_lost": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ və göndərildi, amma tətbiqin cavabı itdi: tətbiqin öz qeydlərini yoxlayın"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ и изпратено, но отговорът на приложението се изгуби: проверете собствените записи на приложението"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a odesláno, ale odpověď aplikace se ztratila: zkontrolujte záznamy samotné aplikace"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und gesendet, aber die Antwort der App ging verloren: Prüfe die eigenen Aufzeichnungen der App"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, and sent, but the app's answer was lost: check the app's own records"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, y enviado, pero se perdió la respuesta de la app: revisa los registros de la propia app"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ja saadetud, kuid rakenduse vastus läks kaotsi: kontrolli rakenduse enda kirjeid"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, et envoyé, mais la réponse de l'app a été perdue : vérifiez les registres de l'app"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, i poslano, ali odgovor aplikacije je izgubljen: provjerite vlastite zapise aplikacije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, és elküldve, de az alkalmazás válasza elveszett: nézd meg az alkalmazás saját nyilvántartását"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, և ուղարկվեց, բայց հավելվածի պատասխանը կորավ․ ստուգեք հենց հավելվածի գրառումները"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, dan terkirim, tetapi jawaban aplikasi hilang: periksa catatan aplikasi itu sendiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, e inviata, ma la risposta dell'app è andata persa: controlla i registri dell'app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、送信済みですが、アプリの応答が失われました：アプリ側の記録を確認してください"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, და გაიგზავნა, მაგრამ აპის პასუხი დაიკარგა: შეამოწმეთ თავად აპის ჩანაწერები"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 보냈지만 앱의 응답이 사라졌습니다: 앱의 자체 기록을 확인하세요"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ir išsiųsta, bet programėlės atsakymas prarastas: patikrinkite pačios programėlės įrašus"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, un nosūtīts, bet lietotnes atbilde pazuda: pārbaudi pašas lietotnes ierakstus"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, en verzonden, maar het antwoord van de app is verloren gegaan: controleer de gegevens van de app zelf"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ i wysłane, ale odpowiedź aplikacji zaginęła: sprawdź własne rejestry aplikacji"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, e enviado, mas a resposta da app perdeu-se: verifique os registos da própria app"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, e enviado, mas a resposta do app se perdeu: verifique os registros do próprio app"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ și trimis, dar răspunsul aplicației s-a pierdut: verificați evidența proprie a aplicației"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a odoslané, ale odpoveď aplikácie sa stratila: skontrolujte záznamy samotnej aplikácie"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in poslano, a odgovor aplikacije se je izgubil: preverite zapise same aplikacije"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, dhe u dërgua, por përgjigjja e aplikacionit humbi: kontrolloni regjistrat e vetë aplikacionit"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, i poslano, ali odgovor aplikacije je izgubljen: proverite vlastite zapise aplikacije"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ และส่งแล้ว แต่คำตอบของแอปหายไป: ตรวจสอบบันทึกของแอปเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ve gönderildi, ama uygulamanın yanıtı kayboldu: uygulamanın kendi kayıtlarını kontrol edin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, và đã gửi, nhưng câu trả lời của ứng dụng bị mất: hãy kiểm tra hồ sơ của chính ứng dụng"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，且已傳送，但 App 的回覆遺失：請查看 App 本身的紀錄"
