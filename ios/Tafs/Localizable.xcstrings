    "connect.connecting_again_asks_you_approve": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": " Yenidən qoşulmaq sizdən təsdiq etməyi və yenidən daxil olmağı xahiş edir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": " Повторното свързване изисква да одобрите и да влезете отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": " Opětovné připojení vás znovu požádá o schválení a přihlášení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Beim erneuten Verbinden wirst du gebeten, erneut zu genehmigen und dich erneut anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Connecting again asks you to approve and sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Volver a conectar te pide aprobar e iniciar sesión otra vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": " Uuesti ühendamisel pead uuesti kinnitama ja sisse logima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Connecter à nouveau vous demande d'approuver et de vous reconnecter."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": " Ponovno povezivanje traži da odobrite i ponovno se prijavite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": " Az újbóli csatlakoztatáshoz újra jóvá kell hagynod és be kell jelentkezned."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": " Նորից միացնելը խնդրում է ձեզ հաստատել և նորից մուտք գործել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " Menghubungkan lagi meminta Anda menyetujui dan masuk lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Per collegarlo di nuovo dovrai approvare e accedere di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再接続するには、もう一度承認とサインインが必要です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": " ხელახლა დაკავშირება გთხოვთ დაამტკიცოთ და ხელახლა შეხვიდეთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 다시 연결하려면 다시 승인하고 로그인해야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": " Jungiant iš naujo reikės vėl patvirtinti ir prisijungti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": " Pievienojot vēlreiz, tev būs vēlreiz jāapstiprina un jāpierakstās."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " Opnieuw koppelen vraagt je opnieuw goed te keuren en in te loggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Ponowne połączenie wymaga ponownego zatwierdzenia i zalogowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " Ligar novamente pede-lhe para aprovar e iniciar sessão novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Conectar novamente pede que você aprove e entre novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": " Reconectarea vă cere să aprobați și să vă conectați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": " Opätovné pripojenie vás znova požiada o schválenie a prihlásenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": " Ponovna povezava vas znova prosi za odobritev in prijavo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": " Lidhja sërish ju kërkon të miratoni dhe të hyni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": " Ponovo povezivanje traži da odobrite i ponovo se prijavite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " การเชื่อมต่ออีกครั้งจะขอให้คุณอนุมัติและเข้าสู่ระบบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " Tekrar bağlamak, onaylamanızı ve tekrar oturum açmanızı ister."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": " Kết nối lại sẽ yêu cầu bạn phê duyệt và đăng nhập lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 再次連接時，會請您核准並重新登入。"
          }
        }
      }
    },
