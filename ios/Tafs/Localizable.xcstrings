        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບໍ່ໄດ້ສືບຕໍ່: ບໍ່ໄດ້ຮັບການຢືນຢັນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Netęsiama: nepatvirtinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav turpināts: tas netika apstiprināts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не е продолжено: не беше потврдено."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үргэлжлүүлээгүй: баталгаажаагүй."
