            "value": "tafs chưa thể xóa hết mọi thứ. Tài khoản KIFF của bạn chưa bị xóa. Hãy thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs 尚無法清除所有內容。您的 KIFF 帳號未刪除。請再試一次。"
          }
        }
      }
    },
    "settings.delete_account.owner_only": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحذف الحساب إلا مالكه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabı yalnız onun sahibi silə bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Само собственикът на акаунта може да го изтрие."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু অ্যাকাউন্টের মালিক এটি মুছতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només el propietari del compte el pot eliminar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat účet může jen jeho vlastník."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Inhaber des Kontos kann es löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the account's owner can delete it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el propietario de la cuenta puede eliminarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontot saab kustutada ainult selle omanik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le propriétaire du compte peut le supprimer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק הבעלים של החשבון יכול למחוק אותו."
