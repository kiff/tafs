          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ je pro tafs vypnuté. Pro schvalování ho zapněte v nastavení tafs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist für tafs ausgeschaltet. Schalte es in den Einstellungen von tafs ein, um zu genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is turned off for tafs. Turn it on in tafs' settings to approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está desactivado para tafs. Actívalo en los ajustes de tafs para aprobar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafsi jaoks on välja lülitatud: %1$@. Kinnitamiseks lülita see tafsi seadetes sisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est désactivé pour tafs. Activez-le dans les réglages de tafs pour approuver."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključeno je za tafs: %1$@. Uključite to u postavkama tafsa da biste odobravali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez ki van kapcsolva a tafs számára: %1$@. A jóváhagyáshoz kapcsold be a tafs beállításaiban."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը անջատված է tafs-ի համար։ Միացրեք tafs-ի կարգավորումներում՝ հաստատելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nonaktif untuk tafs. Aktifkan di pengaturan tafs untuk menyetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è disattivato per tafs. Attivalo nelle impostazioni di tafs per approvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsの%1$@がオフになっています。承認するには、tafsの設定でオンにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ გამორთულია tafs-ისთვის. ჩართეთ tafs-ის პარამეტრებში, რომ დაამტკიცოთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs에서 %1$@이(가) 꺼져 있습니다. 승인하려면 tafs 설정에서 켜세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tafs programėlei išjungtas. Įjunkite jį tafs nustatymuose, kad galėtumėte tvirtinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ir izslēgts lietotnei tafs. Ieslēdz to tafs iestatījumos, lai apstiprinātu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ staat uit voor tafs. Zet het aan in de instellingen van tafs om goed te keuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jest wyłączone dla tafs. Włącz je w ustawieniach tafs, aby zatwierdzać."
