    "pair.refused_key_registered": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz bildirir ki, bu %1$@ artıq hesabınızla cütləşib. Yeni kod göstərin və yenidən skan edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонът ви казва, че този %1$@ вече е сдвоен с акаунта ви. Покажете нов код и го сканирайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon uvádí, že tento %1$@ je už s vaším účtem spárovaný. Zobrazte nový kód a naskenujte ho znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Handy sagt, dass dieser %1$@ schon mit deinem Konto gekoppelt ist. Zeig einen neuen Code und scanne ihn erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone says this %1$@ is already paired with your account. Show a new code and scan it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono indica que este %1$@ ya está vinculado a tu cuenta. Muestra un código nuevo y vuelve a escanearlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefoni järgi on see %1$@ sinu kontoga juba seotud. Näita uut koodi ja skanni see uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléphone indique que %2$@ est déjà associé à votre compte. Affichez un nouveau code et scannez-le à nouveau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš telefon kaže da je ovaj %1$@ već uparen s vašim računom. Prikažite novi kôd i skenirajte ga ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefonod szerint ez az eszköz (%1$@) már párosítva van a fiókoddal. Jeleníts meg új kódot, és olvasd be újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր հեռախոսն ասում է, որ այս սարքը (%1$@) արդեն զուգակցված է ձեր հաշվի հետ։ Ցույց տվեք նոր կոդ և նորից սկանավորեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel Anda mengatakan %1$@ ini sudah dipasangkan dengan akun Anda. Tampilkan kode baru lalu pindai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono indica che questo %1$@ è già associato al tuo account. Mostra un nuovo codice e scansionalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンによると、この%1$@はすでにアカウントとペアリングされています。新しいコードを表示して、もう一度スキャンしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი ტელეფონი ამბობს, რომ ეს მოწყობილობა (%1$@) უკვე დაწყვილებულია თქვენს ანგარიშთან. აჩვენეთ ახალი კოდი და კვლავ დაასკანერეთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰에 따르면 이 %1$@은(는) 이미 내 계정과 페어링되어 있습니다. 새 코드를 표시하고 다시 스캔하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų telefonas praneša, kad šis įrenginys (%1$@) jau susietas su jūsų paskyra. Parodykite naują kodą ir nuskaitykite jį dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavs tālrunis saka, ka šis %1$@ jau ir savienots pārī ar tavu kontu. Parādi jaunu kodu un skenē to vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon zegt dat deze %1$@ al aan je account is gekoppeld. Toon een nieuwe code en scan hem opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon podaje, że to urządzenie (%1$@) jest już sparowane z Twoim kontem. Pokaż nowy kod i zeskanuj go ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O telemóvel indica que este %1$@ já está associado à sua conta. Mostre um código novo e leia-o de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular indica que este %1$@ já está associado à sua conta. Mostre um código novo e leia-o de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonul spune că acest dispozitiv (%1$@) este deja asociat contului dvs. Afișați un cod nou și scanați-l din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefón uvádza, že tento %1$@ je už s vaším účtom spárovaný. Zobrazte nový kód a naskenujte ho znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon pravi, da je ta %1$@ že seznanjen z vašim računom. Prikažite novo kodo in jo znova skenirajte."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefoni juaj thotë se kjo pajisje (%1$@) është çiftuar tashmë me llogarinë tuaj. Shfaqni një kod të ri dhe skanojeni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš telefon kaže da je ovaj %1$@ već uparen s vašim nalogom. Prikažite novi kôd i skenirajte ga ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์ของคุณบอกว่า%1$@เครื่องนี้จับคู่กับบัญชีของคุณแล้ว แสดงรหัสใหม่แล้วสแกนอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz, bu %1$@ cihazının hesabınızla zaten eşleştirildiğini söylüyor. Yeni bir kod gösterip tekrar tarayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại của bạn cho biết %1$@ này đã được ghép với tài khoản của bạn. Hãy hiện mã mới và quét lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的手機表示這部%1$@已與您的帳號配對。請顯示新代碼後再掃描一次。"
          }
        }
      }
    },
