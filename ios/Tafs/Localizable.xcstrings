          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səsiniz bu cihazda mətnə çevrilir. Siz göndərməyincə göndərilmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гласът ви става текст на това устройство. Не се изпраща, докато не го изпратите."
