        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs-ը չի կարող կցել այս ֆայլը․ այն այն տեսակի կամ չափի չէ, որ ընդունում է։ Ընտրեք մեկ ուրիշը։"
