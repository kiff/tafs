        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nevar pievienot šo failu: tas nav pieņemama veida vai izmēra. Izvēlies citu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs не може да ја прикачи оваа датотека: не е вид или големина што ги прифаќа. Избери друга."
          }
        },
        "mn": {
          "stringUnit": {
