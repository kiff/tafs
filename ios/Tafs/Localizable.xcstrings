        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածների միացումը այս հեռախոսից այս հաշվի համար կարգավորված չէ։ Սկսեք tafs-ից iPhone-ում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghubungkan aplikasi belum disiapkan untuk akun ini dari ponsel ini. Mulai dari tafs di iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento delle app non è configurato per questo account da questo telefono. Inizia da tafs su un iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンからは、このアカウントのアプリ接続が設定されていません。iPhoneのtafsから始めてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპების დაკავშირება ამ ტელეფონიდან ამ ანგარიშისთვის დაყენებული არ არის. დაიწყეთ tafs-იდან iPhone-ზე."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에서는 이 계정의 앱 연결이 설정되어 있지 않습니다. iPhone의 tafs에서 시작하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programėlių prijungimas šiai paskyrai iš šio telefono nenustatytas. Pradėkite nuo tafs iPhone telefone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotņu pievienošana šim kontam no šī tālruņa nav iestatīta. Sāc no tafs iPhone tālrunī."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps koppelen is voor dit account niet ingesteld vanaf deze telefoon. Begin vanuit tafs op een iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączenie aplikacji nie jest skonfigurowane dla tego konta z tego telefonu. Zacznij od tafs na iPhonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação de apps não está configurada para esta conta a partir deste telefone. Comece a partir do tafs num iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão de apps não está configurada para esta conta a partir deste telefone. Comece a partir do tafs em um iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarea aplicațiilor nu este configurată pentru acest cont de pe acest telefon. Începeți din tafs pe un iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripájanie aplikácií nie je pre tento účet z tohto telefónu nastavené. Začnite z tafs na iPhone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezovanje aplikacij za ta račun s tega telefona ni nastavljeno. Začnite iz tafs v iPhonu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidhja e aplikacioneve nuk është konfiguruar për këtë llogari nga ky telefon. Filloni nga tafs në një iPhone."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezivanje aplikacija nije podešeno za ovaj nalog s ovog telefona. Počnite iz tafsa na iPhoneu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อแอปยังไม่ได้ตั้งค่าสำหรับบัญชีนี้จากโทรศัพท์เครื่องนี้ เริ่มจาก tafs บน iPhone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama bağlama bu hesap için bu telefondan kurulu değil. Bir iPhone'daki tafs'tan başlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc kết nối ứng dụng chưa được thiết lập cho tài khoản này từ điện thoại này. Hãy bắt đầu từ tafs trên iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未從這部手機為此帳號設定連接 App。請從 iPhone 上的 tafs 開始。"
          }
        }
      }
    },
