    "export.own_chats_each_taf_coach": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər taf-la, o cümlədən Coach-la öz söhbətləriniz, əlavə etdiyiniz faylların adları və qeydləriniz, oxunaqlı fayl və JSON şəklində. Onları yalnız siz ixrac edə bilərsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Собствените ви чатове с всеки taf, включително с Coach, имената на прикачените файлове и бележките ви, като четим файл и като JSON. Само вие можете да ги експортирате."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše vlastní chaty s každým tafem, včetně Coache, názvy souborů, které jste přiložili, a vaše poznámky, jako čitelný soubor a jako JSON. Exportovat je můžete jen vy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine eigenen Chats mit jedem taf, die mit Coach eingeschlossen, die Namen der Dateien, die du angehängt hast, und deine Notizen, als lesbare Datei und als JSON. Nur du kannst sie exportieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own chats with each taf, Coach's included, the names of the files you attached, and your notes, as a readable file and as JSON. Only you can export them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus propios chats con cada taf, incluido Coach, los nombres de los archivos que adjuntaste y tus notas, como archivo legible y como JSON. Solo tú puedes exportarlos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu enda vestlused iga tafiga, ka Coachiga, sinu lisatud failide nimed ja sinu märkmed, loetava failina ja JSON-ina. Eksportida saad neid ainult sina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos propres chats avec chaque taf, y compris Coach, les noms des fichiers que vous avez joints et vos notes, sous forme de fichier lisible et en JSON. Vous seul pouvez les exporter."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši razgovori sa svakim tafom, uključujući Coachove, nazivi datoteka koje ste priložili i vaše bilješke, kao čitljiva datoteka i kao JSON. Samo ih vi možete izvesti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A saját csevegéseid minden taffal, a Coach-csal is, a csatolt fájlok nevei és a jegyzeteid, olvasható fájlként és JSON-ként. Csak te exportálhatod őket."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր սեփական զրույցները յուրաքանչյուր taf-ի հետ, ներառյալ Coach-ինը, ձեր կցած ֆայլերի անունները և ձեր նշումները՝ ընթեռնելի ֆայլով և որպես JSON։ Միայն դուք կարող եք դրանք արտահանել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrolan Anda sendiri dengan setiap taf, termasuk obrolan Coach, nama file yang Anda lampirkan, dan catatan Anda, sebagai file yang dapat dibaca dan sebagai JSON. Hanya Anda yang dapat mengekspornya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue chat con ogni taf, comprese quelle con Coach, i nomi dei file che hai allegato e le tue note, come file leggibile e come JSON. Solo tu puoi esportarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各tafとのあなたのチャット（Coachを含む）、添付したファイルの名前、あなたのメモを、読めるファイルとJSONで書き出します。エクスポートできるのはあなただけです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი საკუთარი ჩატები თითოეულ taf-თან, Coach-ის ჩათვლით, თქვენ მიერ მიმაგრებული ფაილების სახელები და თქვენი ჩანაწერები, წასაკითხი ფაილის სახით და JSON-ად. მათი ექსპორტი მხოლოდ თქვენ შეგიძლიათ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 taf와 나눈 내 채팅(Coach 포함), 첨부한 파일의 이름, 내 메모를 읽을 수 있는 파일과 JSON으로 내보냅니다. 나만 내보낼 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų pačių pokalbiai su kiekvienu taf, įskaitant Coach, pridėtų failų pavadinimai ir jūsų pastabos – kaip skaitomas failas ir kaip JSON. Juos eksportuoti galite tik jūs."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavas sarunas ar katru taf, arī ar Coach, tevis pievienoto failu nosaukumi un tavas piezīmes, kā lasāms fails un kā JSON. Tās vari eksportēt tikai tu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen chats met elk taf, die met Coach inbegrepen, de namen van de bestanden die je hebt bijgevoegd en je notities, als leesbaar bestand en als JSON. Alleen jij kunt ze exporteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje własne czaty z każdym tafem, w tym z Coachem, nazwy załączonych plików i Twoje notatki, jako czytelny plik i jako JSON. Tylko Ty możesz je wyeksportować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus chats com cada taf, incluindo os do Coach, os nomes dos ficheiros que anexou e as suas notas, num ficheiro legível e em JSON. Só você os pode exportar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus chats com cada taf, incluindo os do Coach, os nomes dos arquivos que anexou e as suas notas, em um arquivo legível e em JSON. Só você os pode exportar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Propriile conversații cu fiecare taf, inclusiv cu Coach, numele fișierelor atașate și notițele dvs., ca fișier lizibil și ca JSON. Doar dvs. le puteți exporta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše vlastné chaty s každým tafom vrátane Coacha, názvy súborov, ktoré ste priložili, a vaše poznámky, ako čitateľný súbor a ako JSON. Exportovať ich môžete len vy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši klepeti z vsakim tafom, vključno s Coachem, imena datotek, ki ste jih priložili, in vaši zapiski, kot berljiva datoteka in kot JSON. Izvozite jih lahko samo vi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisedat tuaja me secilin taf, përfshirë ato të Coach, emrat e skedarëve që keni bashkëngjitur dhe shënimet tuaja, si skedar i lexueshëm dhe si JSON. Vetëm ju mund t'i eksportoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši razgovori sa svakim tafom, uključujući Coachove, nazivi datoteka koje ste priložili i vaše beleške, kao čitljiva datoteka i kao JSON. Samo ih vi možete izvesti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชตของคุณเองกับแต่ละ taf รวมถึง Coach ชื่อไฟล์ที่คุณแนบ และบันทึกของคุณ ในรูปแบบไฟล์ที่อ่านได้และ JSON มีเพียงคุณเท่านั้นที่ส่งออกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her taf'la olan kendi sohbetleriniz (Coach'unkiler dahil), eklediğiniz dosyaların adları ve notlarınız; okunabilir bir dosya ve JSON olarak. Bunları yalnızca siz dışa aktarabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc trò chuyện của riêng bạn với từng taf, kể cả với Coach, tên các tệp bạn đã đính kèm và ghi chú của bạn, dưới dạng tệp dễ đọc và JSON. Chỉ bạn mới xuất được chúng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您與每個 taf（包含 Coach）的對話、您附加的檔案名稱，以及您的備註，以可讀檔案和 JSON 格式提供。只有您能匯出。"
          }
        }
      }
    },
