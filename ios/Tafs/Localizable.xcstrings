    "approval.security_key.several_keys": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Birdən çox təhlükəsizlik açarı qoşulub. Digərlərini çıxarın, bu kompüterə uyğun olanı saxlayın, sonra yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включени са повече от един ключ за сигурност. Извадете останалите, оставете този за този компютър и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je připojeno víc bezpečnostních klíčů. Odpojte ostatní, nechte ten, který patří k tomuto počítači, a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist mehr als ein Sicherheitsschlüssel eingesteckt. Zieh die anderen ab, lass den Schlüssel stecken, der zu diesem Computer gehört, und versuch es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one security key is plugged in. Unplug the others, keep the one that goes with this computer, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay más de una llave de seguridad conectada. Desconecta las demás, deja la que va con este ordenador y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendatud on rohkem kui üks turvavõti. Eemalda teised, jäta alles see, mis kuulub selle arvuti juurde, ja proovi siis uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs clés de sécurité sont branchées. Débranchez les autres, gardez celle liée à cet ordinateur, puis réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priključeno je više od jednog sigurnosnog ključa. Iskopčajte ostale, ostavite onaj koji pripada ovom računalu, pa pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Több biztonsági kulcs is csatlakoztatva van. Húzd ki a többit, hagyd bent azt, amelyik ehhez a számítógéphez tartozik, majd próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեկից ավելի անվտանգության բանալի է միացված։ Անջատեք մյուսները, թողեք այն, որը համապատասխանում է այս համակարգչին, ապա փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih dari satu kunci keamanan tercolok. Cabut yang lain, pertahankan yang cocok dengan komputer ini, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È collegata più di una chiave di sicurezza. Scollega le altre, tieni quella che va con questo computer, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のセキュリティキーが差し込まれています。このコンピュータ用のキーだけを残して他を抜き、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ერთზე მეტი უსაფრთხოების გასაღებია ჩართული. გამოაძვრინეთ დანარჩენები, დატოვეთ ის, რომელიც ამ კომპიუტერს შეესაბამება, შემდეგ სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 키가 두 개 이상 꽂혀 있습니다. 이 컴퓨터와 짝을 이룬 키만 남기고 나머지를 뽑은 뒤 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijungtas daugiau nei vienas saugos raktas. Atjunkite kitus, palikite tą, kuris susietas su šiuo kompiuteriu, ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienota vairāk nekā viena drošības atslēga. Atvieno pārējās, atstāj to, kas pieder šim datoram, tad mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zit meer dan één beveiligingssleutel in. Haal de andere eruit, laat de sleutel zitten die bij deze computer hoort en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłączono więcej niż jeden klucz bezpieczeństwa. Odłącz pozostałe, zostaw klucz powiązany z tym komputerem i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Há mais de uma chave de segurança ligada. Desligue as outras, mantenha a que vai com este computador e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há mais de uma chave de segurança conectada. Desconecte as outras, mantenha a que vai com este computador e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt conectate mai multe chei de securitate. Scoateți-le pe celelalte, păstrați-o pe cea care merge cu acest computer, apoi încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je pripojených viac bezpečnostných kľúčov. Odpojte ostatné, nechajte ten, ktorý patrí k tomuto počítaču, a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priključenih je več varnostnih ključev. Izključite druge, pustite tistega, ki spada k temu računalniku, in poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Është futur më shumë se një çelës sigurie. Hiqni të tjerët, mbani atë që shkon me këtë kompjuter, pastaj provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Priključeno je više sigurnosnih ključeva. Isključite ostale, ostavite onaj koji pripada ovom računaru, pa pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีกุญแจความปลอดภัยเสียบอยู่มากกว่าหนึ่งดอก ถอดดอกอื่นออก เหลือไว้ดอกที่ใช้คู่กับคอมพิวเตอร์เครื่องนี้ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla güvenlik anahtarı takılı. Diğerlerini çıkarın, bu bilgisayara ait olanı bırakın, sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có nhiều hơn một khóa bảo mật đang cắm. Hãy rút các khóa khác, giữ khóa đi cùng máy tính này, rồi thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "插入了不只一把安全金鑰。請拔出其他的，保留與這部電腦搭配的那一把，然後再試一次。"
          }
        }
      }
    },
    "approval.security_key.timed_out": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təhlükəsizlik açarına vaxtında toxunulmadı, ona görə heç nə təsdiqlənmədi. Sorğu saxlanılıb: hazır olanda yenidən təsdiq edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът за сигурност не беше докоснат навреме, така че нищо не беше одобрено. Заявката се запазва: одобрете отново, когато сте готови."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostního klíče jste se nedotkli včas, takže se nic neschválilo. Žádost zůstává: schvalte znovu, až budete připraveni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sicherheitsschlüssel wurde nicht rechtzeitig berührt, also wurde nichts genehmigt. Die Anfrage bleibt erhalten: Genehmige erneut, wenn du so weit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The security key wasn't touched in time, so nothing was approved. The request is kept: approve again when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llave de seguridad no se tocó a tiempo, así que no se aprobó nada. La solicitud se conserva: vuelve a aprobar cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Turvavõtit ei puudutatud õigel ajal, seega midagi ei kinnitatud. Päring jääb alles: kinnita uuesti, kui oled valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de sécurité n'a pas été touchée à temps : rien n'a été approuvé. La demande est conservée : approuvez à nouveau quand vous êtes prêt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosni ključ nije dodirnut na vrijeme pa ništa nije odobreno. Zahtjev je sačuvan: odobrite ponovno kad budete spremni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biztonsági kulcsot nem érintetted meg időben, így semmi sem lett jóváhagyva. A kérés megmarad: hagyd jóvá újra, ha készen állsz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անվտանգության բանալուն ժամանակին չհպվեցին, ուստի ոչինչ չհաստատվեց։ Հարցումը պահպանվել է․ հաստատեք նորից, երբ պատրաստ լինեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci keamanan tidak disentuh tepat waktu, jadi tidak ada yang disetujui. Permintaan tetap disimpan: setujui lagi saat Anda siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di sicurezza non è stata toccata in tempo, quindi non è stato approvato nulla. La richiesta resta: approva di nuovo quando sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間内にセキュリティキーがタッチされなかったため、何も承認されていません。リクエストは保持されています。準備ができたらもう一度承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უსაფრთხოების გასაღებს დროზე არ შეხებიან, ამიტომ არაფერი დამტკიცებულა. მოთხოვნა შენახულია: დაამტკიცეთ ხელახლა, როცა მზად იქნებით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제때 보안 키를 터치하지 않아 승인된 것은 없습니다. 요청은 남아 있으니 준비되면 다시 승인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saugos raktas nepaliestas laiku, todėl niekas nepatvirtinta. Užklausa išsaugota: patvirtinkite dar kartą, kai būsite pasirengę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drošības atslēgai laikus nepieskārās, tāpēc nekas netika apstiprināts. Pieprasījums ir saglabāts: apstiprini vēlreiz, kad esi gatavs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beveiligingssleutel is niet op tijd aangeraakt, dus er is niets goedgekeurd. Het verzoek blijft bewaard: keur het goed wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucza bezpieczeństwa nie dotknięto na czas, więc nic nie zostało zatwierdzone. Prośba zostaje zachowana: zatwierdź ją ponownie, kiedy zechcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança não foi tocada a tempo, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de segurança não foi tocada a tempo, por isso nada foi aprovado. O pedido fica guardado: aprove novamente quando estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia de securitate nu a fost atinsă la timp, așa că nu s-a aprobat nimic. Solicitarea se păstrează: aprobați din nou când sunteți gata."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpečnostného kľúča ste sa nedotkli včas, takže sa nič neschválilo. Žiadosť zostáva: schváľte znova, keď budete pripravení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Varnostnega ključa se niste pravočasno dotaknili, zato ni bilo nič odobreno. Zahteva ostane: odobrite znova, ko boste pripravljeni."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çelësi i sigurisë nuk u prek në kohë, ndaj asgjë nuk u miratua. Kërkesa ruhet: miratoni sërish kur të jeni gati."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosni ključ nije dodirnut na vreme, pa ništa nije odobreno. Zahtev je sačuvan: odobrite ponovo kad budete spremni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้แตะกุญแจความปลอดภัยทันเวลา จึงไม่มีอะไรถูกอนุมัติ คำขอยังอยู่: อนุมัติอีกครั้งเมื่อคุณพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik anahtarına zamanında dokunulmadı, bu yüzden hiçbir şey onaylanmadı. İstek korunuyor: hazır olduğunuzda tekrar onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa bảo mật không được chạm vào kịp thời nên không có gì được phê duyệt. Yêu cầu vẫn được giữ: hãy phê duyệt lại khi bạn sẵn sàng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未及時觸碰安全金鑰，因此未核准任何項目。請求仍保留：準備好時再次核准。"
          }
        }
      }
    },
