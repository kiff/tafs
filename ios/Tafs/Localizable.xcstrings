    "door.api.remove_body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onun açarları işləməyi dayandırır və %1$@ artıq %2$@ taf-ına iş verə bilmir. Başlamamış sorğular ləğv edilir; işləyən bitir. Artıq edilmiş heç nə geri qaytarılmır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключовете ѝ спират да работят и %1$@ вече не може да дава работа на %2$@. Незапочналите заявки се отменят; текущата завършва. Вече направеното не се отменя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho klíče přestanou fungovat a %1$@ už nemůže %2$@ předávat práci. Žádosti, které nezačaly, se zruší; ta, která běží, doběhne. Co už se udělalo, se nevrací."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Schlüssel funktionieren nicht mehr, und %1$@ kann %2$@ keine Arbeit mehr geben. Anfragen, die noch nicht begonnen haben, werden abgebrochen; eine laufende wird zu Ende geführt. Was schon getan ist, wird nicht rückgängig gemacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its keys stop working, and %1$@ can no longer hand %2$@ work. Requests that haven't started are cancelled; one that's running finishes. Nothing already done is undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus claves dejan de funcionar y %1$@ ya no puede darle trabajo a %2$@. Las solicitudes que aún no han empezado se cancelan; la que está en curso termina. No se deshace nada de lo ya hecho."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle võtmed lakkavad töötamast ja %1$@ ei saa enam tafile %2$@ tööd anda. Alustamata päringud tühistatakse; käimasolev päring viiakse lõpuni. Juba tehtut tagasi ei võeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses clés cessent de fonctionner et %1$@ ne peut plus confier de travail à %2$@. Les requêtes qui n'ont pas commencé sont annulées ; celle en cours se termine. Rien de ce qui est déjà fait n'est annulé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegovi ključevi prestaju raditi, a aplikacija %1$@ više ne može predavati posao tafu %2$@. Zahtjevi koji nisu počeli otkazuju se; onaj koji se izvodi završava. Ništa što je već učinjeno ne poništava se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcsai nem működnek tovább, és %1$@ többé nem adhat munkát neki (%2$@). A még el nem indult kérések törlődnek; a futó befejeződik. Ami már megtörtént, nem vonódik vissza."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրա բանալիները դադարում են աշխատել, և %1$@-ը այլևս չի կարող %2$@-ին աշխատանք տալ։ Չսկսված հարցումները չեղարկվում են․ աշխատողը ավարտվում է։ Արդեն արվածը չի չեղարկվում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuncinya berhenti berfungsi, dan %1$@ tidak dapat lagi menyerahkan pekerjaan kepada %2$@. Permintaan yang belum dimulai dibatalkan; yang sedang berjalan selesai. Apa pun yang sudah dilakukan tidak dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue chiavi smettono di funzionare e %1$@ non può più affidare lavoro a %2$@. Le richieste non ancora iniziate vengono annullate; quella in corso finisce. Nulla di ciò che è già stato fatto viene annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは使えなくなり、%1$@は%2$@に仕事を渡せなくなります。開始前のリクエストはキャンセルされ、実行中のものは完了します。すでに完了したものは元に戻りません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მისი გასაღებები მუშაობას წყვეტს და %1$@-ს %2$@-ისთვის სამუშაოს მიცემა აღარ შეუძლია. მოთხოვნები, რომლებიც არ დაწყებულა, უქმდება; ის, რაც მუშაობს, სრულდება. არაფერი, რაც უკვე გაკეთდა, არ უქმდება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 작동을 멈추고 %1$@은(는) 더 이상 %2$@에게 작업을 맡길 수 없습니다. 시작되지 않은 요청은 취소되고, 실행 중인 요청은 끝까지 진행됩니다. 이미 한 일은 되돌려지지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jų raktai nustoja veikti, ir %1$@ nebegali perduoti darbo %2$@. Dar nepradėtos užklausos atšaukiamos; vykdoma baigiama. Kas jau padaryta, neatšaukiama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tās atslēgas pārstāj darboties, un %1$@ vairs nevar nodot %2$@ darbu. Pieprasījumi, kas vēl nav sākti, tiek atcelti; tas, kas notiek, tiek pabeigts. Jau izdarītais paliek spēkā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutels werken niet meer en %1$@ kan %2$@ geen werk meer geven. Verzoeken die nog niet begonnen zijn, worden geannuleerd; een verzoek dat loopt, wordt afgemaakt. Wat al gedaan is, wordt niet teruggedraaid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich klucze przestają działać, a aplikacja %1$@ nie może już zlecać pracy dla %2$@. Żądania, które się nie zaczęły, zostają anulowane; trwające kończy się. Nic, co już zrobiono, nie zostaje cofnięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas chaves deixam de funcionar e %1$@ deixa de poder entregar trabalho a %2$@. Os pedidos que ainda não começaram são cancelados; um que esteja em curso termina. Nada do que já foi feito é desfeito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas chaves deixam de funcionar e %1$@ deixa de poder entregar trabalho a %2$@. Os pedidos que ainda não começaram são cancelados; um que esteja em andamento termina. Nada do que já foi feito é desfeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheile sale nu mai funcționează, iar %1$@ nu îi mai poate da lui %2$@ de lucru. Solicitările care nu au pornit sunt anulate; cea care rulează se termină. Ce s-a făcut deja nu se anulează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho kľúče prestanú fungovať a %1$@ už nemôže %2$@ odovzdávať prácu. Žiadosti, ktoré nezačali, sa zrušia; tá, ktorá beží, dobehne. Čo sa už urobilo, sa nevracia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegovi ključi prenehajo delovati in %1$@ ne more več predajati dela %2$@. Zahteve, ki se še niso začele, se prekličejo; tista, ki teče, se dokonča. Kar je že opravljeno, se ne razveljavi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çelësat e saj pushojnë së funksionuari, dhe %1$@ nuk mund t'i japë më %2$@ punë. Kërkesat që s'kanë filluar anulohen; ajo që po ekzekutohet përfundon. Asgjë që është bërë tashmë nuk zhbëhet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegovi ključevi prestaju raditi, a aplikacija %1$@ više ne može predavati posao tafu %2$@. Zahtevi koji nisu počeli otkazuju se; onaj koji se izvodi završava. Ništa šta je već učinjeno ne poništava se."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กุญแจของมันจะใช้ไม่ได้ และ %1$@ จะมอบงานให้ %2$@ ไม่ได้อีก คำขอที่ยังไม่เริ่มจะถูกยกเลิก คำขอที่กำลังทำจะทำจนเสร็จ สิ่งที่ทำไปแล้วจะไม่ถูกยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarları çalışmayı bırakır ve %1$@, %2$@ taf'ına artık iş veremez. Başlamamış istekler iptal edilir; çalışan biri tamamlanır. Daha önce yapılan hiçbir şey geri alınmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các khóa của nó ngừng hoạt động, và %1$@ không còn giao việc được cho %2$@. Các yêu cầu chưa bắt đầu bị hủy; yêu cầu đang chạy sẽ chạy xong. Những gì đã làm không bị hoàn tác."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的金鑰會失效，%1$@ 也無法再交付工作給 %2$@。尚未開始的請求會被取消；正在執行的會執行完畢。已完成的事項不會被復原。"
          }
        }
      }
    },
    "door.api.revoke_body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onun göndərdiyi, başlamamış sorğular ləğv edilir. İşləyən bitir. Dərhal dayandırmaq üçün taf-ı dondurun. Ləğv edilmiş açarı geri qaytarmaq olmaz: yeni açar yeni açardır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпратените от него незапочнали заявки се отменят. Текущата завършва. За да я спрете сега, спрете taf. Оттеглен ключ не може да бъде върнат: новият ключ е нов ключ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádosti, které poslal a které nezačaly, se zruší. Ta, která běží, doběhne. Chcete-li ji zastavit hned, zastavte taf. Odvolaný klíč nelze vrátit: nový klíč je nový klíč."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen von ihm, die noch nicht begonnen haben, werden abgebrochen. Eine laufende wird zu Ende geführt. Um sie sofort zu stoppen, halte den taf an. Ein widerrufener Schlüssel lässt sich nicht zurückholen: Ein neuer Schlüssel ist ein neuer Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests it sent that haven't started are cancelled. One that's running finishes. To stop it now, halt the taf. A revoked key can't be brought back: a new key is a new key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes que envió y que aún no han empezado se cancelan. La que está en curso termina. Para pararla ya, bloquea el taf. Una clave revocada no se puede recuperar: una clave nueva es una clave nueva."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle saadetud alustamata päringud tühistatakse. Käimasolev päring viiakse lõpuni. Kohe lõpetamiseks peata taf. Tühistatud võtit ei saa tagasi tuua: uus võti on uus võti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les requêtes qu'elle a envoyées et qui n'ont pas commencé sont annulées. Celle en cours se termine. Pour l'arrêter tout de suite, bloquez le taf. Une clé révoquée ne peut pas être récupérée : une nouvelle clé est une nouvelle clé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtjevi koje je poslao, a nisu počeli, otkazuju se. Onaj koji se izvodi završava. Da ga zaustavite odmah, blokirajte taf. Opozvani se ključ ne može vratiti: novi ključ je novi ključ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az általa küldött, még el nem indult kérések törlődnek. A futó befejeződik. Az azonnali leállításhoz állítsd le a tafot. Egy visszavont kulcs nem hozható vissza: az új kulcs új kulcs."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրա ուղարկած հարցումները, որ չեն սկսվել, չեղարկվում են։ Աշխատողը ավարտվում է։ Հիմա կանգնեցնելու համար կանգնեցրեք taf-ը։ Չեղարկված բանալին հետ չի բերվի․ նոր բանալին նոր բանալի է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan yang dikirimnya dan belum dimulai dibatalkan. Yang sedang berjalan selesai. Untuk menghentikannya sekarang, bekukan taf. Kunci yang dicabut tidak dapat dikembalikan: kunci baru adalah kunci baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste che ha inviato e non ancora iniziate vengono annullate. Quella in corso finisce. Per fermarla subito, blocca il taf. Una chiave revocata non si può recuperare: una chiave nuova è una chiave nuova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信済みで開始前のリクエストはキャンセルされます。実行中のものは完了します。今すぐ止めるには、tafを遮断してください。取り消したキーは元に戻せません。新しいキーは別のキーです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მის მიერ გაგზავნილი მოთხოვნები, რომლებიც არ დაწყებულა, უქმდება. ის, რაც მუშაობს, სრულდება. ახლავე გასაჩერებლად გააჩერეთ taf. გაუქმებული გასაღები ვეღარ დაბრუნდება: ახალი გასაღები ახალი გასაღებია."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키로 보낸 요청 중 시작되지 않은 것은 취소됩니다. 실행 중인 요청은 끝까지 진행됩니다. 지금 멈추려면 taf를 차단하세요. 취소한 키는 되살릴 수 없으며, 새 키는 새 키입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo išsiųstos, bet dar nepradėtos užklausos atšaukiamos. Vykdoma baigiama. Norėdami ją nutraukti dabar, sustabdykite taf. Atšaukto rakto grąžinti negalima: naujas raktas yra naujas raktas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tās sūtītie pieprasījumi, kas vēl nav sākti, tiek atcelti. Tas, kas notiek, tiek pabeigts. Lai to pārtrauktu tūlīt, aptur taf. Atsauktu atslēgu nevar atjaunot: jauna atslēga ir jauna atslēga."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzoeken die hij stuurde en die nog niet begonnen zijn, worden geannuleerd. Een verzoek dat loopt, wordt afgemaakt. Om het nu te stoppen, zet je de taf stil. Een ingetrokken sleutel kan niet terug: een nieuwe sleutel is een nieuwe sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłane nim żądania, które się nie zaczęły, zostają anulowane. Trwające kończy się. Aby zatrzymać je od razu, zablokuj taf. Unieważnionego klucza nie da się przywrócić: nowy klucz to nowy klucz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos que enviou e que ainda não começaram são cancelados. Um que esteja em curso termina. Para o parar já, bloqueie o taf. Uma chave revogada não pode ser recuperada: uma chave nova é uma chave nova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos que enviou e que ainda não começaram são cancelados. Um que esteja em andamento termina. Para o parar já, bloqueie o taf. Uma chave revogada não pode ser recuperada: uma chave nova é uma chave nova."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitările trimise de ea care nu au pornit sunt anulate. Cea care rulează se termină. Pentru a o opri acum, opriți taful. O cheie revocată nu poate fi readusă: o cheie nouă este o cheie nouă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadosti, ktoré poslal a ktoré nezačali, sa zrušia. Tá, ktorá beží, dobehne. Ak ju chcete zastaviť hneď, zastavte taf. Odvolaný kľúč sa nedá vrátiť: nový kľúč je nový kľúč."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahteve, ki jih je poslal in se še niso začele, se prekličejo. Tista, ki teče, se dokonča. Če jo želite ustaviti takoj, ustavite taf. Odvzetega ključa ni mogoče vrniti: nov ključ je nov ključ."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kërkesat që dërgoi e që s'kanë filluar anulohen. Ajo që po ekzekutohet përfundon. Për ta ndaluar tani, bllokoni taf-in. Një çelës i revokuar nuk kthehet: një çelës i ri është një çelës i ri."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtevi koje je poslao, a nisu počeli, otkazuju se. Onaj koji se izvodi završava. Da ga zaustavite odmah, blokirajte taf. Opozvani se ključ ne može vratiti: novi ključ je novi ključ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอที่มันส่งมาและยังไม่เริ่มจะถูกยกเลิก คำขอที่กำลังทำจะทำจนเสร็จ หากต้องการหยุดทันที ให้ระงับ taf กุญแจที่เพิกถอนแล้วนำกลับมาไม่ได้: กุญแจใหม่ก็คือกุญแจใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderdiği ve başlamamış istekler iptal edilir. Çalışan biri tamamlanır. Hemen durdurmak için taf'ı dondurun. İptal edilen bir anahtar geri getirilemez: yeni anahtar yeni bir anahtardır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các yêu cầu nó đã gửi mà chưa bắt đầu sẽ bị hủy. Yêu cầu đang chạy sẽ chạy xong. Để dừng ngay, hãy đóng băng taf. Khóa đã thu hồi không thể khôi phục: khóa mới là một khóa mới."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它傳送且尚未開始的請求會被取消。正在執行的會執行完畢。若要立即停止，請凍結 taf。撤銷的金鑰無法復原：新的金鑰就是新的金鑰。"
          }
        }
      }
    },
