          "stringUnit": {
            "state": "translated",
            "value": "Die Credits des letzten Zeitraums konnten nicht gelesen werden. Wähle ihn erneut, um es noch einmal zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last period's credits couldn't be read. Choose it again to try again."
