            "state": "translated",
            "value": "Cela n'a pas atteint KIFF. Réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije stiglo do KIFF-a. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem jutott el a KIFF-hez. Próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ին չհասավ։ Փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
