        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece primeiro em Apps ligadas neste %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece primeiro em Apps conectados neste %1$@."
          }
        },
        "ro": {
