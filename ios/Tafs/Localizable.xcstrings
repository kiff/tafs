    "sample.chargebacks.job": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart mübahisələrini son tarixdən əvvəl sifarişin sübutları ilə cavablandırın. Qazanıla bilməyən kiçik mübahisələri qəbul edin. Şablondan başqa heç nə paylaşmayın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговаряйте на споровете по карти с доказателствата от поръчката преди срока. Приемайте малките, които не могат да бъдат спечелени. Не споделяйте нищо извън шаблона."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídat na spory u karet s doklady k objednávce před termínem. Malé spory, které nejde vyhrát, přijmout. Nesdílet nic nad rámec šablony."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworte Kartenreklamationen vor der Frist mit den Nachweisen der Bestellung. Akzeptiere kleine, die nicht zu gewinnen sind. Teile nichts über die Vorlage hinaus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer card disputes with the order's evidence before the deadline. Accept small ones that can't be won. Share nothing beyond the template."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde a las disputas de tarjeta con las pruebas del pedido antes del plazo. Acepta las pequeñas que no se pueden ganar. No compartas nada más allá de la plantilla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasta kaardimaksete vaidlustustele tellimuse tõenditega enne tähtaega. Nõustu väikestega, mida ei saa võita. Ära jaga midagi peale malli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondre aux litiges de carte bancaire avec les preuves de la commande avant l'échéance. Accepter les petits litiges impossibles à gagner. Ne rien partager au-delà du modèle."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovarajte na sporove oko kartičnih plaćanja dokazima narudžbe prije roka. Prihvatite male koji se ne mogu dobiti. Ne dijelite ništa izvan predloška."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszolj a kártyás vitákra a rendelés bizonyítékaival a határidő előtt. A kis, megnyerhetetlen vitákat fogadd el. Semmit ne ossz meg a sablonon túl."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատասխանեք քարտային վեճերին պատվերի ապացույցներով՝ ժամկետից առաջ։ Ընդունեք փոքրերը, որոնք հնարավոր չէ շահել։ Ձևանմուշից դուրս ոչինչ մի կիսեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawab sengketa kartu dengan bukti pesanan sebelum batas waktu. Terima yang kecil yang tidak bisa dimenangkan. Jangan bagikan apa pun di luar templat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi alle contestazioni delle carte con le prove dell'ordine prima della scadenza. Accetta quelle piccole che non si possono vincere. Non condividere nulla oltre il modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限までに注文の証拠でカードの異議申し立てに回答します。勝てない少額のものは受け入れます。テンプレート以外は何も共有しません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უპასუხეთ ბარათის დავებს შეკვეთის მტკიცებულებით ვადამდე. მიიღეთ მცირე, რომელთა მოგებაც შეუძლებელია. შაბლონის მიღმა არაფერი გაუზიაროთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감 전에 주문의 증빙으로 카드 분쟁에 답변합니다. 이길 수 없는 소액 분쟁은 수락합니다. 템플릿 외에는 아무것도 공유하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsakyti į kortelių mokėjimų ginčus su užsakymo įrodymais iki termino. Priimti mažus, kurių neįmanoma laimėti. Nesidalyti niekuo daugiau nei šablonas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbildēt uz karšu maksājumu strīdiem ar pasūtījuma pierādījumiem pirms termiņa. Pieņemt nelielus strīdus, kurus nevar uzvarēt. Nekopīgot neko ārpus veidnes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord kaartgeschillen vóór de deadline met het bewijs van de bestelling. Accepteer kleine geschillen die niet te winnen zijn. Deel niets buiten de sjabloon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadaj na spory kartowe dowodami z zamówienia przed terminem. Akceptuj małe, których nie da się wygrać. Nie udostępniaj niczego poza szablonem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder às disputas de cartão com as provas da encomenda antes do prazo. Aceitar as pequenas que não se podem ganhar. Não partilhar nada além do modelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder às disputas de cartão com as provas do pedido antes do prazo. Aceitar as pequenas que não dá para ganhar. Não compartilhar nada além do modelo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspundeți la disputele de card cu dovezile comenzii înainte de termen. Acceptați disputele mici care nu pot fi câștigate. Nu partajați nimic dincolo de șablon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovedať na spory pri kartách s dokladmi k objednávke pred termínom. Malé spory, ktoré sa nedajú vyhrať, prijať. Nezdieľať nič nad rámec šablóny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na spore pri karticah odgovori z dokazili naročila pred rokom. Majhne, ki jih ni mogoče dobiti, sprejmi. Ne deli ničesar onkraj predloge."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigjuni mosmarrëveshjeve të kartave me provat e porosisë para afatit. Pranoni të voglat që nuk mund të fitohen. Mos ndani asgjë përtej shabllonit."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovarajte na sporove oko kartičnih plaćanja dokazima porudžbine pre roka. Prihvatite male koji se ne mogu dobiti. Ne delite ništa izvan šablona."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอบข้อพิพาทบัตรด้วยหลักฐานของออเดอร์ก่อนกำหนด ยอมรับรายการเล็กที่ชนะไม่ได้ ไม่แชร์สิ่งใดนอกเหนือจากแม่แบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart itirazlarını son tarihten önce siparişin kanıtlarıyla yanıtla. Kazanılamayacak küçük olanları kabul et. Şablonun ötesinde hiçbir şey paylaşma."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời các khiếu nại thẻ bằng bằng chứng của đơn hàng trước hạn chót. Chấp nhận những khoản nhỏ không thể thắng. Không chia sẻ gì ngoài mẫu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在期限前以訂單的證據回覆信用卡爭議。接受無法勝訴的小額爭議。除範本外不分享任何內容。"
          }
        }
      }
    },
