    "version.out_of_date_card": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du genehmigen sollst, hat sich geändert, seit es angezeigt wurde. Lies es erneut und genehmige dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you're asked to approve changed since it was shown. Read it again, then approve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se te pide aprobar cambió desde que se mostró. Vuelve a leerlo y luego aprueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l'on vous demande d'approuver a changé depuis son affichage. Relisez-le, puis approuvez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che ti viene chiesto di approvare è cambiato da quando è stato mostrato. Rileggilo, poi approva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je moet goedkeuren, is gewijzigd sinds het werd getoond. Lees het opnieuw en keur het dan goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co masz zatwierdzić, zmieniło się od chwili pokazania. Przeczytaj to ponownie, a potem zatwierdź."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que lhe pedem para aprovar mudou desde que foi mostrado. Leia-o novamente e depois aprove."
          }
        }
      }
    },
