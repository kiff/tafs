        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš telefon ne može sam pretvoriti govor u tekst na ovom jeziku. Umesto toga tipkajte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์ของคุณแปลงเสียงเป็นข้อความในภาษานี้เองไม่ได้ พิมพ์แทน"
