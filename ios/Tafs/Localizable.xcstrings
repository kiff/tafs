        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור מאזין, אבל החוגה עדיין לא רשמה אותו. יש לאשר שוב כדי לרשום אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन सुन रहा है, पर डायल ने अभी इसे दर्ज नहीं किया। दर्ज करने के लिए फिर मंज़ूर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza osluškuje, ali je brojčanik još nije zabilježio. Odobrite ponovno da je zabilježite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolat figyel, de a tárcsa még nem rögzítette. Hagyd jóvá újra a rögzítéshez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կապը լսում է, բայց թվատախտակը դեռ չի գրանցել այն։ Հաստատեք նորից՝ գրանցելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi mendengarkan, tetapi dial belum mencatatnya. Setujui lagi untuk mencatatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento è in ascolto, ma il quadrante non l'ha ancora registrato. Approva di nuovo per registrarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続は受信中ですが、まだダイヤルに記録されていません。記録するにはもう一度承認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კავშირი უსმენს, მაგრამ ციფერბლატს ის ჯერ არ ჩაუწერია. დაამტკიცეთ ხელახლა ჩასაწერად."
