    "connect.clear_removed.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسجَّل خروج كل منها لدى مزوّده. ويبقى ما تستخدمه Card الخاصة بـ taf آخر."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər biri təchizatçısında çıxış edilir. Başqa taf-ın Card-ının istifadə etdiyi saxlanılır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяка се извежда при доставчика си. Тази, която се използва от Card на друг taf, се запазва."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি তার বিক্রেতার কাছে সাইন আউট করা হয়। অন্য taf-এর Card যেটি ব্যবহার করে সেটি রাখা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadascuna tanca la sessió al seu proveïdor. Se'n conserva la que fa servir el Card d'un altre taf."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé se odhlásí u svého dodavatele. To, které používá Card jiného tafu, zůstane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede wird bei ihrem Anbieter abgemeldet. Eine, die die Card eines anderen tafs nutzt, bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each is signed out at its vendor. One another taf's Card uses is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cierra la sesión de cada una con su proveedor. Se conserva la que use la Card de otro taf."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igaüks logitakse selle pakkuja juures välja. Ühendus, mida mõne teise tafi Card kasutab, jääb alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacune est déconnectée chez son fournisseur. Celle qu'utilise la Card d'un autre taf est conservée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל אחד יוצא מהחשבון אצל הספק שלו. זה ש-Card של taf אחר משתמש בו נשמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर एक अपने विक्रेता पर साइन आउट होता है। जिसे किसी और taf का Card उपयोग करता है वह रखा जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka se odjavljuje kod svog pružatelja. Ona koju koristi Card drugog tafa zadržava se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindegyik ki lesz jelentkeztetve a szolgáltatójánál. Amelyiket egy másik taf Cardja használja, az megmarad."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուրը դուրս է գալիս իր մատակարարի մոտ։ Այն, ինչ մեկ այլ taf-ի Card-ը օգտագործում է, պահվում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masing-masing dikeluarkan di vendornya. Yang dipakai Card taf lain tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ognuno viene effettuata la disconnessione presso il fornitore. Uno usato dalla Card di un altro taf viene mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれ提供元でサインアウトされます。別のtafのCardが使っているものは残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითოეული გამოდის თავის მომწოდებელთან. ის, რასაც სხვა taf-ის Card იყენებს, რჩება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នីមួយៗត្រូវបានចាកចេញនៅអ្នកផ្តល់សេវារបស់វា។ ការតភ្ជាប់ដែល Card របស់ taf ផ្សេងប្រើត្រូវបានរក្សាទុក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 연결은 해당 서비스에서 로그아웃됩니다. 다른 taf의 Card가 쓰는 연결은 유지됩니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແຕ່ລະອັນຖືກໃຫ້ອອກຈາກລະບົບທີ່ຜູ້ໃຫ້ບໍລິການຂອງມັນ. ອັນທີ່ Card ຂອງ taf ອື່ນໃຊ້ຖືກເກັບໄວ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas atjungiamas teikėjo pusėje. Tas, kurį naudoja kito taf Card, išlaikomas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katrā no tiem tiks veikta izrakstīšanās pie nodrošinātāja. Tas, ko izmanto cita taf Card, tiek paturēts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секоја се одјавува кај својот давател. Онаа што ја користи Card на друг taf се задржува."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тус бүр нь өөрийн үйлчилгээ үзүүлэгч дээр гарна. Өөр taf-ын Card ашигладаг нь үлдэнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक आफ्नो विक्रेतामा साइन आउट हुन्छ। अर्को taf को Card ले प्रयोग गर्ने राखिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke koppeling wordt bij de leverancier uitgelogd. Een koppeling die de Card van een ander taf gebruikt, blijft behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde zostanie wylogowane u swojego dostawcy. To, którego używa Card innego tafa, zostanie zachowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada uma termina a sessão no seu fornecedor. Uma que o Card de outro taf use é mantida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada uma termina a sessão no seu fornecedor. Uma que o Card de outro taf use é mantida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare este deconectată la furnizorul ei. Una pe care o folosește Cardul altui taf se păstrează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé sa odhlási u svojho dodávateľa. To, ktoré používa Card iného tafu, zostane."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka se odjavi pri svojem ponudniku. Tista, ki jo uporablja Card drugega tafa, ostane."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Secila del te furnizuesi i vet. Ajo që e përdor Card-i i një taf tjetër mbahet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka se odjavljuje kod svog pružatelja. Ona koju koristi Card drugog tafa zadržava se."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละรายการจะถูกออกจากระบบที่ผู้ให้บริการของมัน รายการที่ Card ของ taf อื่นใช้อยู่จะถูกเก็บไว้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Her biri öz üpjün edijisinde çykarylýar. Başga taf-yň Card-yň ulanýany saklanýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her biri sağlayıcısında oturumdan çıkarılır. Başka bir taf'ın Card'ının kullandığı korunur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر ایک اپنے وینڈر پر سائن آؤٹ ہوتا ہے۔ جسے کسی اور taf کا Card استعمال کرتا ہے وہ رکھا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi kết nối được đăng xuất tại nhà cung cấp của nó. Kết nối mà Card của một taf khác đang dùng sẽ được giữ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一項都會在其服務供應商處登出。其他 taf 的 Card 正在使用的項目會保留。"
          }
        }
      }
    },
