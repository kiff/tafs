        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bot écoute toujours : la porte reste. %1$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבוט עדיין מאזין, ולכן הדלת נשארת. %1$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बॉट अब भी सुनता है, इसलिए द्वार रहता है। %1$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot i dalje osluškuje pa vrata ostaju. %1$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bot még figyel, ezért az ajtó marad. %1$@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բոտը դեռ լսում է, ուստի դուռը մնում է։ %1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot masih mendengarkan, jadi pintu tetap ada. %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bot ascolta ancora, quindi la porta resta. %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットがまだ受信しているため、窓口は残ります。%1$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბოტი მაინც უსმენს, ამიტომ კარი რჩება. %1$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បុតនៅតែស្តាប់ ដូច្នេះទ្វារនៅដដែល។ %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "봇이 아직 듣고 있어 창구가 유지됩니다. %1$@"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບອດຍັງຟັງຢູ່ ສະນັ້ນປະຕູຍັງຢູ່. %1$@"
