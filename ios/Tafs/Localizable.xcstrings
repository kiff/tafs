          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnost kódu vypršela dřív, než byl v prohlížeči schválen. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code ist abgelaufen, bevor er in deinem Browser genehmigt wurde. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code expired before it was approved in your browser. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código caducó antes de aprobarse en tu navegador. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kood aegus enne, kui see brauseris kinnitati. Proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code a expiré avant d'être approuvé dans votre navigateur. Réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôd je istekao prije nego što je odobren u pregledniku. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kód lejárt, mielőtt jóváhagytad volna a böngészőben. Próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կոդի ժամկետը լրացավ, նախքան այն բրաուզերում հաստատվեր։ Փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode kedaluwarsa sebelum disetujui di browser Anda. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice è scaduto prima di essere approvato nel browser. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで承認される前にコードの有効期限が切れました。もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კოდის ვადა ამოიწურა, სანამ ბრაუზერში დამტკიცდებოდა. სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
