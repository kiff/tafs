        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena je napravljena, ali je nije bilo moguće pročitati natrag. Dodirnite da ponovno pročitate brojčanik."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosítás megtörtént, de nem sikerült visszaolvasni. Koppints a tárcsa újraolvasásához."
