    "watch.no_offline_speech": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Handy kann Gesprochenes in dieser Sprache nicht selbst in Text umwandeln. Tipp stattdessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone can't turn speech into text in this language by itself. Type instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono no puede pasar la voz a texto por sí solo en este idioma. Escribe en su lugar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon ei saa selles keeles kõnet ise tekstiks muuta. Kirjuta hoopis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléphone ne peut pas transformer seul la parole en texte dans cette langue. Écrivez plutôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono non può trasformare da solo la voce in testo in questa lingua. Scrivi invece."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語では、スマートフォンだけで音声をテキストに変換できません。代わりに入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 언어에서는 휴대폰이 자체적으로 음성을 텍스트로 변환할 수 없습니다. 대신 입력하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų telefonas pats negali paversti šios kalbos tekstu. Verčiau rašykite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavs tālrunis pats nevar pārvērst runu tekstā šajā valodā. Tā vietā raksti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon kan spraak in deze taal niet zelf omzetten in tekst. Typ in plaats daarvan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon nie potrafi sam zamienić mowy na tekst w tym języku. Napisz zamiast tego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O telemóvel não consegue converter sozinho a voz em texto neste idioma. Escreva em vez disso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular não consegue converter sozinho a voz em texto neste idioma. Escreva em vez disso."
          }
        }
      }
    },
    "watch.not_sure": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unklar, ob es ankam"
