    "error.on_our_side": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin tərəfdə etməli heç nə yoxdur; biz bununla məşğuluq."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
