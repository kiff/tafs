    "needs_you.refused.approver_only": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabda saxlanılan çağırışlara yalnız təsdiqləyici cavab verir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В този акаунт на задържани заявки отговаря само одобряващ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zadržená volání v tomto účtu odpovídá jen schvalovatel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Konto beantwortet nur ein Genehmiger zurückgehaltene Aufrufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an approver answers held calls on this account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta cuenta, solo un aprobador responde a las llamadas retenidas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellel kontol vastab kinni peetud päringutele ainult kinnitaja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un approbateur répond aux appels retenus sur ce compte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zadržane pozive na ovom računu odgovara samo odobravatelj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebben a fiókban a visszatartott hívásokra csak jóváhagyó válaszolhat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հաշվում պահված զանգերին պատասխանում է միայն հաստատողը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya penyetuju yang menjawab panggilan yang ditahan di akun ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo account solo un approvatore risponde alle chiamate trattenute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントでは、保留中の呼び出しには承認者のみが回答します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ანგარიშზე დაკავებულ ზარებს მხოლოდ დამმტკიცებელი პასუხობს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에서는 승인자만 보류된 호출에 답변합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šioje paskyroje į sulaikytas užklausas atsako tik tvirtintojas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šajā kontā uz aizturētiem izsaukumiem atbild tikai apstiprinātājs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een goedkeurder beantwoordt vastgehouden aanroepen in dit account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym koncie na oczekujące wywołania odpowiada tylko zatwierdzający."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta conta, só um aprovador responde a chamadas retidas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta conta, só um aprovador responde a chamadas retidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar un aprobator răspunde la apelurile reținute în acest cont."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na pozdržané volania v tomto účte odpovedá len schvaľovateľ."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zadržane klice v tem računu odgovarja samo odobritelj."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetëm një miratues u përgjigjet thirrjeve të mbajtura në këtë llogari."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zadržane pozive na ovom nalogu odgovara samo odobravatelj."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะผู้อนุมัติเท่านั้นที่ตอบการเรียกที่ถูกพักไว้ในบัญชีนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesapta tutulan çağrıları yalnızca bir onaylayıcı yanıtlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ người phê duyệt mới trả lời các lệnh gọi bị giữ trên tài khoản này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號中只有核准者能回覆已保留的呼叫。"
          }
        }
      }
    },
    "needs_you.refused.card_changer": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun saxlandığı Card-ı siz dəyişdiniz, ona görə ona başqa təsdiqləyici cavab verir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вие променихте Card, според която това беше задържано, затова отговаря друг одобряващ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změnili jste Card, podle které se to zadrželo, takže odpoví jiný schvalovatel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Card geändert, an der das zurückgehalten wurde, daher beantwortet es ein anderer Genehmiger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You changed the Card this was held against, so another approver answers it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiaste la Card por la que esto quedó retenido, así que lo responde otro aprobador."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sina muutsid Cardi, mille alusel see kinni peeti, seega vastab sellele teine kinnitaja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez modifié la Card par rapport à laquelle ceci a été retenu : un autre approbateur y répond donc."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promijenili ste Card prema kojem je ovo zadržano pa odgovara drugi odobravatelj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Te módosítottad a Cardot, amely alapján ez vissza lett tartva, ezért egy másik jóváhagyó válaszol rá."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դուք փոխել եք Card-ը, որի դեմ սա պահվեց, ուստի դրան պատասխանում է մեկ այլ հաստատող։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda mengubah Card tempat ini ditahan, jadi penyetuju lain yang menjawabnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai modificato la Card in base alla quale questa è stata trattenuta, quindi risponde un altro approvatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留の根拠となったCardをあなたが変更したため、別の承認者が回答します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენ შეცვალეთ Card, რომლის წინააღმდეგაც ეს დაკავდა, ამიტომ მას სხვა დამმტკიცებელი პასუხობს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 호출이 보류된 Card를 내가 변경했으므로 다른 승인자가 답변합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakeitėte Card, pagal kurią tai sulaikyta, todėl atsako kitas tvirtintojas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mainīji Card, pret kuru tas tika aizturēts, tāpēc uz to atbild cits apstiprinātājs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de Card gewijzigd waartegen dit werd vastgehouden, dus een andere goedkeurder beantwoordt het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Card, przez którą to wywołanie jest oczekujące, została zmieniona przez Ciebie, więc odpowiada na nie inny zatwierdzający."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterou o Card com base no qual isto foi retido, por isso é outro aprovador que responde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterou o Card com base no qual isto foi retido, por isso é outro aprovador que responde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ați schimbat Cardul pe baza căruia a fost reținut, așa că răspunde alt aprobator."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmenili ste Card, podľa ktorej sa to pozdržalo, takže odpovie iný schvaľovateľ."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremenili ste Card, po kateri je bilo to zadržano, zato odgovori drug odobritelj."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ju e ndryshuat Card-in kundrejt të cilit u mbajt kjo, ndaj i përgjigjet një miratues tjetër."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Promenili ste Card prema kom je ovo zadržano pa odgovara drugi odobravatelj."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเปลี่ยน Card ที่รายการนี้ถูกพักไว้ตามนั้น ผู้อนุมัติคนอื่นจึงตอบรายการนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun tutulduğu Card'ı siz değiştirdiniz, bu yüzden başka bir onaylayıcı yanıtlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đổi Card mà việc này bị giữ theo, nên một người phê duyệt khác sẽ trả lời."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您變更了這項保留所依據的 Card，因此由另一位核准者回覆。"
          }
        }
      }
    },
    "needs_you.refused.check_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kimin cavab verə biləcəyini indi yoxlaya bilmədi. Yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF не можа да провери кой може да отговори в момента. Опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF teď nemohl ověřit, kdo smí odpovědět. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF konnte gerade nicht prüfen, wer antworten darf. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF couldn't check who may answer just now. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no pudo comprobar ahora mismo quién puede responder. Vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei saanud praegu kontrollida, kes tohib vastata. Proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas pu vérifier qui peut répondre pour le moment. Réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF trenutačno nije mogao provjeriti tko smije odgovoriti. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF most nem tudta ellenőrizni, ki válaszolhat. Próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը հիմա չկարողացավ ստուգել, թե ով կարող է պատասխանել։ Փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF tidak dapat memeriksa siapa yang boleh menjawab saat ini. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non è riuscito a verificare chi può rispondere in questo momento. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFは現在、誰が回答できるかを確認できませんでした。もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-მა ახლა ვერ შეამოწმა, ვის შეუძლია პასუხი. სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 KIFF가 누가 답변할 수 있는지 확인하지 못했습니다. 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF šiuo metu nepavyko patikrinti, kas gali atsakyti. Bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF pašlaik nevarēja pārbaudīt, kas drīkst atbildēt. Mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kon nu niet controleren wie mag antwoorden. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie mógł teraz sprawdzić, kto może odpowiedzieć. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não conseguiu verificar neste momento quem pode responder. Tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não conseguiu verificar neste momento quem pode responder. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nu a putut verifica acum cine poate răspunde. Încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF teraz nemohol overiť, kto smie odpovedať. Skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF trenutno ni mogel preveriti, kdo sme odgovoriti. Poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nuk mundi të kontrollojë tani kush mund të përgjigjet. Provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF trenutno nije mogao proveriti ko sme odgovoriti. Pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ KIFF ตรวจสอบไม่ได้ว่าใครตอบได้ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF kimin yanıtlayabileceğini şu anda kontrol edemedi. Tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hiện không kiểm tra được ai được phép trả lời. Hãy thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF 目前無法確認誰可以回覆。請再試一次。"
          }
        }
      }
    },
