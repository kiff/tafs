        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chiave di sicurezza non può verificare un PIN, quindi non può approvare. Collega quella che va con questo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセキュリティキーはPINを確認できないため、承認できません。このコンピュータ用のキーを差し込んでください。"
