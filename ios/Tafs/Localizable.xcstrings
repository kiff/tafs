    "billing.conversation_goes_plan_tools_being": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع تقدّم المحادثة، تظهر هنا الخطة والتطبيقات التي يجري ربطها وCard الخاصة بالـ taf."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Söhbət irəlilədikcə plan, qoşulan tətbiqlər və taf-ın Card-ı burada görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "С напредването на разговора тук се показват планът, свързваните приложения и Card на taf."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কথোপকথন এগোলে পরিকল্পনা, সংযুক্ত হওয়া অ্যাপ এবং taf-এর Card এখানে দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesura que avança la conversa, aquí es mostren el pla, les aplicacions que es connecten i el Card del taf."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak rozhovor pokračuje, zobrazuje se tu plán, připojované aplikace a Card tafu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während des Gesprächs erscheinen hier der Plan, die Apps, die verbunden werden, und die Card des tafs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As the conversation goes, the plan, the apps being connected and the taf's Card show here."
