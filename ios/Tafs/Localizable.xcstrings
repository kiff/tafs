    "sign_in.tafs_had_no_window_screen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs hatte kein Fenster auf dem Bildschirm, über dem sich die Anmeldung öffnen konnte. Öffne tafs und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs had no window on screen to open the sign-in over. Open tafs and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs no tenía ninguna ventana en pantalla sobre la que abrir el inicio de sesión. Abre tafs y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "tafsil polnud ekraanil akent, mille peale sisselogimist avada. Ava tafs ja proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs n'avait aucune fenêtre à l'écran pour y ouvrir la connexion. Ouvrez tafs et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs non aveva una finestra sullo schermo su cui aprire l'accesso. Apri tafs e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインを開くためのtafsのウインドウが画面にありませんでした。tafsを開いてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 창을 띄울 tafs 창이 화면에 없었습니다. tafs를 열고 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs neturėjo ekrane lango, virš kurio atidaryti prisijungimą. Atidarykite tafs ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs ekrānā nebija loga, virs kura atvērt pierakstīšanos. Atver tafs un mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs had geen venster op het scherm om de login over te openen. Open tafs en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tafs nie miał na ekranie okna, nad którym mógłby otworzyć logowanie. Otwórz tafs i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não tinha nenhuma janela no ecrã sobre a qual abrir o início de sessão. Abra o tafs e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tafs não tinha nenhuma janela na tela sobre a qual abrir o login. Abra o tafs e tente novamente."
          }
        }
      }
    },
