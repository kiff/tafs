    "needs_you.refused.role": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rolle in diesem Konto beantwortet keine zurückgehaltenen Aufrufe. Jemand, der darin genehmigt, schon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your role on this account doesn't answer held calls. Someone who approves on it does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rol en esta cuenta no responde a llamadas retenidas. Lo hace quien aprueba en ella."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu roll sellel kontol ei vasta kinni peetud päringutele. Seda teeb keegi, kes sellel kinnitab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rôle sur ce compte ne répond pas aux appels retenus. Une personne qui y approuve le fait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ruolo in questo account non risponde alle chiamate trattenute. Lo fa chi approva nell'account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントでのあなたの役割では、保留中の呼び出しに回答できません。承認権限のある人が回答します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에서 내 역할로는 보류된 호출에 답변하지 않습니다. 이 계정의 승인자가 답변합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų vaidmuo šioje paskyroje neatsako į sulaikytas užklausas. Atsako tas, kas joje tvirtina."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tava loma šajā kontā neatbild uz aizturētiem izsaukumiem. To dara tas, kurš tajā apstiprina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je rol in dit account beantwoordt geen vastgehouden aanroepen. Iemand die erin goedkeurt wel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja rola na tym koncie nie odpowiada na oczekujące wywołania. Robi to osoba zatwierdzająca na tym koncie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua função nesta conta não responde a chamadas retidas. Quem aprova nela responde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua função nesta conta não responde a chamadas retidas. Quem aprova nela responde."
          }
        }
      }
    },
    "needs_you.refused.self_review": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast darum gebeten, daher genehmigt es jemand anderes im Konto. Ablehnen kannst du es trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You asked for this, so someone else on the account approves it. You can still refuse it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú lo pediste, así que lo aprueba otra persona de la cuenta. Aún puedes rechazarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sina palusid seda, seega kinnitab selle keegi teine kontol. Keelduda võid ikkagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous l'avez demandé : quelqu'un d'autre sur le compte l'approuve donc. Vous pouvez toujours le refuser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hai chiesto tu, quindi la approva qualcun altro nell'account. Puoi comunque rifiutarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはあなたが依頼したものなので、アカウントの別の人が承認します。拒否することはできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 요청한 것이므로 계정의 다른 사람이 승인합니다. 거절은 할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "To prašėte jūs, todėl tvirtina kitas paskyros narys. Atmesti vis tiek galite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu to lūdzi, tāpēc to apstiprina kāds cits šajā kontā. Tu joprojām vari to atteikt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt hier zelf om gevraagd, dus iemand anders in het account keurt het goed. Je kunt het nog wel weigeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prośba pochodzi od Ciebie, więc zatwierdza to ktoś inny na koncie. Nadal możesz to odrzucić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi você que pediu isto, por isso é outra pessoa da conta que o aprova. Pode ainda assim recusá-lo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi você que pediu isto, por isso é outra pessoa da conta que o aprova. Pode ainda assim recusá-lo."
          }
        }
      }
    },
    "needs_you.refused.signed_in_approver": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgehaltene Aufrufe beantwortet ein angemeldeter Genehmiger, nicht ein Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held calls are answered by an approver signed in, not by a key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas retenidas las responde un aprobador con la sesión iniciada, no una clave."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinni peetud päringutele vastab sisse logitud kinnitaja, mitte võti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels retenus sont traités par un approbateur connecté, pas par une clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle chiamate trattenute risponde un approvatore che ha effettuato l'accesso, non una chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中の呼び出しには、キーではなく、サインインした承認者が回答します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류된 호출은 키가 아니라 로그인한 승인자가 답변합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Į sulaikytas užklausas atsako prisijungęs tvirtintojas, o ne raktas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz aizturētiem izsaukumiem atbild pierakstījies apstiprinātājs, nevis atslēga."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastgehouden aanroepen worden beantwoord door een ingelogde goedkeurder, niet door een sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na oczekujące wywołania odpowiada zalogowany zatwierdzający, a nie klucz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas retidas são respondidas por um aprovador com sessão iniciada, não por uma chave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas retidas são respondidas por um aprovador conectado à conta, não por uma chave."
          }
        }
      }
    },
