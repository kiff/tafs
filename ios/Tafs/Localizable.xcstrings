            "state": "translated",
            "value": "Vaš odgovor ni uspel. %1$@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigjja juaj nuk kaloi. %1$@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš odgovor nije prošao. %1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบของคุณไม่สำเร็จ %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtınız iletilmedi. %1$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời của bạn không thành công. %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的回覆未成功。%1$@"
          }
        }
      }
    },
    "needs_you.your_step.not_answered_unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cavab verilmədi: təsdiqlənmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без отговор: не беше потвърдено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez odpovědi: nebylo potvrzeno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht beantwortet: Es wurde nicht bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not answered: it wasn't confirmed."
          }
        },
        "es": {
