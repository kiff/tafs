    "coach.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne eine App für deinen taf, etwa deinen Zahlungsanbieter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name an app for your taf, like your payment provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra una app para tu taf, como tu proveedor de pagos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeta oma tafile rakendus, näiteks oma makseteenuse pakkuja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez une app pour votre taf, comme votre prestataire de paiement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un'app per il tuo taf, come il tuo fornitore di pagamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決済サービスなど、tafに使うアプリを指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf가 쓸 앱을 말하세요. 예: 결제 서비스."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nurodykite programėlę savo taf, pavyzdžiui, savo mokėjimų paslaugą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosauc lietotni savam taf, piemēram, savu maksājumu nodrošinātāju."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noem een app voor je taf, zoals je betaalprovider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj aplikację dla swojego tafa, np. Twojego dostawcę płatności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique uma app para o seu taf, como o seu fornecedor de pagamentos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique um app para o seu taf, como o seu fornecedor de pagamentos."
          }
        }
      }
