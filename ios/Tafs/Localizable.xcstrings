        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje: %1$@. Promenite jezik"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเขียนตามคำบอกใน%1$@ สลับภาษา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte dili: %1$@. Dili değiştir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả bằng %1$@. Đổi ngôn ngữ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@聽寫。切換語言"
          }
        }
      }
    },
    "voice.dictation_not_add_keyboard_dictation": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səsli yazma bu %1$@ üzərində hələ aktiv deyil. Parametrlər › Əsas › Klaviatura › Klaviaturalar bölməsində səsli yazması aktiv olan klaviatura əlavə edin, dilinin yüklənməsini gözləyin, sonra yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовката още не е включена на този %1$@. Добавете клавиатура с включена диктовка в Настройки › Общи › Клавиатура › Клавиатури, изчакайте езикът ѝ да се изтегли и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktování na tomto zařízení (%1$@) zatím není. V Nastavení › Obecné › Klávesnice › Klávesnice přidejte klávesnici se zapnutým diktováním, počkejte, až se stáhne její jazyk, a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren ist auf diesem %1$@ noch nicht verfügbar. Füge unter Einstellungen › Allgemein › Tastatur › Tastaturen eine Tastatur mit aktiviertem Diktieren hinzu, warte, bis ihre Sprache geladen ist, und versuch es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation isn't on this %1$@ yet. Add a keyboard with dictation on in Settings › General › Keyboard › Keyboards, wait for its language to download, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado aún no está en este %1$@. Añade un teclado con el dictado activado en Ajustes › General › Teclado › Teclados, espera a que se descargue su idioma y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimine pole selles seadmes (%1$@) veel sees. Lisa dikteerimisega klaviatuur menüüs Settings › General › Keyboard › Keyboards, oota, kuni selle keel alla laaditakse, ja proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée n'est pas encore disponible sur %2$@. Ajoutez un clavier avec la dictée activée dans Réglages › Général › Clavier › Claviers, attendez le téléchargement de sa langue, puis réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje još nije uključeno na ovom uređaju (%1$@). Dodajte tipkovnicu s uključenim diktiranjem u Postavke › Općenito › Tipkovnica › Tipkovnice, pričekajte da se preuzme njezin jezik, pa pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálás ezen az eszközön (%1$@) még nincs bekapcsolva. Adj hozzá egy billentyűzetet bekapcsolt diktálással itt: Beállítások › Általános › Billentyűzet › Billentyűzetek, várd meg, amíg a nyelve letöltődik, majd próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թելադրումը այս սարքում (%1$@) դեռ չկա։ Ավելացրեք ստեղնաշար՝ թելադրումը միացված, Կարգավորումներ › Ընդհանուր › Ստեղնաշար › Ստեղնաշարեր, սպասեք նրա լեզվի ներբեռնմանը, ապա նորից փորձեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte belum aktif di %1$@ ini. Tambahkan papan ketik dengan dikte aktif di Pengaturan › Umum › Papan Ketik › Papan Ketik, tunggu bahasanya terunduh, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura non è ancora attiva su questo %1$@. Aggiungi una tastiera con la dettatura attiva in Impostazioni › Generali › Tastiera › Tastiere, attendi che la sua lingua venga scaricata, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%1$@ではまだ音声入力がオンになっていません。設定 › 一般 › キーボード › キーボードで音声入力がオンのキーボードを追加し、言語のダウンロードを待ってから、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კარნახი ამ მოწყობილობაზე (%1$@) ჯერ არ არის. დაამატეთ კლავიატურა ჩართული კარნახით პარამეტრები › ზოგადი › კლავიატურა › კლავიატურები, დაელოდეთ მისი ენის ჩამოტვირთვას, შემდეგ სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %1$@에서 아직 받아쓰기가 켜져 있지 않습니다. 설정 › 일반 › 키보드 › 키보드에서 받아쓰기가 켜진 키보드를 추가하고, 언어가 다운로드될 때까지 기다린 후 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiame įrenginyje (%1$@) diktavimas dar neįjungtas. Pridėkite klaviatūrą su įjungtu diktavimu skiltyje Nustatymai › Bendrieji › Klaviatūra › Klaviatūros, palaukite, kol atsisiųs jos kalba, ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šajā ierīcē (%1$@) diktēšana vēl nav ieslēgta. Pievieno tastatūru ar ieslēgtu diktēšanu sadaļā Iestatījumi › Vispārīgi › Tastatūra › Tastatūras, pagaidi, līdz tās valoda lejupielādējas, tad mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren staat nog niet aan op deze %1$@. Voeg een toetsenbord met dicteren toe in Instellingen › Algemeen › Toetsenbord › Toetsenborden, wacht tot de taal is gedownload en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie nie jest jeszcze dostępne na tym urządzeniu (%1$@). Dodaj klawiaturę z włączonym dyktowaniem w Ustawienia › Ogólne › Klawiatura › Klawiatury, poczekaj na pobranie jej języka, a potem spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado ainda não está disponível neste %1$@. Adicione um teclado com o ditado ativado em Definições › Geral › Teclado › Teclados, aguarde que o idioma seja descarregado e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado ainda não está disponível neste %1$@. Adicione um teclado com o ditado ativado em Ajustes › Geral › Teclado › Teclados, aguarde o download do idioma e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictarea nu este încă activă pe acest dispozitiv (%1$@). Adăugați o tastatură cu dictarea activată în Configurări › General › Tastatură › Tastaturi, așteptați să se descarce limba ei, apoi încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktovanie na tomto zariadení (%1$@) zatiaľ nie je. V Nastaveniach › Všeobecné › Klávesnica › Klávesnice pridajte klávesnicu so zapnutým diktovaním, počkajte, kým sa stiahne jej jazyk, a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narekovanje na tej napravi (%1$@) še ni vklopljeno. V Nastavitve › Splošno › Tipkovnica › Tipkovnice dodajte tipkovnico z vklopljenim narekovanjem, počakajte, da se njen jezik prenese, in poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktimi nuk është ende në këtë pajisje (%1$@). Shtoni një tastierë me diktimin aktiv te Cilësimet › Të përgjithshme › Tastiera › Tastierat, prisni të shkarkohet gjuha e saj, pastaj provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje još nije uključeno na ovom uređaju (%1$@). Dodajte tipkovnicu s uključenim diktiranjem u Podešavanja › Uopšteno › Tipkovnica › Tipkovnice, pričekajte da se preuzme njen jezik, pa pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@เครื่องนี้ยังไม่ได้เปิดการเขียนตามคำบอก เพิ่มแป้นพิมพ์ที่เปิดการเขียนตามคำบอกไว้ในการตั้งค่า › ทั่วไป › แป้นพิมพ์ › แป้นพิมพ์ รอให้ภาษาของมันดาวน์โหลด แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte bu %1$@ üzerinde henüz açık değil. Ayarlar › Genel › Klavye › Klavyeler'den dikteyi açık bir klavye ekleyin, dilinin inmesini bekleyin, sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả chưa bật trên %1$@ này. Hãy thêm một bàn phím có bật đọc chính tả trong Cài đặt › Cài đặt chung › Bàn phím › Bàn phím, chờ ngôn ngữ của nó tải xong, rồi thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部%1$@尚未開啟聽寫。請在「設定」›「一般」›「鍵盤」›「鍵盤」中新增已開啟聽寫的鍵盤，等待其語言下載完成，然後再試一次。"
          }
        }
      }
    },
    "voice.dictation_not_add_keyboard_dictation_mac": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səsli yazma bu Mac üçün hələ aktiv deyil. Onu Sistem parametrləri › Klaviatura › Səsli yazma bölməsində aktiv edin (macOS 12-də: Sistem tərcihləri › Klaviatura › Səsli yazma), dilinin yüklənməsini gözləyin, sonra yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовката още не е включена на този Mac. Включете я в Системни настройки › Клавиатура › Диктовка (на macOS 12: Системни предпочитания › Клавиатура › Диктовка), изчакайте езикът ѝ да се изтегли и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktování na tomto Macu zatím není zapnuté. Zapněte ho v Nastavení systému › Klávesnice › Diktování (v macOS 12: Předvolby systému › Klávesnice › Diktování), počkejte, až se stáhne jeho jazyk, a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren ist auf diesem Mac noch nicht aktiviert. Aktiviere es unter Systemeinstellungen › Tastatur › Diktieren (unter macOS 12: Systemeinstellungen › Tastatur › Diktieren), warte, bis die Sprache geladen ist, und versuch es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation isn't on for this Mac yet. Turn it on in System Settings › Keyboard › Dictation (on macOS 12: System Preferences › Keyboard › Dictation), wait for its language to download, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado aún no está activado en este Mac. Actívalo en Ajustes del Sistema › Teclado › Dictado (en macOS 12: Preferencias del Sistema › Teclado › Dictado), espera a que se descargue su idioma y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimine pole selles Macis veel sees. Lülita see sisse menüüs System Settings › Keyboard › Dictation (macOS 12-s: System Preferences › Keyboard › Dictation), oota, kuni selle keel alla laaditakse, ja proovi uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée n'est pas encore activée sur ce Mac. Activez-la dans Réglages Système › Clavier › Dictée (sous macOS 12 : Préférences Système › Clavier › Dictée), attendez le téléchargement de sa langue, puis réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje još nije uključeno na ovom Macu. Uključite ga u Postavke sustava › Tipkovnica › Diktiranje (macOS 12: Postavke sustava › Tipkovnica › Diktiranje), pričekajte da se preuzme njegov jezik, pa pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálás ezen a Macen még nincs bekapcsolva. Kapcsold be itt: Rendszerbeállítások › Billentyűzet › Diktálás (macOS 12-n: Rendszerbeállítások › Billentyűzet › Diktálás), várd meg, amíg a nyelve letöltődik, majd próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թելադրումը այս Mac-ում դեռ միացված չէ։ Միացրեք՝ Համակարգի կարգավորումներ › Ստեղնաշար › Թելադրում (macOS 12-ում՝ Համակարգի նախապատվություններ › Ստեղնաշար › Թելադրում), սպասեք նրա լեզվի ներբեռնմանը, ապա նորից փորձեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte belum aktif di Mac ini. Aktifkan di Pengaturan Sistem › Papan Ketik › Dikte (di macOS 12: Preferensi Sistem › Papan Ketik › Dikte), tunggu bahasanya terunduh, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura non è ancora attiva su questo Mac. Attivala in Impostazioni di Sistema › Tastiera › Dettatura (su macOS 12: Preferenze di Sistema › Tastiera › Dettatura), attendi che la sua lingua venga scaricata, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macでは音声入力がまだオンになっていません。システム設定 › キーボード › 音声入力でオンにし（macOS 12：システム環境設定 › キーボード › 音声入力）、言語のダウンロードを待ってから、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კარნახი ამ Mac-ზე ჯერ ჩართული არ არის. ჩართეთ სისტემის პარამეტრები › კლავიატურა › კარნახი (macOS 12-ზე: სისტემის პარამეტრები › კლავიატურა › კარნახი), დაელოდეთ მისი ენის ჩამოტვირთვას, შემდეგ სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서는 아직 받아쓰기가 켜져 있지 않습니다. 시스템 설정 › 키보드 › 받아쓰기에서 켜고(macOS 12: 시스템 환경설정 › 키보드 › 받아쓰기), 언어가 다운로드될 때까지 기다린 후 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiame Mac diktavimas dar neįjungtas. Įjunkite jį skiltyje Sistemos nustatymai › Klaviatūra › Diktavimas (macOS 12: Sistemos nuostatos › Klaviatūra › Diktavimas), palaukite, kol atsisiųs jo kalba, ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šim Mac diktēšana vēl nav ieslēgta. Ieslēdz to sadaļā Sistēmas iestatījumi › Tastatūra › Diktēšana (macOS 12: Sistēmas preferences › Tastatūra › Diktēšana), pagaidi, līdz tās valoda lejupielādējas, tad mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren staat nog niet aan op deze Mac. Zet het aan in Systeeminstellingen › Toetsenbord › Dicteren (op macOS 12: Systeemvoorkeuren › Toetsenbord › Dicteren), wacht tot de taal is gedownload en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie nie jest jeszcze włączone na tym Macu. Włącz je w Ustawienia systemowe › Klawiatura › Dyktowanie (w macOS 12: Preferencje systemowe › Klawiatura › Dyktowanie), poczekaj na pobranie jego języka, a potem spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado ainda não está ativado neste Mac. Ative-o em Definições do Sistema › Teclado › Ditado (no macOS 12: Preferências do Sistema › Teclado › Ditado), aguarde que o idioma seja descarregado e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado ainda não está ativado neste Mac. Ative-o em Ajustes do Sistema › Teclado › Ditado (no macOS 12: Preferências do Sistema › Teclado › Ditado), aguarde o download do idioma e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictarea nu este încă activă pe acest Mac. Activați-o în Configurări sistem › Tastatură › Dictare (pe macOS 12: Preferințe sistem › Tastatură › Dictare), așteptați să se descarce limba ei, apoi încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktovanie na tomto Macu zatiaľ nie je zapnuté. Zapnite ho v Nastaveniach systému › Klávesnica › Diktovanie (v macOS 12: Systémové nastavenia › Klávesnica › Diktovanie), počkajte, kým sa stiahne jeho jazyk, a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narekovanje na tem Macu še ni vklopljeno. Vklopite ga v Sistemske nastavitve › Tipkovnica › Narekovanje (v macOS 12: Sistemske nastavitve › Tipkovnica › Narekovanje), počakajte, da se njegov jezik prenese, in poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktimi nuk është ende aktiv për këtë Mac. Aktivizojeni te Cilësimet e Sistemit › Tastiera › Diktimi (në macOS 12: Preferencat e Sistemit › Tastiera › Diktimi), prisni të shkarkohet gjuha e tij, pastaj provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje još nije uključeno na ovom Macu. Uključite ga u Podešavanja sistema › Tipkovnica › Diktiranje (macOS 12: Podešavanja sistema › Tipkovnica › Diktiranje), pričekajte da se preuzme njegov jezik, pa pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้ยังไม่ได้เปิดการเขียนตามคำบอก เปิดได้ที่การตั้งค่าระบบ › แป้นพิมพ์ › การป้อนด้วยเสียง (บน macOS 12: ค่ากำหนดระบบ › แป้นพิมพ์ › การป้อนด้วยเสียง) รอให้ภาษาของมันดาวน์โหลด แล้วลองอีกครั้ง."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte bu Mac'te henüz açık değil. Sistem Ayarları › Klavye › Dikte'den açın (macOS 12'de: Sistem Tercihleri › Klavye › Dikte), dilinin inmesini bekleyin, sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả chưa bật trên Mac này. Hãy bật nó trong Cài đặt Hệ thống › Bàn phím › Đọc chính tả (trên macOS 12: Tùy chọn Hệ thống › Bàn phím › Đọc chính tả), chờ ngôn ngữ của nó tải xong, rồi thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 尚未開啟聽寫。請在「系統設定」›「鍵盤」›「聽寫」中開啟（macOS 12：「系統偏好設定」›「鍵盤」›「聽寫」），等待其語言下載完成，然後再試一次。"
          }
        }
      }
    },
    "voice.dictation_not_available_right_try": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səsli yazma hazırda mövcud deyil. Bir azdan yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовката не е налична в момента. Опитайте отново след малко."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktování teď není k dispozici. Zkuste to za chvíli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren ist gerade nicht verfügbar. Versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation isn't available right now. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado no está disponible ahora mismo. Vuelve a intentarlo en un momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimine pole praegu saadaval. Proovi hetke pärast uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée n'est pas disponible pour le moment. Réessayez dans un instant."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje trenutačno nije dostupno. Pokušajte ponovno za trenutak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálás most nem érhető el. Próbáld újra egy kicsit később."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թելադրումը հիմա հասանելի չէ։ Փորձեք մի պահ անց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte tidak tersedia saat ini. Coba lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura non è disponibile in questo momento. Riprova tra un attimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、音声入力は使用できません。少し待ってからもう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კარნახი ახლა მიუწვდომელია. სცადეთ ცოტა ხანში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 받아쓰기를 사용할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktavimas šiuo metu nepasiekiamas. Netrukus bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktēšana pašlaik nav pieejama. Pēc brīža mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren is nu niet beschikbaar. Probeer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie jest teraz niedostępne. Spróbuj ponownie za chwilę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado não está disponível neste momento. Tente novamente daqui a pouco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado não está disponível neste momento. Tente novamente daqui a pouco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictarea nu este disponibilă acum. Încercați din nou peste câteva momente."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktovanie teraz nie je dostupné. Skúste to o chvíľu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narekovanje trenutno ni na voljo. Poskusite čez trenutek."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktimi nuk ofrohet tani. Provoni sërish pas pak."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje trenutno nije dostupno. Pokušajte ponovo za trenutak."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ใช้การเขียนตามคำบอกไม่ได้ ลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte şu anda kullanılamıyor. Biraz sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chưa dùng được đọc chính tả. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法使用聽寫。請稍後再試。"
          }
        }
      }
    },
    "voice.dictation_stopped_tap_mic_start": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səsli yazma dayandı: %1$@ Yenidən başlamaq üçün mikrofona toxunun."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовката спря: %1$@ Докоснете микрофона, за да започнете отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktování se zastavilo: %1$@ Klepněte na mikrofon a začněte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren gestoppt: %1$@ Tippe auf das Mikrofon, um neu zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation stopped: %1$@ Tap the mic to start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado se detuvo: %1$@ Toca el micrófono para empezar de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteerimine lõppes: %1$@ Uuesti alustamiseks puuduta mikrofoni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictée arrêtée : %1$@ Touchez le micro pour recommencer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje je zaustavljeno: %1$@ Dodirnite mikrofon da počnete ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálás leállt: %1$@ Koppints a mikrofonra az újrakezdéshez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թելադրումը դադարեց՝ %1$@ Հպեք խոսափողին՝ նորից սկսելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte berhenti: %1$@ Ketuk mikrofon untuk memulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dettatura interrotta: %1$@ Tocca il microfono per ricominciare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力が停止しました：%1$@ もう一度始めるにはマイクをタップしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კარნახი შეწყდა: %1$@ შეეხეთ მიკროფონს ხელახლა დასაწყებად."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기가 멈췄습니다: %1$@ 다시 시작하려면 마이크를 탭하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktavimas sustojo: %1$@ Palieskite mikrofoną, kad pradėtumėte iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktēšana apstājās: %1$@ Pieskaries mikrofonam, lai sāktu vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren gestopt: %1$@ Tik op de microfoon om opnieuw te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie zatrzymane: %1$@ Dotknij mikrofonu, aby zacząć ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado parou: %1$@ Toque no microfone para recomeçar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado parou: %1$@ Toque no microfone para recomeçar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictarea s-a oprit: %1$@ Atingeți microfonul pentru a reporni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktovanie sa zastavilo: %1$@ Ťuknite na mikrofón a začnite znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narekovanje se je ustavilo: %1$@ Tapnite mikrofon in začnite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktimi u ndal: %1$@ Prekni mikrofonin për të filluar sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiranje je zaustavljeno: %1$@ Dodirnite mikrofon da počnete ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเขียนตามคำบอกหยุดแล้ว: %1$@ แตะไมค์เพื่อเริ่มใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte durdu: %1$@ Yeniden başlamak için mikrofona dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả đã dừng: %1$@ Chạm vào micrô để bắt đầu lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽寫已停止：%1$@輕點麥克風即可重新開始。"
          }
        }
      }
    },
    "voice.downloading": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon səsli yazma üçün %1$@ dilini yükləyir. Mikrofon hazır olanda, bir-iki dəqiqəyə işləyir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този телефон изтегля %1$@ за диктовка. Микрофонът ще работи, щом е готово, след минута-две."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon stahuje jazyk %1$@ pro diktování. Mikrofon bude fungovat, až bude připravený, za minutu nebo dvě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon lädt %1$@ für das Diktieren. Das Mikrofon funktioniert, sobald es bereit ist, in ein bis zwei Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone is getting %1$@ for dictation. The mic works once it's ready, in a minute or two."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono está descargando %1$@ para el dictado. El micrófono funcionará cuando esté listo, en un minuto o dos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See telefon laadib dikteerimiseks keelt %1$@. Mikrofon töötab, kui see on valmis, minuti või kahe pärast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone télécharge le %1$@ pour la dictée. Le micro fonctionnera dès qu'il sera prêt, d'ici une minute ou deux."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon preuzima jezik (%1$@) za diktiranje. Mikrofon radi čim bude spreman, za minutu ili dvije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a telefon letölti a diktáláshoz ezt a nyelvet: %1$@. A mikrofon egy-két percen belül működik, amint kész."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հեռախոսը թելադրման համար ստանում է՝ %1$@։ Խոսափողը կաշխատի, հենց պատրաստ լինի, մեկ-երկու րոպեից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini sedang mengunduh %1$@ untuk dikte. Mikrofon berfungsi setelah siap, dalam satu atau dua menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono sta scaricando %1$@ per la dettatura. Il microfono funziona appena è pronto, tra un minuto o due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンは音声入力用の%1$@を取得しています。準備ができると1〜2分でマイクが使えるようになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ტელეფონი კარნახისთვის იღებს ენას: %1$@. მიკროფონი იმუშავებს, როგორც კი მზად იქნება, ერთ-ორ წუთში."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰이 받아쓰기용 %1$@을(를) 받는 중입니다. 준비되면 1~2분 후에 마이크가 작동합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis telefonas atsisiunčia kalbą (%1$@) diktavimui. Mikrofonas veiks, kai ji bus paruošta, po minutės ar dviejų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis tālrunis lejupielādē diktēšanai valodu: %1$@. Mikrofons darbosies, kad tā būs gatava, pēc minūtes vai divām."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon downloadt %1$@ voor dicteren. De microfoon werkt zodra dat klaar is, over een minuut of twee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon pobiera język %1$@ do dyktowania. Mikrofon zadziała, gdy będzie gotowy, za minutę lub dwie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone está a obter %1$@ para o ditado. O microfone funciona quando estiver pronto, dentro de um ou dois minutos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone está obtendo %1$@ para o ditado. O microfone funciona quando estiver pronto, dentro de um ou dois minutos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest telefon descarcă limba %1$@ pentru dictare. Microfonul funcționează când e gata, în unul-două minute."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefón sťahuje jazyk %1$@ na diktovanie. Mikrofón bude fungovať, keď bude pripravený, o minútu či dve."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon prenaša jezik %1$@ za narekovanje. Mikrofon bo deloval, ko bo pripravljen, v minuti ali dveh."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky telefon po merr %1$@ për diktim. Mikrofoni funksionon sapo të jetë gati, brenda një a dy minutash."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj telefon preuzima jezik (%1$@) za diktiranje. Mikrofon radi čim bude spreman, za minutu ili dve."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์เครื่องนี้กำลังดาวน์โหลด%1$@สำหรับการเขียนตามคำบอก ไมค์จะใช้ได้เมื่อพร้อมใน 1-2 นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon dikte için %1$@ dilini indiriyor. Hazır olunca mikrofon çalışır; bir iki dakika sürer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại này đang tải %1$@ để đọc chính tả. Micrô sẽ hoạt động khi sẵn sàng, trong một hai phút."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部手機正在取得聽寫用的%1$@。準備好後麥克風即可使用，約需一兩分鐘。"
          }
        }
      }
    },
