    "receipt.if_it_stays": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا استمر هذا، أخبرنا برقم الإيصال أدناه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qalırsa, aşağıdakı qəbz identifikatorunu bizə bildirin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако това остане, изпратете ни идентификатора на разписката по-долу."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি থেকে গেলে আমাদের নিচের রসিদ আইডি জানান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si continua així, digue'ns l'identificador del rebut de sota."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud to přetrvá, pošlete nám ID potvrzení níže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das so bleibt, nenn uns die Beleg-ID unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this stays, tell us the receipt id below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esto persiste, indícanos el id del recibo de abajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui see jääb nii, teata meile allolev kviitungi ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cela persiste, communiquez-nous l'identifiant du reçu ci-dessous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם זה נשאר כך, יש לשלוח לנו את מזהה הקבלה למטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि यह बना रहे, तो हमें नीचे की रसीद id बताएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ovo ostane, javite nam ID potvrde u nastavku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ez megmarad, küldd el nekünk a lenti nyugtaazonosítót."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե սա մնա, ասեք մեզ անդորրագրի ID-ն ստորև։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ini berlanjut, beri tahu kami ID tanda terima di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se resta così, comunicaci l'id della ricevuta qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この表示が続く場合は、下の領収書IDをお知らせください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ ეს რჩება, გვითხარით ქვითრის ID ქვემოთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រសិនបើវានៅតែដូចនេះ សូមប្រាប់យើងពីលេខសម្គាល់បង្កាន់ដៃខាងក្រោម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 이렇게 표시되면 아래의 영수증 ID를 알려 주세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຖ້າມັນຍັງເປັນແບບນີ້ ບອກພວກເຮົາເລກໃບຮັບເງິນຂ້າງລຸ່ມ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei tai nepraeina, praneškite mums toliau nurodytą kvito ID."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja tas nepazūd, pasaki mums kvīts ID, kas redzams zemāk."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако ова остане, кажи ни го идентификаторот на признаницата подолу."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэрэв энэ хэвээр байвал доорх баримтын дугаарыг бидэнд хэлнэ үү."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो यथावत् रह्यो भने तल रसिद आईडी हामीलाई भन्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft dit zo, geef ons dan de id van het ontvangstbewijs hieronder door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli to się utrzyma, podaj nam identyfikator potwierdzenia poniżej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se isto persistir, indique-nos o ID do recibo abaixo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se isto persistir, indique-nos o ID do recibo abaixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă persistă, trimiteți-ne ID-ul chitanței de mai jos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak to pretrvá, pošlite nám ID potvrdenia nižšie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če to ostane, nam sporočite spodnji ID potrdila."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse kjo mbetet, na tregoni ID-në e dëftesës më poshtë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ovo ostane, javite nam ID potvrde u nastavku."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากยังเป็นเช่นนี้ โปรดแจ้งรหัสใบเสร็จด้านล่างให้เรา"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Eger bu galsa, aşakdaky kwitansiýa id-sini bize aýdyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu devam ederse aşağıdaki makbuz kimliğini bize bildirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر یہ برقرار رہے تو ہمیں نیچے رسید کی id بتائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu vẫn như vậy, hãy báo cho chúng tôi mã biên nhận bên dưới."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若仍是如此，請將下方的收據編號告訴我們。"
          }
        }
      }
    },
