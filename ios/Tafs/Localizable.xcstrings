          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko. Niekas neprijungta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās. Nekas netika pievienots."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is niet gelukt. Er is niets gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
