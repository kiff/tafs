            "value": "L'import d'aquesta línia no coincideix amb el rebut de KIFF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částka na tomto řádku neodpovídá potvrzení od KIFF."
          }
