    "sign_in.not_signed_out": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei KIFF noch nicht abgemeldet. Versuch es erneut oder melde dieses Telefon über „Geräte“ auf einem anderen Gerät ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed out at KIFF yet. Try again, or sign this phone out from another device's Devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha cerrado la sesión en KIFF. Vuelve a intentarlo, o cierra la sesión de este teléfono desde Dispositivos en otro dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFis pole veel välja logitud. Proovi uuesti või logi see telefon välja teise seadme vaatest Seadmed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore déconnecté de KIFF. Réessayez, ou déconnectez ce téléphone depuis Appareils sur un autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora disconnesso da KIFF. Riprova, o disconnetti questo telefono da Dispositivi su un altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFではまだサインアウトしていません。もう一度試すか、別のデバイスの「デバイス」からこのスマートフォンをサインアウトしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 KIFF에서 로그아웃되지 않았습니다. 다시 시도하거나, 다른 기기의 기기 목록에서 이 휴대폰을 로그아웃하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF dar neatjungė šio telefono. Bandykite dar kartą arba atjunkite jį iš kito įrenginio skilties „Įrenginiai“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF šo tālruni vēl nav izrakstījis. Mēģini vēlreiz vai izraksti šo tālruni no citas ierīces sadaļas “Ierīces”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet uitgelogd bij KIFF. Probeer het opnieuw, of log deze telefoon uit via Apparaten op een ander apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie wylogowano w KIFF. Spróbuj ponownie albo wyloguj ten telefon z sekcji Urządzenia na innym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem sessão terminada no KIFF. Tente novamente, ou termine a sessão deste telefone em Dispositivos noutro dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não saiu do KIFF. Tente novamente, ou encerre a sessão deste telefone em Dispositivos em outro dispositivo."
          }
        }
      }
    },
