        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@ de vous et des expéditeurs associés aujourd'hui. Texte uniquement : les pièces jointes ne sont pas ouvertes, et la réponse le précise."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ מתוך %2$@ ממך ומשולחים מוצמדים היום. טקסט בלבד: קבצים מצורפים לא נפתחים, והתשובה אומרת זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आपसे और जोड़े गए भेजने वालों से %2$@ में से %1$@। केवल टेक्स्ट: संलग्नक नहीं खोले जाते, और उत्तर यह बताता है।"
