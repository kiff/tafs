    "door.replies_only": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cavablar yalnız yazana gedir. Taf-ın etdiyi hər şey yenə də KIFF-dən keçir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговорите отиват само до този, който е писал. Всичко друго, което прави taf, минава през KIFF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovědi jdou jen tomu, kdo napsal. Cokoli dalšího taf dělá, jde pořád přes KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten gehen nur an den, der geschrieben hat. Alles andere, was der taf tut, läuft weiterhin über KIFF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies go only to who wrote. Anything else the taf does still goes through KIFF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas van solo a quien escribió. Todo lo demás que hace el taf sigue pasando por KIFF."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastused lähevad ainult kirjutajale. Kõik muu, mida taf teeb, läheb ikka läbi KIFFi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses ne vont qu'à la personne qui a écrit. Tout ce que fait le taf par ailleurs passe toujours par KIFF."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovori idu samo onome tko je pisao. Sve ostalo što taf radi i dalje ide preko KIFF-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszok csak annak mennek, aki írt. Bármi más, amit a taf tesz, továbbra is a KIFF-en megy át."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պատասխանները գնում են միայն նրան, ով գրել է։ Ամեն ինչ, ինչ taf-ը անում է, դեռ անցնում է KIFF-ով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan hanya dikirim kepada yang menulis. Hal lain yang dilakukan taf tetap melewati KIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte vanno solo a chi ha scritto. Tutto il resto che fa il taf passa comunque da KIFF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信は書いた人にだけ届きます。tafが行うその他のことは、引き続きKIFFを通ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პასუხები მიდის მხოლოდ იმასთან, ვინც დაწერა. ყველაფერი დანარჩენი, რასაც taf აკეთებს, მაინც KIFF-ში გადის."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장은 보낸 사람에게만 갑니다. taf가 하는 다른 일은 여전히 KIFF를 거칩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsakymai siunčiami tik tam, kas parašė. Visa kita, ką daro taf, vis tiek eina per KIFF."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbildes tiek sūtītas tikai tam, kas rakstīja. Viss pārējais, ko dara taf, joprojām iet caur KIFF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden gaan alleen naar wie er schreef. Al het andere dat het taf doet, gaat nog steeds via KIFF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedzi trafiają tylko do tego, kto napisał. Wszystko inne, co robi taf, nadal przechodzi przez KIFF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas vão apenas para quem escreveu. Tudo o resto que o taf faz continua a passar pelo KIFF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas vão apenas para quem escreveu. Tudo o resto que o taf faz continua passando pelo KIFF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsurile merg doar la cine a scris. Orice altceva face taful trece în continuare prin KIFF."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovede idú len tomu, kto napísal. Čokoľvek ďalšie taf robí, ide stále cez KIFF."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovori gredo samo tistemu, ki je pisal. Vse drugo, kar taf naredi, še vedno gre skozi KIFF."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigjet shkojnë vetëm te ai që shkroi. Çdo gjë tjetër që bën taf-i kalon prapë përmes KIFF."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovori idu samo onome ko je pisao. Sve ostalo šta taf radi i dalje ide preko KIFF-a."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตอบจะไปถึงผู้เขียนเท่านั้น สิ่งอื่นที่ taf ทำยังผ่าน KIFF"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlar yalnızca yazana gider. Taf'ın yaptığı diğer her şey yine KIFF'ten geçer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phản hồi chỉ đi tới người đã viết. Mọi việc khác taf làm vẫn đi qua KIFF."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆只會傳給寫信的人。taf 做的其他任何事仍會經過 KIFF。"
          }
        }
      }
    },
