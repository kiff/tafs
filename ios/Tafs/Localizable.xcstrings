    "door.knock.proof_failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie gibt an, von %1$@ zu sein, hat aber die Absenderprüfung nicht bestanden und wird daher wie die eines Fremden behandelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It says it's from %1$@, but it didn't pass the sender check, so it's treated as a stranger's."
