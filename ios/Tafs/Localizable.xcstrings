        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დააწყვილეთ %1$@: მას შეუძლია მოქმედებების დამტკიცება"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 페어링: 행동을 승인할 수 있습니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Susieti %1$@: jis galės tvirtinti veiksmus"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Savienot pārī %1$@: tas varēs apstiprināt darbības"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ koppelen: hij kan acties goedkeuren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparuj %1$@: będzie mógł zatwierdzać działania"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Associar %1$@: poderá aprovar ações"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Associar %1$@: poderá aprovar ações"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asociați %1$@: poate aproba acțiuni"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spárovať %1$@: môže schvaľovať akcie"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznani %1$@: lahko odobrava dejanja"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çiftoni %1$@: mund të miratojë veprime"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uparite uređaj %1$@: može odobravati radnje"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จับคู่ %1$@: มันอนุมัติการกระทำได้"
