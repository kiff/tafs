    "door.slack.which_channel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In welchem Kanal antwortet er? Neue Nachrichten dort starten die Arbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which channel does it answer in? New messages there will start work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué canal responde? Los mensajes nuevos de ese canal iniciarán trabajo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Millises kanalis see vastab? Seal olevad uued sõnumid alustavad tööd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quel canal répond-il ? Les nouveaux messages qui y arrivent lanceront le travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quale canale risponde? I nuovi messaggi lì avvieranno il lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのチャンネルで応答しますか？そこへの新しいメッセージで仕事が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 채널에서 답하나요? 그 채널의 새 메시지가 작업을 시작합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuriame kanale jis atsako? Naujos žinutės ten pradės darbą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurā kanālā tas atbild? Jaunas ziņas tur sāks darbu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In welk kanaal antwoordt het? Nieuwe berichten daar starten werk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na którym kanale odpowiada? Nowe wiadomości tam będą uruchamiać pracę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que canal responde? As novas mensagens nesse canal vão iniciar trabalho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que canal responde? As novas mensagens nesse canal vão iniciar trabalho."
          }
        }
      }
    },
    "door.slack_bot_sees_no_channel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Slack-Bot sieht noch keinen Kanal. Lade ihn in Slack in einen ein und komm dann zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Slack bot sees no channel yet. Invite it to one in Slack, then come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bot de Slack aún no ve ningún canal. Invítalo a uno en Slack y vuelve."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Slacki bot ei näe veel ühtegi kanalit. Kutsu see Slackis mõnele kanalile ja tule tagasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bot Slack ne voit encore aucun canal. Invitez-le dans un canal dans Slack, puis revenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bot Slack non vede ancora nessun canale. Invitalo in uno da Slack, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Slackボットにはまだチャンネルが見えません。Slackでチャンネルに招待してから戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack 봇이 아직 채널을 보지 못합니다. Slack에서 채널에 초대한 뒤 돌아오세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack botas dar nemato jokio kanalo. Pakvieskite jį į kanalą Slack programėlėje ir grįžkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack bots vēl neredz nevienu kanālu. Uzaicini to kādā kanālā Slack, tad atgriezies."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Slack-bot ziet nog geen kanaal. Nodig hem in Slack uit voor een kanaal en kom dan terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Slacka nie widzi jeszcze żadnego kanału. Zaproś go do kanału w Slacku, a potem wróć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot do Slack ainda não vê nenhum canal. Convide-o para um no Slack e depois volte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot do Slack ainda não vê nenhum canal. Convide-o para um no Slack e depois volte."
          }
        }
      }
    },
