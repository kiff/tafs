        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendus keeldus enne saatmist. Midagi ei saadetud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion l'a refusé avant l'envoi. Rien n'a été envoyé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza je to odbila prije slanja. Ništa nije poslano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolat küldés előtt elutasította. Semmi sem ment el."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կապը մերժեց այն ուղարկելուց առաջ։ Ոչինչ չուղարկվեց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi menolaknya sebelum mengirim. Tidak ada yang dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento l'ha rifiutato prima dell'invio. Non è stato inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信前に接続先が拒否しました。何も送信されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კავშირმა უარყო გაგზავნამდე. არაფერი გაიგზავნა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기 전에 연결이 거절했습니다. 보낸 것은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryšys ją atmetė prieš išsiunčiant. Niekas neišsiųsta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Savienojums to atteica pirms nosūtīšanas. Nekas netika nosūtīts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De koppeling heeft het vóór verzending geweigerd. Er is niets verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie odrzuciło to przed wysłaniem. Nic nie zostało wysłane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação recusou antes do envio. Nada foi enviado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão recusou antes do envio. Nada foi enviado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea l-a refuzat înainte de trimitere. Nu s-a trimis nimic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojenie to odmietlo pred odoslaním. Nič sa neodoslalo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezava je to zavrnila pred pošiljanjem. Nič ni bilo poslano."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidhja e refuzoi para dërgimit. Asgjë nuk u dërgua."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza je to odbila pre slanja. Ništa nije poslano."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อปฏิเสธก่อนส่ง ยังไม่ได้ส่งอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı göndermeden önce reddetti. Hiçbir şey gönderilmedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối đã từ chối trước khi gửi. Chưa gửi gì cả."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線在傳送之前就拒絕了。未傳送任何內容。"
          }
        }
      }
    },
