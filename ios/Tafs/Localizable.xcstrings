            "state": "translated",
            "value": "No se pudieron leer los créditos del periodo anterior. Vuelve a elegirlo para reintentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les crédits de la période précédente n'ont pas pu être lus. Choisissez-la à nouveau pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
