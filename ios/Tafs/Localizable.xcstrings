    "door.knock.too_many": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir neçə dəqiqədə çox mesaj göndərildi. Bir az gözləyin, sonra yenidən göndərin: heç nə göndərilmədi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това са много съобщения за няколко минути. Изчакайте малко и го изпратете отново: нищо не беше изпратено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za pár minut je to hodně zpráv. Chvíli počkejte a pošlete to znovu: nic se neodeslalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind viele Nachrichten in wenigen Minuten. Warte kurz und sende es dann erneut: Es wurde nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's a lot of messages in a few minutes. Wait a little, then send it again: nothing was sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son muchos mensajes en pocos minutos. Espera un poco y vuelve a enviarlo: no se envió nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paari minutiga on see palju sõnumeid. Oota veidi ja saada see siis uuesti: midagi ei saadetud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fait beaucoup de messages en quelques minutes. Patientez un peu, puis renvoyez-le : rien n'a été envoyé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To je puno poruka u nekoliko minuta. Pričekajte malo, pa pošaljite ponovno: ništa nije poslano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez sok üzenet néhány perc alatt. Várj egy kicsit, aztán küldd el újra: semmi sem ment el."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա շատ հաղորդագրություն է մի քանի րոպեում։ Սպասեք մի քիչ, ապա ուղարկեք նորից․ ոչինչ չուղարկվեց։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu banyak sekali pesan dalam beberapa menit. Tunggu sebentar, lalu kirim lagi: tidak ada yang dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono tanti messaggi in pochi minuti. Aspetta un po', poi invialo di nuovo: non è stato inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数分間にメッセージが多すぎます。少し待ってからもう一度送ってください。何も送信されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ძალიან ბევრი შეტყობინებაა რამდენიმე წუთში. მოიცადეთ ცოტა, შემდეგ გაგზავნეთ ხელახლა: არაფერი გაიგზავნა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 분 사이에 메시지가 너무 많습니다. 조금 기다린 뒤 다시 보내세요. 보낸 것은 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per kelias minutes – daug žinučių. Šiek tiek palaukite ir išsiųskite dar kartą: niekas neišsiųsta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dažās minūtēs ir daudz ziņu. Mazliet uzgaidi, tad sūti vēlreiz: nekas netika nosūtīts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zijn veel berichten in een paar minuten. Wacht even en verzend het dan opnieuw: er is niets verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To dużo wiadomości w kilka minut. Poczekaj chwilę, a potem wyślij ponownie: nic nie zostało wysłane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São muitas mensagens em poucos minutos. Aguarde um pouco e envie novamente: nada foi enviado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São muitas mensagens em poucos minutos. Aguarde um pouco e envie novamente: nada foi enviado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt multe mesaje în câteva minute. Așteptați puțin, apoi trimiteți-l din nou: nu s-a trimis nimic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Za pár minút je to veľa správ. Chvíľu počkajte a pošlite to znova: nič sa neodoslalo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je veliko sporočil v nekaj minutah. Malo počakajte in pošljite znova: nič ni bilo poslano."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Janë shumë mesazhe për pak minuta. Prisni pak, pastaj dërgojeni sërish: asgjë nuk u dërgua."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "To je puno poruka u nekoliko minuta. Pričekajte malo, pa pošaljite ponovo: ništa nije poslano."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีข้อความมากเกินไปในไม่กี่นาที รอสักครู่แล้วส่งอีกครั้ง: ยังไม่ได้ส่งอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç dakikada çok fazla mesaj. Biraz bekleyip tekrar gönderin: hiçbir şey gönderilmedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có quá nhiều tin nhắn trong vài phút. Hãy chờ một lát rồi gửi lại: chưa gửi gì cả."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短時間內訊息過多。請稍候再傳送一次：未傳送任何內容。"
          }
        }
      }
