            "value": "Čtečku otisků teď nelze použít. Zkuste to za chvíli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fingerabdrucksensor kann gerade nicht verwendet werden. Versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fingerprint sensor can't be used just now. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se puede usar el sensor de huellas. Vuelve a intentarlo en un momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sõrmejäljeandurit ei saa praegu kasutada. Proovi hetke pärast uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le capteur d'empreintes ne peut pas être utilisé pour le moment. Réessayez dans un instant."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senzor otiska prsta trenutačno nije moguće upotrijebiti. Pokušajte ponovno za trenutak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ujjlenyomat-érzékelő most nem használható. Próbáld újra egy pillanat múlva."
