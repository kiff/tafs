    "door.paired_senders_today_more_dropped": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@ von dir und gekoppelten Absendern heute. Weitere werden bis morgen verworfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@ from you and paired senders today. More are dropped until tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ tuyos y de remitentes vinculados hoy. Los siguientes se descartan hasta mañana."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täna sinult ja seotud saatjatelt %1$@/%2$@. Rohkem sõnumeid jäetakse homseni vastu võtmata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@ de vous et des expéditeurs associés aujourd'hui. Les suivants sont ignorés jusqu'à demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ su %2$@ da te e dai mittenti associati oggi. I successivi vengono scartati fino a domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のあなたと登録済みの送信者からの連絡：%2$@件中%1$@件。明日まで、それ以上は破棄されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 나와 등록된 발신자에게서 %2$@건 중 %1$@건. 내일까지 더 오는 것은 버려집니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien: %1$@ iš %2$@ – iš jūsų ir susietų siuntėjų. Kitos atmetamos iki rytojaus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šodien %1$@ no %2$@ no tevis un pārī savienotajiem sūtītājiem. Pārējie līdz rītdienai tiek atmesti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van %2$@ van jou en gekoppelde afzenders vandaag. Meer worden tot morgen genegeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ z %2$@ od Ciebie i powiązanych nadawców dziś. Kolejne są odrzucane do jutra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ mensagens suas e de remetentes associados hoje. As seguintes são descartadas até amanhã."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ mensagens suas e de remetentes associados hoje. As seguintes são descartadas até amanhã."
          }
        }
      }
    },
    "door.paired_senders_today_text_only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@ von dir und gekoppelten Absendern heute. Nur Text: Anhänge werden nicht geöffnet, und die Antwort sagt das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@ from you and paired senders today. Text only: attachments aren't opened, and the reply says so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ tuyos y de remitentes vinculados hoy. Solo texto: los adjuntos no se abren, y la respuesta lo dice."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täna sinult ja seotud saatjatelt %1$@/%2$@. Ainult tekst: manuseid ei avata ja vastus ütleb seda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@ de vous et des expéditeurs associés aujourd'hui. Texte uniquement : les pièces jointes ne sont pas ouvertes, et la réponse le précise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ su %2$@ da te e dai mittenti associati oggi. Solo testo: gli allegati non vengono aperti, e la risposta lo dice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のあなたと登録済みの送信者からの連絡：%2$@件中%1$@件。テキストのみ：添付ファイルは開かれず、返信でその旨を伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 나와 등록된 발신자에게서 %2$@건 중 %1$@건. 텍스트만 받습니다: 첨부 파일은 열지 않으며, 답장에서 그렇게 알립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien: %1$@ iš %2$@ – iš jūsų ir susietų siuntėjų. Tik tekstas: priedai neatidaromi, ir atsakyme tai pasakoma."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šodien %1$@ no %2$@ no tevis un pārī savienotajiem sūtītājiem. Tikai teksts: pielikumi netiek atvērti, un atbildē tas ir pateikts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van %2$@ van jou en gekoppelde afzenders vandaag. Alleen tekst: bijlagen worden niet geopend, en het antwoord zegt dat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ z %2$@ od Ciebie i powiązanych nadawców dziś. Tylko tekst: załączniki nie są otwierane, a odpowiedź to mówi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ mensagens suas e de remetentes associados hoje. Só texto: os anexos não são abertos, e a resposta indica-o."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ mensagens suas e de remetentes associados hoje. Só texto: os anexos não são abertos, e a resposta indica-o."
          }
        }
      }
    },
