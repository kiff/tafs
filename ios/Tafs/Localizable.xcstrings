    "version.guide.trial_ends": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي التجربة في %1$@ إن لم تستخدمها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstifadə etməsəniz, sınaq %1$@ tarixində bitir."
