            "value": "Terlalu banyak percobaan saat ini. Coba lagi dalam semenit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi in questo momento. Riprova tra un minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試行回数が多すぎます。1分後にもう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახლა ძალიან ბევრი მცდელობაა. სცადეთ ერთ წუთში."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មានការព្យាយាមច្រើនពេកនៅពេលនេះ។ សូមព្យាយាមម្តងទៀតក្នុងមួយនាទី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 시도가 너무 많습니다. 1분 후 다시 시도하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມີການພະຍາຍາມຫຼາຍເກີນໄປດຽວນີ້. ລອງໃໝ່ໃນອີກນາທີໜຶ່ງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiuo metu per daug bandymų. Bandykite dar kartą po minutės."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pašlaik pārāk daudz mēģinājumu. Pēc minūtes mēģini vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Премногу обиди сега. Обиди се повторно за една минута."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Яг одоо хэт олон оролдлого байна. Нэг минутын дараа дахин оролдоно уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अहिले धेरै प्रयास भए। एक मिनेटपछि फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel pogingen op dit moment. Wacht een minuut en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele prób w tej chwili. Spróbuj ponownie za minutę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas tentativas neste momento. Tente novamente daqui a um minuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas tentativas neste momento. Tente novamente daqui a um minuto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe încercări acum. Încercați din nou peste un minut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príliš veľa pokusov. Skúste to o minútu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutno preveč poskusov. Poskusite čez minuto."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shumë përpjekje tani. Provoni sërish pas një minute."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja upravo sada. Pokušajte ponovo za minutu."
