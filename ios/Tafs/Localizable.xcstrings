    "needs_you.empty_hint": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf Card-ından kənar bir şey istəyəndə, o, burada və kilid ekranınızda görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато taf поиска нещо извън своята Card, то се показва тук и на заключения ви екран."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když taf žádá o něco mimo svou Card, objeví se to tady a na zamčené obrazovce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein taf um etwas außerhalb seiner Card bittet, erscheint es hier und auf deinem Sperrbildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a taf asks for something outside its Card, it shows up here and on your lock screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un taf pide algo fuera de su Card, aparece aquí y en tu pantalla de bloqueo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui taf küsib midagi väljaspool oma Cardi, ilmub see siia ja sinu lukustuskuvale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un taf demande quelque chose hors de sa Card, cela s'affiche ici et sur votre écran verrouillé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad taf traži nešto izvan svog Carda, to se pojavi ovdje i na vašem zaključanom zaslonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha egy taf a Cardján kívül eső dolgot kér, az itt és a zárolási képernyődön jelenik meg."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երբ taf-ը իր Card-ից դուրս որևէ բան է խնդրում, այն երևում է այստեղ և ձեր կողպված էկրանին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat sebuah taf meminta sesuatu di luar Card-nya, permintaan itu muncul di sini dan di layar kunci Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un taf chiede qualcosa fuori dalla sua Card, compare qui e sulla schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tafがCardの範囲外のことを求めると、こことロック画面に表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "როცა taf თავისი Card-ის გარეთ რამეს ითხოვს, ის აქ და თქვენს ჩაკეტილ ეკრანზე გამოჩნდება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "taf가 Card 밖의 일을 요청하면 여기와 잠금 화면에 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai taf prašo ko nors už savo Card ribų, tai rodoma čia ir jūsų užrakinimo ekrane."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad taf lūdz kaut ko ārpus savas Card, tas parādās šeit un tavā bloķēšanas ekrānā."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een taf om iets buiten zijn Card vraagt, verschijnt het hier en op je toegangsscherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy taf poprosi o coś poza swoją Card, pojawi się to tutaj i na ekranie blokady."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf pede algo fora do seu Card, aparece aqui e no seu ecrã bloqueado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um taf pede algo fora do seu Card, aparece aqui e na sua tela bloqueada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când un taf cere ceva în afara Cardului său, apare aici și pe ecranul de blocare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď taf žiada o niečo mimo svojej Card, objaví sa to tu a na zamknutej obrazovke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko taf prosi za nekaj zunaj svoje Card, se to prikaže tukaj in na zaklenjenem zaslonu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur një taf kërkon diçka jashtë Card-it të vet, shfaqet këtu dhe në ekranin tuaj të kyçur."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad taf traži nešto izvan svog Carda, to se pojavi ovdje i na vašem zaključanom ekranu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อ taf ขอสิ่งที่อยู่นอก Card ของมัน จะปรากฏที่นี่และบนหน้าจอล็อกของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir taf Card'ının dışında bir şey istediğinde burada ve kilit ekranınızda görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một taf yêu cầu điều gì ngoài Card của nó, yêu cầu hiện ở đây và trên màn hình khóa của bạn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 taf 要求超出其 Card 範圍的事項時，會顯示在這裡以及您的鎖定畫面上。"
          }
        }
      }
    },
