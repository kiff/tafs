        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Врати · завъртете, за да изберете, натиснете, за да отворите"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dveře · otočením vyberte, stiskem otevřete"
