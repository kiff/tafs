            "value": "تسجيل الخروج من جهاز ينهي تسجيل دخوله إلى هذا الحساب فورًا. لتسجيل الخروج من هذا الهاتف، استخدم «تسجيل الخروج» في «الحساب»."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazı çıxış etdirmək onun bu hesabdakı girişini dərhal bitirir. Bu telefonu çıxış etdirmək üçün Hesabda Çıxış seçin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Извеждането на устройство прекратява входа му в този акаунт веднага. За да изведете този телефон, използвайте „Изход“ в Акаунт."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ডিভাইস সাইন আউট করালে এই অ্যাকাউন্টে তার সাইন-ইন সঙ্গে সঙ্গে শেষ হয়। এই ফোন সাইন আউট করতে অ্যাকাউন্টে সাইন আউট ব্যবহার করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tancar la sessió d'un dispositiu acaba el seu inici de sessió en aquest compte a l'instant. Per tancar la sessió d'aquest telèfon, utilitza Tanca la sessió a Compte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlášení zařízení hned ukončí jeho přihlášení k tomuto účtu. Tento telefon odhlásíte přes Odhlásit se v Účtu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Gerät abmeldest, endet seine Anmeldung bei diesem Konto sofort. Um dieses Telefon abzumelden, nutze „Abmelden“ unter „Konto“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing a device out ends its sign-in on this account at once. To sign out this phone, use Sign out in Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar la sesión de un dispositivo termina al instante su inicio de sesión en esta cuenta. Para cerrar la sesión de este teléfono, usa Cerrar sesión en Cuenta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadme väljalogimine lõpetab kohe selle sisselogimise sellel kontol. Selle telefoni väljalogimiseks kasuta vaates Konto valikut Logi välja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter un appareil met fin immédiatement à sa connexion sur ce compte. Pour déconnecter ce téléphone, utilisez Se déconnecter dans Compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוצאת התקן מהחשבון מסיימת את הכניסה שלו בחשבון הזה מיד. כדי להוציא את הטלפון הזה, יש להשתמש ביציאה בחשבון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस को साइन आउट करने से इस खाते पर उसका साइन-इन तुरंत खत्म हो जाता है। इस फ़ोन को साइन आउट करने के लिए खाता में साइन आउट उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava uređaja odmah završava njegovu prijavu na ovom računu. Da odjavite ovaj telefon, upotrijebite Odjava u Računu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy eszköz kijelentkeztetése azonnal megszünteti a bejelentkezését ebben a fiókban. Ennek a telefonnak a kijelentkeztetéséhez használd a Fiók részben a Kijelentkezést."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սարքը դուրս բերելը անմիջապես ավարտում է նրա մուտքը այս հաշվում։ Այս հեռախոսը դուրս բերելու համար օգտագործեք «Ելք»-ը Հաշվում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengeluarkan sebuah perangkat langsung mengakhiri proses masuknya di akun ini. Untuk keluar dari ponsel ini, gunakan Keluar di Akun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnettere un dispositivo termina subito il suo accesso a questo account. Per disconnettere questo telefono, usa Esci in Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスをサインアウトすると、このアカウントでのサインインがすぐに終了します。このスマートフォンをサインアウトするには、アカウントの「サインアウト」を使ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოწყობილობის გამოყვანა მის შესვლას ამ ანგარიშზე მაშინვე წყვეტს. ამ ტელეფონის გამოსაყვანად გამოიყენეთ „გასვლა“ ანგარიშში."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចាកចេញពីឧបករណ៍បញ្ចប់ការចូលរបស់វាលើគណនីនេះភ្លាមៗ។ ដើម្បីចាកចេញពីទូរសព្ទនេះ សូមប្រើ «ចាកចេញ» ក្នុងគណនី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 로그아웃하면 이 계정에서 그 기기의 로그인이 즉시 끝납니다. 이 휴대폰을 로그아웃하려면 계정에서 로그아웃을 사용하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການໃຫ້ອຸປະກອນອອກຈາກລະບົບຈະສິ້ນສຸດການເຂົ້າສູ່ລະບົບຂອງມັນໃນບັນຊີນີ້ທັນທີ. ເພື່ອໃຫ້ໂທລະສັບນີ້ອອກຈາກລະບົບ ໃຫ້ໃຊ້ ອອກຈາກລະບົບ ໃນບັນຊີ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atjungus įrenginį, jo prisijungimas prie šios paskyros iškart baigiamas. Norėdami atjungti šį telefoną, skiltyje „Paskyra“ naudokite „Atsijungti“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izrakstot ierīci, tās pierakstīšanās šajā kontā tiek nekavējoties beigta. Lai izrakstītu šo tālruni, sadaļā Konts izmanto “Izrakstīties”."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одјавувањето на уред ја завршува неговата најава на оваа сметка веднаш. За да го одјавиш овој телефон, користи Одјави се во Сметка."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Төхөөрөмжийг гаргахад түүний энэ бүртгэл дэх нэвтрэлт шууд дуусна. Энэ утсаа гаргахын тулд Бүртгэл дэх Гарах-ыг ашиглана уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "उपकरण साइन आउट गर्दा यस खातामा त्यसको साइन इन तुरुन्तै समाप्त हुन्छ। यो फोन साइन आउट गर्न खातामा साइन आउट प्रयोग गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een apparaat uitloggen beëindigt meteen de login ervan op dit account. Gebruik Uitloggen in Account om deze telefoon uit te loggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowanie urządzenia natychmiast kończy jego logowanie na tym koncie. Aby wylogować ten telefon, użyj Wyloguj w sekcji Konto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar a sessão de um dispositivo termina de imediato o seu início de sessão nesta conta. Para terminar a sessão neste telefone, use Terminar sessão em Conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerrar a sessão de um dispositivo encerra imediatamente o login dele nesta conta. Para encerrar a sessão neste telefone, use Sair em Conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectarea unui dispozitiv îi încheie imediat conectarea la acest cont. Pentru a deconecta acest telefon, folosiți Deconectați-vă din Cont."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhlásenie zariadenia hneď ukončí jeho prihlásenie k tomuto účtu. Tento telefón odhlásite cez Odhlásiť sa v Účte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava naprave takoj konča njeno prijavo v ta račun. Ta telefon odjavite z Odjava v Računu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Daljet e një pajisjeje e mbyll hyrjen e saj në këtë llogari menjëherë. Për ta nxjerrë këtë telefon, përdorni Dalje te Llogaria."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava uređaja odmah završava njegovu prijavu na ovom nalogu. Da odjavite ovaj telefon, upotrebite Odjava u Nalogu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การออกจากระบบอุปกรณ์จะสิ้นสุดการเข้าสู่ระบบของอุปกรณ์นั้นบนบัญชีนี้ทันที หากต้องการออกจากระบบโทรศัพท์เครื่องนี้ ให้ใช้ออกจากระบบในบัญชี"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjamy çykarmak onuň bu hasapdaky girişini derrew gutarýar. Bu telefony çykarmak üçin Hasap bölüminde Çykyň ulanyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir cihazın oturumunu kapatmak, bu hesaptaki oturumunu hemen sonlandırır. Bu telefonun oturumunu kapatmak için Hesap'taki Oturumu kapat'ı kullanın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی ڈیوائس کو سائن آؤٹ کرنے سے اس اکاؤنٹ پر اس کا سائن اِن فوراً ختم ہو جاتا ہے۔ اس فون کو سائن آؤٹ کرنے کے لیے اکاؤنٹ میں سائن آؤٹ استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng xuất một thiết bị sẽ chấm dứt ngay phiên đăng nhập của nó trên tài khoản này. Để đăng xuất điện thoại này, hãy dùng Đăng xuất trong Tài khoản."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出裝置會立即結束它在此帳號上的登入。若要登出這部手機，請使用「帳號」中的「登出」。"
