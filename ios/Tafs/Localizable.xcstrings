    "halt.explain.halting": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni heç nə başlamır. «Donduruldu» KIFF və bağlantı hər ikisi təsdiq edəndə görünür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо ново не започва. „Спряно“ се показва, щом KIFF и връзката потвърдят."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nového se nespustí. Zastaveno se ukáže, jakmile to potvrdí KIFF i připojení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Neues startet. „Angehalten“ erscheint, sobald KIFF und die Verbindung beide bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing new starts. Halted shows once KIFF and the connection both confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No empieza nada nuevo. Aparece Bloqueado cuando KIFF y la conexión lo confirman."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi uut ei alga. Peatatud kuvatakse, kui KIFF ja ühendus on mõlemad kinnitanud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau ne démarre. Bloqué s'affiche dès que KIFF et la connexion l'ont tous deux confirmé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa novo ne počinje. Blokirano se prikaže kad KIFF i veza oboje potvrde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi új nem indul. A Leállítva akkor látszik, ha a KIFF és a kapcsolat is megerősíti."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոչ մի նոր բան չի սկսվում։ «Կանգնեցված է» ցուցադրվում է, երբ KIFF-ը և կապը երկուսն էլ հաստատեն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang baru dimulai. Status Dibekukan muncul setelah KIFF dan koneksi sama-sama mengonfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non parte nulla di nuovo. Bloccato compare quando KIFF e il collegamento lo confermano entrambi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい作業は始まりません。KIFFと接続先の両方が確認すると、遮断済みと表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახალი არაფერი იწყება. „გაჩერებულია“ ჩანს, როცა KIFF-ი და კავშირი ორივე დაადასტურებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 시작되는 것은 없습니다. KIFF와 연결이 모두 확인하면 차단됨으로 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieko naujo nepradedama. „Sustabdyta“ rodoma, kai tai patvirtina ir KIFF, ir ryšys."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas jauns nesākas. “Apturēts” parādās, kad to apstiprina gan KIFF, gan savienojums."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er start niets nieuws. Stilgezet verschijnt zodra KIFF en de koppeling het allebei bevestigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nowego się nie zaczyna. Zablokowane pojawi się, gdy potwierdzą to KIFF i połączenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de novo começa. Bloqueado aparece quando o KIFF e a ligação o confirmarem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de novo começa. Bloqueado aparece quando o KIFF e a conexão o confirmarem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu pornește nimic nou. „Oprit” apare când KIFF și conexiunea confirmă amândouă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič nové sa nespustí. Zastavené sa ukáže, keď to potvrdí KIFF aj pripojenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič novega se ne začne. Ustavljeno se pokaže, ko to potrdita KIFF in povezava."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Asgjë e re nuk nis. Bllokuar shfaqet kur KIFF dhe lidhja ta konfirmojnë të dyja."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa novo ne počinje. Blokirano se prikaže kad KIFF i veza oboje potvrde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะไม่เริ่มงานใหม่ จะแสดงว่าระงับแล้วเมื่อ KIFF และการเชื่อมต่อยืนยันทั้งคู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir şey başlamaz. KIFF ve bağlantı ikisi de onaylayınca Donduruldu görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì mới bắt đầu. Trạng thái Đã đóng băng hiện ra khi KIFF và kết nối cùng xác nhận."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會啟動任何新工作。待 KIFF 與連線皆確認後，會顯示為已凍結。"
          }
        }
      }
    },
    "halt.explain.running_all": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dondurma siz davam etdirənə qədər taf-larınızı dayandırır. Artıq göndərilmiş zəng yenə də çata bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спирането спира вашите tafs, докато не ги възобновите. Вече изпратена заявка може все пак да пристигне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavení drží vaše tafy, dokud je neobnovíte. Volání, které už odešlo, může ještě dorazit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhalten stoppt deine tafs, bis du fortsetzt. Ein schon gesendeter Aufruf kann noch ankommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halting stops your tafs until you resume. A call already sent may still arrive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear detiene tus tafs hasta que los reanudes. Una llamada ya enviada aún puede llegar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peatamine hoiab sinu tafid seisus, kuni jätkad. Juba saadetud päring võib siiski kohale jõuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquer arrête vos tafs jusqu'à ce que vous repreniez. Un appel déjà envoyé peut encore arriver."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje zaustavlja vaše tafove dok ne nastavite. Već poslan poziv još može stići."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A leállítás megállítja a tafjaidat, amíg nem folytatod őket. Egy már elküldött hívás még megérkezhet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կանգնեցումը դադարեցնում է ձեր taf-երը, մինչև վերսկսեք։ Արդեն ուղարկված զանգը դեռ կարող է հասնել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembekuan menghentikan semua tafs Anda sampai Anda melanjutkan. Panggilan yang sudah terkirim mungkin masih tiba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccare ferma i tuoi tafs finché non riprendi. Una chiamata già inviata può ancora arrivare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮断すると、再開するまでtafsが止まります。すでに送信された呼び出しは届く場合があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაჩერება თქვენს taf-ებს აჩერებს, სანამ არ განაახლებთ. უკვე გაგზავნილი ზარი შეიძლება მაინც მივიდეს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단하면 재개할 때까지 tafs가 멈춥니다. 이미 보낸 호출은 도착할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustabdžius jūsų taf nedirbs, kol netęsite. Jau išsiųsta užklausa vis tiek gali būti gauta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apturēšana aptur tavus taf, līdz tu tos turpini. Jau nosūtīts izsaukums var tomēr pienākt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilzetten stopt je tafs tot je hervat. Een al verzonden aanroep kan nog aankomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokada zatrzymuje Twoje tafs, dopóki ich nie wznowisz. Wysłane już wywołanie może jeszcze dotrzeć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear para os seus tafs até retomar. Uma chamada já enviada pode ainda chegar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear para os seus tafs até retomar. Uma chamada já enviada pode ainda chegar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprirea vă oprește tafurile până le reluați. Un apel deja trimis poate totuși să ajungă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavenie drží vaše tafy, kým ich neobnovíte. Volanie, ktoré už odišlo, môže ešte doraziť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustavitev zadrži vaše tafe, dokler jih ne nadaljujete. Klic, ki je že odšel, lahko še prispe."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bllokimi i ndalon tafs-et tuaj derisa t'i riniseni. Një thirrje e dërguar tashmë mund të arrijë prapë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje zaustavlja vaše tafove dok ne nastavite. Već poslan poziv još može stići."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การระงับจะหยุด taf ทั้งหมดของคุณจนกว่าคุณจะทำต่อ การเรียกที่ส่งไปแล้วอาจยังไปถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dondurma, siz devam ettirene kadar tafs'larınızı durdurur. Gönderilmiş bir çağrı yine de ulaşabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng băng dừng các tafs của bạn cho đến khi bạn tiếp tục. Một lệnh gọi đã gửi vẫn có thể đến nơi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "凍結會讓您的所有 taf 停止，直到您繼續。已傳送的呼叫可能仍會抵達。"
          }
        }
      }
    },
    "halt.explain.running_one": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dondurma siz davam etdirənə qədər onu dayandırır. Artıq göndərilmiş zəng yenə də çata bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спирането го спира, докато не го възобновите. Вече изпратена заявка може все пак да пристигне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavení ho drží, dokud ho neobnovíte. Volání, které už odešlo, může ještě dorazit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhalten stoppt ihn, bis du fortsetzt. Ein schon gesendeter Aufruf kann noch ankommen."
          }
        },
        "en": {
