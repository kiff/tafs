    "record.report.done": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الإبلاغ. تم تجميد %1$@ وحُفظ الإيصال. إذا خرجت أموال من حسابك، فتواصل مع جهة إصدار بطاقتك أيضًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirildi. %1$@ donduruldu və qəbz saxlanılır. Hesabınızdan pul çıxıbsa, kart verən bankla da əlaqə saxlayın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигналът е изпратен. %1$@ е спрян, а разписката се пази. Ако са излезли пари от сметката ви, свържете се и с издателя на картата си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জানানো হয়েছে। %1$@ থামানো হয়েছে এবং রসিদ রাখা হয়েছে। আপনার অ্যাকাউন্ট থেকে টাকা গেলে আপনার কার্ড প্রদানকারীর সঙ্গেও যোগাযোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Informat. %1$@ està bloquejat i el rebut es conserva. Si han sortit diners del teu compte, contacta també amb l'emissor de la teva targeta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlášeno. %1$@ je zastaven a potvrzení zůstává uloženo. Pokud z vašeho účtu odešly peníze, obraťte se také na vydavatele své karty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeldet. %1$@ ist angehalten, und der Beleg bleibt gespeichert. Wenn Geld von deinem Konto abgegangen ist, wende dich auch an deinen Kartenaussteller."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reported. %1$@ is halted and the receipt is kept. If money left your account, contact your card issuer too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informado. %1$@ está bloqueado y se conserva el recibo. Si salió dinero de tu cuenta, contacta también con el emisor de tu tarjeta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teatatud. Taf %1$@ on peatatud ja kviitung säilitatakse. Kui sinu kontolt lahkus raha, võta ühendust ka oma kaardi väljaandjaga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalé. %1$@ est bloqué et le reçu est conservé. Si de l'argent a quitté votre compte, contactez aussi l'émetteur de votre carte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דווח. %1$@ נעצר והקבלה נשמרה. אם כסף יצא מהחשבון שלך, יש לפנות גם למנפיק הכרטיס שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट हो गई। %1$@ रोका गया है और रसीद रखी गई है। यदि आपके खाते से पैसा गया हो, तो अपने कार्ड जारीकर्ता से भी संपर्क करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavljeno. Taf %1$@ je blokiran, a potvrda se čuva. Ako je novac otišao s vašeg računa, obratite se i izdavatelju svoje kartice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentve. A(z) %1$@ le van állítva, a nyugtát pedig megőrizzük. Ha pénz hagyta el a számládat, fordulj a kártyakibocsátódhoz is."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաղորդվեց։ %1$@-ը կանգնեցված է, և անդորրագիրը պահպանվել է։ Եթե գումարը դուրս է եկել ձեր հաշվից, կապվեք նաև ձեր քարտը թողարկողի հետ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilaporkan. %1$@ dibekukan dan tanda terima disimpan. Jika uang keluar dari rekening Anda, hubungi juga penerbit kartu Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnalato. %1$@ è bloccato e la ricevuta viene conservata. Se dei soldi sono usciti dal tuo conto, contatta anche l'emittente della tua carta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告しました。%1$@は遮断済みで、領収書は保管されます。口座からお金が出ている場合は、カード発行会社にも連絡してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაფიქსირდა. %1$@ გაჩერებულია და ქვითარი შენახულია. თუ ფული თქვენი ანგარიშიდან გავიდა, დაუკავშირდით თქვენი ბარათის გამცემსაც."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានរាយការណ៍។ %1$@ ត្រូវបានបញ្ឈប់ ហើយបង្កាន់ដៃត្រូវបានរក្សាទុក។ ប្រសិនបើលុយបានចេញពីគណនីរបស់អ្នក សូមទាក់ទងអ្នកចេញកាតរបស់អ្នកផងដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고했습니다. %1$@이(가) 차단되었으며 영수증은 보관됩니다. 계좌에서 돈이 빠져나갔다면 카드 발급사에도 문의하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍງານແລ້ວ. %1$@ ຢຸດແລ້ວ ແລະ ໃບຮັບເງິນຖືກເກັບໄວ້. ຖ້າເງິນອອກຈາກບັນຊີຂອງທ່ານ ໃຫ້ຕິດຕໍ່ຜູ້ອອກບັດຂອງທ່ານນຳ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pranešta. %1$@ sustabdytas, o kvitas išsaugotas. Jei pinigai išėjo iš Jūsų sąskaitos, susisiekite ir su kortelės išdavėju."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paziņots. %1$@ ir apturēts, un kvīts tiek saglabāta. Ja nauda izgājusi no tava konta, sazinies arī ar savas kartes izdevēju."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пријавено. %1$@ е запрен и признаницата се чува. Ако пари ја напуштиле твојата сметка, јави се и кај издавачот на твојата картичка."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Мэдэгдсэн. %1$@ зогссон бөгөөд баримт хадгалагдана. Хэрэв таны данснаас мөнгө гарсан бол картаа гаргасан байгууллагатай ч холбогдоно уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट गरियो। %1$@ रोकिएको छ र रसिद राखिएको छ। तपाईंको खाताबाट पैसा गएको भए आफ्नो कार्ड जारीकर्तालाई पनि सम्पर्क गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeld. %1$@ is stilgezet en het ontvangstbewijs blijft bewaard. Als er geld van je rekening is gegaan, neem dan ook contact op met de uitgever van je kaart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoszono. %1$@ jest zablokowany, a potwierdzenie zostaje zachowane. Jeśli pieniądze opuściły Twoje konto, skontaktuj się też z wystawcą swojej karty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comunicado. %1$@ está bloqueado e o recibo é mantido. Se saiu dinheiro da sua conta, fale também com o emissor do seu cartão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comunicado. %1$@ está bloqueado e o recibo é mantido. Se saiu dinheiro da sua conta, fale também com o emissor do seu cartão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportat. %1$@ este oprit, iar chitanța se păstrează. Dacă au ieșit bani din contul dumneavoastră, contactați și emitentul cardului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlásené. %1$@ je zastavený a potvrdenie sa uchováva. Ak z vášho účtu odišli peniaze, obráťte sa aj na vydavateľa svojej karty."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavljeno. %1$@ je ustavljen, potrdilo pa se hrani. Če je z vašega računa odšel denar, se obrnite tudi na izdajatelja svoje kartice."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "U raportua. %1$@ është i bllokuar dhe dëftesa ruhet. Nëse para dolën nga llogaria juaj, kontaktoni edhe lëshuesin e kartës suaj."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavljeno. %1$@ je blokiran, a potvrda je sačuvana. Ako je novac napustio vaš nalog, obratite se i izdavaocu svoje kartice."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงานแล้ว %1$@ ถูกระงับ และเก็บใบเสร็จไว้ หากเงินออกจากบัญชีของคุณแล้ว โปรดติดต่อผู้ออกบัตรของคุณด้วย"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Habar berildi. %1$@ togtadyldy we kwitansiýa saklanýar. Eger pul hasabyňyzdan çykan bolsa, kart üpjün edijiňiz bilen hem habarlaşyň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirildi. %1$@ taf'ı donduruldu ve makbuz saklanıyor. Hesabınızdan para çıktıysa kart veren kuruluşla da iletişime geçin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رپورٹ ہو گئی۔ %1$@ روک دیا گیا ہے اور رسید رکھی گئی ہے۔ اگر رقم آپ کے اکاؤنٹ سے نکلی ہو تو اپنے کارڈ جاری کنندہ سے بھی رابطہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã báo cáo. %1$@ đã bị đóng băng và biên nhận được giữ lại. Nếu tiền đã rời khỏi tài khoản của bạn, hãy liên hệ cả đơn vị phát hành thẻ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已回報。%1$@ 已凍結，收據會保留。若款項已從您的帳戶轉出，也請聯絡您的發卡機構。"
          }
        }
      }
    },
