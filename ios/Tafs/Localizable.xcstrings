          "stringUnit": {
            "state": "translated",
            "value": "Informa d'un pagament que no esperaves: %1$@ ha pagat %2$@ el %3$@. Bloquegem %1$@ fins que ho hagis mirat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlaste platbu, kterou jste nečekali: %1$@ zaplatil %2$@ dne %3$@. %1$@ zastavíme, dokud se nepodíváte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde eine Zahlung, die du nicht erwartet hast: %1$@ hat am %3$@ %2$@ gezahlt. Wir halten %1$@ an, bis du nachgesehen hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report a payment you didn't expect: %1$@ paid %2$@ on %3$@. We halt %1$@ until you've looked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa de un pago que no esperabas: %1$@ pagó %2$@ el %3$@. Bloquearemos %1$@ hasta que lo hayas revisado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teata maksest, mida sa ei oodanud: %1$@ maksis %3$@ summa %2$@. Peatame tafi %1$@, kuni oled järele vaadanud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalez un paiement que vous n'attendiez pas : %1$@ a payé %2$@ le %3$@. Nous bloquons %1$@ jusqu'à ce que vous ayez vérifié."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דיווח על תשלום שלא ציפית לו: %1$@ שילם %2$@ ב-%3$@. אנחנו עוצרים את %1$@ עד שתבדוק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अनपेक्षित भुगतान की रिपोर्ट करें: %1$@ ने %3$@ को %2$@ का भुगतान किया। आपके देखने तक हम %1$@ को रोकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite plaćanje koje niste očekivali: taf %1$@ platio je %2$@ dana %3$@. Blokiramo taf %1$@ dok ne provjerite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelents egy fizetést, amire nem számítottál: a(z) %1$@ %3$@ napján %2$@ összeget fizetett. Leállítjuk a(z) %1$@ tafot, amíg át nem nézed."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաղորդեք վճարման մասին, որին չէիք սպասում․ %1$@-ը վճարեց %2$@ %3$@-ին։ Մենք կանգնեցնում ենք %1$@-ը, մինչև նայեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporkan pembayaran yang tidak Anda duga: %1$@ membayar %2$@ pada %3$@. Kami membekukan %1$@ sampai Anda memeriksanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnala un pagamento che non ti aspettavi: %1$@ ha pagato %2$@ il %3$@. Blocchiamo %1$@ finché non hai controllato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予期しない支払いを報告：%1$@が%3$@に%2$@を支払いました。確認いただくまで%1$@を遮断します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დააფიქსირეთ გადახდა, რომელსაც არ ელოდით: %1$@-მა გადაიხადა %2$@ %3$@-ზე. ჩვენ %1$@-ს ვაჩერებთ, სანამ არ გადახედავთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រាយការណ៍ការទូទាត់ដែលអ្នកមិនរំពឹងទុក៖ %1$@ បានបង់ %2$@ នៅថ្ងៃ %3$@។ យើងបញ្ឈប់ %1$@ រហូតដល់អ្នកបានពិនិត្យ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상하지 못한 결제를 신고하세요: %1$@이(가) %3$@에 %2$@을(를) 결제했습니다. 확인하실 때까지 %1$@을(를) 차단합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍງານການຈ່າຍເງິນທີ່ທ່ານບໍ່ຄາດຄິດ: %1$@ ຈ່າຍ %2$@ ໃນ %3$@. ພວກເຮົາຢຸດ %1$@ ຈົນກວ່າທ່ານຈະກວດແລ້ວ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pranešite apie mokėjimą, kurio nesitikėjote: %1$@ sumokėjo %2$@ %3$@. Sustabdysime %1$@, kol patikrinsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziņo par maksājumu, ko negaidīji: %1$@ %3$@ samaksāja %2$@. Mēs apturēsim %1$@, līdz tu to apskatīsi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пријави плаќање што не го очекуваше: %1$@ плати %2$@ на %3$@. Го запираме %1$@ додека не погледнеш."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны хүлээгээгүй төлбөрийг мэдэгдэнэ үү: %1$@ %3$@-д %2$@ төлсөн. Та үзэж дуустал бид %1$@-ыг зогсооно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले नसोचेको भुक्तानी रिपोर्ट गर्नुहोस्: %1$@ ले %3$@ मा %2$@ तिर्‍यो। तपाईंले हेरिसक्नेसम्म हामी %1$@ रोक्छौँ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld een betaling die je niet verwachtte: %1$@ betaalde %2$@ op %3$@. We zetten %1$@ stil totdat je hebt gekeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoś nieoczekiwaną płatność: %1$@ zapłacił %2$@ dnia %3$@. Blokujemy %1$@, dopóki jej nie sprawdzisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comunique um pagamento que não esperava: %1$@ pagou %2$@ em %3$@. Bloqueamos %1$@ até que verifique."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comunique um pagamento que não esperava: %1$@ pagou %2$@ em %3$@. Bloqueamos %1$@ até que verifique."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportați o plată la care nu vă așteptați: %1$@ a plătit %2$@ pe %3$@. Oprim %1$@ până când verificați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahláste platbu, ktorú ste nečakali: %1$@ zaplatil %2$@ dňa %3$@. %1$@ zastavíme, kým sa nepozriete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite plačilo, ki ga niste pričakovali: %1$@ je dne %3$@ plačal %2$@. %1$@ bomo ustavili, dokler ne preverite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportoni një pagesë që nuk e prisnit: %1$@ pagoi %2$@ më %3$@. E bllokojmë %1$@ derisa ta shihni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite plaćanje koje niste očekivali: %1$@ je platio %2$@ dana %3$@. Blokiramo %1$@ dok ne pogledate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงานการชำระเงินที่คุณไม่คาดคิด: %1$@ ชำระ %2$@ เมื่อ %3$@ เราจะระงับ %1$@ จนกว่าคุณจะตรวจสอบ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Garaşylmadyk töleg barada habar beriň: %1$@ %3$@ senesinde %2$@ töledi. Siz seredýänçäňiz biz %1$@-y togtadýarys."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklemediğiniz bir ödemeyi bildirin: %1$@, %3$@ tarihinde %2$@ ödedi. Siz bakana kadar %1$@ taf'ını donduruyoruz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایسی ادائیگی کی رپورٹ کریں جس کی آپ کو توقع نہیں تھی: %1$@ نے %3$@ کو %2$@ ادا کیے۔ آپ کے دیکھنے تک ہم %1$@ کو روک دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo khoản thanh toán bạn không ngờ tới: %1$@ đã thanh toán %2$@ vào %3$@. Chúng tôi đóng băng %1$@ cho đến khi bạn xem xét."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回報您未預期的付款：%1$@ 於 %3$@ 支付了 %2$@。在您查看之前，我們會凍結 %1$@。"
          }
        }
      }
    },
