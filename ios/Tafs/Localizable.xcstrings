    "people.delete_group_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Personen verlieren die tafs, die sie über sie genutzt haben, außer eine andere Gruppe oder eine eigene Freigabe gibt ihnen diese tafs. Ihre Chats bleiben ihre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its people lose the tafs they used through it, unless another group or a share of their own gives them those tafs. Their chats stay theirs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus personas pierden los tafs que usaban a través de él, salvo que otro grupo o un uso compartido propio les dé esos tafs. Sus chats siguen siendo suyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses membres perdent les tafs qu'ils utilisaient par son biais, sauf si un autre groupe ou un partage personnel leur donne ces tafs. Leurs chats restent les leurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue persone perdono i tafs che usavano tramite il gruppo, a meno che un altro gruppo o una loro condivisione non glieli dia. Le loro chat restano loro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mensen erin verliezen de tafs die ze via de groep gebruikten, tenzij een andere groep of een eigen deling ze die tafs geeft. Hun chats blijven van hen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jej członkowie stracą tafs, których używali przez nią, chyba że daje im je inna grupa lub ich własne udostępnienie. Ich czaty pozostaną ich."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas pessoas perdem os tafs que usavam através dele, a menos que outro grupo ou uma partilha própria lhes dê esses tafs. Os seus chats continuam a ser seus."
          }
        }
      }
    },
