        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan ini tidak cocok dengan yang ditampilkan, jadi tidak dapat disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa richiesta non corrisponde a ciò che mostra, quindi non può essere approvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストは表示内容と一致しないため、承認できません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს მოთხოვნა არ ემთხვევა იმას, რასაც აჩვენებს, ამიტომ ვერ დამტკიცდება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청은 표시된 내용과 일치하지 않아 승인할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ši užklausa neatitinka to, ką rodo, todėl jos patvirtinti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis pieprasījums neatbilst tam, ko tas rāda, tāpēc to nevar apstiprināt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verzoek komt niet overeen met wat het toont, dus het kan niet worden goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prośba nie zgadza się z tym, co pokazuje, więc nie można jej zatwierdzić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido não corresponde ao que mostra, por isso não pode ser aprovado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido não corresponde ao que mostra, por isso não pode ser aprovado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această solicitare nu corespunde cu ce afișează, așa că nu poate fi aprobată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto žiadosť nezodpovedá tomu, čo ukazuje, takže ju nemožno schváliť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta zahteva se ne ujema s tem, kar prikazuje, zato je ni mogoče odobriti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo kërkesë nuk përputhet me atë që shfaq, ndaj nuk mund të miratohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj zahtev ne odgovara onome šta prikazuje pa se ne može odobriti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอนี้ไม่ตรงกับสิ่งที่มันแสดง จึงอนุมัติไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istek, gösterdiğiyle eşleşmiyor, bu yüzden onaylanamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu này không khớp với điều nó hiển thị nên không thể phê duyệt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此請求與它所顯示的內容不符，因此無法核准。"
          }
        }
      }
    },
    "connect.schedule_chats_run_reports_memory": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Cədvəli, söhbətləri, iş hesabatları, yaddaşı və açarı silindi, %2$@ adı isə azaddır. KIFF qəbzləri qalır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Графикът, чатовете, отчетите за изпълнения, паметта и ключът му са изтрити, а името %2$@ е свободно. Разписките на KIFF остават."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Jeho plán, chaty, zprávy z běhů, paměť a klíč jsou smazané a název %2$@ je volný. Potvrzení od KIFF zůstávají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Sein Zeitplan, seine Chats, Laufberichte, sein Gedächtnis und sein Schlüssel werden gelöscht, und der Name %2$@ wird frei. KIFFs Belege bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Its schedule, chats, run reports, memory and key are deleted, and the name %2$@ is free. KIFF's receipts stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Se eliminan su programación, sus chats, sus informes de ejecución, su memoria y su clave, y el nombre %2$@ queda libre. Los recibos de KIFF se conservan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Selle ajakava, vestlused, käivituste aruanded, mälu ja võti on kustutatud ning nimi %2$@ on vaba. KIFFi kviitungid jäävad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Son planning, ses chats, ses rapports d'exécution, sa mémoire et sa clé sont supprimés, et le nom %2$@ redevient libre. Les reçus de KIFF restent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Brišu se njegov raspored, razgovori, izvješća izvođenja, memorija i ključ, a naziv %2$@ postaje slobodan. KIFF-ove potvrde ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Az ütemezése, csevegései, futási jelentései, memóriája és kulcsa törölve, és a(z) %2$@ név szabad. A KIFF nyugtái megmaradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Նրա ժամանակացույցը, զրույցները, գործարկումների հաշվետվությունները, հիշողությունը և բանալին ջնջվեցին, և %2$@ անունը ազատ է։ KIFF-ի անդորրագրերը մնում են։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Jadwal, obrolan, laporan eksekusi, memori, dan kuncinya dihapus, dan nama %2$@ bebas. Tanda terima KIFF tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ La sua pianificazione, le chat, i resoconti delle esecuzioni, la memoria e la chiave vengono eliminati, e il nome %2$@ torna libero. Le ricevute di KIFF restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ スケジュール、チャット、実行レポート、メモ、キーが削除され、%2$@という名前は使えるようになりました。KIFFの領収書は残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ მისი განრიგი, ჩატები, გაშვების ანგარიშები, მეხსიერება და გასაღები წაიშალა, და სახელი %2$@ თავისუფალია. KIFF-ის ქვითრები რჩება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 일정, 채팅, 실행 보고서, 기억, 키가 삭제되었고 %2$@ 이름을 다시 쓸 수 있습니다. KIFF의 영수증은 남습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Jo tvarkaraštis, pokalbiai, paleidimų ataskaitos, atmintis ir raktas ištrinami, o pavadinimas %2$@ tampa laisvas. KIFF kvitai lieka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Tā grafiks, sarunas, palaišanu ziņojumi, atmiņa un atslēga tiek dzēsti, un nosaukums %2$@ kļūst brīvs. KIFF kvītis paliek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ De planning, chats, runrapporten, het geheugen en de sleutel worden verwijderd, en de naam %2$@ komt vrij. De ontvangstbewijzen van KIFF blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Jego harmonogram, czaty, raporty z uruchomień, pamięć i klucz zostaną usunięte, a nazwa %2$@ będzie wolna. Potwierdzenia KIFF zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ O seu agendamento, chats, relatórios de execução, memória e chave são eliminados, e o nome %2$@ fica livre. Os recibos do KIFF mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ O agendamento, chats, relatórios de execução, memória e chave dele são excluídos, e o nome %2$@ fica livre. Os recibos do KIFF são mantidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Programul, conversațiile, rapoartele de rulare, memoria și cheia sa sunt șterse, iar numele %2$@ este liber. Chitanțele KIFF rămân."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Jeho plán, chaty, správy z behov, pamäť a kľúč sú odstránené a názov %2$@ je voľný. Potvrdenia od KIFF zostávajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Njegov urnik, klepeti, poročila o zagonih, spomin in ključ so izbrisani, ime %2$@ pa je prosto. Potrdila KIFF ostanejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Orari, bisedat, raportet e ekzekutimeve, kujtesa dhe çelësi i tij janë fshirë, dhe emri %2$@ është i lirë. Dëftesat e KIFF mbeten."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Brišu se njegov raspored, razgovori, izveštaja izvršavanja, memorija i ključ, a naziv %2$@ postaje slobodan. KIFF-ove potvrde ostaju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ กำหนดการ แชต รายงานการทำงาน ความจำ และกุญแจของมันจะถูกลบ และชื่อ %2$@ จะว่าง ใบเสร็จของ KIFF ยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Zamanlaması, sohbetleri, çalıştırma raporları, belleği ve anahtarı silinir ve %2$@ adı serbest kalır. KIFF'in makbuzları kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Lịch, các cuộc trò chuyện, báo cáo lượt chạy, bộ nhớ và khóa của nó bị xóa, và tên %2$@ được giải phóng. Biên nhận của KIFF vẫn còn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 它的排程、對話、執行報告、記憶和金鑰會被刪除，名稱 %2$@ 會釋出。KIFF 的收據會保留。"
          }
        }
      }
    },
