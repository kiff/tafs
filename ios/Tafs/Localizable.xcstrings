        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace tohoto účtu zatím připojuje jiné zařízení. Připojte je z něj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Gerät verbindet vorerst die Apps dieses Kontos. Verbinde sie von dort aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another device connects this account's apps for now. Connect them from that one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora, otro dispositivo conecta las apps de esta cuenta. Conéctalas desde ese."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle konto rakendusi ühendab praegu teine seade. Ühenda need sellest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre appareil connecte les apps de ce compte pour le moment. Connectez-les depuis celui-ci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בינתיים התקן אחר מחבר את האפליקציות של החשבון הזה. יש לחבר אותן משם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी इस खाते के ऐप कोई और डिवाइस जोड़ता है। उन्हें उसी से जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije ovog računa za sada povezuje drugi uređaj. Povežite ih s njega."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyelőre egy másik eszköz csatlakoztatja ennek a fióknak az alkalmazásait. Arról csatlakoztasd őket."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հաշվի հավելվածները առայժմ միացնում է մեկ այլ սարք։ Միացրեք դրանք այնտեղից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk sementara perangkat lain yang menghubungkan aplikasi akun ini. Hubungkan dari perangkat itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora un altro dispositivo collega le app di questo account. Collegale da quello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、このアカウントのアプリは別のデバイスで接続しています。そのデバイスから接続してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ანგარიშის აპებს ჯერჯერობით სხვა მოწყობილობა აკავშირებს. დააკავშირეთ ისინი იქიდან."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឥឡូវនេះឧបករណ៍ផ្សេងភ្ជាប់កម្មវិធីនៃគណនីនេះ។ ភ្ជាប់ពួកវាពីឧបករណ៍នោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 다른 기기가 이 계정의 앱을 연결합니다. 그 기기에서 연결하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດຽວນີ້ອຸປະກອນອື່ນເຊື່ອມຕໍ່ແອັບຂອງບັນຊີນີ້. ເຊື່ອມຕໍ່ຈາກເຄື່ອງນັ້ນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiuo metu šios paskyros programėles prijungia kitas įrenginys. Prijunkite jas iš jo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagaidām šī konta lietotnes pievieno cita ierīce. Pievieno tās no tās ierīces."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Засега друг уред ги поврзува апликациите на оваа сметка. Поврзи ги од тој."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Одоохондоо өөр төхөөрөмж энэ бүртгэлийн аппуудыг холбодог. Тэр төхөөрөмжөөс холбоно уу."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अहिलेका लागि अर्को उपकरणले यस खाताका एप जडान गर्छ। त्यहीँबाट जडान गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ander apparaat koppelt voorlopig de apps van dit account. Koppel ze vanaf dat apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie aplikacje tego konta łączy inne urządzenie. Połącz je z tamtego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por agora, é outro dispositivo que liga as apps desta conta. Ligue-as a partir desse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por enquanto, é outro dispositivo que conecta os apps desta conta. Conecte-os a partir dele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deocamdată alt dispozitiv conectează aplicațiile acestui cont. Conectați-le de pe acela."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácie tohto účtu zatiaľ pripája iné zariadenie. Pripojte ich z neho."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije tega računa zaenkrat povezuje druga naprava. Povežite jih z nje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Për momentin aplikacionet e kësaj llogarie i lidh një pajisje tjetër. Lidhini nga ajo."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije ovog naloga za sada povezuje drugi uređaj. Povežite ih s njega."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้อุปกรณ์อื่นเชื่อมต่อแอปของบัญชีนี้ ให้เชื่อมต่อจากอุปกรณ์นั้น"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Häzirlikçe bu hasabyň programmalaryny başga bir enjam birikdirýär. Olary şol enjamdan birikdiriň."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdilik bu hesabın uygulamalarını başka bir cihaz bağlıyor. Onları o cihazdan bağlayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فی الحال اس اکاؤنٹ کی ایپس کوئی اور ڈیوائس جوڑتی ہے۔ انہیں اسی سے جوڑیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện một thiết bị khác kết nối các ứng dụng của tài khoản này. Hãy kết nối chúng từ thiết bị đó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前由另一部裝置連接此帳號的 App。請從那部裝置連接。"
          }
        }
      }
    },
