            "value": "O bot continua a ouvir, por isso a porta mantém-se. %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot continua ouvindo, por isso a porta continua. %1$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Botul încă ascultă, așa că ușa rămâne. %1$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot stále počúva, takže dvere zostávajú. %1$@"
