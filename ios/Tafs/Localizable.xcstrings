          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché qualcosa è stato rifiutato o trattenuto?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom is iets geweigerd of vastgehouden?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego coś zostało odrzucone lub jest oczekujące?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque é que algo foi recusado ou retido?"
          }
        }
      }
    },
    "coach.improve_line": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag, was sich ändern soll, oder frag, wie es läuft. Der Coach-Modus geht davon aus, was %1$@ getan hat und was seine Card erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say what should change, or ask how it's going. Coach mode starts from what %1$@ did and what its Card allows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di qué debería cambiar, o pregunta cómo va. El modo Coach parte de lo que hizo %1$@ y de lo que permite su Card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites ce qui doit changer, ou demandez comment ça se passe. Le mode Coach part de ce que %1$@ a fait et de ce que sa Card autorise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' cosa dovrebbe cambiare, o chiedi come sta andando. La modalità Coach parte da ciò che %1$@ ha fatto e da ciò che la sua Card consente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg wat er moet veranderen, of vraag hoe het gaat. De Coach-modus begint bij wat %1$@ heeft gedaan en wat zijn Card toestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz, co powinno się zmienić, albo zapytaj, jak idzie. Tryb Coach zaczyna od tego, co zrobił %1$@ i na co pozwala jego Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga o que deve mudar, ou pergunte como está a correr. O modo Coach parte do que %1$@ fez e do que o seu Card permite."
          }
        }
      }
    },
    "coach.improve_taf": {
      "extractionState": "manual",
      "localizations": {
