    "receipt.changed": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qəbz KIFF imzalayandan sonra dəyişdirilib və ya KIFF tərəfindən imzalanmayıb. Bu sətirə etibar etməyin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази разписка е променена, след като KIFF я е подписал, или не е подписана от KIFF. Не разчитайте на този ред."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto potvrzení se změnilo poté, co ho KIFF podepsal, nebo ho KIFF nepodepsal. Na tento řádek se nespoléhejte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Beleg wurde geändert, nachdem KIFF ihn signiert hat, oder er wurde nicht von KIFF signiert. Verlass dich nicht auf diese Zeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This receipt was changed after KIFF signed it, or it wasn't signed by KIFF. Don't rely on this line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recibo se modificó después de que KIFF lo firmara, o no lo firmó KIFF. No confíes en esta línea."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda kviitungit muudeti pärast seda, kui KIFF selle allkirjastas, või ei allkirjastanud seda KIFF. Ära sellele reale tugine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce reçu a été modifié après sa signature par KIFF, ou il n'a pas été signé par KIFF. Ne vous fiez pas à cette ligne."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova je potvrda promijenjena nakon što ju je KIFF potpisao ili je nije potpisao KIFF. Ne oslanjajte se na ovaj redak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a nyugtát a KIFF aláírása után módosították, vagy nem a KIFF írta alá. Ne hagyatkozz erre a sorra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս անդորրագիրը փոխվել է այն բանից հետո, երբ KIFF-ը ստորագրել է այն, կամ այն KIFF-ի կողմից ստորագրված չէ։ Մի հիմնվեք այս տողի վրա։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda terima ini diubah setelah KIFF menandatanganinya, atau tidak ditandatangani oleh KIFF. Jangan mengandalkan baris ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa ricevuta è stata modificata dopo che KIFF l'ha firmata, oppure non è stata firmata da KIFF. Non fare affidamento su questa riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この領収書はKIFFの署名後に変更されたか、KIFFが署名していません。この行を信頼しないでください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ქვითარი შეიცვალა მას შემდეგ, რაც KIFF-მა ხელი მოაწერა, ან მას KIFF-ს არ მოუწერია ხელი. ნუ დაეყრდნობით ამ ხაზს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 영수증은 KIFF가 서명한 후 변경되었거나 KIFF가 서명하지 않았습니다. 이 항목을 신뢰하지 마세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis kvitas pakeistas po to, kai KIFF jį pasirašė, arba jo nepasirašė KIFF. Nepasikliaukite šia eilute."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī kvīts tika mainīta pēc tam, kad KIFF to parakstīja, vai arī to nav parakstījis KIFF. Nepaļaujies uz šo rindu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit ontvangstbewijs is gewijzigd nadat KIFF het ondertekende, of het is niet door KIFF ondertekend. Vertrouw niet op deze regel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To potwierdzenie zostało zmienione po podpisaniu przez KIFF albo nie zostało podpisane przez KIFF. Nie polegaj na tym wierszu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recibo foi alterado depois de o KIFF o assinar, ou não foi assinado pelo KIFF. Não confie nesta linha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recibo foi alterado depois de o KIFF o assinar, ou não foi assinado pelo KIFF. Não confie nesta linha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această chitanță a fost modificată după ce KIFF a semnat-o sau nu a fost semnată de KIFF. Nu vă bazați pe acest rând."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto potvrdenie sa zmenilo potom, čo ho KIFF podpísal, alebo ho KIFF nepodpísal. Na tento riadok sa nespoliehajte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To potrdilo je bilo spremenjeno, potem ko ga je KIFF podpisal, ali pa ga KIFF ni podpisal. Ne zanašajte se na to vrstico."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo dëftesë u ndryshua pasi KIFF e nënshkroi, ose nuk u nënshkrua nga KIFF. Mos u mbështetni te ky rresht."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova je potvrda promenjena nakon šta ju je KIFF potpisao ili je nije potpisao KIFF. Ne oslanjajte se na ovaj red."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใบเสร็จนี้ถูกเปลี่ยนแปลงหลังจาก KIFF ลงนามแล้ว หรือไม่ได้ลงนามโดย KIFF อย่าเชื่อถือบรรทัดนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu makbuz KIFF imzaladıktan sonra değiştirilmiş veya KIFF tarafından imzalanmamış. Bu satıra güvenmeyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biên nhận này đã bị thay đổi sau khi KIFF ký, hoặc không do KIFF ký. Đừng dựa vào dòng này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此收據在 KIFF 簽署後被更改，或並非由 KIFF 簽署。請勿信賴這一行。"
          }
        }
      }
    },
    "receipt.check.amount_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sətirdəki məbləğ KIFF-in qəbzinə uyğun gəlmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумата на този ред не съвпада с разписката на KIFF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částka na tomto řádku neodpovídá potvrzení od KIFF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrag in dieser Zeile stimmt nicht mit KIFFs Beleg überein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The amount on this line doesn't match KIFF's receipt."
          }
        },
        "es": {
