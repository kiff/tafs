        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ainda não tem porta. Alguém que o gerencia pode adicionar uma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nu are încă nicio ușă. Cineva care îl gestionează poate adăuga una."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatiaľ nemá žiadne dvere. Môže ich pridať ten, kto ho spravuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ še nima vrat. Doda jih lahko nekdo, ki ga upravlja."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ende nuk ka portë. Dikush që e menaxhon mund të shtojë një."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Taf %1$@ još nema vrata. Netko ko njime upravlja može ih dodati."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ยังไม่มีประตู ผู้ที่จัดการมันเพิ่มได้"
