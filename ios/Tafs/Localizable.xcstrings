    "approval.add_face_id_first": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte zuerst Face ID oder einen Fingerabdruck in den Einstellungen ein: Dieses %1$@ genehmigt damit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Face ID or a fingerprint in Settings first: this %1$@ approves with one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade Face ID o una huella en Ajustes: este %1$@ aprueba con ello."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa esmalt seadetes Face ID või sõrmejälg: see %1$@ kinnitab sellega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord Face ID ou une empreinte dans Réglages : %2$@ approuve avec l'un des deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima Face ID o un'impronta in Impostazioni: questo %1$@ approva con uno dei due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に設定でFace IDまたは指紋を追加してください。この%1$@はそれで承認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 설정에서 Face ID나 지문을 추가하세요. 이 %1$@에서는 그것으로 승인합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmiausia nustatymuose pridėkite Face ID arba piršto atspaudą: šis įrenginys (%1$@) tvirtina juo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vispirms iestatījumos pievieno Face ID vai pirksta nospiedumu: šis %1$@ apstiprina ar to."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg eerst Face ID of een vingerafdruk toe in Instellingen: deze %1$@ keurt daarmee goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw dodaj Face ID lub odcisk palca w Ustawieniach: ten %1$@ zatwierdza za ich pomocą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione primeiro o Face ID ou uma impressão digital nas Definições: este %1$@ aprova com um deles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione primeiro o Face ID ou uma impressão digital nas Configurações: este %1$@ aprova com um deles."
          }
        }
      }
    },
    "approval.adding_face_fingerprint_later_ends": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügst du später ein Gesicht oder einen Fingerabdruck hinzu, endet der Genehmigungsschlüssel dieses Geräts, und du genehmigst dieses Gerät dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding a face or fingerprint later ends this device's approval key, so you approve this device again then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si más adelante añades una cara o una huella, la clave de aprobación de este dispositivo deja de valer, y tendrás que volver a aprobar este dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui lisad hiljem näo või sõrmejälje, lõpeb selle seadme kinnitusvõti ja pead selle seadme siis uuesti kinnitama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter plus tard un visage ou une empreinte met fin à la clé d'approbation de cet appareil : vous devrez alors approuver à nouveau cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se in seguito aggiungi un volto o un'impronta, la chiave di approvazione di questo dispositivo termina, quindi dovrai approvare di nuovo questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で顔や指紋を追加すると、このデバイスの承認キーが無効になるため、その時にこのデバイスをもう一度承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 얼굴이나 지문을 추가하면 이 기기의 승인 키가 종료되므로, 그때 이 기기를 다시 승인해야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vėliau pridėjus veidą ar piršto atspaudą, šio įrenginio patvirtinimo raktas nustoja galioti, todėl tada šį įrenginį turėsite patvirtinti dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja vēlāk pievienosi seju vai pirksta nospiedumu, šīs ierīces apstiprināšanas atslēga beigsies, un tev šī ierīce būs jāapstiprina vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg je later een gezicht of vingerafdruk toe, dan vervalt de goedkeuringssleutel van dit apparaat en keur je dit apparaat opnieuw goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodanie później twarzy lub odcisku palca unieważnia klucz zatwierdzania tego urządzenia, więc wtedy zatwierdzisz to urządzenie ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar mais tarde um rosto ou uma impressão digital anula a chave de aprovação deste dispositivo; terá então de aprovar este dispositivo novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar mais tarde um rosto ou uma impressão digital anula a chave de aprovação deste dispositivo; terá então de aprovar este dispositivo novamente."
          }
        }
      }
    },
