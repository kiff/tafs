        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "„არა“ Card-ს სივრცეს უბრუნებს. პასუხს სჭირდება: %1$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거절하면 Card의 여유가 돌아옵니다. 답변하려면 %1$@이(가) 필요합니다."
          }
        },
        "lt": {
