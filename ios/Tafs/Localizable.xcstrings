        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas apstājās pusceļā, pirms tika pabeigts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is halverwege gestopt, voordat het klaar was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zatrzymało się w połowie, zanim się skończyło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto parou a meio, antes de terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto parou a meio, antes de terminar."
          }
        },
        "ro": {
