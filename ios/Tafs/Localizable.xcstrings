    "version.go_back_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Test-Card von Version %1$@ stoppt sofort, und dieser Chat wird gelöscht. %2$@ arbeitet weiter wie bisher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %3$@ trial Card stops at once, and this chat is deleted. %2$@ keeps working as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Card de prueba de la versión %1$@ se detiene al instante, y este chat se elimina. %2$@ sigue funcionando como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Card d'essai de la version %1$@ s'arrête immédiatement, et ce chat est supprimé. %2$@ continue de fonctionner tel quel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Card di prova della versione %1$@ si ferma subito, e questa chat viene eliminata. %2$@ continua a lavorare com'è."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De proef-Card van versie %1$@ stopt meteen, en deze chat wordt verwijderd. %2$@ blijft werken zoals het is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Card próbna wersji %1$@ natychmiast przestaje działać, a ten czat zostanie usunięty. %2$@ działa dalej bez zmian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Card de experiência da versão %1$@ para de imediato, e este chat é eliminado. %2$@ continua a funcionar como está."
          }
        }
      }
    },
