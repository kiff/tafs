    "people.own_chats": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər kəsin öz söhbətləri və qeydləri var. Tətbiqdə onları başqa heç kim görmür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки човек има собствени чатове и бележки. Никой друг не ги вижда в приложението."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý má své vlastní chaty a poznámky. Nikdo jiný je v aplikaci nevidí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Person hat ihre eigenen Chats und Notizen. Niemand sonst sieht sie in der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each person gets their own chats and notes. No one else sees them in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada persona tiene sus propios chats y notas. Nadie más los ve en la app."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igal inimesel on oma vestlused ja märkmed. Keegi teine ei näe neid rakenduses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque personne a ses propres chats et notes. Personne d'autre ne les voit dans l'app."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka osoba ima vlastite razgovore i bilješke. Nitko drugi ih ne vidi u aplikaciji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindenki saját csevegéseket és jegyzeteket kap. Az alkalmazásban senki más nem látja őket."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր մարդ ունի իր սեփական զրույցներն ու նշումները։ Հավելվածում ուրիշ ոչ ոք դրանք չի տեսնում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap orang memiliki obrolan dan catatannya sendiri. Tidak ada orang lain yang melihatnya di aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni persona ha le sue chat e le sue note. Nessun altro le vede nell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各メンバーは自分専用のチャットとメモを持ちます。アプリ内で他の人がそれを見ることはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითოეულ ადამიანს საკუთარი ჩატები და ჩანაწერები აქვს. აპში მათ სხვა ვერავინ ხედავს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 사람은 자신만의 채팅과 메모를 가집니다. 앱에서 다른 사람은 이를 볼 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas asmuo turi savo pokalbius ir pastabas. Programėlėje jų niekas kitas nemato."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katram cilvēkam ir savas sarunas un piezīmes. Lietotnē tās neredz neviens cits."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen krijgt eigen chats en notities. Niemand anders ziet ze in de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda osoba ma własne czaty i notatki. Nikt inny nie widzi ich w aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pessoa tem os seus próprios chats e notas. Mais ninguém os vê na app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pessoa tem os seus próprios chats e notas. Mais ninguém os vê no app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare persoană are propriile conversații și notițe. Nimeni altcineva nu le vede în aplicație."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý má svoje vlastné chaty a poznámky. Nikto iný ich v aplikácii nevidí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak ima svoje klepete in zapiske. Nihče drug jih v aplikaciji ne vidi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo person ka bisedat dhe shënimet e veta. Askush tjetër nuk i sheh në aplikacion."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka osoba ima vlastite razgovore i beleške. Nitko drugi ih ne vidi u aplikaciji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละคนมีแชตและบันทึกของตัวเอง ไม่มีคนอื่นเห็นในแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kişinin kendi sohbetleri ve notları vardır. Uygulamada başka kimse onları görmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi người có các cuộc trò chuyện và ghi chú riêng. Không ai khác thấy chúng trong ứng dụng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個人都有自己的對話與備註。App 中其他人看不到這些內容。"
