    "approval.security_key.pin_paused": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, ardıcıl üç yanlış PIN-dir. Açarı çıxarın, yenidən qoşun, sonra yenidən cəhd edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това са три грешни ПИН кода подред. Извадете ключа, включете го отново и опитайте пак."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Třikrát po sobě špatný PIN. Odpojte klíč, znovu ho připojte a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind drei falsche PINs hintereinander. Zieh den Schlüssel ab, steck ihn wieder ein und versuch es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's three wrong PINs in a row. Unplug the key, plug it in again, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tres PIN incorrectos seguidos. Desconecta la llave, vuelve a conectarla y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolm valet PIN-koodi järjest. Eemalda võti, ühenda see uuesti ja proovi siis uuesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois codes PIN incorrects de suite. Débranchez la clé, rebranchez-la, puis réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To su tri pogrešna PIN-a zaredom. Iskopčajte ključ, ponovno ga priključite, pa pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egymás után három hibás PIN-kód. Húzd ki a kulcsot, csatlakoztasd újra, majd próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա երեք սխալ PIN է անընդմեջ։ Անջատեք բանալին, նորից միացրեք, ապա փորձեք նորից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu tiga PIN salah berturut-turut. Cabut kunci, colokkan lagi, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono tre PIN errati di fila. Scollega la chiave, ricollegala, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PINを3回続けて間違えました。キーを抜いて差し直してから、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს სამი არასწორი PIN-ია ზედიზედ. გამოაძვრინეთ გასაღები, ისევ ჩართეთ, შემდეგ სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN을 연속으로 세 번 틀렸습니다. 키를 뽑았다가 다시 꽂은 뒤 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tris kartus iš eilės įvestas neteisingas PIN. Atjunkite raktą, vėl jį prijunkite ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trīs nepareizi PIN pēc kārtas. Atvieno atslēgu, pievieno to vēlreiz, tad mēģini vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zijn drie verkeerde pincodes achter elkaar. Haal de sleutel eruit, steek hem er weer in en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To trzy złe PIN-y z rzędu. Odłącz klucz, podłącz go ponownie i spróbuj jeszcze raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São três PIN errados seguidos. Desligue a chave, volte a ligá-la e tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São três PIN errados seguidos. Desconecte a chave, conecte-a novamente e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Au fost trei PIN-uri greșite la rând. Scoateți cheia, conectați-o din nou, apoi încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trikrát za sebou nesprávny PIN. Odpojte kľúč, znova ho pripojte a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trikrat zapored napačen PIN. Izključite ključ, ga znova priključite in poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo janë tre PIN të gabuar radhazi. Hiqeni çelësin, futeni sërish, pastaj provoni sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "To su tri pogrešna PIN-a zaredom. Isključite ključ, ponovo ga priključite, pa pokušajte ponovo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ PIN ผิดติดต่อกันสามครั้งแล้ว ถอดกุญแจออก เสียบใหม่ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst üste üç yanlış PIN oldu. Anahtarı çıkarın, tekrar takın, sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là ba lần PIN sai liên tiếp. Hãy rút khóa, cắm lại, rồi thử lại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續輸入錯誤三次。請拔出金鑰，重新插入，然後再試一次。"
          }
        }
      }
    },
