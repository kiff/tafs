    "door.anyone_else_today": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün başqalarından %2$@ içindən %1$@."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ от %2$@ от всеки друг днес."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od kohokoli jiného dnes %1$@ z %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@ von allen anderen heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@ from anyone else today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ de cualquier otra persona hoy."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täna kõigilt teistelt %1$@/%2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@ de toute autre personne aujourd'hui."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ od %2$@ od svih ostalih danas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma %1$@ / %2$@ bárki mástól."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-ից ցանկացած ուրիշից այսօր։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dari %2$@ dari orang lain hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ su %2$@ da chiunque altro oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の他の人からの連絡：%2$@件中%1$@件。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@-დან ნებისმიერი სხვისგან დღეს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 다른 사람에게서 %2$@건 중 %1$@건."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandien: %1$@ iš %2$@ – iš kitų žmonių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "No visiem citiem šodien: %1$@ no %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van %2$@ van anderen vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ z %2$@ od wszystkich innych dziś."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ de qualquer outra pessoa hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ de qualquer outra pessoa hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ din %2$@ de la oricine altcineva azi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Od kohokoľvek iného dnes %1$@ z %2$@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od kogarkoli drugega danes %1$@ od %2$@."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nga %2$@ nga këdo tjetër sot."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ od %2$@ od svih ostalih danas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จาก %2$@ จากคนอื่นวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün başkalarından %1$@ / %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@ từ những người khác hôm nay."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天來自其他人的有 %1$@ / %2$@。"
          }
        }
      }
    },
    "door.api.boundary": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qapının açarı %1$@ taf-ına yalnız iş verə bilər. O, heç vaxt ödəyə və ya ala bilməz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът на врата може само да дава работа на %1$@. Никога не може да плаща или купува."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč od dveří může %1$@ jen předávat práci. Nikdy nemůže platit ani nakupovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel einer Tür kann %1$@ nur Arbeit geben. Er kann nie zahlen oder kaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A door's key can only hand %1$@ work. It can never pay or buy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de una puerta solo puede darle trabajo a %1$@. Nunca puede pagar ni comprar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukse võti saab tafile %1$@ ainult tööd anda. See ei saa kunagi maksta ega osta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé d'une porte peut seulement confier du travail à %1$@. Elle ne peut jamais payer ni acheter."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ vrata može tafu %1$@ samo predati posao. Nikad ne može platiti ni kupiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy ajtó kulcsa csak munkát adhat neki (%1$@). Soha nem fizethet vagy vásárolhat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դռան բանալին կարող է %1$@-ին միայն աշխատանք տալ։ Այն երբեք չի վճարի կամ չի գնի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci sebuah pintu hanya dapat menyerahkan pekerjaan kepada %1$@. Ia tidak pernah dapat membayar atau membeli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di una porta può solo affidare lavoro a %1$@. Non può mai pagare né comprare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "窓口のキーでできるのは%1$@に仕事を渡すことだけです。支払いや購入は決してできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კარის გასაღებს მხოლოდ %1$@-ისთვის სამუშაოს მიცემა შეუძლია. ის არასოდეს გადაიხდის და არაფერს იყიდის."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창구의 키로는 %1$@에게 작업을 맡기는 것만 할 수 있습니다. 결제나 구매는 절대 할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durų raktas gali tik perduoti darbą %1$@. Juo niekada negalima mokėti ar pirkti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Durvju atslēga var tikai nodot %1$@ darbu. Tā nekad nevar maksāt vai pirkt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel van een deur kan %1$@ alleen werk geven. Hij kan nooit betalen of kopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz do drzwi może tylko zlecać pracę dla %1$@. Nigdy nie może płacić ani kupować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de uma porta só pode entregar trabalho a %1$@. Nunca pode pagar nem comprar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de uma porta só pode entregar trabalho a %1$@. Nunca pode pagar nem comprar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia unei uși îi poate da lui %1$@ doar de lucru. Nu poate niciodată plăti sau cumpăra."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúč od dverí môže %1$@ len odovzdávať prácu. Nikdy nemôže platiť ani nakupovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ vrat lahko %1$@ samo predaja delo. Nikoli ne more plačati ali kupiti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çelësi i një porte mund t'i japë %1$@ vetëm punë. Nuk mund të paguajë ose të blejë kurrë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ vrata može tafu %1$@ samo predati posao. Nikad ne može platiti ni kupiti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กุญแจของประตูมอบงานให้ %1$@ ได้เท่านั้น ไม่มีทางชำระเงินหรือซื้อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kapının anahtarı %1$@ taf'ına yalnızca iş verebilir. Asla ödeme yapamaz veya satın alamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa của một cửa chỉ có thể giao việc cho %1$@. Nó không bao giờ thanh toán hay mua được."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
