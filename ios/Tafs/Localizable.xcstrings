        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հեռախոսում մատնահետք կարգավորված չէ։ Ավելացրեք այն հեռախոսի կարգավորումներում, ապա վերադարձեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada sidik jari yang disiapkan di ponsel ini. Tambahkan di pengaturannya, lalu kembali."
