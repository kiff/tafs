          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "(Risposta di esempio. Con l'accesso a KIFF, il tuo taf risponde davvero.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（サンプルの返信です。KIFFでサインインすると、tafが実際に回答します。）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(샘플 답장입니다. KIFF로 로그인하면 taf가 실제로 답합니다.)"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "(Pavyzdinis atsakymas. Prisijungus su KIFF, jūsų taf atsako iš tikrųjų.)"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "(Parauga atbilde. Kad pierakstīsies ar KIFF, tavs taf atbildēs pa īstam.)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "(Voorbeeldantwoord. Ingelogd met KIFF antwoordt je taf echt.)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "(Przykładowa odpowiedź. Po zalogowaniu przez KIFF Twój taf odpowiada naprawdę.)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "(Resposta de exemplo. Com sessão iniciada no KIFF, o seu taf responde a sério.)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "(Resposta de exemplo. Com login feito no KIFF, o seu taf responde de verdade.)"
          }
        }
      }
    },
    "sample.reply.nothing_done": {
