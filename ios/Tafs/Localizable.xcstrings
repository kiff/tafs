    "drive.card_note_pauses": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach siz izləyərkən bu tətbiqdə toxunur və yazır, yalnız bu sorğu üçün. O, heç nəyi təsdiqləmir. Dayandırmaq üçün tətbiqə toxunun və ya bitirmək üçün «Dayandırın» düyməsinə basın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach докосва и пише в това приложение, докато гледате, само за тази заявка. Никога не потвърждава нищо. Докоснете приложението, за да го спрете на пауза, или докоснете „Спиране“, за да приключите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach v této aplikaci klepe a píše, zatímco se díváte, jen pro tuto žádost. Nikdy nic nepotvrzuje. Dotykem aplikace ho pozastavíte, klepnutím na Zastavit ho ukončíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tippt und schreibt in dieser App, während du zusiehst, nur für diese Anfrage. Er bestätigt nie etwas. Berühre die App, um ihn zu pausieren, oder tippe auf „Stoppen“, um ihn zu beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach taps and types in this app while you watch, for this request only. It never confirms anything. Touch the app to pause it, or tap Stop to end it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach toca y escribe en esta app mientras miras, solo para esta solicitud. Nunca confirma nada. Toca la app para pausarlo o toca Detener para terminar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach puudutab ja kirjutab selles rakenduses, kuni sina vaatad, ainult selle päringu jaoks. See ei kinnita kunagi midagi. Pausile panemiseks puuduta rakendust, lõpetamiseks puuduta Lõpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach touche et écrit dans cette app sous vos yeux, pour cette demande uniquement. Il ne confirme jamais rien. Touchez l'app pour le mettre en pause, ou touchez Arrêter pour terminer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dodiruje i tipka u ovoj aplikaciji dok vi gledate, samo za ovaj zahtjev. Nikad ništa ne potvrđuje. Dodirnite aplikaciju da je pauzirate ili dodirnite Zaustavite da završite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Coach koppint és gépel ebben az alkalmazásban, miközben nézed, csak ehhez a kéréshez. Soha semmit nem erősít meg. Érintsd meg az alkalmazást a szüneteltetéshez, vagy koppints a Leállítás gombra a befejezéshez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-ը հպում և մուտքագրում է այս հավելվածում, մինչ դուք դիտում եք, միայն այս հարցման համար։ Այն երբեք ոչինչ չի հաստատում։ Հպեք հավելվածին՝ դադարեցնելու համար, կամ հպեք «Կանգնեցնել»՝ ավարտելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach mengetuk dan mengetik di aplikasi ini saat Anda menonton, hanya untuk permintaan ini. Ia tidak pernah mengonfirmasi apa pun. Sentuh aplikasi untuk menjedanya, atau ketuk Hentikan untuk mengakhirinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tocca e scrive in questa app mentre guardi, solo per questa richiesta. Non conferma mai nulla. Tocca l'app per metterlo in pausa o tocca Ferma per terminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストに限り、あなたが見ている間にCoachがこのアプリでタップと入力を行います。何かを確定することはありません。一時停止するにはアプリに触れ、終了するには「停止」をタップしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach ეხება და წერს ამ აპში, სანამ თქვენ უყურებთ, მხოლოდ ამ მოთხოვნისთვის. ის არასოდეს ადასტურებს არაფერს. შეეხეთ აპს შესაჩერებლად ან შეეხეთ „გაჩერებას“ დასასრულებლად."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach는 이 요청에 한해, 내가 지켜보는 동안 이 앱에서 탭하고 입력합니다. 무엇도 확정하지 않습니다. 일시 중지하려면 앱을 터치하고, 끝내려면 중지를 탭하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach liečia ir rašo šioje programėlėje, kol jūs stebite, tik šiai užklausai. Jis niekada nieko netvirtina. Palieskite programėlę, kad jį pristabdytumėte, arba palieskite „Nutraukti Coach“, kad baigtumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach pieskaras un raksta šajā lietotnē, kamēr tu skaties, tikai šim pieprasījumam. Tas nekad neko neapstiprina. Pieskaries lietotnei, lai to iepauzētu, vai pieskaries “Pārtraukt”, lai to beigtu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tikt en typt in deze app terwijl je kijkt, alleen voor dit verzoek. Het bevestigt nooit iets. Raak de app aan om het te pauzeren, of tik op Stoppen om het te beëindigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dotyka i pisze w tej aplikacji, gdy patrzysz, tylko dla tej prośby. Nigdy niczego nie potwierdza. Dotknij aplikacji, aby go wstrzymać, lub Zatrzymaj, aby zakończyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach toca e escreve nesta app enquanto observa, apenas para este pedido. Nunca confirma nada. Toque na app para o pausar ou em Parar para terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coach toca e escreve neste app enquanto você observa, apenas para este pedido. Nunca confirma nada. Toque no app para pausar ou em Parar para terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach atinge și tastează în această aplicație în timp ce priviți, doar pentru această solicitare. Nu confirmă niciodată nimic. Atingeți aplicația pentru a-l întrerupe sau atingeți Opriți pentru a încheia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach v tejto aplikácii ťuká a píše, kým sa pozeráte, len pre túto žiadosť. Nikdy nič nepotvrdzuje. Dotykom aplikácie ho pozastavíte, ťuknutím na Zastaviť ho ukončíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach v tej aplikaciji tapka in tipka, medtem ko gledate, samo za to zahtevo. Nikoli ničesar ne potrdi. Dotaknite se aplikacije, da ga začasno ustavite, ali tapnite Ustavi, da ga končate."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach prek dhe shkruan në këtë aplikacion ndërsa shikoni, vetëm për këtë kërkesë. Nuk konfirmon kurrë asgjë. Prekni aplikacionin për ta ndërprerë, ose prekni Ndaloni për ta mbyllur."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach dodiruje i tipka u ovoj aplikaciji dok vi gledate, samo za ovaj zahtev. Nikad ništa ne potvrđuje. Dodirnite aplikaciju da je pauzirate ili dodirnite Zaustavite da završite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach แตะและพิมพ์ในแอปนี้ขณะที่คุณดูอยู่ เฉพาะสำหรับคำขอนี้ มันไม่ยืนยันอะไรเลย แตะที่แอปเพื่อหยุดชั่วคราว หรือแตะหยุดเพื่อสิ้นสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach, siz izlerken bu uygulamada dokunur ve yazar; yalnızca bu istek için. Hiçbir şeyi onaylamaz. Duraklatmak için uygulamaya dokunun veya bitirmek için Durdur'a dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach chạm và gõ trong ứng dụng này khi bạn theo dõi, chỉ cho yêu cầu này. Nó không bao giờ xác nhận gì cả. Hãy chạm vào ứng dụng để tạm dừng, hoặc chạm Dừng để kết thúc."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您在一旁觀看時，Coach 會在這個 App 中輕點和輸入，僅限這次請求。它絕不會確認任何事項。觸碰 App 即可暫停，或輕點「停止」結束。"
          }
        }
      }
    },
    "drive.card_note_scrolls_pauses": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach siz izləyərkən bu tətbiqdə toxunur, yazır və sürüşdürür. O, heç nəyi təsdiqləmir. Dayandırmaq üçün tətbiqə toxunun və ya bitirmək üçün «Dayandırın» düyməsinə basın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach докосва, пише и превърта в това приложение, докато гледате. Никога не потвърждава нищо. Докоснете приложението, за да го спрете на пауза, или докоснете „Спиране“, за да приключите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach v této aplikaci klepe, píše a posouvá, zatímco se díváte. Nikdy nic nepotvrzuje. Dotykem aplikace ho pozastavíte, klepnutím na Zastavit ho ukončíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach tippt, schreibt und scrollt in dieser App, während du zusiehst. Er bestätigt nie etwas. Berühre die App, um ihn zu pausieren, oder tippe auf „Stoppen“, um ihn zu beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach taps, types and scrolls in this app while you watch. It never confirms anything. Touch the app to pause it, or tap Stop to end it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach toca, escribe y se desplaza en esta app mientras miras. Nunca confirma nada. Toca la app para pausarlo o toca Detener para terminar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach puudutab, kirjutab ja kerib selles rakenduses, kuni sina vaatad. See ei kinnita kunagi midagi. Pausile panemiseks puuduta rakendust, lõpetamiseks puuduta Lõpeta."
