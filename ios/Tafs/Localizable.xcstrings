    "door.pair_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسائلهم إلى هذا الباب (%1$@) تعطي عملًا، ضمن الـ Card. أما رسائل غيرهم فتطرق الباب فقط."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onların bu %1$@ qapısına mesajları Card daxilində iş verir. Başqalarınınkı yalnız döyür."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съобщенията им до вратата %1$@ дават работа, в рамките на Card. Тези на всеки друг само чукат."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই %1$@ দরজায় তাদের বার্তা Card-এর মধ্যে কাজ দেয়। অন্য যে কারও বার্তা শুধু কড়া নাড়ে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els seus missatges a aquesta porta de %1$@ donen feina, dins del Card. Els de qualsevol altra persona només truquen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejich zprávy na tyto dveře %1$@ dávají práci, v rámci Card. Zprávy kohokoli jiného jen klepou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Nachrichten an diese %1$@-Tür geben Arbeit, innerhalb der Card. Alle anderen klopfen nur an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their messages to this %1$@ door give work, within the Card. Anyone else's only knock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus mensajes a esta puerta de %1$@ dan trabajo, dentro de la Card. Los de cualquier otra persona solo llegan como llamada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nende sõnumid sellele uksele (%1$@) annavad tööd, Cardi piires. Kõigi teiste omad ainult koputavad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses messages à cette porte %1$@ donnent du travail, dans la Card. Ceux de toute autre personne ne sont que des demandes d'accès."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההודעות שלהם לדלת %1$@ הזו נותנות עבודה, בתוך ה-Card. של כל אחד אחר רק דופקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस %1$@ द्वार पर उनके संदेश Card के भीतर काम देते हैं। किसी और के केवल दस्तक देते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njihove poruke na vratima %1$@ daju posao, unutar Carda. Poruke svih ostalih samo kucaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az erre a(z) %1$@ ajtóra küldött üzeneteik munkát adnak, a Cardon belül. Bárki másé csak kopog."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրանց հաղորդագրությունները այս դռանը (%1$@) աշխատանք են տալիս, Card-ի շրջանակներում։ Ցանկացած ուրիշինը միայն թակում է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan mereka ke pintu %1$@ ini memberi pekerjaan, dalam Card. Pesan orang lain hanya mengetuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi messaggi a questa porta %1$@ danno lavoro, entro la Card. Quelli di chiunque altro sono solo bussate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%1$@窓口へのその人のメッセージは、Cardの範囲内で仕事になります。それ以外の人のものはノックになるだけです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მათი შეტყობინებები ამ კარზე (%1$@) სამუშაოს აძლევს, Card-ის ფარგლებში. სხვა ნებისმიერისა მხოლოდ აკაკუნებს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សាររបស់ពួកគេទៅទ្វារ %1$@ នេះផ្តល់ការងារ ក្នុង Card។ សាររបស់អ្នកផ្សេងទៀតគ្រាន់តែគោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람이 이 %1$@ 창구로 보낸 메시지는 Card 안에서 작업을 맡깁니다. 다른 사람의 메시지는 노크만 합니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຂໍ້ຄວາມຂອງເຂົາເຈົ້າຫາປະຕູ %1$@ ນີ້ມອບວຽກ, ພາຍໃນ Card. ຂອງຄົນອື່ນພຽງແຕ່ເຄາະ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jų žinutės į šias %1$@ duris suteikia darbą, Card ribose. Visų kitų žinutės tik beldžiasi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viņu ziņas uz šīm durvīm (%1$@) dod darbu Card ietvaros. Visu citu ziņas tikai klauvē."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нивните пораки до овие врата %1$@ даваат работа, во рамки на Card. Пораките од секој друг само тропаат."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэдний энэ %1$@ хаалга руу илгээсэн мессеж Card-ын хүрээнд ажил өгнө. Бусдын мессеж зөвхөн тогшино."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "उनीहरूले यो %1$@ ढोकामा पठाएका सन्देशले Card भित्र काम दिन्छन्। अरू जोसुकैका ढकढक मात्र हुन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hun berichten aan deze %1$@-deur geven werk, binnen de Card. Berichten van anderen kloppen alleen aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich wiadomości do tych drzwi %1$@ zlecają pracę, w ramach Card. Wiadomości od innych to tylko pukanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens desta pessoa para esta porta de %1$@ dão trabalho, dentro do Card. As de qualquer outra pessoa ficam só como pedido de contacto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens desta pessoa para esta porta de %1$@ dão trabalho, dentro do Card. As de qualquer outra pessoa ficam só como pedido de contato."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajele lor către ușa %1$@ dau de lucru, în limitele Cardului. Ale oricui altcuiva doar bat la ușă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich správy na tieto dvere %1$@ dávajú prácu, v rámci Card. Správy kohokoľvek iného len klopú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Njihova sporočila na ta vrata %1$@ dajejo delo, znotraj Card. Sporočila vseh drugih samo potrkajo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesazhet e tyre te kjo portë (%1$@) japin punë, brenda Card-it. Ato të çdo tjetri vetëm trokasin."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Njihove poruke na vratima %1$@ daju posao, unutar Carda. Poruke svih ostalih samo kucaju."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความของพวกเขาถึงประตู %1$@ นี้ มอบงาน ภายใน Card ข้อความของคนอื่นเป็นเพียงการเคาะ"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Olaryň bu %1$@ gapysyna iberen habarlary Card-yň çäginde iş berýär. Başga adamlaryňky diňe kakýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %1$@ kapısına gönderdikleri mesajlar, Card içinde iş verir. Başkalarınınki yalnızca kapıyı çalar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان کے اس %1$@ دروازے پر پیغامات کام دیتے ہیں، Card کے اندر رہ کر۔ کسی اور کے صرف دستک دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn của họ tới cửa %1$@ này giao việc, trong phạm vi Card. Tin của người khác chỉ là gõ cửa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他們傳到這扇%1$@門的訊息會在 Card 範圍內交付工作。其他人的訊息只是敲門。"
          }
        }
      }
    },
