    "settings.devices.passkey_not_registered": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنشئ مفتاح المرور على هذا الهاتف لكنه لم يُضف إلى حسابك. يمكنك إزالته من كلمات المرور ومفاتيح المرور المحفوظة في هذا الهاتف."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş açarı bu telefonda yaradıldı, amma hesabınıza əlavə edilmədi. Onu bu telefonun saxlanmış parollar və giriş açarları bölməsindən silə bilərsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключът за достъп беше създаден на този телефон, но не беше добавен към акаунта ви. Можете да го премахнете от запазените пароли и ключове за достъп на телефона."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসকিটি এই ফোনে তৈরি হয়েছে কিন্তু আপনার অ্যাকাউন্টে যোগ হয়নি। আপনি এই ফোনের সংরক্ষিত পাসওয়ার্ড ও পাসকি থেকে এটি সরাতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La clau d'accés s'ha creat en aquest telèfon però no s'ha afegit al teu compte. La pots treure de les contrasenyes i claus d'accés desades d'aquest telèfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístupový klíč se v tomto telefonu vytvořil, ale nepřidal se k vašemu účtu. Můžete ho odstranit z uložených hesel a přístupových klíčů tohoto telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Passkey wurde auf diesem Telefon erstellt, aber nicht zu deinem Konto hinzugefügt. Du kannst ihn aus den gespeicherten Passwörtern und Passkeys dieses Telefons entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passkey was made on this phone but not added to your account. You can remove it from this phone's saved passwords and passkeys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llave de acceso se creó en este teléfono, pero no se añadió a tu cuenta. Puedes quitarla de las contraseñas y llaves de acceso guardadas en este teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pääsuvõti loodi selles telefonis, kuid seda ei lisatud sinu kontole. Võid selle eemaldada selle telefoni salvestatud paroolide ja pääsuvõtmete hulgast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé d'accès a été créée sur ce téléphone, mais pas ajoutée à votre compte. Vous pouvez la supprimer des mots de passe et clés d'accès enregistrés sur ce téléphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח הגישה נוצר בטלפון הזה אבל לא נוסף לחשבון שלך. אפשר להסיר אותו מהסיסמאות ומפתחות הגישה השמורים בטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "passkey इस फ़ोन पर बनी पर आपके खाते में नहीं जुड़ी। आप उसे इस फ़ोन के सहेजे पासवर्ड और passkey से हटा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristupni je ključ izrađen na ovom telefonu, ali nije dodan vašem računu. Možete ga ukloniti iz spremljenih lozinki i pristupnih ključeva ovog telefona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelkulcs létrejött ezen a telefonon, de nem lett hozzáadva a fiókodhoz. Eltávolíthatod a telefon mentett jelszavai és jelkulcsai közül."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքի բանալին ստեղծվեց այս հեռախոսում, բայց ձեր հաշվին չավելացվեց։ Կարող եք այն հեռացնել այս հեռախոսի պահպանված գաղտնաբառերից և մուտքի բանալիներից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci sandi dibuat di ponsel ini tetapi tidak ditambahkan ke akun Anda. Anda dapat menghapusnya dari kata sandi dan kunci sandi tersimpan di ponsel ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La passkey è stata creata su questo telefono, ma non è stata aggiunta al tuo account. Puoi rimuoverla dalle password e passkey salvate su questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスキーはこのスマートフォンで作成されましたが、アカウントには追加されませんでした。このスマートフォンの保存済みパスワードとパスキーから削除できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პასკი შეიქმნა ამ ტელეფონზე, მაგრამ თქვენს ანგარიშს არ დაემატა. შეგიძლიათ ამოიღოთ ის ამ ტელეფონის შენახული პაროლებიდან და პასკებიდან."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "passkey ត្រូវបានបង្កើតនៅលើទូរសព្ទនេះ ប៉ុន្តែមិនត្រូវបានបន្ថែមទៅគណនីរបស់អ្នកទេ។ អ្នកអាចដកវាចេញពីពាក្យសម្ងាត់ និង passkey ដែលបានរក្សាទុកនៃទូរសព្ទនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에서 패스키를 만들었지만 계정에 추가되지 않았습니다. 이 휴대폰의 저장된 암호 및 패스키에서 삭제할 수 있습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "passkey ຖືກສ້າງໃນໂທລະສັບນີ້ ແຕ່ບໍ່ໄດ້ເພີ່ມໃນບັນຊີຂອງທ່ານ. ທ່ານລຶບມັນໄດ້ຈາກລະຫັດຜ່ານ ແລະ passkey ທີ່ບັນທຶກໄວ້ຂອງໂທລະສັບນີ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieigos raktas sukurtas šiame telefone, bet nepridėtas prie jūsų paskyros. Galite jį pašalinti iš šio telefono išsaugotų slaptažodžių ir prieigos raktų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piekļuves atslēga tika izveidota šajā tālrunī, bet netika pievienota tavam kontam. Tu vari to noņemt no šī tālruņa saglabātajām parolēm un piekļuves atslēgām."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клучот за пристап е направен на овој телефон, но не е додаден на твојата сметка. Можеш да го отстраниш од зачуваните лозинки и клучеви за пристап на овој телефон."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэвтрэх түлхүүр энэ утсан дээр үүссэн боловч таны бүртгэлд нэмэгдээгүй. Та үүнийг энэ утасны хадгалсан нууц үг болон нэвтрэх түлхүүрүүдээс устгаж болно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पासकी यो फोनमा बनाइयो तर तपाईंको खातामा थपिएन। तपाईं यसलाई यो फोनका सुरक्षित पासवर्ड र पासकीहरूबाट हटाउन सक्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De passkey is op deze telefoon gemaakt, maar niet aan je account toegevoegd. Je kunt hem verwijderen uit de opgeslagen wachtwoorden en passkeys van deze telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz dostępu został utworzony na tym telefonie, ale nie dodano go do konta. Możesz usunąć go z haseł i kluczy dostępu zapisanych na tym telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de acesso foi criada neste telefone, mas não foi adicionada à sua conta. Pode removê-la das palavras-passe e chaves de acesso guardadas neste telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de acesso foi criada neste telefone, mas não foi adicionada à sua conta. Pode removê-la das senhas e chaves de acesso guardadas neste telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia de acces a fost creată pe acest telefon, dar nu a fost adăugată la cont. O puteți elimina din parolele și cheile de acces salvate ale telefonului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prístupový kľúč sa v tomto telefóne vytvoril, ale nepridal sa k vášmu účtu. Môžete ho odstrániť z uložených hesiel a prístupových kľúčov tohto telefónu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ za dostop je bil ustvarjen v tem telefonu, a ni bil dodan v vaš račun. Odstranite ga lahko iz shranjenih gesel in ključev za dostop tega telefona."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çelësi i kalimit u krijua në këtë telefon por nuk u shtua në llogarinë tuaj. Mund ta hiqni nga fjalëkalimet dhe çelësat e kalimit të ruajtur të këtij telefoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristupni je ključ izrađen na ovom telefonu, ali nije dodan vašem nalogu. Možete ga ukloniti iz sačuvanih lozinki i pristupnih ključeva ovog telefona."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างพาสคีย์บนโทรศัพท์เครื่องนี้แล้ว แต่ยังไม่ได้เพิ่มในบัญชีของคุณ คุณลบมันได้จากรหัสผ่านและพาสคีย์ที่บันทึกไว้ของโทรศัพท์เครื่องนี้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey bu telefonda döredildi, ýöne hasabyňyza goşulmady. Ony bu telefonyň saklanan parollarynda we passkey-lerinde aýryp bilersiňiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçiş anahtarı bu telefonda oluşturuldu ama hesabınıza eklenmedi. Bu telefonun kayıtlı parolalarından ve geçiş anahtarlarından kaldırabilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پاس کی اس فون پر بنی مگر آپ کے اکاؤنٹ میں شامل نہیں ہوئی۔ آپ اسے اس فون کے محفوظ پاس ورڈز اور پاس کیز سے ہٹا سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa truy cập đã được tạo trên điện thoại này nhưng chưa được thêm vào tài khoản của bạn. Bạn có thể gỡ nó khỏi mật khẩu và khóa truy cập đã lưu của điện thoại này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼金鑰已在這部手機上建立，但未新增到您的帳號。您可以從這部手機已儲存的密碼和密碼金鑰中移除它。"
          }
        }
      }
    },
    "settings.devices.passkey_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع مفتاح مرور على هذا الهاتف، يستطيع كمبيوتر الموافقة من خلاله: يعرض الكمبيوتر رمز QR وتمسحه أنت بهذا الهاتف."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefondakı giriş açarı ilə kompüter onun vasitəsilə təsdiq edə bilər: kompüter QR kod göstərir, siz isə onu bu telefonla skan edirsiniz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "С ключ за достъп на този телефон компютър може да одобрява чрез него: компютърът показва QR код, а вие го сканирате с този телефон."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনে একটি পাসকি থাকলে একটি কম্পিউটার এর মাধ্যমে অনুমোদন করতে পারে: কম্পিউটার একটি QR কোড দেখায়, আর আপনি এই ফোন দিয়ে তা স্ক্যান করেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb una clau d'accés en aquest telèfon, un ordinador pot aprovar a través seu: l'ordinador mostra un codi QR i tu l'escanejes amb aquest telèfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S přístupovým klíčem v tomto telefonu může přes něj schvalovat i počítač: počítač ukáže QR kód a vy ho naskenujete tímto telefonem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Passkey auf diesem Telefon kann ein Computer darüber genehmigen: Der Computer zeigt einen QR-Code, und du scannst ihn mit diesem Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a passkey on this phone, a computer can approve through it: the computer shows a QR code, and you scan it with this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una llave de acceso en este teléfono, un ordenador puede aprobar a través de él: el ordenador muestra un código QR y tú lo escaneas con este teléfono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui selles telefonis on pääsuvõti, saab arvuti selle kaudu kinnitada: arvuti näitab QR-koodi ja sina skannid selle selle telefoniga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec une clé d'accès sur ce téléphone, un ordinateur peut approuver par son biais : l'ordinateur affiche un code QR, et vous le scannez avec ce téléphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עם מפתח גישה בטלפון הזה, מחשב יכול לאשר דרכו: המחשב מציג קוד QR, ואתה סורק אותו עם הטלפון הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन की passkey के साथ, कंप्यूटर उसके ज़रिए मंज़ूर कर सकता है: कंप्यूटर QR कोड दिखाता है, और आप उसे इस फ़ोन से स्कैन करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "S pristupnim ključem na ovom telefonu računalo može odobravati preko njega: računalo prikazuje QR kôd, a vi ga skenirate ovim telefonom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ezen a telefonon van jelkulcs, egy számítógép rajta keresztül jóváhagyhat: a számítógép QR-kódot mutat, te pedig beolvasod ezzel a telefonnal."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հեռախոսում մուտքի բանալիով համակարգիչը կարող է հաստատել դրա միջոցով․ համակարգիչը ցույց է տալիս QR կոդ, և դուք սկանավորում եք այն այս հեռախոսով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan kunci sandi di ponsel ini, sebuah komputer dapat menyetujui lewatnya: komputer menampilkan kode QR, dan Anda memindainya dengan ponsel ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una passkey su questo telefono, un computer può approvare tramite esso: il computer mostra un codice QR e tu lo scansioni con questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンにパスキーがあれば、コンピュータはそれを通じて承認できます。コンピュータにQRコードが表示されたら、このスマートフォンでスキャンしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პასკით ამ ტელეფონზე კომპიუტერს მისი საშუალებით შეუძლია დამტკიცება: კომპიუტერი აჩვენებს QR კოდს და თქვენ ამ ტელეფონით ასკანერებთ."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជាមួយ passkey នៅលើទូរសព្ទនេះ កុំព្យូទ័រអាចអនុម័តតាមរយៈវា៖ កុំព្យូទ័របង្ហាញកូដ QR ហើយអ្នកស្កែនវាដោយទូរសព្ទនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에 패스키가 있으면 컴퓨터가 이를 통해 승인할 수 있습니다. 컴퓨터에 QR 코드가 표시되면 이 휴대폰으로 스캔하세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດ້ວຍ passkey ໃນໂທລະສັບນີ້ ຄອມພິວເຕີອະນຸມັດຜ່ານມັນໄດ້: ຄອມພິວເຕີສະແດງ QR code ແລ້ວທ່ານສະແກນມັນດ້ວຍໂທລະສັບນີ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Turint prieigos raktą šiame telefone, kompiuteris gali tvirtinti per jį: kompiuteris rodo QR kodą, o jūs jį nuskaitote šiuo telefonu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja šajā tālrunī ir piekļuves atslēga, dators var apstiprināt caur to: dators parāda QR kodu, un tu to skenē ar šo tālruni."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Со клуч за пристап на овој телефон, компјутер може да одобрува преку него: компјутерот прикажува QR код, а ти го скенираш со овој телефон."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ утсан дээр нэвтрэх түлхүүр байвал компьютер түүгээр дамжуулан зөвшөөрч чадна: компьютер QR код харуулж, та энэ утсаараа скан хийнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो फोनमा पासकी भए कम्प्युटरले यसमार्फत स्वीकृत गर्न सक्छ: कम्प्युटरले QR कोड देखाउँछ, र तपाईं यो फोनले स्क्यान गर्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een passkey op deze telefoon kan een computer via deze telefoon goedkeuren: de computer toont een QR-code en jij scant die met deze telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z kluczem dostępu na tym telefonie komputer może zatwierdzać przez niego: komputer pokazuje kod QR, a Ty skanujesz go tym telefonem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma chave de acesso neste telefone, um computador pode aprovar através dele: o computador mostra um código QR, que lê com este telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma chave de acesso neste telefone, um computador pode aprovar através dele: o computador mostra um código QR, que lê com este telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu o cheie de acces pe acest telefon, un computer poate aproba prin el: computerul afișează un cod QR, iar dvs. îl scanați cu acest telefon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "S prístupovým kľúčom v tomto telefóne cez neho môže schvaľovať aj počítač: počítač ukáže QR kód a vy ho naskenujete týmto telefónom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S ključem za dostop v tem telefonu lahko računalnik odobrava prek njega: računalnik prikaže kodo QR, vi pa jo skenirate s tem telefonom."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Me një çelës kalimi në këtë telefon, një kompjuter mund të miratojë përmes tij: kompjuteri shfaq një kod QR, dhe ju e skanoni me këtë telefon."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "S pristupnim ključem na ovom telefonu računar može odobravati preko njega: računar prikazuje QR kôd, a vi ga skenirate ovim telefonom."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีพาสคีย์บนโทรศัพท์เครื่องนี้ คอมพิวเตอร์สามารถอนุมัติผ่านมันได้: คอมพิวเตอร์แสดงคิวอาร์โค้ด และคุณสแกนด้วยโทรศัพท์เครื่องนี้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefondaky passkey bilen kompýuter onuň arkaly tassyklap biler: kompýuter QR kod görkezýär, siz ony bu telefon bilen skanirleýärsiňiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefondaki bir geçiş anahtarıyla bir bilgisayar onayı onun üzerinden verebilir: bilgisayar bir QR kodu gösterir, siz bu telefonla taratırsınız."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فون پر پاس کی کے ساتھ، کمپیوٹر اس کے ذریعے منظور کر سکتا ہے: کمپیوٹر QR کوڈ دکھاتا ہے، اور آپ اسے اس فون سے اسکین کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với khóa truy cập trên điện thoại này, một máy tính có thể phê duyệt qua nó: máy tính hiển thị mã QR và bạn quét bằng điện thoại này."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機上有密碼金鑰後，電腦就可以透過它核准：電腦顯示 QR 碼，而您用這部手機掃描。"
          }
        }
      }
    },
