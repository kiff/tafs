    "files.delete_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحذف من «الملفات» لكل من في هذا الحساب، فورًا. لا يمكن التراجع عن ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "O, bu hesabdakı hər kəs üçün dərhal Fayllardan silinir. Bunu geri qaytarmaq olmaz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изчезва от Файлове за всички в този акаунт веднага. Това не може да бъде отменено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি এই অ্যাকাউন্টের সবার জন্য এখনই ফাইল থেকে চলে যায়। এটি ফেরানো যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desapareix de Fitxers per a tothom en aquest compte, a l'instant. Això no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmizí ze Souborů pro všechny v tomto účtu, hned. Nelze to vrátit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verschwindet sofort für alle in diesem Konto aus Dateien. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It goes from Files for everyone on this account, right away. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina de Archivos para todo el mundo en esta cuenta, ya. No se puede deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See kaob kohe kõigi selle konto inimeste jaoks failidest. Seda ei saa tagasi võtta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disparaît de Fichiers pour tout le monde sur ce compte, tout de suite. C'est définitif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא נמחק מהקבצים לכל מי שנמצא בחשבון הזה, מיד. אי אפשר לבטל את זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस खाते के सभी लोगों के लिए फ़ाइलें से तुरंत चली जाती है। इसे पलटा नहीं जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nestaje iz Datoteka za sve na ovom računu, odmah. Ovo se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonnal eltűnik a Fájlokból a fiók minden tagja számára. Ez nem vonható vissza."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն անմիջապես հեռացվում է Ֆայլերից այս հաշվի բոլորի համար։ Սա հնարավոր չէ հետ շրջել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File akan hilang dari Berkas untuk semua orang di akun ini, segera. Tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparisce subito da File per tutti in questo account. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの全員のファイルからすぐに削除されます。元に戻すことはできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ის ფაილებიდან იშლება ამ ანგარიშის ყველასთვის, დაუყოვნებლივ. ამის გაუქმება შეუძლებელია."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាត្រូវបានលុបចេញពីឯកសារសម្រាប់អ្នកគ្រប់គ្នាលើគណនីនេះ ភ្លាមៗ។ មិនអាចត្រឡប់វិញបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 모든 사람에게서 즉시 파일이 사라집니다. 되돌릴 수 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມັນຈະຫາຍໄປຈາກໄຟລ໌ສຳລັບທຸກຄົນໃນບັນຊີນີ້ ທັນທີ. ບໍ່ສາມາດຍົກເລີກໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jis iš karto dings iš skilties „Failai“ visiems šios paskyros nariams. To negalima atšaukti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas nekavējoties pazūd no sadaļas “Faili” visiem šajā kontā. To vairs nevarēs atjaunot."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Исчезнува од Датотеки за сите на оваа сметка, веднаш. Ова не може да се врати."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ бүртгэлийн бүх хүнд зориулсан Файлуудаас шууд устна. Үүнийг буцаах боломжгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो यस खाताका सबैका लागि फाइलहरूबाट तुरुन्तै हट्छ। यो फिर्ता गर्न सकिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verdwijnt meteen uit Bestanden voor iedereen in dit account. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znika z Plików od razu dla wszystkich na tym koncie. Tego nie da się cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desaparece de Ficheiros para toda a gente nesta conta, de imediato. Não pode ser desfeito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desaparece de Arquivos para todos nesta conta, de imediato. Não pode ser desfeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispare din Fișiere pentru toată lumea din acest cont, imediat. Acțiunea nu poate fi anulată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmizne zo Súborov pre všetkých v tomto účte, hneď. Nedá sa to vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Takoj izgine iz Datotek za vse v tem računu. Tega ni mogoče razveljaviti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiqet nga Skedarët për këdo në këtë llogari, menjëherë. Kjo nuk mund të zhbëhet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nestaje iz Datoteka za sve na ovom nalogu, odmah. Ovo se ne može poništiti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันจะหายไปจากไฟล์สำหรับทุกคนในบัญชีนี้ทันที ไม่สามารถย้อนกลับได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ol bu hasapdaky hemmeler üçin Faýllardan derrew aýrylýar. Muny yzyna gaýtaryp bolmaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesaptaki herkes için hemen Dosyalar'dan kaldırılır. Geri alınamaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اس اکاؤنٹ کے ہر فرد کے لیے فائلز سے فوراً ہٹ جاتی ہے۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó biến mất khỏi Tệp với mọi người trong tài khoản này, ngay lập tức. Không thể hoàn tác."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會立即從此帳號所有人的「檔案」中消失。此操作無法復原。"
          }
        }
      }
    },
