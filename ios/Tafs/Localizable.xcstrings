    "sample.hello": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, ich bin %1$@. Ich bin dran: %2$@. Frag mich, was ich getan habe, oder sag mir, was ich anders machen soll. Ich bleibe so oder so innerhalb meiner Card."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I'm %1$@. I'm on it: %2$@. Ask me what I did, or tell me what to do differently. I stay inside my Card either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola, soy %1$@. Estoy en ello: %2$@. Pregúntame qué hice, o dime qué hacer de otra forma. En cualquier caso, me mantengo dentro de mi Card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour, je suis %1$@. Je m'en occupe : %2$@. Demandez-moi ce que j'ai fait, ou dites-moi quoi faire autrement. Je reste dans ma Card dans tous les cas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao, sono %1$@. Ci sto lavorando: %2$@. Chiedimi cosa ho fatto, o dimmi cosa fare diversamente. In ogni caso resto entro la mia Card."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoi, ik ben %1$@. Ik ben ermee bezig: %2$@. Vraag me wat ik heb gedaan, of zeg wat ik anders moet doen. Ik blijf hoe dan ook binnen mijn Card."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cześć, jestem %1$@. Zajmuję się tym: %2$@. Zapytaj mnie, co zrobiłem, albo powiedz, co mam robić inaczej. Tak czy inaczej działam w ramach swojej Card."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá, sou %1$@. Estou a tratar disto: %2$@. Pergunte-me o que fiz, ou diga-me o que fazer de outra forma. Fico sempre dentro do meu Card."
          }
        }
      }
    },
