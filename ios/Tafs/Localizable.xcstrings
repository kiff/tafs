    "watch.paused_still_answers": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasilədədir: cədvəli söndürülüb. O, hələ də göndərdiklərinizə cavab verir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На пауза: графикът му е изключен. Все пак отговаря на това, което изпращате."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastaveno: jeho plán je vypnutý. Na to, co pošlete, pořád odpovídá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert: Sein Zeitplan ist aus. Was du sendest, beantwortet er trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused: its schedule is off. It still answers what you send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa: su programación está detenida. Aun así responde a lo que envías."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausil: selle ajakava on väljas. See vastab ikka sellele, mida saadad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause : son planning est arrêté. Il répond quand même à ce que vous envoyez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzirano: njegov je raspored isključen. I dalje odgovara na ono što pošaljete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szüneteltetve: az ütemezése ki van kapcsolva. Arra, amit küldesz, továbbra is válaszol."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դադարեցված է․ նրա ժամանակացույցը անջատված է։ Այն դեռ պատասխանում է նրան, ինչ ուղարկում եք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda: jadwalnya mati. Ia tetap menjawab apa yang Anda kirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa: la sua pianificazione è ferma. Risponde comunque a ciò che invii."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中：スケジュールはオフです。送ったメッセージには引き続き答えます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაპაუზებულია: მისი განრიგი გამორთულია. ის მაინც პასუხობს, რასაც გაუგზავნით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 중지됨: 일정이 꺼져 있습니다. 보내는 메시지에는 계속 답합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristabdyta: tvarkaraštis išjungtas. Jis vis tiek atsako į tai, ką siunčiate."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iepauzēts: tā grafiks ir izslēgts. Tas joprojām atbild uz to, ko tu sūti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd: de planning staat stil. Het antwoordt nog steeds op wat je stuurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane: harmonogram jest wyłączony. Taf nadal odpowiada na to, co wysyłasz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa: o agendamento está parado. Ainda assim responde ao que envia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa: o agendamento está parado. Ainda assim responde ao que envia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întrerupt: programul său este dezactivat. Totuși răspunde la ce îi trimiteți."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastavené: jeho plán je vypnutý. Na to, čo pošlete, stále odpovedá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začasno ustavljeno: njegov urnik je izklopljen. Še vedno odgovarja na to, kar pošljete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pezulluar: orari i tij është joaktiv. Ende u përgjigjet atyre që dërgoni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzirano: njegov je raspored isključen. I dalje odgovara na ono šta pošaljete."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดชั่วคราว: กำหนดการของมันปิดอยู่ มันยังตอบสิ่งที่คุณส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
