    "alert.kiff_did_not_take_refusal": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF imtinanı qəbul etmədi. Cavab vermək üçün tafs-ı açın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF не прие отказа. Отворете tafs, за да отговорите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF odmítnutí nepřijal. Otevřete tafs a odpovězte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF hat die Ablehnung nicht angenommen. Öffne tafs, um zu antworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF didn't take the refusal. Open tafs to answer it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF no aceptó el rechazo. Abre tafs para responder."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei võtnud keeldumist vastu. Vastamiseks ava tafs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'a pas pris en compte le refus. Ouvrez tafs pour y répondre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nije prihvatio odbijanje. Otvorite tafs da odgovorite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF nem fogadta el az elutasítást. Nyisd meg a tafst a válaszhoz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը մերժումը չընդունեց։ Բացեք tafs-ը՝ պատասխանելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF tidak menerima penolakan. Buka tafs untuk menjawabnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non ha accettato il rifiuto. Apri tafs per rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFが拒否を受け付けませんでした。tafsを開いて回答してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-მა უარი არ მიიღო. გახსენით tafs, რომ უპასუხოთ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF가 거절을 받지 않았습니다. tafs를 열어 응답하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nepriėmė atmetimo. Atidarykite tafs ir atsakykite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nepieņēma atteikumu. Atver tafs, lai atbildētu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF heeft de weigering niet aangenomen. Open tafs om te antwoorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nie przyjął odrzucenia. Otwórz tafs, aby odpowiedzieć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não aceitou a recusa. Abra o tafs para responder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KIFF não aceitou a recusa. Abra o tafs para responder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nu a acceptat refuzul. Deschideți tafs pentru a răspunde."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF odmietnutie neprijal. Otvorte tafs a odpovedzte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF zavrnitve ni sprejel. Odprite tafs in odgovorite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nuk e pranoi refuzimin. Hapni tafs për t'u përgjigjur."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF nije prihvatio odbijanje. Otvorite tafs da odgovorite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ไม่รับการปฏิเสธ เปิด tafs เพื่อตอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF reddi kabul etmedi. Yanıtlamak için tafs'ı açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF không nhận lời từ chối. Hãy mở tafs để trả lời."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF 未接受該拒絕。請開啟 tafs 回覆。"
          }
        }
      }
    },
    "alert.kiff_doesnt_send": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF bu hesab üçün tafs-a hələ bildiriş göndərmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF все още не изпраща известия към tafs в този акаунт."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF zatím v tomto účtu neposílá upozornění do tafs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF sendet in diesem Konto noch keine Benachrichtigungen an tafs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF doesn't send alerts to tafs yet on this account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF aún no envía alertas a tafs en esta cuenta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ei saada sellel kontol veel tafsile teavitusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF n'envoie pas encore d'alertes à tafs sur ce compte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF još ne šalje obavijesti u tafs na ovom računu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A KIFF ebben a fiókban még nem küld értesítéseket a tafsnek."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ը դեռ ծանուցումներ չի ուղարկում tafs-ին այս հաշվի համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF belum mengirim peringatan ke tafs di akun ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF non invia ancora avvisi a tafs per questo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントでは、KIFFはまだtafsに通知を送りません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF ჯერ არ აგზავნის შეტყობინებებს tafs-ში ამ ანგარიშისთვის."
          }
        },
        "ko": {
