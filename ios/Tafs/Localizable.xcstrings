        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirkstu nospiedumu sensoru pašlaik nevar izmantot. Pēc brīža mēģini vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сензорот за отисоци сега не може да се користи. Обиди се повторно за малку."
