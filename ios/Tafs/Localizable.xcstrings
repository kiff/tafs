    "home.sample_foot": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات تجريبية. يبدأ الـ taf الجديد في Coach."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nümunə məlumatlar. Yeni taf Coach-da başlayır."
          }
