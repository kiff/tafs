    "sign_in.pair_check": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "O, bu %1$@ cihazının %2$@ göstərib-göstərmədiyini soruşacaq."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
