    "approval.security_key.enter_pin": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمز PIN الخاص بمفتاح الأمان. يطلبه tafs في كل مرة ولا يخزنه أبدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təhlükəsizlik açarınızın PIN-ini daxil edin. tafs bunu hər dəfə istəyir və heç vaxt saxlamır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете ПИН кода на ключа за сигурност. tafs го иска всеки път и никога не го съхранява."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সিকিউরিটি কী-র PIN দিন। tafs প্রতিবার এটি চায় এবং কখনও সংরক্ষণ করে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el PIN de la teva clau de seguretat. tafs el demana cada cop i mai no el desa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte PIN bezpečnostního klíče. tafs se na něj zeptá pokaždé a nikdy ho neukládá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die PIN deines Sicherheitsschlüssels ein. tafs fragt jedes Mal danach und speichert sie nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your security key's PIN. tafs asks for it each time and never stores it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el PIN de tu llave de seguridad. tafs lo pide cada vez y nunca lo guarda."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta oma turvavõtme PIN-kood. tafs küsib seda iga kord ega salvesta seda kunagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code PIN de votre clé de sécurité. tafs le demande à chaque fois et ne l'enregistre jamais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להזין את ה-PIN של מפתח האבטחה. tafs מבקש אותו בכל פעם ולעולם לא שומר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सुरक्षा कुंजी का PIN दर्ज करें। tafs हर बार उसे माँगता है और कभी सहेजता नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite PIN svojeg sigurnosnog ključa. tafs ga traži svaki put i nikad ga ne sprema."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a biztonsági kulcsod PIN-kódját. A tafs minden alkalommal kéri, és soha nem tárolja."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքագրեք ձեր անվտանգության բանալու PIN-ը։ tafs-ը այն խնդրում է ամեն անգամ և երբեք չի պահում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan PIN kunci keamanan Anda. tafs memintanya setiap kali dan tidak pernah menyimpannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il PIN della tua chiave di sicurezza. tafs lo chiede ogni volta e non lo salva mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティキーのPINを入力してください。tafsは毎回PINを求め、保存することはありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეიყვანეთ თქვენი უსაფრთხოების გასაღების PIN. tafs მას ყოველ ჯერზე ითხოვს და არასოდეს ინახავს."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ចូល PIN នៃសោសុវត្ថិភាពរបស់អ្នក។ tafs សុំវារាល់ពេល ហើយមិនដែលរក្សាទុកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 키의 PIN을 입력하세요. tafs는 매번 PIN을 묻고 저장하지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃສ່ PIN ຂອງກຸນແຈຄວາມປອດໄພຂອງທ່ານ. tafs ຖາມທຸກຄັ້ງ ແລະ ບໍ່ເກັບມັນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite saugos rakto PIN. tafs jo prašo kaskart ir niekada jo nesaugo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadi savas drošības atslēgas PIN. tafs to prasa katru reizi un nekad neglabā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Внеси го PIN на твојот безбедносен клуч. tafs го бара секој пат и никогаш не го чува."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Аюулгүй байдлын түлхүүрийнхээ PIN-г оруулна уу. tafs үүнийг тухай бүрт асууж, хэзээ ч хадгалдаггүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आफ्नो सुरक्षा कुञ्जीको PIN हाल्नुहोस्। tafs ले यो हरेक पटक सोध्छ र कहिल्यै भण्डारण गर्दैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de pincode van je beveiligingssleutel in. tafs vraagt er elke keer om en bewaart hem nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz PIN swojego klucza bezpieczeństwa. tafs pyta o niego za każdym razem i nigdy go nie zapisuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza o PIN da sua chave de segurança. O tafs pede-o sempre e nunca o guarda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o PIN da sua chave de segurança. O tafs pede o PIN sempre e nunca o guarda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
