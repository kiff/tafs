    "taf.remove_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Cards werden widerrufen, sein Zeitplan gestoppt, seine Chats, Laufberichte, sein Gedächtnis und sein Schlüssel gelöscht und sein Name freigegeben. KIFFs Belege bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its Cards are revoked, its schedule stopped, its chats, run reports, memory and key deleted, and its name freed. KIFF's receipts stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se revocan sus Cards, se detiene su programación, se eliminan sus chats, informes de ejecución, memoria y clave, y se libera su nombre. Los recibos de KIFF se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses Cards sont révoquées, son planning arrêté, ses chats, rapports d'exécution, mémoire et clé supprimés, et son nom libéré. Les reçus de KIFF restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue Card vengono revocate, la sua pianificazione fermata, le chat, i resoconti delle esecuzioni, la memoria e la chiave eliminati, e il suo nome liberato. Le ricevute di KIFF restano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zijn Cards worden ingetrokken, de planning gestopt, de chats, runrapporten, het geheugen en de sleutel verwijderd, en de naam komt vrij. De ontvangstbewijzen van KIFF blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego Card zostaną unieważnione, harmonogram zatrzymany, czaty, raporty z uruchomień, pamięć i klucz usunięte, a nazwa zwolniona. Potwierdzenia KIFF zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus Cards são revogados, o seu agendamento parado, os seus chats, relatórios de execução, memória e chave eliminados, e o seu nome libertado. Os recibos do KIFF mantêm-se."
          }
        }
      }
    },
