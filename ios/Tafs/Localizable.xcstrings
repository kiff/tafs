            "state": "translated",
            "value": "%1$@ pourra approuver les actions de vos tafs avec Windows Hello."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređaj %1$@ moći će odobravati radnje vaših tafova uz Windows Hello."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Windows Hellóval jóváhagyhatja majd a tafjaid műveleteit."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը կկարողանա հաստատել ձեր taf-երի գործողությունները Windows Hello-ով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ akan dapat menyetujui tindakan tafs Anda dengan Windows Hello."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ potrà approvare le azioni dei tuoi tafs con Windows Hello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@でWindows Helloを使ってtafsの操作を承認できるようになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ შეძლებს თქვენი taf-ების მოქმედებების დამტკიცებას Windows Hello-თი."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 Windows Hello로 tafs의 행동을 승인할 수 있게 됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ galės tvirtinti jūsų taf veiksmus su Windows Hello."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ varēs apstiprināt tavu taf darbības ar Windows Hello."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kan dan de acties van je tafs goedkeuren met Windows Hello."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ będzie mógł zatwierdzać działania Twoich tafs za pomocą Windows Hello."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ poderá aprovar as ações dos seus tafs com Windows Hello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ poderá aprovar as ações dos seus tafs com Windows Hello."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ va putea aproba acțiunile tafurilor dvs. cu Windows Hello."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bude môcť schvaľovať akcie vašich tafov cez Windows Hello."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bo lahko odobraval dejanja vaših tafov z Windows Hello."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ do të mund të miratojë veprimet e tafs-eve tuaj me Windows Hello."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređaj %1$@ moći će odobravati radnje vaših tafova uz Windows Hello."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จะสามารถอนุมัติการกระทำของ taf ของคุณด้วย Windows Hello"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, tafs'larınızın eylemlerini Windows Hello ile onaylayabilecek."
