          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávka se do telefonu nedostala. Zkuste to znovu, nebo to napište."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist nicht auf deinem Handy angekommen. Versuch es erneut oder tippe stattdessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording didn't reach your phone. Try again, or type instead."
