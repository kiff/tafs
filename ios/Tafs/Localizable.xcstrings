        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에서는 이 계정의 앱 연결이 설정되어 있지 않습니다. Coach를 열어 시작하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programėlių prijungimas šiai paskyrai iš šio telefono nenustatytas. Atidarykite Coach, kad jį pradėtumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotņu pievienošana šim kontam no šī tālruņa nav iestatīta. Atver Coach, lai to sāktu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps koppelen is voor dit account niet ingesteld vanaf deze telefoon. Open Coach om ermee te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączenie aplikacji nie jest skonfigurowane dla tego konta z tego telefonu. Otwórz Coacha, aby to rozpocząć."
          }
        },
        "pt": {
