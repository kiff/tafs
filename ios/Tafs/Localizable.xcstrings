    "settings.devices.pair_add_only": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف هذا الجهاز إلى حسابك. هذا الجهاز فقط؛ ولا يتغير شيء آخر."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazı hesabınıza əlavə edin. Yalnız bu cihaz; başqa heç nə dəyişmir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавяне на това устройство към акаунта ви. Само това устройство; нищо друго не се променя."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইস আপনার অ্যাকাউন্টে যোগ করুন। শুধু এই ডিভাইস; আর কিছু বদলায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix aquest dispositiu al teu compte. Només aquest dispositiu; no canvia res més."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte toto zařízení ke svému účtu. Jen toto zařízení; nic jiného se nemění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät zu deinem Konto hinzufügen. Nur dieses Gerät, sonst ändert sich nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this device to your account. Only this device; nothing else changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir este dispositivo a tu cuenta. Solo este dispositivo; nada más cambia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa see seade oma kontole. Ainult see seade; midagi muud ei muutu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter cet appareil à votre compte. Uniquement cet appareil ; rien d'autre ne change."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת ההתקן הזה לחשבון שלך. רק ההתקן הזה; שום דבר אחר לא משתנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस को अपने खाते में जोड़ें। केवल यह डिवाइस; और कुछ नहीं बदलता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte ovaj uređaj svom računu. Samo ovaj uređaj; ništa se drugo ne mijenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek az eszköznek a hozzáadása a fiókodhoz. Csak ez az eszköz; semmi más nem változik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելացրեք այս սարքը ձեր հաշվին։ Միայն այս սարքը․ ուրիշ ոչինչ չի փոխվում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan perangkat ini ke akun Anda. Hanya perangkat ini; tidak ada yang lain berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi questo dispositivo al tuo account. Solo questo dispositivo; nient'altro cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスをアカウントに追加します。このデバイスだけで、他は何も変わりません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაამატეთ ეს მოწყობილობა თქვენს ანგარიშს. მხოლოდ ეს მოწყობილობა; სხვა არაფერი იცვლება."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ថែមឧបករណ៍នេះទៅគណនីរបស់អ្នក។ ឧបករណ៍នេះតែប៉ុណ្ណោះ; គ្មានអ្វីផ្សេងផ្លាស់ប្តូរទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기를 계정에 추가합니다. 이 기기만 추가되며 다른 것은 바뀌지 않습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພີ່ມອຸປະກອນນີ້ໃນບັນຊີຂອງທ່ານ. ສະເພາະອຸປະກອນນີ້; ບໍ່ມີຫຍັງອື່ນປ່ຽນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėkite šį įrenginį prie savo paskyros. Tik šį įrenginį; niekas kitas nesikeičia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievieno šo ierīci savam kontam. Tikai šo ierīci; nekas cits nemainās."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додај го овој уред на твојата сметка. Само овој уред; ништо друго не се менува."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ төхөөрөмжийг бүртгэлдээ нэмнэ үү. Зөвхөн энэ төхөөрөмж; өөр юу ч өөрчлөгдөхгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो उपकरण आफ्नो खातामा थप्नुहोस्। यही उपकरण मात्र; अरू केही परिवर्तन हुँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat aan je account toevoegen. Alleen dit apparaat; verder verandert er niets."
          }
        },
        "pl": {
