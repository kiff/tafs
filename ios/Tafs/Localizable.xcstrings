    "home.cant_reach_kiff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى KIFF"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF-ə çatmaq olmur"
          }
