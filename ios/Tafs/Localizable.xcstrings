          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostanie wysłane, dopóki nie zatwierdzisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é enviado até aprovar."
