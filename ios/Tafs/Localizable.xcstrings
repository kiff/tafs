            "value": "तीनों कैरियर द्वारा देर से पुष्ट हैं और %1$@ ने जाँचे हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sva tri kašnjenja potvrdio je prijevoznik, a provjerio ih je %1$@."
