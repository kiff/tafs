    "attachment.wrong_kind": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إرفاق %1$@. يمكن إرفاق الصور وملفات PDF والنصوص وCSV وMarkdown وملفات Word وExcel."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ əlavə edilə bilmir. Foto, PDF, mətn, CSV, Markdown, Word və Excel faylları əlavə edilə bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не може да бъде прикачен. Могат да се прикачват снимки, PDF, текст, CSV, Markdown и файлове на Word и Excel."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ সংযুক্ত করা যায় না। ছবি, PDF, টেক্সট, CSV, Markdown, Word ও Excel ফাইল যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es pot adjuntar %1$@. Es poden adjuntar fotos, PDF, text, CSV, Markdown i fitxers de Word i d'Excel."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nelze přiložit. Přiložit lze fotky, PDF, text, CSV, Markdown a soubory Word a Excel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kann nicht angehängt werden. Fotos, PDFs, Text, CSV, Markdown sowie Word- und Excel-Dateien schon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ can't be attached. Photos, PDFs, text, CSV, Markdown, Word and Excel files can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede adjuntar %1$@. Se pueden adjuntar fotos, PDF, texto, CSV, Markdown y archivos de Word y Excel."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili %1$@ ei saa lisada. Lisada saab fotosid, PDF-e, teksti-, CSV-, Markdowni-, Wordi- ja Exceli faile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne peut pas être joint. Seuls les photos, PDF, fichiers texte, CSV, Markdown, Word et Excel peuvent l'être."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לצרף את %1$@. אפשר לצרף תמונות, קובצי PDF, טקסט, CSV, Markdown, Word ו-Excel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ जोड़ा नहीं जा सकता। फ़ोटो, PDF, टेक्स्ट, CSV, Markdown, Word और Excel फ़ाइलें जोड़ी जा सकती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nije moguće priložiti. Mogu se priložiti fotografije, PDF-ovi, tekst, CSV, Markdown te Word i Excel datoteke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nem csatolható. Fotók, PDF-ek, szövegek, CSV, Markdown, Word- és Excel-fájlok csatolhatók."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-ը հնարավոր չէ կցել։ Կարելի է կցել լուսանկարներ, PDF, տեքստ, CSV, Markdown, Word և Excel ֆայլեր։"
