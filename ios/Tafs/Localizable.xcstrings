    "settings.delete_account.warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف هذا حسابك في KIFF. لا يمكن التراجع عن ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, KIFF hesabınızı silir. Bunu geri qaytarmaq olmaz."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това изтрива акаунта ви в KIFF. Не може да бъде отменено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনার KIFF অ্যাকাউন্ট মুছে দেয়। এটি ফেরানো যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això elimina el teu compte de KIFF. No es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto smažete svůj účet KIFF. Nelze to vrátit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird dein KIFF-Konto gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes your KIFF account. It can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina tu cuenta de KIFF. No se puede deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See kustutab sinu KIFFi konto. Seda ei saa tagasi võtta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime votre compte KIFF. C'est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מוחק את חשבון KIFF שלך. אי אפשר לבטל את זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपका KIFF खाता हटाता है। इसे पलटा नहीं जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo briše vaš KIFF račun. Ne može se poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez törli a KIFF-fiókodat. Nem vonható vissza."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա ջնջում է ձեր KIFF հաշիվը։ Սա հնարավոր չէ հետ շրջել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus akun KIFF Anda. Tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina il tuo account KIFF. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFFアカウントを削除します。元に戻すことはできません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს შლის თქვენს KIFF ანგარიშს. ამის გაუქმება შეუძლებელია."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នេះលុបគណនី KIFF របស់អ្នក។ មិនអាចត្រឡប់វិញបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KIFF 계정이 삭제됩니다. 되돌릴 수 없습니다."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສິ່ງນີ້ລຶບບັນຊີ KIFF ຂອງທ່ານ. ຍົກເລີກບໍ່ໄດ້."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai ištrina jūsų KIFF paskyrą. To negalima atšaukti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas dzēš tavu KIFF kontu. To vairs nevarēs atjaunot."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова ја брише твојата сметка на KIFF. Не може да се врати."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ нь таны KIFF бүртгэлийг устгана. Үүнийг буцаах боломжгүй."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसले तपाईंको KIFF खाता मेट्छ। यो फिर्ता गर्न सकिँदैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert je KIFF-account. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usuwa Twoje konto KIFF. Nie można tego cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina a sua conta KIFF. Não pode ser desfeito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto exclui a sua conta KIFF. Não pode ser desfeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta vă șterge contul KIFF. Acțiunea nu poate fi anulată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto odstránite svoj účet KIFF. Nedá sa to vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem izbrišete svoj račun KIFF. Tega ni mogoče razveljaviti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo fshin llogarinë tuaj KIFF. Nuk mund të zhbëhet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo briše vaš KIFF nalog. Ne može se poništiti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนี้จะลบบัญชี KIFF ของคุณ ไม่สามารถย้อนกลับได้"
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu KIFF hasabyňyzy pozýar. Muny yzyna gaýtaryp bolmaýar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, KIFF hesabınızı siler. Geri alınamaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آپ کا KIFF اکاؤنٹ حذف کر دیتا ہے۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này xóa tài khoản KIFF của bạn. Không thể hoàn tác."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除您的 KIFF 帳號。此操作無法復原。"
          }
        }
      }
    },
