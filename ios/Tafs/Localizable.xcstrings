        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njihove poruke putem: %1$@ od sada mu daju posao"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ezen (%1$@) érkező üzenetei mostantól munkát adnak neki"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նրանց հաղորդագրությունները %1$@-ով այսուհետ աշխատանք են տալիս"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan mereka lewat %1$@ memberinya pekerjaan mulai sekarang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "D'ora in poi i suoi messaggi via %1$@ gli danno lavoro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後、%1$@経由のメッセージで仕事を依頼できます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მათი შეტყობინებები კარით %1$@ ამიერიდან სამუშაოს აძლევს"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제부터 %1$@에서 보낸 메시지로 작업을 맡깁니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuo šiol jų žinutės per %1$@ suteikia jam darbą"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī sūtītāja ziņas (durvis: %1$@) turpmāk dod tam darbu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hun berichten via %1$@ geven het vanaf nu werk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od teraz wiadomości tej osoby przez %1$@ zlecają mu pracę"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens desta pessoa por %1$@ dão-lhe trabalho a partir de agora"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens desta pessoa por %1$@ passam a dar trabalho a ele"
