<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac build's entitlements (docs/mac-app.md, "Signing and the sandbox"): the iPhone and
     iPad's, which project.yml writes to Tafs.entitlements, with the Mac's name for push and
     the App Sandbox the Mac App Store requires. A key added there is added here too: the Mac
     workflow checks. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.aps-environment</key>
	<string>$(TAFS_APS_ENVIRONMENT)</string>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)bot.tafs.app</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:kiff.dev</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
