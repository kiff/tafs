{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "tafs",
  "description": "__MSG_description__",
  "version": "0.2.20",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "src/sw.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "__MSG_name__", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "side_panel": { "default_path": "sidepanel/index.html" },
  "permissions": ["storage", "alarms", "scripting", "sidePanel", "tabs", "tabGroups", "webNavigation", "declarativeNetRequest", "notifications"],
  "host_permissions": ["https://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
}
