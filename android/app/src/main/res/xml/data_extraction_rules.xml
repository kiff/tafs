<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The KIFF session never leaves this phone: its file stays out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tafs_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tafs_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
