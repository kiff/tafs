<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Confirms each approval with a strong biometric, never the screen lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Shows an alert when a taf needs you (Android 13 and later asks first). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Dictating a message (docs/chat.md): recognised on the phone, asked at the first tap of the mic. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Haptics' touch effects where the view's feedback plays none (some phones keep it off and use their own touch slider);
         a normal permission, granted at install, never asked. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Dictation is optional: a phone without a microphone still installs tafs, and its mic says it can't dictate. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Any orientation: tafs runs on phones held upright and on devices that are only ever landscape (a Chromebook, a desktop,
         a tablet docked sideways). Play would otherwise read an activity locked to portrait as needing a portrait screen. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <!-- Finds the phone's own speech recognizer for dictation. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".TafsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tafs">
        <!-- Pairing a computer: Play services fetches its QR scanner as the app installs, not on the first scan. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
        <!-- ML Kit's scanner delegate is invisible: it starts Play services' scanner and takes its result. ML Kit locks it to
             portrait only so a rotation can't recreate it mid-scan; it handles those changes itself here instead, so nothing locks
             the app to portrait and a landscape-only device scans as a phone does (AnyOrientationTest). -->
        <activity
            android:name="com.google.mlkit.vision.codescanner.internal.GmsBarcodeScanningDelegateActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:screenOrientation="unspecified"
            tools:replace="android:screenOrientation" />
        <!-- adjustResize: the app moves itself above the keyboard (imePadding), so the window must not pan as well. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Where the Wear OS watch's Open on phone goes (docs/watch-wear.md): tafs://open/needs-you. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tafs" android:host="open" />
            </intent-filter>
            <!-- Where a vendor's sign-in comes back to, from planque. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tafs" android:host="planque" android:path="/signed-in" />
            </intent-filter>
            <!-- Where KIFF's sign-in comes back to (docs/onboarding.md): dev.kiff.tafs:/oauth, the Play package's own scheme.
                 It has no host, so Android matches the scheme only; AppSignIn.answer takes the path and state exactly. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.kiff.tafs" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging delivers tafs cloud's alerts here. -->
        <service
            android:name=".push.TafsMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The Wear OS watch's requests, from the paired watch running tafs only (docs/watch-wear.md). -->
        <service
            android:name=".watch.WearRelayService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/tafs/watch/v1/" />
            </intent-filter>
            <!-- A recording the watch's recognizer gave up on, to turn into text on this phone only (row 44, A). -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/tafs/watch/v1/voice/" />
            </intent-filter>
        </service>

        <!-- Photos and files on a message (docs/attachments.md): the camera writes its photo here, and a file opened full size
             is handed to the app that shows it. Only the app's own cache folders, never shared storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
