{
 "about": "An API door's endpoint and example (docs/doors.md; each app's APIDoorText). The example is a shell line a developer pastes, so the endpoint is only ever on tafs cloud's own host, over HTTPS, with a path of unreserved characters only (letters, digits, \"/\", \"_\", \".\", \"~\", \"-\"), and no query or fragment; any other path gives tafs cloud's address alone. The example single-quotes it. `exact` gives the endpoint every app must show; `hostile` gives addresses whose endpoint may differ by app but must keep `rules`. Read by every app's tests.",
 "base": "https://cloud.tafs.kiff.dev",
 "alone": "https://cloud.tafs.kiff.dev/",
 "rules": {
  "scheme": "https",
  "host": "cloud.tafs.kiff.dev",
  "port": null,
  "user": null,
  "path_pattern": "^/[A-Za-z0-9/_.~-]*$",
  "query": null,
  "fragment": null
 },
 "example_prefix": "curl -X POST '",
 "example_suffix": "' \\\n  -H \"Authorization: Bearer $TAFS_API_KEY\" \\\n  -H \"Idempotency-Key: <your request id>\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"input\": {}}'",
